{
  "name": "italian-tweaks",
  "productName": "ITALIAN TWEAKS",
  "version": "1.0.0",
  "description": "ITALIAN TWEAKS — Performance Suite",
  "main": "src/main.js",
  "author": "ITALIAN TWEAKS",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sanaaxzu/italian-tweaks.git"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "dist": "electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --x64 --publish always",
    "postinstall": "node scripts/generate-placeholders.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sanaaxzu.italiantweaks",
    "productName": "ITALIAN TWEAKS",
    "directories": {
      "output": "build",
      "buildResources": "build/resources"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "scripts/**/*",
      "tools/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "ITALIAN-TWEAKS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ITALIAN TWEAKS"
    },
    "asar": true,
    "asarUnpack": [
      "scripts/**/*",
      "tools/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "sanaaxzu",
        "repo": "italian-tweaks"
      }
    ]
  }
}
