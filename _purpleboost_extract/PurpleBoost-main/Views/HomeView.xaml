<UserControl x:Class="PurpleBoost.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="980"
             Loaded="HomeView_OnLoaded">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
      <TextBlock Text="Accueil" Style="{StaticResource PbTitle}" />
      <TextBlock Style="{StaticResource PbSubtitle}"
                 Margin="0,8,0,0"
                 Text="Dashboard orienté performance : lecture matérielle via WMI / compteurs Windows. Les valeurs marquées « À connecter plus tard » seront branchées (températures / GPU selon matériel)." />

      <Grid Margin="0,14,0,0">
        <Button HorizontalAlignment="Right"
                Style="{StaticResource PbGhostButton}"
                Content="Rafraîchir"
                Command="{Binding RefreshCommand}" />
      </Grid>

      <Border Style="{StaticResource PbMotherboardCard}" Margin="0,14,0,0">
        <StackPanel>
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="PANNEAU PERFORMANCE"
                         Foreground="{StaticResource Brush.Neon}"
                         FontSize="11"
                         FontWeight="Bold"
                         LetterSpacing="2" />
              <TextBlock Text="Carte mère — instantané système"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Margin="0,6,0,0" />
              <TextBlock Foreground="{StaticResource Brush.Muted}"
                         FontSize="13"
                         TextWrapping="Wrap"
                         Margin="0,6,0,0"
                         Text="Les températures dépendent souvent des capteurs exposés par le fabricant / pilotes." />
            </StackPanel>
          </DockPanel>

          <UniformGrid Margin="0,14,0,0" Columns="3" Rows="1">
            <Border Style="{StaticResource PbCard}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="PROCESSEUR" Style="{StaticResource PbSubtitle}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding CpuName}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource PbCard}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="CARTE GRAPHIQUE" Style="{StaticResource PbSubtitle}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding GpuName}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource PbCard}">
              <StackPanel>
                <TextBlock Text="MÉMOIRE" Style="{StaticResource PbSubtitle}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding RamTotal}" Margin="0,8,0,0" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <UniformGrid Margin="0,12,0,0" Columns="2">
            <Border Style="{StaticResource PbCard}" Margin="0,0,10,0">
              <StackPanel>
                <TextBlock Text="CHARGE" Style="{StaticResource PbSubtitle}" FontSize="11" FontWeight="Bold" />
                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Brush.Muted}" Text="CPU" />
                <TextBlock Text="{Binding CpuUsage}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Brush.Muted}" Text="GPU" />
                <TextBlock Text="{Binding GpuUsage}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Brush.Muted}" Text="RAM" />
                <TextBlock Text="{Binding RamUsage}" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource PbCard}">
              <StackPanel>
                <TextBlock Text="TEMPÉRATURES" Style="{StaticResource PbSubtitle}" FontSize="11" FontWeight="Bold" />
                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Brush.Muted}" Text="CPU" />
                <TextBlock Text="{Binding CpuTemperature}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Brush.Muted}" Text="GPU" />
                <TextBlock Text="{Binding GpuTemperature}" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <TextBlock Margin="0,12,0,0"
                     Foreground="{StaticResource Brush.Muted}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Text="Astuce : si la charge GPU reste « À connecter plus tard », les compteurs « GPU Engine » peuvent être absents selon pilote / version Windows." />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
