  if (/\[NVCleanstall\].*Automatisation dÃ©marrÃ©e|\[NVCleanstall\].*Automatisation demarree/i.test(live)) {
    return { pct: 50, msg: "Automatisation NVCleanstall en cours..." };
  }
  if (/\[NVCleanstall\].*Page Driver Version|\[NVCleanstall\].*Next cliquÃ©|\[NVCleanstall\].*Page intermÃ©diaire/i.test(live)) {
    return { pct: 60, msg: "Assistant NVCleanstall â€” avancement automatique..." };
  }
  if (/Detection page prete NVCleanstall|DÃ©tection page prÃªte NVCleanstall|\[NVCleanstall\].*Recherche|Recherche texte Finished/i.test(live)) {
