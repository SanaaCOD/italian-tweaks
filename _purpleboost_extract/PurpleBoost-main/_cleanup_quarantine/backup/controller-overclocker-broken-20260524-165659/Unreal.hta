function clearControllerOcApplyArtifacts() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var fso = getFso();
  var paths = [
    getControllerOverclockerParamsPath(),
    getControllerOverclockerApplyResultPath(),
    app ? getAbsolutePathFs(combinePath(app, "logs\\controller-overclocker-apply-result.json")) : "",
    app ? getAbsolutePathFs(combinePath(app, "logs\\controller-overclocker-exitcode.txt")) : ""
  ];
  var i;
  for (i = 0; i < paths.length; i++) {
    try {
      if (paths[i] && fso.FileExists(paths[i])) fso.DeleteFile(paths[i], true);
    } catch (eDel) {}
  }
}

function writeControllerOverclockerParamsFile(app, logPath, params) {
  var paramPath = getControllerOverclockerParamsPath();
  try {
    var outDir = getFso().GetParentFolderName(paramPath);
    if (outDir && !getFso().FolderExists(outDir)) getFso().CreateFolder(outDir);
  } catch (eMk) {}
  var instanceId = String(params.instanceId || "");
  if (!isValidControllerDeviceInstanceId(instanceId)) {
    instanceId = "";
  }
  var payload = {
    AppRoot: String(app || ""),
    LogPath: String(logPath || ""),
    DeviceInstanceId: instanceId,
    UsbParentDeviceId: String(params.usbParentDeviceId || ""),
    Vid: String(params.vid || ""),
    Pid: String(params.pid || ""),
    MaxRateHz: params.maxRateHz ? parseInt(params.maxRateHz, 10) : 0,
    Uninstall: !!params.uninstall,
    Mode: String(params.mode || "")
  };
  writeUtf8TextFileAll(paramPath, JSON.stringify(payload, null, 2));
  return paramPath;
}

function getHidusbfToolsPath() {
  var bundle = resolveHidusbfBundle();
  return bundle.root || "";
}

function findHidusbfAssetRecursive(rootDir, leafName, depth) {
  if (!rootDir || depth > 10) return "";
  var fso = getFso();
  try {
    var folder = fso.GetFolder(rootDir);
    var files = new Enumerator(folder.Files);
    for (; !files.atEnd(); files.moveNext()) {
      if (String(files.item().Name).toUpperCase() === String(leafName || "").toUpperCase()) {
        return String(files.item().Path);
      }
    }
    if (depth >= 10) return "";
    var subs = new Enumerator(folder.SubFolders);
    for (; !subs.atEnd(); subs.moveNext()) {
      var hit = findHidusbfAssetRecursive(String(subs.item().Path), leafName, depth + 1);
      if (hit) return hit;
    }
  } catch (eFind) {}
  return "";
}

function resolveHidusbfBundle() {
  initApplicationBaseDirectory();
  var fso = getFso();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var htaDir = getUnrealHtaDirectory() || "";
  var roots = [];
  var seen = {};
  function addRoot(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d]) return;
    seen[d] = true;
    if (fso.FolderExists(d)) roots.push(d);
  }
  if (app) {
    addRoot(combinePath(app, "Tools\\hidusbf"));
    addRoot(combinePath(app, "tools\\hidusbf"));
  }
  if (htaDir && htaDir !== app) {
    addRoot(combinePath(htaDir, "Tools\\hidusbf"));
    addRoot(combinePath(htaDir, "tools\\hidusbf"));
  }
  var relInfPaths = [
    "HIDUSBF_AS.INF",
    "hidusbf\\DRIVER\\HIDUSBF_AS.INF",
    "HIDUSBF\\DRIVER\\HIDUSBF_AS.INF",
    "DRIVER\\HIDUSBF_AS.INF"
  ];
  var i;
  var j;
  for (i = 0; i < roots.length; i++) {
    var recursiveInf = findHidusbfAssetRecursive(roots[i], "HIDUSBF_AS.INF", 0);
    if (recursiveInf) {
      return { found: true, root: roots[i], infPath: recursiveInf };
    }
    for (j = 0; j < relInfPaths.length; j++) {
      var infPath = getAbsolutePathFs(combinePath(roots[i], relInfPaths[j]));
      if (infPath && fso.FileExists(infPath)) {
        return { found: true, root: roots[i], infPath: infPath };
      }
    }
  }
  var fallback = roots.length ? roots[0] : (app ? getAbsolutePathFs(combinePath(app, "Tools\\hidusbf")) : "");
  return { found: false, root: fallback, infPath: "" };
}

function findHidusbfRateDriverSys(rootDir, rateFolderName, depth) {
  if (!rootDir || depth > 10) return "";
  var fso = getFso();
  try {
    var folder = fso.GetFolder(rootDir);
    if (String(folder.Name).toUpperCase() === String(rateFolderName || "").toUpperCase()) {
      var sysPath = getAbsolutePathFs(combinePath(folder.Path, "hidusbf.sys"));
      if (sysPath && fso.FileExists(sysPath)) return sysPath;
    }
    var subs = new Enumerator(folder.SubFolders);
    for (; !subs.atEnd(); subs.moveNext()) {
      var hit = findHidusbfRateDriverSys(String(subs.item().Path), rateFolderName, depth + 1);
      if (hit) return hit;
    }
  } catch (eRate) {}
  return "";
}

function isHidusbfBundledPresent() {
  var bundle = resolveHidusbfBundle();
  if (!bundle.found || !bundle.root) return false;
  var fso = getFso();
  var cert = findHidusbfAssetRecursive(bundle.root, "SweetLow.CER", 0);
  if (!cert || !fso.FileExists(cert)) return false;
  var infU = findHidusbfAssetRecursive(bundle.root, "HIDUSBFU.INF", 0);
  if (!infU || !fso.FileExists(infU)) return false;
  var sys1k = findHidusbfRateDriverSys(bundle.root, "1khz", 0);
  if (!sys1k) sys1k = findHidusbfRateDriverSys(bundle.root, "1kHz", 0);
  return !!sys1k;
}

function writeControllerOverclockerLog(line) {
  try {
    var path = getControllerOverclockerLogPath();
    var fso = getFso();
    var folder = fso.GetParentFolderName(path);
    if (folder && !fso.FolderExists(folder)) fso.CreateFolder(folder);
    var ForAppending = 8;
    if (!fso.FileExists(path)) {
      var t0 = fso.CreateTextFile(path, true);
      t0.WriteLine(line);
      t0.Close();
    } else {
      var t1 = fso.OpenTextFile(path, ForAppending, true);
      t1.WriteLine(line);
      t1.Close();
    }
  } catch (eLog) {}
  appendControllerOverclockerUiLog(line);
}

function appendControllerOverclockerUiLog(message) {
  /* Logs fichier uniquement — jamais affichés dans l'UI. */
}

function setControllerOverclockerStatus(message, kind) {
  var line = $("cocStateLine");
  if (line) {
    line.innerText = String(message || "");
    line.className = "coc-state-line" + (kind ? " coc-state-line--" + kind : "");
  }
  var el = $("controllerOverclockerStatus");
  if (el) {
    el.style.display = message ? "" : "none";
    el.innerText = message || "";
    el.className = "tool-status" + (kind ? " tool-status--" + kind : "");
  }
}

function updateControllerOverclockerHidusbfBadge() {
  var badge = $("controllerOverclockerHidusbfBadge");
  if (!badge) return;
  var bundle = resolveHidusbfBundle();
  writeControllerOverclockerLog("[DEVICE] HIDUSBF path: " + (bundle.root || "(non r\u00e9solu)"));
  writeControllerOverclockerLog("[DEVICE] HIDUSBF detected: " + (bundle.found ? "true" : "false"));
  if (bundle.found) {
    badge.innerText = "HIDUSBF : d\u00e9tect\u00e9";
    badge.className = "tcp-badge tcp-badge--ok";
  } else {
    badge.innerText = "HIDUSBF : introuvable";
    badge.className = "tcp-badge tcp-badge--err";
  }
}

function updateControllerOverclockerSelectionUi() {
  var sel = $("controllerOverclockerSelect");
  var idx = sel ? parseInt(sel.value, 10) : -1;
  if (isNaN(idx)) idx = -1;
  controllerOverclockerState.selectedIndex = idx;
  var dev = idx >= 0 && controllerOverclockerState.devices[idx] ? controllerOverclockerState.devices[idx] : null;
  var lineEl = $("cocDeviceLine");
  if (lineEl) {
    if (!dev) {
      lineEl.innerText = "Aucun p\u00e9riph\u00e9rique s\u00e9lectionn\u00e9";
    } else {
      var devName = fixUtf8Mojibake(dev.Name || dev.FriendlyName || "P\u00e9riph\u00e9rique");
      var devType = dev.Type ? (" [" + fixUtf8Mojibake(dev.Type) + "]") : "";
      var parentHint = dev.ParentResolved === false
        ? " — parent USB à résoudre pour appliquer"
        : "";
      lineEl.innerText = devName + devType + parentHint;
    }
  }
  if (!dev) {
    try { renderControllerPollingStatusUi(null); } catch (eNoDev) {}
  }
  updateControllerApplyUi();
}

function updateControllerApplyUi() {
  var r = controllerOverclockerState.uiLastClickedRate || 0;
  var dev = getSelectedControllerDevice();
  var selectedEl = $("cocSelectedRate");
  var b1 = $("btnApplyController1000");
  var b8 = $("btnApplyController8000");
  if (selectedEl) selectedEl.innerText = r >= 1000 ? (r + " Hz") : "\u2014";
  var busy = !!controllerOverclockerState.busy || !dev;
  if (b1) b1.disabled = busy;
  if (b8) b8.disabled = busy;
}

function runApplyControllerOC(hardRate) {
  var rate = parseInt(hardRate, 10);
  if (rate !== 1000 && rate !== 8000) return;
  runControllerOverclockerAction("apply", rate);
}

function applyController1000() {
  var card = getSelectedControllerDevice();
  if (card) applyControllerRateForCard(getControllerCardId(card), 1000, card.cardIndex);
}

function applyController8000() {
  var card = getSelectedControllerDevice();
  if (card) applyControllerRateForCard(getControllerCardId(card), 8000, card.cardIndex);
}

function handleControllerApplyResult(applyResult, requestedRate) {
  if (!applyResult) {
    setControllerOverclockerStatus("\u00c9chec application", "error");
    return;
  }
  var req = parseInt(applyResult.RequestedRate, 10) || parseInt(requestedRate, 10) || 0;
  var conf = parseInt(applyResult.ConfirmedRate, 10);
  if (isNaN(conf)) conf = 125;
  var code = String(applyResult.Code || "");

  if (code === "RATE_1000_FAILED_STILL_8000" || code === "1000_STILL_HAS_8000_PATCH" || (req === 1000 && conf === 8000)) {
    setControllerOverclockerStatus("\u00c9chec application 1000 Hz \u2014 8000 Hz d\u00e9tect\u00e9", "warn");
    return;
  }
  if (code === "DRIVER_VARIANT_MISMATCH_1000" || code === "RATE_1000_USING_8000_VARIANT" || code === "APPLY_1000_FAILED") {
    setControllerOverclockerStatus("\u00c9chec application 1000 Hz", "error");
    return;
  }
  if (code === "DRIVER_VARIANT_MISMATCH_8000" || code === "ACTIVE_RATE_MISMATCH") {
    setControllerOverclockerStatus("\u00c9chec application 8000 Hz", "error");
    return;
  }
  if (code === "APPLIED_1000_CONFIRMED" || (req === 1000 && conf === 1000 && applyResult.Success === true)) {
    setControllerOverclockerStatus("Optimis\u00e9 1000 Hz confirm\u00e9", "success");
    return;
  }
  if (code === "APPLIED_8000_CONFIRMED" || (req === 8000 && conf === 8000 && applyResult.Success === true)) {
    setControllerOverclockerStatus("Optimis\u00e9 8000 Hz confirm\u00e9", "success");
    return;
  }
  if (code === "PREPARED_NEEDS_RECONNECT") {
    setControllerOverclockerStatus(req + " Hz pr\u00e9par\u00e9 \u2014 rebranche la manette", "warn");
    return;
  }
  if (applyResult.Success === true) {
    setControllerOverclockerStatus(fixUtf8Mojibake(String(applyResult.Message || "Application termin\u00e9e")), "info");
    return;
  }
  setControllerOverclockerStatus(fixUtf8Mojibake(String(applyResult.Message || "\u00c9chec application")), "error");
}

function controllerCoEscapeHtml(text) {
  return String(text || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function showControllerAssistedGuide(rateHz) {
  var guide = $("controllerOverclockerAssistedGuide");
  if (!guide) return;
  var dev = getSelectedControllerDevice();
  var vid = dev && dev.Vid ? dev.Vid : "054C";
  var pid = dev && dev.Pid ? dev.Pid : "0CE6";
  var typeName = dev && dev.Type ? fixUtf8Mojibake(dev.Type) : "DualSense";
  var rateStep = rateHz
    ? ("Choisis le rate demand\u00e9 : " + rateHz)
    : "Choisis le rate demand\u00e9 : 1000 ou 8000";
  controllerOverclockerState.assistedGuideRate = rateHz || 0;
  guide.innerHTML =
    "<strong>Mode assist\u00e9 \u2014 \u00e9tapes dans HIDUSBF Setup :</strong>" +
    "<ol style=\"margin:8px 0 0 18px;padding:0;font-size:12px;line-height:1.55;\">" +
    "<li>S\u00e9lectionne la ligne de la manette correspondant \u00e0 :<br>VID " +
    controllerCoEscapeHtml(vid) + " / PID " + controllerCoEscapeHtml(pid) + " / " +
    controllerCoEscapeHtml(typeName) + "</li>" +
    "<li>Coche \u00ab Filter On Device \u00bb</li>" +
    "<li>" + controllerCoEscapeHtml(rateStep) + "</li>" +
    "<li>Clique \u00ab Install Service \u00bb</li>" +
    "<li>Clique \u00ab Restart \u00bb</li>" +
    "<li>D\u00e9branche/rebranche la manette si n\u00e9cessaire</li>" +
    "</ol>" +
    (!isHidusbfAutoMethodValidated()
      ? ""
      : "");
  guide.style.display = "";
}

function hideControllerAssistedGuide() {
  var guide = $("controllerOverclockerAssistedGuide");
  if (guide) guide.style.display = "none";
  controllerOverclockerState.assistedGuideRate = 0;
}

function logControllerAssistedSetupOpened() {
  writeControllerOverclockerLog("[DEVICE] HIDUSBF Setup opened");
  writeControllerOverclockerLog("[DEVICE] Manual action required");
  writeControllerOverclockerLog("[DEVICE] Result: setup_opened_not_applied");
}

function setControllerAssistedSetupStatus() {
  setControllerOverclockerStatus(
    "Mode assist\u00e9 : HIDUSBF Setup est ouvert, applique le rate dans la fen\u00eatre.",
    "warn"
  );
}

function controllerCoFormatPotentialForCard(card, confirmedRate) {
  var max = card && card.MaxRateHz ? parseInt(card.MaxRateHz, 10) : 1000;
  var cur = confirmedRate > 0 ? confirmedRate : (card ? card.CurrentRateHz : 125);
  if (isNaN(cur)) cur = 125;
  if (max >= 8000 && cur >= 8000) return "8000 Hz";
  if (max >= 8000 && cur < 8000) return "8000 Hz";
  if (cur >= 1000) return "1000 Hz";
  return "1000 Hz";
}

function renderControllerCardDom(card) {
  card = controllerCoFinalizeCard(card);
  var domId = cocSafeDomId(getControllerCardId(card));
  var confirmed = card.status ? controllerCoResolveConfirmedRate(card.status) : (card.CurrentRateHz || 125);
  var requested = card.uiRequestedRate || 0;
  var optimized = card.status ? controllerCoIsOptimizedStatus(card.status, confirmed) : (confirmed > 125);
  var mismatch = card.status ? controllerCoHasRateMismatch(card.status, confirmed, requested) : false;
  var responseMs = card.status && card.status.ResponseTimeMs != null
    ? card.status.ResponseTimeMs
    : controllerCoDefaultResponseMs(confirmed > 0 ? confirmed : 125);
  var el = document.getElementById(domId);
  if (!el) return;
  var tone = mismatch ? "coc-tone-mismatch" : (optimized ? "coc-tone-opt" : "coc-tone-default");
  el.className = "coc-card " + tone;
  var badgeDev = document.getElementById(domId + "_badgeDev");
  var badgeSt = document.getElementById(domId + "_badgeSt");
  var poll = document.getElementById(domId + "_poll");
  var resp = document.getElementById(domId + "_resp");
  var pot = document.getElementById(domId + "_pot");
  var state = document.getElementById(domId + "_state");
  if (badgeDev) badgeDev.innerText = card.Badge || card.Type || "MANETTE";
  if (badgeSt) {
    if (card.statusPending) {
      badgeSt.innerText = "\u2026";
      badgeSt.className = "coc-badge coc-badge--default";
    } else if (mismatch) {
      badgeSt.innerText = "NON CONFIRM\u00c9";
      badgeSt.className = "coc-badge coc-badge--warn";
    } else if (optimized) {
      badgeSt.innerText = "OPTIMIS\u00c9";
      badgeSt.className = "coc-badge coc-badge--optimized";
    } else {
      badgeSt.innerText = "DEFAULT";
      badgeSt.className = "coc-badge coc-badge--default";
    }
  }
  var maxEl = document.getElementById(domId + "_max");
  if (maxEl) maxEl.innerText = String(card.MaxRateHz) + " Hz";
  if (poll) poll.innerText = card.statusPending ? "\u2026" : (confirmed > 0 ? confirmed + " Hz" : "125 Hz");
  if (resp) resp.innerText = controllerCoFormatResponseMs(responseMs);
  if (pot) pot.innerText = controllerCoFormatPotentialForCard(card, confirmed);
  var canApply = card.ParentResolved && !!card.UsbParentDeviceId;
  if (state) {
    if (card.statusPending) state.innerText = "V\u00e9rification en cours...";
    else if (!canApply) state.innerText = "Parent USB composite introuvable";
    else state.innerText = controllerCoBuildStateLine(card.status, confirmed, requested);
  }
  var btn1 = document.getElementById(domId + "_btn1000");
  var btn8 = document.getElementById(domId + "_btn8000");
  var btnR = document.getElementById(domId + "_btnRestore");
  var busy = controllerOverclockerState.busy && controllerOverclockerState.busyCardId === getControllerCardId(card);
  var maxHz = parseInt(card.MaxRateHz, 10);
  if (btn1) btn1.disabled = busy || !canApply;
  if (btn8) {
    btn8.disabled = busy || !canApply;
    btn8.style.display = maxHz >= 8000 ? "" : "none";
  }
  if (btnR) btnR.disabled = busy || !canApply;
}

function buildControllerCardHtml(card, cardIndex) {
  card = controllerCoFinalizeCard(card);
  card.cardIndex = parseInt(cardIndex, 10);
  var domId = cocSafeDomId(getControllerCardId(card));
  var idx = card.cardIndex;
  if (isNaN(idx)) idx = 0;
  var child = card.ChildName ? (" \u2014 " + controllerCoEscapeHtml(card.ChildName)) : "";
  var maxHz = parseInt(card.MaxRateHz, 10);
  if (isNaN(maxHz)) maxHz = controllerCoInferMaxRateHz(card.Type, card.Badge, card.Vid, card.Pid, card.ChildName, card.DisplayName);
  var show8k = maxHz >= 8000;
  var label1k = maxHz <= 1000 ? "Boost to 1000 Hz" : "Appliquer 1000 Hz";
  var label8k = "Appliquer 8000 Hz";
  var canApply = card.ParentResolved && !!card.UsbParentDeviceId;
  var disAttr = canApply ? "" : " disabled";
  return (
    '<div class="coc-card coc-tone-pending" id="' + domId + '" data-card-index="' + idx + '">' +
    '<div class="coc-card-header">' +
    '<div class="coc-card-title">' + controllerCoEscapeHtml(card.DisplayName || card.Name) + '</div>' +
    '<span class="coc-badge coc-badge--device" id="' + domId + '_badgeDev">' + controllerCoEscapeHtml(card.Badge) + '</span>' +
    '<span class="coc-badge coc-badge--default" id="' + domId + '_badgeSt">\u2026</span>' +
    '</div>' +
    '<div class="coc-card-sub">VID ' + controllerCoEscapeHtml(card.Vid) + ' / PID ' + controllerCoEscapeHtml(card.Pid) + child + '</div>' +
    '<div class="coc-card-metrics">' +
    '<div class="coc-card-metric"><span class="coc-metric-label">Polling actuel</span><span id="' + domId + '_poll">\u2026</span></div>' +
    '<div class="coc-card-metric"><span class="coc-metric-label">Max</span><span id="' + domId + '_max">' + maxHz + ' Hz</span></div>' +
    '<div class="coc-card-metric"><span class="coc-metric-label">Response time</span><span id="' + domId + '_resp">\u2014</span></div>' +
    '<div class="coc-card-metric"><span class="coc-metric-label">Potential</span><span id="' + domId + '_pot">\u2014</span></div>' +
    '</div>' +
    '<div class="coc-card-actions">' +
    '<button type="button" class="coc-btn-primary coc-btn-rate" id="' + domId + '_btn1000"' + disAttr + ' onclick="applyControllerRateForCardByIndex(' + idx + ',1000)">' + label1k + '</button>' +
    (show8k ? '<button type="button" class="coc-btn-primary coc-btn-rate" id="' + domId + '_btn8000"' + disAttr + ' onclick="applyControllerRateForCardByIndex(' + idx + ',8000)">' + label8k + '</button>' : '') +
    '</div>' +
    '<div class="coc-card-actions-footer">' +
    '<button type="button" class="coc-btn-secondary" id="' + domId + '_btnRestore"' + disAttr + ' onclick="restoreControllerCardDefaultByIndex(' + idx + ')">Restaurer d\u00e9faut</button>' +
    '</div>' +
    '<div class="coc-card-state" id="' + domId + '_state">V\u00e9rification en cours...</div>' +
    '</div>'
  );
}

function renderControllerOverclockerDeviceList(devices) {
  var container = $("controllerOverclockerCards");
  var emptyEl = $("controllerOverclockerEmpty");
  var cards = [];
  var i;
  for (i = 0; i < (devices || []).length; i++) {
    var c = normalizeControllerCard(devices[i]);
    if (c) {
      c.cardIndex = cards.length;
      cards.push(c);
    }
  }
  controllerOverclockerState.cards = cards;
  controllerOverclockerState.devices = cards;
  controllerOverclockerState.selectedIndex = cards.length ? 0 : -1;
  if (!container) return;
  container.innerHTML = "";
  if (emptyEl) {
    if (cards.length) {
      emptyEl.className = "coc-empty-hint coc-hidden";
    } else {
      emptyEl.className = "coc-empty-hint";
      emptyEl.innerText = "Aucune manette d\u00e9tect\u00e9e. Branchez une manette USB puis rafra\u00eechissez.";
    }
  }
  for (i = 0; i < cards.length; i++) {
    container.innerHTML += buildControllerCardHtml(cards[i], i);
  }
  refreshAllControllerCardsStatus(0);
}

function refreshControllerCardStatus(cardIndex, done) {
  var cards = controllerOverclockerState.cards || [];
  var card = cards[cardIndex];
  if (!card) {
    if (done) done();
    return;
  }
  card.statusPending = true;
  renderControllerCardDom(card);
  var psPath = getControllerOcStatusScriptPath();
  if (!psPath || !getFso().FileExists(psPath)) {
    card.statusPending = false;
    renderControllerCardDom(card);
    if (done) done();
    return;
  }
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var logPath = getControllerOverclockerLogPath();
  var outPath = getControllerOverclockerStatusJsonPath();
  var instanceId = String(card.DeviceInstanceId || "");
  var usbParent = String(card.UsbParentDeviceId || "");
  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + psPath + '"' +
    ' -AppRoot "' + escapeControllerPsArg(app) + '"' +
    ' -LogPath "' + escapeControllerPsArg(logPath) + '"' +
    ' -OutputPath "' + escapeControllerPsArg(outPath) + '"' +
    ' -DeviceInstanceId "' + escapeControllerPsArg(instanceId) + '"' +
    ' -UsbParentDeviceId "' + escapeControllerPsArg(usbParent) + '"' +
    ' -Vid "' + escapeControllerPsArg(card.Vid || "") + '"' +
    ' -Pid "' + escapeControllerPsArg(card.Pid || "") + '"' +
    ' -Quiet';
  window.setTimeout(function () {
    try { getShell().Run(cmd, 0, true); } catch (eRun) {}
    var st = readControllerPollingStatusResult();
    card.status = st;
    if (st) {
      var cr = controllerCoResolveConfirmedRate(st);
      card.CurrentRateHz = cr;
      card.ConfiguredRate = cr;
    }
    card.statusPending = false;
    renderControllerCardDom(card);
    if (done) done();
  }, 15);
}

function refreshAllControllerCardsStatus(startIndex) {
  var cards = controllerOverclockerState.cards || [];
  var idx = startIndex || 0;
  if (idx >= cards.length) {
    controllerOverclockerState.statusPending = false;
    controllerOverclockerState.statusLoaded = true;
    return;
  }
  refreshControllerCardStatus(idx, function () {
    refreshAllControllerCardsStatus(idx + 1);
  });
}

function applyControllerRateForCardByIndex(cardIndex, rateHz) {
  var card = getControllerCardByIndex(cardIndex);
  if (!card) return;
  applyControllerRateForCard(getControllerCardId(card), rateHz, cardIndex);
}

function applyControllerRateForCard(cardId, rateHz, cardIndexHint) {
  var card = null;
  if (typeof cardIndexHint === "number" && !isNaN(cardIndexHint)) {
    card = getControllerCardByIndex(cardIndexHint);
  }
  if (!card) card = getControllerCardById(cardId);
  if (!card) return;
  card = controllerCoFinalizeCard(card);
  var rate = parseInt(rateHz, 10);
  var maxHz = parseInt(card.MaxRateHz, 10);
  writeControllerOverclockerLog("[DEVICE] Apply card clicked");
  writeControllerOverclockerLog("[DEVICE] Card index=" + String(card.cardIndex));
  writeControllerOverclockerLog("[DEVICE] Card Type=" + card.Type);
  writeControllerOverclockerLog("[DEVICE] Card VID/PID=" + card.Vid + "/" + card.Pid);
  writeControllerOverclockerLog("[DEVICE] Card DeviceInstanceId=" + card.DeviceInstanceId);
  writeControllerOverclockerLog("[DEVICE] Card UsbParentDeviceId=" + (card.UsbParentDeviceId || "(empty)"));
  writeControllerOverclockerLog("[DEVICE] Card MaxRateHz=" + maxHz);
  writeControllerOverclockerLog("[DEVICE] Requested RateHz=" + rate);
  if (rate !== 1000 && rate !== 8000) return;
  if (!card.ParentResolved || !card.UsbParentDeviceId) {
    setControllerOverclockerStatus("Parent USB composite introuvable", "error");
    return;
  }
  if (rate > maxHz) {
    setControllerOverclockerStatus("Cette manette ne supporte pas " + rate + " Hz", "error");
    return;
  }
  card.uiRequestedRate = rate;
  runControllerOverclockerActionForCard(card, "apply", rate);
}

function applyControllerCardRateByIndex(cardIndex, rateHz) {
  applyControllerRateForCardByIndex(cardIndex, rateHz);
}

function applyControllerCardRate(cardId, rateHz) {
  applyControllerRateForCard(cardId, rateHz);
}

function restoreControllerCardDefaultByIndex(cardIndex) {
  var cards = controllerOverclockerState.cards || [];
  var card = cards[cardIndex];
  if (!card) return;
  restoreControllerCardDefault(getControllerCardId(card));
}

function restoreControllerCardDefault(cardId) {
  var card = getControllerCardById(cardId);
  if (!card) return;
  runControllerOverclockerActionForCard(card, "restore", 125);
}

function cocSafeDomId(cardId) {
  return "coc_" + String(cardId || "card").replace(/[^a-zA-Z0-9_]/g, "_").substring(0, 72);
}

function getControllerCardId(card) {
  if (!card) return "";
  return String(
    card.cardId || card.CardId || card.UsbParentDeviceId || card.TargetHidusbfDeviceId ||
    (card.Vid + ":" + card.Pid)
  );
}

function getControllerCardById(cardId) {
  var cards = controllerOverclockerState.cards || [];
  var i;
  for (i = 0; i < cards.length; i++) {
    if (getControllerCardId(cards[i]) === String(cardId || "")) return cards[i];
  }
  return null;
}

function getControllerCardByIndex(cardIndex) {
  var cards = controllerOverclockerState.cards || [];
  var idx = parseInt(cardIndex, 10);
  if (isNaN(idx) || idx < 0 || idx >= cards.length) return null;
  return cards[idx];
}

function controllerCoInferMaxRateHz(type, badge, vid, pid, childName, displayName) {
  var t = String(type || "").toLowerCase();
  var b = String(badge || "").toUpperCase();
  var v = String(vid || "").toUpperCase();
  var p = String(pid || "").toUpperCase();
  var blob = (String(childName || "") + " " + String(displayName || "")).toLowerCase();
  if (t.indexOf("dualsense") >= 0 || b.indexOf("PS5") >= 0 || b.indexOf("DUALSENSE") >= 0) return 8000;
  if (v === "054C" && /^(0CE6|0DF2|0E5F)$/.test(p)) return 8000;
  if (blob.indexOf("dualsense") >= 0 || blob.indexOf("ps5") >= 0) return 8000;
  return 1000;
}

function controllerCoFinalizeCard(card) {
  if (!card) return null;
  var maxRate = parseInt(card.MaxRateHz, 10);
  if (isNaN(maxRate) || maxRate <= 0) {
    maxRate = controllerCoInferMaxRateHz(card.Type, card.Badge, card.Vid, card.Pid, card.ChildName, card.DisplayName);
  }
  card.MaxRateHz = maxRate;
  var cur = parseInt(card.CurrentRateHz, 10);
  if (isNaN(cur)) cur = parseInt(card.ConfiguredRate, 10);
  if (isNaN(cur)) cur = 125;
  card.CurrentRateHz = cur;
  card.ConfiguredRate = cur;
  if (!card.Vid || !card.Pid) {
    var idBlob = String(card.DeviceInstanceId || card.UsbParentDeviceId || "");
    var mVid = idBlob.match(/VID_([0-9A-Fa-f]{4})/i);
    var mPid = idBlob.match(/PID_([0-9A-Fa-f]{4})/i);
    if (mVid && !card.Vid) card.Vid = mVid[1].toUpperCase();
    if (mPid && !card.Pid) card.Pid = mPid[1].toUpperCase();
  }
  card.ParentResolved = card.ParentResolved === true && !!String(card.UsbParentDeviceId || "");
  if (card.MaxRateHz >= 8000) {
    card.Type = "DualSense";
    if (!card.Badge || card.Badge.indexOf("PS5") < 0) card.Badge = "PS5 DUALSENSE";
  }
  return card;
}

function normalizeControllerCard(raw) {
  if (!raw) return null;
  var instanceId = String(raw.DeviceInstanceId || raw.InstanceId || raw.DeviceId || raw.deviceInstanceId || "");
  var usbParent = String(
    raw.UsbParentDeviceId || raw.usbParentDeviceId || raw.TargetHidusbfDeviceId ||
    raw.targetHidusbfDeviceId || raw.UsbCompositeParentId || raw.usbCompositeParentId || ""
  );
  var vid = String(raw.Vid || raw.vid || "").toUpperCase();
  var pid = String(raw.Pid || raw.pid || raw.ProductId || "").toUpperCase();
  var type = String(raw.Type || raw.type || "HID Controller");
  var badge = fixUtf8Mojibake(String(raw.Badge || raw.badge || raw.Type || raw.type || "HID CONTROLLER")).toUpperCase();
  var maxRate = parseInt(raw.MaxRateHz != null ? raw.MaxRateHz : raw.maxRateHz, 10);
  if (isNaN(maxRate) || maxRate <= 0) {
    maxRate = controllerCoInferMaxRateHz(type, badge, vid, pid, raw.ChildName, raw.DisplayName);
  }
  var cur = parseInt(raw.CurrentRateHz != null ? raw.CurrentRateHz : raw.currentRateHz, 10);
  if (isNaN(cur)) cur = parseInt(raw.ConfiguredRate != null ? raw.ConfiguredRate : raw.configuredRate, 10);
  if (isNaN(cur)) cur = 125;
  var card = {
    cardIndex: -1,
    cardId: String(raw.CardId || raw.cardId || usbParent || (vid + ":" + pid + ":" + instanceId)),
    DisplayName: fixUtf8Mojibake(String(raw.DisplayName || raw.displayName || raw.Name || raw.name || "P\u00e9riph\u00e9rique USB composite")),
    ChildName: fixUtf8Mojibake(String(raw.ChildName || raw.childName || "")),
    Name: fixUtf8Mojibake(String(raw.Name || raw.name || raw.DisplayName || "")),
    FriendlyName: fixUtf8Mojibake(String(raw.FriendlyName || raw.friendlyName || raw.DisplayName || raw.Name || "")),
    DeviceInstanceId: instanceId,
    InstanceId: instanceId,
    DeviceId: instanceId,
    Vid: vid,
    Pid: pid,
    UsbParentDeviceId: usbParent,
    UsbCompositeParentId: usbParent,
    TargetHidusbfDeviceId: usbParent,
    Type: type,
    Badge: badge,
    MaxRateHz: maxRate,
    CurrentRateHz: cur,
    ConfiguredRate: cur,
    HasFilter: !!raw.HasFilter,
    ParentResolved: raw.ParentResolved === true || raw.parentResolved === true || !!usbParent,
    Present: raw.Present !== false,
    status: null,
    statusPending: true,
    uiRequestedRate: 0
  };
  return controllerCoFinalizeCard(card);
}

function normalizeControllerDevice(raw) {
  return normalizeControllerCard(raw);
}

function parseControllerDetectJson(text) {
  if (!text) return [];
  var raw = String(text).replace(/^\uFEFF/, "");
  var data = JSON.parse(raw);
  if (!data) return [];
  var list = data.length !== undefined && typeof data.length === "number" ? data : [data];
  var out = [];
  var i;
  for (i = 0; i < list.length; i++) {
    var norm = normalizeControllerCard(list[i]);
    if (norm && (norm.InstanceId || norm.UsbParentDeviceId)) out.push(norm);
  }
  return out;
}

function readControllerDetectResult() {
  try {
    var path = getControllerOverclockerDetectJsonPath();
    if (!getFso().FileExists(path)) return null;
    return parseControllerDetectJson(readUtf8TextFileAll(path));
  } catch (eR) {
    return null;
  }
}

function refreshUsbControllers(preserveSelection, isStartup) {
  if (controllerOverclockerState.scanning) return;
  if (controllerOverclockerState.busy) return;
  var gen = ++controllerOverclockerGen;
  controllerOverclockerState.scanning = true;
  var btn = $("btnControllerOverclockerRefresh");
  if (btn) btn.disabled = true;
  if (isStartup) writeControllerOverclockerLog("[DEVICE] Startup controller scan");
  writeControllerOverclockerLog("[DEVICE] Scan started (UI)");

  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var scriptsDir = getAppScriptsDir();
  var psPath = scriptsDir ? combinePath(scriptsDir, "Devices\\Detect-USBControllers.ps1") : "";
  if (!psPath || !getFso().FileExists(psPath)) {
    setControllerOverclockerStatus("Script Detect-USBControllers.ps1 introuvable.", "error");
    writeControllerOverclockerLog("[DEVICE] Result: error script_missing");
    controllerOverclockerState.scanning = false;
    if (btn) btn.disabled = false;
    return;
  }

  var logPath = getControllerOverclockerLogPath();
  var outPath = getControllerOverclockerDetectJsonPath();
  try {
    var outDir = getFso().GetParentFolderName(outPath);
    if (outDir && !getFso().FolderExists(outDir)) getFso().CreateFolder(outDir);
    if (getFso().FileExists(outPath)) getFso().DeleteFile(outPath, true);
  } catch (eClr) {}

  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + psPath + '"' +
    ' -AppRoot "' + app + '"' +
    ' -LogPath "' + logPath + '"' +
    ' -OutputPath "' + outPath + '"';

  window.setTimeout(function () {
    if (gen !== controllerOverclockerGen) return;
    var exitCode = -1;
    try {
      exitCode = getShell().Run(cmd, 0, true);
    } catch (eRun) {
      writeControllerOverclockerLog("[DEVICE] Result: error " + String(eRun.message || eRun));
      setControllerOverclockerStatus("Erreur lors du scan.", "error");
      controllerOverclockerState.scanning = false;
      if (btn) btn.disabled = false;
      return;
    }

    var devices = readControllerDetectResult();
    if (!devices) devices = [];

    if (gen !== controllerOverclockerGen) return;
    renderControllerOverclockerDeviceList(devices);
    updateControllerOverclockerHidusbfBadge();

    if (devices.length) {
      writeControllerOverclockerLog("[DEVICE] Result: success count=" + devices.length);
    } else {
      setControllerOverclockerStatus("Aucune manette d\u00e9tect\u00e9e. Branchez une manette USB puis rafra\u00eechissez.", "warn");
      writeControllerOverclockerLog("[DEVICE] Result: success count=0");
    }

    controllerOverclockerState.scanning = false;
    if (btn) btn.disabled = false;
  }, 20);
}

function getSelectedControllerDevice() {
  if (controllerOverclockerState.cards && controllerOverclockerState.cards.length) {
    var idx = controllerOverclockerState.selectedIndex;
    if (idx >= 0 && controllerOverclockerState.cards[idx]) {
      return controllerOverclockerState.cards[idx];
    }
    return controllerOverclockerState.cards[0];
  }
  var idx = controllerOverclockerState.selectedIndex;
  if (idx < 0 || !controllerOverclockerState.devices[idx]) return null;
  return controllerOverclockerState.devices[idx];
}

function isValidControllerDeviceInstanceId(instanceId) {
  var id = String(instanceId || "").replace(/^\s+|\s+$/g, "");
  if (!id) return false;
  if (/^(test|null|none|undefined|n\/a|na)$/i.test(id)) return false;
  if (id.length < 12) return false;
  if (!/^(HID|USB)\\/i.test(id)) return false;
  if (!/VID_[0-9A-Fa-f]{4}/i.test(id)) return false;
  if (!/PID_[0-9A-Fa-f]{4}/i.test(id)) return false;
  return true;
}

function resolveControllerDeviceInstanceId(dev) {
  if (!dev) return "";
  var primary = String(dev.InstanceId || dev.DeviceId || "").replace(/^\s+|\s+$/g, "");
  if (isValidControllerDeviceInstanceId(primary)) return primary;
  var vid = String(dev.Vid || "").toUpperCase();
  var pid = String(dev.Pid || "").toUpperCase();
  var devices = controllerOverclockerState.devices || [];
  var i, d, did, bestHid = "", bestUsb = "";
  for (i = 0; i < devices.length; i++) {
    d = devices[i];
    if (!d) continue;
    if (String(d.Vid || "").toUpperCase() !== vid) continue;
    if (String(d.Pid || "").toUpperCase() !== pid) continue;
    did = String(d.InstanceId || d.DeviceId || "").replace(/^\s+|\s+$/g, "");
    if (!isValidControllerDeviceInstanceId(did)) continue;
    if (/^HID\\/i.test(did) && /MI_03/i.test(did)) return did;
    if (/^HID\\/i.test(did) && !bestHid) bestHid = did;
    if (/^USB\\/i.test(did) && !bestUsb) bestUsb = did;
  }
  if (bestHid) return bestHid;
  if (bestUsb) return bestUsb;
  return "";
}

function setControllerOverclockerButtonsBusy(busy) {
  controllerOverclockerState.busy = !!busy;
  var btn = $("btnControllerOverclockerRefresh");
  if (btn) btn.disabled = !!busy;
  if (!busy) {
    var cards = controllerOverclockerState.cards || [];
    var i;
    for (i = 0; i < cards.length; i++) {
      renderControllerCardDom(controllerCoFinalizeCard(cards[i]));
    }
  }
}

function isControllerDeviceSafeForOverclock(dev) {
  if (!dev) return false;
  var name = fixUtf8Mojibake(
    String(dev.Name || "") + " " + String(dev.FriendlyName || "") + " " + String(dev.Type || "")
  );
  if (/keyboard|clavier|mouse|souris|touchpad|trackpad/i.test(name)) return false;
  if (/dualsense|xbox|controller|game controller|scuf|ps4|ps5|manette|joystick|gamepad|hid controller|contrÃ´leur/i.test(name)) {
    return true;
  }
  if (dev.Type && /dualsense|xbox|ps4|scuf|hid controller/i.test(String(dev.Type))) return true;
  var vid = String(dev.Vid || "").toUpperCase();
  var pid = String(dev.Pid || "").toUpperCase();
  if (vid === "054C" && /^(0CE6|0DF2|05C4|09CC|0BA0|0E5F|054C|0268|0C5E)$/.test(pid)) return true;
  if (vid === "045E" && pid) return true;
  return false;
}

function escapeControllerPsArg(value) {
  return String(value || "").replace(/"/g, '""');
}

function readControllerOverclockerExitCodeFile() {
  try {
    initApplicationBaseDirectory();
    var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
    var exitPath = app ? getAbsolutePathFs(combinePath(app, "logs\\controller-overclocker-exitcode.txt")) : "";
    if (!exitPath || !getFso().FileExists(exitPath)) return null;
    var ecTxt = String(readTextFileAll(exitPath) || "").replace(/\s/g, "");
    if (ecTxt === "" || isNaN(parseInt(ecTxt, 10))) return null;
    return parseInt(ecTxt, 10);
  } catch (eEcRead) {
    return null;
  }
}

function resolveControllerOverclockerExitCode(shellExitCode) {
  var code = typeof shellExitCode === "number" ? shellExitCode : -1;
  var fileCode = readControllerOverclockerExitCodeFile();
  if (code === 259 || code === -1) {
    if (fileCode !== null && !isNaN(fileCode)) code = fileCode;
  }
  return code;
}

function findHidusbfSetupExePath() {
  var bundle = resolveHidusbfBundle();
  var fso = getFso();
  var roots = [];
  var seen = {};
  function addRoot(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d]) return;
    seen[d] = true;
    if (fso.FolderExists(d)) roots.push(d);
  }
  if (bundle.root) addRoot(bundle.root);
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) {
    addRoot(combinePath(app, "Tools\\hidusbf"));
    addRoot(combinePath(app, "tools\\hidusbf"));
  }
  var rels = [
    "Setup.exe",
    "setup.exe",
    "USB Devices Rate Setup.exe",
    "DRIVER\\Setup.exe",
    "hidusbf\\DRIVER\\Setup.exe",
    "HIDUSBF\\DRIVER\\Setup.exe"
  ];
  var i;
  var j;
  for (i = 0; i < roots.length; i++) {
    for (j = 0; j < rels.length; j++) {
      var p = getAbsolutePathFs(combinePath(roots[i], rels[j]));
      if (p && fso.FileExists(p)) {
        writeControllerOverclockerLog("[DEVICE] HIDUSBF setup exe found: " + p);
        return p;
      }
    }
    var treeHit = findSetupExeInTree(fso, roots[i], 0);
    if (treeHit) {
      writeControllerOverclockerLog("[DEVICE] HIDUSBF setup exe found: " + treeHit);
      return treeHit;
    }
  }
  writeControllerOverclockerLog("[DEVICE] HIDUSBF setup exe found: none");
  return "";
}

function isHidusbfSetupPresent() {
  return !!findHidusbfSetupExePath();
}

function launchHidusbfSetupExe(setupPath) {
  if (!setupPath) return false;
  try {
    initApplicationBaseDirectory();
    createUnrealFolders();
    var outerPath = UNREAL_LOGS + "\\open-hidusbf-setup.ps1";
    var esc = function (s) { return String(s || "").replace(/'/g, "''"); };
    var tw = getFso().CreateTextFile(outerPath, true);
    tw.Write(
      "$ErrorActionPreference = 'Continue'\r\n" +
      "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8\r\n" +
      "$OutputEncoding = [System.Text.Encoding]::UTF8\r\n" +
      "Start-Process -FilePath '" + esc(setupPath) + "' -ArgumentList '/all' -Verb RunAs\r\n"
    );
    tw.Close();
    getShell().Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + outerPath + '"', 0, false);
    return true;
  } catch (eLaunch) {
    return false;
  }
}

function openHidusbfSetupFromTools(skipAssistedUi) {
  var setupPath = findHidusbfSetupExePath();
  if (!setupPath) {
    setControllerOverclockerStatus("HIDUSBF Setup introuvable", "error");
    alert("HIDUSBF Setup introuvable.\n\nPlacez Setup.exe dans Tools\\hidusbf\\.");
    return;
  }
  writeControllerOverclockerLog("[DEVICE] Open HIDUSBF Setup clicked: " + setupPath);
  if (!launchHidusbfSetupExe(setupPath)) {
    setControllerOverclockerStatus("Impossible de lancer HIDUSBF Setup.", "error");
    alert("Impossible de lancer HIDUSBF Setup.");
    return;
  }
  if (!skipAssistedUi) {
    logControllerAssistedSetupOpened();
    showControllerAssistedGuide(0);
    setControllerAssistedSetupStatus();
  }
}

function runControllerOverclockerScriptSync(scriptFileName, params) {
  initApplicationBaseDirectory();
  createUnrealFolders();
  clearControllerOcApplyArtifacts();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var scriptsDir = getAppScriptsDir();
  var psPath = scriptsDir ? getAbsolutePathFs(combinePath(scriptsDir, "Devices\\" + scriptFileName)) : "";
  if (!psPath || !getFso().FileExists(psPath)) {
    return { exitCode: 127, error: "script_missing" };
  }
  var logPath = getControllerOverclockerLogPath();
  var exitPath = app ? getAbsolutePathFs(combinePath(app, "logs\\controller-overclocker-exitcode.txt")) : "";
  var resultPath = getControllerOverclockerApplyResultPath();
  var outPath = UNREAL_LOGS + "\\controller-overclocker-last-stdout.txt";
  var errPath = UNREAL_LOGS + "\\controller-overclocker-last-stderr.txt";
  var rateForPs = params.rate ? parseInt(params.rate, 10) : 0;
  if (isNaN(rateForPs)) rateForPs = 0;
  writeControllerOverclockerLog("[DEVICE] HARD_RATE=" + rateForPs);
  writeControllerOverclockerLog("[DEVICE] Passed RateHz=" + rateForPs);
  var paramPath = writeControllerOverclockerParamsFile(app, logPath, params);
  var instanceId = String(params.instanceId || "");
  var usbParent = String(params.usbParentDeviceId || "");
  var vid = String(params.vid || "");
  var pid = String(params.pid || "");

  try {
    if (getFso().FileExists(outPath)) getFso().DeleteFile(outPath, true);
    if (getFso().FileExists(errPath)) getFso().DeleteFile(errPath, true);
  } catch (eDel2) {}

  var exitCode = -1;
  var esc = function (s) { return String(s || "").replace(/'/g, "''"); };
  var runBody =
    "$ErrorActionPreference = 'Continue'\r\n" +
    "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8\r\n" +
    "$OutputEncoding = [System.Text.Encoding]::UTF8\r\n" +
    "$psPath = '" + esc(psPath) + "'\r\n" +
    "$argList = @('-NoProfile','-ExecutionPolicy','Bypass','-File', $psPath, '-AppRoot', '" + esc(app) + "', '-LogPath', '" + esc(logPath) + "', '-ResultPath', '" + esc(resultPath) + "', '-DeviceInstanceId', '" + esc(instanceId) + "', '-UsbParentDeviceId', '" + esc(usbParent) + "', '-Vid', '" + esc(vid) + "', '-Pid', '" + esc(pid) + "'" +
    (params.uninstall ? ", '-Uninstall'" : (", '-RateHz', '" + esc(String(rateForPs)) + "'" + (params.maxRateHz ? (", '-MaxRateHz', '" + esc(String(params.maxRateHz)) + "'") : ""))) + ")\r\n" +
    "$outPath = '" + esc(outPath) + "'\r\n" +
    "$errPath = '" + esc(errPath) + "'\r\n" +
    "$logPath = '" + esc(logPath) + "'\r\n" +
    "$exitPath = '" + esc(exitPath) + "'\r\n" +
    "try {\r\n" +
    "  $p = Start-Process -FilePath 'powershell.exe' -ArgumentList $argList -Wait -PassThru -NoNewWindow -RedirectStandardOutput $outPath -RedirectStandardError $errPath\r\n" +
    "  $c = 0; if ($p) { $c = [int]$p.ExitCode }\r\n" +
    "  if ($exitPath -and (Test-Path -LiteralPath $exitPath)) {\r\n" +
    "    $fromFile = (Get-Content -LiteralPath $exitPath -Raw -ErrorAction SilentlyContinue).Trim()\r\n" +
    "    if ($fromFile -match '^\\d+$') { $c = [int]$fromFile }\r\n" +
    "  }\r\n" +
    "  if ($logPath -and (Test-Path -LiteralPath $outPath)) {\r\n" +
    "    Add-Content -LiteralPath $logPath -Value '[DEVICE-AUTO] --- stdout ---' -Encoding UTF8\r\n" +
    "    Get-Content -LiteralPath $outPath -ErrorAction SilentlyContinue | ForEach-Object { Add-Content -LiteralPath $logPath -Value ('[DEVICE-AUTO] stdout=' + $_) -Encoding UTF8 }\r\n" +
    "  }\r\n" +
    "  if ($logPath -and (Test-Path -LiteralPath $errPath)) {\r\n" +
    "    Add-Content -LiteralPath $logPath -Value '[DEVICE-AUTO] --- stderr ---' -Encoding UTF8\r\n" +
    "    Get-Content -LiteralPath $errPath -ErrorAction SilentlyContinue | ForEach-Object { Add-Content -LiteralPath $logPath -Value ('[DEVICE-AUTO] stderr=' + $_) -Encoding UTF8 }\r\n" +
    "  }\r\n" +
    "  exit $c\r\n" +
    "} catch {\r\n" +
    "  if ($exitPath) { Set-Content -LiteralPath $exitPath -Value 3 -Encoding ascii -Force }\r\n" +
    "  exit 3\r\n" +
    "}\r\n";

  if (isRunningAsAdmin()) {
    var wrapperPath = UNREAL_LOGS + "\\controller-overclocker-run.ps1";
    var twRun = getFso().CreateTextFile(wrapperPath, true);
    twRun.Write(runBody);
    twRun.Close();
    exitCode = getShell().Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + wrapperPath + '"', 0, true);
    exitCode = resolveControllerOverclockerExitCode(exitCode);
  } else {
    var wrapperPath2 = UNREAL_LOGS + "\\controller-overclocker-run.ps1";
    var twRun2 = getFso().CreateTextFile(wrapperPath2, true);
    twRun2.Write(runBody);
    twRun2.Close();
    var outerPath = UNREAL_LOGS + "\\controller-overclocker-elev.ps1";
    var tw = getFso().CreateTextFile(outerPath, true);
    var body =
      "$ErrorActionPreference = 'Continue'\r\n" +
      "try {\r\n" +
      "  $p = Start-Process -FilePath 'powershell.exe' -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File','" + esc(wrapperPath2) + "') -Verb RunAs -PassThru -Wait -ErrorAction Stop\r\n" +
      "  $c = 0; if ($p) { $c = [int]$p.ExitCode }\r\n" +
      "  exit $c\r\n" +
      "} catch {\r\n" +
      "  exit 3\r\n" +
      "}\r\n";
    tw.Write(body);
    tw.Close();
    exitCode = getShell().Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + outerPath + '"', 0, true);
    exitCode = resolveControllerOverclockerExitCode(exitCode);
  }
  appendControllerAutoCapturedOutput();
  return { exitCode: exitCode, applyResult: readControllerApplyResultJson() };
}

function runControllerOverclockerActionForCard(card, action, rateHz) {
  if (!card) return;
  if (controllerOverclockerState.busy) return;
  card = controllerCoFinalizeCard(card);
  var cardId = getControllerCardId(card);
  controllerOverclockerState.busyCardId = cardId;
  controllerOverclockerState.busy = true;
  var dev = card;
  if (!isControllerDeviceSafeForOverclock(dev)) {
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    alert("S\u00e9curit\u00e9 : p\u00e9riph\u00e9rique non autoris\u00e9.");
    return;
  }
  if (!dev.Vid || !dev.Pid) {
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    setControllerOverclockerStatus("VID/PID manquants \u2014 rafra\u00eechis la liste.", "error");
    return;
  }
  var appliedInstanceId = String(dev.DeviceInstanceId || "");
  if (!isValidControllerDeviceInstanceId(appliedInstanceId)) {
    appliedInstanceId = resolveControllerDeviceInstanceId(dev);
  }
  if (!isValidControllerDeviceInstanceId(appliedInstanceId)) {
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    alert("Aucun vrai p\u00e9riph\u00e9rique s\u00e9lectionn\u00e9.");
    return;
  }
  var usbParentId = String(dev.UsbParentDeviceId || dev.TargetHidusbfDeviceId || "");
  if (!usbParentId) {
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    setControllerOverclockerStatus("Parent USB composite introuvable", "error");
    return;
  }
  if (!isHidusbfBundledPresent()) {
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    setControllerOverclockerStatus("HIDUSBF extrait introuvable dans Tools\\hidusbf", "error");
    return;
  }
  if (action === "apply") {
    var applyRateCheck = parseInt(rateHz, 10);
    if (applyRateCheck !== 1000 && applyRateCheck !== 8000) {
      controllerOverclockerState.busy = false;
      controllerOverclockerState.busyCardId = "";
      return;
    }
    if (applyRateCheck > parseInt(dev.MaxRateHz, 10)) {
      controllerOverclockerState.busy = false;
      controllerOverclockerState.busyCardId = "";
      setControllerOverclockerStatus("Cette manette ne supporte pas " + applyRateCheck + " Hz", "error");
      return;
    }
    dev.uiRequestedRate = applyRateCheck;
    renderControllerCardDom(dev);
  }
  setControllerOverclockerButtonsBusy(true);
  setControllerOverclockerStatus(action === "restore" ? "Restauration en cours..." : "Application en cours...", "info");
  window.setTimeout(function () {
    var applyRate = action === "restore" ? 125 : rateHz;
    writeControllerOverclockerLog("[DEVICE] Passed RateHz=" + applyRate);
    var result = runControllerOverclockerScriptSync("Apply-ControllerOC.ps1", {
      instanceId: appliedInstanceId,
      usbParentDeviceId: usbParentId,
      vid: dev.Vid || "",
      pid: dev.Pid || "",
      maxRateHz: parseInt(dev.MaxRateHz, 10) || 1000,
      rate: action === "restore" ? 125 : (rateHz || 0),
      uninstall: action === "restore",
      mode: action === "restore" ? "Restore" : "Apply"
    });
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    setControllerOverclockerButtonsBusy(false);
    var exitCode = result && typeof result.exitCode === "number" ? result.exitCode : -1;
    var applyResult = result && result.applyResult ? result.applyResult : readControllerApplyResultJson();
    handleControllerCardApplyResult(dev, applyResult, applyRate, exitCode, action);
    window.setTimeout(function () {
      try { refreshUsbControllers(appliedInstanceId); } catch (eRef) {}
    }, 1200);
  }, 20);
}

function handleControllerCardApplyResult(card, applyResult, requestedRate, exitCode, action) {
  if (!card) return;
  if (applyResult && applyResult.Code === "RATE_NOT_SUPPORTED_BY_CONTROLLER") {
    setControllerOverclockerStatus(fixUtf8Mojibake(String(applyResult.Message || "Rate non support\u00e9")), "error");
    renderControllerCardDom(card);
    return;
  }
  if (action === "apply") {
    handleControllerApplyResult(applyResult, requestedRate);
  } else if (applyResult && applyResult.Success) {
    setControllerOverclockerStatus("D\u00e9faut restaur\u00e9", "success");
  }
  card.uiRequestedRate = requestedRate;
  refreshControllerCardStatus(
    (function () {
      var i;
      for (i = 0; i < controllerOverclockerState.cards.length; i++) {
        if (getControllerCardId(controllerOverclockerState.cards[i]) === getControllerCardId(card)) return i;
      }
      return 0;
    })(),
    function () {}
  );
}

function runControllerOverclockerAction(action, rateHz) {
  if (controllerOverclockerState.busy) return;
  var dev = getSelectedControllerDevice();
  if (!dev) {
    alert("Aucune manette d\u00e9tect\u00e9e. Rafra\u00eechis la liste.");
    return;
  }
  if (controllerOverclockerState.cards && controllerOverclockerState.cards.length) {
    runControllerOverclockerActionForCard(dev, action, rateHz);
    return;
  }
  if (!isControllerDeviceSafeForOverclock(dev)) {
    var devLabel = fixUtf8Mojibake(
      String(dev.Name || "") + " " + String(dev.FriendlyName || "") + " " + String(dev.Type || "")
    );
    if (/keyboard|clavier|mouse|souris|touchpad|trackpad/i.test(devLabel)) {
      alert("S\u00e9curit\u00e9 : p\u00e9riph\u00e9rique clavier/souris non modifi\u00e9.");
    } else {
      alert("S\u00e9curit\u00e9 : seuls les manettes/contr\u00f4leurs de jeu sont autoris\u00e9s.");
    }
    writeControllerOverclockerLog("[DEVICE] Result: error blocked_input_device");
    setControllerOverclockerStatus("S\u00e9curit\u00e9 : p\u00e9riph\u00e9rique non autoris\u00e9.", "error");
    return;
  }
  if (!dev.Vid || !dev.Pid) {
    alert("VID/PID manquants pour ce p\u00e9riph\u00e9rique. Rafra\u00eechis la liste.");
    setControllerOverclockerStatus("VID/PID manquants \u2014 rafra\u00eechis la liste.", "error");
    return;
  }

  var appliedInstanceId = resolveControllerDeviceInstanceId(dev);
  if (!isValidControllerDeviceInstanceId(appliedInstanceId)) {
    writeControllerOverclockerLog("[HIDUSBF-AUTO] ERROR invalid DeviceInstanceId from UI");
    writeControllerOverclockerLog("[DEVICE] Rejected DeviceInstanceId=" + String(dev.InstanceId || dev.DeviceId || ""));
    alert("Aucun vrai p\u00e9riph\u00e9rique s\u00e9lectionn\u00e9.\n\nChoisis une manette dans la liste (HID\\VID_... ou USB\\VID_...).");
    setControllerOverclockerStatus("Aucun vrai p\u00e9riph\u00e9rique s\u00e9lectionn\u00e9.", "error");
    return;
  }
  var usbParentId = String(dev.TargetHidusbfDeviceId || dev.UsbCompositeParentId || dev.UsbParentDeviceId || "");
  writeControllerOverclockerLog("[DEVICE] Selected DeviceInstanceId=" + appliedInstanceId);
  writeControllerOverclockerLog("[DEVICE] Selected UsbParentDeviceId=" + (usbParentId || "(empty, script will resolve)"));
  writeControllerOverclockerLog("[DEVICE] Selected TargetHidusbfDeviceId=" + (usbParentId || "(resolve in script)"));

  if (!isHidusbfBundledPresent()) {
    setControllerOverclockerStatus("HIDUSBF extrait introuvable dans Tools\\hidusbf", "error");
    alert("HIDUSBF extrait introuvable dans Tools\\hidusbf.\n\nVerifiez que le dossier extrait est present (ex: Tools\\hidusbf\\hidusbf\\DRIVER\\).");
    return;
  }

  if (action === "apply") {
    var applyRateCheck = parseInt(rateHz, 10);
    if (applyRateCheck !== 1000 && applyRateCheck !== 8000) {
      setControllerOverclockerStatus("Rate invalide (1000 ou 8000 uniquement)", "error");
      return;
    }
    controllerOverclockerState.uiLastClickedRate = applyRateCheck;
    updateControllerApplyUi();
  } else {
    writeControllerOverclockerLog("[DEVICE] Restore default clicked");
  }
  writeControllerOverclockerLog("[DEVICE] VID/PID: " + dev.Vid + "/" + dev.Pid);
  var scriptName = "Apply-ControllerOC.ps1";
  setControllerOverclockerButtonsBusy(true);
  if (action === "restore") {
    setControllerOverclockerStatus("Restauration en cours...", "info");
  } else {
    setControllerOverclockerStatus("Application en cours...", "info");
  }
  window.setTimeout(function () {
    var applyRate = action === "restore" ? 125 : rateHz;
    writeControllerOverclockerLog("[DEVICE] Apply OC clicked rate=" + applyRate);
    writeControllerOverclockerLog("[DEVICE] Passed RateHz=" + applyRate);
    writeControllerOverclockerLog("[DEVICE] DeviceInstanceId=" + appliedInstanceId);
    writeControllerOverclockerLog("[DEVICE] UsbParentDeviceId=" + usbParentId);
    var result = runControllerOverclockerScriptSync(scriptName, {
      instanceId: appliedInstanceId,
      usbParentDeviceId: usbParentId,
      vid: dev.Vid || "",
      pid: dev.Pid || "",
      rate: action === "restore" ? 125 : (rateHz || 0),
      uninstall: action === "restore",
      mode: action === "restore" ? "Restore" : "Apply"
    });
    var exitCode = result && typeof result.exitCode === "number" ? result.exitCode : -1;
    var applyResult = result && result.applyResult ? result.applyResult : readControllerApplyResultJson();
    writeControllerOverclockerLog("[DEVICE] Script exit=" + exitCode);
    if (applyResult) writeControllerOverclockerLog("[DEVICE] JSON result=" + JSON.stringify(applyResult));
    if (applyResult && applyResult.Code) {
      writeControllerOverclockerLog("[DEVICE] Apply result code: " + applyResult.Code);
    }

    if (action === "apply" && rateHz) {
      handleControllerApplyResult(applyResult, rateHz);
      if (applyResult && (applyResult.Code === "APPLIED_1000_CONFIRMED" || applyResult.Code === "APPLIED_8000_CONFIRMED" || applyResult.Code === "APPLIED_CONFIRMED_1000" || applyResult.Code === "APPLIED_CONFIRMED_8000")) {
        hideControllerAssistedGuide();
        window.setTimeout(function () {
          try { refreshUsbControllers(appliedInstanceId); } catch (eRefOk) {}
        }, 1200);
      } else if (exitCode === 0 && applyResult && applyResult.Success === true && applyResult.Code === "PREPARED_NEEDS_RECONNECT") {
        hideControllerAssistedGuide();
        window.setTimeout(function () {
          try { refreshUsbControllers(appliedInstanceId); } catch (eRefPrep) {}
        }, 1200);
      }
    } else if (exitCode === 0 && applyResult && applyResult.Success === true && action === "restore") {
      setControllerOverclockerStatus("Default d\u00e9tect\u00e9", "success");
      hideControllerAssistedGuide();
      window.setTimeout(function () {
        try { refreshUsbControllers(appliedInstanceId); } catch (eRefOk) {}
      }, 1200);
    } else if (exitCode === 20 || (applyResult && applyResult.Code === "NOT_ADMIN")) {
      writeControllerOverclockerLog("[DEVICE] Result: error not_admin");
      setControllerOverclockerStatus(
        fixUtf8Mojibake(applyResult && applyResult.Message ? applyResult.Message : "Droits administrateur requis pour appliquer HIDUSBF"),
        "error"
      );
    } else if (exitCode === 3) {
      writeControllerOverclockerLog("[DEVICE] Result: error uac_cancelled");
      setControllerOverclockerStatus("Op\u00e9ration annul\u00e9e (UAC).", "warn");
    } else if (exitCode === 4) {
      writeControllerOverclockerLog("[DEVICE] Result: error blocked_device");
      setControllerOverclockerStatus("S\u00e9curit\u00e9 : p\u00e9riph\u00e9rique clavier/souris non modifi\u00e9.", "error");
    } else if (exitCode === 1 || (applyResult && (applyResult.Code === "DEVICE_NOT_FOUND" || applyResult.Code === "INVALID_DEVICE_INSTANCE_ID"))) {
      writeControllerOverclockerLog("[DEVICE] Result: error no_device");
      setControllerOverclockerStatus(
        fixUtf8Mojibake(applyResult && applyResult.Message ? applyResult.Message : "Aucun vrai p\u00e9riph\u00e9rique s\u00e9lectionn\u00e9"),
        "error"
      );
    } else if (exitCode === 40 || (applyResult && applyResult.Code === "RATE_NOT_SUPPORTED_BY_CONTROLLER")) {
      setControllerOverclockerStatus(fixUtf8Mojibake(String(applyResult && applyResult.Message ? applyResult.Message : "Cette manette ne supporte pas ce rate")), "error");
    } else if (exitCode === 31 || (applyResult && (applyResult.Code === "USB_PARENT_NOT_FOUND" || applyResult.Code === "USB_PARENT_KEY_MISSING" || applyResult.Code === "USB_COMPOSITE_NOT_FOUND"))) {
      writeControllerOverclockerLog("[DEVICE] Result: error usb_composite_not_found");
      hideControllerAssistedGuide();
      setControllerOverclockerStatus("Parent USB composite introuvable", "error");
    } else if (exitCode === 32 || (applyResult && applyResult.Code === "WRONG_TARGET_MI_INTERFACE")) {
      writeControllerOverclockerLog("[DEVICE] Result: error wrong_target_mi");
      hideControllerAssistedGuide();
      setControllerOverclockerStatus("Cible HIDUSBF invalide (interface MI)", "error");
    } else if (action === "apply" || action === "restore") {
      var failMsg = applyResult && applyResult.Message
        ? fixUtf8Mojibake(String(applyResult.Message))
        : ("Erreur Controller OC (code " + exitCode + ")");
      writeControllerOverclockerLog("[DEVICE] Result: error");
      setControllerOverclockerStatus(failMsg, "error");
    } else {
      var errMsg = applyResult && applyResult.Message
        ? fixUtf8Mojibake(String(applyResult.Message))
        : ("Erreur (code " + exitCode + ")");
      writeControllerOverclockerLog("[DEVICE] Result: error");
      setControllerOverclockerStatus(errMsg, "error");
    }

    setControllerOverclockerButtonsBusy(false);
    window.setTimeout(function () {
      try { refreshControllerPollingStatus({ silent: false }); } catch (eAfterAct) {}
    }, exitCode === 0 ? 1200 : 400);
  }, 20);
}

function restoreControllerPollingDefault() {
  runControllerOverclockerAction("restore", 0);
}

function onControllerOverclockerSelectChange() {
  updateControllerOverclockerSelectionUi();
  var dev = getSelectedControllerDevice();
  if (dev) {
    writeControllerOverclockerLog(
      "[DEVICE] Selected controller=" + String(dev.InstanceId || dev.DeviceId || "") +
      " vid=" + (dev.Vid || "") + " pid=" + (dev.Pid || "")
    );
    controllerOverclockerState.statusPending = true;
    setControllerOverclockerPendingUi();
    try { refreshControllerPollingStatus({ silent: false }); } catch (eSelSt) {}
  } else {
    controllerOverclockerState.statusPending = false;
    renderControllerPollingStatusUi(null);
  }
}

function ensureControllerPollingStatusPanels() {
  /* Legacy no-op: compact widget markup is static in page-peripheral. */
}

function initControllerOverclockerUi() {
  updateControllerOverclockerHidusbfBadge();
  var sel = $("controllerOverclockerSelect");
  if (sel) sel.onchange = onControllerOverclockerSelectChange;
  controllerOverclockerState.statusPending = true;
  controllerOverclockerState.statusLoaded = false;
  setControllerOverclockerPendingUi();
  updateControllerApplyUi();
  hideControllerAssistedGuide();
  ensureControllerOverclockerWatcher();
}

/* ---------- Onglet PÃ©riphÃ©rique : HIDUSBF (zip + extraction sur le Bureau uniquement) ---------- */
var HIDUSBF_URL = "https://raw.githubusercontent.com/LordOfMice/hidusbf/master/hidusbf.zip";

function getUserDesktopDirectory() {
  try {
    return getShell().SpecialFolders("Desktop");
  } catch (eDesk) {
    return "";
  }
}

function hidUpper(s) {
  return (s || "").toString().toUpperCase();
}

function logHidusbf(message) {
  var box = $("hidusbfLogBox");
  if (!box) return;
  var line = document.createElement("div");
  line.className = "logline";
  line.textContent = "[" + nowTime() + "] " + message;
  box.insertBefore(line, box.firstChild);
  while (box.childNodes.length > 40) box.removeChild(box.lastChild);
}

function findSetupExeInTree(fso, dir, depth) {
  if (!dir || depth > 5 || !fso.FolderExists(dir)) return "";
  try {
    var folder = fso.GetFolder(dir);
    var fc = new Enumerator(folder.Files);
    for (; !fc.atEnd(); fc.moveNext()) {
      var f = fc.item();
      var n = String(f.Name || "");
      if (hidUpper(n) === "SETUP.EXE") return f.Path;
    }
    var fe = new Enumerator(folder.SubFolders);
    for (; !fe.atEnd(); fe.moveNext()) {
      var sub = fe.item().Path;
      var got = findSetupExeInTree(fso, sub, depth + 1);
      if (got) return got;
    }
  } catch (eTree) {}
  return "";
}

function locateHidusbfSetupOnDesktop(fso, desk) {
  var extractDir = desk + "\\HIDUSBF";
  if (!fso.FolderExists(extractDir)) return "";
  return findSetupExeInTree(fso, extractDir, 0);
}

/** DÃ©compresse hidusbf.zip sur le Bureau vers Bureau\\HIDUSBF (script temporaire dans %TEMP% uniquement). */
function expandHidusbfZipOnDesktop(zipPath, extractDir) {
  var fso = getFso();
  var tmp = fso.GetSpecialFolder(2);
  var psPath = tmp + "\\unreal-hidusbf-expand.ps1";
  var z = zipPath.replace(/'/g, "''");
  var d = extractDir.replace(/'/g, "''");
  var body =
    "$ErrorActionPreference='Stop'\r\n" +
    "if (Test-Path -LiteralPath '" +
    d +
    "') { Remove-Item -LiteralPath '" +
    d +
    "' -Recurse -Force -ErrorAction SilentlyContinue }\r\n" +
    "New-Item -ItemType Directory -Force -Path '" +
    d +
    "' | Out-Null\r\n" +
    "Unblock-File -LiteralPath '" +
    z +
    "' -ErrorAction SilentlyContinue\r\n" +
    "Expand-Archive -LiteralPath '" +
    z +
    "' -DestinationPath '" +
    d +
    "' -Force\r\n" +
    "exit 0\r\n";
  try {
    var tw = fso.CreateTextFile(psPath, true);
    tw.Write(body);
    tw.Close();
  } catch (eW) {
    return false;
  }
  return getShell().Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psPath + "\"", 0, true) === 0;
}

function downloadOrLaunchHidusbf() {
  var fso = getFso();
  var desk = getUserDesktopDirectory();
  if (!desk) {
    logHidusbf("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
    alert("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
    return;
  }
  var zipPath = desk + "\\hidusbf.zip";
  var extractDir = desk + "\\HIDUSBF";
  try {
    var exePath = locateHidusbfSetupOnDesktop(fso, desk);
    if (exePath) {
      logHidusbf("Lancement de HIDUSBF...");
      try {
        launchFileAsAdmin(exePath);
      } catch (eLaunch) {
        alert("Impossible de lancer HIDUSBF.");
      }
      return;
    }

    logHidusbf("TÃ©lÃ©chargement de HIDUSBF...");
    try {
      downloadFile(HIDUSBF_URL, zipPath);
    } catch (eDl) {
      logHidusbf("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
      alert("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
      return;
    }
    if (!fso.FileExists(zipPath) || fso.GetFile(zipPath).Size < 50000) {
      logHidusbf("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
      alert("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
      return;
    }
    if (!expandHidusbfZipOnDesktop(zipPath, extractDir)) {
      logHidusbf("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
      alert("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
      return;
    }
    exePath = locateHidusbfSetupOnDesktop(fso, desk);
    if (!exePath) {
      logHidusbf("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
      alert("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
      return;
    }
    logHidusbf("HIDUSBF tÃ©lÃ©chargÃ© sur le Bureau.");
    logHidusbf("Lancement de HIDUSBF...");
    try {
      launchFileAsAdmin(exePath);
    } catch (e2) {
      alert("Impossible de lancer HIDUSBF.");
    }
  } catch (e0) {
    logHidusbf("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
    alert("Erreur : impossible de tÃ©lÃ©charger HIDUSBF.");
  }
}

/* ---------- TCP Optimizer 4  â€” tÃ©lÃ©chargement PowerShell multi-mÃ©thodes ---------- */

/** Script PS : Invoke-WebRequest  â†’  WebClient  â†’  BITSAdmin (secours). */
function buildTcpDownloadPsScript() {
  var u = TCP_OPTIMIZER_URL.replace(/'/g, "''");
  var o = TCP_OPTIMIZER_PATH.replace(/'/g, "''");
  var lines = [
    "$ErrorActionPreference='SilentlyContinue'",
    "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12",
    "$Url = '" + u + "'",
    "$OutPath = '" + o + "'",
    "function Test-ExeOk($p) {",
    "  if (-not (Test-Path $p)) { return $false }",
    "  $i = Get-Item -LiteralPath $p -ErrorAction SilentlyContinue",
    "  if (-not $i) { return $false }",
    "  return ($i.Length -gt 50000)",
    "}",
    "$dir = Split-Path -Parent $OutPath",
    "if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }",
    "if (Test-Path $OutPath) { Remove-Item -LiteralPath $OutPath -Force -ErrorAction SilentlyContinue }",
    "$ok = $false",
    "try {",
    "  Invoke-WebRequest -Uri $Url -OutFile $OutPath -UseBasicParsing",
    "  if (Test-ExeOk $OutPath) { $ok = $true }",
    "} catch {}",
    "if (-not $ok) {",
    "  try {",
    "    $wc = New-Object System.Net.WebClient",
    "    $wc.DownloadFile($Url, $OutPath)",
    "    if (Test-ExeOk $OutPath) { $ok = $true }",
    "  } catch {}",
    "}",
    "if (-not $ok) {",
    "  try {",
    "    $job = 'UNREALTCP' + (Get-Random -Maximum 99999)",
    "    $a = @('/transfer', $job, '/download', '/priority', 'high', $Url, $OutPath)",
    "    $p = Start-Process -FilePath bitsadmin.exe -ArgumentList $a -Wait -PassThru -WindowStyle Hidden",
    "    if ((Test-ExeOk $OutPath)) { $ok = $true }",
    "  } catch {}",
    "}",
    "if ($ok) { exit 0 } else { exit 1 }"
  ];
  return lines.join("\r\n");
}

/** true si le processus HTA a des droits administrateur (nÃ©cessaire pour profil TCP). */
function isRunningAsAdmin() {
  try {
    return getShell().Run("net session", 0, true) === 0;
  } catch (e0) {
    return false;
  }
}

function refreshConnAdminBanner() {
  var el = $("connAdminBanner");
  if (!el) return;
  if (isRunningAsAdmin()) {
    el.className = "conn-admin-ok";
    el.innerText = "PrÃªt : les optimisations rÃ©seau peuvent Ãªtre appliquÃ©es directement.";
  } else {
    el.className = "conn-admin-banner";
    el.innerText = "Pour le profil gaming, une demande d'Ã©lÃ©vation Windows peut apparaÃ®tre : accepte-la pour enregistrer les rÃ©glages.";
  }
  refreshConnQoSNlaUi();
}

function setConnOptimizationStatus(isOptimized) {
  var el = $("connOptimizeStatus");
  if (!el) return;
  var meta = $("connOptimizeLast");
  if (isOptimized) {
    el.className = "tcp-badge tcp-badge--ok";
    el.innerText = "Connexion optimisÃ©e";
  } else {
    el.className = "tcp-badge";
    el.innerText = "Non optimisÃ©";
  }
  if (!meta) return;
  var st = readTcpOptimizerState();
  if (st && st.tcpOptimizerLastApplied) {
    meta.innerText = "DerniÃ¨re optimisation : " + st.tcpOptimizerLastApplied;
  } else {
    meta.innerText = "DerniÃ¨re optimisation : â€”";
  }
}

function getLocalUnrealDir() {
  var base = "";
  try { base = getShell().ExpandEnvironmentStrings("%LOCALAPPDATA%"); } catch (e0) {}
  if (!base) return "";
  return base + "\\Unreal";
}

function tcpOptimizerStatePath() {
  var d = getLocalUnrealDir();
  if (!d) return "";
  return d + "\\settings.json";
}

/** Alias pour persistance JSON pilote (mÃªme fichier que TCP si prÃ©sent). */
function getNvSettingsPath() {
  return tcpOptimizerStatePath();
}

function readTcpOptimizerState() {
  try {
    var p = tcpOptimizerStatePath();
    if (!p) return null;
    var txt = readTextFileAll(p);
    if (!txt) return null;
    return JSON.parse(txt);
  } catch (e) { return null; }
}

function writeTcpOptimizerState(next) {
  try {
    var d = getLocalUnrealDir();
    var p = tcpOptimizerStatePath();
    if (!d || !p) return false;
    var fso = getFso();
    if (!fso.FolderExists(d)) fso.CreateFolder(d);
    var prev = readTcpOptimizerState() || {};
    var out = {};
    var k;
    for (k in prev) if (prev.hasOwnProperty(k)) out[k] = prev[k];
    for (k in next) if (next.hasOwnProperty(k)) out[k] = next[k];
    var tw = fso.CreateTextFile(p, true);
    tw.Write(JSON.stringify(out, null, 2));
    tw.Close();
    return true;
  } catch (eW) {
    log("Impossible d'Ã©crire settings.json (TCP) : " + eW.message);
    return false;
  }
}

function queryRegValueText(keyPath, valueName) {
  try {
    createUnrealFolders();
    var outPath = UNREAL_LOGS + "\\tmp-reg-" + Date.now() + "-" + Math.floor(Math.random() * 10000) + ".txt";
    var cmd = "cmd /c reg query \"" + keyPath + "\" /v \"" + valueName + "\" > \"" + outPath + "\" 2>&1";
    getShell().Run(cmd, 0, true);
    var txt = readTextFileAll(outPath);
    try { if (getFso().FileExists(outPath)) getFso().DeleteFile(outPath, true); } catch (eDel) {}
    return txt || "";
  } catch (eQ) { return ""; }
}

function detectTcpOptimizerGamingApplied() {
  var checks = [
    { key: "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile", name: "NetworkThrottlingIndex", expected: /REG_DWORD\s+0xFFFFFFFF/i },
    { key: "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile", name: "SystemResponsiveness", expected: /REG_DWORD\s+0x0\b/i },
    { key: "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters", name: "TcpMaxSynRetransmissions", expected: /REG_DWORD\s+0x2\b/i },
    { key: "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters", name: "NonSackRttResiliency", expected: /REG_DWORD\s+0x0\b/i }
  ];
  var i;
  for (i = 0; i < checks.length; i++) {
    var t = queryRegValueText(checks[i].key, checks[i].name);
    if (!t || !checks[i].expected.test(t)) return false;
  }
  return true;
}

function refreshConnOptimizationStatusFromState() {
  var st = readTcpOptimizerState() || {};
  var fromState = !!st.tcpOptimizerApplied;
  var real = false;
  try { real = detectTcpOptimizerGamingApplied(); } catch (eD) { real = fromState; }
  var finalState = real || fromState;
  setConnOptimizationStatus(finalState);
}

/** LibellÃ© UI pour la relecture reg query Â« Do not use NLA Â» (REG_SZ). */
function mapQoSNlaRegQueryToUiLabel(regOut) {
  var t = (regOut || "").replace(/^\s+|\s+$/g, "");
  if (!t) return "N/A";
  if (/ERROR|Unable\s+to\s+find|introuvable|Impossible\s+de\s+trouver|Cannot\s+find|accÃ¨s\s+refusÃ©|Access\s+is\s+denied/i.test(t)) return "N/A";
  if (/REG_SZ\s+1(\s|$)/i.test(t)) return "optimal: 1";
  if (/REG_SZ/i.test(t)) return "non optimal";
  return "N/A";
}

/** Met Ã  jour la ligne Connexion Â· QoS Â· Do not use NLA depuis le registre (reg query). */
function refreshConnQoSNlaUi() {
  var el = $("connQosNlaUi");
  if (!el) return;
  try {
    createUnrealFolders();
    var tmp = UNREAL_LOGS + "\\conn-qos-nla-query.txt";
    var cmd = "cmd /c reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\QoS\" /v \"Do not use NLA\" > \"" + tmp + "\" 2>&1";
    getShell().Run(cmd, 0, true);
    el.innerText = mapQoSNlaRegQueryToUiLabel(readTextFileAll(tmp));
  } catch (eQ) {
    el.innerText = "N/A";
  }
}

/** TÃ©lÃ©charge TCP Optimizer si absent. silent=true : pas de confirm ni alerte succÃ¨s (logs seulement). */
