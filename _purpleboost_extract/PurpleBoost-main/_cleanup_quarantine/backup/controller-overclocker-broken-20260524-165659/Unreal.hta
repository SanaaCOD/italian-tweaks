          </div>
          <div class="toolbar" style="margin-top:10px;">
            <button class="btn secondary" type="button" onclick="showUnrealNvidiaPresetChecklist()">Voir la checklist</button>
            <button class="btn secondary" type="button" onclick="openNvcleanstallWithPresetGuidance()">Ouvrir NVCleanInstall (preset)</button>
          </div>
          <div class="logs" id="nvPresetLogBox" style="margin-top:12px;max-height:160px;"></div>
        </div>
        <div class="tcp-badge tcp-badge--progress" id="nvcleanstallOpenStatus" style="margin-top:12px;display:none;"></div>
        <div class="nv-opt-progress-wrap drivers-progress-wrap" id="nvMediaProgressWrap" style="display:none;">
          <div class="nv-opt-progress-bar">
            <div class="nv-opt-progress-fill" id="nvMediaProgressFill" style="width:0%;"></div>
            <span class="nv-opt-progress-text" id="nvMediaProgressText">0 %</span>
          </div>
          <div class="nv-opt-progress-step" id="nvMediaProgressStep">Ã‰tape en cours : En attente</div>
        </div>
        <div class="tcp-badge tcp-badge--progress" id="nvMediaAutoStatus" style="margin-top:12px;display:none;"></div>
