function runNvidiaPanelClickerExecAsync(task, logTag, timeoutMs, onDone, dedicatedLogFile) {
  createUnrealFolders();
  var exe = getNvidiaPanelClickerExePath();
  if (!exe || !fileExists(exe)) {
    if (onDone) onDone({ error: "NvidiaPanelClicker.exe introuvable â€” lancez tools/nvidia-panel-clicker/build.ps1" });
    return;
  }
  var app = getAppFolderFromHta();
  var resultPath = getAbsolutePathFs(app + "\\logs\\" + logTag + "-result.json");
  var psPath = UNREAL_LOGS + "\\" + logTag + "-run.ps1";
  var escExe = String(exe).replace(/'/g, "''");
  var escRoot = String(app || "").replace(/'/g, "''");
  var escResult = String(resultPath).replace(/'/g, "''");
  var waitMs = timeoutMs || 90000;
  var fso = getFso();
  try {
    var logsDir = fso.GetParentFolderName(resultPath);
    if (logsDir && !fso.FolderExists(logsDir)) fso.CreateFolder(logsDir);
    if (fso.FileExists(resultPath)) fso.DeleteFile(resultPath, true);
  } catch (ePrep) {}
  var cliArgs = "--json --purpleboost-root \"" + app + "\" --task " + task + " --result-file \"" + resultPath + "\"";
  if (dedicatedLogFile) {
    cliArgs += " --log-file \"" + String(dedicatedLogFile).replace(/\\/g, "\\\\") + "\"";
  }
  var psLines = [
    "$ErrorActionPreference = 'Continue'",
    "$Exe = '" + escExe + "'",
    "$ResultPath = '" + escResult + "'",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Exe",
    "$psi.Arguments = '" + cliArgs.replace(/'/g, "''") + "'",
    "$psi.WorkingDirectory = (Split-Path -Parent $Exe)",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$psi.RedirectStandardOutput = $true",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if ($p) {",
    "  $null = $p.StandardOutput.ReadToEnd()",
    "  if (-not $p.WaitForExit(" + waitMs + ")) { try { $p.Kill() } catch {} }",
    "  exit 0",
    "}",
    "exit 18"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(psLines.join("\r\n"));
  tw.Close();
  appendNvGamingLogLine("NV_PANEL_CLICKER=" + logTag + " task=" + task);
  var shell = new ActiveXObject("WScript.Shell");
  var exec = shell.Exec("powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" + psPath + "\"");
  var t0 = new Date().getTime();
  var hardLimitMs = waitMs + 8000;
  function finish(r) { if (onDone) onDone(r); }
  function readPayload() {
    try {
      if (fso.FileExists(resultPath)) {
        var raw = readTextFileAll(resultPath);
        if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
        var payload = raw ? JSON.parse(raw) : null;
        if (payload) return { payload: payload };
      }
    } catch (eP) {}
    try { fso.DeleteFile(psPath, true); } catch (eD) {}
    return { error: "RÃ©ponse NvidiaPanelClicker illisible", payload: null };
  }
  function poll() {
    if (new Date().getTime() - t0 > hardLimitMs) {
      try { exec.Terminate(); } catch (eK) {}
      finish({ error: "timeout panneau NVIDIA", payload: null });
      return;
    }
    if (exec.Status === 1) { finish(readPayload()); return; }
    window.setTimeout(poll, 500);
  }
  window.setTimeout(poll, 500);
}

