}

/** Chemins possibles pour TCPOptimizer.exe (ProgramData + dossier de l'app / build .exe). */
function resolveTcpOptimizerFullPath() {
  var fso = getFso();
  var list = [];
  var i, p;
  if (TCP_OPTIMIZER_PATH) list.push(TCP_OPTIMIZER_PATH);
  if (UNREAL_TCP_EXE && list.indexOf(UNREAL_TCP_EXE) < 0) list.push(UNREAL_TCP_EXE);
  try {
    var pathname = unescape(String(window.location.pathname || "").replace(/\//g, "\\"));
    if (pathname.length >= 3 && pathname.charAt(0) === "\\" && pathname.charAt(2) === ":") pathname = pathname.substring(1);
    if (pathname.length >= 2 && pathname.charAt(1) === ":") {
      var appDir = fso.GetParentFolderName(pathname);
      if (appDir) {
        list.push(appDir + "\\TCPOptimizer.exe");
        list.push(appDir + "\\Tools\\TCPOptimizer\\TCPOptimizer.exe");
      }
    }
  } catch (e1) {}
  for (i = 0; i < list.length; i++) {
    p = list[i];
    if (p && fso.FileExists(p)) return p;
  }
  return TCP_OPTIMIZER_PATH || "";
}

/** VÃ©rifie l'existence d'un fichier (chemin absolu). */
function fileExists(path) {
  try { return getFso().FileExists(path); } catch (e) { return false; }
}

/** CrÃ©e un dossier et ses parents (FSO). */
function createFolder(path) {
  var fso = getFso();
  var p = (path || "").replace(/\\+$/g, "");
  if (!p) return false;
  var parts = p.split("\\");
  var cur = parts[0];
  if (parts.length === 1) {
    if (!fso.FolderExists(cur)) fso.CreateFolder(cur);
    return true;
  }
  for (var i = 1; i < parts.length; i++) {
    cur = cur + "\\" + parts[i];
    try {
      if (!fso.FolderExists(cur)) fso.CreateFolder(cur);
    } catch (e) {
      log("ERREUR createFolder : " + cur + " - " + e.message);
      return false;
    }
  }
  return true;
}

/**
 * ExÃ©cute PowerShell (fenÃªtre masquÃ©e, attente fin).
 * command : arguments aprÃ¨s powershell.exe (ex. -File "C:\x.ps1" -Url "http")
 */
function runPowerShell(command) {
  var cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass " + command;
  try {
    var code = getShell().Run(cmd, 0, true);
    return code;
  } catch (e) {
    log("ERREUR runPowerShell : " + e.message);
    return -1;
  }
}

/** Lance PowerShell en administrateur (UAC). command = arguments aprÃ¨s powershell.exe */
function runPowerShellAsAdmin(command) {
  try {
    var sh = new ActiveXObject("Shell.Application");
    sh.ShellExecute("powershell.exe", command, "", "runas", 1);
    log("PowerShell administrateur demandÃ© (UAC).");
  } catch (e) {
    log("ERREUR runPowerShellAsAdmin : " + e.message);
  }
}

function wmiService() {
  var locator = new ActiveXObject("WbemScripting.SWbemLocator");
  return locator.ConnectServer(".", "root\\cimv2");
}
function wmiQuery(wql) { return wmiService().ExecQuery(wql); }

function isProcessRunningByImageName(imageName) {
  try {
    var esc = String(imageName || "").replace(/'/g, "''");
    if (!esc) return false;
    var items = wmiQuery("SELECT Name FROM Win32_Process WHERE Name='" + esc + "'");
    var e = new Enumerator(items);
    return !e.atEnd();
  } catch (ex) {}
  return false;
}

function isDduProcessRunning() {
  return probeDduPresence({}, false).active;
}

function isNvcleanstallProcessRunning() {
  return isProcessRunningByImageName("NVCleanstall.exe");
}

function firstProp(enumItems, prop) {
  try {
    var e = new Enumerator(enumItems);
    for (; !e.atEnd(); e.moveNext()) {
      var o = e.item();
      var v = o[prop];
      if (v !== null && v !== undefined && v !== "") return v;
    }
  } catch (ex) {}
  return null;
}
function firstNumber(enumItems, prop) {
  var v = firstProp(enumItems, prop);
  if (v === null) return null;
  var n = parseFloat(v);
  return isNaN(n) ? null : n;
}

function formatRamKB(kb) {
  if (!kb || isNaN(kb)) return "â€”";
  var gb = kb / 1024 / 1024;
  if (gb >= 1) return (Math.round(gb * 10) / 10) + " Go";
  return (Math.round(kb / 1024)) + " Mo";
}

function trimRamToken(s) {
  if (s === null || s === undefined) return "";
  var t = String(s).replace(/\0/g, "").replace(/^\s+|\s+$/g, "").replace(/\s+/g, " ");
  return t;
}

function smbiosMemoryTypeLabel(t) {
  var n = parseInt(t, 10);
  if (n === 20) return "DDR";
  if (n === 21) return "DDR2";
  if (n === 24) return "DDR3";
  if (n === 26) return "DDR4";
  if (n === 34) return "DDR5";
  return "";
}

function isRamVendorJunk(s) {
  if (!s) return true;
  var u = String(s).toUpperCase();
  if (u === "UNKNOWN" || u === "N/A") return true;
  if (/^0x[0-9A-F]+$/i.test(s)) return true;
  if (/^[0-9\s]+$/.test(s) && s.replace(/\s/g, "").length < 6) return true;
  return false;
}

/** Ligne matÃ©rielle RAM (WMI Win32_PhysicalMemory + capacitÃ©), style Â« Marque ModÃ¨le DDR4 3200 MHz - 32 Go Â». */
function formatHomeRamDetail(totalKbOs) {
  var modules = [];
  try {
    var q = wmiQuery("SELECT Manufacturer,PartNumber,Speed,Capacity,SMBIOSMemoryType FROM Win32_PhysicalMemory");
    var e = new Enumerator(q);
    for (; !e.atEnd(); e.moveNext()) {
      var o = e.item();
      modules.push({
        man: trimRamToken(o.Manufacturer),
        part: trimRamToken(o.PartNumber),
        speed: parseInt(o.Speed, 10) || 0,
        cap: parseFloat(o.Capacity) || 0,
        smbios: parseInt(o.SMBIOSMemoryType, 10) || 0
      });
    }
  } catch (exM) {
    modules = [];
  }
  var totalBytes = 0;
  var i;
  for (i = 0; i < modules.length; i++) {
    if (modules[i].cap > 0) totalBytes += modules[i].cap;
  }
  var capStr = "";
  if (totalBytes > 0) {
    var gb = totalBytes / (1024 * 1024 * 1024);
    capStr = (Math.round(gb * 10) / 10) + " Go";
  } else if (totalKbOs && !isNaN(totalKbOs)) {
    capStr = formatRamKB(totalKbOs);
  }
  if (modules.length === 0) {
    return capStr || "";
  }
  var maxSpeed = 0;
  var ddrFrom = 0;
  for (i = 0; i < modules.length; i++) {
    if (modules[i].speed > maxSpeed) maxSpeed = modules[i].speed;
    if (modules[i].smbios && !ddrFrom) ddrFrom = modules[i].smbios;
  }
  var mfg = "";
  var part = "";
  for (i = 0; i < modules.length; i++) {
    if (!isRamVendorJunk(modules[i].man)) {
      mfg = modules[i].man;
      part = modules[i].part;
      break;
    }
  }
  if (!mfg) {
    for (i = 0; i < modules.length; i++) {
      if (modules[i].part) {
        part = modules[i].part;
        break;
      }
    }
  }
  var head = "";
  if (mfg && part && part.toUpperCase().indexOf(mfg.toUpperCase()) === 0) head = part;
  else if (mfg && part) head = mfg + " " + part;
  else if (mfg) head = mfg;
  else if (part) head = part;
  var ddr = smbiosMemoryTypeLabel(ddrFrom);
  var mid = "";
  if (ddr) mid = ddr;
  if (maxSpeed > 0) {
    if (mid) mid += " " + maxSpeed + " MHz";
    else mid = maxSpeed + " MHz";
  }
  var left = head;
  if (mid) {
    if (left) left += " " + mid;
    else left = mid;
  }
  if (left && capStr) return left + " - " + capStr;
  if (left) return left;
  return capStr || "";
}

/** RAM WMI : valeur brute -> MT/s approximatif pour comparaisons (JEDEC vs profil). */
function normalizeWmiMemoryMt(raw) {
  if (raw === null || raw === undefined) return null;
  var n = parseInt(raw, 10);
  if (isNaN(n) || n <= 0) return null;
  if (n >= 3400) return n;
  if (n >= 400 && n <= 1900) return n * 2;
  return n;
}

/** Plafond JEDEC Â« typique Â» par gÃ©nÃ©ration (SMBIOSMemoryType), pour heuristique XMP/expo. */
function jedecCeilingMt(smbiosType) {
  var t = parseInt(smbiosType, 10) || 0;
  if (t === 24) return 2133;
  if (t === 26) return 2666;
  if (t === 34) return 4800;
  return 2666;
}

/**
 * Heuristique XMP / profil mÃ©moire (WMI uniquement, pas de lecture SPD matÃ©rielle).
 * Compare ConfiguredClockSpeed (effectif) Ã  Speed (souvent max annoncÃ©) et au plafond JEDEC.
 */
function inferHomeRamXmpLine() {
  var maxCC = null;
  var maxSpd = null;
  var ddrType = 0;
  try {
    var q = wmiQuery("SELECT ConfiguredClockSpeed,Speed,SMBIOSMemoryType FROM Win32_PhysicalMemory");
    var e = new Enumerator(q);
    for (; !e.atEnd(); e.moveNext()) {
      var o = e.item();
      var ccRaw = parseInt(o.ConfiguredClockSpeed, 10) || 0;
      var spRaw = parseInt(o.Speed, 10) || 0;
      var smb = parseInt(o.SMBIOSMemoryType, 10) || 0;
      var cc = normalizeWmiMemoryMt(ccRaw);
      var sp = normalizeWmiMemoryMt(spRaw);
      if (cc !== null && (maxCC === null || cc > maxCC)) maxCC = cc;
      if (sp !== null && (maxSpd === null || sp > maxSpd)) maxSpd = sp;
      if (smb && !ddrType) ddrType = smb;
    }
  } catch (exX) {
    return "XMP : Unknown";
  }
  if (maxCC === null) return "XMP : Unknown";
  var jed = jedecCeilingMt(ddrType);
  if (maxSpd !== null && maxSpd > 0) {
    if (maxSpd > jed + 120 && maxCC >= maxSpd * 0.87) return "XMP : Enable";
    if (maxCC < maxSpd * 0.78 && maxSpd > jed + 80) return "XMP : Disable";
  }
  if (maxCC > jed + 120) return "XMP : Enable";
  if (maxCC <= jed + 40) return "XMP : Disable";
  return "XMP : Unknown";
}

/** Pourcentage CPU global (moyenne LoadPercentage par processeur logique, WMI). */
function tryCpuUsagePercent() {
  try {
    var q = wmiQuery("SELECT LoadPercentage FROM Win32_Processor");
    var sum = 0;
    var n = 0;
    var e = new Enumerator(q);
    for (; !e.atEnd(); e.moveNext()) {
      var lp = parseFloat(e.item().LoadPercentage);
      if (!isNaN(lp)) {
        sum += lp;
        n++;
      }
    }
    if (n > 0) {
      var avg = sum / n;
      if (avg < 0) avg = 0;
      if (avg > 100) avg = 100;
      return Math.round(avg * 10) / 10;
    }
  } catch (e0) {}
  try {
    var q2 = wmiQuery("SELECT PercentProcessorTime FROM Win32_PerfFormattedData_PerfOS_Processor WHERE Name='_Total'");
    var v = firstNumber(q2, "PercentProcessorTime");
    if (v === null) return null;
    if (v < 0) v = 0;
    if (v > 100) v = 100;
    return Math.round(v * 10) / 10;
  } catch (e1) {}
  return null;
}

/** Utilisation GPU : max des moteurs WMI (Win10+). */
function tryGpuUsagePercent() {
  var max = null;
  function bump(n) {
    if (isNaN(n)) return;
    if (max === null || n > max) max = n;
  }
  try {
    var q = wmiQuery("SELECT UtilizationPercentage FROM Win32_PerfFormattedData_GPUPerformanceCounters_GPUEngine");
    var e = new Enumerator(q);
    for (; !e.atEnd(); e.moveNext()) {
      bump(parseFloat(e.item().UtilizationPercentage));
    }
    if (max !== null) {
      if (max < 0) max = 0;
      if (max > 100) max = 100;
      return Math.round(max * 10) / 10;
    }
  } catch (e1) {}
  try {
    var q2 = wmiQuery("SELECT UtilizationPercentage FROM Win32_PerfFormattedData_GPUPerformanceCounters_GPUAdapterEngine");
    var e2 = new Enumerator(q2);
    for (; !e2.atEnd(); e2.moveNext()) {
      bump(parseFloat(e2.item().UtilizationPercentage));
    }
    if (max !== null) {
      if (max < 0) max = 0;
      if (max > 100) max = 100;
      return Math.round(max * 10) / 10;
    }
  } catch (e2) {}
  return null;
}

/** Pourcentage RAM utilisÃ©e (mÃ©moire physique). */
function tryRamUsagePercent() {
  try {
    var q = wmiQuery("SELECT TotalVisibleMemorySize, FreePhysicalMemory FROM Win32_OperatingSystem");
    var e = new Enumerator(q);
    if (e.atEnd()) return null;
    var o = e.item();
    var totalKb = parseFloat(o.TotalVisibleMemorySize);
    var freeKb = parseFloat(o.FreePhysicalMemory);
    if (isNaN(totalKb) || totalKb <= 0 || isNaN(freeKb)) return null;
    var pct = ((totalKb - freeKb) * 100.0) / totalKb;
    if (pct < 0) pct = 0;
    if (pct > 100) pct = 100;
    return Math.round(pct * 10) / 10;
  } catch (e) {
    return null;
  }
}

function homePctLine(label, value) {
  if (value === null || value === undefined || isNaN(value)) return label + " : N/A";
  return label + " : " + value + "%";
}

/** Affichage grand pourcentage seul (cartes CPU / GPU / RAM). */
function homePctValue(value) {
  if (value === null || value === undefined || isNaN(value)) return "-- %";
  return value + "%";
}

function applyHomeStatsCacheToUi() {
  var elCpu = $("homeCpuPct");
  var elGpu = $("homeGpuPct");
  var elRam = $("homeRamPct");
  if (!elCpu || !elGpu || !elRam) return;
  elCpu.innerText = homePctValue(homeStatsCache.cpu);
  elGpu.innerText = homePctValue(homeStatsCache.gpu);
  elRam.innerText = homePctValue(homeStatsCache.ram);
}

function stopHomeStatsBackgroundCollect() {
  if (homeStatsPollIntervalId !== null) {
    window.clearInterval(homeStatsPollIntervalId);
    homeStatsPollIntervalId = null;
  }
  homeStatsWorkerBusy = false;
}

function readHomeStatsResultFile(sinceMs) {
  try {
    var fso = getFso();
    var p = UNREAL_LOGS + "\\home-stats-result.json";
    if (!fso.FileExists(p)) return null;
    if (sinceMs) {
      var fileMs = new Date(fso.GetFile(p).DateLastModified).getTime();
      if (fileMs < sinceMs - 1500) return null;
    }
    var obj = JSON.parse(readTextFileAll(p));
    if (!obj) return null;
    return obj;
  } catch (eR) {
    return null;
  }
}

function writeHomeStatsCollectorScript() {
  createUnrealFolders();
  var psPath = UNREAL_LOGS + "\\home-stats-collect.ps1";
  var outPath = UNREAL_LOGS + "\\home-stats-result.json";
  var escOut = String(outPath).replace(/'/g, "''");
  var gpuSec = HOME_STATS_GPU_TIMEOUT_SEC;
  var lines = [
    "$ErrorActionPreference = 'SilentlyContinue'",
    "$OutPath = '" + escOut + "'",
    "$result = @{ cpu = $null; gpu = $null; ram = $null; updatedAt = [int][double]::Parse((Get-Date -UFormat %s)) }",
    "function Clamp-Pct($n) {",
    "  if ($null -eq $n -or [double]::IsNaN([double]$n)) { return $null }",
    "  $v = [double]$n",
    "  if ($v -lt 0) { $v = 0 }",
    "  if ($v -gt 100) { $v = 100 }",
    "  return [math]::Round($v, 1)",
    "}",
    "try {",
    "  $cpus = Get-WmiObject Win32_Processor | ForEach-Object { [double]$_.LoadPercentage }",
    "  $n = @($cpus | Where-Object { -not [double]::IsNaN($_) }).Count",
    "  if ($n -gt 0) { $result.cpu = Clamp-Pct(($cpus | Where-Object { -not [double]::IsNaN($_) } | Measure-Object -Average).Average) }",
    "} catch {}",
    "try {",
    "  $os = Get-WmiObject Win32_OperatingSystem | Select-Object -First 1",
    "  $total = [double]$os.TotalVisibleMemorySize",
    "  $free = [double]$os.FreePhysicalMemory",
    "  if ($total -gt 0) { $result.ram = Clamp-Pct((($total - $free) * 100.0) / $total) }",
    "} catch {}",
    "try {",
    "  $sw = [Diagnostics.Stopwatch]::StartNew()",
    "  $maxGpu = $null",
    "  $engines = Get-WmiObject Win32_PerfFormattedData_GPUPerformanceCounters_GPUEngine",
    "  foreach ($e in $engines) {",
    "    if ($sw.Elapsed.TotalSeconds -gt " + gpuSec + ") { break }",
    "    $u = [double]$e.UtilizationPercentage",
    "    if (-not [double]::IsNaN($u)) { if ($null -eq $maxGpu -or $u -gt $maxGpu) { $maxGpu = $u } }",
    "  }",
    "  if ($null -eq $maxGpu) {",
    "    $engines2 = Get-WmiObject Win32_PerfFormattedData_GPUPerformanceCounters_GPUAdapterEngine",
    "    foreach ($e2 in $engines2) {",
    "      if ($sw.Elapsed.TotalSeconds -gt " + gpuSec + ") { break }",
    "      $u2 = [double]$e2.UtilizationPercentage",
    "      if (-not [double]::IsNaN($u2)) { if ($null -eq $maxGpu -or $u2 -gt $maxGpu) { $maxGpu = $u2 } }",
    "    }",
    "  }",
    "  $result.gpu = Clamp-Pct($maxGpu)",
    "} catch {}",
    "$dir = Split-Path -Parent $OutPath",
    "if ($dir -and -not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }",
    "($result | ConvertTo-Json -Compress) | Out-File -LiteralPath $OutPath -Encoding utf8 -Force"
  ];
  var tw = getFso().CreateTextFile(psPath, true);
  tw.Write(lines.join("\r\n"));
  tw.Close();
  return psPath;
}

function scheduleHomeStatsBackgroundCollect() {
  if (homeStatsWorkerBusy) return;
  homeStatsWorkerBusy = true;
  homeStatsCollectStartMs = new Date().getTime();
  try {
    var resultPath = UNREAL_LOGS + "\\home-stats-result.json";
    var fsoDel = getFso();
    if (fsoDel.FileExists(resultPath)) fsoDel.DeleteFile(resultPath);
  } catch (eDel) {}
  try {
    var psPath = writeHomeStatsCollectorScript();
    var cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" + psPath + "\"";
    getShell().Run(cmd, 0, false);
  } catch (eLaunch) {
    homeStatsWorkerBusy = false;
    return;
  }
  if (homeStatsPollIntervalId !== null) window.clearInterval(homeStatsPollIntervalId);
  homeStatsPollIntervalId = window.setInterval(function () {
    try {
      var data = readHomeStatsResultFile(homeStatsCollectStartMs);
      if (data) {
        if (typeof data.cpu !== "undefined" && data.cpu !== null && !isNaN(parseFloat(data.cpu))) homeStatsCache.cpu = parseFloat(data.cpu);
        if (typeof data.gpu !== "undefined" && data.gpu !== null && !isNaN(parseFloat(data.gpu))) homeStatsCache.gpu = parseFloat(data.gpu);
        if (typeof data.ram !== "undefined" && data.ram !== null && !isNaN(parseFloat(data.ram))) homeStatsCache.ram = parseFloat(data.ram);
        homeStatsCache.updatedAt = new Date().getTime();
        if (currentPageName === "home") applyHomeStatsCacheToUi();
        stopHomeStatsBackgroundCollect();
        return;
      }
      if (new Date().getTime() - homeStatsCollectStartMs > HOME_STATS_COLLECT_TIMEOUT_MS) {
        stopHomeStatsBackgroundCollect();
      }
    } catch (ePoll) {
      stopHomeStatsBackgroundCollect();
    }
  }, 350);
}

function clearHomeStatsTimer() {
  if (homeStatsIntervalId !== null) {
    window.clearInterval(homeStatsIntervalId);
    homeStatsIntervalId = null;
  }
  stopHomeStatsBackgroundCollect();
}

function ensureHomeStatsTimer() {
  applyHomeStatsCacheToUi();
  if (homeStatsIntervalId !== null) return;
  homeStatsIntervalId = window.setInterval(function () {
    if (currentPageName === "home") scheduleHomeStatsBackgroundCollect();
  }, HOME_STATS_MS);
  if (currentPageName === "home") scheduleHomeStatsBackgroundCollect();
}

function refreshHomeStats() {
  applyHomeStatsCacheToUi();
  scheduleHomeStatsBackgroundCollect();
}

/** Infos statiques Accueil (noms + taille RAM), une fois au dÃ©marrage ou retour manuel. */
function initHomeHardwareStatic() {
  try {
    var cpuName = firstProp(wmiQuery("SELECT Name FROM Win32_Processor"), "Name") || "";
    var gpuName = firstProp(wmiQuery("SELECT Name FROM Win32_VideoController"), "Name") || "";
    var totalKb = firstNumber(wmiQuery("SELECT TotalVisibleMemorySize FROM Win32_OperatingSystem"), "TotalVisibleMemorySize");
    var subCpu = $("homeCpuSub");
    var subGpu = $("homeGpuSub");
    var subRam = $("homeRamSub");
    var xmpRam = $("homeRamXmp");
    if (subCpu) subCpu.innerText = cpuName || "";
    if (subGpu) subGpu.innerText = gpuName || "";
    if (subRam) subRam.innerText = formatHomeRamDetail(totalKb);
    if (xmpRam) xmpRam.innerText = inferHomeRamXmpLine();
  } catch (e) {
    log("ERREUR init Accueil (matÃ©riel) : " + e.message);
  }
}

function refreshHomeDateTimeLabel() {
  var el = $("homeDateTime");
  if (!el) return;
  el.innerText = nowDateTimeFr();
}

function ensureHomeDateTimeTimer() {
  if (homeDateTimeIntervalId !== null) return;
  refreshHomeDateTimeLabel();
  homeDateTimeIntervalId = window.setInterval(function () {
    try { refreshHomeDateTimeLabel(); } catch (exDt) {}
  }, 60000);
}

/* ---------- Controller Overclocker (onglet PÃ©riphÃ©rique) ---------- */
var controllerOverclockerGen = 0;
var controllerOverclockerState = {
  devices: [],
  cards: [],
  selectedIndex: -1,
  scanning: false,
  busy: false,
  busyCardId: "",
  assistedGuideRate: 0,
  statusRefreshing: false,
  lastStatusKey: "",
  lastDevicePresent: true,
  watchIntervalId: 0,
  applied1000Once: false,
  probeActiveRate: 0,
  probeBeforeCaptured: false,
  uiLastClickedRate: 0,
  statusPending: true,
  statusLoaded: false
};

function getControllerOverclockerStatusJsonPath() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) return getAbsolutePathFs(combinePath(app, "logs\\controller-overclocker-status.json"));
  return UNREAL_LOGS + "\\controller-overclocker-status.json";
}

function parseControllerPollingStatusJson(raw) {
  if (!raw) return null;
  try {
    return JSON.parse(String(raw));
  } catch (eParse) {
    return null;
  }
}

function readControllerPollingStatusResult() {
  try {
    var path = getControllerOverclockerStatusJsonPath();
    if (!path || !getFso().FileExists(path)) return null;
    return parseControllerPollingStatusJson(readUtf8TextFileAll(path));
  } catch (eRead) {
    return null;
  }
}

function controllerCoFormatResponseMs(ms) {
  var n = parseFloat(ms);
  if (isNaN(n)) return "\u2014";
  if (n >= 1) return n.toFixed(1) + " ms";
  return n.toFixed(3) + " ms";
}

function controllerCoDefaultResponseMs(rateHz) {
  var r = parseInt(rateHz, 10);
  if (isNaN(r) || r <= 0) return 8;
  if (r >= 8000) return 0.125;
  if (r >= 1000) return 1;
  if (r >= 500) return 2;
  if (r >= 250) return 4;
  return 8;
}

function controllerCoResolveConfirmedRate(st) {
  if (!st) return 0;
  if (st.Status === "Unknown" && (!st.ConfirmedRate || st.ConfirmedRate === 0)) return 0;
  var rate = 0;
  if (st.ConfirmedRate != null) rate = parseInt(st.ConfirmedRate, 10);
  else if (st.ConfiguredRate != null) rate = parseInt(st.ConfiguredRate, 10);
  if (isNaN(rate)) rate = 0;
  if (rate <= 0 && st.Status === "Default") return 125;
  return rate;
}

function getControllerOcStatusScriptPath() {
  var scriptsDir = getAppScriptsDir();
  if (!scriptsDir) return "";
  return getAbsolutePathFs(combinePath(scriptsDir, "Devices\\Get-ControllerOCStatus.ps1"));
}

function setControllerOverclockerPendingUi() {
  var widget = $("controllerOverclockerWidget");
  var statusBadgeEl = $("cocStatusBadge");
  var pollingEl = $("cocPollingRate");
  var selectedEl = $("cocSelectedRate");
  var etatEl = $("cocEtatLabel");
  var responseEl = $("cocResponseTime");
  var potentialEl = $("cocPotential");
  var stateLineEl = $("cocStateLine");
  if (widget) widget.className = "coc-widget coc-tone-pending";
  if (statusBadgeEl) {
    statusBadgeEl.innerText = "\u2026";
    statusBadgeEl.className = "coc-badge coc-badge--default";
  }
  if (pollingEl) pollingEl.innerText = "\u2014";
  if (selectedEl) {
    var sr = controllerOverclockerState.uiLastClickedRate || 0;
    selectedEl.innerText = sr >= 1000 ? (sr + " Hz") : "\u2014";
  }
  if (etatEl) etatEl.innerText = "\u2026";
  if (responseEl) responseEl.innerText = "\u2014";
  if (potentialEl) potentialEl.innerText = "\u2014";
  if (stateLineEl && !controllerOverclockerState.busy) {
    stateLineEl.innerText = "V\u00e9rification en cours...";
    stateLineEl.className = "coc-state-line coc-state-line--info";
  }
}

function controllerCoIsOptimizedStatus(st, confirmedRateHz) {
  if (!st || confirmedRateHz <= 125) return false;
  if (st.Status === "Mismatch" || st.Status === "Unknown") return false;
  if (st.Optimized === true && confirmedRateHz >= 1000) return true;
  if (confirmedRateHz >= 8000) return st.Status === "Optimized8000";
  if (confirmedRateHz >= 1000) return st.Status === "Optimized1000" && confirmedRateHz < 8000;
  return false;
}

function controllerCoHasRateMismatch(st, confirmedRateHz, selectedRateHz) {
  if (st && st.Status === "Mismatch") return true;
  var sel = parseInt(selectedRateHz, 10) || 0;
  var req = st && st.RequestedRate ? parseInt(st.RequestedRate, 10) : 0;
  var last = controllerOverclockerState.uiLastClickedRate || 0;
  var wanted = sel >= 1000 ? sel : (req >= 1000 ? req : (last >= 1000 ? last : 0));
  if (wanted < 1000) return false;
  if (confirmedRateHz <= 125) return wanted >= 1000;
  return confirmedRateHz !== wanted;
}

function controllerCoFormatPotentialLabel(st, rateHz) {
  if (rateHz >= 8000) return "maximum";
  var pl = st && st.PotentialLabel ? fixUtf8Mojibake(String(st.PotentialLabel)) : "";
  if (pl && /maximum|max/i.test(pl)) return "maximum";
  return "0.13 ms";
}

function controllerCoBuildEtatLabel(st, confirmedRateHz, selectedRateHz) {
  var mismatch = controllerCoHasRateMismatch(st, confirmedRateHz, selectedRateHz);
  if (mismatch) return "Non confirm\u00e9";
  if (confirmedRateHz <= 0) return "Inconnu";
  if (confirmedRateHz <= 125) return "Default";
  if (confirmedRateHz >= 8000 && controllerCoIsOptimizedStatus(st, confirmedRateHz)) return "Optimis\u00e9 8000";
  if (confirmedRateHz >= 1000 && controllerCoIsOptimizedStatus(st, confirmedRateHz)) return "Optimis\u00e9 1000";
  if (st && st.Code === "PREPARED_NEEDS_RECONNECT") return "Pr\u00e9par\u00e9";
  return "Inconnu";
}

function controllerCoBuildStateLine(st, confirmedRateHz, selectedRateHz) {
  if (st && st.Message && controllerCoIsOptimizedStatus(st, confirmedRateHz) && !controllerCoHasRateMismatch(st, confirmedRateHz, selectedRateHz)) {
    return fixUtf8Mojibake(String(st.Message));
  }
  var mismatch = controllerCoHasRateMismatch(st, confirmedRateHz, selectedRateHz);
  var wanted = parseInt(selectedRateHz, 10) || 0;
  if (wanted < 1000 && controllerOverclockerState.uiLastClickedRate) wanted = controllerOverclockerState.uiLastClickedRate;
  if (mismatch && wanted >= 1000 && confirmedRateHz >= 1000) {
    return wanted + " Hz demand\u00e9 \u2014 " + confirmedRateHz + " Hz d\u00e9tect\u00e9";
  }
  if (st && st.Code === "PREPARED_NEEDS_RECONNECT") {
    var req = controllerOverclockerState.uiLastClickedRate || wanted;
    if (req > 0) return req + " Hz pr\u00e9par\u00e9 \u2014 rebranche la manette";
  }
  if (confirmedRateHz <= 125) return "Default d\u00e9tect\u00e9";
  if (confirmedRateHz >= 8000 && controllerCoIsOptimizedStatus(st, confirmedRateHz)) {
    return "Optimis\u00e9 8000 Hz confirm\u00e9";
  }
  if (confirmedRateHz >= 1000 && controllerCoIsOptimizedStatus(st, confirmedRateHz)) {
    return "Optimis\u00e9 1000 Hz confirm\u00e9";
  }
  if (confirmedRateHz <= 0 && st && st.Message) return fixUtf8Mojibake(String(st.Message));
  return "Non confirm\u00e9";
}

function renderControllerPollingStatusUi(status) {
  var widget = $("controllerOverclockerWidget");
  var deviceBadgeEl = $("controllerOverclockerDeviceBadge");
  var statusBadgeEl = $("cocStatusBadge");
  var pollingEl = $("cocPollingRate");
  var selectedEl = $("cocSelectedRate");
  var etatEl = $("cocEtatLabel");
  var responseEl = $("cocResponseTime");
  var potentialEl = $("cocPotential");
  var stateLineEl = $("cocStateLine");
  var dev = getSelectedControllerDevice();
  var selectedRate = controllerOverclockerState.uiLastClickedRate || 0;

  if (controllerOverclockerState.statusPending && !controllerOverclockerState.busy) {
    setControllerOverclockerPendingUi();
    return;
  }

  if (!dev && (!status || !status.DeviceFound)) {
    if (widget) widget.className = "coc-widget coc-tone-default";
    if (deviceBadgeEl) { deviceBadgeEl.innerText = "\u2014"; deviceBadgeEl.className = "coc-badge coc-badge--device"; }
    if (statusBadgeEl) { statusBadgeEl.innerText = "\u2014"; statusBadgeEl.className = "coc-badge coc-badge--default"; }
    if (pollingEl) pollingEl.innerText = "\u2014";
    if (selectedEl) selectedEl.innerText = selectedRate >= 1000 ? (selectedRate + " Hz") : "\u2014";
    if (etatEl) etatEl.innerText = "\u2014";
    if (responseEl) responseEl.innerText = "\u2014";
    if (potentialEl) potentialEl.innerText = "\u2014";
    if (stateLineEl && !controllerOverclockerState.busy) {
      stateLineEl.innerText = status && status.Present === false ? "P\u00e9riph\u00e9rique d\u00e9connect\u00e9" : "\u2014";
    }
    updateControllerApplyUi();
    return;
  }

  var st = status || {};
  var confirmedRate = controllerCoResolveConfirmedRate(st);
  var optimized = controllerCoIsOptimizedStatus(st, confirmedRate);
  var mismatch = controllerCoHasRateMismatch(st, confirmedRate, selectedRate);
  var responseMs = st.ResponseTimeMs != null
    ? st.ResponseTimeMs
    : controllerCoDefaultResponseMs(confirmedRate > 0 ? confirmedRate : 125);

  if (widget) {
    if (mismatch) widget.className = "coc-widget coc-tone-mismatch";
    else if (optimized) widget.className = "coc-widget coc-tone-opt";
    else widget.className = "coc-widget coc-tone-default";
  }

  if (deviceBadgeEl) {
    var badgeText = st.DeviceBadge || (dev && dev.Type) || "Manette";
    deviceBadgeEl.innerText = fixUtf8Mojibake(String(badgeText)).toUpperCase();
    deviceBadgeEl.className = "coc-badge coc-badge--device";
  }
  if (statusBadgeEl) {
    if (mismatch) {
      statusBadgeEl.innerText = "NON CONFIRM\u00c9";
      statusBadgeEl.className = "coc-badge coc-badge--warn";
    } else if (optimized) {
      statusBadgeEl.innerText = "OPTIMIS\u00c9";
      statusBadgeEl.className = "coc-badge coc-badge--optimized";
    } else {
      statusBadgeEl.innerText = "DEFAULT";
      statusBadgeEl.className = "coc-badge coc-badge--default";
    }
  }
  if (pollingEl) pollingEl.innerText = confirmedRate > 0 ? (confirmedRate + " Hz") : "\u2014";
  if (selectedEl) selectedEl.innerText = selectedRate >= 1000 ? (selectedRate + " Hz") : "\u2014";
  if (etatEl) etatEl.innerText = controllerCoBuildEtatLabel(st, confirmedRate, selectedRate);
  if (responseEl) responseEl.innerText = controllerCoFormatResponseMs(responseMs);
  if (potentialEl) potentialEl.innerText = controllerCoFormatPotentialLabel(st, confirmedRate);
  if (stateLineEl && !controllerOverclockerState.busy) {
    stateLineEl.innerText = controllerCoBuildStateLine(st, confirmedRate, selectedRate);
    if (mismatch) stateLineEl.className = "coc-state-line coc-state-line--warn";
    else if (optimized) stateLineEl.className = "coc-state-line coc-state-line--success";
    else stateLineEl.className = "coc-state-line";
  }
  updateControllerApplyUi();
}

function refreshControllerPollingStatus(options) {
  options = options || {};
  var silent = !!options.silent;
  var dev = getSelectedControllerDevice();
  if (!dev) {
    controllerOverclockerState.statusPending = false;
    renderControllerPollingStatusUi(null);
    return;
  }
  if (controllerOverclockerState.statusRefreshing) return;
  controllerOverclockerState.statusRefreshing = true;
  controllerOverclockerState.statusPending = true;
  setControllerOverclockerPendingUi();
  writeControllerOverclockerLog("[DEVICE] Reading OC status");

  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var psPath = getControllerOcStatusScriptPath();
  if (!psPath || !getFso().FileExists(psPath)) {
    controllerOverclockerState.statusRefreshing = false;
    controllerOverclockerState.statusPending = false;
    writeControllerOverclockerLog("[DEVICE] Status result: error script_missing");
    return;
  }

  var logPath = getControllerOverclockerLogPath();
  var outPath = getControllerOverclockerStatusJsonPath();
  var instanceId = String(dev.InstanceId || dev.DeviceId || "");
  var usbParent = String(dev.TargetHidusbfDeviceId || dev.UsbCompositeParentId || dev.UsbParentDeviceId || "");
  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + psPath + '"' +
    ' -AppRoot "' + escapeControllerPsArg(app) + '"' +
    ' -LogPath "' + escapeControllerPsArg(logPath) + '"' +
    ' -OutputPath "' + escapeControllerPsArg(outPath) + '"' +
    ' -DeviceInstanceId "' + escapeControllerPsArg(instanceId) + '"' +
    ' -UsbParentDeviceId "' + escapeControllerPsArg(usbParent) + '"' +
    ' -Vid "' + escapeControllerPsArg(dev.Vid || "") + '"' +
    ' -Pid "' + escapeControllerPsArg(dev.Pid || "") + '"' +
    (silent ? ' -Quiet' : '');

  window.setTimeout(function () {
    try {
      getShell().Run(cmd, 0, true);
    } catch (eRun) {
      writeControllerOverclockerLog("[DEVICE] Status result: error " + String(eRun.message || eRun));
      controllerOverclockerState.statusRefreshing = false;
      controllerOverclockerState.statusPending = false;
      return;
    }
    var status = readControllerPollingStatusResult();
    controllerOverclockerState.statusPending = false;
    controllerOverclockerState.statusLoaded = true;
    if (status) {
      writeControllerOverclockerLog("[DEVICE] ConfirmedRate=" + String(status.ConfirmedRate != null ? status.ConfirmedRate : status.ConfiguredRate || "?"));
      writeControllerOverclockerLog("[DEVICE] Status=" + String(status.Status || "?"));
    }
    var statusKey = status
      ? String(status.Status || "") + "|" + String(status.ConfirmedRate != null ? status.ConfirmedRate : status.ConfiguredRate || "") + "|" + String(status.DeviceFound) + "|" + String(status.Present)
      : "";
    var wasPresent = controllerOverclockerState.lastDevicePresent;
    var isPresent = !!(status && status.DeviceFound !== false && status.Present !== false);
    if (wasPresent && !isPresent && statusKey !== controllerOverclockerState.lastStatusKey) {
      writeControllerOverclockerLog("[DEVICE] Device disconnected");
      renderControllerPollingStatusUi(status);
      window.setTimeout(function () {
        try { refreshUsbControllers(); } catch (eReScan) {}
      }, 400);
    } else if (!wasPresent && isPresent && statusKey !== controllerOverclockerState.lastStatusKey) {
      writeControllerOverclockerLog("[DEVICE] Device reconnected, refreshing status");
      renderControllerPollingStatusUi(status);
    } else {
      renderControllerPollingStatusUi(status);
    }
    controllerOverclockerState.lastDevicePresent = isPresent;
    controllerOverclockerState.lastStatusKey = statusKey;
    controllerOverclockerState.statusRefreshing = false;
  }, 10);
}

function ensureControllerOverclockerWatcher() {
  if (controllerOverclockerState.watchIntervalId) return;
  controllerOverclockerState.watchIntervalId = window.setInterval(function () {
    if (currentPageName !== "peripheral") return;
    if (controllerOverclockerState.scanning || controllerOverclockerState.busy) return;
    if (!controllerOverclockerState.cards || !controllerOverclockerState.cards.length) return;
    refreshAllControllerCardsStatus(0);
  }, 5000);
}

function stopControllerOverclockerWatcher() {
  if (controllerOverclockerState.watchIntervalId) {
    window.clearInterval(controllerOverclockerState.watchIntervalId);
    controllerOverclockerState.watchIntervalId = 0;
  }
}

