function $(id) { return document.getElementById(id); }
function pad2(n) { return n < 10 ? "0" + n : "" + n; }
function nowTime() { var d = new Date(); return pad2(d.getHours()) + ":" + pad2(d.getMinutes()) + ":" + pad2(d.getSeconds()); }
function nowDateTimeFr() {
  var d = new Date();
  return pad2(d.getDate()) + "/" + pad2(d.getMonth() + 1) + "/" + d.getFullYear() + " - " + pad2(d.getHours()) + ":" + pad2(d.getMinutes());
}

function perfLog(message) {
  try {
    appendFileLogLine("[PERF] " + String(message || ""));
  } catch (eP) {}
}

function perfStart(label) {
  return { label: String(label || ""), t: new Date().getTime() };
}

function perfEnd(mark) {
  if (!mark) return;
  var dt = new Date().getTime() - mark.t;
  if (dt >= UI_PERF_WARN_MS) perfLog(mark.label + " = " + dt + "ms (SLOW)");
  else perfLog(mark.label + " = " + dt + "ms");
}

function initHomeHardwareStaticOnce() {
  if (homeHardwareStaticDone) return;
  homeHardwareStaticDone = true;
  initHomeHardwareStatic();
}

function log(message) {
  var box = $("logBox");
  if (!box) return;
  var line = document.createElement("div");
  line.className = "logline";
  line.textContent = "[" + nowTime() + "] " + message;
  box.insertBefore(line, box.firstChild);
  while (box.childNodes.length > 280) box.removeChild(box.lastChild);
  try { appendFileLogLine(line.textContent); } catch (e0) {}
}

function logScriptErrorMasked(message, lineNo) {
  var msg = String(message || "erreur inconnue");
  if (lineNo) msg += " ligne " + lineNo;
  try {
    if (typeof writeNvcleanAutoLog === "function") writeNvcleanAutoLog("[SCRIPT] erreur masquee : " + msg);
  } catch (eW) {}
  try {
    log("[SCRIPT] erreur masquee : " + msg);
  } catch (eL) {}
}

window.onerror = function (message, source, lineno, colno, error) {
  try {
    logScriptErrorMasked(message, lineno);
  } catch (e) {}
  return true;
};

function confirmAction(message) { return window.confirm(message); }

function showPage(pageName) {
  var mark = perfStart("showPage(" + pageName + ")");
  if (currentPageName === "drivers" && pageName !== "drivers") {
    nvCheckGeneration++;
    try { finishGpuDriverCheck(); } catch (eDrvStop) {}
  }
  currentPageName = pageName;
  try {
    document.body.className = pageName === "peripheral" ? "page-peripheral-active" : "";
  } catch (eBodyCls) {}
  var buttons = document.getElementsByClassName("navbtn");
  for (var i = 0; i < buttons.length; i++) {
    var b = buttons[i];
    b.className = "navbtn" + (b.getAttribute("data-page") === pageName ? " active" : "");
  }
  var pages = document.getElementsByClassName("page");
  for (var j = 0; j < pages.length; j++) {
    var p = pages[j];
    p.className = "page" + (p.id === "page-" + pageName ? " active" : "");
  }
  if (pageName === "conn") {
    window.setTimeout(function () {
      if (currentPageName !== "conn") return;
      try { refreshConnAdminBanner(); } catch (e1) {}
      try { refreshConnOptimizationStatusFromState(); } catch (e2) {}
      try { syncConnProfileSelectionUi(); } catch (e3) {}
    }, 0);
  }
  if (pageName === "game") {
    window.setTimeout(function () {
      if (currentPageName !== "game") return;
      try { refreshWarzoneInstallStatus(false); } catch (eGw) {}
    }, 0);
  }
  if (pageName === "peripheral") {
    window.setTimeout(function () {
      if (currentPageName !== "peripheral") return;
      writeControllerOverclockerLog("[DEVICE] Tab p\u00e9riph\u00e9rique opened \u2014 refreshing status");
      try { initControllerOverclockerUi(); } catch (eCoInit) {}
      try { refreshUsbControllers(); } catch (eCoScan) {}
      try { ensureControllerOverclockerWatcher(); } catch (eCoWatch) {}
    }, 0);
  } else {
    try { stopControllerOverclockerWatcher(); } catch (eCoStop) {}
  }
  if (pageName === "drivers") {
    try { setDriversTabLightUi(); } catch (eDr) {}
  }
  if (pageName === "home") {
    ensureHomeStatsTimer();
    window.setTimeout(function () {
      if (currentPageName !== "home") return;
      try { applyHomeStatsCacheToUi(); } catch (eHc) {}
      try { initHomeHardwareStaticOnce(); } catch (eHs) {}
    }, 0);
  } else {
    clearHomeStatsTimer();
  }
  perfEnd(mark);
}

