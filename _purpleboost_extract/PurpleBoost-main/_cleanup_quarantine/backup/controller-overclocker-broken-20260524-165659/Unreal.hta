            <span class="nv-driver-upd__title">Preset NVCleanInstall Unreal</span>
          </div>
          <div class="nv-driver-upd__lines">
            <div style="margin-bottom:8px;">
              <span class="tcp-badge tcp-badge--ok" id="nvPresetStatusBadge">Preset : â€”</span>
              <span class="tcp-badge tcp-badge--progress" id="nvPresetNvcBadge" style="margin-left:8px;">NVCleanInstall : â€”</span>
            </div>
            <div id="nvPresetNvcPath" style="font-size:11px;color:#94a3b8;word-break:break-all;">â€”</div>
            <div id="nvPresetMethodLine">MÃ©thode : -</div>
