  return null;
}

function inferNvcleanInstallProgressPct(live, attempts, watchPhase) {
  var mapped = nvcleanProgressFromLiveStatus(live);
  if (mapped) return mapped.pct;
  if (watchPhase === "verify") return 95;
  if (watchPhase === "finalize") return 85;
  if (/Installation terminÃ©e|FenÃªtre fermÃ©e/i.test(live)) return 95;
  if (/bloquÃ©e|bloquee/i.test(live) && attempts > 4 && !/confirmation requise/i.test(live)) return -2;
  if (/Attente de la fenÃªtre finale|FenÃªtre finale/i.test(live)) return 85;
  if (/Detection page prete NVCleanstall|DÃ©tection page prÃªte NVCleanstall|\[NVCleanstall\].*Texte detecte/i.test(live)) return 75;
  if (/\[NVCleanInstall\].*Attente page Finished|Attente de la page Finished|Attente page Finished/i.test(live)) return 70;
  if (/confirmation requise|page d'installation|page d.installation/i.test(live)) return 75;
  if (/Reglages NVIDIA|Preparation NVIDIA|Preparation des fichiers|finalisation/i.test(live)) return 85;
  if (/Installation lancÃ©e|Application des reglages|Install|Pages 1-2/i.test(live)) return 65;
  if (/Ouverture|NVCleanstall|prÃ©paration|Preparation/i.test(live)) return 45;
  if (attempts <= 2) return 10;
  if (attempts <= 4) return 25;
  return Math.min(90, 45 + Math.floor(attempts / 3));
}

function shouldStartNvcleanDriverWatch(live) {
  if (!live) return false;
  if (/Installation NVIDIA lancÃ©e|Installation du pilote NVIDIA en cours|AWAIT_DRIVER|Contrat NVIDIA acceptÃ©|Installation personnalisÃ©e sÃ©lectionnÃ©e/i.test(live)) {
    return true;
  }
  if (/Lancement du programme d'installation NVIDIA|Lancement du programme d installation NVIDIA/i.test(live)) {
    return true;
  }
  if (/Installateur personnalisÃ© prÃªt|Install lancÃ©|programme d'installation NVIDIA/i.test(live)) {
    return true;
  }
  return false;
}

function isNvcleanManualConfirmationLive(live) {
  if (!live) return false;
  return /confirmation requise|page d'installation|page d.installation|confirmation manuelle/i.test(live);
}

function stopNvcleanDriverWatchPoll() {
  nvcleanDriverWatchPollGen++;
}

function showNvcleanVerifyInstallButton(show) {
  var btn = $("btnVerifyNvidiaInstall");
  if (btn) btn.style.display = show ? "" : "none";
}

function refreshDriverStatusAfterNvcleanInstall(det) {
  det = det || detectInstalledNvidiaDriver({ forceFull: true });
  var hw = detectGpuForDriverInstall({ skipLog: true });
  syncNvidiaInfoCacheFromGpu(buildGpuDriverInfoFromDetect(det, hw));
  sessionCache.nvidiaDriverCleaned = false;
  if (det.installed && det.version) {
    sessionCache.gpuDriverUpdate = null;
    nvCheckGeneration++;
    window.setTimeout(function () {
      try { scheduleGpuDriverFullCheck(); } catch (eSch) {}
    }, 500);
  } else if (det.installed) {
    sessionCache.gpuDriverUpdate = {
      status: "installed_unknown",
      latestVersion: "",
      error: "",
      source: det.source || "",
      checkedAt: new Date().getTime()
    };
    applySimplifiedNvMediaCardUi();
  }
}

function readNvidiaOrchFinishedFromLog() {
  var tail = readNvcleanAutoLogTail(50);
  if (/NVIDIA_ORCH_RESULT=finished/i.test(tail)) return true;
  if (/NVIDIA-ORCH-SIMPLE\] Done/i.test(tail)) return true;
  if (/ACTION=nvidia_installer_loop_finished/i.test(tail)) return true;
  return false;
}

function shouldCompleteInstallUiOnNvcClose() {
  if (readNvidiaOrchFinishedFromLog()) return true;
  if (nvidiaInstallerLoopStarted) return true;
  var live = readNvcleanAutoLiveStatus();
  var tail = readNvcleanAutoLogTail(50);
  if (/SCRIPT_LAUNCHED=oui|Installation NVIDIA|NVIDIA_INSTALLER|NVIDIA-ORCH|NVCleanInstall lancÃ©|PS1.*06|\[NVIDIA Driver\]/i.test(tail)) return true;
  if (/Installation terminÃ©e|Finish|Finished|FenÃªtre fermÃ©e|page Finished/i.test(live || "")) return true;
  return false;
}

function logNvcWaitFinishIfNeeded() {
  if (nvcWaitFinishLogged || nvcleanInstallUiCompleted) return;
  if (nvidiaInstallerLoopStarted || readNvidiaOrchFinishedFromLog()) {
    nvcWaitFinishLogged = true;
    writeNvcleanAutoLog("[NVIDIA Driver] Attente fin NVCleanInstall / Finish");
    logNvidiaDriverRefresh("Attente fin NVCleanInstall / Finish");
  }
}

function completeNvcleanInstallProgressUi(reason) {
  if (nvcleanInstallUiCompleted) return;
  nvcleanInstallUiCompleted = true;
  stopNvidiaInstallerWizardLoop();
  stopNvcleanDriverWatchPoll();
  nvcleanAutoPollGen++;
  showNvcleanVerifyInstallButton(false);
  writeNvcleanAutoLog("[NVIDIA Driver] Progression installation pilote 100 %");
  logNvidiaDriverRefresh("Progression installation pilote 100 %");
  writeNvcleanAutoLog("[NVIDIA Driver] Installation du pilote terminÃ©e");
  logNvidiaDriverRefresh("Installation du pilote terminÃ©e");
  if (reason) writeNvcleanAutoLog("INSTALL_UI_COMPLETE=" + reason);
  setNvcleanAutoStatus("Installation du pilote terminÃ©e", "success", 100);
  driversWorkflowState.installDone = true;
  driversWorkflowState.installError = false;
  setNvcleanAutoButtonBusy(false);
  setNvcleanContinueButtonBusy(false);
  nvcleanAutoBusy = false;
  nvcleanTweaksBusy = false;
  sessionCache.gpuDriverInfo = null;
  sessionCache.nvidiaInfo = null;
  var det = detectInstalledNvidiaDriver({ forceFull: true });
  if (det.installed) {
    refreshDriverStatusAfterNvcleanInstall(det);
  } else {
    sessionCache.gpuDriverUpdate = {
      status: "installed_unknown",
      latestVersion: "",
      error: "",
      source: det.source || "",
      checkedAt: new Date().getTime()
    };
    applySimplifiedNvMediaCardUi();
    applyNvidiaDriverUpdatePanel("ok", "Pilote Nvidia installÃ©", "", false);
  }
  try { updateDriversWorkflowGuide(); } catch (eWf) {}
}

function tryCompleteNvcleanInstallOnProcessExit() {
  if (nvcleanInstallUiCompleted) return true;
  if (isNvcleanstallProcessRunning()) {
    nvcInstallProcessSeen = true;
    return false;
  }
  if (!shouldCompleteInstallUiOnNvcClose()) return false;
  if (!nvcInstallProcessSeen && !readNvidiaOrchFinishedFromLog() && !nvidiaInstallerLoopStarted) return false;
  writeNvcleanAutoLog("[NVIDIA Driver] NVCleanInstall terminÃ© ou fermÃ©");
  completeNvcleanInstallProgressUi("nvc_process_closed");
  return true;
}

function finishNvcleanInstallSuccess(detPre) {
  var det = detPre || detectInstalledNvidiaDriver({ forceFull: true });
  if (det.installed) {
    completeNvcleanInstallProgressUi("driver_detected");
    return;
  }
  if (nvcInstallProcessSeen && !isNvcleanstallProcessRunning() && shouldCompleteInstallUiOnNvcClose()) {
    completeNvcleanInstallProgressUi("nvc_closed_no_driver_yet");
    return;
  }
  stopNvcleanDriverWatchPoll();
  showNvcleanVerifyInstallButton(true);
  sessionCache.gpuDriverInfo = null;
  sessionCache.nvidiaInfo = null;
  sessionCache.gpuDriverUpdate = null;
  setNvcleanAutoStatus(
    "Installation terminÃ©e mais aucun pilote Nvidia dÃ©tectÃ© â€” vÃ©rification requise.",
    "error",
    85
  );
  driversWorkflowState.installError = true;
  setNvcleanAutoButtonBusy(false);
  setNvcleanContinueButtonBusy(false);
  nvcleanAutoBusy = false;
  nvcleanTweaksBusy = false;
  try { updateDriversWorkflowGuide(); } catch (eWf) {}
}

function verifyNvidiaInstallAfterManualConfirmation() {
  writeNvcleanAutoLog("ACTION=manual_verify_install");
  var det = detectInstalledNvidiaDriver({ forceFull: true });
  writeNvcleanAutoLog("MANUAL_VERIFY installed=" + (det.installed ? "oui" : "non") + " ver=" + (det.version || ""));
  if (det.installed) {
    nvcleanAutoPollGen++;
    finishNvcleanInstallSuccess(det);
  } else {
    setNvcleanAutoStatus("Aucun pilote Nvidia dÃ©tectÃ© â€” installation non confirmÃ©e.", "error", 85);
    showNvcleanVerifyInstallButton(true);
  }
}

function waitForNvidiaDriverInstalledAfterManualConfirmation() {
  stopNvcleanDriverWatchPoll();
  nvcleanAutoPollGen++;
  var gen = ++nvcleanDriverWatchPollGen;
  var attempts = 0;
  var maxAttempts = 16;
  var pollMs = 500;
  var driverWatchTimedOut = false;
  showNvcleanVerifyInstallButton(true);
  setNvcleanAutoButtonBusy(false);
  writeNvcleanAutoLog("ACTION=driver_watch_after_install");

  function tick() {
    if (gen !== nvcleanDriverWatchPollGen) return;
    logNvcWaitFinishIfNeeded();
    if (tryCompleteNvcleanInstallOnProcessExit()) return;
    attempts++;
    var live = readNvcleanAutoLiveStatus();
    if (isNvidiaInstallerWizardLoopRunning || /\[NVIDIA Installer\]|Installation NVIDIA en cours|nvidia-wizard|NVIDIA_WIZARD|NVIDIA_INSTALLER_WINDOW_READY/i.test(live || "")) {
      setNvcleanAutoStatus("Installation NVIDIA en cours...", "info", 95);
      if (!nvidiaInstallerLoopStarted && shouldStartNvidiaInstallerWizardLoop(live)) {
        RunNvidiaInstallerWizardLoopAsync();
      }
      window.setTimeout(tick, pollMs);
      return;
    }
    if (isNvidiaInstallerWizardLoopRunning) {
      setNvcleanAutoStatus("Installation NVIDIA en cours...", "info", 95);
      window.setTimeout(tick, pollMs);
      return;
    }
    var det = detectInstalledNvidiaDriver({ forceFull: true });
    writeNvcleanAutoLog(
      "DRIVER_WATCH n=" + attempts + " installed=" + (det.installed ? "oui" : "non") +
      " ver=" + (det.version || "")
    );

    if (det.installed) {
      finishNvcleanInstallSuccess(det);
      return;
    }

    var mapped = nvcleanProgressFromLiveStatus(live);
    var pct = 95;
    var msg = "Installation du pilote NVIDIA en cours...";
    if (mapped) {
      pct = mapped.pct;
      msg = mapped.msg;
      if (mapped.pct < 95 && /Installation du pilote NVIDIA en cours/i.test(mapped.msg)) {
        pct = 95;
      }
    } else if (isNvcleanManualConfirmationLive(live)) {
      pct = 75;
      msg = "Confirmation requise dans l'installateur Nvidia â€” en attente de finalisation...";
    }
    setNvcleanAutoStatus(msg, "info", pct);

    if (attempts >= maxAttempts) {
      if (!driverWatchTimedOut) {
        driverWatchTimedOut = true;
        setNvcleanAutoStatus("VÃ©rification pilote impossible pour le moment", "warn", pct);
        writeNvcleanAutoLog("DRIVER_WATCH=timeout_8s_continue");
      }
      showNvcleanVerifyInstallButton(true);
      setNvcleanAutoButtonBusy(false);
      nvcleanAutoBusy = false;
      return;
    }
    window.setTimeout(tick, pollMs);
  }

  var live0 = readNvcleanAutoLiveStatus();
  var mapped0 = nvcleanProgressFromLiveStatus(live0);
  if (mapped0) {
    setNvcleanAutoStatus(mapped0.msg, "info", mapped0.pct);
  } else {
    setNvcleanAutoStatus("Installation du pilote NVIDIA en cours...", "info", 95);
  }
  window.setTimeout(tick, pollMs);
}

function inferDduCleanProgressPct(live, cleanStarted, attempts, driverVerified) {
  if (driverVerified) return 100;
  if (/Nettoyage GPU terminÃ©|redÃ©marrage conseillÃ©|\[DDU\] Bouton Nettoyer/i.test(live || "")) return 95;
  if (/Nettoyage GPU en cours|CLEAN_NO_RESTART_CLICKED/i.test(live || "")) return 70;
  if (/VÃ©rification finale|Nettoyage DDU terminÃ©|DDU fermÃ©/i.test(live || "")) return 90;
  if (cleanStarted && (attempts > 8 || /suppression|registre|packages|fichiers|FenÃªtre finale|Attente de la fenÃªtre/i.test(live || ""))) {
    return 75;
  }
  if (/Nettoyage DDU en cours|Nettoyage lancÃ©|DÃ©sinstallation|Nettoyage en cours|surveillance du nettoyage|DDU lancÃ©|DDU lance|Automatisation impossible|DDU est ouvert|choisis GPU|Nettoyer/i.test(live || "")) {
    return 50;
  }
  if (/Interface DDU|Attente de l'interface|prÃ©paration|PrÃ©paration|Lancement DDU|NoSafeMode|VÃ©rification DDU/i.test(live || "")) {
    return 30;
  }
  if (attempts <= 1) return 0;
  if (attempts <= 2) return 15;
  if (cleanStarted || attempts > 3) return 50;
  return 30;
}

function mapDduLiveStatusToUiMessage(live) {
  if (!live) return "";
  if (/Automatisation impossible/i.test(live)) {
    return "DDU lancÃ© â€” surveillance du nettoyage en cours...";
  }
  return live;
}

function isDduBenignLiveStatus(live) {
  if (!live) return false;
  if (/Nettoyage GPU terminÃ©|Nettoyage GPU en cours|\[DDU\]|FenÃªtre dÃ©tectÃ©e|Pop-up DDU|OK cliquÃ©|Bouton Nettoyer/i.test(live)) return true;
  if (/Nettoyage DDU terminÃ©|DDU fermÃ©|redÃ©marrage conseillÃ©|reboot|restart required|restart recommended/i.test(live)) return true;
  if (/Nettoyage lancÃ©|Nettoyage DDU en cours|Nettoyage en cours|DÃ©sinstallation du pilote/i.test(live)) return true;
  if (/Automatisation impossible|surveillance du nettoyage|DDU lancÃ©|DDU lance/i.test(live)) return true;
  if (/DDU est ouvert/i.test(live) && /choisis GPU|Nettoyer|Nettoyer sans redÃ©marrer/i.test(live)) return true;
  if (/Interface DDU dÃ©tectÃ©e|Attente de l'interface DDU|\[DDU\] Ouverture/i.test(live)) return true;
  return false;
}

function isDduBlockingErrorStatus(live) {
  if (!live) return false;
  if (/Erreur ouverture DDU|ddu_launch_fail/i.test(live)) return true;
  if (/SCRIPT_LAUNCHED=non/i.test(live) && !/DDU lancÃ©|DDU lance|surveillance/i.test(live || "")) return true;
  return false;
}

function fileStartsLikeHtml(path) {
  try {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type = 2;
    st.Charset = "utf-8";
    st.Open();
    st.LoadFromFile(path);
    var t = st.ReadText(128);
    st.Close();
    var s = String(t || "").toLowerCase();
    return s.indexOf("<!doctype html") >= 0 || s.indexOf("<html") >= 0;
  } catch (eH) {
    return false;
  }
}

/** EXE Windows : taille minimale, en-tÃªte MZ, pas une page HTML renommÃ©e. */
function isPeExeFile(path) {
  try {
    var fso = getFso();
    if (!fso.FileExists(path)) return false;
    var sf = fso.GetFile(path);
    if (!sf || sf.Size < 512000) return false;
    if (fileStartsLikeHtml(path)) return false;
    var st = new ActiveXObject("ADODB.Stream");
    st.Type = 1;
    st.Open();
    st.LoadFromFile(path);
    var bin = st.Read(2);
    st.Close();
    if (!bin || bin.length < 2) return false;
    return bin.charCodeAt(0) === 0x4d && bin.charCodeAt(1) === 0x5a;
  } catch (eP) {
    return false;
  }
}

function extractFirstHttpsExeFromText(txt) {
  var m = String(txt || "").match(/https?:\/\/[^\s"'<>]+\.exe(?:\?[^\s"'<>]*)?/i);
  return m && m[0] ? m[0] : "";
}

function extractNvidiaDownloadUrlFromAjaxText(txt) {
  var t = String(txt || "");
  var m = t.match(/"DownloadURL"\s*:\s*"([^"]+)"/i);
  if (m && m[1]) {
    var u = m[1].replace(/\\\//g, "/");
    if (/\.exe(\?|$)/i.test(u)) return u;
  }
  return extractFirstHttpsExeFromText(t);
}

function extractNvidiaDriverVersionFromAjaxText(txt) {
  var t = String(txt || "");
  var m = t.match(/"Version"\s*:\s*"([0-9]+\.[0-9]+)"/i);
  if (m && m[1]) return m[1];
  m = t.match(/"DisplayVersion"\s*:\s*"([0-9]+\.[0-9]+)"/i);
  if (m && m[1]) return m[1];
  return "";
}

function extractVersionFromNvidiaDriverDownloadUrl(url) {
  var u = String(url || "");
  var m = u.match(/\/([0-9]{2,3}\.[0-9]{2})\//);
  if (m && m[1]) return m[1];
  m = u.match(/([0-9]{2,3}\.[0-9]{2})-desktop/i);
  if (m && m[1]) return m[1];
  return "";
}

/** Dernier pilote DCH (URL + version) depuis le service GeForce, ou null. */
function fetchLatestNvidiaDriverFromApi() {
  var iOs, iPf;
  for (iOs = 0; iOs < NVIDIA_DRIVER_LOOKUP_OSIDS.length; iOs++) {
    for (iPf = 0; iPf < NVIDIA_DRIVER_LOOKUP_PFIDS.length; iPf++) {
      try {
        var api = "https://gfwsl.geforce.com/services_toolkit/services/com/nvidia/services/AjaxDriverService.php?beta=null&dch=1&dltype=-1&func=DriverManualLookup&isWHQL=1&languageCode=1033&numberOfResults=1&osID=" + NVIDIA_DRIVER_LOOKUP_OSIDS[iOs] + "&pfid=" + NVIDIA_DRIVER_LOOKUP_PFIDS[iPf];
        var xhr = new ActiveXObject("MSXML2.XMLHTTP");
        xhr.open("GET", api, false);
        xhr.send();
        if (xhr.status !== 200) continue;
        var body = xhr.responseText || "";
        var url = extractNvidiaDownloadUrlFromAjaxText(body);
        if (!url) continue;
        var version = extractNvidiaDriverVersionFromAjaxText(body);
        if (!version) version = extractVersionFromNvidiaDriverDownloadUrl(url);
        return { url: url, version: version };
      } catch (eApi) {}
    }
  }
  return null;
}

function downloadBinaryWithBrowserUa(url, destination) {
  if (!url) throw new Error("URL de tÃ©lÃ©chargement vide.");
  var xhr = new ActiveXObject("MSXML2.XMLHTTP");
  xhr.open("GET", url, false);
  try {
    xhr.setRequestHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36");
  } catch (eUa) {}
  try {
    xhr.setRequestHeader("Accept", "*/*");
  } catch (eAc) {}
  xhr.send();
  if (xhr.status !== 200) throw new Error("HTTP " + xhr.status + "  â€” le serveur a refusÃ© ou redirigÃ© le tÃ©lÃ©chargement.");
  var stream = new ActiveXObject("ADODB.Stream");
  stream.Type = 1;
  stream.Open();
  stream.Write(xhr.responseBody);
  stream.SaveToFile(destination, 2);
  stream.Close();
}

/** Chemin absolu attendu : tools\\NVCleanstall\\NVCleanstall.exe (outil valide uniquement). */
function getPreferredNvcleanstallExePath() {
  var loc = locateNvcleanstallExecutable(false);
  return loc && loc.path ? loc.path : "";
}

function getUnrealNvidiaPresetPath() {
  var app = getAppFolderFromHta();
  if (app) {
    var p1 = getAbsolutePathFs(app + "\\config\\UnrealNvidiaPreset.json");
    if (getFso().FileExists(p1)) return p1;
    var p2 = getAbsolutePathFs(app + "\\UnrealNvidiaPreset.json");
    if (getFso().FileExists(p2)) return p2;
    return p1;
  }
  var loc = getLocalUnrealDir();
  if (loc) return getAbsolutePathFs(loc + "\\config\\UnrealNvidiaPreset.json");
  return "";
}

function ensureDefaultUnrealNvidiaPresetFile() {
  var p = getUnrealNvidiaPresetPath();
  if (!p) return null;
  var fso = getFso();
  if (fso.FileExists(p)) return p;
  try {
    var dir = fso.GetParentFolderName(p);
    if (dir && !fso.FolderExists(dir)) createFolder(dir);
    var bundled = getAppFolderFromHta();
    if (bundled) {
      var src = getAbsolutePathFs(bundled + "\\config\\UnrealNvidiaPreset.json");
      if (fso.FileExists(src)) {
        fso.CopyFile(src, p, true);
        return p;
      }
    }
  } catch (eMk) {}
  return p;
}

function loadUnrealNvidiaPreset() {
  if (sessionCache.nvcPresetLoaded) return sessionCache.nvcPresetLoaded;
  try {
    var p = ensureDefaultUnrealNvidiaPresetFile();
    if (!p || !getFso().FileExists(p)) return null;
    var preset = JSON.parse(readTextFileAll(p));
    sessionCache.nvcPresetLoaded = preset;
    return preset;
  } catch (eL) {
    return null;
  }
}

function appendNvPresetLog(message) {
  var box = $("nvPresetLogBox");
  if (!box) {
    try { log("[NV preset] " + String(message || "")); } catch (e0) {}
    return;
  }
  var line = document.createElement("div");
  line.className = "logline";
  line.textContent = "[" + nowTime() + "] " + message;
  box.insertBefore(line, box.firstChild);
  while (box.childNodes.length > 120) box.removeChild(box.lastChild);
  try { log("[NV preset] " + String(message || "")); } catch (e1) {}
}

function logNvPreset(message) {
  appendNvPresetLog(String(message || ""));
}

function listExeCandidatesInFolder(folderDir, maxDepth, depth) {
  var out = [];
  var fso = getFso();
  if (!folderDir || !fso.FolderExists(folderDir)) return out;
  depth = depth || 0;
  if (depth > (maxDepth || 2)) return out;
  try {
    var folder = fso.GetFolder(folderDir);
    var ef = new Enumerator(folder.Files);
    for (; !ef.atEnd(); ef.moveNext()) {
      var file = ef.item();
      var name = String(file.Name || "");
      if (/\.exe$/i.test(name)) out.push(getAbsolutePathFs(String(file.Path || "")));
    }
    if (depth < (maxDepth || 2)) {
      var sd = new Enumerator(folder.SubFolders);
      for (; !sd.atEnd(); sd.moveNext()) {
        var sub = sd.item();
        var subPath = String(sub.Path || "");
        if (/\\Windows|\\Program Files|\\Program Files \(x86\)/i.test(subPath)) continue;
        out = out.concat(listExeCandidatesInFolder(subPath, maxDepth, depth + 1));
      }
    }
  } catch (eList) {}
  return out;
}

function locateNvcleanstallExecutable(forceRescan) {
  try {
    if (!forceRescan && sessionCache.nvcExeLocate && sessionCache.nvcExeLocate.path) {
      return sessionCache.nvcExeLocate;
    }
    var fso = getFso();
    var sh = getShell();
    var hits = [];
    function addHit(path, source) {
      try {
        var p = getAbsolutePathFs(String(path || ""));
        if (!p || !isLaunchableExeFile(p)) return;
        var score = scoreNvcleanstallExeName(fso.GetFileName(p));
        if (score < 70) return;
        hits.push({ path: p, source: source, score: score });
      } catch (eHit) {}
    }
    var toolsDir = getNvcleanstallToolsDir();
    if (toolsDir) addHit(toolsDir + "\\NVCleanstall.exe", "tools");
    var app = getAppFolderFromHta();
    if (app) {
      addHit(app + "\\tools\\NVCleanstall\\NVCleanstall.exe", "app-tools");
      var appExes = listExeCandidatesInFolder(app, 3, 0);
      var i;
      for (i = 0; i < appExes.length; i++) addHit(appExes[i], "app-scan");
    }
    try {
      var down = sh.ExpandEnvironmentStrings("%USERPROFILE%\\Downloads");
      var desk = sh.ExpandEnvironmentStrings("%USERPROFILE%\\Desktop");
      var j;
      if (down) {
        var downExes = listExeCandidatesInFolder(down, 1, 0);
        for (j = 0; j < downExes.length; j++) addHit(downExes[j], "downloads");
      }
      if (desk) {
        var deskExes = listExeCandidatesInFolder(desk, 1, 0);
        for (j = 0; j < deskExes.length; j++) addHit(deskExes[j], "desktop");
      }
    } catch (eEnv) {}
    hits.sort(function (a, b) {
      if (b.score !== a.score) return b.score - a.score;
      return String(a.source).length - String(b.source).length;
    });
    var best = hits.length ? hits[0] : null;
    sessionCache.nvcExeLocate = best;
    return best;
  } catch (eLoc) {
    try {
      writeNvcleanAutoLog("[SCRIPT] locateNvcleanstall: " + String(eLoc.message || eLoc));
    } catch (eLog) {}
    return null;
  }
}

function getNvcleanstallFileVersion(exePath) {
  try {
    var sh = getShell();
    var folder = getFso().GetParentFolderName(exePath);
    var name = getFso().GetFileName(exePath);
    var cmd = "cmd /c for %V in (\"" + String(exePath).replace(/"/g, "") + "\") do @echo %~zV|%V";
    var out = runCommandCapture("powershell.exe -NoProfile -Command \"(Get-Item -LiteralPath '" + String(exePath).replace(/'/g, "''") + "').VersionInfo.FileVersion\"");
    var v = String(out || "").replace(/^\s+|\s+$/g, "");
    if (v) return v;
    var m = String(name || "").match(/NVCleanstall[_\s-]?([0-9]+(?:\.[0-9]+)+)/i);
    if (m && m[1]) return m[1];
  } catch (eV) {}
  return "";
}

function probeNvcleanstallCapabilities(exePath) {
  var result = {
  probedAt: new Date().getTime(),
    exePath: exePath || "",
    cliSupported: false,
    cliHelpSnippet: "",
    configFiles: [],
    configWritablePath: "",
    deployDir: "",
    method: "guided"
  };
  if (!exePath || !isLaunchableExeFile(exePath)) return result;
  var fso = getFso();
  var exeDir = fso.GetParentFolderName(exePath);
  var sh = getShell();
  var cfgNames = ["NVCleanstall.ini", "settings.ini", "Settings.xml", "config.json", "NVCleanstallSettings.xml"];
  var cfgRoots = [
    exeDir,
    sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\NVCleanstall"),
    sh.ExpandEnvironmentStrings("%APPDATA%\\NVCleanstall"),
    sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\NVCleanInstall"),
    sh.ExpandEnvironmentStrings("%APPDATA%\\NVCleanInstall"),
    sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\TechPowerUp\\NVCleanstall")
  ];
  var i, j, cp, cn;
  for (i = 0; i < cfgRoots.length; i++) {
    var root = cfgRoots[i];
    if (!root || !fso.FolderExists(root)) continue;
    for (j = 0; j < cfgNames.length; j++) {
      cn = cfgNames[j];
      cp = getAbsolutePathFs(root + "\\" + cn);
      if (fso.FileExists(cp)) result.configFiles.push(cp);
    }
  }
  var args = ["/?", "--help", "-h", "/help"];
  var helpAll = "";
  for (i = 0; i < args.length; i++) {
    try {
      var out = runCommandCapture('"' + String(exePath).replace(/"/g, "") + '" ' + args[i]);
      if (out && out.length > helpAll.length) helpAll = out;
    } catch (eH) {}
  }
  result.cliHelpSnippet = String(helpAll || "").substring(0, 600);
  if (/silent|unattend|preset|config|\.ini|import|export|command[- ]?line/i.test(helpAll)) {
    result.cliSupported = true;
  }
  if (result.configFiles.length) {
    result.configWritablePath = result.configFiles[0];
    if (/^tools|app-tools/i.test(String(sessionCache.nvcExeLocate && sessionCache.nvcExeLocate.source))) {
      result.method = "config";
    }
  }
  if (result.cliSupported) result.method = "cli";
  var deploy = getNvcleanstallToolsDir() || exeDir;
  if (deploy) result.deployDir = getAbsolutePathFs(deploy + "\\UnrealPresetDeploy");
  return result;
}

function mapPresetToNvcleanstallIniLines(preset) {
  var lines = [];
  lines.push("; Unreal  â€” preset NVCleanInstall Gaming / Unreal (suggestion, non officiel)");
  lines.push("; Composants : 1 = installer, 0 = ne pas installer");
  var c = preset.components || {};
  var t = preset.tweaks || {};
  function onOff(obj, key) {
    if (!obj || !obj[key]) return "0";
    if (obj[key].enabled === true || obj[key].required) return "1";
    return "0";
  }
  lines.push("DisplayDriver=" + onOff(c, "displayDriver"));
  lines.push("PhysX=" + onOff(c, "physX"));
  lines.push("NVIDIA_DLSS=" + onOff(c, "nvidiaDlss"));
  lines.push("LegacyControlPanel=" + onOff(c, "legacyControlPanel"));
  lines.push("HDAudio=" + onOff(c, "hdAudioHdmi"));
  lines.push("VCpp2017=" + onOff(c, "vcpp2017"));
  lines.push("USBC=" + onOff(c, "usbC"));
  lines.push("FrameViewSDK=" + onOff(c, "frameViewSdk"));
  lines.push("QuadroView=" + onOff(c, "quadroView"));
  lines.push("VirtualAudio=" + onOff(c, "virtualAudio"));
  lines.push("Telemetry=" + onOff(c, "telemetry"));
  lines.push("NVPlatformControllers=" + onOff(c, "nvPlatformControllers"));
  lines.push("NVIDIAApp=" + onOff(c, "nvidiaApp"));
  lines.push("NVContainer=" + onOff(c, "nvContainer"));
  lines.push("ShadowPlay=" + onOff(c, "shadowPlay"));
  lines.push("NVBackend=" + onOff(c, "nvBackend"));
  lines.push("NVIDIAAppMessageBus=" + onOff(c, "nvidiaAppMessageBus"));
  lines.push("; Tweaks");
  lines.push("DisableInstallerTelemetry=" + onOff(t, "disableInstallerTelemetryAdvertising"));
  lines.push("UnattendedExpressInstallation=" + onOff(t, "unattendedExpressInstallation"));
  lines.push("PerformCleanInstallation=" + onOff(t, "performCleanInstallation"));
  lines.push("AddHardwareSupport=" + onOff(t, "addHardwareSupport"));
  lines.push("EnableDLSSIndicator=" + onOff(t, "enableDlssIndicator"));
  lines.push("DisableMPO=" + onOff(t, "disableMpo"));
  lines.push("DisableAnsel=" + onOff(t, "disableAnsel"));
  lines.push("ShowExpertTweaks=" + onOff(t, "showExpertTweaks"));
  lines.push("DisableDriverTelemetry=" + onOff(t, "disableDriverTelemetryExperimental"));
  lines.push("DisableNVIDIAContainer=" + onOff(t, "disableNvidiaContainerExperimental"));
  lines.push("DisableHDAudioSleepTimer=" + onOff(t, "disableHdAudioSleepTimer"));
  lines.push("EnableMSI=" + onOff(t, "enableMsi"));
  lines.push("InterruptPolicy=" + (t.interruptPolicy && t.interruptPolicy.value ? t.interruptPolicy.value : "Default"));
  lines.push("InterruptPriority=" + (t.interruptPriority && t.interruptPriority.value ? t.interruptPriority.value : "Default"));
  lines.push("DisableHDCP=" + onOff(t, "disableHdcp"));
  lines.push("ApplyNVENCPatch=" + onOff(t, "applyNvencSessionLimitPatch"));
  lines.push("StartExternalApp=" + onOff(t, "startExternalApplication"));
  lines.push("RebuildDigitalSignature=" + onOff(t, "rebuildDigitalSignature"));
  lines.push("EACCompatibleMethod=" + onOff(t, "easyAntiCheatCompatibleMethod"));
  lines.push("AutoAcceptUnsignedWarning=" + onOff(t, "autoAcceptDriverUnsignedWarning"));
  return lines;
}

function buildUnrealNvidiaPresetChecklist(preset) {
  var lines = [];
  var c = preset.components || {};
  var t = preset.tweaks || {};
  var k;
  lines.push("=== Composants Ã  cocher dans NVCleanInstall ===");
  for (k in c) {
    if (!c.hasOwnProperty(k) || !c[k] || !c[k].label) continue;
    var mark = (c[k].enabled || c[k].required) ? "[x]" : "[ ]";
    lines.push(mark + " " + c[k].label);
  }
  lines.push("");
  lines.push("=== Installation Tweaks ===");
  for (k in t) {
    if (!t.hasOwnProperty(k) || !t[k] || !t[k].label) continue;
    if (t[k].value) {
      lines.push("[=] " + t[k].label + " : " + t[k].value);
    } else {
      mark = t[k].enabled ? "[x]" : "[ ]";
      lines.push(mark + " " + t[k].label);
    }
  }
  return lines;
}

function deployUnrealNvidiaPresetFiles(preset, probe) {
  var applied = [];
  var skipped = [];
  var deployDir = probe && probe.deployDir ? probe.deployDir : "";
  if (!deployDir) {
    skipped.push("Dossier de dÃ©ploiement introuvable");
    return { applied: applied, skipped: skipped, deployDir: "" };
  }
  if (!createFolder(deployDir)) {
    skipped.push("Impossible de crÃ©er le dossier deploy");
    return { applied: applied, skipped: skipped, deployDir: deployDir };
  }
  var fso = getFso();
  var presetPath = getUnrealNvidiaPresetPath();
  try {
    if (presetPath && fso.FileExists(presetPath)) {
      fso.CopyFile(presetPath, deployDir + "\\UnrealNvidiaPreset.json", true);
      applied.push("UnrealNvidiaPreset.json");
    }
  } catch (eCp) {
    skipped.push("Copie preset : " + String(eCp.message || eCp));
  }
  var checklist = buildUnrealNvidiaPresetChecklist(preset);
  try {
    var tw = fso.CreateTextFile(deployDir + "\\UnrealNvidiaPreset.checklist.txt", true);
    tw.Write(checklist.join("\r\n"));
    tw.Close();
    applied.push("UnrealNvidiaPreset.checklist.txt");
  } catch (eCl) {
    skipped.push("Checklist : " + String(eCl.message || eCl));
  }
  var iniLines = mapPresetToNvcleanstallIniLines(preset);
  try {
    var tw2 = fso.CreateTextFile(deployDir + "\\UnrealNvidiaPreset.suggested.ini", true);
    tw2.Write(iniLines.join("\r\n"));
    tw2.Close();
    applied.push("UnrealNvidiaPreset.suggested.ini");
  } catch (eIn) {
    skipped.push("INI : " + String(eIn.message || eIn));
  }
  if (probe && probe.configWritablePath && /\\tools\\NVCleanstall/i.test(probe.configWritablePath)) {
    try {
      var targetIni = getAbsolutePathFs(fso.GetParentFolderName(probe.configWritablePath) + "\\UnrealNvidiaPreset.suggested.ini");
      var tw3 = fso.CreateTextFile(targetIni, true);
      tw3.Write(iniLines.join("\r\n"));
      tw3.Close();
      applied.push("INI outils (Ã  importer si NVCleanInstall le supporte)");
    } catch (eT) {
      skipped.push("INI outils : " + String(eT.message || eT));
    }
  }
  return { applied: applied, skipped: skipped, deployDir: deployDir };
}

function readNvPresetState() {
  try {
    var p = UNREAL_BASE + "\\nvc-preset-state.json";
    if (!getFso().FileExists(p)) return null;
    return JSON.parse(readTextFileAll(p));
  } catch (e) {
    return null;
  }
}

function writeNvPresetState(obj) {
  try {
    createUnrealFolders();
    var prev = readNvPresetState() || {};
    var k;
    for (k in obj) if (obj.hasOwnProperty(k)) prev[k] = obj[k];
    var w = getFso().CreateTextFile(UNREAL_BASE + "\\nvc-preset-state.json", true);
    w.Write(JSON.stringify(prev, null, 2));
    w.Close();
  } catch (eW) {}
}

function prepareUnrealNvidiaPresetForInstall(exePath, options) {
  options = options || {};
  var preset = loadUnrealNvidiaPreset();
  var result = {
    ok: false,
    method: "guided",
    applied: [],
    skipped: [],
    checklist: [],
    deployDir: ""
  };
  if (!preset) {
    logNvPreset("Preset Unreal chargÃ© : non");
    result.skipped.push("Fichier UnrealNvidiaPreset.json introuvable");
    return result;
  }
  logNvPreset("Preset Unreal chargÃ© : oui (" + (preset.presetName || preset.presetId) + ")");
  var probe = probeNvcleanstallCapabilities(exePath);
  sessionCache.nvcPresetProbe = probe;
  logNvPreset("Support ligne de commande : " + (probe.cliSupported ? "oui" : "non"));
  logNvPreset("Fichier config dÃ©tectÃ© : " + (probe.configFiles.length ? "oui" : "non"));
  if (probe.configFiles.length) logNvPreset("Config : " + probe.configFiles.join(" | "));
  var deploy = deployUnrealNvidiaPresetFiles(preset, probe);
  result.applied = deploy.applied;
  result.skipped = deploy.skipped;
  result.deployDir = deploy.deployDir;
  result.checklist = buildUnrealNvidiaPresetChecklist(preset);
  if (probe.method === "cli" && probe.cliSupported) {
    result.method = "cli";
    result.ok = true;
    logNvPreset("MÃ©thode : automatique (arguments CLI dÃ©tectÃ©s  â€” validation manuelle requise)");
  } else if (probe.method === "config" && deploy.applied.length) {
    result.method = "config";
    result.ok = true;
    logNvPreset("MÃ©thode : config (fichiers dÃ©ployÃ©s dans tools  â€” import selon version NVCleanInstall)");
  } else {
    result.method = "guided";
    result.ok = true;
    logNvPreset("MÃ©thode : guidÃ©e (checklist  â€” pas d'automatisation souris)");
  }
  var i;
  for (i = 0; i < result.applied.length; i++) logNvPreset("Option dÃ©ployÃ©e : " + result.applied[i]);
  for (i = 0; i < result.skipped.length; i++) logNvPreset("Option ignorÃ©e : " + result.skipped[i]);
  if (!options.dryRun) {
    writeNvPresetState({
      lastApplied: nowDateTimeFr(),
      method: result.method,
      deployDir: result.deployDir,
      exePath: exePath || ""
    });
  }
  return result;
}

/* ---------- NVCleanstall preset fichier (sans clics souris) ---------- */
var NVCLEAN_PRESET_LOG_PATH = "";

function initNvcleanstallPresetLogPath() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  NVCLEAN_PRESET_LOG_PATH = app
    ? combinePath(app, "logs\\nvcleaninstall-preset.log")
    : combinePath(UNREAL_BASE, "logs\\nvcleaninstall-preset.log");
}

function writeNvcleanstallPresetLog(line) {
  initNvcleanstallPresetLogPath();
  try {
    var fso = getFso();
    var folder = fso.GetParentFolderName(NVCLEAN_PRESET_LOG_PATH);
    if (folder && !fso.FolderExists(folder)) fso.CreateFolder(folder);
    var ForAppending = 8;
    if (!fso.FileExists(NVCLEAN_PRESET_LOG_PATH)) {
      var t0 = fso.CreateTextFile(NVCLEAN_PRESET_LOG_PATH, true);
      t0.WriteLine(line);
      t0.Close();
    } else {
      var t1 = fso.OpenTextFile(NVCLEAN_PRESET_LOG_PATH, ForAppending, true);
      t1.WriteLine(line);
      t1.Close();
    }
  } catch (eLog) {}
}

function getNvcleanstallUnrealPresetPath() {
  var app = getAppFolderFromHta() || getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (!app) return "";
  return getAbsolutePathFs(app + "\\config\\NVCleanstall_UnrealPreset.json");
}

function buildNvcleanstallUnrealPresetSpec() {
  return {
    bestDriverForHardware: true,
    components: { displayDriver: true },
    tweaks: {
      disableInstallerTelemetryAdvertising: true,
      performCleanInstall: true,
      disableMPO: true,
      disableAnsel: true,
      showExpertTweaks: true,
      disableDriverTelemetry: true,
      enableMSI: true,
      disableHDCP: true,
      easyAntiCheatCompatible: true,
      acceptUnsignedWarning: true
    }
  };
}

function nvcPresetSpecToIniKeyMap(spec) {
  var m = {};
  var compOff = {
    DisplayDriver: "1",
    PhysX: "0",
    NVIDIA_DLSS: "0",
    LegacyControlPanel: "0",
    HDAudio: "0",
    VCpp2017: "0",
    USBC: "0",
    FrameViewSDK: "0",
    QuadroView: "0",
    VirtualAudio: "0",
    Telemetry: "0",
    NVPlatformControllers: "0",
    NVIDIAApp: "0",
    NVContainer: "0",
    ShadowPlay: "0",
    NVBackend: "0",
    NVIDIAAppMessageBus: "0"
  };
  var ck;
  for (ck in compOff) {
    if (compOff.hasOwnProperty(ck)) m[ck] = compOff[ck];
  }
  if (spec && spec.tweaks) {
    var t = spec.tweaks;
    if (t.disableInstallerTelemetryAdvertising) m.DisableInstallerTelemetry = "1";
    if (t.performCleanInstall) m.PerformCleanInstallation = "1";
    if (t.disableMPO) m.DisableMPO = "1";
    if (t.disableAnsel) m.DisableAnsel = "1";
    if (t.showExpertTweaks) m.ShowExpertTweaks = "1";
    if (t.disableDriverTelemetry) m.DisableDriverTelemetry = "1";
    if (t.enableMSI) m.EnableMSI = "1";
    if (t.disableHDCP) m.DisableHDCP = "1";
    if (t.easyAntiCheatCompatible) m.EACCompatibleMethod = "1";
    if (t.acceptUnsignedWarning) m.AutoAcceptUnsignedWarning = "1";
  }
  m.InstallBestDriverForHardware = "1";
  m.BestDriverForHardware = "1";
  m.AutoSelectBestDriver = "1";
  return m;
}

function writeNvcleanstallInternalPresetFile(spec) {
  var path = getNvcleanstallUnrealPresetPath();
  if (!path) return { ok: false, path: "", error: "path_unresolved" };
  try {
    var dir = getFso().GetParentFolderName(path);
    if (dir && !getFso().FolderExists(dir)) createFolder(dir);
    var tw = getFso().CreateTextFile(path, true);
    tw.Write(JSON.stringify(spec, null, 2));
    tw.Close();
    return { ok: true, path: path, error: "" };
  } catch (eW) {
    return { ok: false, path: path, error: String(eW.message || eW) };
  }
}

function collectNvcleanstallPresetSearchRoots(nvcExePath) {
  var fso = getFso();
  var sh = getShell();
  var roots = [];
  var seen = {};
  function add(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d] || !fso.FolderExists(d)) return;
    seen[d] = true;
    roots.push(d);
  }
  if (nvcExePath && fso.FileExists(nvcExePath)) add(fso.GetParentFolderName(nvcExePath));
  add(getNvcleanstallToolsDir());
  add(sh.ExpandEnvironmentStrings("%LOCALAPPDATA%"));
  add(sh.ExpandEnvironmentStrings("%APPDATA%"));
  add(sh.ExpandEnvironmentStrings("%PROGRAMDATA%"));
  add(sh.ExpandEnvironmentStrings("%USERPROFILE%\\Documents"));
  add(sh.ExpandEnvironmentStrings("%USERPROFILE%\\Downloads"));
  add(sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\NVCleanstall"));
  add(sh.ExpandEnvironmentStrings("%APPDATA%\\NVCleanstall"));
  add(sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\NVCleanInstall"));
  add(sh.ExpandEnvironmentStrings("%APPDATA%\\NVCleanInstall"));
  add(sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\TechPowerUp\\NVCleanstall"));
  return roots;
}

function nvcConfigFileNameLooksRelevant(name) {
  return /nvcleanstall|nvcleaninstall|techpowerup|settings|config|preset|preferences|profile/i.test(String(name || ""));
}

function nvcConfigFileHasUsefulKeywords(content) {
  return /telemetry|advertising|clean|mpo|multiplane|ansel|expert|msi|message\s*signaled|hdcp|anti-?cheat|unsigned|warning|display\s*driver|DisableMPO|PerformClean|ShowExpert/i.test(String(content || ""));
}

function searchNvcleanstallConfigFilesLimited(nvcExePath) {
  var fso = getFso();
  var roots = collectNvcleanstallPresetSearchRoots(nvcExePath);
  var found = [];
  var seenFile = {};
  var extRe = /\.(ini|json|xml|cfg|config|txt)$/i;
  var cfgNames = ["NVCleanstall.ini", "settings.ini", "Settings.xml", "config.json", "NVCleanstallSettings.xml", "preferences.ini", "profile.ini"];
  var maxFiles = 48;
  function pushFile(fp) {
    var p = getAbsolutePathFs(fp);
    if (!p || seenFile[p] || !fso.FileExists(p)) return;
    if (!extRe.test(p)) return;
    if (!nvcConfigFileNameLooksRelevant(fso.GetFileName(p))) return;
    seenFile[p] = true;
    found.push(p);
  }
  function scanDir(dir, depth) {
    if (!dir || depth > 2 || found.length >= maxFiles) return;
    var i;
    try {
      for (i = 0; i < cfgNames.length; i++) pushFile(dir + "\\" + cfgNames[i]);
      var folder = fso.GetFolder(dir);
      var fc = new Enumerator(folder.Files);
      for (; !fc.atEnd(); fc.moveNext()) {
        if (found.length >= maxFiles) break;
        pushFile(fc.item().Path);
      }
      if (depth < 2) {
        var sub = new Enumerator(folder.SubFolders);
        for (; !sub.atEnd(); sub.moveNext()) {
          if (found.length >= maxFiles) break;
          var subName = sub.item().Name;
          if (/nvcleanstall|nvcleaninstall|techpowerup|config|settings|preset/i.test(subName)) {
            scanDir(sub.item().Path, depth + 1);
          }
        }
      }
    } catch (eScan) {}
  }
  var r;
  for (r = 0; r < roots.length; r++) scanDir(roots[r], 0);
  return { roots: roots, files: found };
}

function backupNvcConfigFile(filePath) {
  var fso = getFso();
  var backupPath = filePath + ".bak-unreal";
  try {
    if (fso.FileExists(backupPath)) return { ok: true, path: backupPath };
    fso.CopyFile(filePath, backupPath, false);
    return { ok: true, path: backupPath };
  } catch (eB) {
    return { ok: false, path: "", error: String(eB.message || eB) };
  }
}

function countIniKnownKeysInContent(content, keyMap) {
  var found = 0;
  var lines = String(content || "").split(/\r?\n/);
  var i, m, k;
  for (i = 0; i < lines.length; i++) {
    m = /^\s*([A-Za-z0-9_]+)\s*=/.exec(lines[i]);
    if (m && keyMap[m[1]]) found++;
  }
  return found;
}

function applyPresetToIniContent(content, keyMap, allowAdd) {
  var lines = String(content || "").split(/\r?\n/);
  var keysFound = [];
  var keysModified = [];
  var present = countIniKnownKeysInContent(content, keyMap);
  var canAdd = !!allowAdd && present >= 3;
  var i, m, key, line, newLine, re;
  for (i = 0; i < lines.length; i++) {
    line = lines[i];
    m = /^\s*([A-Za-z0-9_]+)\s*=\s*(.*)$/.exec(line);
    if (!m) continue;
    key = m[1];
    if (!keyMap[key]) continue;
    keysFound.push(key);
    newLine = key + "=" + keyMap[key];
    if (line !== newLine) {
      lines[i] = newLine;
      keysModified.push(key);
    }
  }
  if (canAdd) {
    for (key in keyMap) {
      if (!keyMap.hasOwnProperty(key)) continue;
      re = new RegExp("^\\s*" + key + "\\s*=", "m");
      if (!re.test(content)) {
        lines.push(key + "=" + keyMap[key]);
        keysModified.push(key + "(added)");
      }
    }
  }
  return {
    content: lines.join("\r\n"),
    keysFound: keysFound,
    keysModified: keysModified,
    format: "ini"
  };
}

function applyPresetToJsonContent(content, keyMap) {
  var keysFound = [];
  var keysModified = [];
  try {
    var obj = JSON.parse(content);
    var flat = {};
    function walk(o, prefix) {
      var k;
      for (k in o) {
        if (!o.hasOwnProperty(k)) continue;
        var path = prefix ? prefix + "." + k : k;
        if (o[k] !== null && typeof o[k] === "object" && !o[k].length && typeof o[k] !== "boolean") {
          walk(o[k], path);
        } else {
          flat[k] = o[k];
        }
      }
    }
    walk(obj, "");
    var mapKey, fileKey;
    for (mapKey in keyMap) {
      if (!keyMap.hasOwnProperty(mapKey)) continue;
      for (fileKey in flat) {
        if (!flat.hasOwnProperty(fileKey)) continue;
        if (String(fileKey).toLowerCase() === String(mapKey).toLowerCase()) {
          keysFound.push(fileKey);
          var want = keyMap[mapKey] === "1" || keyMap[mapKey] === "true";
          if (typeof flat[fileKey] === "boolean" && flat[fileKey] !== want) {
            flat[fileKey] = want;
            keysModified.push(fileKey);
          } else if (String(flat[fileKey]) !== String(keyMap[mapKey])) {
            flat[fileKey] = mapKey.indexOf("Disable") === 0 || mapKey.indexOf("Enable") === 0 ? (keyMap[mapKey] === "1") : keyMap[mapKey];
            keysModified.push(fileKey);
          }
        }
      }
    }
    if (!keysModified.length) return { content: content, keysFound: keysFound, keysModified: keysModified, format: "json" };
    for (mapKey in keyMap) {
      if (!keyMap.hasOwnProperty(mapKey)) continue;
      if (obj[mapKey] !== undefined && String(obj[mapKey]) !== String(keyMap[mapKey])) {
        obj[mapKey] = keyMap[mapKey] === "1";
        if (keysModified.indexOf(mapKey) < 0) keysModified.push(mapKey);
      }
    }
    return { content: JSON.stringify(obj, null, 2), keysFound: keysFound, keysModified: keysModified, format: "json" };
  } catch (eJ) {
    return { content: content, keysFound: keysFound, keysModified: keysModified, format: "json-invalid" };
  }
}

function applyPresetToConfigFile(filePath, keyMap) {
  var content = readTextFileAll(filePath);
  if (!content || !nvcConfigFileHasUsefulKeywords(content)) {
    return { ok: false, analyzed: true, exploitable: false, keysFound: [], keysModified: [], backup: "" };
  }
  var lower = String(filePath).toLowerCase();
  var result;
  if (/\.json$/i.test(lower)) result = applyPresetToJsonContent(content, keyMap);
  else result = applyPresetToIniContent(content, keyMap, false);
  if (!result.keysFound.length && !result.keysModified.length) {
    return { ok: false, analyzed: true, exploitable: false, keysFound: [], keysModified: [], backup: "" };
  }
  if (!result.keysModified.length) {
    return { ok: false, analyzed: true, exploitable: true, keysFound: result.keysFound, keysModified: [], backup: "" };
  }
  var bak = backupNvcConfigFile(filePath);
  if (!bak.ok) return { ok: false, analyzed: true, exploitable: true, keysFound: result.keysFound, keysModified: [], backup: "", error: bak.error };
  try {
    var tw = getFso().CreateTextFile(filePath, true);
    tw.Write(result.content);
    tw.Close();
    return {
      ok: true,
      analyzed: true,
      exploitable: true,
      keysFound: result.keysFound,
      keysModified: result.keysModified,
      backup: bak.path,
      format: result.format
    };
  } catch (eW) {
    return { ok: false, analyzed: true, exploitable: true, keysFound: result.keysFound, keysModified: [], backup: bak.path, error: String(eW.message || eW) };
  }
}

function prepareNvcleanstallPreset() {
  initNvcleanstallPresetLogPath();
  writeNvcleanstallPresetLog("DATE=" + new Date().toISOString());
  writeNvcleanstallPresetLog("ACTION=prepare_nvcleaninstall_preset");
  setNvcleanAutoStatus("Recherche des fichiers de configuration NVCleanstall...", "info");
  var nvcPath = getPreferredNvcleanstallExePath();
  writeNvcleanstallPresetLog("NVCLEANSTALL_PATH=" + (nvcPath || ""));
  var spec = buildNvcleanstallUnrealPresetSpec();
  var internal = writeNvcleanstallInternalPresetFile(spec);
  writeNvcleanstallPresetLog("INTERNAL_PRESET_CREATED=" + (internal.ok ? "oui" : "non"));
  if (internal.path) writeNvcleanstallPresetLog("INTERNAL_PRESET_PATH=" + internal.path);
  if (!internal.ok) writeNvcleanstallPresetLog("INTERNAL_PRESET_ERROR=" + internal.error);
  var keyMap = nvcPresetSpecToIniKeyMap(spec);
  var search = searchNvcleanstallConfigFilesLimited(nvcPath);
  writeNvcleanstallPresetLog("SEARCH_PATHS=" + search.roots.join(" | "));
  writeNvcleanstallPresetLog("CONFIG_FILES_FOUND=" + search.files.length);
  var allKeysFound = [];
  var allKeysModified = [];
  var backups = [];
  var filesModified = 0;
  var i, fp, applyRes;
  for (i = 0; i < search.files.length; i++) {
    fp = search.files[i];
    writeNvcleanstallPresetLog("CONFIG_FILE_ANALYZED=" + fp);
    applyRes = applyPresetToConfigFile(fp, keyMap);
    if (applyRes.keysFound && applyRes.keysFound.length) {
      writeNvcleanstallPresetLog("KEYS_FOUND=" + applyRes.keysFound.join(","));
      allKeysFound = allKeysFound.concat(applyRes.keysFound);
    }
    if (applyRes.ok) {
      filesModified++;
      if (applyRes.keysModified.length) {
        writeNvcleanstallPresetLog("KEYS_MODIFIED=" + applyRes.keysModified.join(","));
        allKeysModified = allKeysModified.concat(applyRes.keysModified);
      }
      if (applyRes.backup) {
        backups.push(applyRes.backup);
        writeNvcleanstallPresetLog("BACKUP_CREATED=oui");
        writeNvcleanstallPresetLog("BACKUP_PATH=" + applyRes.backup);
      }
    } else if (applyRes.exploitable) {
      writeNvcleanstallPresetLog("KEYS_MODIFIED=");
      writeNvcleanstallPresetLog("BACKUP_CREATED=non");
    }
  }
  if (!search.files.length) {
    writeNvcleanstallPresetLog("RESULT=no_config_files");
    writeNvcleanstallPresetLog("ERROR=");
    setNvcleanAutoStatus("Aucun fichier de configuration NVCleanstall exploitable trouve.", "info");
    if (internal.ok) {
      window.setTimeout(function () {
        setNvcleanAutoStatus("Preset interne cree, mais aucun fichier NVCleanstall modifiable trouve.", "info");
      }, 1200);
    }
    return;
  }
  if (filesModified > 0) {
    writeNvcleanstallPresetLog("RESULT=preset_applied");
    writeNvcleanstallPresetLog("ERROR=");
    setNvcleanAutoStatus("Preset NVCleanstall applique. Ouvre NVCleanstall pour verifier les reglages.", "success");
    return;
  }
  writeNvcleanstallPresetLog("RESULT=internal_only");
  writeNvcleanstallPresetLog("ERROR=");
  if (internal.ok) {
    setNvcleanAutoStatus("Preset interne cree, mais aucun fichier NVCleanstall modifiable trouve.", "info");
  } else {
    setNvcleanAutoStatus("Aucun fichier de configuration NVCleanstall exploitable trouve.", "info");
  }
}

function verifyNvidiaTweaksAfterInstall(preset) {
  var out = [];
  function pushLine(name, status, detail) {
    out.push({ name: name, status: status, detail: detail || "" });
  }
  try {
    var mpo = queryRegValueText("HKLM\\SOFTWARE\\Microsoft\\Windows\\Dwm", "OverlayTestMode");
    if (/REG_DWORD\s+0x5\b/i.test(mpo) || /REG_DWORD\s+5(\s|$)/i.test(mpo)) {
      pushLine("MPO dÃ©sactivÃ©", "ok", "OverlayTestMode=5");
    } else if (mpo) {
      pushLine("MPO dÃ©sactivÃ©", "unknown", "Valeur actuelle : " + mpo.replace(/\s+/g, " "));
    } else {
      pushLine("MPO dÃ©sactivÃ©", "unknown", "non vÃ©rifiable automatiquement");
    }
  } catch (eM) {
    pushLine("MPO dÃ©sactivÃ©", "unknown", "non vÃ©rifiable automatiquement");
  }
  pushLine("Composants NVIDIA (App/ShadowPlay)", "unknown", "non vÃ©rifiable automatiquement");
  pushLine("TÃ©lÃ©mÃ©trie pilote", "unknown", "non vÃ©rifiable automatiquement");
  pushLine("HDCP", "unknown", "non vÃ©rifiable automatiquement");
  pushLine("MSI", "unknown", "non vÃ©rifiable automatiquement");
  return out;
}

function setNvPresetBadge(elId, text, kind) {
  var el = $(elId);
  if (!el) return;
  var cls = "tcp-badge";
  if (kind === "ok") cls += " tcp-badge--ok";
  else if (kind === "warn") cls += " tcp-badge--warn";
  else if (kind === "bad") cls += " tcp-badge--bad";
  else cls += " tcp-badge--progress";
  el.className = cls;
  el.innerText = text || "â€”";
}

function refreshNvPresetUi() {
  var preset = loadUnrealNvidiaPreset();
  if (preset) setNvPresetBadge("nvPresetStatusBadge", "Preset : actif", "ok");
  else setNvPresetBadge("nvPresetStatusBadge", "Preset : introuvable", "bad");
  var loc = locateNvcleanstallExecutable(false);
  if (loc && loc.path) {
    setNvPresetBadge("nvPresetNvcBadge", "NVCleanInstall : dÃ©tectÃ©", "ok");
    if ($("nvPresetNvcPath")) $("nvPresetNvcPath").innerText = loc.path;
  } else {
    setNvPresetBadge("nvPresetNvcBadge", "NVCleanInstall : non dÃ©tectÃ©", "warn");
    if ($("nvPresetNvcPath")) $("nvPresetNvcPath").innerText = "â€”";
  }
  var st = readNvPresetState();
  var method = (sessionCache.nvcPresetProbe && sessionCache.nvcPresetProbe.method) || (st && st.method) || "â€”";
  if (method === "guided") method = "guidÃ©e";
  else if (method === "config") method = "config";
  else if (method === "cli") method = "automatique (CLI)";
  if ($("nvPresetMethodLine")) $("nvPresetMethodLine").innerText = "MÃ©thode : " + method;
  if ($("nvPresetLastAppliedLine")) {
    $("nvPresetLastAppliedLine").innerText = "DerniÃ¨re application du preset : " + ((st && st.lastApplied) ? st.lastApplied : "â€”");
  }
  var upd = sessionCache.gpuDriverUpdate;
  if ($("nvPresetDriverLine")) {
    if (upd && upd.status === "update") $("nvPresetDriverLine").innerText = "Dernier pilote : mise Ã  jour disponible";
    else if (upd && upd.status === "uptodate") $("nvPresetDriverLine").innerText = "Dernier pilote : Ã  jour";
    else $("nvPresetDriverLine").innerText = "Dernier pilote : â€”";
  }
}

var nvPresetProbeBusy = false;

function scheduleNvPresetProbe(force) {
  if (nvPresetProbeBusy && !force) return;
  nvPresetProbeBusy = true;
  window.setTimeout(function () {
    try {
      var loc = locateNvcleanstallExecutable(!!force);
      if (loc && loc.path) {
        logNvPreset("Chemin NVCleanInstall trouvÃ© : " + loc.path + " (" + loc.source + ")");
        var ver = getNvcleanstallFileVersion(loc.path);
        logNvPreset("Version NVCleanInstall : " + (ver || "inconnue"));
        sessionCache.nvcPresetProbe = probeNvcleanstallCapabilities(loc.path);
        var preset = loadUnrealNvidiaPreset();
        if (preset) prepareUnrealNvidiaPresetForInstall(loc.path, { dryRun: true });
      } else {
        logNvPreset("NVCleanInstall non dÃ©tectÃ© (tools, Downloads, Bureau, projet)");
      }
      refreshNvPresetUi();
    } catch (ePr) {
      logNvPreset("Erreur probe preset : " + String(ePr.message || ePr));
    }
    nvPresetProbeBusy = false;
  }, 30);
}

function showUnrealNvidiaPresetChecklist() {
  var preset = loadUnrealNvidiaPreset();
  if (!preset) {
    alert("Preset Unreal introuvable (config\\UnrealNvidiaPreset.json).");
    return;
  }
  var lines = buildUnrealNvidiaPresetChecklist(preset);
  var i;
  for (i = 0; i < lines.length; i++) appendNvPresetLog(lines[i]);
  var st = readNvPresetState();
  if (st && st.deployDir) {
    appendNvPresetLog("Fichiers : " + st.deployDir);
    try {
      getShell().Run('explorer.exe "' + String(st.deployDir).replace(/"/g, "") + '"', 1, false);
    } catch (eEx) {}
  }
}

function openNvcleanstallWithPresetGuidance() {
  var loc = locateNvcleanstallExecutable(false);
  if (!loc || !loc.path) {
    if (window.confirm("NVCleanInstall non dÃ©tectÃ©.\n\nTÃ©lÃ©charger / ouvrir la page officielle ?")) {
      openNvcleanstall();
    }
    return;
  }
  prepareUnrealNvidiaPresetForInstall(loc.path, { dryRun: false });
  showUnrealNvidiaPresetChecklist();
  if (!window.confirm("Ouvrir NVCleanInstall maintenant ?\n\nSuivez la checklist affichÃ©e dans le journal preset (composants + tweaks).")) return;
  var res = launchNvcleanstallExeElevated(loc.path, logNvPreset);
  if (res === "ok") setNvcleanstallOpenStatus("NVCleanInstall ouvert  â€” appliquez le preset Unreal.", "ok");
  else nvcleanstallSetLaunchErrorUi(res);
}

function downloadNvcleanstallBinaryToPreferredPath(logFn) {
  var dir = getNvcleanstallToolsDir();
  if (!dir) throw new Error("Impossible de rÃ©soudre le dossier tools\\NVCleanstall (emplacement d'Unreal.hta).");
  if (!createFolder(dir)) throw new Error("Impossible de crÃ©er le dossier tools\\NVCleanstall (accÃ¨s refusÃ© ou chemin invalide).");
  var dest = getAbsolutePathFs(dir + "\\NVCleanstall.exe");
  var fso = getFso();
  var lastErr = "";
  var i;
  for (i = 0; i < NVCLEANSTALL_DIRECT_EXE_URLS.length; i++) {
    try {
      if (logFn) logFn("TÃ©lÃ©chargement NVCleanstall (miroir " + (i + 1) + ") : " + NVCLEANSTALL_DIRECT_EXE_URLS[i]);
      downloadBinaryWithBrowserUa(NVCLEANSTALL_DIRECT_EXE_URLS[i], dest);
      if (isLaunchableExeFile(dest)) return dest;
      lastErr = "Le fichier tÃ©lÃ©chargÃ© n'est pas un exÃ©cutable utilisable (contenu invalide ou page d'erreur).";
      try {
        if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
      } catch (eRm) {}
    } catch (e) {
      lastErr = String(e.message || e);
      try {
        if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
      } catch (eRm2) {}
    }
  }
  throw new Error(lastErr || "Ã©chec du tÃ©lÃ©chargement de NVCleanstall depuis tous les miroirs TechPowerUp.");
}

/**
 * Journal : rÃ©glages NVCleanstall Ã  appliquer (NVCleanstall ne documente pas de ligne de commande complÃ¨te pour tout prÃ©-cocher ;
 * le pilote est passÃ© en argument pour ouvrir directement le package ; vÃ©rifiez l'assistant si une Ã©tape reste manuelle).
 */
function logNvcleanstallExpectedSettings(logFn) {
  if (!logFn) return;
  var preset = loadUnrealNvidiaPreset();
  if (!preset) {
    logFn("Preset UnrealNvidiaPreset.json : introuvable");
    return;
  }
  var lines = buildUnrealNvidiaPresetChecklist(preset);
  var i;
  logFn("Preset Unreal  â€” checklist NVCleanInstall :");
  for (i = 0; i < lines.length; i++) logFn("  " + lines[i]);
}

function shellQuoteAbsolutePath(path) {
  var p = getAbsolutePathFs(path);
  p = String(p || "").split('"').join("");
  return '"' + p + '"';
}

function nvcleanstallSetLaunchErrorUi(code, detail) {
  var map = {
    missing: "Erreur : fichier EXE introuvable.",
    invalid: "Erreur : fichier invalide ou non exÃ©cutable (extension, taille nulle, ou fichier HTML renommÃ©).",
    uac_cancel: "Erreur : Ã©lÃ©vation administrateur refusÃ©e (UAC annulÃ©).",
    access: "Erreur : accÃ¨s refusÃ©.",
    blocked: "Erreur : fichier peut Ãªtre bloquÃ© par Windows ou l'antivirus.",
    unknown: "Erreur : le lancement a Ã©chouÃ© (voir le journal)."
  };
  var base = map[code] || map.unknown;
  if (detail) base += " " + detail;
  setNvcleanstallOpenStatus(base, "bad");
}

/** Lance NVCleanstall avec chemin absolu ; retour ok | missing | invalid | uac_cancel | access | unknown */
function launchNvcleanstallExeElevated(absExePath, logFn) {
  var p = "";
  try {
    p = getAbsolutePathFs(absExePath);
    if (logFn) logFn("PrÃ©paration du lancement (ShellExecute, runas, rÃ©pertoire de travail = dossier de l'exe)...");
    var fso = getFso();
    if (!fso.FileExists(p)) {
      if (logFn) logFn("Erreur prÃ©cise : fichier introuvable Ã  l'emplacement attendu.");
      return "missing";
    }
    try {
      var sz = fso.GetFile(p).Size;
      if (logFn) logFn("Fichier trouvÃ© : oui  â€” taille " + String(sz) + " octet(s).");
    } catch (eSz) {
      if (logFn) logFn("Impossible de lire la taille du fichier : " + String(eSz.message || eSz));
    }
    if (!isLaunchableExeFile(p)) {
      if (logFn) {
        if (!/\.exe$/i.test(String(p))) logFn("Erreur prÃ©cise : le chemin ne se terminÃ©e pas par .exe.");
        else if (fileLooksLikeAsciiHtmlSavedAsExe(p)) logFn("Erreur prÃ©cise : le contenu ressemble Ã  du HTML/texte (pas un binaire d'application).");
        else logFn("Erreur prÃ©cise : fichier absent, taille nulle, ou illisible.");
      }
      return "invalid";
    }
    if (logFn) logFn("Chemin absolu utilisÃ© pour ShellExecute : " + p);
    if (logFn) logFn("RÃ©pertoire de travail : " + fso.GetParentFolderName(p));
    launchFileAsAdmin(p);
    return "ok";
  } catch (e) {
    var msg = String(e.message || e || "");
    if (logFn) logFn("Erreur exacte au lancement (exception) : " + msg);
    if (/1223|cancel|cancelled|annul/i.test(msg)) return "uac_cancel";
    if (/accÃ¨s|access|permission|denied|refus/i.test(msg)) return "access";
    if (/bloqu|blocked|smartscreen|protÃ©gÃ©/i.test(msg)) return "blocked";
    return "unknown";
  }
}

function openNvcleanstall() {
  appendNvMediaLog("openNvcleanstall dÃ©but");
  setNvcleanstallOpenStatus("VÃ©rification en cours...", "progress");
  try {
    var dir = getNvcleanstallToolsDir();
    appendNvMediaLog("Dossier outil : " + (dir ? getAbsolutePathFs(dir) : "(non rÃ©solu)"));
    if (!dir) {
      nvcleanstallSetLaunchErrorUi("missing");
      alert("Erreur : dossier introuvable.");
      setNvcleanstallOpenStatus("", "");
      return;
    }
    if (!createFolder(dir)) {
      alert("Erreur : impossible de crÃ©er tools\\NVCleanstall.");
      nvcleanstallSetLaunchErrorUi("access");
      setNvcleanstallOpenStatus("", "");
      return;
    }
    tryMigrateLegacyNvcleanstallFolder(dir);
    var nvc = getPreferredNvcleanstallExePath();
    if (!nvc) {
      var askDl = window.confirm("NVCleanstall n'est pas installÃ© dans tools\\NVCleanstall\\NVCleanstall.exe.\n\nTÃ©lÃ©charger automatiquement depuis TechPowerUp ?\n\n(Annuler = ouvrir la page officielle.)");
      if (askDl) {
        setNvcleanstallOpenStatus("TÃ©lÃ©chargement en cours...", "progress");
        try {
          nvc = downloadNvcleanstallBinaryToPreferredPath(appendNvMediaLog);
        } catch (eDl) {
          var md = String(eDl.message || eDl);
          appendNvMediaLog("Ã©chec tÃ©lÃ©chargement NVCleanstall : " + md);
          openNvcleanstallOfficialDownloadPage();
          alert("Erreur : tÃ©lÃ©chargement impossible.\n" + md);
          setNvcleanstallOpenStatus("", "");
          return;
        }
      } else {
        openNvcleanstallOfficialDownloadPage();
        setNvcleanstallOpenStatus("", "");
        return;
      }
    }
    if (!nvc) {
      setNvcleanstallOpenStatus("", "");
      return;
    }
    setNvcleanstallOpenStatus("Ouverture en cours...", "progress");
    var res = launchNvcleanstallExeElevated(nvc, appendNvMediaLog);
    if (res === "ok") {
      setNvcleanstallOpenStatus("Ouverture rÃ©ussie.", "ok");
      window.setTimeout(function () {
        setNvcleanstallOpenStatus("", "");
      }, 5000);
    } else {
      nvcleanstallSetLaunchErrorUi(res);
      var detail = "";
      if (res === "uac_cancel") detail = "Ã‰lÃ©vation administrateur annulÃ©e.";
      else if (res === "access") detail = "AccÃ¨s refusÃ©.";
      else if (res === "invalid") detail = "Fichier NVCleanstall.exe invalide ou inaccessible.";
      else if (res === "blocked") detail = "Fichier peut Ãªtre bloquÃ© par Windows ou l'antivirus.";
      else detail = "Erreur : ouverture impossible.";
      if (detail) alert(detail);
    }
  } catch (eAll) {
    var em = String(eAll.message || eAll);
    appendNvMediaLog("Exception : " + em);
    alert("Erreur : " + em);
    setNvcleanstallOpenStatus("", "");
  }
}

function installLatestNvidiaDriverAutomatic() {
  appendNvMediaLog("installLatestNvidiaDriverAutomatic dÃ©but");
  setNvMediaAutoStatus("VÃ©rification en cours...", "progress", 6);
  window.setTimeout(function () {
    try { installLatestNvidiaDriverAutomaticImpl(); } catch (eTop) {
      var em = String(eTop.message || eTop);
      appendNvMediaLog("Exception : " + em);
      alert("Erreur : " + em);
      setNvMediaAutoStatus("", "", -1);
    }
  }, 20);
}

function installLatestNvidiaDriverAutomaticImpl() {
  try {
    showNvGpuManualPick(false);
    setNvMediaAutoStatus("Pilote graphique absent aprÃ¨s nettoyage DDU. Recherche du matÃ©riel GPU...", "progress", 8);
    appendNvMediaLog("DÃ©tection GPU matÃ©riel pour installation pilote...");
    var hw = detectGpuForDriverInstall({});
    var detInstall = detectInstalledNvidiaDriver({ forceFull: true });
    var info = getInstalledNvidiaDriverInfo(true);
    if (hw.hasNvidia) {
      info.hasNvidia = true;
      if (!info.gpuName || hw.hardwareOnly) info.gpuName = hw.gpuName || info.gpuName || "GPU NVIDIA";
      info.detectionSource = hw.detectionSource || info.detectionSource;
      info.hardwareOnly = !detInstall.installed && hw.hardwareOnly;
    }
    if (detInstall.installed && detInstall.version) {
      info.driverVersion = detInstall.version;
      info.source = detInstall.source;
      info.hardwareOnly = false;
    } else {
      info.driverVersion = "";
      info.hardwareOnly = !!(hw.hasNvidia || info.hasNvidia);
    }
    if ($("nvGpuDetected")) {
      $("nvGpuDetected").innerText = info.gpuName || (info.hasNvidia ? "GPU NVIDIA" : "â€”");
    }
    if ($("nvDriverInstalled")) {
      $("nvDriverInstalled").innerText = info.driverVersion || (info.hasNvidia ? "Aucun pilote installÃ©" : "â€”");
    }
    if (!info.hasNvidia) {
      showNvGpuManualPick(true);
      setNvMediaAutoStatus("Impossible de dÃ©tecter le GPU. Choisis le fabricant manuellement.", "bad", 0);
      appendNvMediaLog("NVIDIA non dÃ©tectÃ© (cache/PCI/pnputil/video)");
      setNvMediaAutoStatus("", "", -1);
      return;
    }
    if (hw.detectionSource === "cache") {
      setNvMediaAutoStatus("Dernier GPU connu : NVIDIA. Installation du pilote possible.", "progress", 14);
      appendNvMediaLog("GPU depuis cache : " + (hw.gpuName || "NVIDIA"));
    } else if (hw.detectionSource === "pnp_entity" || hw.detectionSource === "pnputil") {
      setNvMediaAutoStatus("Carte NVIDIA dÃ©tectÃ©e sans pilote. Installation du pilote possible.", "progress", 14);
      appendNvMediaLog("GPU NVIDIA matÃ©riel (" + hw.detectionSource + ")");
    } else if (!info.driverVersion) {
      setNvMediaAutoStatus("Carte NVIDIA dÃ©tectÃ©e sans pilote. Installation du pilote possible.", "progress", 14);
    }

    setNvMediaAutoStatus("VÃ©rification en cours...", "progress", 18);
    appendNvMediaLog("Pilote installÃ© : " + (info.driverVersion || "(absent)") + " source=" + (info.source || hw.detectionSource || ""));
    var bundle = fetchLatestNvidiaDriverFromApi();
    if (!bundle || !bundle.url) {
      setNvMediaAutoStatus("Erreur : vÃ©rification impossible.", "bad", 0);
      appendNvMediaLog("API NVIDIA sans rÃ©sultat");
      alert("Erreur : impossible de rÃ©cupÃ©rer le dernier pilote (rÃ©seau ou service NVIDIA).");
      setNvMediaAutoStatus("", "", -1);
      return;
    }
    appendNvMediaLog("Dernier pilote : " + (bundle.version || "?") + " " + bundle.url);

    var latestVer = bundle.version || "";
    if (info.driverVersion && latestVer && detInstall.installed) {
      var cmp = compareDriverVersions(info.driverVersion, latestVer);
      if (cmp >= 0) {
        setNvMediaAutoStatus("Pilote NVIDIA Ã  jour.", "ok", 100);
        appendNvMediaLog("DÃ©jÃ  Ã  jour");
        window.setTimeout(function () {
          setNvMediaAutoStatus("", "", -1);
        }, 8000);
        return;
      }
    } else if (!info.driverVersion) {
      appendNvMediaLog("Pas de pilote installÃ©  â€” installation via NVCleanInstall");
    }

    setNvMediaAutoStatus("VÃ©rification en cours...", "progress", 28);
    appendNvMediaLog("Mise Ã  jour nÃ©cessaire vers " + (latestVer || "?"));

    var cacheDir = getNvidiaDriverCacheDir();
    if (!cacheDir || !createFolder(cacheDir)) {
      setNvMediaAutoStatus("Erreur : prÃ©paration impossible.", "bad", 0);
      appendNvMediaLog("Cache pilote introuvable : " + (cacheDir || ""));
      alert("Erreur : impossible de prÃ©parer le dossier de tÃ©lÃ©chargement.");
      setNvMediaAutoStatus("", "", -1);
      return;
    }
    var safeVer = latestVer ? latestVer.replace(/[^\d.]/g, "") : "";
    var dest = getAbsolutePathFs(cacheDir + "\\nvidia-driver-" + (safeVer || "latest") + ".exe");
    var fso = getFso();
    try {
      if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
    } catch (eOld) {}

    setNvMediaAutoStatus("TÃ©lÃ©chargement en cours...", "progress", 45);
    appendNvMediaLog("TÃ©lÃ©chargement vers " + dest);
    try {
      downloadBinaryWithBrowserUa(bundle.url, dest);
    } catch (eDl) {
      var mDl = String(eDl.message || eDl);
      setNvMediaAutoStatus("Erreur : tÃ©lÃ©chargement impossible.", "bad", 0);
      appendNvMediaLog("DL erreur : " + mDl);
      alert("Erreur : tÃ©lÃ©chargement impossible.\n" + mDl);
      try {
        if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
      } catch (eRm) {}
      setNvMediaAutoStatus("", "", -1);
      return;
    }

    try {
      var szDrv = fso.GetFile(dest).Size;
      appendNvMediaLog("Taille fichier : " + String(szDrv));
    } catch (eSz) {
      appendNvMediaLog("Taille illisible : " + String(eSz.message || eSz));
    }

    var driverOk = false;
    try {
      if (isPeExeFile(dest)) driverOk = true;
      else if (isLaunchableExeFile(dest)) {
        var szCheck = fso.GetFile(dest).Size;
        if (szCheck > 5000000) driverOk = true;
        else appendNvMediaLog("Taille pilote suspecte : " + String(szCheck));
      }
    } catch (eValDrv) {
      appendNvMediaLog("Validation : " + String(eValDrv.message || eValDrv));
      driverOk = false;
    }
    if (!driverOk) {
      setNvMediaAutoStatus("Erreur : tÃ©lÃ©chargement impossible.", "bad", 0);
      appendNvMediaLog("Fichier pilote invalide");
      alert("Erreur : fichier tÃ©lÃ©chargÃ© invalide.");
      try {
        if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
      } catch (eRm2) {}
      setNvMediaAutoStatus("", "", -1);
      return;
    }

    setNvMediaAutoStatus("PrÃ©paration en cours...", "progress", 62);
    tryMigrateLegacyNvcleanstallFolder(getNvcleanstallToolsDir());
    var nvc = getPreferredNvcleanstallExePath();
    if (!nvc) {
      if (!window.confirm("NVCleanstall est introuvable.\n\nTÃ©lÃ©charger NVCleanstall automatiquement ?")) {
        setNvMediaAutoStatus("OpÃ©ration annulÃ©e.", "bad", 0);
        appendNvMediaLog("Utilisateur a annulÃ© sans NVCleanstall");
        alert("OpÃ©ration annulÃ©e. Pilote enregistrÃ© :\n" + dest);
        setNvMediaAutoStatus("", "", -1);
        return;
      }
      try {
        nvc = downloadNvcleanstallBinaryToPreferredPath(appendNvMediaLog);
      } catch (eNv) {
        var mNv = String(eNv.message || eNv);
        setNvMediaAutoStatus("Erreur : tÃ©lÃ©chargement impossible.", "bad", 0);
        appendNvMediaLog("NVCleanstall DL : " + mNv);
        alert("Erreur : tÃ©lÃ©chargement impossible.\n" + mNv);
        setNvMediaAutoStatus("", "", -1);
        return;
      }
    }

    setNvMediaAutoStatus("PrÃ©paration du pilote...", "progress", 72);
    var prep = prepareUnrealNvidiaPresetForInstall(nvc, { dryRun: false });
    logNvcleanstallExpectedSettings(appendNvMediaLog);
    if (prep.method === "guided") {
      setNvMediaAutoStatus("Application du preset Unreal (guidÃ©e)...", "progress", 78);
      appendNvMediaLog("Mode guidÃ© : suivez la checklist preset avant de valider dans NVCleanInstall");
    } else {
      setNvMediaAutoStatus("Application du preset Unreal...", "progress", 78);
      appendNvMediaLog("Preset dÃ©ployÃ© : " + (prep.deployDir || "â€”"));
    }
    appendNvMediaLog("Lancement NVCleanstall + pilote");

    setNvMediaAutoStatus("Installation NVIDIA en cours...", "progress", 92);
    var driverArg = shellQuoteAbsolutePath(dest);
    launchFileAsAdminWithArgs(nvc, driverArg);

    setNvMediaAutoStatus("Terminez l'assistant NVCleanInstall...", "progress", 96);
    appendNvMediaLog("NVCleanInstall lancÃ© avec le package pilote  â€” Terminez l'assistant");
    try {
      sessionCache.nvidiaInfo = null;
      window.setTimeout(function () {
        try { applyNvDriverInfoToUi(true); } catch (eNvRef) {}
      }, 0);
    } catch (eNvRef2) {}
    alert("NVCleanInstall est ouvert avec le pilote tÃ©lÃ©chargÃ©.\n\nAppliquez le preset Unreal (checklist dans le journal preset / dossier UnrealPresetDeploy).\n\nTerminez l'assistant, puis redÃ©marrez si demandÃ©.");
    window.setTimeout(function () {
      try { scheduleGpuDriverFullCheck(); } catch (eVer) {}
    }, 0);
  } catch (eAll) {
    var msg = String(eAll && eAll.message ? eAll.message : eAll);
    setNvMediaAutoStatus("Erreur : installation impossible.", "bad", 0);
    appendNvMediaLog("Exception : " + msg);
    alert("Erreur : installation impossible.\n" + msg);
  }
  try {
    window.setTimeout(function () {
      setNvMediaAutoStatus("", "", -1);
    }, 14000);
  } catch (eT) {
    setNvMediaAutoStatus("", "", -1);
  }
}

/* ---------- NVCleanstall auto (expÃ©rimental, AutoHotkey v2 + UIA) ---------- */
var NVCLEAN_AUTO_LOG_PATH = "";
var NVCLEAN_AUTO_LIVE_PATH = "";
var nvcleanAutoBusy = false;
var nvcleanTweaksBusy = false;
var nvcleanAutoPollGen = 0;
var nvcleanPackageReadyLogged = false;
var nvcleanKeyboardActionLogged = false;
var nvcleanDriverWatchPollGen = 0;
var nvcleanContinuePromptVisible = false;
var isNvidiaInstallerWizardLoopRunning = false;
var nvidiaInstallerLoopGen = 0;
var nvidiaInstallerLoopStarted = false;
var nvidiaElevatedHelperLaunchAttempted = false;
var nvidiaInstallerTickBusy = false;
var nvidiaOrchestratorWatcherGen = 0;
var nvidiaOrchestratorWatcherStarted = false;
var nvcInstallProcessSeen = false;
var nvcleanInstallUiCompleted = false;
var nvcWaitFinishLogged = false;

function initNvcleanAutoPaths() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) {
    NVCLEAN_AUTO_LOG_PATH = combinePath(app, "logs\\nvcleaninstall-auto.log");
    NVCLEAN_AUTO_LIVE_PATH = combinePath(app, "logs\\nvcleaninstall-auto-live.txt");
  } else {
    NVCLEAN_AUTO_LOG_PATH = combinePath(UNREAL_BASE, "logs\\nvcleaninstall-auto.log");
    NVCLEAN_AUTO_LIVE_PATH = combinePath(UNREAL_BASE, "logs\\nvcleaninstall-auto-live.txt");
  }
}

function writeNvcleanAutoLog(line) {
  try {
    initNvcleanAutoPaths();
    var fso = getFso();
    var folder = fso.GetParentFolderName(NVCLEAN_AUTO_LOG_PATH);
    if (folder && !fso.FolderExists(folder)) {
      try {
        fso.CreateFolder(folder);
      } catch (eMk) {}
    }
    var ForAppending = 8;
    if (!fso.FileExists(NVCLEAN_AUTO_LOG_PATH)) {
      var t0 = fso.CreateTextFile(NVCLEAN_AUTO_LOG_PATH, true);
      t0.WriteLine(line);
      t0.Close();
    } else {
      var t1 = fso.OpenTextFile(NVCLEAN_AUTO_LOG_PATH, ForAppending, true);
      t1.WriteLine(line);
      t1.Close();
    }
  } catch (eLog) {
    try {
      log("[NVClean auto] " + String(line || ""));
    } catch (eL) {}
  }
}

function writeNvcleanAutoLiveStatus(message) {
  initNvcleanAutoPaths();
  try {
    var fso = getFso();
    var dir = fso.GetParentFolderName(NVCLEAN_AUTO_LIVE_PATH);
    if (dir && !fso.FolderExists(dir)) fso.CreateFolder(dir);
    var st = fso.OpenTextFile(NVCLEAN_AUTO_LIVE_PATH, 8, true, -1);
    st.WriteLine("STATUS=" + String(message || ""));
    st.Close();
  } catch (eW) {}
}

function clearNvcleanAutoLiveFile() {
  initNvcleanAutoPaths();
  try {
    var fso = getFso();
    if (fso.FileExists(NVCLEAN_AUTO_LIVE_PATH)) fso.DeleteFile(NVCLEAN_AUTO_LIVE_PATH);
  } catch (eClr) {}
}

function readNvcleanAutoLiveStatus() {
  initNvcleanAutoPaths();
  try {
    var fso = getFso();
    if (!fso.FileExists(NVCLEAN_AUTO_LIVE_PATH)) return "";
    var txt = readTextFileAll(NVCLEAN_AUTO_LIVE_PATH);
    if (!txt) return "";
    var lines = String(txt).split(/\r?\n/);
    var i;
    for (i = lines.length - 1; i >= 0; i--) {
      var line = String(lines[i] || "");
      if (line.indexOf("STATUS=") === 0) return line.replace(/^STATUS=/, "");
    }
  } catch (eR) {}
  return "";
}

function readNvcleanAutoLogTail(maxLines) {
  initNvcleanAutoPaths();
  try {
    var fso = getFso();
    if (!fso.FileExists(NVCLEAN_AUTO_LOG_PATH)) return "";
    var txt = readTextFileAll(NVCLEAN_AUTO_LOG_PATH);
    if (!txt) return "";
    var lines = String(txt).split(/\r?\n/);
    var start = Math.max(0, lines.length - (maxLines || 30));
    return lines.slice(start).join("\n");
  } catch (eT) {}
  return "";
}

function readNvidiaInstallerTickResultFromLog() {
  var tail = readNvcleanAutoLogTail(40);
  var mOrch = tail.match(/NVIDIA_ORCH_RESULT=([^\r\n]+)/gi);
  if (mOrch && mOrch.length) {
    var lastO = mOrch[mOrch.length - 1];
    var po = lastO.split("=");
    if (po.length >= 2) return String(po[1]).toLowerCase();
  }
  var mElev = tail.match(/NVIDIA_ELEVATED_RESULT=([^\r\n]+)/gi);
  if (mElev && mElev.length) {
    var lastE = mElev[mElev.length - 1];
    var pe = lastE.split("=");
    if (pe.length >= 2) return String(pe[1]).toLowerCase();
  }
  var m = tail.match(/NVIDIA_TICK_RESULT=([^\r\n]+)/gi);
  if (m && m.length) {
    var last = m[m.length - 1];
    var parts = last.split("=");
    if (parts.length >= 2) return String(parts[1]).toLowerCase();
  }
  return "continue";
}

function shouldStartNvidiaInstallerWizardLoop(live) {
  if (nvidiaInstallerLoopStarted || isNvidiaInstallerWizardLoopRunning) return false;
  var logTail = readNvcleanAutoLogTail(40);
  if (/NVIDIA_INSTALLER_WINDOW_READY=oui/i.test(logTail)) return true;
  live = live || readNvcleanAutoLiveStatus();
  if (/Lancement du programme d'installation NVIDIA|Lancement du programme d installation NVIDIA/i.test(live)) return true;
  if (/\[NVIDIA Installer\] FenÃªtre Programme/i.test(live)) return true;
  if (/NVIDIA Setup is running|Setup is running|Programme d'installation NVIDIA/i.test(live)) return true;
  return false;
}

function stopNvidiaInstallerWizardLoop() {
  isNvidiaInstallerWizardLoopRunning = false;
  nvidiaInstallerLoopGen++;
}

function refreshNvidiaDriverOnceAfterInstallerClosed() {
  writeNvcleanAutoLog("ACTION=nvidia_installer_closed_refresh_driver");
  var det = detectInstalledNvidiaDriver({ forceFull: true });
  writeNvcleanAutoLog(
    "POST_INSTALLER_DRIVER installed=" + (det.installed ? "oui" : "non") +
    " ver=" + (det.version || "")
  );
  if (tryCompleteNvcleanInstallOnProcessExit()) return;
  if (det.installed) {
    finishNvcleanInstallSuccess(det);
    return;
  }
  if (nvcInstallProcessSeen && !isNvcleanstallProcessRunning()) {
    completeNvcleanInstallProgressUi("installer_closed");
    return;
  }
  setNvcleanAutoStatus("Installation NVIDIA terminÃ©e â€” validation finale manuelle si demandÃ©e.", "info", 100);
  showNvcleanVerifyInstallButton(true);
}

function probeNvidiaInstallerWindowVisible() {
  try {
    initNvcleanAutoPaths();
    var scriptsDir = getAppScriptsDir();
    if (!scriptsDir) return false;
    var helperCs = getAbsolutePathFs(combinePath(scriptsDir, "NvidiaWin32Msaa-helper.cs"));
    if (!helperCs || !getFso().FileExists(helperCs)) return false;
    var escPath = String(helperCs).replace(/'/g, "''");
    var psCmd =
      "Add-Type -Path '" + escPath + "'; " +
      "$h=[NvidiaWin32Msaa]::FindNvidiaInstallerRootHwnd(); " +
      "if ($h -ne [IntPtr]::Zero) { Write-Output 'NVIDIA_INSTALLER_WINDOW_PROBE=FOUND' }";
    var out = runCommandCapture("powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"" + psCmd.replace(/"/g, "\\\"") + "\"");
    return /NVIDIA_INSTALLER_WINDOW_PROBE=FOUND/i.test(String(out || ""));
  } catch (eProbe) {
  }
  return false;
}

function probeNvidiaLicensePageVisible() {
  try {
    initNvcleanAutoPaths();
    var scriptsDir = getAppScriptsDir();
    if (!scriptsDir) return false;
    var helperCs = getAbsolutePathFs(combinePath(scriptsDir, "NvidiaWin32Msaa-helper.cs"));
    if (!helperCs || !getFso().FileExists(helperCs)) return false;
    var escPath = String(helperCs).replace(/'/g, "''");
    var psCmd =
      "Add-Type -Path '" + escPath + "'; " +
      "$h=[NvidiaWin32Msaa]::FindNvidiaInstallerRootHwnd(); " +
      "if ($h -eq [IntPtr]::Zero) { exit 1 }; " +
      "$ok=$false; " +
      "foreach ($c in [NvidiaWin32Msaa]::EnumChildren($h)) { " +
      "  if (-not $c.Visible) { continue }; " +
      "  $n=($c.Text + '').ToLowerInvariant().Replace('&','').Replace('Ã©','e').Replace('Ã¨','e'); " +
      "  if ($n -eq 'accepter et continuer' -or $n -eq 'accept and continue' -or $n -eq 'agree and continue') { $ok=$true; break } " +
      "}; " +
      "if ($ok) { Write-Output 'NVIDIA_LICENSE_PROBE=FOUND' }";
    var out = runCommandCapture("powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"" + psCmd.replace(/"/g, "\\\"") + "\"");
    return /NVIDIA_LICENSE_PROBE=FOUND/i.test(String(out || ""));
  } catch (eLic) {}
  return false;
}

function startNvidiaPs1OrchestratorIfNeeded() {
  if (nvidiaElevatedHelperLaunchAttempted) return;
  writeNvcleanAutoLog("[NVIDIA Driver] Lancement orchestrateur PS1...");
  logNvidiaDriverRefresh("Lancement orchestrateur PS1...");
  launchNvidiaInstallerElevatedHelperAsync(function () {});
  if (!isNvidiaInstallerWizardLoopRunning) {
    RunNvidiaInstallerWizardLoopAsync(true);
  }
}

function launchNvidiaInstallerElevatedHelperAsync(onDone) {
  if (nvidiaElevatedHelperLaunchAttempted) {
    if (onDone) onDone({ already: true });
    return;
  }
  nvidiaElevatedHelperLaunchAttempted = true;
  initNvcleanAutoPaths();
  var scriptsDir = getAppScriptsDir();
  var orchPath = scriptsDir ? getAbsolutePathFs(combinePath(scriptsDir, "nvidia-installer-ps1-orchestrator.ps1")) : "";
  if (!orchPath || !getFso().FileExists(orchPath)) {
    writeNvcleanAutoLog("NVIDIA_ORCH_SCRIPT_MISSING=oui");
    if (onDone) onDone({ error: "orchestrator_missing" });
    return;
  }
  writeNvcleanAutoLog("NVIDIA_ORCH_SCRIPT_PATH=" + orchPath);
  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + orchPath + '"' +
    ' -LogPath "' + NVCLEAN_AUTO_LOG_PATH + '"' +
    ' -LiveStatusPath "' + NVCLEAN_AUTO_LIVE_PATH + '"';
  writeNvcleanAutoLog("ACTION=nvidia_ps1_orchestrator_launch");
  try {
    var shell = getShell();
    var exec = shell.Exec(cmd);
    var pid = exec ? exec.ProcessID : 0;
    writeNvcleanAutoLog("[NVIDIA Driver] Orchestrateur PS1 dÃ©marrÃ© PID=" + pid);
    logNvidiaDriverRefresh("Orchestrateur PS1 dÃ©marrÃ© PID=" + pid);
  } catch (eLaunch) {
    writeNvcleanAutoLog("NVIDIA_ORCH_LAUNCH_ERROR=" + String(eLaunch.message || eLaunch));
    if (onDone) onDone({ error: "launch_failed" });
    return;
  }
  if (onDone) onDone({ launched: true });
}

function WaitForNvidiaInstallerWindowAndStartOrchestratorAsync() {
  if (nvidiaOrchestratorWatcherStarted) return;
  nvidiaOrchestratorWatcherStarted = true;
  var gen = ++nvidiaOrchestratorWatcherGen;
  var attempts = 0;
  var maxAttempts = 360;

  writeNvcleanAutoLog("[NVIDIA Driver] Attente fenÃªtre Programme d'installation NVIDIA...");
  logNvidiaDriverRefresh("Attente fenÃªtre Programme d'installation NVIDIA...");

  function tick() {
    if (gen !== nvidiaOrchestratorWatcherGen) return;
    attempts++;

    if (probeNvidiaInstallerWindowVisible() && probeNvidiaLicensePageVisible()) {
      writeNvcleanAutoLog("[NVIDIA Driver] FenÃªtre Programme d'installation NVIDIA dÃ©tectÃ©e");
      logNvidiaDriverRefresh("FenÃªtre Programme d'installation NVIDIA dÃ©tectÃ©e");
      startNvidiaPs1OrchestratorIfNeeded();
      return;
    }

    var logTail = readNvcleanAutoLogTail(20);
    if (/NVIDIA_INSTALLER_WINDOW_READY=oui|NVIDIA_INSTALLER_FOUND=oui/i.test(logTail)) {
      if (probeNvidiaLicensePageVisible()) {
        writeNvcleanAutoLog("[NVIDIA Driver] FenÃªtre Programme d'installation NVIDIA dÃ©tectÃ©e");
        logNvidiaDriverRefresh("FenÃªtre Programme d'installation NVIDIA dÃ©tectÃ©e");
        startNvidiaPs1OrchestratorIfNeeded();
        return;
      }
    }

    if (attempts >= maxAttempts) {
      writeNvcleanAutoLog("[NVIDIA Driver] TIMEOUT attente fenÃªtre NVIDIA pour orchestrateur");
      logNvidiaDriverRefresh("TIMEOUT attente fenÃªtre NVIDIA pour orchestrateur");
      return;
    }
    window.setTimeout(tick, 500);
  }

  window.setTimeout(tick, 500);
}

function runNvidiaInstallerWizardTickOnce(onDone) {
  if (nvidiaInstallerTickBusy) {
    if (onDone) onDone({ busy: true, result: "continue" });
    return;
  }
  initNvcleanAutoPaths();
  var scriptsDir = getAppScriptsDir();
  var psPath = scriptsDir ? combinePath(scriptsDir, "nvcleaninstall-auto-uia.ps1") : "";
  if (!psPath || !getFso().FileExists(psPath)) {
    if (onDone) onDone({ error: "uia_missing", result: "continue" });
    return;
  }
  var cmd =
    'powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File "' + psPath + '"' +
    ' -Phase nvidia-installer-tick' +
    ' -LiveStatusPath "' + NVCLEAN_AUTO_LIVE_PATH + '"' +
    ' -LogPath "' + NVCLEAN_AUTO_LOG_PATH + '"';
  nvidiaInstallerTickBusy = true;
  var exitCode = -1;
  try {
    exitCode = getShell().Run(cmd, 0, true);
  } catch (eRun) {
    writeNvcleanAutoLog("NVIDIA_TICK_RUN_ERROR=" + String(eRun.message || eRun));
  }
  nvidiaInstallerTickBusy = false;
  var result = readNvidiaInstallerTickResultFromLog();
  if (onDone) onDone({ result: result, exitCode: exitCode });
}

function RunNvidiaInstallerWizardLoopAsync(skipLaunch) {
  if (isNvidiaInstallerWizardLoopRunning) return;
  isNvidiaInstallerWizardLoopRunning = true;
  nvidiaInstallerLoopStarted = true;
  var gen = ++nvidiaInstallerLoopGen;
  writeNvcleanAutoLog("ACTION=nvidia_installer_loop_start");
  writeNvcleanAutoLog("[NVIDIA Driver] Installation NVIDIA lancÃ©e");
  logNvidiaDriverRefresh("Installation NVIDIA lancÃ©e");
  setNvcleanAutoStatus("Installation NVIDIA en cours...", "info", 90);

  if (!skipLaunch && !nvidiaElevatedHelperLaunchAttempted) {
    launchNvidiaInstallerElevatedHelperAsync(function () {});
  }

  function pollLoop() {
    if (gen !== nvidiaInstallerLoopGen) return;
    if (nvcleanInstallUiCompleted) return;
    logNvcWaitFinishIfNeeded();
    if (tryCompleteNvcleanInstallOnProcessExit()) return;
    var tr = readNvidiaInstallerTickResultFromLog();
    if (tr === "finished") {
      stopNvidiaInstallerWizardLoop();
      writeNvcleanAutoLog("ACTION=nvidia_installer_loop_finished");
      logNvcWaitFinishIfNeeded();
      if (tryCompleteNvcleanInstallOnProcessExit()) return;
      setNvcleanAutoStatus("Installation NVIDIA terminÃ©e â€” fermeture NVCleanInstall en attente...", "info", 95);
      window.setTimeout(function () {
        refreshNvidiaDriverOnceAfterInstallerClosed();
        pollLoop();
      }, 2000);
      return;
    }
    if (tr === "manual" || tr === "timeout") {
      stopNvidiaInstallerWizardLoop();
      setNvcleanAutoStatus("Installation NVIDIA â€” action manuelle requise sur l'installateur.", "warn", 95);
      window.setTimeout(pollLoop, 500);
      return;
    }
    var liveOrch = readNvcleanAutoLiveStatus();
    if (liveOrch && /^NVIDIA\s*:/i.test(liveOrch)) {
      setNvcleanAutoStatus(liveOrch, "info", tr === "installing" || tr === "continue" ? 95 : undefined);
    } else if (tr === "installing" || tr === "continue") {
      setNvcleanAutoStatus("Installation NVIDIA en cours...", "info", 95);
    }
    window.setTimeout(pollLoop, 500);
  }
  pollLoop();
}

function setNvcleanAutoStatus(message, type, progressPct) {
  var el = $("nvcleanAutoStatus");
  if (el) {
    el.style.display = typeof progressPct === "number" ? "none" : (message ? "" : "none");
    if (el.style.display !== "none") {
      el.innerText = message || "";
      el.className = "tool-status" + (type ? " tool-status--" + type : "");
    }
  }
  if (typeof progressPct !== "number") return;
  var kind = "progress";
  if (type === "success") kind = "ok";
  else if (type === "error") kind = "bad";
  setNvMediaAutoStatus(message || "", kind, progressPct);
}

function ensureAutoHotkeyForNvcleanAuto() {
  try {
    var existing = "";
    try {
      existing = findAutoHotkeyExeInstalled();
    } catch (eFind) {
      writeNvcleanAutoLog("[SCRIPT] findAutoHotkey: " + String(eFind.message || eFind));
    }
    if (existing) {
      if (!isAutoHotkeyExecutableV2(existing)) {
        return { ok: false, error: "autohotkey_v1_detected", openPage: true };
      }
      return { ok: true, path: existing };
    }
    var inst = { ok: false, error: "installation_autohotkey_echouee", openPage: true };
    try {
      inst = installAutoHotkeyViaPowerShell();
    } catch (eInst) {
      writeNvcleanAutoLog("[SCRIPT] installAutoHotkey: " + String(eInst.message || eInst));
      inst = { ok: false, error: String(eInst.message || eInst), openPage: true };
    }
    if (inst.ok && inst.path) {
      if (!isAutoHotkeyExecutableV2(inst.path)) {
        return { ok: false, error: "autohotkey_v1_detected", openPage: true };
      }
      return { ok: true, path: inst.path };
    }
    return {
      ok: false,
      error: inst.error || "installation_autohotkey_echouee",
      openPage: inst.openPage !== false
    };
  } catch (eTop) {
    writeNvcleanAutoLog("[SCRIPT] ensureAutoHotkeyForNvcleanAuto: " + String(eTop.message || eTop));
    return { ok: false, error: "autohotkey_access", openPage: true };
  }
}

function ensureNvcleanstallExeForAuto() {
  try {
    try {
      sessionCache.nvcExeLocate = null;
    } catch (eClr) {}
    var nvc = "";
    try {
      nvc = getPreferredNvcleanstallExePath();
    } catch (eGet) {
      writeNvcleanAutoLog("[SCRIPT] getPreferredNvcleanstall: " + String(eGet.message || eGet));
    }
    if (nvc) return { ok: true, path: nvc };
    setNvcleanAutoStatus("NVCleanstall absent, tÃ©lÃ©chargement...", "info");
    try {
      nvc = downloadNvcleanstallBinaryToPreferredPath(appendNvMediaLog);
      if (nvc && getFso().FileExists(nvc)) return { ok: true, path: nvc };
    } catch (eDl) {
      writeNvcleanAutoLog("DOWNLOAD_ERROR=" + String(eDl.message || eDl));
    }
    try {
      nvc = getPreferredNvcleanstallExePath();
    } catch (eGet2) {
      writeNvcleanAutoLog("[SCRIPT] getPreferredNvcleanstall(retry): " + String(eGet2.message || eGet2));
    }
    if (nvc) return { ok: true, path: nvc };
    return { ok: false, error: "nvcleanstall_missing", openPage: true };
  } catch (eTop) {
    writeNvcleanAutoLog("[SCRIPT] ensureNvcleanstallExeForAuto: " + String(eTop.message || eTop));
    return { ok: false, error: "nvcleanstall_access", openPage: true };
  }
}

function beginNvcleanAutoStatusPoll() {
  var gen = ++nvcleanAutoPollGen;
  var attempts = 0;
  var maxAttempts = 240;
  var lastPct = 0;
  var driverWatchStarted = false;
  function poll() {
    if (gen !== nvcleanAutoPollGen) return;
    logNvcWaitFinishIfNeeded();
    if (tryCompleteNvcleanInstallOnProcessExit()) return;
    attempts++;
    var live = readNvcleanAutoLiveStatus();

    if (!nvidiaInstallerLoopStarted && shouldStartNvidiaInstallerWizardLoop(live)) {
      RunNvidiaInstallerWizardLoopAsync();
    }
    if (isNvidiaInstallerWizardLoopRunning) {
      setNvcleanAutoStatus("Installation NVIDIA en cours...", "info", Math.max(lastPct, 90));
      window.setTimeout(poll, 200);
      return;
    }

    if (!driverWatchStarted && shouldStartNvcleanDriverWatch(live)) {
      driverWatchStarted = true;
      waitForNvidiaDriverInstalledAfterManualConfirmation();
      return;
    }

    if (driverWatchStarted) return;

    var mappedLive = nvcleanProgressFromLiveStatus(live);
    var pct = inferNvcleanInstallProgressPct(live, attempts);
    if (pct === -2) pct = lastPct;
    else if (pct > lastPct) lastPct = pct;
    else pct = lastPct;

    if (attempts >= 6 && attempts % 2 === 0 && lastPct >= 75 && !isNvidiaInstallerWizardLoopRunning) {
      var earlyDet = detectInstalledNvidiaDriver({ forceFull: true });
      if (earlyDet.installed) {
        finishNvcleanInstallSuccess(earlyDet);
        return;
      }
    }

    if (live) {
      if (!nvcleanPackageReadyLogged && /\[NVCleanstall\].*Texte d[eÃ©]tect[eÃ©]|your customi[sz]ed installer is now ready/i.test(live)) {
        nvcleanPackageReadyLogged = true;
        try { appendNvMediaLog("[NVCleanstall] Texte dÃ©tectÃ© : Your customized installer is now ready."); } catch (ePkgLog) {}
      }
      if (!nvcleanKeyboardActionLogged && /\[NVCleanstall\].*Action clavier|fleche bas puis entree|flÃ¨che bas puis entrÃ©e/i.test(live)) {
        nvcleanKeyboardActionLogged = true;
        try { appendNvMediaLog("[NVCleanstall] Action clavier envoyÃ©e : flÃ¨che bas puis entrÃ©e."); } catch (eKbLog) {}
      }
      if (mappedLive) {
        setNvcleanAutoStatus(mappedLive.msg, "info", mappedLive.pct);
        lastPct = Math.max(lastPct, mappedLive.pct);
        if (mappedLive.pct >= 95 && !driverWatchStarted) {
          driverWatchStarted = true;
          waitForNvidiaDriverInstalledAfterManualConfirmation();
          return;
        }
      } else if (/Installation terminÃ©e|FenÃªtre fermÃ©e/i.test(live)) {
        setNvcleanAutoStatus("VÃ©rification du pilote installÃ©...", "info", Math.max(pct, 95));
      } else if (/FenÃªtre finale dÃ©tectÃ©e|Clic sur Oui/i.test(live)) {
        setNvcleanAutoStatus(live, "info", pct);
      } else if (/Attente de la fenÃªtre finale/i.test(live)) {
        setNvcleanAutoStatus("Attente de la fenÃªtre finale...", "info", pct);
      } else if (/Reglages NVIDIA :|WAITING_FOR_TWEAKS|Preparation des fichiers NVIDIA|Preparation NVIDIA en cours/i.test(live)) {
        setNvcleanAutoStatus("Finalisation de l'installation...", "info", pct);
      } else if (/Application des reglages|Application :|Reglages NVIDIA appliques|Reglages partiellement|Installation du pilote lancee|Bouton Install|Clique sur Next|Automatisation annulee/i.test(live)) {
        setNvcleanAutoStatus(live, "info", pct);
      } else if (/Preparation des fichiers NVIDIA|copie les fichiers|preparation NVIDIA/i.test(live)) {
        setNvcleanAutoStatus("PrÃ©paration NVCleanInstall...", "info", pct);
      } else if (/Install non lance automatiquement|Impossible de lancer automatiquement Install|Impossible de lancer Install automatiquement/i.test(live)) {
        setNvcleanAutoStatus(live, "error", Math.max(lastPct, 75));
        setNvcleanAutoButtonBusy(false);
        nvcleanAutoBusy = false;
        showNvcleanVerifyInstallButton(true);
        return;
      } else if (/Impossible de lire les options/i.test(live)) {
        setNvcleanAutoStatus(live, "error", lastPct);
      } else if (/bloquÃ©e|bloquee/i.test(live) && live.indexOf("Continue") < 0) {
        setNvcleanAutoStatus(live, "error", lastPct);
      } else if (/Installation lancÃ©e/i.test(live)) {
        setNvcleanAutoStatus("Installation du pilote en cours...", "info", pct);
      } else {
        setNvcleanAutoStatus(live, "info", pct);
      }
    } else if (attempts > 0) {
      setNvcleanAutoStatus("Installation du pilote en cours...", "info", pct);
    }

    if (/prÃ©pare les fichiers NVIDIA/i.test(live) && !nvcleanTweaksBusy) {
      setNvcleanAutoButtonBusy(false);
    }
    if (/bloquÃ©e|bloquee/i.test(live) && live.indexOf("Continue") < 0 && attempts > 6) {
      setNvcleanAutoStatus("Automatisation NVCleanstall bloquÃ©e. Continue manuellement Ã  partir de cette fenÃªtre.", "error", lastPct);
      setNvcleanAutoButtonBusy(false);
      nvcleanAutoBusy = false;
      showNvcleanVerifyInstallButton(true);
      return;
    }
    if (attempts >= maxAttempts) {
      var lateDet = detectInstalledNvidiaDriver({ forceFull: true });
      if (lateDet.installed) {
        finishNvcleanInstallSuccess(lateDet);
      } else {
        setNvcleanAutoStatus(
          "Installation non confirmÃ©e automatiquement â€” cliquez sur VÃ©rifier l'installation si le pilote est installÃ©.",
          "info",
          lastPct
        );
        showNvcleanVerifyInstallButton(true);
        setNvcleanAutoButtonBusy(false);
        nvcleanAutoBusy = false;
      }
      return;
    }
    window.setTimeout(poll, 800);
  }
  window.setTimeout(poll, 800);
}

function setNvcleanAutoButtonBusy(busy) {
  var btn = $("btnNvcleaninstallAuto");
  if (btn) btn.disabled = !!busy;
}

function setNvcleanContinueButtonBusy(busy) {
  var btn = $("btnContinueNvidiaTweaks");
  if (btn) btn.disabled = !!busy;
}

function bindContinueNvidiaTweaksButton() {
  var btn = document.getElementById("btnContinueNvidiaTweaks");
  if (!btn) return;
  btn.onclick = continueNvidiaTweaks;
}

function showNvcleanContinuePrompt(show) {
  var panel = $("nvcleanContinuePanel");
  var btn = $("btnContinueNvidiaTweaks");
  nvcleanContinuePromptVisible = !!show;
  if (panel) panel.style.display = show ? "" : "none";
  if (btn) {
    btn.disabled = false;
    bindContinueNvidiaTweaksButton();
  }
  if (show) {
    writeNvcleanAutoLog("PHASE=1");
    writeNvcleanAutoLog("INSTALLATION_TWEAKS_DETECTED=oui");
    writeNvcleanAutoLog("CONTINUE_BUTTON_SHOWN=oui");
    setNvcleanAutoStatus("Page des rÃ©glages NVIDIA dÃ©tectÃ©e. Cliquez sur Continuer les rÃ©glages NVIDIA.", "info");
  }
}

function getNvcTweaksOnlyScriptPath() {
  var fso = getFso();
  var candidates = [];
  var scriptsDir = getAppScriptsDir();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (scriptsDir) candidates.push(combinePath(scriptsDir, "nvcleaninstall-tweaks-only.ahk"));
  if (app) {
    candidates.push(combinePath(app, "Scripts\\nvcleaninstall-tweaks-only.ahk"));
    candidates.push(combinePath(app, "scripts\\nvcleaninstall-tweaks-only.ahk"));
  }
  var i;
  for (i = 0; i < candidates.length; i++) {
    if (candidates[i] && fso.FileExists(candidates[i])) return candidates[i];
  }
  return "";
}

function cancelNvcleanContinuePrompt() {
  showNvcleanContinuePrompt(false);
  setNvcleanAutoStatus("Reprise automatique annulÃ©e. Tu peux continuer manuellement dans NVCleanstall.", "info");
  writeNvcleanAutoLog("TWEAKS_CONTINUE_CANCELLED=oui");
}

function isAutoHotkeyExecutableV2(exePath) {
  if (!exePath || !getFso().FileExists(exePath)) return false;
  var base = String(exePath).toLowerCase();
  if (base.indexOf("autohotkey_v1") >= 0 || /\\v1\\/.test(base)) return false;
  if (/\\autohotkey\.exe$/.test(base) && base.indexOf("v2") < 0 && base.indexOf("64") < 0 && base.indexOf("u64") < 0) {
    return false;
  }
  return true;
}

function validateNvcleanAutoAhkScript(scriptPath) {
  var forbidden = [
    { word: "ControlGetCaption", re: /ControlGetCaption/i },
    { word: "catch name", re: /\bcatch\s+name\b/i },
    { word: "handleFinalExitPopup", re: /handleFinalExitPopup/i },
    { word: "FINAL_EXIT_POPUP", re: /FINAL_EXIT_POPUP/i },
    { word: "FINAL_YES", re: /\bFINAL_YES\b/i },
    { word: "final-exit-popup", re: /final-exit-popup/i },
    { word: "#Include final-exit", re: /#Include\s+final-exit/i }
  ];
  var v1CommandLines = [
    { word: "SetTitleMatchMode_v1", re: /^\s*SetTitleMatchMode\s*,/m },
    { word: "WinWait_v1", re: /^\s*WinWait\s*,/m },
    { word: "WinActivate_v1", re: /^\s*WinActivate\s*,/m },
    { word: "WinWaitActive_v1", re: /^\s*WinWaitActive\s*,/m },
    { word: "Send_v1", re: /^\s*Send\s*,/m },
    { word: "SendInput_v1", re: /^\s*SendInput\s*,/m },
    { word: "ControlSend_v1", re: /^\s*ControlSend\s*,/m },
    { word: "ControlClick_v1", re: /^\s*ControlClick\s*,/m },
    { word: "IfWinExist", re: /^\s*IfWinExist\b/m },
    { word: "var_v1", re: /^\s*var\s+[A-Za-z_]+\s*:=/m }
  ];
  var fso = getFso();
  if (!scriptPath || !fso.FileExists(scriptPath)) {
    return { ok: false, word: "file_missing", detail: "" };
  }
  var content = readTextFileAll(scriptPath);
  if (!content) {
    return { ok: false, word: "empty", detail: "" };
  }
  if (!/#Requires\s+AutoHotkey\s+v2/i.test(content)) {
    return { ok: false, word: "missing_v2_requires", detail: "#Requires AutoHotkey v2.0" };
  }
  if (/#Requires\s+AutoHotkey\s+v1/i.test(content)) {
    return { ok: false, word: "ahk_v1_requires", detail: "" };
  }
  var i;
  for (i = 0; i < forbidden.length; i++) {
    if (forbidden[i].re.test(content)) {
      return { ok: false, word: forbidden[i].word, detail: "" };
    }
  }
  for (i = 0; i < v1CommandLines.length; i++) {
    if (v1CommandLines[i].re.test(content)) {
      return { ok: false, word: v1CommandLines[i].word, detail: "" };
    }
  }
  var tweaksPath = combinePath(fso.GetParentFolderName(scriptPath), "nvcleaninstall-tweaks-page.ahk");
  if (fso.FileExists(tweaksPath)) {
    var tweaksContent = readTextFileAll(tweaksPath);
    if (tweaksContent && /#Include/i.test(content) && /nvcleaninstall-tweaks-page/i.test(content)) {
      for (i = 0; i < forbidden.length; i++) {
        if (forbidden[i].re.test(tweaksContent)) {
          return { ok: false, word: forbidden[i].word, detail: "tweaks-page" };
        }
      }
    }
  }
  return { ok: true, word: "", detail: "" };
}

function launchNvcleaninstallAutoRunImpl() {
  try {
    initNvcleanAutoPaths();
  } catch (eInit) {
    writeNvcleanAutoLog("[SCRIPT] initNvcleanAutoPaths: " + String(eInit.message || eInit));
  }
  try {
    clearNvcleanAutoLiveFile();
  } catch (eClr) {
    writeNvcleanAutoLog("[SCRIPT] clearNvcleanAutoLiveFile: " + String(eClr.message || eClr));
  }
  nvcleanPackageReadyLogged = false;
  nvcleanKeyboardActionLogged = false;
  nvidiaInstallerLoopStarted = false;
  nvidiaElevatedHelperLaunchAttempted = false;
  nvidiaOrchestratorWatcherStarted = false;
  nvidiaOrchestratorWatcherGen++;
  nvcInstallProcessSeen = false;
  nvcleanInstallUiCompleted = false;
  nvcWaitFinishLogged = false;
  stopNvidiaInstallerWizardLoop();
  writeNvcleanAutoLog("DATE=" + new Date().toISOString());
  writeNvcleanAutoLog("ACTION=nvcleaninstall_auto_start");
  driversWorkflowState.installError = false;
  sessionCache.gpuDriverUpdate = null;
  setNvcleanAutoStatus("Installation du pilote en cours...", "info", 0);

  var gpu = detectGpuForDriverInstall({ skipLog: true });
  if (!gpu.hasNvidia && !gpu.installAllowed) {
    gpu = detectGpuForDriverInstall({});
  }
  if (!gpu.hasNvidia) {
    writeNvcleanAutoLog("INSTALL_ALLOWED=non");
    writeNvcleanAutoLog("ERROR=nvidia_gpu_not_detected");
    setNvcleanAutoStatus("GPU NVIDIA non dÃ©tectÃ©. Nettoyage DDU ou choix manuel requis.", "error", 10);
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }
  setNvcleanAutoStatus("Recherche du pilote...", "info", 10);

  var nvc = ensureNvcleanstallExeForAuto();
  if (!nvc.ok || !nvc.path) {
    writeNvcleanAutoLog("NVCLEANSTALL_PATH=");
    writeNvcleanAutoLog("ERROR=" + (nvc.error || "nvc_missing"));
    if (nvc.openPage) {
      setNvcleanAutoStatus("NVCleanstall introuvable. Ouverture de la page officielle...", "info");
      openNvcleanstallOfficialDownloadPage();
      setNvcleanAutoStatus("TÃ©lÃ©charge NVCleanstall, puis relance l'installation auto.", "error");
    } else {
      setNvcleanAutoStatus("NVCleanstall introuvable.", "error");
    }
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }
  setNvcleanAutoStatus("TÃ©lÃ©chargement / prÃ©paration...", "info", 25);

  writeNvcleanAutoLog("NVCLEANSTALL_PATH=" + nvc.path);

  var ahk = ensureAutoHotkeyForNvcleanAuto();
  if (!ahk.ok || !ahk.path) {
    writeNvcleanAutoLog("ERROR=" + (ahk.error || "autohotkey_missing"));
    if (ahk.error === "autohotkey_v1_detected") {
      setNvcleanAutoStatus("AutoHotkey v2 requis â€” version 1 dÃ©tectÃ©e.", "error", 25);
    } else if (ahk.openPage) {
      setNvcleanAutoStatus("AutoHotkey v2 requis â€” tÃ©lÃ©chargement en cours...", "info", 25);
    } else {
      setNvcleanAutoStatus("AutoHotkey v2 introuvable.", "error", 25);
    }
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }

  var scriptsDir = getAppScriptsDir();
  var ahkScript = scriptsDir ? combinePath(scriptsDir, "nvcleaninstall-auto.ahk") : "";
  if (!ahkScript || !getFso().FileExists(ahkScript)) {
    writeNvcleanAutoLog("ERROR=ahk_script_missing");
    writeNvcleanAutoLog("SCRIPT_SYNTAX_CHECK=erreur");
    writeNvcleanAutoLog("STARTED=non");
    setNvcleanAutoStatus("Script nvcleaninstall-auto.ahk introuvable.", "error");
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }

  var syntaxCheck = validateNvcleanAutoAhkScript(ahkScript);
  writeNvcleanAutoLog("AHK_VERSION_MODE=v2");
  writeNvcleanAutoLog("SCRIPT_PATH=" + ahkScript);
  writeNvcleanAutoLog("SYNTAX_CHECK=" + (syntaxCheck.ok ? "ok" : "error"));
  if (!syntaxCheck.ok) {
    writeNvcleanAutoLog("ERROR_MESSAGE=" + syntaxCheck.word);
    writeNvcleanAutoLog("FORBIDDEN_WORD_FOUND=" + syntaxCheck.word);
    writeNvcleanAutoLog("STARTED=non");
    writeNvcleanAutoLog("ERROR=forbidden_ahk_syntax");
    if (syntaxCheck.word === "missing_v2_requires") {
      setNvcleanAutoStatus("Script NVCleanstall invalide : #Requires AutoHotkey v2.0 manquant.", "error", 25);
    } else if (/^WinWait_v1|Send_v1|ControlSend_v1|SetTitleMatchMode_v1/i.test(syntaxCheck.word)) {
      setNvcleanAutoStatus("Script NVCleanstall invalide : syntaxe AutoHotkey v1 detectee.", "error", 25);
    } else {
      setNvcleanAutoStatus("Script NVCleanstall invalide : " + syntaxCheck.word + ".", "error", 25);
    }
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }

  setNvcleanAutoStatus("Script NVCleanstall AutoHotkey v2 prÃªt", "info", 25);
  try {
    writeNvcleanAutoLiveStatus("[NVCleanInstall] AutoHotkey v2 script genere");
  } catch (eLiveGen) {}

  writeNvcleanAutoLog("AHK_PATH=" + ahk.path);
  writeNvcleanAutoLog("AHK_SCRIPT=" + ahkScript);

  setNvcleanAutoStatus("Ouverture de NVCleanstall...", "info", 45);
  var launchRes = launchNvcleanstallExeElevated(nvc.path, function (m) { writeNvcleanAutoLog(String(m)); });
  if (launchRes !== "ok") {
    writeNvcleanAutoLog("ERROR=nvc_launch_" + launchRes);
    if (launchRes === "uac_cancel") {
      setNvcleanAutoStatus("Ouverture annulÃ©e (UAC).", "error");
    } else {
      setNvcleanAutoStatus("Erreur ouverture NVCleanstall.", "error");
    }
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }
  nvcInstallProcessSeen = isNvcleanstallProcessRunning();

  var appRoot = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  window.setTimeout(function () {
    setNvcleanAutoStatus("Installation en cours...", "info", 65);
    var args = "\"" + ahkScript + "\" \"" + appRoot + "\"";
    try {
      launchFileAsAdminWithArgs(ahk.path, args);
      writeNvcleanAutoLog("SCRIPT_LAUNCHED=oui");
      writeNvcleanAutoLog("[NVIDIA Driver] NVCleanInstall lancÃ©");
      logNvidiaDriverRefresh("NVCleanInstall lancÃ©");
      writeNvcleanAutoLog("PHASE=1_DRIVER_AND_COMPONENTS");
      beginNvcleanAutoStatusPoll();
      WaitForNvidiaInstallerWindowAndStartOrchestratorAsync();
    } catch (eAhk) {
      writeNvcleanAutoLog("SCRIPT_LAUNCHED=non");
      writeNvcleanAutoLog("ERROR=" + String(eAhk.message || eAhk));
      setNvcleanAutoStatus("Automatisation NVCleanstall bloquÃ©e. Continue manuellement.", "error");
      setNvcleanAutoButtonBusy(false);
      nvcleanAutoBusy = false;
    }
  }, 500);
}

function continueNvidiaTweaks() {
  setNvcleanAutoStatus("Automatisation NVIDIA temporairement desactivee.", "info");
}

function launchNvcleaninstallTweaksOnly() {
  continueNvidiaTweaks();
}

function launchNvcleaninstallAutoExperimental() {
  if (nvcleanAutoBusy || nvcleanTweaksBusy) return;
  nvcleanAutoPollGen++;
  stopNvcleanDriverWatchPoll();
  showNvcleanVerifyInstallButton(false);
  nvcleanAutoBusy = true;
  setNvcleanAutoButtonBusy(true);
  driversWorkflowState.installDone = false;
  driversWorkflowState.installError = false;
  sessionCache.gpuDriverUpdate = null;
  setNvcleanAutoStatus("Installation du pilote en cours...", "info", 0);
  window.setTimeout(function () {
    try {
      launchNvcleaninstallAutoRunImpl();
    } catch (eRun) {
      writeNvcleanAutoLog("ERROR=" + String(eRun.message || eRun));
      setNvcleanAutoStatus("Erreur : " + String(eRun.message || eRun), "error");
      setNvcleanAutoButtonBusy(false);
      nvcleanAutoBusy = false;
    }
  }, 10);
}

var NVIDIA_PERFORMANCE_PROFILE_FILE = "NvidiaPerformanceProfile.nip";
var NVIDIA_FPS_LATENCY_PROFILE_FILE = "Unreal_NVIDIA_FPS_Latence_Global.nip";
var NVIDIA_DEFAULT_RESET_PROFILE_FILE = "NVIDIA_Default_Reset.nip";
var NVIDIA_BACKUP_BEFORE_UNREAL_FILE = "Backup_Before_Unreal_Profile.nip";
var NVIDIA_PROFILE_INSPECTOR_EXE_NAME = "nvidiaProfileInspector.exe";
var NVIDIA_PROFILE_INSPECTOR_BUNDLE_ZIPS = [
  "nvidiaProfileInspector.zip",
  "ProfileInspector.zip"
];
/** RÃ©glages 3D du profil Unreal  â€” utilisÃ©s pour confirmer qu'un reset a rÃ©ellement changÃ© l'Ã©tat. */
var NVIDIA_RESET_WATCH_IDS = ["274197361", "277041152", "11041231"];
var NVIDIA_NIP_MIN_BYTES = 1024;
var NVIDIA_FULL_WARZONE_NIP_FILE = "Unreal_Warzone_Performance.nip";
var NVIDIA_FULL_IMPORT_TIMEOUT_MS = 60000;

function logNvidiaPanelDev(message) {
  var line = "[NVIDIA Panel] " + String(message || "");
  try { log(line); } catch (eL) {}
  try { appendFileLogLine(line); } catch (eF) {}
}

function getNvidiaToolsDir() {
  var app = getAppFolderFromHta();
  if (app) return app + "\\tools\\NVIDIA";
  var loc = getLocalUnrealDir();
  if (loc) return loc + "\\Tools\\NVIDIA";
  return "";
}

function getNvidiaProfileInspectorDir() {
  var base = getNvidiaToolsDir();
  if (!base) return "";
  return base + "\\ProfileInspector";
}

function getNvidiaPanelToolsDir() {
  return getNvidiaProfileInspectorDir();
}

function getNvidiaProfilesDir() {
  var base = getNvidiaToolsDir();
  if (!base) return "";
  return base + "\\Profiles";
}

function getNvidiaBackupDir() {
  var base = getNvidiaToolsDir();
  if (!base) return "";
  return base + "\\Backups";
}

function getNvidiaFpsLatencyProfilePath() {
  var dir = getNvidiaProfilesDir();
  if (!dir) return "";
  return getAbsolutePathFs(dir + "\\" + NVIDIA_FPS_LATENCY_PROFILE_FILE);
}

function getNvidiaDefaultResetProfilePath() {
  var dir = getNvidiaProfilesDir();
  if (!dir) return "";
  return getAbsolutePathFs(dir + "\\" + NVIDIA_DEFAULT_RESET_PROFILE_FILE);
}

function getNvidiaBackupBeforeUnrealPath() {
  var dir = getNvidiaBackupDir();
  if (!dir) return "";
  return getAbsolutePathFs(dir + "\\" + NVIDIA_BACKUP_BEFORE_UNREAL_FILE);
}

function resolveNvidiaResetProfilePath() {
  var base = getNvidiaToolsDir();
  var backup = getNvidiaBackupBeforeUnrealPath();
  if (backup && !fileExists(backup) && base) {
    backup = findNvidiaFileRecursive(base, NVIDIA_BACKUP_BEFORE_UNREAL_FILE, 0) || backup;
  }
  if (backup && fileExists(backup)) return { path: backup, source: "backup" };
  var def = getNvidiaDefaultResetProfilePath();
  if (def && !fileExists(def) && base) {
    def = findNvidiaFileRecursive(base, NVIDIA_DEFAULT_RESET_PROFILE_FILE, 0) || def;
  }
  if (def && fileExists(def)) return { path: def, source: "default" };
  return { path: "", source: "" };
}

function sleepMs(ms) {
  var n = parseInt(ms, 10);
  if (isNaN(n) || n < 0) n = 0;
  var end = new Date().getTime() + n;
  while (new Date().getTime() < end) {}
}

function countNvidiaNipProfileSettings(filePath) {
  var txt = readTextFileAll(filePath);
  var c = 0;
  if (txt) {
    var re = /<ProfileSetting>/gi;
    var m;
    while ((m = re.exec(txt)) !== null) c++;
    if (c > 0) return c;
    re = /ProfileSetting/gi;
    while ((m = re.exec(txt)) !== null) c++;
    if (c > 0) return c;
  }
  try {
    var out = runCommandCapture("findstr /C:\"<ProfileSetting>\" \"" + String(filePath).replace(/"/g, "") + "\"");
    if (out) {
      var lines = String(out).split(/\r?\n/);
      var i;
      for (i = 0; i < lines.length; i++) {
        if (lines[i] && lines[i].indexOf("ProfileSetting") >= 0) c++;
      }
    }
  } catch (eF) {}
  return c;
}

function parseNvidiaNipSettingMap(filePath) {
  var map = {};
  var txt = readTextFileAll(filePath);
  if (!txt) return map;
  var re = /<SettingID>(\d+)<\/SettingID>[\s\S]*?<SettingValue>([^<]*)<\/SettingValue>/gi;
  var m;
  while ((m = re.exec(txt)) !== null) {
    map[m[1]] = String(m[2]);
  }
  return map;
}

function validateNvidiaNipFile(filePath) {
  var info = { valid: false, size: 0, modified: "", settingCount: 0, reason: "" };
  try {
    var fso = getFso();
    if (!filePath || !fso.FileExists(filePath)) {
      info.reason = "fichier absent";
      return info;
    }
    var f = fso.GetFile(filePath);
    info.size = f.Size;
    try {
      info.modified = new Date(f.DateLastModified).toLocaleString();
    } catch (eDt) {
      info.modified = String(f.DateLastModified || "");
    }
    info.settingCount = countNvidiaNipProfileSettings(filePath);
    var txt = readTextFileAll(filePath);
    if (info.size < NVIDIA_NIP_MIN_BYTES) {
      info.reason = "taille < " + NVIDIA_NIP_MIN_BYTES + " octets";
      return info;
    }
    if (!txt || txt.indexOf("<ArrayOfProfile") < 0) {
      info.reason = "format .nip invalide";
      return info;
    }
    if (info.settingCount < 1) {
      info.reason = "aucun rÃ©glage NVIDIA (ProfileSetting vide)";
      return info;
    }
    info.valid = true;
    return info;
  } catch (eV) {
    info.reason = String(eV.message || eV);
    return info;
  }
}

function logNvidiaNipFileInfo(label, filePath) {
  var v = validateNvidiaNipFile(filePath);
  logNvidiaPanelDev(label + " : " + (filePath || "(vide)") + " | taille=" + v.size + " | rÃ©glages=" + v.settingCount + " | modif=" + (v.modified || "?") + " | valide=" + (v.valid ? "oui" : "non (" + v.reason + ")"));
  return v;
}

function resolveNvidiaResetProfileForApply() {
  var base = getNvidiaToolsDir();
  var backup = getNvidiaBackupBeforeUnrealPath();
  if (base && (!backup || !fileExists(backup))) {
    backup = findNvidiaFileRecursive(base, NVIDIA_BACKUP_BEFORE_UNREAL_FILE, 0) || backup;
  }
  if (backup && fileExists(backup)) {
    var vb = validateNvidiaNipFile(backup);
    if (vb.valid) return { path: backup, source: "backup", validation: vb };
    logNvidiaPanelDev("Backup prÃ©sent mais invalide : " + vb.reason);
  }
  var def = getNvidiaDefaultResetProfilePath();
  if (base && (!def || !fileExists(def))) {
    def = findNvidiaFileRecursive(base, NVIDIA_DEFAULT_RESET_PROFILE_FILE, 0) || def;
  }
  if (def && fileExists(def)) {
    var vd = validateNvidiaNipFile(def);
    if (vd.valid) return { path: def, source: "default", validation: vd };
    return { path: def, source: "default", validation: vd, invalid: true };
  }
  return { path: "", source: "", validation: null };
}

function getExpectedNvidiaProfileInspectorExePath() {
  var dir = getNvidiaProfileInspectorDir();
  if (!dir) return "";
  return getAbsolutePathFs(dir + "\\" + NVIDIA_PROFILE_INSPECTOR_EXE_NAME);
}

function isNvidiaProfileInspectorExeName(fileName) {
  var n = String(fileName || "");
  if (!/\.exe$/i.test(n)) return false;
  if (/^nvidiaProfileInspector\.exe$/i.test(n)) return true;
  if (/^NvidiaProfileInspector\.exe$/i.test(n)) return true;
  if (/^nvidiaProfileInspectorDmW\.exe$/i.test(n)) return true;
  if (/ProfileInspector/i.test(n)) return true;
  if (/nvidiaProfile/i.test(n)) return true;
  return false;
}

function findNvidiaProfileInspectorExe(dir, depth) {
  var fso = getFso();
  if (!dir || !fso.FolderExists(dir)) return "";
  if (typeof depth !== "number") depth = 0;
  if (depth > 4) return "";
  var expected = dir + "\\" + NVIDIA_PROFILE_INSPECTOR_EXE_NAME;
  if (fso.FileExists(expected)) return getAbsolutePathFs(expected);
  try {
    var folder = fso.GetFolder(dir);
    var ef = new Enumerator(folder.Files);
    for (; !ef.atEnd(); ef.moveNext()) {
      var file = ef.item();
      var n = String(file.Name || "");
      if (isNvidiaProfileInspectorExeName(n)) {
        return getAbsolutePathFs(String(file.Path || ""));
      }
    }
    if (depth < 4) {
      var es = new Enumerator(folder.SubFolders);
      for (; !es.atEnd(); es.moveNext()) {
        var sub = es.item();
        var found = findNvidiaProfileInspectorExe(String(sub.Path || ""), depth + 1);
        if (found) return found;
      }
    }
  } catch (e) {}
  return "";
}

function getNvidiaProfileInspectorSearchRoots() {
  var roots = [], seen = {}, app, sh, i;
  function add(p) {
    if (!p) return;
    var a = getAbsolutePathFs(p);
    if (!a || seen[a]) return;
    seen[a] = true;
    roots.push(a);
  }
  add(getExpectedNvidiaProfileInspectorExePath());
  add(getNvidiaProfileInspectorDir());
  add(getNvidiaToolsDir());
  app = getAppFolderFromHta();
  if (app) {
    add(app);
    add(app + "\\tools");
    add(app + "\\Tools");
    add(app + "\\tools\\NvidiaProfileInspector");
    add(app + "\\tools\\NVIDIAProfileInspector");
    add(app + "\\Tools\\NVIDIA\\ProfileInspector");
    add(app + "\\config");
  }
  try {
    sh = getShell();
    add(sh.SpecialFolders("Desktop"));
    add(sh.ExpandEnvironmentStrings("%USERPROFILE%\\Desktop"));
    add(sh.ExpandEnvironmentStrings("%USERPROFILE%\\Downloads"));
  } catch (eSh) {}
  return roots;
}

function resolveNvidiaProfileInspectorExe() {
  var roots = getNvidiaProfileInspectorSearchRoots();
  var i;
  for (i = 0; i < roots.length; i++) {
    var r = roots[i];
    if (/\.exe$/i.test(r) && fileExists(r) && isNvidiaProfileInspectorExeName(r.split("\\").pop())) {
      return getAbsolutePathFs(r);
    }
    var found = findNvidiaProfileInspectorExe(r, 0);
    if (found) return found;
  }
  return "";
}

function findNvidiaFileRecursive(rootDir, fileName, depth) {
  var fso = getFso();
  if (!rootDir || !fileName || !fso.FolderExists(rootDir)) return "";
  if (typeof depth !== "number") depth = 0;
  if (depth > 6) return "";
  var direct = getAbsolutePathFs(rootDir + "\\" + fileName);
  if (fso.FileExists(direct)) return direct;
  try {
    var folder = fso.GetFolder(rootDir);
    var es = new Enumerator(folder.SubFolders);
    for (; !es.atEnd(); es.moveNext()) {
      var sub = es.item();
      var hit = findNvidiaFileRecursive(String(sub.Path || ""), fileName, depth + 1);
      if (hit) return hit;
    }
  } catch (eR) {}
  return "";
}

function resolveNvidiaPerformanceProfilePath() {
  var fso = getFso();
  var candidates = [], i, app = getAppFolderFromHta();
  if (app) {
    candidates.push(app + "\\config\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
    candidates.push(app + "\\PurpleBoost\\config\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
    candidates.push(app + "\\tools\\NvidiaProfileInspector\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
    candidates.push(app + "\\tools\\NVIDIAProfileInspector\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
    candidates.push(app + "\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
  }
  var piDir = getNvidiaProfileInspectorDir();
  if (piDir) candidates.push(piDir + "\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
  var profilesDir = getNvidiaProfilesDir();
  if (profilesDir) candidates.push(profilesDir + "\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
  for (i = 0; i < candidates.length; i++) {
    if (candidates[i] && fso.FileExists(candidates[i])) {
      return getAbsolutePathFs(candidates[i]);
    }
  }
  var base = getNvidiaToolsDir();
  if (base) {
    var found = findNvidiaFileRecursive(base, NVIDIA_PERFORMANCE_PROFILE_FILE, 0);
    if (found) return found;
  }
  var legacy = getNvidiaFpsLatencyProfilePath();
  if (legacy && fileExists(legacy)) return legacy;
  if (base) {
    found = findNvidiaFileRecursive(base, NVIDIA_FPS_LATENCY_PROFILE_FILE, 0);
    if (found) return found;
  }
  return "";
}

function resolveNvidiaFpsLatencyProfilePath() {
  return resolveNvidiaPerformanceProfilePath();
}

function extractZipArchiveToFolder(archivePath, destDir) {
  var escA = archivePath.replace(/'/g, "''");
  var escD = destDir.replace(/'/g, "''");
  if (/\.zip$/i.test(archivePath)) {
    getShell().Run(
      "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Expand-Archive -LiteralPath '" + escA + "' -DestinationPath '" + escD + "' -Force\"",
      0,
      true
    );
    return;
  }
  if (/\.7z$/i.test(archivePath)) {
    getShell().Run(
      "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"tar -xf '" + escA + "' -C '" + escD + "'\"",
      0,
      true
    );
  }
}

function extractNvidiaProfileInspectorBundleZip(zipPath, destDir) {
  if (!zipPath || !destDir) return false;
  var fso = getFso();
  if (!fso.FileExists(zipPath)) return false;
  try {
    extractZipArchiveToFolder(zipPath, destDir);
    logNvidiaPanelDev("Archive embarquÃ©e extraite : " + zipPath);
    return true;
  } catch (eEx) {
    logNvidiaPanelDev("Ã©chec extraction archive : " + zipPath + " - " + String(eEx.message || eEx));
    return false;
  }
}

/** DÃ©ploie nvidiaProfileInspector.exe depuis le zip embarquÃ© (aucune action utilisateur). */
function ensureBundledNvidiaProfileInspector() {
  var existing = resolveNvidiaProfileInspectorExe();
  if (existing) return existing;

  var dir = getNvidiaProfileInspectorDir();
  if (!dir || !createFolder(dir)) return "";

  var fso = getFso();
  var i, zipPath, base = getNvidiaToolsDir();
  for (i = 0; i < NVIDIA_PROFILE_INSPECTOR_BUNDLE_ZIPS.length; i++) {
    zipPath = dir + "\\" + NVIDIA_PROFILE_INSPECTOR_BUNDLE_ZIPS[i];
    if (fso.FileExists(zipPath)) extractNvidiaProfileInspectorBundleZip(zipPath, dir);
  }
  if (base && base !== dir) {
    for (i = 0; i < NVIDIA_PROFILE_INSPECTOR_BUNDLE_ZIPS.length; i++) {
      zipPath = base + "\\" + NVIDIA_PROFILE_INSPECTOR_BUNDLE_ZIPS[i];
      if (fso.FileExists(zipPath)) extractNvidiaProfileInspectorBundleZip(zipPath, dir);
    }
  }

  existing = resolveNvidiaProfileInspectorExe();
  if (existing) return existing;

  var legacy = getAppFolderFromHta();
  if (legacy) {
    legacy = legacy + "\\tools\\NVIDIAProfileInspector";
    var legacyExe = findNvidiaProfileInspectorExe(legacy, 0);
    if (legacyExe && fso.FileExists(legacyExe)) {
      try {
        var destExe = getExpectedNvidiaProfileInspectorExePath();
        if (destExe) {
          fso.CopyFile(legacyExe, destExe, true);
          logNvidiaPanelDev("Migration outil interne depuis ancien dossier : " + legacyExe);
          return resolveNvidiaProfileInspectorExe();
        }
      } catch (eCp) {
        logNvidiaPanelDev("Ã©chec migration outil interne : " + String(eCp.message || eCp));
      }
    }
  }
  return "";
}

function mapNvidiaCliExitCode(code, context) {
  var c = parseInt(code, 10);
  if (isNaN(c)) c = -1;
  var ctx = String(context || "import");
  if (c === 0) {
    if (ctx === "reset") return { ok: false, status: "", detail: "code 0  â€” vÃ©rification post-reset requise" };
    if (ctx === "export") return { ok: true, status: "", detail: "export silencieux rÃ©ussi" };
    return { ok: true, status: "Profil 3D NVIDIA appliquÃ©.", detail: "import silencieux rÃ©ussi" };
  }
  if (c === 16) {
    return { ok: false, status: "Erreur : outil NVIDIA interne manquant", detail: "nvidiaProfileInspector.exe absent" };
  }
  if (c === 17) {
    if (ctx === "reset") return { ok: false, status: "Erreur : aucun profil de reset NVIDIA disponible. RÃ©installez Purple Boost.", detail: "fichier .nip reset/backup absent" };
    return { ok: false, status: "Erreur : profil NVIDIA FPS / Latence manquant", detail: "fichier .nip profil Unreal absent" };
  }
  if (c === 18 || c === 1223 || c === 5) {
    return { ok: false, status: "Erreur : droits administrateur requis", detail: "Ã©lÃ©vation refusÃ©e (code " + c + ")" };
  }
  if (ctx === "reset") return { ok: false, status: "Erreur : reset NVIDIA impossible", detail: "code de sortie " + c };
  return { ok: false, status: "Erreur : application du profil NVIDIA impossible", detail: "code de sortie " + c };
}

function mapNvidiaImportExitCode(code) {
  return mapNvidiaCliExitCode(code, "import");
}

function mapNvidiaResetExitCode(code) {
  return mapNvidiaCliExitCode(code, "reset");
}

function mapNvidiaImportProcessResult(res) {
  if (!res) return { ok: false, status: "Erreur : application du profil NVIDIA impossible", detail: "rÃ©sultat processus vide" };
  var code = parseInt(res.exitCode, 10);
  if (isNaN(code)) code = -1;
  return mapNvidiaImportExitCode(code);
}

function setNvidiaPanelStatus(text, kind) {
  var el = $("nvidiaGamingStatus") || $("nvidiaPanelStatus");
  if (!el) return;
  var cls = "tcp-badge";
  if (kind === "ok") cls += " tcp-badge--ok";
  else if (kind === "progress") cls += " tcp-badge--progress";
  else if (kind === "warn") cls += " tcp-badge--progress";
  else cls += " tcp-badge--bad";
  el.className = cls;
  el.style.whiteSpace = "pre-line";
  el.innerText = text || "PrÃªt";
}

function openNvidiaProfileInspectorWithNip(inspectorExe, profilePath) {
  if (!inspectorExe || !profilePath || !fileExists(inspectorExe) || !fileExists(profilePath)) return false;
  try {
    getShell().Run('"' + inspectorExe + '" "' + profilePath + '"', 1, false);
    return true;
  } catch (eOpen) {
    logNvidiaPanelDev("Ouverture NPI + .nip : " + String(eOpen.message || eOpen));
    return false;
  }
}

function getNvidiaProfileLogPath() {
  var app = getAppFolderFromHta();
  var path = app ? getAbsolutePathFs(app + "\\logs\\nvidia-profile.log") : (UNREAL_LOGS + "\\nvidia-profile.log");
  try {
    var fso = getFso();
    var dir = fso.GetParentFolderName(path);
    if (dir && !fso.FolderExists(dir)) fso.CreateFolder(dir);
  } catch (eMk) {}
  return path;
}

function appendNvidiaProfileLogLine(line) {
  var path = getNvidiaProfileLogPath();
  try {
    var fso = getFso();
    var stream = fso.OpenTextFile(path, 8, true);
    stream.WriteLine(String(line || ""));
    stream.Close();
  } catch (eW) {
    try { appendFileLogLine("[nvidia-profile] " + line); } catch (e2) {}
  }
}

/**
 * Import silencieux .nip (arriÃ¨re-plan) â€” appelÃ© uniquement par ApplyNipProfile.
 * nvidiaProfileInspector.exe -silent -silentImport â€” fenÃªtre masquÃ©e, jamais affichÃ©e.
 */
function importNvidiaProfileNipElevated(inspectorExe, profilePath) {
  var nip = getAbsolutePathFs(profilePath || "");
  if (!nip || !fileExists(nip)) return { exitCode: 17, durationMs: 0, cmdLine: "", error: "nip absent" };
  if (!inspectorExe || !fileExists(inspectorExe)) return { exitCode: 16, durationMs: 0, cmdLine: "", error: "inspector absent" };

  createUnrealFolders();
  var fso = getFso();
  var psPath = UNREAL_LOGS + "\\nvidia-nip-import.ps1";
  var elevInnerPath = UNREAL_LOGS + "\\nvidia-nip-import-elev-inner.ps1";
  var resultPath = UNREAL_LOGS + "\\nvidia-nip-import-result.json";
  var escInspector = String(inspectorExe).replace(/'/g, "''");
  var escProfile = String(nip).replace(/'/g, "''");
  var escResult = String(resultPath).replace(/'/g, "''");
  var escElevInner = String(elevInnerPath).replace(/'/g, "''");
  var elevInnerLines = [
    "$ErrorActionPreference = 'Stop'",
    "$Inspector = '" + escInspector + "'",
    "$Profile = '" + escProfile + "'",
    "$wd = Split-Path -Parent $Inspector",
    "$argsLine = '-silent -silentImport \"' + $Profile + '\"'",
    "Add-Type @'",
    "using System; using System.Runtime.InteropServices;",
    "public class NpiWinHide {",
    "  [DllImport(\"user32.dll\")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);",
    "}",
    "'@ -ErrorAction SilentlyContinue",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Inspector",
    "$psi.Arguments = $argsLine",
    "$psi.WorkingDirectory = $wd",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if (-not $p) { exit 18 }",
    "for ($i = 0; $i -lt 50; $i++) {",
    "  Start-Sleep -Milliseconds 80",
    "  try { $p.Refresh() } catch {}",
    "  if ($p.MainWindowHandle -ne [IntPtr]::Zero) { [void][NpiWinHide]::ShowWindow($p.MainWindowHandle, 0); break }",
    "}",
    "$null = $p.WaitForExit()",
    "exit $p.ExitCode"
  ];
  var elevTw = fso.CreateTextFile(elevInnerPath, true);
  elevTw.Write(elevInnerLines.join("\r\n"));
  elevTw.Close();
  var lines = [
    "$ErrorActionPreference = 'Stop'",
    "$Inspector = '" + escInspector + "'",
    "$Profile = '" + escProfile + "'",
    "$ResultPath = '" + escResult + "'",
    "$ElevInner = '" + escElevInner + "'",
    "if (-not (Test-Path -LiteralPath $Inspector)) { exit 16 }",
    "if (-not (Test-Path -LiteralPath $Profile)) { exit 17 }",
    "$wd = Split-Path -Parent $Inspector",
    "$argsLine = '-silent -silentImport \"' + $Profile + '\"'",
    "$cmdLine = $Inspector + ' ' + $argsLine",
    "Set-Content -LiteralPath ($env:TEMP + '\\purpleboost-nvidia-cli-last.txt') -Value $cmdLine -Encoding UTF8",
    "$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
    "$sw = [System.Diagnostics.Stopwatch]::StartNew()",
    "$exitCode = -1",
    "$errMsg = ''",
    "Add-Type @'",
    "using System; using System.Runtime.InteropServices;",
    "public class NpiWinHide {",
    "  [DllImport(\"user32.dll\")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);",
    "}",
    "'@ -ErrorAction SilentlyContinue",
    "function Hide-NpiProcessWindow([System.Diagnostics.Process]$proc) {",
    "  if (-not $proc) { return }",
    "  for ($i = 0; $i -lt 50; $i++) {",
    "    Start-Sleep -Milliseconds 80",
    "    try { $proc.Refresh() } catch {}",
    "    if ($proc.MainWindowHandle -ne [IntPtr]::Zero) {",
    "      [void][NpiWinHide]::ShowWindow($proc.MainWindowHandle, 0)",
    "      return",
    "    }",
    "  }",
    "}",
    "function Invoke-NpiHidden {",
    "  $psi = New-Object System.Diagnostics.ProcessStartInfo",
    "  $psi.FileName = $Inspector",
    "  $psi.Arguments = $argsLine",
    "  $psi.WorkingDirectory = $wd",
    "  $psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "  $psi.CreateNoWindow = $true",
    "  $psi.UseShellExecute = $false",
    "  $psi.RedirectStandardError = $true",
    "  $psi.RedirectStandardOutput = $true",
    "  $p = [System.Diagnostics.Process]::Start($psi)",
    "  if (-not $p) { throw [System.InvalidOperationException]::new('ProcessStartFailed') }",
    "  Hide-NpiProcessWindow $p",
    "  $stdout = $p.StandardOutput.ReadToEnd()",
    "  $stderr = $p.StandardError.ReadToEnd()",
    "  $null = $p.WaitForExit()",
    "  return @{ ExitCode = $p.ExitCode; StdOut = $stdout; StdErr = $stderr }",
    "}",
    "try {",
    "  if ($isAdmin) {",
    "    $run = Invoke-NpiHidden",
    "    $exitCode = $run.ExitCode",
    "    $errMsg = [string]$run.StdErr",
    "  } else {",
    "    $elevArgs = @('-NoProfile','-ExecutionPolicy','Bypass','-WindowStyle','Hidden','-File',$ElevInner)",
    "    $ep = Start-Process -FilePath 'powershell.exe' -ArgumentList $elevArgs -Verb RunAs -Wait -PassThru -WindowStyle Hidden",
    "    if ($ep) { $exitCode = $ep.ExitCode } else { $exitCode = 18 }",
    "  }",
    "} catch {",
    "  $errMsg = [string]$_.Exception.Message",
    "  if ($errMsg -match '1223|canceled|cancelled|refus|operation was canceled') { $exitCode = 1223 }",
    "  elseif ($exitCode -lt 0) { $exitCode = 18 }",
    "}",
    "$sw.Stop()",
    "$payload = @{ exitCode = $exitCode; durationMs = [int]$sw.ElapsedMilliseconds; cmdLine = $cmdLine; stderr = $errMsg }",
    "$dir = Split-Path -Parent $ResultPath",
    "if ($dir -and -not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }",
    "($payload | ConvertTo-Json -Compress) | Out-File -LiteralPath $ResultPath -Encoding utf8 -Force",
    "exit $exitCode"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(lines.join("\r\n"));
  tw.Close();
  logNvidiaPanelDev("Commande silencieuse : " + inspectorExe + " -silentImport \"" + nip + "\"");
  var shellCode = runPowerShell("-File \"" + psPath + "\"");
  var out = { exitCode: shellCode, durationMs: 0, cmdLine: inspectorExe + " -silentImport \"" + nip + "\"", error: "" };
  try {
    if (fso.FileExists(resultPath)) {
      var json = readTextFileAll(resultPath);
      if (json) {
        var parsed = JSON.parse(json);
        if (parsed && typeof parsed.exitCode !== "undefined") out.exitCode = parsed.exitCode;
        if (parsed && parsed.durationMs) out.durationMs = parsed.durationMs;
        if (parsed && parsed.cmdLine) out.cmdLine = parsed.cmdLine;
        if (parsed && parsed.stderr) out.error = String(parsed.stderr);
      }
      fso.DeleteFile(resultPath, true);
    }
  } catch (eJ) {}
  try { if (fso.FileExists(psPath)) fso.DeleteFile(psPath, true); } catch (eDel) {}
  try { if (fso.FileExists(elevInnerPath)) fso.DeleteFile(elevInnerPath, true); } catch (eDel2) {}
  appendNvidiaProfileLogLine("NPI_CMD=" + out.cmdLine);
  appendNvidiaProfileLogLine("NPI_EXIT_CODE=" + out.exitCode);
  logNvidiaPanelDev("Import terminÃ©  â€” code=" + out.exitCode + " durÃ©e=" + out.durationMs + "ms");
  if (out.error) logNvidiaPanelDev("Import stderr : " + out.error);
  return out;
}

function exportNvidiaProfileToVerifyPath(inspectorExe, destPath) {
  return exportNvidiaBackupViaInspector(inspectorExe, destPath);
}

function verifyNvidiaResetAfterImport(inspector, importedPath, resetSource) {
  var verifyPath = getAbsolutePathFs((getNvidiaBackupDir() || UNREAL_LOGS) + "\\__verify_after_reset.nip");
  try {
    if (fileExists(verifyPath)) getFso().DeleteFile(verifyPath, true);
  } catch (eRm) {}
  sleepMs(1500);
  var expCode = exportNvidiaProfileToVerifyPath(inspector, verifyPath);
  if (expCode !== 0 || !fileExists(verifyPath)) {
    return { state: "unverified", detail: "export post-reset impossible (code " + expCode + ")" };
  }
  var afterMap = parseNvidiaNipSettingMap(verifyPath);
  var importedMap = parseNvidiaNipSettingMap(importedPath);
  if (resetSource === "backup") {
    var match = 0;
    var total = 0;
    var id;
    for (id in importedMap) {
      if (!importedMap.hasOwnProperty(id)) continue;
      total++;
      if (afterMap[id] === importedMap[id]) match++;
    }
    logNvidiaPanelDev("VÃ©rif backup : correspondance " + match + "/" + total + " rÃ©glages");
    if (total >= 5 && match / total >= 0.75) return { state: "confirmed", detail: "profil driver alignÃ© sur le backup" };
    if (total >= 1 && match > 0) return { state: "confirmed", detail: "partie du backup restaurÃ©e (" + match + "/" + total + ")" };
    return { state: "unconfirmed", detail: "le driver ne correspond pas au backup importÃ©" };
  }
  var unrealPath = resolveNvidiaFpsLatencyProfilePath();
  var unrealMap = unrealPath ? parseNvidiaNipSettingMap(unrealPath) : {};
  var same = 0;
  var checked = 0;
  var i;
  var sid;
  for (i = 0; i < NVIDIA_RESET_WATCH_IDS.length; i++) {
    sid = NVIDIA_RESET_WATCH_IDS[i];
    if (typeof unrealMap[sid] === "undefined") continue;
    checked++;
    if (afterMap[sid] === unrealMap[sid]) same++;
  }
  logNvidiaPanelDev("VÃ©rif dÃ©faut : rÃ©glages encore identiques au profil Unreal " + same + "/" + checked);
  if (countNvidiaNipProfileSettings(importedPath) < 1) {
    return { state: "unconfirmed", detail: "fichier reset sans rÃ©glages  â€” aucun changement attendu" };
  }
  if (checked > 0 && same >= checked) {
    return { state: "unconfirmed", detail: "rÃ©glages FPS/latence toujours identiques au profil Unreal" };
  }
  if (checked > 0 && same < checked) {
    return { state: "confirmed", detail: "Ã©cart confirmÃ© sur " + (checked - same) + " rÃ©glage(s) surveillÃ©(s)" };
  }
  var afterCount = countNvidiaNipProfileSettings(verifyPath);
  var importCount = countNvidiaNipProfileSettings(importedPath);
  if (importCount >= 3 && afterCount >= 3) {
    return { state: "confirmed", detail: "profil driver rÃ©exportÃ© aprÃ¨s import (" + afterCount + " rÃ©glages)" };
  }
  return { state: "unverified", detail: "comparaison des rÃ©glages surveillÃ©s impossible" };
}

/** Export sauvegarde via -exportCustomized (NPI v3+), sans ouvrir l'interface. */
function exportNvidiaBackupViaInspector(inspectorExe, backupPath) {
  if (!inspectorExe || !fileExists(inspectorExe)) return 16;
  var dest = getAbsolutePathFs(backupPath || "");
  if (!dest) return 17;
  var backupDir = getNvidiaBackupDir();
  if (!backupDir || !createFolder(backupDir)) return 17;

  createUnrealFolders();
  var fso = getFso();
  var psPath = UNREAL_LOGS + "\\nvidia-nip-export.ps1";
  var escInspector = String(inspectorExe).replace(/'/g, "''");
  var escDest = String(dest).replace(/'/g, "''");
  var lines = [
    "$ErrorActionPreference = 'Stop'",
    "$Inspector = '" + escInspector + "'",
    "$Dest = '" + escDest + "'",
    "$wd = Split-Path -Parent $Inspector",
    "if (-not (Test-Path -LiteralPath $Inspector)) { exit 16 }",
    "$argsLine = '-exportCustomized'",
    "$cmdLine = $Inspector + ' ' + $argsLine",
    "Set-Content -LiteralPath ($env:TEMP + '\\purpleboost-nvidia-cli-last.txt') -Value $cmdLine -Encoding UTF8",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Inspector",
    "$psi.Arguments = $argsLine",
    "$psi.WorkingDirectory = $wd",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$before = @(Get-ChildItem -LiteralPath $wd -Filter '*.nip' -File -ErrorAction SilentlyContinue | ForEach-Object { $_.FullName })",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if (-not $p) { exit 18 }",
    "$p.WaitForExit()",
    "if ($p.ExitCode -ne 0) { exit $p.ExitCode }",
    "$after = Get-ChildItem -LiteralPath $wd -Filter '*.nip' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending",
    "$newFile = $null",
    "foreach ($f in $after) { if ($before -notcontains $f.FullName) { $newFile = $f; break } }",
    "if (-not $newFile -and $after.Count -gt 0) { $newFile = $after[0] }",
    "if (-not $newFile) { exit 19 }",
    "Copy-Item -LiteralPath $newFile.FullName -Destination $Dest -Force",
    "exit 0"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(lines.join("\r\n"));
  tw.Close();
  logNvidiaPanelDev("Commande silencieuse export : " + inspectorExe + " -exportCustomized  â†’  " + dest);
  var code = runPowerShell("-File \"" + psPath + "\"");
  try { if (fso.FileExists(psPath)) fso.DeleteFile(psPath, true); } catch (eDel2) {}
  logNvidiaPanelDev("Code retour export : " + code);
  return code;
}

function tryExportNvidiaBackupBeforeUnreal(inspector) {
  var backupDir = getNvidiaBackupDir();
  if (!backupDir || !createFolder(backupDir)) {
    logNvidiaPanelDev("Sauvegarde auto : dossier Backups inaccessible.");
    return { ok: false, warn: true };
  }
  var backupPath = getNvidiaBackupBeforeUnrealPath();
  if (!backupPath) return { ok: false, warn: true };
  if (fileExists(backupPath)) {
    logNvidiaPanelDev("Sauvegarde existante conservÃ©e : " + backupPath);
    return { ok: true, warn: false };
  }
  var code = exportNvidiaBackupViaInspector(inspector, backupPath);
  if (code === 0 && fileExists(backupPath)) {
    logNvidiaPanelDev("Sauvegarde crÃ©Ã©e : " + backupPath);
    return { ok: true, warn: false };
  }
  logNvidiaPanelDev("Sauvegarde auto impossible (code " + code + ")  â€” application du profil poursuivie.");
  return { ok: false, warn: true };
}

/* ========== NvidiaAutomationV2 (module indÃ©pendant) ==========
 * N'appelle pas DDU ni NVCleanInstall. Logs : nvidia-gaming.log, nvidia-automation-v2.log.
 * NIP Ã©levÃ© : ApplyNipProfile / importNvidiaProfileNipElevated (HTA).
 * Affichage max : runNvGamingDisplayApply + NvidiaAutomationV2.exe (--skip-nip pour NIP).
 */
var nvGamingDisplayCache = null;

function makeNvGamingResult(status, message) {
  return { status: status, message: message || "" };
}

function getNvGamingLogPath() {
