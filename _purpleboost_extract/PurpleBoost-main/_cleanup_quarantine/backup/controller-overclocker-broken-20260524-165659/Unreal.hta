}

var purpleboostNvDevMode = false;

function getNvFinalLogDir() {
  var app = getAppFolderFromHta();
  return app ? getAbsolutePathFs(app + "\\logs\\nvidia-final") : (UNREAL_LOGS + "\\nvidia-final");
}

function ensureNvFinalLogDir() {
  try {
    var fso = getFso();
    var dir = getNvFinalLogDir();
    if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
    return dir;
