function applyGsyncOffTestFromUi() {
  setNvGamingStatus("G-Sync OFFâ€¦", "progress");
  var box = $("nvidiaGamingSteps");
  if (box) { box.style.display = "none"; box.innerHTML = ""; }
  window.setTimeout(function () {
    try {
      appendNvGamingLogLine("ACTION=disable_gsync_test");
      var payload = runNvidiaAutomationV2DisableGsyncOnly();
      if (!payload || payload.error) {
