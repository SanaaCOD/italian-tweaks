  }
  if (/\[NVCleanstall\].*Page finale|\[NVCleanstall\].*Page prete detectee|Page prete detectee, lancement|\[NVCleanstall\].*Texte detecte|Your customized installer is now ready/i.test(live)) {
    return { pct: 75, msg: "Page prÃªte dÃ©tectÃ©e, lancement de l'installation NVIDIA..." };
  }
  if (/\[NVCleanstall\].*FlÃ¨che bas|FlÃ¨che bas \+ EntrÃ©e|\[NVCleanstall\].*Action clavier|fleche bas puis entree|flÃ¨che bas puis entrÃ©e/i.test(live)) {
    return { pct: 80, msg: "Lancement du programme d'installation NVIDIA..." };
  }
  if (/\[NVCleanInstall\].*NVIDIA Installer|Attente Programme d'installation|\[NVCleanstall\].*Attente installateur/i.test(live)) {
    return { pct: 80, msg: "Lancement du programme d'installation NVIDIA..." };
  }
  if (/Page Finished detectee|attente stabilisation/i.test(live)) {
    return { pct: 75, msg: "DÃ©tection page prÃªte NVCleanstall..." };
  }
  if (/verifiez le focus|vÃ©rifiez le focus/i.test(live)) {
    return { pct: 75, msg: live };
  }
  if (/Lancement du programme d'installation NVIDIA|Lancement du programme d installation NVIDIA/i.test(live)) {
    return { pct: 80, msg: "Lancement du programme d'installation NVIDIA..." };
  }
  if (/Install lancÃ©|programme d'installation NVIDIA|Ouverture du programme/i.test(live)) {
    return { pct: 80, msg: "Lancement du programme d'installation NVIDIA..." };
  }
  if (/Contrat NVIDIA acceptÃ©|Contrat NVIDIA accepte/i.test(live)) {
    return { pct: 85, msg: "Contrat NVIDIA acceptÃ©." };
  }
  if (/\[NVIDIA Installer\].*Options d'installation|\[NVIDIA Installer\].*PersonnalisÃ©e|\[NVIDIA Installer\].*Personnalisee/i.test(live)) {
    return { pct: 90, msg: "Installation personnalisÃ©e sÃ©lectionnÃ©e." };
  }
  if (/\[NVIDIA-INSTALLER\].*Options page detected|\[NVIDIA-INSTALLER\].*PersonnalisÃ©e|\[NVIDIA-INSTALLER\].*Personnalisee/i.test(live)) {
    return { pct: 90, msg: "Installation personnalisÃ©e sÃ©lectionnÃ©e." };
  }
  if (/\[NVIDIA-INSTALLER\].*Installation final state|\[NVIDIA-INSTALLER\].*Progress forced to 100|Installation NVIDIA terminÃ©e â€” validation finale/i.test(live)) {
    return { pct: 100, msg: "Installation NVIDIA terminÃ©e â€” validation finale manuelle si demandÃ©e." };
  }
  if (/Installation personnalisÃ©e sÃ©lectionnÃ©e|Installation personnalisee selectionnee/i.test(live)) {
    return { pct: 90, msg: "Installation personnalisÃ©e sÃ©lectionnÃ©e." };
  }
  if (/Installation NVIDIA lancÃ©e|Installation du pilote NVIDIA en cours/i.test(live)) {
    return { pct: 95, msg: "Installation du pilote NVIDIA en cours..." };
  }
  if (/^NVIDIA\s*:\s*attente du programme/i.test(live)) {
    return { pct: 82, msg: live };
  }
  if (/^NVIDIA\s*:\s*licence/i.test(live)) {
    return { pct: 85, msg: live };
  }
  if (/^NVIDIA\s*:\s*options d'installation|^NVIDIA\s*:\s*sÃ©lection PersonnalisÃ©e|^NVIDIA\s*:\s*validation Options/i.test(live)) {
    return { pct: 90, msg: live };
  }
  if (/^NVIDIA\s*:\s*options personnalisÃ©es/i.test(live)) {
