<!DOCTYPE html>
<html lang="fr">
<head>
<HTA:APPLICATION
  APPLICATIONNAME="UNREAL Gaming Optimizer"
  ID="UnrealApp"
  BORDER="none"
  CAPTION="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="no"
  SCROLL="no"
  SELECTION="no"
  CONTEXTMENU="no"
  WINDOWSTATE="maximize"
  INNERBORDER="no"
  ICON="none"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="no"
/>
<meta http-equiv="X-UA-Compatible" content="IE=11" />
<meta charset="UTF-8" />
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<title>UNREAL Gaming Optimizer</title>

<style type="text/css">
:root{
  --bg-unified:#0a0a0e;
  --bg-app:#0a0a0e;
  --bg-main:#0a0a0e;
  --bg-sidebar:#0a0a0e;
  --surface:#0a0a0e;
  --surface-2:#0a0a0e;
  --surface-elev:#0a0a0e;
  /* Logo : bleu nÃ©on gauche â†’ jonction centre â†’ rose nÃ©on droite */
  --neon-blue:#00CFFF;
  --neon-cyan:#00E8FF;
  --neon-blue-bright:#5CE4FF;
  --neon-blue-dim:#1EA7FF;
  --neon-junction:#B8A8FF;
  --neon-violet:#B8A8FF;
  --neon-mid:#D4A0FF;
  --neon:#FF4FD8;
  --neon-bright:#FF7AE8;
  --neon-pink:#FF4FD8;
  --neon-magenta:#FF3CCF;
  --neon-dim:#FF6AE8;
  --accent-blue:var(--neon-blue-bright);
  --accent:var(--neon-pink);
  --border-neon-blue:#00D8FF;
  --border-neon-center:#C93CFF;
  --border-neon-pink:#FF3CCF;
  --border-blue:rgba(0,216,255,.92);
  --border-mix:rgba(201,60,255,.78);
  --border-violet:rgba(184,168,255,.55);
  --border-pink:rgba(255,60,207,.92);
  --border-neon:var(--border-neon-pink);
  --border-neon-strong:rgba(255,122,232,.98);
  --grad-spectrum-h:linear-gradient(90deg,#00CFFF 0%,#00CFFF 16%,#1EA7FF 24%,#4DB8FF 34%,#8EB8FF 42%,#C8B0FF 48%,#E090FF 52%,#FF6AE8 58%,#FF4FD8 68%,#FF3CCF 82%,#FF3CCF 100%);
  --grad-spectrum-bar:linear-gradient(90deg,#00CFFF 0%,#1EA7FF 18%,#5CE4FF 30%,#A8C8FF 42%,#D8B0FF 50%,#F090FF 54%,#FF4FD8 66%,#FF3CCF 82%,#FF3CCF 100%);
  --grad-border-center:linear-gradient(135deg,#00CFFF 0%,#00CFFF 48%,#FF3CCF 52%,#FF3CCF 100%);
  --grad-split-slash:linear-gradient(135deg,#00CFFF 0%,#00CFFF 48%,#FF3CCF 52%,#FF3CCF 100%);
  --grad-btn-primary:linear-gradient(90deg,#0099CC 0%,#1EA7FF 38%,#C878FF 52%,#FF3CCF 100%);
  --grad-btn-primary-hover:linear-gradient(90deg,#00CFFF 0%,#5CE4FF 36%,#E090FF 52%,#FF4FD8 100%);
  --glow-line:0 0 10px rgba(0,207,255,.4),0 0 14px rgba(255,79,216,.35);
  --glow-blue:
    0 0 0 2px rgba(0,216,255,.88),
    0 0 22px rgba(0,207,255,.78),
    0 0 44px rgba(19,191,255,.55),
    0 0 68px rgba(0,207,255,.28),
    inset 0 0 32px rgba(0,207,255,.09);
  --shadow-center-split:
    inset 4px 0 0 0 #00D8FF,
    inset -4px 0 0 0 #FF3CCF,
    0 0 28px rgba(0,207,255,.92),
    0 0 28px rgba(255,79,216,.92),
    0 0 52px rgba(19,191,255,.55),
    0 0 52px rgba(255,63,207,.55);
  --shadow-center-split-inner:
    inset 3px 0 0 0 #00D8FF,
    inset -3px 0 0 0 #FF3CCF,
    0 0 18px rgba(0,207,255,.78),
    0 0 18px rgba(255,79,216,.78);
  --glow-center:var(--shadow-center-split);
  --glow-mix:var(--glow-center);
  --glow-mix-hover:
    0 0 0 2px rgba(92,228,255,.85),
    0 0 28px rgba(0,207,255,.72),
    0 0 38px rgba(201,60,255,.65),
    0 0 58px rgba(255,79,216,.58),
    inset 0 0 40px rgba(0,207,255,.08),
    inset 0 0 40px rgba(255,63,207,.08);
  --glow-pink:
    0 0 0 2px rgba(255,60,207,.9),
    0 0 24px rgba(255,79,216,.82),
    0 0 46px rgba(201,60,255,.58),
    0 0 70px rgba(255,63,207,.32),
    inset 0 0 32px rgba(255,63,207,.09);
  --glow-card:
    0 0 0 2px rgba(140,200,255,.45),
    0 0 20px rgba(0,207,255,.35),
    0 0 26px rgba(255,79,216,.32),
    inset 0 0 24px rgba(0,0,0,.12);
  --glow-card-hover:var(--glow-mix-hover);
  --text:#f8fafc;
  --text-soft:#a1a1b5;
  --line:rgba(0,207,255,.22);
  --line-soft:rgba(255,79,216,.18);
}
/* AtmosphÃ¨re : bleu Ã  gauche, rose Ã  droite â€” pas de barre violette centrale */
.app::before{
  content:"";position:fixed;left:0;top:0;right:0;bottom:0;z-index:0;pointer-events:none;
  background:
    linear-gradient(90deg,
      rgba(0,207,255,.14) 0%,rgba(0,207,255,.09) 14%,rgba(30,167,255,.05) 24%,
      rgba(10,10,14,0) 40%,rgba(10,10,14,0) 60%,
      rgba(255,60,207,.05) 76%,rgba(255,79,216,.09) 86%,rgba(255,60,207,.13) 100%);
}
.app > *{position:relative;z-index:1;}
html,body{
  margin:0;padding:0;width:100%;height:100%;
  overflow:hidden;
  background:#05060a;
  scrollbar-face-color:#151522;
  scrollbar-track-color:#05060a;
  scrollbar-arrow-color:#ff3ccf;
  scrollbar-shadow-color:#00d8ff;
  scrollbar-highlight-color:#151522;
  scrollbar-3dlight-color:#05060a;
  scrollbar-darkshadow-color:#05060a;
}
body{
  font-family:"Segoe UI","Segoe UI Variable",Tahoma,sans-serif;
  font-size:14px;
  color:var(--text);
  overflow:hidden;
  background:#05060a;
  border:none;
}
html{
  border:none;
}
.app-shell{
  display:flex;flex-direction:column;width:100vw;height:100vh;
  overflow:hidden;background:#05060a;
}
.unreal-titlebar{
  flex:0 0 32px;height:32px;min-height:32px;
  display:flex;align-items:center;justify-content:space-between;
  padding:0 10px 0 14px;box-sizing:border-box;
  background:linear-gradient(180deg,#0c0d14 0%,#08090f 100%);
  border-bottom:1px solid rgba(0,216,255,.35);
  box-shadow:0 1px 0 rgba(255,60,207,.22),0 4px 18px rgba(0,0,0,.45);
  user-select:none;position:relative;z-index:50;
}
.unreal-titlebar__brand{
  font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
  color:#b8c8e8;
  text-shadow:0 0 10px rgba(0,207,255,.35),0 0 14px rgba(255,79,216,.25);
}
.unreal-titlebar__actions{display:flex;align-items:center;gap:6px;}
.unreal-titlebar__btn{
  width:28px;height:22px;padding:0;border:1px solid rgba(255,255,255,.08);
  border-radius:6px;background:#12131c;color:#a8b4d4;
  font-size:14px;line-height:1;cursor:pointer;font-family:inherit;
}
.unreal-titlebar__btn--min:hover{
  border-color:rgba(0,216,255,.55);color:#e8f8ff;
  background:linear-gradient(180deg,#15202e,#0f141c);
  box-shadow:0 0 12px rgba(0,207,255,.35);
}
.unreal-titlebar__btn--close:hover{
  border-color:rgba(255,60,207,.65);color:#ffe8f8;
  background:linear-gradient(180deg,#2a1220,#180c14);
  box-shadow:0 0 12px rgba(255,79,216,.4);
}
.app-scroll{
  flex:1 1 auto;min-height:0;
  overflow:hidden;
  display:flex;flex-direction:column;
  background:#05060a;
}
.app{position:relative;z-index:1;display:flex;flex:1;min-height:0;}
.sidebar{
  width:268px;flex:0 0 268px;
  background:var(--bg-unified);
  border-right:1px solid var(--border-blue);
  box-shadow:4px 0 40px rgba(0,0,0,.55),inset -1px 0 0 rgba(0,207,255,.12);
  display:flex;flex-direction:column;padding:18px 14px 14px;box-sizing:border-box;
}
.brand{display:flex;gap:12px;align-items:center;padding:4px 6px 18px;border-bottom:1px solid rgba(0,207,255,.22);margin-bottom:8px;}
.logo{
  border-radius:0;flex-shrink:0;
  position:relative;overflow:visible;
  background:transparent !important;border:none;box-shadow:none;
}
.logo.logo-stack{
  display:block;width:52px;height:52px;line-height:0;font-size:0;
}
.logo.logo-stack .brand-logo-png,
.logo.logo-stack .brand-logomark{
  position:absolute;left:50%;top:50%;
  -ms-transform:translate(-50%,-50%);
  transform:translate(-50%,-50%);
  margin:0;
}
.brand-logo-png{
  display:none;border:0;outline:none;
  background:transparent !important;background-color:transparent !important;
  max-width:48px;max-height:48px;width:auto;height:auto;
  object-fit:contain;object-position:center;
  -ms-interpolation-mode:bicubic;
  filter:none !important;-ms-filter:none !important;
}
.brand-logomark{
  width:48px;height:48px;display:block;
  filter:drop-shadow(0 0 6px rgba(0,207,255,.7)) drop-shadow(0 0 12px rgba(255,79,216,.45));
}
.brand-logomark .ubl-stroke-white{fill:none;stroke:#f8f7ff;stroke-opacity:0.92;}
.brand-logomark .ubl-stroke-grad{fill:none;}
.brand h1{margin:0;font-size:17px;font-weight:900;letter-spacing:.06em;color:var(--text);}
.brand p{margin:4px 0 0;font-size:11px;font-weight:650;color:var(--text-soft);letter-spacing:.04em;}
.nav-label{
  font-size:10px;font-weight:900;letter-spacing:.2em;text-transform:uppercase;
  color:rgba(92,228,255,.58);margin:14px 4px 6px;
}
.nav{flex:1;overflow:auto;padding:4px 2px 8px;}
.navbtn{
  width:100%;text-align:left;border:none;border-radius:10px;padding:11px 12px 11px 14px;margin:2px 0;
  cursor:pointer;color:#d4d2e0;background:transparent;font-size:13px;font-weight:700;
  border-left:3px solid transparent;
  transition:background .15s ease,color .15s ease,border-color .15s ease,box-shadow .15s ease;
}
.navbtn:hover{
  color:#fff;
  background:rgba(0,207,255,.08);
  border-left-color:rgba(0,207,255,.42);
}
.navbtn.active{
  background:linear-gradient(90deg,rgba(0,207,255,.22),rgba(184,168,255,.08) 48%,rgba(255,79,216,.16));
  color:#fff;
  border-left-color:var(--neon-blue);
  box-shadow:0 0 24px rgba(0,207,255,.34),0 0 32px rgba(255,79,216,.24),inset 0 0 0 1px rgba(184,168,255,.2);
}
.sidebar-foot{
  font-size:10px;font-weight:650;color:var(--text-soft);line-height:1.5;padding:12px 8px 4px;
  border-top:1px solid rgba(0,207,255,.16);margin-top:8px;letter-spacing:.02em;
}
.main{
  flex:1;display:flex;flex-direction:column;min-width:0;min-height:0;position:relative;z-index:1;
  background:var(--bg-unified);
  box-shadow:inset 12px 0 48px rgba(0,0,0,.35),inset -120px 0 80px rgba(255,79,216,.04);
}
.content{
  flex:1;overflow-y:auto;overflow-x:hidden;padding:22px 28px 16px;
  position:relative;z-index:1;
  background:var(--bg-unified);
  scrollbar-face-color:#151522;
  scrollbar-track-color:#05060a;
  scrollbar-arrow-color:#ff3ccf;
  scrollbar-shadow-color:#00d8ff;
  scrollbar-highlight-color:#151522;
  scrollbar-3dlight-color:#05060a;
  scrollbar-darkshadow-color:#05060a;
}
.content::-webkit-scrollbar{width:8px;}
.content::-webkit-scrollbar-track{background:#05060a;}
.content::-webkit-scrollbar-thumb{
  background:linear-gradient(180deg,#00d8ff,#ff3ccf);
  border-radius:999px;
}
.content:before{display:none;}
.page{display:none;}.page.active{display:block;}
h2.page-title{
  margin:0 0 6px;font-size:30px;font-weight:900;color:var(--text);
  letter-spacing:-.02em;line-height:1.15;
}
p.lead{margin:0 0 18px;color:var(--text-soft);line-height:1.55;max-width:920px;font-size:14px;}
.neon-panel{
  border-radius:14px;padding:20px 22px;
  border:2px solid rgba(184,168,255,.45);
  background-color:#0a0a0e;
  background-image:none;
  box-shadow:var(--shadow-center-split);
  position:relative;overflow:visible;z-index:1;
  transition:box-shadow .2s ease,border-color .2s ease,transform .2s ease;
}
.neon-panel::before{
  content:"";position:absolute;left:10px;right:10px;top:0;height:3px;border-radius:0 0 6px 6px;
  background:var(--grad-spectrum-h);
  opacity:1;pointer-events:none;
  box-shadow:0 0 14px rgba(0,207,255,.65),0 0 22px rgba(255,79,216,.55);
}
.neon-panel:hover{box-shadow:var(--glow-mix-hover);}
.neon-inner{position:relative;z-index:1;}

/* --- Encadrements nÃ©on : gauche bleu | centre slash diagonal | droite rose --- */
.neon-card-left{
  border:2px solid #00D8FF !important;
  box-shadow:var(--glow-blue) !important;
  background-color:var(--bg-unified) !important;
}
.neon-card-right{
  border:2px solid #FF3CCF !important;
  box-shadow:var(--glow-pink) !important;
  background-color:var(--bg-unified) !important;
}
/* Centre : moitiÃ© gauche bleue / moitiÃ© droite rose â€” bordure visible (MSHTA-safe) */
.neon-card-center,
.home-stats-grid .home-stat-card:nth-child(2),
.cards > .card:nth-child(3n+2):not(:nth-child(2):nth-last-child(1)),
#page-drivers .cards > .card:nth-child(2),
#page-conn .neon-panel.tcp-card,
.neon-panel.tcp-card{
  border:2px solid rgba(184,168,255,.45) !important;
  background-color:#0a0a0e !important;
  background-image:none !important;
  box-shadow:var(--shadow-center-split) !important;
  position:relative;
  overflow:visible;
  z-index:0;
}
.neon-card-center:hover,
.home-stats-grid .home-stat-card:nth-child(2):hover,
.cards > .card:nth-child(3n+2):not(:nth-child(2):nth-last-child(1)):hover,
#page-drivers .cards > .card:nth-child(2):hover,
#page-conn .neon-panel.tcp-card:hover{
  box-shadow:
    inset 4px 0 0 0 #5CE4FF,
    inset -4px 0 0 0 #FF7AE8,
    0 0 32px rgba(0,207,255,.95),
    0 0 32px rgba(255,79,216,.95),
    0 0 58px rgba(19,191,255,.62),
    0 0 58px rgba(255,63,207,.58) !important;
}
/* Sous-encadrements dans blocs centraux */
.neon-card-center .panel,
.neon-card-center .chip,
.neon-card-center .nv-driver-upd,
.neon-card-center .option-tile,
.cards > .card:nth-child(3n+2) .grid2 > .panel,
.cards > .card:nth-child(3n+2) .panel,
.cards > .card:nth-child(3n+2) .nv-driver-upd,
#page-drivers .cards > .card:nth-child(2) .grid2 > .panel,
#page-drivers .cards > .card:nth-child(2) .nv-driver-upd,
#page-drivers .cards > .card:nth-child(2) #nvDriverUpdatePanel,
#page-drivers .cards > .card:nth-child(2) #nvPresetPanel{
  border:2px solid rgba(140,200,255,.4) !important;
  background-color:#0a0a0e !important;
  background-image:none !important;
  box-shadow:var(--shadow-center-split-inner) !important;
  position:relative;
  overflow:visible;
  z-index:0;
}
.kicker{
  font-size:10px;letter-spacing:.24em;text-transform:uppercase;
  color:rgba(140,200,255,.82);font-weight:900;margin-bottom:4px;
}
.grid3{display:flex;flex-wrap:wrap;gap:14px;margin-top:16px;}
.chip{
  flex:1 1 230px;border-radius:12px;padding:16px;
  border:2px solid rgba(184,168,255,.72);
  background:var(--bg-unified);
  box-shadow:var(--glow-card);
  position:relative;overflow:visible;z-index:0;
  transition:box-shadow .2s ease,border-color .2s ease;
}
.grid3 > .chip:nth-child(3n+1){border-color:#00D8FF;box-shadow:var(--glow-blue);}
.grid3 > .chip:nth-child(3n+2):not(:nth-child(2):nth-last-child(1)){
  border:2px solid rgba(184,168,255,.45);
  background-color:#0a0a0e;
  background-image:none;
  box-shadow:var(--shadow-center-split);
}
.grid3 > .chip:nth-child(2):nth-last-child(1){border:2px solid #FF3CCF;box-shadow:var(--glow-pink);}
.grid3 > .chip:nth-child(3n){border-color:#FF3CCF;box-shadow:var(--glow-pink);}
.grid3 > .chip:nth-child(3n+1):hover{box-shadow:var(--glow-blue);}
.grid3 > .chip:nth-child(3n+2):not(:nth-child(2):nth-last-child(1)):hover{box-shadow:var(--glow-mix-hover);}
.grid3 > .chip:nth-child(3n):hover{box-shadow:var(--glow-pink);}
.chip .label{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent-blue);font-weight:900;}
.chip .value{margin-top:10px;font-size:15px;font-weight:800;color:var(--text);word-break:break-word;}
.grid2{display:flex;flex-wrap:wrap;gap:14px;margin-top:14px;}
.panel{
  flex:1 1 320px;border-radius:12px;padding:16px 18px;
  border:2px solid rgba(184,168,255,.72);
  background:var(--bg-unified);
  box-shadow:var(--glow-card);
  position:relative;overflow:visible;z-index:0;
}
.grid2 > .panel:nth-child(3n+1){border-color:#00D8FF;box-shadow:var(--glow-blue);}
.grid2 > .panel:nth-child(3n+2):not(:nth-child(2):nth-last-child(1)){
  border:2px solid rgba(184,168,255,.45);
  background-color:#0a0a0e;
  background-image:none;
  box-shadow:var(--shadow-center-split);
}
.grid2 > .panel:nth-child(2):nth-last-child(1){border:2px solid #FF3CCF;box-shadow:var(--glow-pink);}
.grid2 > .panel:nth-child(3n){border-color:#FF3CCF;box-shadow:var(--glow-pink);}
.panel h3{margin:0 0 10px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--neon-blue-bright);font-weight:900;}
.row{margin-top:10px;}.row .l{color:var(--text-soft);font-size:12px;font-weight:700;}.row .v{font-size:17px;font-weight:900;margin-top:5px;color:var(--text);}
.cards{display:flex;flex-wrap:wrap;gap:16px;margin-top:16px;}
.card{
  flex:1 1 240px;border-radius:12px;padding:18px 20px 16px;
  border:2px solid rgba(184,168,255,.72);
  background:var(--bg-unified);
  box-shadow:var(--glow-card);
  color:var(--text);
  transition:box-shadow .2s ease,border-color .2s ease;
  position:relative;overflow:visible;z-index:0;
}
/* Cartes principales : gauche bleu | centre slash | droite rose */
.cards > .card:nth-child(3n+1),
.cards > .card:nth-child(1):nth-last-child(1){
  border:2px solid #00D8FF;
  box-shadow:var(--glow-blue);
  background-color:var(--bg-unified);
}
.cards > .card:nth-child(3n+2):not(:nth-child(2):nth-last-child(1)){
  border:2px solid rgba(184,168,255,.45);
  background-color:#0a0a0e;
  background-image:none;
  box-shadow:var(--shadow-center-split);
}
#page-drivers .cards > .card:nth-child(2){
  border:2px solid rgba(184,168,255,.45);
  background-color:#0a0a0e;
  background-image:none;
  box-shadow:var(--shadow-center-split);
}
.cards > .card:nth-child(2):nth-last-child(1){
  border:2px solid #FF3CCF;
  box-shadow:var(--glow-pink);
  background-color:var(--bg-unified);
}
.cards > .card:nth-child(2):nth-last-child(1):hover{box-shadow:var(--glow-pink);}
.cards > .card:nth-child(2):nth-last-child(1)::before{
  background:linear-gradient(135deg,#C93CFF,#FF3CCF);
  box-shadow:0 0 14px rgba(255,79,216,.9);
}
.cards > .card:nth-child(3n),
.cards > .card:nth-child(3):nth-last-child(1){
  border:2px solid #FF3CCF;
  box-shadow:var(--glow-pink);
  background-color:var(--bg-unified);
}
.cards > .card:nth-child(3n+1):hover{box-shadow:var(--glow-blue);}
.cards > .card:nth-child(3n+2):not(:nth-child(2):nth-last-child(1)):hover{box-shadow:var(--glow-mix-hover);}
.cards > .card:nth-child(3n):hover{box-shadow:var(--glow-pink);}
.cards > .card:nth-child(3n+1)::before{background:linear-gradient(135deg,#00CFFF,#13BFFF);box-shadow:0 0 14px rgba(0,207,255,.9);}
.cards > .card:nth-child(3n+2):not(:nth-child(2):nth-last-child(1))::before{
  background:linear-gradient(135deg,#00CFFF 48%,#FF3CCF 52%);
  box-shadow:0 0 14px rgba(0,207,255,.85),0 0 14px rgba(255,79,216,.85);
}
.cards > .card:nth-child(3n)::before{background:linear-gradient(135deg,#C93CFF,#FF3CCF);box-shadow:0 0 14px rgba(255,79,216,.9);}
#page-drivers .cards > .card{border-width:2px;}
.card-desc{display:block;margin-top:10px;margin-left:18px;font-size:13px;font-weight:600;line-height:1.5;color:var(--text-soft);max-width:42em;word-break:break-word;}
.neon-inner > .cards{margin-top:12px;}
.neon-panel .toolbar{margin-top:14px;}
.neon-panel .grid2{margin-top:12px;}
#logBox{margin-top:14px;}
body.page-peripheral-active #logBox{display:none !important;}
.input-wide{width:100%;max-width:560px;box-sizing:border-box;}
.account-form label{display:block;margin-top:14px;}
.account-form label:first-of-type{margin-top:2px;}
.account-form .toolbar{margin-top:16px;}
.tcp-hero-title{margin-top:6px;font-size:20px;font-weight:950;line-height:1.2;color:var(--text);letter-spacing:-.02em;}
.tcp-hero-sub{margin-top:8px;font-size:14px;font-weight:600;line-height:1.5;color:#d8d4ea;max-width:720px;}
.card::before{
  content:"";position:absolute;left:16px;top:12px;width:7px;height:7px;
  background:var(--grad-spectrum-h);
  transform:rotate(45deg);-ms-transform:rotate(45deg);
  border-radius:1px;opacity:1;
  box-shadow:0 0 12px rgba(0,207,255,.7),0 0 18px rgba(255,79,216,.55);
}
.card strong{display:block;color:var(--text);font-size:15px;margin:8px 0 8px 18px;font-weight:850;letter-spacing:.01em;}
.btn{
  border:2px solid var(--border-violet);border-radius:10px;padding:11px 20px;cursor:pointer;font-weight:800;font-size:13px;color:var(--text);
  background:var(--bg-unified);
  box-shadow:0 0 18px rgba(0,207,255,.22),0 0 20px rgba(255,79,216,.18),inset 0 0 24px rgba(0,0,0,.2);
  transition:box-shadow .18s ease,border-color .18s ease,background .18s ease,color .18s ease;
}
.btn:hover{
  border-color:var(--border-mix);
  box-shadow:0 0 28px rgba(0,207,255,.38),0 0 40px rgba(255,79,216,.36),inset 0 0 28px rgba(0,0,0,.12);
  background:var(--bg-unified);
  color:#fff;
}
.btn-primary{
  background:var(--grad-btn-primary);
  border:2px solid rgba(186,230,253,.65);
  color:#fff;
  font-weight:900;
  letter-spacing:.04em;
  text-transform:uppercase;
  font-size:12px;
  padding:14px 22px;
  box-shadow:0 0 28px rgba(0,207,255,.48),0 0 48px rgba(255,79,216,.42),inset 0 1px 0 rgba(255,255,255,.25);
}
.btn-primary:hover{
  background:var(--grad-btn-primary-hover);
  color:#0f172a;
  border-color:#fff;
  box-shadow:0 0 40px rgba(0,207,255,.58),0 0 64px rgba(255,79,216,.52);
}
.btn.secondary{
  background:var(--bg-unified);
  border:2px solid var(--border-violet);
  box-shadow:0 0 16px rgba(0,207,255,.2),0 0 18px rgba(255,79,216,.16),inset 0 0 20px rgba(0,0,0,.25);
  color:#e8e6f0;
}
.btn.secondary:hover{
  border-color:rgba(255,122,232,.75);
  box-shadow:0 0 24px rgba(0,207,255,.3),0 0 36px rgba(255,79,216,.34);
  background:var(--bg-unified);
}
.action-bar{
  margin-top:18px;padding-top:18px;border-top:1px solid rgba(0,207,255,.14);
  display:flex;flex-direction:column;gap:12px;
}
.action-bar .btn-primary{width:100%;box-sizing:border-box;text-align:center;}
.action-bar .toolbar{margin-top:0;justify-content:flex-start;}
input,select{
  max-width:100%;box-sizing:border-box;margin-top:8px;padding:11px 14px;border-radius:10px;  border:2px solid var(--border-violet);
  background:var(--bg-unified);color:var(--text);transition:border-color .15s ease,box-shadow .15s ease;
  box-shadow:0 0 14px rgba(0,207,255,.18),0 0 16px rgba(255,79,216,.14),inset 0 0 20px rgba(0,0,0,.2);
}
input:focus,select:focus{outline:none;border-color:var(--border-mix);box-shadow:0 0 0 2px rgba(0,207,255,.35),0 0 28px rgba(0,207,255,.32),0 0 40px rgba(255,79,216,.28);}
label{display:block;margin-top:12px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-blue);font-weight:900;}
.toolbar{margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
.progress{height:10px;border-radius:999px;background:var(--bg-unified);overflow:hidden;margin-top:10px;max-width:560px;border:2px solid var(--border-violet);box-shadow:0 0 16px rgba(0,207,255,.15),0 0 20px rgba(255,79,216,.12),inset 0 2px 8px rgba(0,0,0,.45);}
.progress>i{display:block;height:100%;width:0%;background:var(--grad-spectrum-bar);}
.progress.progress--indeterminate>i{width:38%;animation:ddu-progress-indet 1.35s ease-in-out infinite;}
@keyframes ddu-progress-indet{0%{margin-left:0;width:28%}50%{margin-left:38%;width:42%}100%{margin-left:62%;width:28%}}
.ddu-clean-hint{font-size:12px;color:var(--neon-blue-bright);margin-top:8px;line-height:1.45;}
.ddu-card-actions{flex-wrap:nowrap;gap:12px;align-items:center;}
.tool-status{font-size:12px;margin-top:10px;line-height:1.45;color:#94a3b8;min-height:1.2em;}
.tool-status--info{color:var(--neon-blue-bright);}
.tool-status--success{color:#86efac;}
.tool-status--error{color:#fca5a5;}
.logs{
  border:2px solid rgba(184,168,255,.65);
  border-radius:12px;
  background:var(--bg-unified);
  padding:12px 16px;max-height:210px;overflow:auto;font-family:Consolas,monospace;font-size:12px;color:#e4e0f0;
  box-shadow:var(--glow-card),inset 0 0 32px rgba(0,0,0,.5);
}
.logline{margin:4px 0;white-space:pre-wrap;}
.option-tile{
  display:flex;align-items:center;justify-content:space-between;gap:18px;
  padding:16px 18px;margin-top:14px;border-radius:12px;
  border:2px solid rgba(184,168,255,.45);
  background-color:#0a0a0e;
  background-image:none;
  box-shadow:var(--shadow-center-split);
  position:relative;overflow:visible;z-index:0;
}
.option-tile:first-of-type{margin-top:4px;}
.option-tile-text{flex:1;min-width:0;}
.option-tile-title{display:block;font-size:14px;font-weight:850;color:var(--text);letter-spacing:.01em;}
.option-tile-desc{display:block;margin-top:4px;font-size:12px;color:var(--text-soft);line-height:1.45;}
.unreal-switch{position:relative;display:inline-block;width:52px;height:28px;flex-shrink:0;cursor:pointer;}
.unreal-switch input{position:absolute;opacity:0;width:0;height:0;}
.unreal-switch-track{
  position:absolute;inset:0;border-radius:999px;
  background:var(--bg-unified);border:2px solid rgba(192,132,252,.5);
  box-shadow:0 0 14px rgba(124,58,237,.25),inset 0 2px 10px rgba(0,0,0,.45);
  transition:background .2s,border-color .2s,box-shadow .2s;
}
.unreal-switch-thumb{
  position:absolute;height:20px;width:20px;left:4px;top:2px;border-radius:50%;
  background:linear-gradient(180deg,#f8fafc,#cbd5e1);
  box-shadow:0 2px 6px rgba(0,0,0,.35);
  transition:left .2s;
}
.unreal-switch input:checked + .unreal-switch-track{
  background:var(--grad-spectrum-bar);
  border-color:rgba(186,230,253,.75);
  box-shadow:0 0 22px rgba(0,207,255,.4),0 0 36px rgba(255,79,216,.35),inset 0 1px 4px rgba(0,0,0,.25);
}
.unreal-switch input:checked + .unreal-switch-track .unreal-switch-thumb{left:26px;background:linear-gradient(180deg,#fff,#f1f5f9);}

/* Accueil  â€” hero : grande carte nÃ©on, sans image de fond */
.page-home-root .page-title{display:none;}
.home-hero{
  margin:0 0 16px 0;
  min-height:204px;
  border-radius:14px;
  position:relative;
  overflow:hidden;
  border:none;
  background:var(--bg-unified);
  box-shadow:none;
  transition:box-shadow .2s ease,border-color .2s ease;
}
.home-hero:hover{
  border-color:transparent;
  box-shadow:none;
}
.home-hero::before{
  content:"";position:absolute;left:10px;right:10px;top:0;height:0;
  background:linear-gradient(90deg,transparent,#e879f9,#a5b4fc,#f0abfc,transparent);
  opacity:0;pointer-events:none;
  box-shadow:none;
}
.home-hero-inner{position:relative;z-index:2;padding:24px 20px 28px;text-align:center;max-width:680px;margin:0 auto;}
.home-hero-glass{
  margin:0 auto;
  padding:0;
  border-radius:0;
  border:none;
  background:transparent;
  box-shadow:none;
}
.home-hero-core{
  margin:0 auto 18px auto;position:relative;z-index:1;
  background:transparent !important;border:none;box-shadow:none;
}
.home-hero-core.hero-logo-stack{
  display:block;width:120px;height:132px;line-height:0;font-size:0;padding:0;
}
.home-hero-core.hero-logo-stack .brand-logo-png--hero,
.home-hero-core.hero-logo-stack .brand-logomark--hero{
  position:absolute;left:50%;top:50%;
  -ms-transform:translate(-50%,-50%);
  transform:translate(-50%,-50%);
  margin:0;
}
.brand-logo-png--hero{
  display:none;border:0;outline:none;
  background:transparent !important;background-color:transparent !important;
  max-width:118px;max-height:128px;width:auto;height:auto;
  object-fit:contain;object-position:center;
  -ms-interpolation-mode:bicubic;
  filter:none !important;-ms-filter:none !important;
}
.brand-logomark--hero{
  width:118px;height:128px;display:block;
  filter:drop-shadow(0 0 10px rgba(0,207,255,.72)) drop-shadow(0 0 18px rgba(184,168,255,.28)) drop-shadow(0 0 22px rgba(255,79,216,.48));
}
.home-hero-kicker{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--neon);font-weight:900;margin-bottom:8px;}
.home-hero-title{font-size:24px;font-weight:950;color:var(--text);letter-spacing:.03em;}
.home-hero-sub{margin-top:10px;font-size:14px;line-height:1.55;color:var(--text-soft);max-width:560px;margin-left:auto;margin-right:auto;}

/* Accueil  â€” composants systÃ¨me (4 cartes nÃ©on) */
.home-stats-section{margin-top:6px;}
.home-stats-headline{
  font-size:13px;font-weight:900;letter-spacing:.2em;text-transform:uppercase;
  color:var(--neon-bright);text-align:center;margin:0 0 18px;
  text-shadow:0 0 18px rgba(0,207,255,.45),0 0 28px rgba(255,79,216,.35);
}
.home-stats-grid .home-stat-card:nth-child(1){
  border:2px solid #00D8FF;
  box-shadow:var(--glow-blue);
  background-color:var(--bg-unified);
}
.home-stats-grid .home-stat-card:nth-child(3){
  border:2px solid #FF3CCF;
  box-shadow:var(--glow-pink);
  background-color:var(--bg-unified);
}
.home-stats-grid .home-stat-card:nth-child(1):hover{box-shadow:var(--glow-blue);}
.home-stats-grid .home-stat-card:nth-child(2):hover{box-shadow:var(--glow-mix-hover);}
.home-stats-grid .home-stat-card:nth-child(3):hover{box-shadow:var(--glow-pink);}
.home-stats-grid{
  display:flex;flex-wrap:wrap;gap:16px;
  align-items:stretch;justify-content:center;
}
.home-stat-card{
  flex:1 1 256px;
  min-width:244px;
  max-width:100%;
  border-radius:14px;
  padding:16px 18px 18px 18px;
  border:2px solid rgba(184,168,255,.72);
  background:var(--bg-unified);
  box-shadow:var(--glow-card);
  text-align:left;
  transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;
  box-sizing:border-box;
  position:relative;overflow:visible;z-index:0;
}
.home-stat-card::before{
  content:"";position:absolute;left:18px;top:16px;width:8px;height:8px;
  background:var(--grad-spectrum-h);
  transform:rotate(45deg);-ms-transform:rotate(45deg);
  border-radius:1px;
  box-shadow:0 0 12px rgba(0,207,255,.65),0 0 18px rgba(255,79,216,.5);
  opacity:1;
}
.home-stats-grid .home-stat-card:nth-child(1)::before{background:linear-gradient(135deg,var(--neon-blue),var(--neon-blue-dim));box-shadow:0 0 14px rgba(0,207,255,.85);}
.home-stats-grid .home-stat-card:nth-child(2)::before{
  background:linear-gradient(135deg,#00CFFF 48%,#FF3CCF 52%);
  box-shadow:0 0 14px rgba(0,207,255,.85),0 0 14px rgba(255,79,216,.85);
}
.home-stats-grid .home-stat-card:nth-child(3)::before{background:linear-gradient(135deg,var(--neon-magenta),var(--neon-pink));box-shadow:0 0 14px rgba(255,79,216,.85);}
.home-stat-card:hover{transform:translateY(-2px);}
.home-stat-head{
  display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;
  padding:0 0 12px 20px;margin-bottom:12px;
  border-bottom:1px solid rgba(0,207,255,.16);
}
.home-stats-grid .home-stat-card:nth-child(3) .home-stat-head{border-bottom-color:rgba(255,79,216,.2);}
.home-stats-grid .home-stat-card:nth-child(2) .home-stat-head{border-bottom-color:rgba(184,168,255,.22);}
.home-stat-title{
  font-size:17px;font-weight:950;letter-spacing:.12em;text-transform:uppercase;
  color:#ffffff;
  text-shadow:0 0 18px rgba(0,207,255,.32),0 0 22px rgba(255,79,216,.28),0 1px 2px rgba(0,0,0,.5);
}
.home-stat-badge{
  font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;
  color:#1a1020;
  background:var(--grad-spectrum-h);
  padding:5px 10px;border-radius:999px;
  border:1px solid rgba(186,230,253,.45);
  box-shadow:0 0 14px rgba(0,207,255,.5),0 0 24px rgba(255,79,216,.4);
}
.home-stat-body{margin-top:2px;padding-top:2px;}
.home-stat-value{
  font-size:48px;font-weight:950;line-height:1.08;letter-spacing:-.03em;
  color:#ffffff;
  text-shadow:0 0 22px rgba(0,207,255,.38),0 0 36px rgba(255,79,216,.32);
  margin:0 0 6px 0;
}
.home-stat-hint{
  margin:0;font-size:13px;font-weight:600;color:#d4d0e4;line-height:1.45;
}
.home-stat-model{
  margin:0;font-size:15px;font-weight:700;line-height:1.5;color:#f4f4f8;
  word-break:break-word;
}
.home-stat-card--static .home-stat-model{
  margin-top:0;font-size:16px;font-weight:800;line-height:1.5;color:#ffffff;
  min-height:3.2em;
}
.home-stat-card--static .home-stat-hint{margin-top:14px;}
.home-stat-model--sub{
  margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,79,216,.22);
  font-size:14px;font-weight:600;color:#d8d4ea;line-height:1.5;
}
.home-stat-meta{
  margin:14px 0 0;padding-top:14px;border-top:1px solid rgba(255,79,216,.22);
  font-size:14px;font-weight:600;color:#d8d4ea;line-height:1.45;
}
.home-stat-hint + .home-stat-meta{margin-top:12px;padding-top:14px;}
.home-stat-model--sub + .home-stat-meta{margin-top:12px;padding-top:14px;}
#page-home .neon-panel,
#page-drivers .neon-panel,
#page-game .neon-panel,
#page-opt .neon-panel,
#page-sound .neon-panel,
#page-account .neon-panel,
#page-settings .neon-panel{
  border:2px solid rgba(184,168,255,.45);
  background-color:#0a0a0e;
  background-image:none;
  box-shadow:var(--shadow-center-split);
}
#page-conn .neon-panel:not(.tcp-card){
  border:2px solid rgba(184,168,255,.45);
  background-color:#0a0a0e;
  background-image:none;
  box-shadow:var(--shadow-center-split);
}
#page-home .neon-panel:hover,
#page-drivers .neon-panel:hover{box-shadow:var(--glow-mix-hover);}

/* PÃ©riphÃ©riques */
.gp-host{margin-top:14px;display:flex;flex-wrap:wrap;gap:16px;align-items:stretch;}
.gp-card{
  flex:1 1 300px;border-radius:12px;padding:20px;
  border:2px solid rgba(184,168,255,.72);
  background:var(--bg-unified);
  box-shadow:var(--glow-card);
  position:relative;overflow:visible;z-index:0;
  transition:box-shadow .2s ease,border-color .2s ease;
}
.gp-host > .gp-card:nth-child(1),
.gp-host > .gp-card:nth-child(3n+1){border-color:#00D8FF;box-shadow:var(--glow-blue);}
.gp-host > .gp-card:nth-child(3n+2){
  border:2px solid rgba(184,168,255,.45);
  background-color:#0a0a0e;
  background-image:none;
  box-shadow:var(--shadow-center-split);
}
.gp-host > .gp-card:nth-child(3n),
.gp-host > .gp-card:nth-child(2){border-color:#FF3CCF;box-shadow:var(--glow-pink);}
.gp-card:hover{box-shadow:var(--glow-pink);}
.gp-card h3{margin:0 0 12px;font-size:20px;font-weight:950;color:var(--text);}
.gp-card .gp-line{margin:10px 0;font-size:13px;color:var(--text-soft);line-height:1.5;}
.gp-card .gp-line b{color:var(--neon);font-weight:850;}
.gp-card .usb-actions{margin-top:16px;}
.usb-host{margin-top:12px;}
.usb-card{
  border-radius:12px;padding:16px;margin:12px 0;
  border:2px solid rgba(255,60,207,.85);
  background:var(--bg-unified);
  box-shadow:var(--glow-pink);
}
.usb-card-head{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-start;justify-content:space-between;}
.usb-title{font-size:17px;font-weight:950;color:var(--text);line-height:1.25;max-width:720px;}
.usb-badges{display:flex;flex-wrap:wrap;gap:8px;align-items:center;}
.badge-type{font-size:11px;font-weight:900;padding:6px 10px;border-radius:999px;background:rgba(45,32,62,.9);border:2px solid rgba(192,132,252,.5);color:var(--text);}
.badge-ok{background:rgba(22,101,52,.35);border-color:rgba(74,222,128,.55);color:#bbf7d0;}
.badge-err{background:rgba(45,20,55,.65);border-color:rgba(232,121,249,.45);color:#fbcfe8;}
.badge-unk{background:rgba(40,40,48,.8);border-color:rgba(167,139,250,.4);color:#e2e8f0;}
.usb-meta{margin-top:12px;font-size:13px;color:var(--text-soft);line-height:1.55;}
.usb-meta code{font-size:12px;color:var(--neon);word-break:break-all;}
.usb-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:14px;align-items:flex-end;}
.usb-actions>div{flex:1 1 200px;}
.coc-widget{
  margin-top:14px;max-width:420px;padding:14px 16px 12px;
  border-radius:14px;border:1px solid rgba(139,92,246,.45);
  background:linear-gradient(165deg,rgba(12,10,22,.98) 0%,rgba(6,6,12,.99) 100%);
  box-shadow:0 0 24px rgba(99,102,241,.12),0 0 40px rgba(255,60,207,.06);
}
.coc-header{display:flex;align-items:flex-start;gap:10px;margin-bottom:12px;}
.coc-header-icon{
  width:34px;height:34px;flex-shrink:0;border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  font-size:18px;line-height:1;
  background:linear-gradient(135deg,rgba(250,204,21,.25),rgba(255,60,207,.2));
  border:1px solid rgba(250,204,21,.35);
  box-shadow:0 0 12px rgba(250,204,21,.15);
}
.coc-title{font-size:15px;font-weight:950;color:var(--text);letter-spacing:.02em;line-height:1.2;}
.coc-subtitle{font-size:11px;color:var(--text-soft);margin-top:2px;line-height:1.35;}
.coc-header-text{flex:1;min-width:0;}
.coc-refresh-btn{
  flex-shrink:0;padding:5px 10px;font-size:11px;font-weight:800;
  border-radius:8px;border:1px solid rgba(167,139,250,.35);
  background:rgba(30,22,48,.8);color:#e9d5ff;cursor:pointer;
}
.coc-refresh-btn:hover{border-color:rgba(192,132,252,.6);box-shadow:0 0 10px rgba(139,92,246,.25);}
.coc-refresh-btn:disabled{opacity:.45;cursor:not-allowed;}
.coc-device-row{margin-bottom:6px;}
.coc-select{
  width:100%;padding:7px 10px;font-size:12px;border-radius:8px;
  border:1px solid rgba(120,100,160,.35);background:rgba(8,8,14,.9);color:var(--text);
}
.coc-device-line{font-size:11px;color:var(--text-soft);margin-bottom:8px;line-height:1.4;min-height:14px;}
.coc-badges-row{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px;align-items:center;}
.coc-badge{
  display:inline-block;font-size:10px;font-weight:900;letter-spacing:.06em;
  text-transform:uppercase;padding:4px 9px;border-radius:999px;line-height:1.2;
}
.coc-badge--device{
  background:rgba(20,52,34,.5);border:1px solid rgba(74,222,128,.45);color:#bbf7d0;
}
.coc-badge--default{
  background:rgba(55,38,18,.75);border:1px solid rgba(251,146,60,.55);color:#fed7aa;
}
.coc-badge--optimized{
  background:rgba(20,52,34,.65);border:1px solid rgba(74,222,128,.55);color:#bbf7d0;
}
.coc-badge--warn{
  background:rgba(55,38,18,.75);border:1px solid rgba(251,191,36,.55);color:#fde68a;
}
.coc-widget.coc-tone-mismatch .coc-metric-value{color:#fcd34d;}
.coc-widget.coc-tone-pending .coc-metric-value{color:var(--text-soft);}
.coc-widget.coc-tone-pending .coc-state-line{color:#a5b4fc;}
.coc-metrics{display:grid;grid-template-columns:1fr;gap:6px;margin-bottom:12px;}
.coc-metric{display:flex;align-items:baseline;justify-content:space-between;gap:10px;font-size:12px;}
.coc-metric-label{color:var(--text-soft);font-weight:650;}
.coc-metric-value{font-weight:900;font-variant-numeric:tabular-nums;}
.coc-metric-value--sel{color:#ddd6fe;}
.coc-metric-value--etat{font-size:11px;font-weight:800;}
.coc-widget.coc-tone-default .coc-metric-value{color:#fdba74;}
.coc-widget.coc-tone-opt .coc-metric-value{color:#86efac;}
.coc-pills{display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap;}
.coc-btn-rate{flex:1;min-width:120px;max-width:none;margin:0;padding:9px 12px;font-size:12px;}
.coc-pill{
  flex:1;padding:7px 10px;font-size:12px;font-weight:850;border-radius:999px;cursor:pointer;
  border:1px solid rgba(120,100,160,.4);background:rgba(18,14,28,.85);color:var(--text-soft);
  transition:border-color .15s,background .15s,color .15s,box-shadow .15s;
}
.coc-pill:hover{border-color:rgba(167,139,250,.55);color:#f5f3ff;}
.coc-pill--active{
  border-color:rgba(192,132,252,.85);background:linear-gradient(180deg,rgba(124,58,237,.55),rgba(88,28,135,.65));
  color:#fff;box-shadow:0 0 16px rgba(168,85,247,.35);
}
.coc-pill:not(.coc-pill--active){
  background:rgba(14,12,22,.92);color:#e8e4f4;border-color:rgba(139,92,246,.35);
}
.coc-pill:not(.coc-pill--active):hover{color:#fff;border-color:rgba(167,139,250,.55);}
.coc-pill:disabled{opacity:.4;cursor:not-allowed;}
.coc-btn-primary{
  display:block;width:100%;max-width:280px;margin:0 auto 8px;padding:10px 16px;
  font-size:13px;font-weight:950;letter-spacing:.03em;border-radius:10px;cursor:pointer;
  border:1px solid rgba(192,132,252,.7);
  background:linear-gradient(180deg,#a855f7 0%,#7c3aed 52%,#5b21b6 100%);
  color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.35);
  box-shadow:0 0 20px rgba(168,85,247,.4),0 4px 14px rgba(0,0,0,.35);
}
.coc-btn-primary:hover{filter:brightness(1.08);box-shadow:0 0 26px rgba(168,85,247,.5);}
.coc-btn-primary:disabled{opacity:.45;cursor:not-allowed;filter:none;box-shadow:none;}
.coc-state-line{
  text-align:center;font-size:11px;color:var(--text-soft);margin-bottom:10px;min-height:14px;line-height:1.45;
}
.coc-state-line--info{color:#a5b4fc;}
.coc-state-line--success{color:#86efac;}
.coc-state-line--warn{color:#fcd34d;}
.coc-state-line--error{color:#fca5a5;}
.coc-btn-secondary{
  display:block;margin:0 auto;padding:5px 12px;font-size:11px;font-weight:750;
  border-radius:8px;cursor:pointer;border:1px solid rgba(100,90,120,.35);
  background:transparent;color:var(--text-soft);
}
.coc-btn-secondary:hover{border-color:rgba(167,139,250,.4);color:#e9d5ff;}
.coc-btn-secondary:disabled{opacity:.4;cursor:not-allowed;}
.coc-hidden{display:none !important;}
.coc-cards{display:flex;flex-direction:column;gap:10px;margin-bottom:10px;}
.coc-card{
  border:1px solid rgba(139,92,246,.28);
  border-radius:10px;
  padding:10px 12px;
  background:rgba(12,8,24,.55);
}
.coc-card.coc-tone-opt{border-color:rgba(74,222,128,.35);}
.coc-card.coc-tone-mismatch{border-color:rgba(252,211,77,.4);}
.coc-card.coc-tone-default{border-color:rgba(251,146,60,.25);}
.coc-card-header{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-bottom:8px;}
.coc-card-title{font-size:13px;font-weight:900;color:var(--text);flex:1;min-width:120px;line-height:1.3;}
.coc-card-sub{font-size:10px;color:var(--text-soft);width:100%;margin-top:-4px;}
.coc-card-metrics{display:grid;grid-template-columns:1fr 1fr;gap:4px 10px;margin-bottom:8px;font-size:11px;}
.coc-card-metric{display:flex;justify-content:space-between;gap:8px;}
.coc-card-actions{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:6px;width:100%;}
.coc-card-actions .coc-btn-rate{flex:1 1 calc(50% - 6px);min-width:100px;margin:0;}
.coc-card-actions-footer{display:flex;justify-content:center;width:100%;margin-top:4px;}
.coc-card-actions-footer .coc-btn-secondary{width:100%;max-width:100%;margin:0;text-align:center;}
.coc-card-state{font-size:11px;color:var(--text-soft);line-height:1.35;min-height:14px;}
.coc-empty-hint{font-size:12px;color:var(--text-soft);margin-bottom:10px;line-height:1.4;}
.conn-quick-desc{margin:8px 0 0;font-size:13px;color:var(--text-soft);line-height:1.5;}
.conn-profile-card{
  position:relative;
  transition:border-color .18s ease,box-shadow .18s ease,background .18s ease;
}
.conn-profile-card .conn-profile-badge{
  display:none;
  position:absolute;
  right:12px;
  top:10px;
  font-size:10px;
  font-weight:900;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:#fdf4ff;
  background:var(--grad-spectrum-h);
  border:1px solid var(--border-violet);
  border-radius:999px;
  padding:4px 8px;
  box-shadow:0 0 12px rgba(0,207,255,.35),0 0 16px rgba(255,79,216,.32);
}
.conn-profile-card.conn-profile-card--selected{
  box-shadow:var(--glow-mix-hover);
  background:#120f1d;
}
.cards > .conn-profile-card:nth-child(1).conn-profile-card--selected{
  border-color:#00D8FF !important;
  box-shadow:var(--glow-blue) !important;
}
.cards > .conn-profile-card:nth-child(2).conn-profile-card--selected{
  border-color:#FF3CCF !important;
  box-shadow:var(--glow-pink) !important;
}
.conn-profile-card.conn-profile-card--selected .conn-profile-badge{display:inline-block;}
.conn-profile-card.conn-profile-card--selected .conn-quick-desc{color:#e9e4f7;}
.tcp-card{margin-top:14px;}
#page-peripheral .neon-panel::before{display:none;}
.tcp-badge{
  display:inline-block;margin-top:8px;font-size:11px;font-weight:900;padding:6px 12px;border-radius:999px;
  background:rgba(45,38,20,.85);border:2px solid rgba(253,224,71,.45);color:#fef9c3;
  box-shadow:0 0 14px rgba(250,204,21,.15);
}
.tcp-badge.tcp-badge--ok{
  background:rgba(20,52,34,.85);border-color:rgba(74,222,128,.55);color:#d1fae5;
  box-shadow:0 0 14px rgba(34,197,94,.2);
}
.tcp-badge.tcp-badge--bad{
  background:rgba(58,34,18,.88);border-color:rgba(251,191,36,.55);color:#fde68a;
  box-shadow:0 0 14px rgba(245,158,11,.2);
}
.tcp-badge.tcp-badge--progress{
  background:linear-gradient(90deg,rgba(8,47,73,.88),rgba(46,16,52,.88));
  border-color:var(--border-violet);color:#ede9fe;
  box-shadow:0 0 12px rgba(0,207,255,.2),0 0 16px rgba(255,79,216,.18);
}
.tcp-badge.tcp-badge--warn{
  background:rgba(55,48,26,.92);border-color:rgba(250,204,21,.6);color:#fde68a;
  box-shadow:0 0 14px rgba(245,158,11,.18);
}
.nv-gaming-card{
  flex:1 1 240px;
  padding:18px 20px 16px;
  background:var(--bg-unified);
  border:2px solid #FF3CCF !important;
  box-shadow:var(--glow-pink) !important;
  position:relative;overflow:visible;z-index:0;
}
.nv-gaming-card:hover{box-shadow:var(--glow-pink) !important;}
.nv-gaming-card strong{color:var(--text);}
.nv-gaming-actions{
  margin-top:14px;
  flex-wrap:nowrap;
  gap:12px;
  align-items:stretch;
}
.nv-gaming-actions .btn-nv-gaming-main{
  flex:1 1 auto;
  min-width:0;
  margin-top:0;
  color:#f3e8ff !important;
  background:var(--grad-btn-primary) !important;
  border:1px solid rgba(255,122,232,.55) !important;
  font-weight:600;
}
.nv-gaming-actions .btn-nv-reset-panel{
  flex:0 0 auto;
  white-space:nowrap;
}
.nv-gaming-card .btn-nv-gaming-main:disabled,.nv-gaming-card .btn-nv-reset-panel:disabled{opacity:.65;}
.nv-gaming-steps .nv-step-ok{color:#4ade80;}
.nv-gaming-steps .nv-step-warn{color:#facc15;}
.nv-gaming-steps .nv-step-bad{color:#f87171;}
.nv-gaming-steps .nv-step-muted{color:#94a3b8;}
.nv-opt-progress-wrap{margin-top:12px;max-width:560px;display:none;}
.nv-opt-progress-bar{position:relative;height:22px;border-radius:999px;background:#0f0a1a;border:2px solid var(--border-violet);box-shadow:0 0 14px rgba(0,207,255,.22),0 0 20px rgba(255,79,216,.18),inset 0 2px 8px rgba(0,0,0,.45);overflow:hidden;}
.nv-opt-progress-fill{height:100%;width:0%;background:var(--grad-spectrum-bar);transition:width .35s ease;border-radius:999px;}
.nv-opt-progress-text{position:absolute;left:0;right:0;top:0;bottom:0;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#f5f3ff;text-shadow:0 1px 3px rgba(0,0,0,.85);pointer-events:none;}
.nv-opt-progress-step{margin-top:8px;font-size:12px;color:var(--neon-mid);line-height:1.4;}
.drivers-progress-wrap{margin-top:10px;max-width:100%;}
.nv-gaming-card-desc{display:block;margin:6px 0 0 0;padding-left:18px;font-size:12px;font-weight:600;line-height:1.45;color:#94a3b8;}
.drivers-workflow-guide{
  font-size:12px;font-weight:700;color:var(--neon-mid);margin:0 0 12px;padding:10px 12px;line-height:1.45;
  border-radius:8px;border:1px solid rgba(201,60,255,.55);
  background:linear-gradient(90deg,rgba(0,207,255,.1) 0%,rgba(201,60,255,.08) 50%,rgba(255,79,216,.12) 100%);
  box-shadow:0 0 14px rgba(0,207,255,.18),0 0 18px rgba(255,79,216,.16);
}
.nv-diag-overlay{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(8,6,18,.75);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;}
.nv-diag-modal{background:var(--panel,#1a1528);border:1px solid rgba(167,139,250,.35);border-radius:12px;padding:20px;max-width:720px;width:100%;max-height:90vh;overflow:auto;box-shadow:0 12px 40px rgba(0,0,0,.5);}
.nv-diag-diff-table{width:100%;border-collapse:collapse;font-size:11px;color:#ddd6fe;}
.nv-diag-diff-table th,.nv-diag-diff-table td{border:1px solid rgba(167,139,250,.2);padding:4px 6px;text-align:left;vertical-align:top;}
.nv-diag-diff-table th{background:rgba(167,139,250,.12);}
.gpu-clean-modal{
  display:none;position:fixed;inset:0;z-index:9999;background:rgba(6,4,12,.78);
  align-items:center;justify-content:center;padding:24px;
}
.gpu-clean-modal.gpu-clean-modal--open{display:flex;}
.gpu-clean-modal__box{
  max-width:460px;width:100%;padding:22px 24px;border-radius:14px;
  border:2px solid rgba(167,139,250,.55);
  background:linear-gradient(165deg,rgba(24,20,38,.98),rgba(10,10,14,.98));
  box-shadow:0 0 28px rgba(124,58,237,.35);
}
.gpu-clean-modal__msg{font-size:14px;line-height:1.55;color:#ede9fe;margin:0 0 18px;}
.gpu-clean-modal__actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-end;}
.gpu-clean-modal__hint{font-size:12px;color:#a5b4fc;margin:0 0 14px;line-height:1.45;}
/* Encart mise Ã  jour pilote NVIDIA (Drivers) */
.nv-driver-upd{
  margin-top:14px;padding:12px 14px 14px;border-radius:12px;
  border:2px solid rgba(140,200,255,.4);
  background-color:#0a0a0e;
  background-image:none;
  box-shadow:var(--shadow-center-split-inner);
  position:relative;overflow:visible;z-index:0;
}
.nv-driver-upd__head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;}
.nv-driver-upd__title{
  font-size:10px;font-weight:900;letter-spacing:.18em;text-transform:uppercase;color:#c4b5fd;
}
.nv-driver-upd__lines{font-size:13px;font-weight:750;line-height:1.55;color:#e8e4f4;}
.nv-driver-upd__lines div{margin:2px 0;}
.nv-driver-upd__status{
  margin-top:10px;font-size:14px;font-weight:900;letter-spacing:.02em;color:#f8fafc;
}
.nv-driver-upd__detail{
  margin-top:6px;font-size:11px;font-weight:650;line-height:1.45;color:#94a3b8;word-break:break-word;
  max-height:3.2em;overflow:hidden;
}
.nv-driver-upd--progress{border-color:var(--border-mix);box-shadow:0 0 18px rgba(0,207,255,.15),0 0 22px rgba(255,79,216,.15);}
.nv-driver-upd--ok{
  border-color:rgba(74,222,128,.55);
  box-shadow:0 0 20px rgba(34,197,94,.2),inset 0 0 0 1px rgba(74,222,128,.12);
}
.nv-driver-upd--ok .nv-driver-upd__status{color:#bbf7d0;}
.nv-driver-upd--ok #nvDriverStateLine{font-weight:900;color:#86efac;}
.nv-driver-upd--ok #nvDriverUpdateLatestLine{font-weight:900;color:#f8fafc;}
.nv-driver-upd--warn #nvDriverStateLine{font-weight:900;color:#fde68a;}
.nv-driver-upd--warn #nvDriverUpdateLatestLine{font-weight:900;color:#f8fafc;}
.nv-driver-upd--warn{
  border-color:rgba(250,204,21,.65);
  box-shadow:0 0 22px rgba(245,158,11,.22),inset 0 0 0 1px rgba(250,204,21,.1);
}
.nv-driver-upd--warn .nv-driver-upd__status{color:#fde68a;}
.nv-driver-upd--bad{
  border-color:rgba(248,113,113,.55);
  box-shadow:0 0 20px rgba(239,68,68,.18),inset 0 0 0 1px rgba(248,113,113,.1);
}
.nv-driver-upd--bad .nv-driver-upd__status{color:#fecaca;}
.nv-driver-upd--nogpu,.nv-driver-upd--neutral{
  border-color:rgba(100,116,139,.5);
  box-shadow:0 0 16px rgba(71,85,105,.15);
}
.nv-driver-upd--nogpu .nv-driver-upd__status,.nv-driver-upd--neutral .nv-driver-upd__status{color:#cbd5e1;}
.btn.nv-install-emphasis{
  border:2px solid rgba(250,204,21,.85) !important;
  box-shadow:0 0 20px rgba(250,204,21,.28),0 0 40px rgba(245,158,11,.12) !important;
  color:#fff7ed !important;
  background:linear-gradient(180deg,rgba(55,48,26,.95),rgba(30,26,14,.98)) !important;
}
.conn-admin-banner{
  margin-top:12px;padding:12px 16px;border-radius:12px;
  border:1px solid rgba(251,191,36,.45);
  background:linear-gradient(180deg,#2a2418,#1e1a12);color:#fde68a;font-size:13px;font-weight:750;
  box-shadow:0 0 20px rgba(251,191,36,.12),var(--glow-line);
}
.conn-admin-ok{
  margin-top:12px;padding:12px 14px;border-radius:14px;border:2px solid rgba(74,222,128,.5);
  background:linear-gradient(180deg,#14261c,#121e18);color:#bbf7d0;font-size:13px;font-weight:750;
  box-shadow:0 0 20px rgba(34,197,94,.15);
}
.usb-phys-list{margin-top:12px;}
.usb-phys-row{
  border-radius:12px;padding:14px 16px;margin:10px 0;
  border:2px solid rgba(255,60,207,.8);
  background:var(--bg-unified);
  box-shadow:var(--glow-pink);
}
.usb-phys-row .usb-title{margin-bottom:6px;}
.usb-phys-meta{font-size:13px;color:var(--text-soft);line-height:1.55;}
.usb-phys-count{font-size:12px;color:var(--neon);margin-top:8px;}

/*
 * LisibilitÃ© MSHTA / Trident : les custom properties pour "color" sont souvent ignorÃ©es,
 * ce qui laisse le texte en noir par dÃ©faut. Ce bloc impose des couleurs en hex (prioritÃ© finale).
 */
body,.app,.main,.content,.sidebar,.page,.page.active,
.neon-panel,.neon-inner,.card,.chip,.panel,.home-stat-card,.home-stat-body,.home-hero,
.gp-card,.usb-card,.usb-phys-row,.option-tile,.toolbar,.logs{
  color:#f4f4f8;
}
body,.app,.main,.content,.sidebar,.page,.page.active,
.neon-panel,.card,.chip,.panel,.home-stat-card,.home-stat-body,.home-hero,
.gp-card,.usb-card,.usb-phys-row,.option-tile,.logs,.progress{
  background-color:#0a0a0e;
}
.neon-inner{background-color:transparent;}
.btn,.btn.secondary{background-color:#0a0a0e;}
.btn,.btn.secondary{color:#f4f4f8;}
h2.page-title,.home-hero-title,.home-stat-title,.usb-title,.gp-card h3,.option-tile-title,
.card strong,.row .v,.home-stat-value,.home-stat-model,.home-stat-card--static .home-stat-model,
.tcp-hero-title{
  color:#ffffff;
}
p.lead,.brand p,.sidebar-foot,.kicker,.row .l,.nav-label,
.home-stat-hint,.home-stat-meta,.home-stat-model--sub,.home-hero-sub,
.conn-quick-desc,.usb-meta,.gp-line,.option-tile-desc,.chip .label,.card-desc,.tcp-hero-sub{
  color:#c9c5d8;
}
.home-stats-headline{color:#f8fafc;}
.home-hero-kicker{color:var(--neon-blue-bright);}
.panel h3{color:var(--neon-blue-bright);}
label{color:var(--neon-blue-bright);}
.navbtn{color:#e8e6f2;}
.navbtn.active{color:#ffffff;}
input,select{color:#f8fafc;background-color:#0a0a0e;}
.logs,.logline{color:#e8e4f4;}
.usb-meta code{color:var(--neon-pink);}
.home-stat-badge{
  color:#ffffff;
  text-shadow:0 1px 3px rgba(0,0,0,.45);
}
.btn-primary{color:#ffffff;}
.conn-admin-banner{color:#fef3c7;}
.conn-admin-ok{color:#d1fae5;}
.tcp-badge{color:#fef9c3;}
.badge-type{color:#f8fafc;}
.badge-ok{color:#d1fae5;}
.badge-err{color:#fce7f3;}
.badge-unk{color:#e2e8f0;}
.neon-panel code{color:#e9d5ff;}
.brand-logo-png,.brand-logo-png--hero{
  background-color:transparent !important;
  background-image:none !important;
  filter:none !important;
  -ms-filter:none !important;
}

/* MSHTA / Trident : bordures + glow explicites â€” slash diagonal centre (pas haut/bas) */
.cards > .card:nth-child(3n+1),
.cards > .card:nth-child(1):nth-last-child(1),
.grid3 > .chip:nth-child(3n+1),
.grid2 > .panel:nth-child(3n+1),
.grid2 > .panel:nth-child(1),
.gp-host > .gp-card:nth-child(3n+1),
.gp-host > .gp-card:nth-child(1),
.home-stats-grid .home-stat-card:nth-child(1),
#page-drivers .cards > .card:nth-child(1){
  border:2px solid #00D8FF !important;
  background-color:#0a0a0e !important;
  box-shadow:0 0 0 2px rgba(0,216,255,.88),0 0 22px rgba(0,207,255,.78),0 0 44px rgba(19,191,255,.55),0 0 68px rgba(0,207,255,.28),inset 0 0 32px rgba(0,207,255,.09) !important;
}
.home-stats-grid .home-stat-card:nth-child(2),
.cards > .card:nth-child(3n+2):not(:nth-child(2):nth-last-child(1)),
#page-drivers .cards > .card:nth-child(2),
#page-conn .neon-panel.tcp-card,
.neon-panel.tcp-card,
.grid3 > .chip:nth-child(3n+2):not(:nth-child(2):nth-last-child(1)),
.grid2 > .panel:nth-child(3n+2):not(:nth-child(2):nth-last-child(1)),
.gp-host > .gp-card:nth-child(3n+2),
.neon-panel,
.option-tile{
  border:2px solid rgba(184,168,255,.45) !important;
  background-color:#0a0a0e !important;
  background-image:none !important;
  box-shadow:inset 4px 0 0 0 #00D8FF,inset -4px 0 0 0 #FF3CCF,0 0 28px rgba(0,207,255,.92),0 0 28px rgba(255,79,216,.92),0 0 52px rgba(19,191,255,.55),0 0 52px rgba(255,63,207,.55) !important;
}
.cards > .card:nth-child(3n+2) .grid2 > .panel,
.cards > .card:nth-child(3n+2) .nv-driver-upd,
#page-drivers .cards > .card:nth-child(2) .grid2 > .panel,
#page-drivers .cards > .card:nth-child(2) .nv-driver-upd,
#page-drivers .cards > .card:nth-child(2) #nvDriverUpdatePanel,
#page-drivers .cards > .card:nth-child(2) #nvPresetPanel,
.nv-driver-upd{
  border:2px solid rgba(140,200,255,.4) !important;
  background-color:#0a0a0e !important;
  background-image:none !important;
  box-shadow:inset 3px 0 0 0 #00D8FF,inset -3px 0 0 0 #FF3CCF,0 0 18px rgba(0,207,255,.78),0 0 18px rgba(255,79,216,.78) !important;
}
.cards > .card:nth-child(3n),
.cards > .card:nth-child(3):nth-last-child(1),
.cards > .card:nth-child(2):nth-last-child(1),
.grid3 > .chip:nth-child(3n),
.grid3 > .chip:nth-child(2):nth-last-child(1),
.grid2 > .panel:nth-child(3n),
.grid2 > .panel:nth-child(2):nth-last-child(1),
.gp-host > .gp-card:nth-child(3n),
.gp-host > .gp-card:nth-child(2),
.home-stats-grid .home-stat-card:nth-child(3),
#page-drivers .cards > .card:nth-child(3),
.nv-gaming-card,.usb-card,.usb-phys-row{
