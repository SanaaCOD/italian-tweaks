}

function getFso() { return new ActiveXObject("Scripting.FileSystemObject"); }
function getShell() { return new ActiveXObject("WScript.Shell"); }

/** PowerShell 64 bits (vue registre native, pas WOW6432Node) pour les scripts systÃ¨me. */
function getPowerShell64Path() {
  try {
    var sh = getShell();
    var sysRoot = sh.ExpandEnvironmentStrings("%SystemRoot%");
    var fso = getFso();
    var pNative = sysRoot + "\\Sysnative\\WindowsPowerShell\\v1.0\\powershell.exe";
    if (fso.FileExists(pNative)) return pNative;
    var p32 = sysRoot + "\\System32\\WindowsPowerShell\\v1.0\\powershell.exe";
    if (fso.FileExists(p32)) return p32;
  } catch (ePs) {}
  return "powershell.exe";
}

/** Chemin du fichier HTA courant (rÃ©solution chemin disque). */
function getUnrealHtaPath() {
  try {
    var href = String(window.location.href || "");
    if (href.indexOf("file:") !== 0) return "";
    var path = href.replace(/^file:\/\/?/i, "");
    if (path.indexOf("///") === 0) path = path.substring(2);
    else if (path.indexOf("//") === 0) path = path.substring(1);
    path = unescape(path.replace(/\//g, "\\"));
    if (path.length >= 3 && path.charAt(0) === "\\" && path.charAt(2) === ":") path = path.substring(1);
    var fso = getFso();
    if (path && fso.FileExists(path)) return path;
    return "";
  } catch (eH) {
    return "";
  }
}

/** Dossier contenant Unreal.hta (chemin absolu disque). */
function getUnrealHtaDirectory() {
  var p = getUnrealHtaPath();
  if (!p) return "";
  try {
    return getFso().GetParentFolderName(p);
  } catch (eD) {
    return "";
  }
}

/** URL file:/// pour MSHTA (Ã©vite chargement relatif capricieux). */
function unrealFileUrlFromAbs(absPath) {
  if (!absPath) return "";
  var p = String(absPath).replace(/\\/g, "/");
  if (/^[A-Za-z]:\//.test(p)) return "file:///" + p.replace(/ /g, "%20");
  return "file://" + p.replace(/ /g, "%20");
}

function wireBrandLogoPng(img, svgId) {
  if (!img) return;
  var svg = $(svgId);
  function showPng() {
    try {
      img.style.display = "block";
      if (svg) svg.style.display = "none";
    } catch (e1) {}
  }
  function showSvg() {
    try {
      img.style.display = "none";
      if (svg) svg.style.display = "block";
    } catch (e2) {}
  }
  img.onload = function () {
    showPng();
  };
  img.onerror = function () {
    showSvg();
  };
  try {
    if (img.complete) {
      if (img.naturalWidth > 0) showPng();
      else showSvg();
    }
  } catch (eC) {}
}

/** Logo PNG : chemin absolu + affichage fiable (pas de filtre CSS sur img sous Trident). */
function initBrandLogoImages() {
  var navSvg = $("brandLogoSvgNav");
  var heroSvg = $("brandLogoSvgHero");
  var nav = $("brandLogoPngNav");
  var hero = $("brandLogoPngHero");
  try {
    if (nav) nav.style.display = "none";
    if (hero) hero.style.display = "none";
    if (navSvg) navSvg.style.display = "block";
    if (heroSvg) heroSvg.style.display = "block";
  } catch (eShow) {}
  wireBrandLogoPng(nav, "brandLogoSvgNav");
  wireBrandLogoPng(hero, "brandLogoSvgHero");
  var dir = getUnrealHtaDirectory();
  if (!dir) return;
  var abs = dir + "\\assets\\images\\unreal-logo.png";
  try {
    if (!getFso().FileExists(abs)) return;
  } catch (eF) {
    return;
  }
  var url = unrealFileUrlFromAbs(abs);
  if (nav) nav.src = url;
  if (hero) hero.src = url;
}

function createUnrealFolders() {
  var fso = getFso();
  var paths = [UNREAL_BASE, UNREAL_TOOLS, UNREAL_TCP_DIR, UNREAL_SCRIPTS, UNREAL_LOGS, UNREAL_BACKUPS];
  for (var i = 0; i < paths.length; i++) {
    try {
      if (!fso.FolderExists(paths[i])) fso.CreateFolder(paths[i]);
    } catch (e) {
      log("ERREUR dossier : " + paths[i] + " - " + e.message);
      log("Relance UNREAL en administrateur.");
      return false;
    }
  }
  return true;
}

function appendFileLogLine(text) {
  var fso = getFso();
  if (!fso.FolderExists(UNREAL_LOGS)) createUnrealFolders();
  var path = UNREAL_LOGS + "\\unreal.log";
  var ForAppending = 8;
  var t;
  if (!fso.FileExists(path)) { t = fso.CreateTextFile(path, true); t.WriteLine(text); t.Close(); return; }
  t = fso.OpenTextFile(path, ForAppending, true);
  t.WriteLine(text);
  t.Close();
}

/** Une ligne dans connection-profiles.log (horodatage court). */
function appendConnectionProfilesLog(message) {
  try {
    var fso = getFso();
    if (!fso.FolderExists(UNREAL_LOGS)) {
      if (!createUnrealFolders()) throw new Error("Logs");
    }
    var path = CONNECTION_PROFILES_LOG;
    var line = "[" + nowTime() + "] " + (message || "");
    var ForAppending = 8;
    var t;
    if (!fso.FileExists(path)) {
      t = fso.CreateTextFile(path, true);
      t.WriteLine(line);
      t.Close();
      return;
    }
    t = fso.OpenTextFile(path, ForAppending, true);
    t.WriteLine(line);
    t.Close();
  } catch (eCpl) {
    try {
      log("Profils rÃ©seau rapides : impossible d'Ã©crire connection-profiles.log - " + eCpl.message);
    } catch (e2) {}
  }
}

/**
 * Profils rÃ©seau rapides : Ã©crit Gaming.bat ou Download.bat puis lancement UAC (Shell.Application runas).
 * @param {"gaming"|"download"} kind
 */
function launchQuickNetProfile(kind) {
  setConnProfileSelection(kind);
  var isDownload = kind === "download";
  var label = isDownload ? "Profil Download" : "Profil Gaming";
  var fileName = isDownload ? "Download.bat" : "Gaming.bat";
  var content = isDownload ? BAT_PROFILE_DOWNLOAD : BAT_PROFILE_GAMING;
  var successAlert = isDownload ? "Profil Download lancÃ© en administrateur." : "Profil Gaming lancÃ© en administrateur.";
  var batPath = UNREAL_SCRIPTS + "\\" + fileName;
  var fso;
  appendConnectionProfilesLog("Clic : " + label);
  try {
    fso = getFso();
  } catch (eFso) {
    appendConnectionProfilesLog("Erreur inconnue : " + (eFso && eFso.message ? eFso.message : String(eFso)));
    log(label + " : erreur inconnue - " + (eFso && eFso.message ? eFso.message : ""));
    alert("Erreur inconnue : " + (eFso && eFso.message ? eFso.message : String(eFso)));
    return;
  }
  if (!createUnrealFolders()) {
    appendConnectionProfilesLog("Erreur : impossible de crÃ©er le dossier (ProgramData\\Unreal ou Scripts).");
    log(label + " : impossible de crÃ©er le dossier.");
    alert("Impossible de crÃ©er le dossier.");
    return;
  }
  appendConnectionProfilesLog("Dossier Scripts : OK (crÃ©Ã© ou dÃ©jÃ  existant).");
  try {
    if (!fso.FolderExists(UNREAL_SCRIPTS)) {
      appendConnectionProfilesLog("Erreur : dossier Scripts introuvable aprÃ¨s crÃ©ation.");
      alert("Impossible de crÃ©er le dossier.");
      return;
    }
  } catch (eChk) {
    appendConnectionProfilesLog("Erreur : accÃ¨s refusÃ© - " + eChk.message);
    log(label + " : accÃ¨s refusÃ© - " + eChk.message);
    alert("AccÃ¨s refusÃ©.");
    return;
  }
  try {
    var tw = fso.CreateTextFile(batPath, true);
    tw.Write(content);
    tw.Close();
  } catch (eWrite) {
    appendConnectionProfilesLog("Erreur : impossible d'Ã©crire le fichier BAT - " + eWrite.message);
    log(label + " : impossible d'Ã©crire le fichier BAT - " + eWrite.message);
    alert("Impossible d'Ã©crire le fichier BAT.");
    return;
  }
  appendConnectionProfilesLog("Fichier BAT crÃ©Ã© ou remplacÃ© : " + fileName);
  appendConnectionProfilesLog("Chemin du BAT : " + batPath);
  if (!fileExists(batPath)) {
    appendConnectionProfilesLog("Erreur : fichier BAT introuvable aprÃ¨s Ã©criture.");
    log(label + " : fichier BAT introuvable.");
    alert("Fichier BAT introuvable.");
    return;
  }
  var workDir = UNREAL_SCRIPTS;
  try {
    workDir = fso.GetParentFolderName(batPath);
  } catch (eWd) {}
  appendConnectionProfilesLog("Demande d'exÃ©cution administrateur (UAC) pour : " + batPath);
  try {
    var app = new ActiveXObject("Shell.Application");
    app.ShellExecute(batPath, "", workDir, "runas", 1);
  } catch (eRun) {
    var msg = (eRun && eRun.message) ? eRun.message : String(eRun);
    var low = msg.toLowerCase();
    if (low.indexOf("canceled") >= 0 || low.indexOf("cancelled") >= 0 || low.indexOf("annul") >= 0 || low.indexOf("1223") >= 0 || low.indexOf("denied") >= 0) {
      appendConnectionProfilesLog("Erreur : lancement admin refusÃ© - " + msg);
      log(label + " : lancement admin refusÃ©.");
      alert("Lancement admin refusÃ©.");
      return;
    }
    if (low.indexOf("accÃ¨s") >= 0 || low.indexOf("access") >= 0) {
      appendConnectionProfilesLog("Erreur : accÃ¨s refusÃ© - " + msg);
      alert("AccÃ¨s refusÃ©.");
      return;
    }
    appendConnectionProfilesLog("Erreur inconnue (Shell.Application) : " + msg);
    log(label + " : erreur inconnue - " + msg);
    alert("Erreur inconnue : " + msg);
    return;
  }
  appendConnectionProfilesLog("SuccÃ¨s : demande UAC envoyÃ©e pour " + fileName + " (exÃ©cution Ã©levÃ©e cÃ´tÃ© Windows).");
  log(successAlert);
  appendConnectionProfilesLog(successAlert);
  alert(successAlert);
}

function appendWarzoneLog(message) {
  var box = $("warzoneLogBox");
  if (!box) return;
  var line = document.createElement("div");
  line.className = "logline";
  line.textContent = "[" + nowTime() + "] " + message;
  box.insertBefore(line, box.firstChild);
  while (box.childNodes.length > 240) box.removeChild(box.lastChild);
}

function expandEnvPath(token) {
  try {
    var v = getShell().ExpandEnvironmentStrings(String(token || ""));
    if (v && v.indexOf("%") < 0) return v;
  } catch (e0) {}
  return "";
}

function getWarzoneSearchPlayerDirs() {
  var dirs = [];
  var seen = {};
  function addDir(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d]) return;
    seen[d] = true;
    dirs.push(d);
  }
  var local = expandEnvPath("%LOCALAPPDATA%");
  var profile = expandEnvPath("%USERPROFILE%");
  if (local) {
    addDir(local + "\\Activision\\Call of Duty\\players");
    addDir(local + "\\Activision\\Call of Duty");
  }
  if (profile) {
    addDir(profile + "\\Documents\\Call of Duty\\players");
    addDir(profile + "\\Documents\\Call of Duty");
  }
  try {
    var fso = getFso();
    var usersRoot = "C:\\Users";
    if (fso.FolderExists(usersRoot)) {
      var ef = new Enumerator(fso.GetFolder(usersRoot).SubFolders);
      for (; !ef.atEnd(); ef.moveNext()) {
        var sub = ef.item();
        var un = String(sub.Name || "");
        if (/^(Public|Default|Default User|All Users|DefaultAppPool)$/i.test(un)) continue;
        var up = String(sub.Path || "");
        addDir(up + "\\AppData\\Local\\Activision\\Call of Duty\\players");
        addDir(up + "\\Documents\\Call of Duty\\players");
      }
    }
  } catch (eU) {}
  return dirs;
}

function getWarzoneAutoPlayersDir() {
  var found = findWarzonePlayerDirWithTargetFiles(false);
  if (found) return found;
  var dirs = getWarzoneSearchPlayerDirs();
  var fso = getFso();
  var i;
  for (i = 0; i < dirs.length; i++) {
    if (dirs[i] && fso.FolderExists(dirs[i])) return dirs[i];
  }
  if (dirs.length) return dirs[0];
  return "";
}

function getWarzoneEmbeddedFilePath(fileName) {
  var dir = getUnrealHtaDirectory();
  if (!dir) return "";
  var names = [
    dir + "\\assets\\warzone\\" + fileName,
    dir + "\\assets\\Warzone\\" + fileName
  ];
  var fso = getFso();
  var i;
  for (i = 0; i < names.length; i++) {
    if (fso.FileExists(names[i])) return getAbsolutePathFs(names[i]);
  }
  return names[0];
}

function warzoneStatePath() {
  return UNREAL_BASE + "\\warzone-state.json";
}

function readWarzoneState() {
  try {
    var p = warzoneStatePath();
    if (!getFso().FileExists(p)) return null;
    return JSON.parse(readTextFileAll(p));
  } catch (eR) {
    return null;
  }
}

function writeWarzoneState(obj) {
  try {
    createUnrealFolders();
    var prev = readWarzoneState() || {};
    var k;
    for (k in obj) {
      if (obj.hasOwnProperty(k)) prev[k] = obj[k];
    }
    var w = getFso().CreateTextFile(warzoneStatePath(), true);
    w.Write(JSON.stringify(prev));
    w.Close();
  } catch (eW) {}
}

function findWarzonePlayerDirWithTargetFiles(requireMatchEmbedded) {
  var fso = getFso();
  var dirs = getWarzoneSearchPlayerDirs();
  var i, j;
  for (i = 0; i < dirs.length; i++) {
    var base = dirs[i];
    if (!base || !fso.FolderExists(base)) continue;
    var allPresent = true;
    var allMatch = true;
    for (j = 0; j < WARZONE_FILE_NAMES.length; j++) {
      var name = WARZONE_FILE_NAMES[j];
      var dst = base + "\\" + name;
      var src = getWarzoneEmbeddedFilePath(name);
      if (!fso.FileExists(dst)) {
        allPresent = false;
        allMatch = false;
        break;
      }
      if (requireMatchEmbedded) {
        if (!src || !fso.FileExists(src)) {
          allMatch = false;
          break;
        }
        if (!areFilesExactlyIdentical(src, dst)) {
          allMatch = false;
        }
      }
    }
    if (allMatch) return base;
    if (!requireMatchEmbedded && allPresent) return base;
  }
  return "";
}

function warzoneFilesPresentAtDir(baseFolder) {
  if (!baseFolder) return false;
  var fso = getFso();
  if (!fso.FolderExists(baseFolder)) return false;
  var i;
  for (i = 0; i < WARZONE_FILE_NAMES.length; i++) {
    if (!fso.FileExists(baseFolder + "\\" + WARZONE_FILE_NAMES[i])) return false;
  }
  return true;
}

function warzoneDirMatchesEmbedded(baseFolder) {
  if (!warzoneFilesPresentAtDir(baseFolder)) return false;
  var fso = getFso();
  var i;
  for (i = 0; i < WARZONE_FILE_NAMES.length; i++) {
    var name = WARZONE_FILE_NAMES[i];
    var src = getWarzoneEmbeddedFilePath(name);
    var dst = baseFolder + "\\" + name;
    if (!src || !fso.FileExists(src) || !fso.FileExists(dst)) return false;
    if (!areFilesExactlyIdentical(src, dst)) return false;
  }
  return true;
}

function resolveWarzoneInstallTargetDir() {
  var matched = findWarzonePlayerDirWithTargetFiles(true);
  if (matched) return matched;
  var fso = getFso();
  var dirs = getWarzoneSearchPlayerDirs();
  var i;
  for (i = 0; i < dirs.length; i++) {
    if (dirs[i] && fso.FolderExists(dirs[i])) return dirs[i];
  }
  var local = expandEnvPath("%LOCALAPPDATA%");
  if (local) return local + "\\Activision\\Call of Duty\\players";
  return "";
}

function readFileBase64(path) {
  try {
    var fso = getFso();
    if (!fso.FileExists(path)) return "";
    var stream = new ActiveXObject("ADODB.Stream");
    stream.Type = 1;
    stream.Open();
    stream.LoadFromFile(path);
    var bytes = stream.Read();
    stream.Close();
    var xml = new ActiveXObject("MSXML2.DOMDocument");
    var node = xml.createElement("b64");
    node.dataType = "bin.base64";
    node.nodeTypedValue = bytes;
    return String(node.text || "").replace(/\s+/g, "");
  } catch (eB) {
    return "";
  }
}

function areFilesExactlyIdentical(pathA, pathB) {
  var a = readFileBase64(pathA);
  var b = readFileBase64(pathB);
  if (!a || !b) return false;
  return a === b;
}

function setWarzoneInstallStatus(isInstalled, label) {
  var el = $("warzoneInstallStatus");
  if (!el) return;
  if (isInstalled) {
    el.className = "tcp-badge tcp-badge--ok";
    el.innerText = label || "Fichiers Warzone installÃ©s";
  } else {
    el.className = "tcp-badge tcp-badge--bad";
    el.innerText = label || "Fichiers Warzone non dÃ©tectÃ©s";
  }
}

function verifyWarzoneInstallation(logDetails) {
  var matchedDir = findWarzonePlayerDirWithTargetFiles(true);
  if (matchedDir) {
    var prevSt = readWarzoneState();
    var mode = (prevSt && prevSt.profileActive) ? "profile" : "files";
    if (logDetails) {
      appendWarzoneLog((mode === "profile" ? "Profil Warzone actif" : "Fichiers Warzone installÃ©s") + " : " + matchedDir);
    }
    writeWarzoneState({
      installed: true,
      profileActive: mode === "profile",
      playersDir: matchedDir,
      checkedAt: nowDateTimeFr()
    });
    return { ok: true, dir: matchedDir, mode: mode };
  }
  var st = readWarzoneState();
  if (st && st.playersDir && warzoneDirMatchesEmbedded(st.playersDir)) {
    if (logDetails) appendWarzoneLog("Ã©tat persistant validÃ© : " + st.playersDir);
    return { ok: true, dir: st.playersDir, mode: st.profileActive ? "profile" : "files" };
  }
  if (logDetails) {
    appendWarzoneLog("Fichiers Warzone non dÃ©tectÃ©s.");
    appendWarzoneLog("Chemins testÃ©s : " + getWarzoneSearchPlayerDirs().join(" | "));
  }
  writeWarzoneState({ installed: false, profileActive: false, playersDir: "", checkedAt: nowDateTimeFr() });
  return { ok: false, dir: "", mode: "" };
}

function refreshWarzoneInstallStatus(logDetails) {
  var res = { ok: false, dir: "", mode: "" };
  try {
    res = verifyWarzoneInstallation(!!logDetails);
  } catch (eV) {
    if (logDetails) appendWarzoneLog("Erreur dÃ©tection : " + String(eV.message || eV));
    res = { ok: false, dir: "", mode: "" };
  }
  if (res.ok) {
    if (res.mode === "profile") setWarzoneInstallStatus(true, "Profil Warzone actif");
    else setWarzoneInstallStatus(true, "Fichiers Warzone installÃ©s");
  } else {
    setWarzoneInstallStatus(false, "Fichiers Warzone non dÃ©tectÃ©s");
  }
  return res.ok;
}

function installWarzoneFiles() {
  var fso = getFso();
  var i;
  var baseFolder = resolveWarzoneInstallTargetDir();
  appendWarzoneLog("Chemin analysÃ© : " + baseFolder);
  if (!baseFolder) {
    appendWarzoneLog("Erreur : impossible de dÃ©terminÃ©er le dossier players Warzone.");
    alert("Dossier Warzone introuvable. Lance une fois Warzone, puis rÃ©essaie.");
    return;
  }
  if (!fso.FolderExists(baseFolder)) {
    if (!createFolder(baseFolder)) {
      appendWarzoneLog("Erreur : crÃ©ation du dossier impossible : " + baseFolder);
      alert("Impossible de crÃ©er le dossier Warzone : " + baseFolder);
      return;
    }
    appendWarzoneLog("Dossier crÃ©Ã© : " + baseFolder);
  }
  var src = {};
  for (i = 0; i < WARZONE_FILE_NAMES.length; i++) {
    var n = WARZONE_FILE_NAMES[i];
    var p = getWarzoneEmbeddedFilePath(n);
    if (p && fso.FileExists(p)) {
      src[n] = p;
      continue;
    }
    appendWarzoneLog("Fichier source introuvable : " + n);
    alert("Fichier source introuvable : " + n + "\nAjoute-le dans assets\\warzone.");
    setWarzoneInstallStatus(false);
    return;
  }
  for (i = 0; i < WARZONE_FILE_NAMES.length; i++) {
    var name = WARZONE_FILE_NAMES[i];
    var tp = baseFolder + "\\" + name;
    var bak = tp + ".bak";
    try {
      if (fso.FileExists(tp)) {
        fso.CopyFile(tp, bak, true);
        appendWarzoneLog("Fichier sauvegardÃ© : " + bak);
      }
      fso.CopyFile(src[name], tp, true);
      if (fso.FileExists(bak)) appendWarzoneLog("Fichier remplacÃ© : " + tp);
      else appendWarzoneLog("Fichier copiÃ© : " + tp);
    } catch (eWz) {
      appendWarzoneLog("Erreur fichier (" + tp + ") : " + eWz.message);
    }
  }
  writeWarzoneState({ installed: true, profileActive: true, playersDir: baseFolder, checkedAt: nowDateTimeFr() });
  var installed = refreshWarzoneInstallStatus(true);
  if (installed) {
    appendWarzoneLog("Installation terminÃ©e.");
    alert("Installation Warzone terminÃ©e.");
  } else {
    appendWarzoneLog("Erreur : installation incomplÃ¨te.");
    alert("Erreur : l'installation Warzone n'a pas pu Ãªtre validÃ©e.");
  }
}

function setConnProfileSelection(kind) {
  connSelectedProfile = (kind === "download") ? "download" : "gaming";
  syncConnProfileSelectionUi();
}

function syncConnProfileSelectionUi() {
  var gaming = $("connProfileGaming");
  var download = $("connProfileDownload");
  if (!gaming || !download) return;
  var gamingSelected = connSelectedProfile === "gaming";
  gaming.className = "card conn-profile-card" + (gamingSelected ? " conn-profile-card--selected" : "");
  download.className = "card conn-profile-card" + (!gamingSelected ? " conn-profile-card--selected" : "");
}

function downloadFile(url, destination) {
  if (!url) throw new Error("URL invalide.");
  var xhr = new ActiveXObject("MSXML2.XMLHTTP");
  xhr.open("GET", url, false);
  xhr.send();
  if (xhr.status !== 200) throw new Error("HTTP " + xhr.status);
  try { downloadFile.lastContentType = String(xhr.getResponseHeader("Content-Type") || ""); } catch (eCT) { downloadFile.lastContentType = ""; }
  var stream = new ActiveXObject("ADODB.Stream");
  stream.Type = 1;
  stream.Open();
  stream.Write(xhr.responseBody);
  stream.SaveToFile(destination, 2);
  stream.Close();
}

function readTextFileAll(path) {
  try {
    var fso = getFso();
    if (!fso.FileExists(path)) return "";
    var t = fso.OpenTextFile(path, 1, false, 0);
    var s = t.ReadAll();
    t.Close();
    if (s.length && s.charCodeAt(0) === 0xFEFF) {
      s = s.substring(1);
    }
    if (s.length >= 3 && s.charCodeAt(0) === 0xEF && s.charCodeAt(1) === 0xBB && s.charCodeAt(2) === 0xBF) {
      s = s.substring(3);
    }
    return s;
  } catch (exR) {
    return "";
  }
}

function readUtf8TextFileAll(path) {
  try {
    var fso = getFso();
    if (!fso.FileExists(path)) return "";
    var stream = new ActiveXObject("ADODB.Stream");
    stream.Type = 2;
    stream.Charset = "utf-8";
    stream.Open();
    stream.LoadFromFile(path);
    var s = stream.ReadText(-1);
    stream.Close();
    if (s.length && s.charCodeAt(0) === 0xFEFF) s = s.substring(1);
    return s;
  } catch (exUtf8) {
    return readTextFileAll(path);
  }
}

function writeUtf8TextFileAll(path, text) {
  var stream = new ActiveXObject("ADODB.Stream");
  stream.Type = 2;
  stream.Charset = "utf-8";
  stream.Open();
  stream.WriteText(String(text || ""));
  stream.SaveToFile(path, 2);
  stream.Close();
}

function fixUtf8Mojibake(str) {
  if (!str || str.indexOf("Ãƒ") < 0) return str;
  try {
    var encoded = "";
    var i;
    for (i = 0; i < str.length; i++) {
      encoded += "%" + ("0" + str.charCodeAt(i).toString(16)).slice(-2);
    }
    return decodeURIComponent(encoded);
  } catch (eFix) {
    return str;
  }
}

function launchFileAsAdmin(path) {
  var shellApp = new ActiveXObject("Shell.Application");
  var fso = getFso();
  var workDir = "";
  try {
    workDir = fso.GetParentFolderName(path);
  } catch (e0) {
    workDir = "";
  }
  shellApp.ShellExecute(path, "", workDir, "runas", 1);
}

/** Lance un exÃ©cutable avec arguments (UAC si nÃ©cessaire). */
function launchFileAsAdminWithArgs(path, args) {
  var shellApp = new ActiveXObject("Shell.Application");
  var fso = getFso();
  var workDir = "";
  try {
    workDir = fso.GetParentFolderName(path);
  } catch (e0) {
    workDir = "";
  }
  shellApp.ShellExecute(path, args || "", workDir, "runas", 1);
}

function parseUnrealCommandLineArgs() {
  var out = { autoDduClean: false, baseDir: "", dduPath: "" };
  try {
    if (typeof WScript === "undefined" || !WScript.Arguments) return out;
    var a = WScript.Arguments;
    var n = a.length || 0;
    var i;
    for (i = 0; i < n; i++) {
      var part = String(a.Item ? a.Item(i) : a(i));
      if (/--auto-ddu-clean/i.test(part) || /--auto-gpu-clean/i.test(part)) out.autoDduClean = true;
      if (/^--base-dir$/i.test(part) && i + 1 < n) {
        out.baseDir = getAbsolutePathFs(String(a.Item ? a.Item(i + 1) : a(i + 1)));
        i++;
      } else if (/^--base-dir=(.+)$/i.test(part)) {
        out.baseDir = getAbsolutePathFs(part.replace(/^--base-dir=/i, "").replace(/^\"|\"$/g, ""));
      }
      if (/^--ddu-path$/i.test(part) && i + 1 < n) {
        out.dduPath = getAbsolutePathFs(String(a.Item ? a.Item(i + 1) : a(i + 1)));
        i++;
      } else if (/^--ddu-path=(.+)$/i.test(part)) {
        out.dduPath = getAbsolutePathFs(part.replace(/^--ddu-path=/i, "").replace(/^\"|\"$/g, ""));
      }
    }
  } catch (eA) {}
  return out;
}

function getPersistedApplicationBaseDirectoryPath() {
  return UNREAL_BASE + "\\app-base-directory.txt";
}

function readPersistedApplicationBaseDirectory() {
  try {
    var p = getPersistedApplicationBaseDirectoryPath();
    var txt = readTextFileAll(p);
    if (!txt) return "";
    return getAbsolutePathFs(String(txt).replace(/^\s+|\s+$/g, ""));
  } catch (eR) {
    return "";
  }
}

function persistApplicationBaseDirectory(base) {
  if (!base) return;
  try {
    createUnrealFolders();
    var tw = getFso().CreateTextFile(getPersistedApplicationBaseDirectoryPath(), true);
    tw.Write(String(base));
    tw.Close();
  } catch (eW) {}
}

function getWindowsCurrentDirectory() {
  try {
    return getAbsolutePathFs(String(getShell().CurrentDirectory || ""));
  } catch (eC) {
    return "";
  }
}

function directoryContainsUnrealHta(dir) {
  if (!dir) return false;
  try {
    return getFso().FileExists(getAbsolutePathFs(dir) + "\\Unreal.hta");
  } catch (eH) {
    return false;
  }
}

function initApplicationBaseDirectory() {
  if (APP_BASE_DIRECTORY) return APP_BASE_DIRECTORY;
  var fso = getFso();
  var cmd = parseUnrealCommandLineArgs();
  var candidates = [];
  var i;
  function trySet(p, reason) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || !fso.FolderExists(d)) return false;
    APP_BASE_DIRECTORY = d;
    persistApplicationBaseDirectory(d);
    return true;
  }
  if (cmd.baseDir) candidates.push({ path: cmd.baseDir, reason: "--base-dir" });
  var persisted = readPersistedApplicationBaseDirectory();
  if (persisted) candidates.push({ path: persisted, reason: "persistÃ© ProgramData" });
  var htaDir = getUnrealHtaDirectory();
  if (htaDir) candidates.push({ path: htaDir, reason: "Unreal.hta" });
  try {
    var pathname = unescape(String(window.location.pathname || "").replace(/\//g, "\\"));
    if (pathname.length >= 3 && pathname.charAt(0) === "\\" && pathname.charAt(2) === ":") pathname = pathname.substring(1);
    if (pathname.length >= 2 && pathname.charAt(1) === ":") {
      candidates.push({ path: fso.GetParentFolderName(pathname), reason: "window.location" });
    }
  } catch (ePath) {}
  try {
    var envBase = getShell().ExpandEnvironmentStrings("%UNREAL_APP_BASE%");
    if (envBase && envBase.indexOf("%") < 0) candidates.push({ path: envBase, reason: "env UNREAL_APP_BASE" });
  } catch (eEnv) {}
  var cwd = getWindowsCurrentDirectory();
  if (cwd && directoryContainsUnrealHta(cwd)) candidates.push({ path: cwd, reason: "CurrentDirectory+Unreal.hta" });
  for (i = 0; i < candidates.length; i++) {
    if (trySet(candidates[i].path, candidates[i].reason)) return APP_BASE_DIRECTORY;
  }
  return "";
}

function getApplicationBaseRoots() {
  var fso = getFso();
  var list = [];
  var seen = {};
  function add(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d] || !fso.FolderExists(d)) return;
    seen[d] = true;
    list.push(d);
  }
  var cmd = parseUnrealCommandLineArgs();
  if (cmd.baseDir) add(cmd.baseDir);
  add(readPersistedApplicationBaseDirectory());
  add(getApplicationBaseDirectory());
  var hta = getUnrealHtaPath();
  if (hta) add(fso.GetParentFolderName(hta));
  var names = ["Unreal.exe", "UnrealLauncher.exe", "UNREAL.exe"];
  var basesToScan = list.slice();
  var bi, ni, lp;
  for (bi = 0; bi < basesToScan.length; bi++) {
    for (ni = 0; ni < names.length; ni++) {
      lp = basesToScan[bi] + "\\" + names[ni];
      if (fso.FileExists(lp)) add(fso.GetParentFolderName(lp));
    }
  }
  var cwd = getWindowsCurrentDirectory();
  if (cwd) add(cwd);
  var expanded = list.slice();
  for (bi = 0; bi < expanded.length; bi++) {
    try {
      var par = fso.GetParentFolderName(expanded[bi]);
      if (par) add(par);
    } catch (ePar) {}
  }
  return list;
}

function getApplicationBaseDirectory() {
  if (!APP_BASE_DIRECTORY) initApplicationBaseDirectory();
  return APP_BASE_DIRECTORY || "";
}

/** Dossier de l'application (stable, mÃªme aprÃ¨s relance admin). */
function getAppFolderFromHta() {
  var base = getApplicationBaseDirectory();
  if (base) return base;
  try {
    var pathname = unescape(String(window.location.pathname || "").replace(/\//g, "\\"));
    if (pathname.length >= 3 && pathname.charAt(0) === "\\" && pathname.charAt(2) === ":") pathname = pathname.substring(1);
    if (pathname.length >= 2 && pathname.charAt(1) === ":") {
      return getFso().GetParentFolderName(pathname);
    }
  } catch (e1) {}
  return "";
}

/** Dossier outil : [Unreal.hta]\\tools\\NVCleanstall\\  â€” repli %LOCALAPPDATA%\\Unreal\\Tools\\NVCleanstall */
function getNvcleanstallToolsDir() {
  var app = getAppFolderFromHta();
  if (app) return app + "\\tools\\NVCleanstall";
  var loc = getLocalUnrealDir();
  if (loc) return loc + "\\Tools\\NVCleanstall";
  return "";
}

function setNvcleanstallOpenStatus(text, kind) {
  var el = $("nvcleanstallOpenStatus");
  if (!el) return;
  if (!text) {
    el.style.display = "none";
    el.innerText = "";
    return;
  }
  el.style.display = "";
  el.innerText = text;
  var cls = "tcp-badge";
  if (kind === "ok") cls += " tcp-badge--ok";
  else if (kind === "progress") cls += " tcp-badge--progress";
  else cls += " tcp-badge--bad";
  el.className = cls;
}

function openNvcleanstallOfficialDownloadPage() {
  try {
    var sh = new ActiveXObject("Shell.Application");
    sh.ShellExecute(NVCLEANSTALL_OFFICIAL_DOWNLOAD_PAGE, "", "", "open", 1);
  } catch (e1) {
    try {
      getShell().Run("cmd /c start \"\" \"" + NVCLEANSTALL_OFFICIAL_DOWNLOAD_PAGE + "\"", 1, false);
    } catch (e2) {}
  }
}

/** TÃ©lÃ©chargement binaire avec User-Agent (certains CDN refusent les clients sans en-tÃªte). */
function nvcleanstallDownloadToFile(url, destination) {
  if (!url) throw new Error("URL invalide.");
  var xhr = new ActiveXObject("MSXML2.XMLHTTP");
  xhr.open("GET", url, false);
  try {
    xhr.setRequestHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36");
  } catch (eUa) {}
  try {
    xhr.setRequestHeader("Accept", "*/*");
  } catch (eAc) {}
  xhr.send();
  if (xhr.status !== 200) throw new Error("HTTP " + xhr.status);
  var stream = new ActiveXObject("ADODB.Stream");
  stream.Type = 1;
  stream.Open();
  stream.Write(xhr.responseBody);
  stream.SaveToFile(destination, 2);
  stream.Close();
}

/** Liste tous les .exe du dossier (non rÃ©cursif). */
function listAllExeFilesFlat(folderDir) {
  var out = [];
  var fso = getFso();
  if (!folderDir || !fso.FolderExists(folderDir)) return out;
  try {
    var folder = fso.GetFolder(folderDir);
    var ef = new Enumerator(folder.Files);
    for (; !ef.atEnd(); ef.moveNext()) {
      var file = ef.item();
      var name = String(file.Name || "");
      if (/\.exe$/i.test(name)) out.push(file);
    }
  } catch (eList) {}
  return out;
}

function combinePath(base, rel) {
  var b = String(base || "").replace(/[\\\/]+$/, "");
  var r = String(rel || "").replace(/^[\\\/]+/, "");
  if (!b) return r;
  if (!r) return b;
  return b + "\\" + r;
}

function getAbsolutePathFs(path) {
  var p = String(path || "").replace(/^\s+|\s+$/g, "");
  if (!p) return "";
  if (/^empty$/i.test(p)) return "";
  try {
    var fso = getFso();
    if (p.length >= 2 && p.charAt(1) === ":") {
      return fso.GetAbsolutePathName(p);
    }
    var appBase = getApplicationBaseDirectory();
    if (appBase) {
      return fso.GetAbsolutePathName(combinePath(appBase, p));
    }
    var abs = fso.GetAbsolutePathName(p);
    if (!abs || /^empty$/i.test(abs)) return "";
    return abs;
  } catch (eAbs) {
    if (p.length >= 2 && p.charAt(1) === ":") return p;
    return "";
  }
}

/**
 * Score heuristique pour deviner quel .exe est NVCleanstall (noms variables / fautes).
 */
function scoreNvcleanstallExeName(fileName) {
  var raw = String(fileName || "").toLowerCase();
  var compact = raw.replace(/[\s\-_]/g, "").replace(/\.exe$/i, "");
  if (raw.indexOf("nvcleanstall") >= 0 || compact.indexOf("nvcleanstall") >= 0) return 100;
  var s = 0;
  if (compact.indexOf("cleanstall") >= 0) s = Math.max(s, 92);
  if (compact.indexOf("nvclean") >= 0) s = Math.max(s, 88);
  if (compact.indexOf("nvdcleaninstall") >= 0 || compact.indexOf("nvcleaninstall") >= 0) s = Math.max(s, 86);
  if (compact === "nvc" || /^nvc\.exe$/i.test(raw)) s = Math.max(s, 80);
  if (compact.indexOf("nvc") === 0 || /^nvc/i.test(compact)) s = Math.max(s, 72);
  if (compact.indexOf("nvidia") >= 0) s = Math.max(s, 65);
  return s;
}

/**
 * DÃ©tecte un fichier texte/HTML renommÃ© en .exe (lecture binaire, pas d'interprÃ©tation UTF-8).
 * N'exige pas l'en-tÃªte PE/MZ : si Windows peut lancer l'exe au double-clic, on ne bloque pas.
 */
function fileLooksLikeAsciiHtmlSavedAsExe(path) {
  try {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type = 1;
    st.Open();
    st.LoadFromFile(path);
    var max = 256;
    var sz = st.Size;
    if (typeof sz === "number" && sz >= 0 && sz < max) max = sz;
    var bin = st.Read(max);
    st.Close();
    var bytes = [];
    var i;
    for (i = 0; i < bin.length; i++) bytes.push(bin.charCodeAt(i) & 255);
    var start = 0;
    if (bytes.length >= 3 && bytes[0] === 239 && bytes[1] === 187 && bytes[2] === 191) start = 3;
    while (start < bytes.length && (bytes[start] === 9 || bytes[start] === 10 || bytes[start] === 13 || bytes[start] === 32)) start++;
    if (start >= bytes.length || bytes[start] !== 60) return false;
    var ascii = "";
    for (i = start; i < bytes.length && ascii.length < 64; i++) {
      var b = bytes[i];
      if (b >= 32 && b < 127) ascii += String.fromCharCode(b);
      else break;
    }
    var up = ascii.toUpperCase();
    if (up.indexOf("<!DOCTYPE") === 0) return true;
    if (up.indexOf("<!DOC") === 0) return true;
    if (up.indexOf("<HTML") === 0) return true;
    if (up.indexOf("<HEAD") === 0) return true;
    if (up.indexOf("<SCRIPT") === 0) return true;
    return false;
  } catch (eHtml) {
    return false;
  }
}

/**
 * Candidat pour ShellExecute runas : fichier prÃ©sent, extension .exe, taille > 0,
 * pas un HTML Ã©vident  â€” sans test PE/MZ strict.
 */
function isLaunchableExeFile(path) {
  try {
    var fso = getFso();
    if (!path || !fso.FileExists(path)) return false;
    if (!/\.exe$/i.test(String(path))) return false;
    var sf = fso.GetFile(path);
    if (!sf || sf.Size <= 0) return false;
    if (fileLooksLikeAsciiHtmlSavedAsExe(path)) return false;
    return true;
  } catch (eL) {
    return false;
  }
}

function tryMigrateLegacyNvcleanstallFolder(targetDir) {
  var app = getAppFolderFromHta();
  if (!app) return;
  var legacy = app + "\\tools\\NVCleanInstall";
  var fso = getFso();
  if (!fso.FolderExists(legacy)) return;
  var files = listAllExeFilesFlat(legacy);
  if (!files.length) return;
  var scored = [];
  var i;
  for (i = 0; i < files.length; i++) {
    scored.push({ file: files[i], score: scoreNvcleanstallExeName(String(files[i].Name || "")) });
  }
  scored.sort(function (a, b) {
    return b.score - a.score;
  });
  var src = getAbsolutePathFs(String(scored[0].file.Path || ""));
  if (!isLaunchableExeFile(src)) return;
  try {
    var dest = getAbsolutePathFs(targetDir + "\\NVCleanstall.exe");
    fso.CopyFile(src, dest, true);
    appendNvMediaLog("Migration : copie depuis l'ancien dossier tools\\NVCleanInstall vers " + dest);
  } catch (eM) {}
}

function getNvidiaDriverCacheDir() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  return app + "\\tools\\NvidiaDriverCache";
}

/** Journal technique uniquement (console fichier via log)  â€” plus d'affichage horodatÃ© dans l'UI. */
function appendNvMediaLog(message) {
  try {
    log("[NV mÃ©dia] " + String(message || ""));
  } catch (e0) {}
}

var driversWorkflowState = {
  dduPct: 0, dduDone: false, dduError: false,
  installPct: 0, installDone: false, installError: false,
  optPct: 0, optDone: false, optError: false
};

function updateDriversWorkflowGuide() {
  var el = $("driversWorkflowGuide");
  if (!el) return;
  var s = driversWorkflowState;
  if (s.optDone && s.optPct >= 100) {
    el.innerText = "Optimisation NVIDIA terminÃ©e";
    return;
  }
  if (s.installDone && s.installPct >= 100) {
    el.innerText = "Ã‰tape 3 : lancer l'optimisation NVIDIA (installation du pilote terminÃ©e)";
    return;
  }
  if (s.dduDone && s.dduPct >= 100) {
    el.innerText = "Ã‰tape 2 : installer le nouveau pilote graphique (nettoyage GPU terminÃ©)";
    return;
  }
  el.innerText = "Ã‰tape 1 : nettoyer le pilote GPU";
}

function setDriversProgressBar(wrapId, fillId, textId, stepId, pct, stepLabel) {
  var wrap = $(wrapId);
  var fill = $(fillId);
  var text = $(textId);
  var step = $(stepId);
  if (!wrap) return;
  if (pct === -1 || pct === null || typeof pct === "undefined") {
    wrap.style.display = "none";
    return;
  }
  var p = parseInt(pct, 10);
  if (isNaN(p)) p = 0;
  if (p < 0) p = 0;
  if (p > 100) p = 100;
  wrap.style.display = "block";
  try { void wrap.offsetWidth; } catch (eRf) {}
  if (fill) fill.style.width = p + "%";
  if (text) text.innerText = p + " %";
  if (step) step.innerText = stepLabel ? ("Ã‰tape en cours : " + stepLabel) : "";
}

/**
 * Statut installation pilote automatique + barre optionnelle (progressPct 0-100, ou -1 pour masquer).
 */
function setNvMediaAutoStatus(text, kind, progressPct) {
  var el = $("nvMediaAutoStatus");
  if (progressPct === -1 || progressPct === null || typeof progressPct === "undefined") {
    if (el) {
      el.style.display = "none";
      el.innerText = "";
    }
    setDriversProgressBar("nvMediaProgressWrap", "nvMediaProgressFill", "nvMediaProgressText", "nvMediaProgressStep", -1, "");
    return;
  }
  if (el) {
    el.style.display = progressPct >= 100 && kind === "ok" ? "" : "none";
    if (el.style.display !== "none") {
      el.innerText = text || "";
      var cls = "tcp-badge";
      if (kind === "ok") cls += " tcp-badge--ok";
      else if (kind === "progress") cls += " tcp-badge--progress";
      else cls += " tcp-badge--bad";
      el.className = cls;
    }
  }
  setDriversProgressBar("nvMediaProgressWrap", "nvMediaProgressFill", "nvMediaProgressText", "nvMediaProgressStep", progressPct, text || "");
  var p = parseInt(progressPct, 10);
  if (!isNaN(p)) {
    driversWorkflowState.installPct = p;
    if (p >= 100 && kind === "ok") {
      driversWorkflowState.installDone = true;
      driversWorkflowState.installError = false;
    }
    if (kind === "bad" || kind === "error") driversWorkflowState.installError = true;
    updateDriversWorkflowGuide();
  }
}

function nvcleanProgressFromLiveStatus(live) {
