    if (b && b.url) return { bundle: b, error: "" };
    return { bundle: null, error: "Connexion impossible ou rÃ©ponse vide du service de pilotes NVIDIA (rÃ©seau, pare-feu, proxy)." };
  } catch (e) {
    return { bundle: null, error: String(e.message || e) };
  }
}

