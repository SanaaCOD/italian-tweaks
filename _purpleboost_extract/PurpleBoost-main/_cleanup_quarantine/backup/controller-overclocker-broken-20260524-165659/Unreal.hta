    var p = UNREAL_LOGS + "\\gpu-driver-nvidia-update.json";
    if (!fso.FileExists(p)) return null;
    if (sinceMs) {
      var fileMs = new Date(fso.GetFile(p).DateLastModified).getTime();
      if (fileMs < sinceMs - 1500) return null;
    }
    return JSON.parse(readTextFileAll(p));
  } catch (eR) {
