    var stream = fso.OpenTextFile(path, 8, true);
    stream.WriteLine(ts + " " + String(line || ""));
    stream.Close();
  } catch (eW) {}
}

function appendNvFinalStepLog(fileName, stepName, actionSent, outcome, errMsg, durationMs) {
  appendNvFinalLog(fileName, "Ã©tape=" + stepName + " action=" + actionSent + " rÃ©sultat=" + outcome
    + (errMsg ? " erreur=" + errMsg : "") + " durÃ©eMs=" + (durationMs || 0));
}

function loadNvidiaOptimizationConfig() {
  var defaults = {
    digitalVibrance: 80,
    runNipProfile: true,
    runDigitalVibrance: true,
    runDisplaySettings: true,
    runPanelSettings: true,
    closeNvidiaPanelAtEnd: true,
    bringUnrealToFrontAtEnd: true,
    experimentalKeepUnrealInFrontDuringPanelAutomation: false,
    panelSettings: {
      runNoScaling: true,
      runPreviewPerformance: true,
      runInverseTelecine: true,
      delayAfterNoScalingMs: 4000,
      delayBetweenPanelStepsMs: 1000
    }
  };
  try {
    var app = getAppFolderFromHta();
    if (!app) return defaults;
    var path = getAbsolutePathFs(app + "\\config\\nvidia-optimization.json");
    if (!fileExists(path)) return defaults;
    var raw = readTextFileAll(path);
    if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
    var cfg = JSON.parse(raw);
    if (!cfg.panelSettings) cfg.panelSettings = defaults.panelSettings;
    return cfg;
  } catch (e) {
    appendNvFinalLog("nvidia-full-optimization.log", "WARN config illisible â€” dÃ©fauts");
    return defaults;
  }
}

function purgeObsoleteNvidiaLogs() {
  var app = getAppFolderFromHta();
  if (!app) return;
  var logsDir = getAbsolutePathFs(app + "\\logs");
  var patterns = [
    "nvidia-ui-fallback.log",
    "nvidia-control-panel-ui-tree.json",
    "nvidia-control-panel-ui-tree.txt",
    "nvidia-v3-result.json",
    "nvidia-v3-diagnostics.log",
    "nvidia-v3-audit-report.txt",
    "nvidia-v3-performance-forensic.log",
    "nvidia-performance-reg-candidates.txt",
    "nvidia-performance-nvtweak-diff.txt",
    "nvidia-final-three-settings.log"
  ];
  var prefixes = ["nvidia_snapshot_", "nvidia-v3-"];
  try {
    var fso = getFso();
    if (!fso.FolderExists(logsDir)) return;
    var folder = fso.GetFolder(logsDir);
    var fe = new Enumerator(folder.Files);
    for (; !fe.atEnd(); fe.moveNext()) {
      var name = fe.item().Name;
      var i, kill = false;
      for (i = 0; i < patterns.length; i++) {
        if (name === patterns[i]) { kill = true; break; }
      }
      if (!kill) {
        for (i = 0; i < prefixes.length; i++) {
          if (name.indexOf(prefixes[i]) === 0) { kill = true; break; }
        }
      }
      if (kill) {
        try { fso.DeleteFile(logsDir + "\\" + name, true); } catch (eD) {}
      }
    }
  } catch (eP) {}
}

function initNvFullOptResult(startedAt) {
  return {
    success: false,
    startedAt: startedAt || new Date().toISOString(),
    endedAt: "",
    steps: {
      nip: { status: "skipped", log: "logs/nvidia-final/01-nip.log" },
      digitalVibrance: { status: "skipped", value: 80, log: "logs/nvidia-final/02-digital-vibrance.log" },
      display: {
        status: "skipped",
        log: "logs/nvidia-final/03-display.log",
        resolution: { status: "skipped", message: "" },
        refreshRate: { status: "skipped", message: "" }
      },
      panelSettings: {
        status: "skipped",
        label: "",
        log: "logs/nvidia-final/04-panel-settings.log",
        children: {
          noScaling: "skipped",
          previewPerformance: "skipped",
          inverseTelecine: "skipped"
        }
      }
    }
  };
}

function nvFullOptMapV2Step(step) {
  if (!step || !step.status) return "error";
  if (step.status === "Skipped") return "skipped";
  if (step.status === "Success" && step.verified === true) return "success";
  if (step.status === "Success") return "success";
  return "error";
}

function nvFullOptMapPanelPayload(payload, hadError) {
  if (hadError || !payload) return "error";
  if (payload.uiStatus === "error") return "error";
  if (payload.verified === true && payload.uiStatus === "panel_verified") return "success";
  if (payload.success !== false) return "success";
  return "error";
}

function nvFullOptMapPanelChild(status) {
  if (status === "success") return "success";
  if (status === "skipped") return "skipped";
  return "error";
}

function writeNvFullOptimizationResultJson(result) {
  try {
    ensureNvFinalLogDir();
    var app = getAppFolderFromHta();
    var path = getNvFinalLogDir() + "\\nvidia-full-optimization-result.json";
    var fso = getFso();
    var tw = fso.CreateTextFile(path, true);
    tw.Write(JSON.stringify(result, null, 2));
    tw.Close();
    if (app) appendNvGamingLogLine("NV_FULL_OPT_JSON=" + path);
  } catch (eW) {
    appendNvGamingLogLine("NV_FULL_OPT_JSON_ERROR=" + String(eW.message || eW));
  }
}

function logNvOptProgress(pct, stepLabel) {
  appendNvFinalLog("nvidia-full-optimization.log", "progress=" + pct + " " + stepLabel);
}

function preventUnrealHtaRelaunch(context) {
  appendNvFinalLog("nvidia-full-optimization.log", "No second HTA instance should be launched");
  appendNvFinalLog("nvidia-full-optimization.log", "Unreal.hta relaunch prevented" + (context ? " (" + context + ")" : ""));
  appendNvGamingLogLine("Unreal.hta relaunch prevented context=" + (context || "nv-full-opt"));
}

function setNvOptProgress(pct, stepLabel) {
  var wrap = $("nvOptProgressWrap");
  var fill = $("nvOptProgressFill");
  var text = $("nvOptProgressText");
  var step = $("nvOptProgressStep");
  var p = parseInt(pct, 10);
  if (isNaN(p)) p = 0;
  if (p < 0) p = 0;
  if (p > 100) p = 100;
  if (wrap) {
    wrap.style.display = "block";
    try { void wrap.offsetWidth; } catch (eRf) {}
  }
  if (fill) fill.style.width = p + "%";
  if (text) text.innerHTML = p + " %";
  if (step) step.innerHTML = "Ã‰tape en cours : " + (stepLabel || "â€¦");
  if (stepLabel) logNvOptProgress(p, stepLabel);
  driversWorkflowState.optPct = p;
  if (p >= 100) {
    driversWorkflowState.optDone = true;
    driversWorkflowState.optError = false;
    updateDriversWorkflowGuide();
  } else if (p > 0) {
    driversWorkflowState.optDone = false;
    updateDriversWorkflowGuide();
  }
}

function setProgress(pct, stepLabel, nextFn) {
  setNvOptProgress(pct, stepLabel);
  if (typeof nextFn === "function") {
    window.setTimeout(nextFn, 100);
  }
}

function resetNvOptProgress(hide) {
  if (hide) {
    var wrap = $("nvOptProgressWrap");
    if (wrap) wrap.style.display = "none";
    return;
  }
  setNvOptProgress(0, "En attente");
}

/** Met la fenÃªtre HTA courante au premier plan â€” ne relance jamais mshta.exe / Unreal.hta */
function focusCurrentHtaWindowOnly() {
  preventUnrealHtaRelaunch("focus-end");
  try {
    if (window.focus) window.focus();
    appendNvGamingLogLine("FOCUS=current HTA window only (no mshta relaunch)");
    appendNvFinalLog("nvidia-full-optimization.log", "FenÃªtre Unreal au premier plan (instance courante)");
  } catch (eF) {
    appendNvGamingLogLine("FOCUS_WARN=" + String(eF.message || eF));
  }
}

function extractDisplayMaxFromPayload(payload) {
  var maxRes = "";
  var maxHz = 0;
  var msgs = (payload && payload.messages) ? payload.messages : [];
  var i, m, rm, hm;
  for (i = 0; i < msgs.length; i++) {
    m = String(msgs[i] || "");
    rm = m.match(/Selected max resolution:\s*(\d+x\d+)/i);
    if (rm) maxRes = rm[1];
    hm = m.match(/Selected max refresh rate:\s*(\d+)/i);
    if (hm) maxHz = parseInt(hm[1], 10);
  }
  return { maxRes: maxRes, maxHz: maxHz };
}

function normalizeResStr(res) {
  if (!res) return "";
  return String(res).replace(/\s/g, "").toLowerCase();
}

function parseRefreshHz(hzStr) {
  if (!hzStr) return 0;
  var n = parseInt(String(hzStr).replace(/Hz/gi, ""), 10);
  return isNaN(n) ? 0 : n;
}

function evaluateDisplayResolutionStatus(d, payload) {
  if (!d || !d.resolution) {
    return { status: "error", message: "Impossible de lire les modes d'affichage" };
  }
  if (d.verified) {
    return { status: "success", message: "appliquÃ©e (" + d.resolution + ")" };
  }
  var max = extractDisplayMaxFromPayload(payload);
  if (max.maxRes && normalizeResStr(d.resolution) === normalizeResStr(max.maxRes)) {
    return { status: "already_optimal", message: "RÃ©solution dÃ©jÃ  maximale" };
  }
  return { status: "error", message: "Impossible d'appliquer la rÃ©solution maximale" };
}

function evaluateDisplayRefreshStatus(d, payload) {
  if (!d || !d.refresh) {
    return { status: "error", message: "Impossible de lire la frÃ©quence d'affichage" };
  }
  if (d.verified) {
    return { status: "success", message: "appliquÃ©e (" + d.refresh + ")" };
  }
  var max = extractDisplayMaxFromPayload(payload);
  var curHz = parseRefreshHz(d.refresh);
  if (max.maxHz > 0 && curHz >= max.maxHz) {
    return { status: "already_optimal", message: "FrÃ©quence dÃ©jÃ  maximale" };
  }
  if (max.maxHz > 0 && curHz > 0 && curHz >= max.maxHz - 1) {
    return { status: "already_optimal", message: "FrÃ©quence dÃ©jÃ  maximale" };
  }
  return { status: "error", message: "Impossible d'appliquer la frÃ©quence maximale" };
}

function aggregateDisplayStepStatus(resSt, hzSt) {
  if (resSt.status === "error" && hzSt.status === "error") return "error";
  if (resSt.status === "error" || hzSt.status === "error") return "error";
  return "success";
}

function isDisplayStepOkForFlow(st) {
  return st === "success" || st === "already_optimal" || st === "skipped";
}

function nvFullOptUiLabel(status) {
  if (status === "success") return { text: "fait", tone: "ok" };
  if (status === "already_optimal") return { text: "dÃ©jÃ  maximale", tone: "ok" };
  if (status === "applied") return { text: "appliquÃ©e", tone: "ok" };
  if (status === "skipped") return { text: "ignorÃ©", tone: "muted" };
  if (status === "sent") return { text: "action envoyÃ©e", tone: "warn" };
  return { text: "erreur", tone: "bad" };
}

function nvDisplayLineUiLabel(step) {
  if (!step) return { text: "â€”", tone: "muted" };
  if (step.status === "success") return { text: "appliquÃ©e", tone: "ok" };
  if (step.status === "already_optimal") return { text: "dÃ©jÃ  maximale", tone: "ok" };
  if (step.status === "skipped") return { text: "ignorÃ©", tone: "muted" };
  return { text: "erreur", tone: "bad" };
}

function mapPanelChildFromPayload(status) {
  if (status === "applied" || status === "success") return "applied";
  if (status === "skipped") return "skipped";
  return "error";
}

function aggregatePanelSettingsStatus(children) {
  if (!children) return "skipped";
  if (children.noScaling === "error" || children.previewPerformance === "error" || children.inverseTelecine === "error") {
    return "error";
  }
  if (children.noScaling === "applied" || children.previewPerformance === "applied" || children.inverseTelecine === "applied") {
    return "applied";
  }
  return "skipped";
}

function panelLabelForStatus(status) {
  if (status === "applied") return "appliquÃ©";
  if (status === "skipped") return "ignorÃ©";
  return "erreur";
}

function nvPanelParentUiLabel(panelStep) {
  if (!panelStep) return { text: "â€”", tone: "muted" };
  var st = panelStep.status || "error";
  if (st === "error") return { text: "erreur", tone: "bad" };
  if (st === "skipped") return { text: "ignorÃ©", tone: "muted" };
  if (st === "applied") return { text: "appliquÃ©", tone: "ok" };
  return { text: "erreur", tone: "bad" };
}

function nvPanelSubStepUiLabel(childStatus) {
  if (childStatus === "skipped") return { text: "ignorÃ©", tone: "muted" };
  if (childStatus === "applied") return { text: "appliquÃ©", tone: "ok" };
  if (childStatus === "error") return { text: "erreur", tone: "bad" };
  return { text: "erreur", tone: "bad" };
}

function isPanelStepOkForFlow(status) {
  return status === "applied" || status === "skipped";
}

function renderNvFullOptimizationSummary(result) {
  var box = $("nvidiaGamingSteps");
  if (!box || !result || !result.steps) return;
  var s = result.steps;
  var lines = ["<strong>Optimisation NVIDIA complÃ¨te terminÃ©e</strong>"];
  var nip = nvFullOptUiLabel(s.nip.status);
  var dvVal = (s.digitalVibrance && s.digitalVibrance.value) ? s.digitalVibrance.value : 80;
  var dv = nvFullOptUiLabel(s.digitalVibrance.status);
  var dvText = (s.digitalVibrance.status === "success") ? (dvVal + " %") : dv.text;
  var resUi = nvDisplayLineUiLabel(s.display.resolution);
  var hzUi = nvDisplayLineUiLabel(s.display.refreshRate);
  var pan = nvPanelParentUiLabel(s.panelSettings);
  lines.push("- Profil NVIDIA : <span class=\"nv-step-" + nip.tone + "\">" + nip.text + "</span>");
  lines.push("- Ã‰clat numÃ©rique : <span class=\"nv-step-" + dv.tone + "\">" + dvText + "</span>");
  lines.push("- RÃ©solution : <span class=\"nv-step-" + resUi.tone + "\">" + resUi.text + "</span>");
  lines.push("- FrÃ©quence : <span class=\"nv-step-" + hzUi.tone + "\">" + hzUi.text + "</span>");
  lines.push("- RÃ©glages panneau NVIDIA : <span class=\"nv-step-" + pan.tone + "\">" + pan.text + "</span>");
  if (s.panelSettings.children) {
    var c = s.panelSettings.children;
    var ns = nvPanelSubStepUiLabel(c.noScaling);
    var pp = nvPanelSubStepUiLabel(c.previewPerformance);
    var it = nvPanelSubStepUiLabel(c.inverseTelecine);
    lines.push("  - Pas de mise Ã  l'Ã©chelle : <span class=\"nv-step-" + ns.tone + "\">" + ns.text + "</span>");
    lines.push("  - Mode performance NVIDIA : <span class=\"nv-step-" + pp.tone + "\">" + pp.text + "</span>");
    lines.push("  - TÃ©lÃ©cinÃ© inversÃ©e : <span class=\"nv-step-" + it.tone + "\">" + it.text + "</span>");
  }
  box.innerHTML = lines.join("<br/>");
  box.style.display = "block";
}

function setNvGamingStatusFromFullOpt(result) {
  if (!result) { setNvGamingStatus("Optimisation NVIDIA : erreur interne", "bad"); return; }
  if (result.success) {
    setNvGamingStatus("Optimisation NVIDIA complÃ¨te terminÃ©e â€” voir dÃ©tail ci-dessous.", "ok");
    return;
  }
  var hasError = false;
  var steps = result.steps;
  if (steps.nip.status === "error" || steps.digitalVibrance.status === "error") hasError = true;
  if (steps.display && steps.display.resolution && steps.display.resolution.status === "error") hasError = true;
  if (steps.display && steps.display.refreshRate && steps.display.refreshRate.status === "error") hasError = true;
  if (steps.panelSettings && steps.panelSettings.status === "error") hasError = true;
  if (hasError) {
    setNvGamingStatus("Optimisation NVIDIA : une ou plusieurs Ã©tapes en erreur â€” voir dÃ©tail.", "bad");
    return;
  }
  setNvGamingStatus("Optimisation NVIDIA : terminÃ©e avec avertissements â€” voir dÃ©tail.", "warn");
}

function toggleNvDevMode() {
  purpleboostNvDevMode = !purpleboostNvDevMode;
  var nodes = document.querySelectorAll ? document.querySelectorAll(".nv-dev-only") : [];
  var i, display = purpleboostNvDevMode ? "" : "none";
  for (i = 0; i < nodes.length; i++) nodes[i].style.display = display;
  var link = $("nvDevModeToggle");
  if (link) link.innerHTML = purpleboostNvDevMode ? "Masquer mode dÃ©veloppeur" : "Mode dÃ©veloppeur (tests NVIDIA)";
}

function getNvidiaFullProfileInspectorPath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var candidates = [
    app + "\\tools\\nvidiaProfileInspector\\nvidiaProfileInspector.exe",
    app + "\\tools\\nvidiaProfileInspector\\ProfileInspector\\nvidiaProfileInspector.exe",
    app + "\\tools\\NVIDIA\\ProfileInspector\\nvidiaProfileInspector.exe"
  ];
  var i;
  for (i = 0; i < candidates.length; i++) {
    if (fileExists(candidates[i])) return getAbsolutePathFs(candidates[i]);
  }
  return "";
}

function getNvidiaFullWarzoneNipPath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var candidates = [
    app + "\\tools\\profiles\\" + NVIDIA_FULL_WARZONE_NIP_FILE,
    app + "\\tools\\nvidiaProfileInspector\\Profiles\\" + NVIDIA_FULL_WARZONE_NIP_FILE,
    app + "\\tools\\NVIDIA\\Profiles\\" + NVIDIA_FULL_WARZONE_NIP_FILE
  ];
  var i;
  for (i = 0; i < candidates.length; i++) {
    if (fileExists(candidates[i])) return getAbsolutePathFs(candidates[i]);
  }
  return "";
}

function getNvidiaDisplayHelperPath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var p = getAbsolutePathFs(app + "\\tools\\nvidia-display-helper\\UnrealNvidiaDisplayHelper.exe");
  if (fileExists(p)) return p;
  return "";
}

function setNvGamingStatus(text, kind) {
  setNvidiaPanelStatus(text, kind);
}

function resolveNvGamingNipPath() {
  var p = getNvidiaFullWarzoneNipPath();
  if (p && fileExists(p)) return p;
  return resolveNvidiaPerformanceProfilePath();
}

function resolveNvGamingInspectorPath() {
  var inspector = ensureBundledNvidiaProfileInspector();
  if (!inspector) inspector = resolveNvidiaProfileInspectorExe();
  if (!inspector) inspector = getNvidiaFullProfileInspectorPath();
  return inspector || "";
}

/*
 * STABLE â€” stable-nvidia-nip-silent-import (NE PAS RÃ‰Ã‰CRIRE)
 * Import .nip validÃ© : NvidiaAutomationV2 + -silentImport, sans UI NPI.
 * Ne pas remplacer par ShellExecute, ouverture du .nip, PowerShell runas sur NPI,
 * ni export sauvegarde avant apply dans ce flux.
 * Fichiers : ApplyNipProfile, runNvidiaAutomationV2ApplyNipOnly,
 *   tools/nvidia-automation-v2/.../NipSilentImportService.cs
 */
function resolveApplyNipInspectorPath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var primary = getAbsolutePathFs(app + "\\tools\\NvidiaProfileInspector\\nvidiaProfileInspector.exe");
  if (fileExists(primary)) return primary;
  return resolveNvGamingInspectorPath();
}

function resolveApplyNipPresetPath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var primary = getAbsolutePathFs(app + "\\presets\\UnrealGaming.nip");
  if (fileExists(primary)) return primary;
  return resolveNvGamingNipPath();
}

function runNvidiaAutomationV2ApplyNipOnly() {
  createUnrealFolders();
  var exe = getNvidiaAutomationV2ExePath();
  if (!exe || !fileExists(exe)) {
    return { error: "NvidiaAutomationV2.exe introuvable" };
  }
  var app = getAppFolderFromHta();
  var stdoutPath = UNREAL_LOGS + "\\nvidia-apply-nip-result.json";
  var psPath = UNREAL_LOGS + "\\nvidia-apply-nip-run.ps1";
  var escExe = String(exe).replace(/'/g, "''");
  var escRoot = String(app || "").replace(/'/g, "''");
  var escOut = String(stdoutPath).replace(/'/g, "''");
  var fso = getFso();
  var psLines = [
    "$ErrorActionPreference = 'Continue'",
    "$Exe = '" + escExe + "'",
    "$Root = '" + escRoot + "'",
    "$StdoutPath = '" + escOut + "'",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Exe",
    "$psi.Arguments = '--apply-nip --json --purpleboost-root \"' + $Root + '\"'",
    "$psi.WorkingDirectory = (Split-Path -Parent $Exe)",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$psi.RedirectStandardOutput = $true",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if ($p) {",
    "  $stdout = $p.StandardOutput.ReadToEnd()",
    "  if (-not $p.WaitForExit(180000)) { try { $p.Kill() } catch {}; exit 124 }",
    "  else { if ($stdout) { [System.IO.File]::WriteAllText($StdoutPath, $stdout, [System.Text.UTF8Encoding]::new($false)) }; exit $p.ExitCode }",
    "}",
    "exit 18"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(psLines.join("\r\n"));
  tw.Close();
  appendNvGamingLogLine("NIP_V2_SILENT=" + exe);
  runPowerShell("-ExecutionPolicy Bypass -File \"" + psPath + "\"");
  var payload = null;
  try {
    if (fso.FileExists(stdoutPath)) {
      var raw = readTextFileAll(stdoutPath);
      if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
      if (raw) payload = JSON.parse(raw);
      fso.DeleteFile(stdoutPath, true);
    }
  } catch (eP) {
    appendNvGamingLogLine("NIP_V2_PARSE_ERROR=" + String(eP.message || eP));
  }
  try { fso.DeleteFile(psPath, true); } catch (eD) {}
  return payload;
}

function ApplyNipProfile() {
  appendNvGamingLogLine("STEP=ApplyNipProfile");
  appendNvidiaProfileLogLine("STEP=ApplyNipProfile (-silentImport C#, sans UI NPI)");
  var inspector = resolveApplyNipInspectorPath();
  if (!inspector || !fileExists(inspector)) {
    appendNvidiaProfileLogLine("NPI=manquant");
    return makeNvGamingResult("Failed", "Outil Nvidia Profile Inspector manquant.");
  }
  var nipPath = resolveApplyNipPresetPath();
  if (!nipPath || !fileExists(nipPath)) {
    appendNvidiaProfileLogLine("NIP=preset UnrealGaming.nip manquant");
    return makeNvGamingResult("Failed", "Preset Nvidia UnrealGaming.nip introuvable.");
  }
  appendNvidiaProfileLogLine("NPI_PATH=" + inspector);
  appendNvidiaProfileLogLine("NIP_PATH=" + nipPath);
  appendNvidiaProfileLogLine("NPI_CMD=" + inspector + " -silentImport \"" + nipPath + "\"");
  var payload = runNvidiaAutomationV2ApplyNipOnly();
  if (!payload || payload.error) {
    appendNvidiaProfileLogLine("NPI_EXIT_CODE=error " + (payload && payload.error ? payload.error : "no_json"));
    return makeNvGamingResult("Failed", payload && payload.error ? payload.error : "Import .nip Ã©chouÃ©");
  }
  var step = payload.nipProfile || {};
  var exitOk = step.status === "Success";
  appendNvGamingLogLine("NIP_EXIT=" + (step.status || "?") + " ok=" + exitOk);
  appendNvidiaProfileLogLine("NPI_EXIT_CODE=" + (step.status || "?") + " msg=" + (step.message || ""));
  if (exitOk) {
    return makeNvGamingResult("Success", "Profil NVIDIA appliquÃ© via .nip");
  }
  return makeNvGamingResult("Failed", step.message || "Import .nip Ã©chouÃ©");
}

function runNvGamingDisplayApply() {
  if (nvGamingDisplayCache) return nvGamingDisplayCache;
  createUnrealFolders();
  var helperPath = getNvidiaDisplayHelperPath();
  var fso = getFso();
  var payload = null;

  if (helperPath && fileExists(helperPath)) {
    var stdoutPath = UNREAL_LOGS + "\\nvidia-gaming-display-stdout.json";
    var psPath = UNREAL_LOGS + "\\nvidia-gaming-display-run.ps1";
    var escHelper = String(helperPath).replace(/'/g, "''");
    var escOut = String(stdoutPath).replace(/'/g, "''");
    var psLines = [
      "$ErrorActionPreference = 'Continue'",
      "$Helper = '" + escHelper + "'",
      "$StdoutPath = '" + escOut + "'",
      "$psi = New-Object System.Diagnostics.ProcessStartInfo",
      "$psi.FileName = $Helper",
      "$psi.Arguments = '--apply-full --skip-digital-vibrance --json'",
      "$psi.WorkingDirectory = (Split-Path -Parent $Helper)",
      "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
      "$psi.CreateNoWindow = $true",
      "$psi.UseShellExecute = $false",
      "$psi.RedirectStandardOutput = $true",
      "$p = [System.Diagnostics.Process]::Start($psi)",
      "if ($p) {",
      "  $stdout = $p.StandardOutput.ReadToEnd()",
      "  if (-not $p.WaitForExit(120000)) { try { $p.Kill() } catch {}; exit 124 }",
      "  else { if ($stdout) { [System.IO.File]::WriteAllText($StdoutPath, $stdout, [System.Text.UTF8Encoding]::new($false)) }; exit $p.ExitCode }",
      "}",
      "exit 18"
    ];
    var tw = fso.CreateTextFile(psPath, true);
    tw.Write(psLines.join("\r\n"));
    tw.Close();
    appendNvGamingLogLine("DISPLAY=helper " + helperPath);
    runPowerShell("-ExecutionPolicy Bypass -File \"" + psPath + "\"");
    try {
      if (fso.FileExists(stdoutPath)) {
        var raw = readTextFileAll(stdoutPath);
        if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
        if (raw) payload = JSON.parse(raw);
        fso.DeleteFile(stdoutPath, true);
      }
    } catch (eP) {
      appendNvGamingLogLine("DISPLAY_PARSE_ERROR=" + String(eP.message || eP));
    }
    try { fso.DeleteFile(psPath, true); } catch (eD) {}
  }

  if (!payload) {
    var resultPath = UNREAL_LOGS + "\\nvidia-gaming-display-result.json";
    var psDisplay = UNREAL_SCRIPTS + "\\apply-nvidia-display-profile.ps1";
    if (!fileExists(psDisplay)) {
      nvGamingDisplayCache = { ok: false, resolution: "", refresh: "", verified: false };
      return nvGamingDisplayCache;
    }
    var escPs = String(psDisplay).replace(/'/g, "''");
    var escRes = String(resultPath).replace(/'/g, "''");
    var escLog = String(getNvGamingLogPath()).replace(/'/g, "''");
    var runner = UNREAL_LOGS + "\\nvidia-gaming-display-ps.ps1";
    var rLines = [
      "& '" + escPs + "' -LogPath '" + escLog + "' -ResultPath '" + escRes + "'",
      "exit $LASTEXITCODE"
    ];
    var tr = fso.CreateTextFile(runner, true);
    tr.Write(rLines.join("\r\n"));
    tr.Close();
    appendNvGamingLogLine("DISPLAY=ps1 fallback");
    runPowerShell("-ExecutionPolicy Bypass -File \"" + runner + "\"");
    try {
      if (fso.FileExists(resultPath)) {
        var json = readTextFileAll(resultPath);
        if (json) {
          var parsed = JSON.parse(json);
          if (parsed && parsed.resolution) {
            payload = {
              displayMode: {
                applied: parsed.globalResult === "ok",
                verified: parsed.resolution.verified === true,
                resolution: parsed.resolution.targetResolution || parsed.resolution.activeResolution || "",
                refreshRate: (parsed.resolution.targetRefresh || parsed.resolution.activeRefresh || "") + "Hz"
              }
            };
          }
        }
        fso.DeleteFile(resultPath, true);
      }
    } catch (eP2) {}
    try { fso.DeleteFile(runner, true); } catch (eD2) {}
  }

  var dm = payload && payload.displayMode ? payload.displayMode : {};
  var res = dm.resolution || "";
  var hz = dm.refreshRate || "";
  if (hz && hz.indexOf("Hz") < 0) hz = hz + "Hz";
  var verified = dm.applied === true && dm.verified === true;
  nvGamingDisplayCache = {
    ok: verified,
    resolution: res,
    refresh: hz,
    verified: verified,
    raw: dm,
    payload: payload,
    messages: (payload && payload.messages) ? payload.messages : []
  };
  if (payload && payload.messages && payload.messages.length) {
    for (var mi = 0; mi < payload.messages.length; mi++) {
      var msg = String(payload.messages[mi] || "");
      if (msg.indexOf("Selected max") === 0 || msg.indexOf("Available display") === 0 ||
          msg.indexOf("Resolution applied") === 0 || msg.indexOf("Refresh rate applied") === 0 ||
          msg.indexOf("Current mode after apply") === 0) {
        appendNvGamingLogLine(msg);
      }
    }
  }
  appendNvGamingLogLine("Resolution applied: " + (verified && res ? "OK" : "Failed"));
  appendNvGamingLogLine("Refresh rate applied: " + (verified && hz ? "OK" : "Failed"));
  if (res && hz) {
    var hzNum = String(hz).replace(/Hz$/i, "");
    appendNvGamingLogLine("Current mode after apply: " + res + " @ " + hzNum + " Hz");
  }
  appendNvGamingLogLine("DISPLAY_RESULT verified=" + verified + " res=" + res + " hz=" + hz);
  return nvGamingDisplayCache;
}

function nvGamingBuildDisplayCacheFromPayload(payload) {
  var dm = payload && payload.displayMode ? payload.displayMode : {};
  var res = dm.resolution || "";
  var hz = dm.refreshRate || "";
  if (hz && hz.indexOf("Hz") < 0) hz = hz + "Hz";
  var verified = dm.applied === true && dm.verified === true;
  nvGamingDisplayCache = {
    ok: verified,
    resolution: res,
    refresh: hz,
    verified: verified,
    raw: dm,
    payload: payload,
    messages: (payload && payload.messages) ? payload.messages : []
  };
  return nvGamingDisplayCache;
}

function runNvGamingDisplayApplyAsync(onDone) {
  nvGamingDisplayCache = null;
  createUnrealFolders();
  var helperPath = getNvidiaDisplayHelperPath();
  if (!helperPath || !fileExists(helperPath)) {
    window.setTimeout(function () {
      try {
        onDone(runNvGamingDisplayApply());
      } catch (eD) {
        onDone({ ok: false, resolution: "", refresh: "", verified: false });
      }
    }, 50);
    return;
  }
  var fso = getFso();
  var stdoutPath = UNREAL_LOGS + "\\nvidia-gaming-display-stdout.json";
  var psPath = UNREAL_LOGS + "\\nvidia-gaming-display-async-run.ps1";
  var escHelper = String(helperPath).replace(/'/g, "''");
  var escOut = String(stdoutPath).replace(/'/g, "''");
  var psLines = [
    "$ErrorActionPreference = 'Continue'",
    "$Helper = '" + escHelper + "'",
    "$StdoutPath = '" + escOut + "'",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Helper",
    "$psi.Arguments = '--apply-full --skip-digital-vibrance --json'",
    "$psi.WorkingDirectory = (Split-Path -Parent $Helper)",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$psi.RedirectStandardOutput = $true",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if ($p) {",
    "  $stdout = $p.StandardOutput.ReadToEnd()",
    "  if (-not $p.WaitForExit(120000)) { try { $p.Kill() } catch {}; exit 124 }",
    "  else { if ($stdout) { [System.IO.File]::WriteAllText($StdoutPath, $stdout, [System.Text.UTF8Encoding]::new($false)) }; exit $p.ExitCode }",
    "}",
    "exit 18"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(psLines.join("\r\n"));
  tw.Close();
  appendNvGamingLogLine("DISPLAY=helper async " + helperPath);
  var shell = new ActiveXObject("WScript.Shell");
  var exec = shell.Exec("powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" + psPath + "\"");
  var t0 = new Date().getTime();
  var hardLimitMs = 125000;
  function finish(cache) {
    try { fso.DeleteFile(psPath, true); } catch (eD) {}
    if (onDone) onDone(cache);
  }
  function poll() {
    if (new Date().getTime() - t0 > hardLimitMs) {
      try { exec.Terminate(); } catch (eK) {}
      finish({ ok: false, resolution: "", refresh: "", verified: false });
      return;
    }
    if (exec.Status === 1) {
      var payload = null;
      try {
        if (fso.FileExists(stdoutPath)) {
          var raw = readTextFileAll(stdoutPath);
          if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
          if (raw) payload = JSON.parse(raw);
          fso.DeleteFile(stdoutPath, true);
        }
      } catch (eP) {
        appendNvGamingLogLine("DISPLAY_ASYNC_PARSE_ERROR=" + String(eP.message || eP));
      }
      if (payload) {
        finish(nvGamingBuildDisplayCacheFromPayload(payload));
      } else {
        window.setTimeout(function () {
          try { finish(runNvGamingDisplayApply()); } catch (eF) { finish({ ok: false, resolution: "", refresh: "", verified: false }); }
        }, 50);
      }
      return;
    }
    window.setTimeout(poll, 400);
  }
  window.setTimeout(poll, 400);
}

function ApplyMaxResolution() {
  appendNvGamingLogLine("STEP=ApplyMaxResolution");
  var d = runNvGamingDisplayApply();
  if (!d || !d.resolution) {
    return makeNvGamingResult("Failed", "RÃƒÂ©solution maximale non appliquÃƒÂ©e ou non vÃƒÂ©rifiable");
  }
  if (d.verified) {
    return makeNvGamingResult("Success", "RÃƒÂ©solution " + d.resolution);
  }
  if (d.resolution) {
    return makeNvGamingResult("Failed", "RÃƒÂ©solution " + d.resolution + " (non vÃƒÂ©rifiÃƒÂ©e)");
  }
  return makeNvGamingResult("Failed", "Impossible d'appliquer la rÃƒÂ©solution maximale");
}

function ApplyMaxRefreshRate() {
  appendNvGamingLogLine("STEP=ApplyMaxRefreshRate");
  var d = runNvGamingDisplayApply();
  if (!d || !d.refresh) {
    return makeNvGamingResult("Failed", "FrÃƒÂ©quence maximale non appliquÃƒÂ©e ou non vÃƒÂ©rifiable");
  }
  if (d.verified) {
    return makeNvGamingResult("Success", "FrÃƒÂ©quence " + d.refresh);
  }
  if (d.refresh) {
    return makeNvGamingResult("Failed", "FrÃƒÂ©quence " + d.refresh + " (non vÃƒÂ©rifiÃƒÂ©e)");
  }
  return makeNvGamingResult("Failed", "Impossible d'appliquer la frÃƒÂ©quence maximale");
}

/* --- Nvidia Automation V2 (exe) --- */
function getNvidiaAutomationV2ExePath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var main = getAbsolutePathFs(app + "\\tools\\nvidia-automation-v2\\NvidiaAutomationV2.exe");
  var staging = getAbsolutePathFs(app + "\\tools\\nvidia-automation-v2\\_publish-staging\\NvidiaAutomationV2.exe");
  if (fileExists(staging) && fileExists(main)) {
    try {
      var fso = getFso();
      if (fso.GetFile(staging).DateLastModified > fso.GetFile(main).DateLastModified) return staging;
    } catch (eCmp) {}
  }
  if (fileExists(staging) && !fileExists(main)) return staging;
  if (fileExists(main)) return main;
  if (fileExists(staging)) return staging;
  return "";
}

/* --- RÃ©glages NVIDIA supplÃ©mentaires (statuts honnÃªtes â€” SAFE_STATUS_2026_05_22) --- */
var NV_EXTRA_UI_VERSION = "SAFE_STATUS_2026_05_22";

function initNvExtraUiVersion() {
  try { appendNvGamingLogLine("NV_EXTRA_UI_VERSION=" + NV_EXTRA_UI_VERSION); } catch (eLog) {}
  var el = $("nvExtraUiVersionLabel");
  if (el) el.innerText = "Version UI NVIDIA extras : " + NV_EXTRA_UI_VERSION;
}

function setNvExtraRegStatus(msg, tone) {
  var el = $("nvExtraRegStatus");
  if (!el) return;
  el.innerHTML = msg;
  var cls = "tcp-badge tcp-badge--progress";
  if (tone === "ok") cls = "tcp-badge tcp-badge--ok";
  else if (tone === "bad") cls = "tcp-badge tcp-badge--bad";
  else if (tone === "warn") cls = "tcp-badge tcp-badge--warn";
  else if (tone === "muted") cls = "tcp-badge tcp-badge--progress";
  el.className = cls;
}

function nvExtraTextHasBlockedGreenTerms(text) {
  var t = String(text || "").toLowerCase();
  var blocked = [
    "non implÃ©mentÃ©", "non implemente", "diagnostic", "ignored", "ignorÃ©", "ignore",
    "dÃ©jÃ ", "deja", "aucune preuve", "no change", "no scaling", "not implemented",
    "not_implemented", "dÃ©jÃ  natif", "deja natif", "relecture seulement"
  ];
  for (var i = 0; i < blocked.length; i++) {
    if (t.indexOf(blocked[i]) >= 0) return true;
  }
  return false;
}

function nvExtraEvidenceImpliesReadAfterApply(evidence) {
  var e = String(evidence || "").toLowerCase();
  if (!e) return false;
  if (e.indexOf("aprÃ¨s Ã©criture") >= 0 || e.indexOf("apres ecriture") >= 0) return true;
  if (e.indexOf("relu aprÃ¨s application") >= 0 || e.indexOf("relu apres application") >= 0) return true;
  if (e.indexOf("after apply") >= 0) return true;
  return false;
}

/** Vert impossible si message/evidence ambigu â€” applied+verified+evidence+method requis. */
function nvExtraRenderUi(internal) {
  if (!internal) internal = { status: "error", verified: false, message: "aucun retour", evidence: "", method: "none" };
  var st = String(internal.status || "error");
  var v = internal.verified === true;
  var proof = String(internal.evidence || "").trim();
  var msg = String(internal.message || "");
  var method = String(internal.method || "none");

  if (st === "not_implemented" || method === "none") {
    return { tone: "muted", label: "non implÃ©mentÃ©", detail: msg, proof: "" };
  }
  if (st === "ignored") {
    return { tone: "warn", label: "ignorÃ©", detail: msg, proof: proof || "" };
  }
  if (st === "applied") {
    if (!v || proof.length === 0 || method === "none" || nvExtraTextHasBlockedGreenTerms(msg) || nvExtraTextHasBlockedGreenTerms(proof)) {
      return { tone: "bad", label: "erreur", detail: msg || "applied sans preuve fiable", proof: "" };
    }
    if (!nvExtraEvidenceImpliesReadAfterApply(proof) && st === "applied") {
      return { tone: "warn", label: "ignorÃ©", detail: "Pas de mise Ã  l'Ã©chelle non confirmÃ© visuellement", proof: proof };
    }
    return { tone: "ok", label: "appliquÃ©", detail: msg, proof: proof };
  }
  return { tone: "bad", label: "erreur", detail: msg || st, proof: "" };
}

function nvExtraFormatStatusLine(title, ui) {
  var line = title + " : <strong>" + ui.label + "</strong> â€” " + ui.detail;
  if (ui.proof) line += " <span style=\"opacity:0.85\">(" + ui.proof + ")</span>";
  return line;
}

function nvExtraMapV2TelecineStep(step) {
  if (!step || !step.status) {
    return { status: "error", verified: false, method: "registry_xalg_cadence", evidence: "", message: "aucun retour exe" };
  }
  var msg = String(step.message || "");
  var evidence = String(step.evidence || "");
  var modifiedCount = (typeof step.modifiedCount === "number") ? step.modifiedCount : 0;
  var changed = (step.changed === true) || (step.registryChanged === true) || modifiedCount > 0;
  var uiSt = String(step.uiStatus || "");

  if (msg.indexOf("Action non lancÃ©e en administrateur") >= 0 || msg.indexOf("not allowed") >= 0 || msg.indexOf("Requested registry access") >= 0) {
    return { status: "error", verified: false, method: "registry_xalg_cadence", evidence: "", message: "Action non lancÃ©e en administrateur" };
  }
  if (step.status === "Failed" || uiSt === "error" || (msg.indexOf("AccÃ¨s registre refusÃ©") >= 0)) {
    return { status: "error", verified: false, method: "registry_xalg_cadence", evidence: "", message: msg || "AccÃ¨s registre refusÃ©, lancement admin requis" };
  }
  if (step.status === "Skipped" || uiSt === "ignored" || (!changed && modifiedCount === 0)) {
    if (msg.indexOf("Aucune valeur") >= 0) {
      return { status: "ignored", verified: false, method: "registry_xalg_cadence", evidence: evidence, message: msg };
    }
    return { status: "ignored", verified: false, method: "registry_xalg_cadence", evidence: evidence, message: "DÃ©jÃ  Ã  zÃ©ro dans le registre, aucune preuve de changement utilisateur" };
  }
  if (changed && step.verified === true && evidence.indexOf("00 00 00 00 00 00 00 00") >= 0 && evidence.indexOf("aprÃ¨s Ã©criture") >= 0) {
    return {
      status: "ignored",
      verified: false,
      method: "registry_xalg_cadence",
      evidence: evidence,
      message: "Registre modifiÃ©, panneau NVIDIA non confirmÃ©"
    };
  }
  if (step.status === "Success" && !changed) {
    return { status: "ignored", verified: false, method: "registry_xalg_cadence", evidence: evidence, message: "DÃ©jÃ  Ã  zÃ©ro dans le registre, aucune preuve de changement utilisateur" };
  }
  return { status: "error", verified: false, method: "registry_xalg_cadence", evidence: "", message: msg || step.status };
}

function nvExtraMapScalingPayload(payload) {
  var sc = payload && payload.scaling ? payload.scaling : null;
  if (!sc) {
    return { status: "error", verified: false, method: "display_helper_existing", evidence: "", message: "RÃ©ponse helper affichage vide" };
  }
  var mode = String(sc.mode || "");
  var evidence = String(sc.evidence || "");
  var modeLc = mode.toLowerCase();
  var evLc = evidence.toLowerCase();

  if (sc.uiStatus === "not_implemented") {
    return { status: "not_implemented", verified: false, method: "display_helper_existing", evidence: "", message: "Pas de mise Ã  l'Ã©chelle non vÃ©rifiable dans le helper actuel" };
  }
  if (sc.uiStatus === "ignored" || modeLc.indexOf("no change") >= 0 || modeLc.indexOf("dÃ©jÃ ") >= 0 || modeLc.indexOf("deja") >= 0 || evLc.indexOf("dÃ©jÃ ") >= 0) {
    return { status: "ignored", verified: false, method: "display_helper_existing", evidence: evidence, message: "Pas de mise Ã  l'Ã©chelle non confirmÃ© visuellement" };
  }
  if (modeLc.indexOf("no scaling") >= 0 && sc.verified !== true) {
    return { status: "ignored", verified: false, method: "display_helper_existing", evidence: "", message: mode || "No scaling â€” preuve insuffisante" };
  }
  if (sc.scalingChanged === true && sc.uiStatus === "applied" && sc.verified === true && evidence && nvExtraEvidenceImpliesReadAfterApply(evidence)) {
    return { status: "applied", verified: true, method: "display_helper_existing", evidence: evidence, message: mode || "Pas de mise Ã  l'Ã©chelle" };
  }
  if (sc.applied === true && sc.verified !== true) {
    return { status: "error", verified: false, method: "display_helper_existing", evidence: "", message: "Scaling appliquÃ© sans relecture confirmÃ©e" };
  }
  return { status: "ignored", verified: false, method: "display_helper_existing", evidence: evidence, message: "Pas de mise Ã  l'Ã©chelle non confirmÃ© visuellement" };
}

function runUnrealDisplayHelperExecAsync(helperArgs, logTag, timeoutMs, onDone) {
  createUnrealFolders();
  var helper = getNvidiaDisplayHelperPath();
  if (!helper || !fileExists(helper)) {
    if (onDone) onDone({ error: "UnrealNvidiaDisplayHelper.exe introuvable â€” lancez tools/nvidia-display-helper/build.ps1" });
    return;
  }
  var stdoutPath = UNREAL_LOGS + "\\" + logTag + "-result.json";
  var psPath = UNREAL_LOGS + "\\" + logTag + "-run.ps1";
  var escHelper = String(helper).replace(/'/g, "''");
  var escOut = String(stdoutPath).replace(/'/g, "''");
  var waitMs = timeoutMs || 60000;
  var fso = getFso();
  var psLines = [
    "$ErrorActionPreference = 'Continue'",
    "$Helper = '" + escHelper + "'",
    "$StdoutPath = '" + escOut + "'",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Helper",
    "$psi.Arguments = '" + helperArgs + "'",
    "$psi.WorkingDirectory = (Split-Path -Parent $Helper)",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$psi.RedirectStandardOutput = $true",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if ($p) {",
    "  $stdout = $p.StandardOutput.ReadToEnd()",
    "  if (-not $p.WaitForExit(" + waitMs + ")) { try { $p.Kill() } catch {}; $stdout = '{\"success\":false,\"messages\":[\"timeout\"]}' }",
    "  if (-not $stdout -or $stdout.Trim().Length -eq 0) { $stdout = '{\"success\":false,\"messages\":[\"stdout vide\"]}' }",
    "  [System.IO.File]::WriteAllText($StdoutPath, $stdout, [System.Text.UTF8Encoding]::new($false))",
    "  exit 0",
    "}",
    "exit 18"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(psLines.join("\r\n"));
  tw.Close();
  appendNvGamingLogLine("DISPLAY_HELPER=" + logTag + " args=" + helperArgs);
  var shell = new ActiveXObject("WScript.Shell");
  var exec = shell.Exec("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psPath + "\"");
  var t0 = new Date().getTime();
  var hardLimitMs = waitMs + 5000;
  function finish(r) { if (onDone) onDone(r); }
  function readPayload() {
    try {
      if (fso.FileExists(stdoutPath)) {
        var raw = readTextFileAll(stdoutPath);
        if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
        var payload = raw ? JSON.parse(raw) : null;
        fso.DeleteFile(stdoutPath, true);
        if (payload) return { payload: payload };
      }
    } catch (eP) {}
    try { fso.DeleteFile(psPath, true); } catch (eD) {}
    return { error: "RÃ©ponse helper affichage illisible", payload: null };
  }
  function poll() {
    if (new Date().getTime() - t0 > hardLimitMs) {
      try { exec.Terminate(); } catch (eK) {}
      finish({ error: "timeout helper affichage", payload: null });
      return;
    }
    if (exec.Status === 1) { finish(readPayload()); return; }
    window.setTimeout(poll, 400);
  }
  window.setTimeout(poll, 400);
}

function runNvExtraInverseTelecineAdminAsync(onDone) {
  var exe = getNvidiaAutomationV2ExePath();
  var app = getAppFolderFromHta();
  if (!exe || !fileExists(exe)) {
    if (onDone) onDone({ error: "NvidiaAutomationV2.exe introuvable â€” lancez tools/nvidia-automation-v2/build.ps1" });
    return;
  }
  if (!app) {
    if (onDone) onDone({ error: "Dossier application introuvable" });
    return;
  }
  var fso = getFso();
  var resultPath = getAbsolutePathFs(app + "\\logs\\nv-extra-it-result.json");
  try {
    var logsDir = fso.GetParentFolderName(resultPath);
    if (logsDir && !fso.FolderExists(logsDir)) fso.CreateFolder(logsDir);
    if (fso.FileExists(resultPath)) fso.DeleteFile(resultPath, true);
  } catch (ePrep) {}

  var args = "--disable-inverse-telecine-registry-only --json --purpleboost-root \"" + app + "\" --result-file \"" + resultPath + "\"";
  appendNvGamingLogLine("NV_EXTRA_IT admin ShellExecute runas result=" + resultPath);
  try {
    launchFileAsAdminWithArgs(exe, args);
  } catch (eLaunch) {
    if (onDone) onDone({ error: "Ã‰lÃ©vation administrateur refusÃ©e ou impossible" });
    return;
  }

  var t0 = new Date().getTime();
  var waitMs = 120000;
  function finish(r) { if (onDone) onDone(r); }
  function tryRead() {
    try {
      if (!fso.FileExists(resultPath)) return null;
      var raw = readTextFileAll(resultPath);
      var payload = parseNvV2JsonFromRaw(raw);
      if (payload && payload.inverseTelecine) return { payload: payload };
    } catch (eR) {}
    return null;
  }
  function poll() {
    if (new Date().getTime() - t0 > waitMs) {
      finish({
        error: "timeout",
        payload: makeEmptyNvV2Payload("Action non lancÃ©e en administrateur ou timeout UAC")
      });
      return;
    }
    var got = tryRead();
    if (got) {
      finish(got);
      return;
    }
    window.setTimeout(poll, 500);
  }
  window.setTimeout(poll, 800);
}

function applyNvExtraInverseTelecineFromUi() {
  setNvExtraRegStatus("DÃ©sactivation tÃ©lÃ©cinÃ© inversÃ©e (Ã©lÃ©vation admin)â€¦", "progress");
  appendNvGamingLogLine("NV_EXTRA=inverse_telecine_admin");
  runNvExtraInverseTelecineAdminAsync(function (r) {
    var payload = (r && r.payload) ? r.payload : null;
    var step = (payload && payload.inverseTelecine) ? payload.inverseTelecine : { status: "Failed", message: r && r.error ? r.error : "Ã©chec", verified: false, changed: false };
    var internal = nvExtraMapV2TelecineStep(step);
    var ui = nvExtraRenderUi(internal);
    setNvExtraRegStatus(nvExtraFormatStatusLine("TÃ©lÃ©cinÃ© inversÃ©e", ui), ui.tone);
    appendNvGamingLogLine("NV_EXTRA_IT status=" + internal.status + " verified=" + internal.verified + " changed=" + (step.changed === true));
  });
}

