function applyInverseTelecineOffTestFromUi() {
  setNvGamingStatus("TÃ©lÃ©cinÃ© inversÃ©e OFF (registre)â€¦", "progress");
  runNvidiaAutomationV2ExecAsync("--disable-inverse-telecine-registry-only", "nvidia-inverse-telecine", 20000, function (r) {
    try {
      var payload = (r && r.payload) ? r.payload : makeEmptyNvV2Payload(r && r.error ? r.error : "RÃ©ponse V2 partielle");
      var step = payload.inverseTelecine || { status: "Failed", message: r && r.error ? r.error : "Ã‰chec", verified: false };
      var label = nvInverseTelecineUiLabel(step);
      var st = (label === "OFF") ? "ok" : (label === "Non vÃ©rifiÃ©" ? "warn" : "bad");
      finishNvPanelTest("", "TÃ©lÃ©cinÃ© inversÃ© : " + label, st, { inverseTelecine: step }, step);
    } catch (e) {
      finishNvPanelTest("", "Erreur test tÃ©lÃ©cinÃ© inversÃ©", "bad", { inverseTelecine: { status: "Failed", message: String(e.message || e), verified: false } }, null);
    }
  });
}

function applyDigitalVibrance80TestFromUi() {
  setNvGamingStatus("Ã‰clat numÃ©rique 80%â€¦", "progress");
  var box = $("nvidiaGamingSteps");
  if (box) { box.style.display = "none"; box.innerHTML = ""; }
  window.setTimeout(function () {
    try {
      appendNvGamingLogLine("ACTION=apply_digital_vibrance_80_test");
      var dvRun = runNvidiaAutomationV2ApplyDigitalVibrance80();
      var payload = dvRun;
      if (!payload || payload.error) {
        setNvGamingStatus(payload && payload.error ? payload.error : "Ã‰clat numÃ©rique 80% : Ã©chec", "bad");
        return;
      }
      var step = payload.digitalVibrance || {};
      renderNvGamingStepsPanel({ digitalVibrance: step });
      if (step.status === "Success" && step.verified) {
        setNvGamingStatus("Ã‰clat numÃ©rique 80% : OK", "ok");
        appendNvGamingLogLine("DV80_TEST=ok");
      } else {
        setNvGamingStatus("Ã‰clat numÃ©rique 80% : " + (step.message || step.status), "bad");
        appendNvGamingLogLine("DV80_TEST=failed");
      }
    } catch (eTop) {
      appendNvGamingLogLine("DV80_EXCEPTION=" + String(eTop.message || eTop));
      setNvGamingStatus("Erreur test Ã©clat numÃ©rique 80%", "bad");
    }
  }, 30);
}

