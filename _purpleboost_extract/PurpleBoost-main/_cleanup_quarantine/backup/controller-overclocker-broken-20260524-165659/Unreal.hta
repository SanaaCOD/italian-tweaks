      } else if (label === "Outil manquant") {
        setNvGamingStatus("G-Sync : Outil manquant", "bad");
        appendNvGamingLogLine("GSYNC_OFF_TEST=missing_tool");
      } else if (label === "Ã‰chec") {
        setNvGamingStatus("G-Sync : Ã‰chec â€” " + (step.message || ""), "bad");
        appendNvGamingLogLine("GSYNC_OFF_TEST=failed");
      } else {
        setNvGamingStatus("G-Sync : Statut inconnu", "warn");
        appendNvGamingLogLine("GSYNC_OFF_TEST=unknown");
      }
    } catch (eTop) {
      appendNvGamingLogLine("GSYNC_OFF_EXCEPTION=" + String(eTop.message || eTop));
      setNvGamingStatus("Erreur test G-Sync OFF", "bad");
    }
  }, 30);
}

function runNvidiaAutomationV2(skipNip, skipDisplay, skipDigitalVibrance) {
  var args = "--apply-all";
  if (skipNip) args += " --skip-nip";
  if (skipDisplay) args += " --skip-display";
  if (skipDigitalVibrance) args += " --skip-digital-vibrance";
  var r = runNvidiaAutomationV2Exec(args, "nvidia-automation-v2", 300000);
  if (r.error) return r.payload || { error: r.error };
  return r.payload;
}

var nvGamingIsBusy = false;
var nvGamingIsRunning = false;
var nvGamingIsLoading = false;

function setNvGamingBusyFlags(busy) {
  nvGamingIsBusy = !!busy;
  nvGamingIsRunning = !!busy;
  nvGamingIsLoading = !!busy;
}

function stopNvGamingLoader(btn) {
  setNvGamingBusyFlags(false);
  appendNvGamingLogLine("Loader stopped");
  if (btn) {
    btn.disabled = false;
    appendNvGamingLogLine("Button re-enabled");
  }
  var resetBtn = $("btnResetNvPanel");
  if (resetBtn) resetBtn.disabled = false;
}

function startNvGamingLoader(btn) {
  setNvGamingBusyFlags(true);
  if (btn) btn.disabled = true;
  var resetBtn = $("btnResetNvPanel");
  if (resetBtn) resetBtn.disabled = true;
}

function nvStepOutcomeLabel(step) {
  if (!step || !step.status) return "Failed";
  if (step.status === "Success" && step.verified) return "OK";
  if (step.status === "Skipped") return "Skipped";
  return "Failed";
}

function applyNvidiaGamingOptimizationFromUi() {
  if (nvGamingIsBusy) return;
  driversWorkflowState.optDone = false;
  driversWorkflowState.optError = false;
  driversWorkflowState.optPct = 0;
  updateDriversWorkflowGuide();
  nvGamingDisplayCache = null;
  var btn = $("btnApplyNvidiaGaming");
  var box = $("nvidiaGamingSteps");
  if (box) { box.style.display = "none"; box.innerHTML = ""; }
  var wrap = $("nvOptProgressWrap");
  if (wrap) wrap.style.display = "block";
  resetNvOptProgress(false);
  startNvGamingLoader(btn);
  setNvGamingStatus("Optimisation Nvidia en coursâ€¦", "progress");
  window.setTimeout(function () {
    try {
      runFullNvidiaOptimizationWithProgress(btn);
    } catch (eTop) {
      appendNvGamingLogLine("EXCEPTION=" + String(eTop.message || eTop));
      setNvGamingStatus("Erreur interne optimisation Nvidia", "bad");
      stopNvGamingLoader(btn);
    }
  }, 30);
}

function applyNvidiaGamingOptimizationImpl(btn) {
  runFullNvidiaOptimizationWithProgress(btn);
}

function runFullNvidiaOptimizationWithProgress(btn) {
  purgeObsoleteNvidiaLogs();
  ensureNvFinalLogDir();
  preventUnrealHtaRelaunch("full-opt-start");
  var cfg = loadNvidiaOptimizationConfig();
  var startedAt = new Date().toISOString();
  var fullResult = initNvFullOptResult(startedAt);
  fullResult.steps.digitalVibrance.value = cfg.digitalVibrance || 80;
  var nvPanelProgressTimers = [];

  appendNvGamingLogLine("DATE=" + startedAt);
  appendNvGamingLogLine("ACTION=apply_nvidia_full_optimization");
  appendNvFinalLog("nvidia-full-optimization.log", "DÃ©but optimisation NVIDIA complÃ¨te");
  appendNvFinalLog("nvidia-full-optimization.log",
    "experimentalKeepUnrealInFrontDuringPanelAutomation=" + (cfg.experimentalKeepUnrealInFrontDuringPanelAutomation === true));
  if (cfg.experimentalKeepUnrealInFrontDuringPanelAutomation === true) {
    appendNvFinalLog("nvidia-full-optimization.log", "Mode expÃ©rimental actif â€” Unreal devant, panneau NVIDIA derriÃ¨re");
    appendNvGamingLogLine("NV_EXP_PANEL_MODE=experimental-unreal-front");
  } else {
    appendNvFinalLog("nvidia-full-optimization.log", "Mode fiable â€” panneau NVIDIA visible au premier plan");
    appendNvGamingLogLine("NV_EXP_PANEL_MODE=reliable-panel-front");
  }

  function clearNvPanelProgressTimers() {
    var i;
    for (i = 0; i < nvPanelProgressTimers.length; i++) {
      try { window.clearTimeout(nvPanelProgressTimers[i]); } catch (eT) {}
    }
    nvPanelProgressTimers = [];
  }

  function finalizeAll() {
    try {
      var allOk = true;
      if (cfg.runNipProfile && fullResult.steps.nip.status !== "success") allOk = false;
      if (cfg.runDigitalVibrance && fullResult.steps.digitalVibrance.status !== "success") allOk = false;
      if (cfg.runDisplaySettings) {
        if (!isDisplayStepOkForFlow(fullResult.steps.display.resolution.status)) allOk = false;
        if (!isDisplayStepOkForFlow(fullResult.steps.display.refreshRate.status)) allOk = false;
      }
      if (cfg.runPanelSettings && !isPanelStepOkForFlow(fullResult.steps.panelSettings.status)) allOk = false;
      fullResult.success = allOk;
      fullResult.endedAt = new Date().toISOString();

      function finishOptimizationUi() {
        writeNvFullOptimizationResultJson(fullResult);
        renderNvFullOptimizationSummary(fullResult);
        setNvGamingStatusFromFullOpt(fullResult);
        appendNvFinalLog("nvidia-full-optimization.log", "Fin optimisation success=" + allOk);
        appendNvGamingLogLine("NV_FULL_OPT done success=" + allOk);
        stopNvGamingLoader(btn);
      }

      function bringUnrealFrontIfConfigured(thenFn) {
        var broughtFront = false;
        if (cfg.bringUnrealToFrontAtEnd !== false) {
          focusCurrentHtaWindowOnly();
          broughtFront = true;
          appendNvGamingLogLine("NV_PANEL_CLOSE unreal-front=yes");
        }
        appendNvFinalLog("nvidia-full-optimization.log", "Unreal remis au premier plan " + (broughtFront ? "oui" : "non"));
        if (thenFn) window.setTimeout(thenFn, 100);
      }

      function closeNvidiaPanelAtEndThenFinish() {
        appendNvFinalLog("nvidia-full-optimization.log", "Progression 100 %");
        appendNvFinalLog("nvidia-full-optimization.log", "Unreal laissÃ© ouvert");
        if (cfg.closeNvidiaPanelAtEnd === false) {
          appendNvFinalLog("nvidia-full-optimization.log", "Fermeture panneau NVIDIA demandÃ©e : non (config)");
          bringUnrealFrontIfConfigured(finishOptimizationUi);
          return;
        }
        appendNvFinalLog("nvidia-full-optimization.log", "Fermeture panneau NVIDIA demandÃ©e");
        window.setTimeout(function () {
          runNvidiaPanelClickerExecAsync("close-panel", "nv-panel-close", 30000, function (r) {
            var payload = (r && r.payload) ? r.payload : null;
            var closed = payload && payload.success !== false && payload.uiStatus !== "error";
            var nvcplKill = "non";
            if (payload && payload.children && payload.children.nvcpluiKilled) {
              nvcplKill = String(payload.children.nvcpluiKilled);
            }
            appendNvFinalLog("nvidia-full-optimization.log", "nvcplui.exe fermÃ© " + nvcplKill);
            appendNvFinalLog("nvidia-full-optimization.log", "Panneau NVIDIA fermÃ© : " + (closed ? "oui" : "non"));
            appendNvGamingLogLine("NV_PANEL_CLOSE closed=" + (closed ? "yes" : "no") + " nvcplui_kill=" + nvcplKill);
            bringUnrealFrontIfConfigured(finishOptimizationUi);
          });
        }, 500);
      }

      setProgress(100, "Optimisation NVIDIA complÃ¨te terminÃ©e", closeNvidiaPanelAtEndThenFinish);
    } catch (eFin) {
      appendNvGamingLogLine("FINALIZE_EXCEPTION=" + String(eFin.message || eFin));
      setNvGamingStatus("Erreur finalisation optimisation NVIDIA", "bad");
      focusCurrentHtaWindowOnly();
      stopNvGamingLoader(btn);
    }
  }

  function runOpenPanelTask(logLabel, logTag, onDone) {
    appendNvFinalLog("nvidia-full-optimization.log", logLabel);
    appendNvGamingLogLine(logLabel);
    runNvidiaPanelClickerExecAsync("open-panel", logTag, 120000, function (r) {
      var payload = (r && r.payload) ? r.payload : null;
      var ok = payload && payload.success !== false && payload.uiStatus !== "error";
      var detail = ok ? "success" : "error";
      if (r && r.error && !payload) detail = "error";
      appendNvFinalLog("nvidia-full-optimization.log", "OPEN_PANEL " + detail + " (" + logLabel + ")");
      appendNvGamingLogLine("OPEN_PANEL " + detail + " tag=" + logTag);
      if (onDone) onDone(ok, r);
    });
  }

  var hasAcceptedNvidiaControlPanelLicense = false;

  function appendNvPanelLicenseLogLines(payload) {
    var lines = (payload && payload.logLines) ? payload.logLines : [];
    var i;
    for (i = 0; i < lines.length; i++) {
      try { appendNvGamingLogLine(String(lines[i])); } catch (eL) {}
      try { appendNvFinalLog("nvidia-full-optimization.log", String(lines[i])); } catch (eF) {}
    }
    if (payload && payload.message) {
      appendNvGamingLogLine("NV_PANEL_LICENSE " + payload.message);
    }
  }

  function runNvidiaPanelLicenseAcceptThen(onDone) {
    if (hasAcceptedNvidiaControlPanelLicense) {
      if (onDone) onDone();
      return;
    }
    appendNvFinalLog("nvidia-full-optimization.log", "VÃ©rification licence panneau NVIDIA");
    appendNvGamingLogLine("NV_PANEL_LICENSE check start");
    runNvidiaPanelClickerExecAsync("accept-panel-license", "nv-panel-license", 15000, function (r) {
      hasAcceptedNvidiaControlPanelLicense = true;
      var payload = (r && r.payload) ? r.payload : null;
      appendNvPanelLicenseLogLines(payload);
      if (!payload || !payload.logLines || payload.logLines.length === 0) {
        try { appendNvGamingLogLine("[NVIDIA Control Panel] Aucune licence dÃ©tectÃ©e, continuitÃ© normale."); } catch (eNo) {}
      }
      if (onDone) onDone();
    });
  }

  function runPanelCombinedAfterOpen(panelLog, t0, onDone) {
    appendNvFinalLog("04-panel-settings.log", "Lancement apply-panel-nvidia-settings");
    appendNvGamingLogLine("NV_PANEL lancement apply-panel-nvidia-settings");
    logNvOptProgress(65, "panel settings");
    nvPanelProgressTimers.push(window.setTimeout(function () {
      setNvOptProgress(80, "rÃ©glages panneau NVIDIA â€” mode performance");
      logNvOptProgress(80, "preview-performance");
    }, 12000));
    nvPanelProgressTimers.push(window.setTimeout(function () {
      setNvOptProgress(95, "rÃ©glages panneau NVIDIA â€” tÃ©lÃ©cinÃ© inversÃ©e");
      logNvOptProgress(95, "inverse-telecine");
    }, 28000));
    runNvidiaPanelClickerExecAsync("apply-panel-nvidia-settings", "nv-panel-combined", 270000, function (r) {
      clearNvPanelProgressTimers();
      var ms = new Date().getTime() - t0;
      var payload = (r && r.payload) ? r.payload : null;
      var hadErr = !!(r && r.error && !payload);
      if (hadErr || !payload || payload.success === false || payload.uiStatus === "error") {
        fullResult.steps.panelSettings.status = "error";
        fullResult.steps.panelSettings.label = "erreur";
        fullResult.steps.panelSettings.children.noScaling = "error";
        fullResult.steps.panelSettings.children.previewPerformance = "error";
        fullResult.steps.panelSettings.children.inverseTelecine = "error";
      } else if (payload && payload.children) {
        var ch = payload.children;
        fullResult.steps.panelSettings.children = {
          noScaling: mapPanelChildFromPayload(ch.noScaling || "error"),
          previewPerformance: mapPanelChildFromPayload(ch.previewPerformance || "error"),
          inverseTelecine: mapPanelChildFromPayload(ch.inverseTelecine || "error")
        };
        fullResult.steps.panelSettings.status = aggregatePanelSettingsStatus(fullResult.steps.panelSettings.children);
        fullResult.steps.panelSettings.label = panelLabelForStatus(fullResult.steps.panelSettings.status);
      } else {
        fullResult.steps.panelSettings.status = "error";
        fullResult.steps.panelSettings.label = "erreur";
      }
      fullResult.steps.panelSettings.verified = payload ? (payload.verified === true) : false;
      appendNvFinalStepLog("04-panel-settings.log", "panel-combined", "apply-panel-nvidia-settings",
        fullResult.steps.panelSettings.status,
        hadErr ? r.error : (payload ? payload.message : ""), ms);
      appendNvGamingLogLine("NV_PANEL_COMBINED status=" + fullResult.steps.panelSettings.status);
      if (payload && payload.children) {
        var ch = payload.children;
        appendNvFinalLog("nvidia-full-optimization.log", "rÃ©sultat no-scaling=" + (ch.noScaling || "?"));
        appendNvFinalLog("nvidia-full-optimization.log", "rÃ©sultat preview-performance=" + (ch.previewPerformance || "?"));
        appendNvFinalLog("nvidia-full-optimization.log", "rÃ©sultat inverse-telecine=" + (ch.inverseTelecine || "?"));
      }
      if (onDone) onDone();
    }, panelLog);
  }

  function runPanelStep(onDone) {
    if (!cfg.runPanelSettings) {
      fullResult.steps.panelSettings.status = "skipped";
      fullResult.steps.panelSettings.label = "ignorÃ©";
      appendNvFinalStepLog("04-panel-settings.log", "panel", "aucune", "skipped", "", 0);
      setProgress(65, "RÃ©glages panneau NVIDIA (ignorÃ©)", onDone);
      return;
    }
    setProgress(65, "RÃ©glages panneau NVIDIA", function () {
      var panelLog = getNvFinalLogDir() + "\\04-panel-settings.log";
      var t0 = new Date().getTime();
      runOpenPanelTask("OPEN_PANEL rappelÃ© avant apply-panel-nvidia-settings", "nv-panel-open-retry", function (openOk, openR) {
        if (!openOk) {
          var warnMsg = (openR && openR.error) ? openR.error : ((openR && openR.payload) ? openR.payload.message : "open-panel Ã©chec");
          appendNvFinalLog("04-panel-settings.log", "OPEN_PANEL retry warning: " + warnMsg);
          appendNvGamingLogLine("NV_PANEL_OPEN_RETRY warn=" + warnMsg);
        }
        appendNvFinalLog("nvidia-full-optimization.log", "panneau NVIDIA ouvert");
        runNvidiaPanelLicenseAcceptThen(function () {
        if (cfg.experimentalKeepUnrealInFrontDuringPanelAutomation === true) {
          appendNvFinalLog("nvidia-full-optimization.log", "Mode expÃ©rimental â€” panneau laissÃ© ouvert derriÃ¨re Unreal");
          focusCurrentHtaWindowOnly();
          appendNvFinalLog("nvidia-full-optimization.log", "Unreal remis devant avant rÃ©glages panneau : oui");
          appendNvGamingLogLine("NV_EXP_PANEL=unreal-front-before-panel-settings");
          window.setTimeout(function () {
            runPanelCombinedAfterOpen(panelLog, t0, onDone);
          }, 150);
        } else {
          appendNvFinalLog("nvidia-full-optimization.log", "Unreal remis devant avant rÃ©glages panneau : non");
          runPanelCombinedAfterOpen(panelLog, t0, onDone);
        }
        });
      });
    });
  }

  function runDisplayStep(onDone) {
    if (!cfg.runDisplaySettings) {
      fullResult.steps.display.status = "skipped";
      fullResult.steps.display.resolution.status = "skipped";
      fullResult.steps.display.refreshRate.status = "skipped";
      appendNvFinalStepLog("03-display.log", "display", "aucune", "skipped", "", 0);
      setProgress(45, "RÃ©solution / frÃ©quence (ignorÃ©)", onDone);
      return;
    }
    setProgress(45, "RÃ©solution / frÃ©quence", function () {
      var t0 = new Date().getTime();
      appendNvFinalLog("03-display.log", "RÃ©solution max + frÃ©quence max + G-Sync OFF");
      runNvGamingDisplayApplyAsync(function (d) {
        var payload = (d && d.payload) ? d.payload : (nvGamingDisplayCache ? nvGamingDisplayCache.payload : null);
        var resEval = evaluateDisplayResolutionStatus(d, payload);
        var hzEval = evaluateDisplayRefreshStatus(d, payload);
        fullResult.steps.display.resolution = resEval;
        fullResult.steps.display.refreshRate = hzEval;
        fullResult.steps.display.status = aggregateDisplayStepStatus(resEval, hzEval);
        appendNvFinalLog("03-display.log", "rÃ©solution=" + resEval.status + " frÃ©quence=" + hzEval.status);
        runNvidiaAutomationV2ExecAsync("--disable-gsync-only", "nvidia-gsync-off", 120000, function (gsyncRun) {
          if (!isDisplayStepOkForFlow(fullResult.steps.display.resolution.status)
              || !isDisplayStepOkForFlow(fullResult.steps.display.refreshRate.status)) {
            fullResult.steps.display.status = "error";
          }
          var ms = new Date().getTime() - t0;
          appendNvFinalStepLog("03-display.log", "display", "resolution+refresh+gsync",
            fullResult.steps.display.status,
            "res=" + resEval.status + " hz=" + hzEval.status, ms);
          appendNvGamingLogLine("DISPLAY_STEP res=" + resEval.status + " hz=" + hzEval.status);
          if (onDone) onDone();
        });
      });
    });
  }

  function runDigitalVibranceStep(onDone) {
    if (!cfg.runDigitalVibrance) {
      fullResult.steps.digitalVibrance.status = "skipped";
      appendNvFinalStepLog("02-digital-vibrance.log", "digitalVibrance", "aucune", "skipped", "", 0);
      setProgress(30, "Ã‰clat numÃ©rique (ignorÃ©)", onDone);
      return;
    }
    setProgress(30, "Ã‰clat numÃ©rique 80 %", function () {
      appendNvFinalLog("02-digital-vibrance.log", "Ã‰clat numÃ©rique " + (cfg.digitalVibrance || 80) + "%");
      var t0 = new Date().getTime();
      runNvidiaAutomationV2ExecAsync("--apply-digital-vibrance-80", "nvidia-dv80", 120000, function (dvRun) {
        var ms = new Date().getTime() - t0;
        var dvPayload = (dvRun && dvRun.payload) ? dvRun.payload : makeEmptyNvV2Payload(dvRun && dvRun.error ? dvRun.error : "");
        var step = dvPayload.digitalVibrance || { status: "Failed", verified: false };
        var st = nvFullOptMapV2Step(step);
        fullResult.steps.digitalVibrance.status = st;
        appendNvFinalStepLog("02-digital-vibrance.log", "digitalVibrance", "--apply-digital-vibrance-80", st,
          dvRun && dvRun.error ? dvRun.error : (step.message || ""), ms);
        appendNvGamingLogLine("DV_STEP status=" + st);
        if (onDone) onDone();
      });
    });
  }

  function runNipStep(onDone) {
    if (!cfg.runNipProfile) {
      fullResult.steps.nip.status = "skipped";
      appendNvFinalStepLog("01-nip.log", "nip", "aucune", "skipped", "", 0);
      setProgress(15, "Profil NVIDIA (ignorÃ©)", onDone);
      return;
    }
    setProgress(15, "Profil NVIDIA (.nip)", function () {
      appendNvFinalLog("01-nip.log", "Profil NVIDIA (.nip)");
      var inspector = resolveApplyNipInspectorPath();
      if (!inspector || !fileExists(inspector)) {
        fullResult.steps.nip.status = "error";
        appendNvFinalStepLog("01-nip.log", "nip", "ApplyNipProfile", "error", "NPI manquant", 0);
        if (onDone) onDone();
        return;
      }
      var nipPath = resolveApplyNipPresetPath();
      if (!nipPath || !fileExists(nipPath)) {
        fullResult.steps.nip.status = "error";
        appendNvFinalStepLog("01-nip.log", "nip", "ApplyNipProfile", "error", "nip manquant", 0);
        if (onDone) onDone();
        return;
      }
      var t0 = new Date().getTime();
      runNvidiaAutomationV2ExecAsync("--apply-nip", "nvidia-apply-nip", 180000, function (r) {
        var ms = new Date().getTime() - t0;
        var payload = (r && r.payload) ? r.payload : null;
        var step = (payload && payload.nipProfile) ? payload.nipProfile : {};
        var st = (step.status === "Success") ? "success" : "error";
        fullResult.steps.nip.status = st;
        appendNvFinalStepLog("01-nip.log", "nip", "ApplyNipProfile", st, step.message || (r && r.error ? r.error : ""), ms);
        appendNvGamingLogLine("NIP_STEP status=" + st);
        if (onDone) onDone();
      });
    });
  }

  try {
    setProgress(5, "Ouverture panneau NVIDIA", function () {
      runOpenPanelTask("OPEN_PANEL appelÃ© au dÃ©but optimisation complÃ¨te", "nv-panel-open-start", function (openOk, openR) {
        if (!openOk) {
          var errStart = (openR && openR.error) ? openR.error : ((openR && openR.payload) ? openR.payload.message : "open-panel Ã©chec");
          appendNvFinalLog("nvidia-full-optimization.log", "OPEN_PANEL dÃ©but en erreur (continue) : " + errStart);
          appendNvGamingLogLine("NV_PANEL_OPEN_START warn=" + errStart);
        }
        runNvidiaPanelLicenseAcceptThen(function () {
        runNipStep(function () {
          runDigitalVibranceStep(function () {
            runDisplayStep(function () {
              runPanelStep(finalizeAll);
            });
          });
        });
        });
      });
    });
  } catch (eTop) {
    appendNvGamingLogLine("EXCEPTION=" + String(eTop.message || eTop));
    appendNvFinalLog("nvidia-full-optimization.log", "EXCEPTION " + String(eTop.message || eTop));
    setNvGamingStatus("Erreur interne optimisation NVIDIA", "bad");
    stopNvGamingLoader(btn);
  }
}

function applyNvidiaPanelProfile() {
  applyNvidiaGamingOptimizationFromUi();
}
function runNvidiaNativeDriverSettingsReset() {
  createUnrealFolders();
  var fso = getFso();
  var psPath = UNREAL_LOGS + "\\nvidia-native-reset.ps1";
  var resultPath = UNREAL_LOGS + "\\nvidia-native-reset-result.json";
  var escResult = String(resultPath).replace(/'/g, "''");
  var lines = [
    "$ErrorActionPreference = 'Continue'",
    "$ResultPath = '" + escResult + "'",
    "$method = 'native-drs-clear'",
    "$sw = [System.Diagnostics.Stopwatch]::StartNew()",
    "$deleted = 0",
    "$errors = @()",
    "$pd = $env:ProgramData",
    "if (-not $pd) { $pd = 'C:\\ProgramData' }",
    "$drsDir = Join-Path $pd 'NVIDIA Corporation\\Drs'",
    "$targets = @()",
    "if (Test-Path -LiteralPath $drsDir) {",
    "  $targets += Get-ChildItem -LiteralPath $drsDir -File -ErrorAction SilentlyContinue | Where-Object { $_.Name -match '^(nvdrsdb|nvappdb)' }",
    "}",
    "$regPath = 'HKLM:\\SYSTEM\\CurrentControlSet\\Services\\nvlddmkm\\Global\\NVTweak'",
    "foreach ($f in $targets) {",
    "  try { Remove-Item -LiteralPath $f.FullName -Force -ErrorAction Stop; $deleted++ } catch { $errors += $_.Exception.Message }",
    "}",
    "if (Test-Path -LiteralPath $regPath) {",
    "  try { Remove-Item -LiteralPath $regPath -Recurse -Force -ErrorAction Stop; $deleted++ } catch { $errors += $_.Exception.Message }",
    "}",
    "$svcNames = @('NVDisplay.ContainerLocalSystem','NvContainerLocalSystem','nvcontainer','NVDisplay.Container')",
    "foreach ($sn in $svcNames) {",
    "  $svc = Get-Service -Name $sn -ErrorAction SilentlyContinue",
    "  if ($svc) {",
    "    try { Restart-Service -Name $sn -Force -ErrorAction SilentlyContinue } catch { $errors += ('svc:' + $sn + ' ' + $_.Exception.Message) }",
    "  }",
    "}",
    "Start-Sleep -Seconds 2",
    "$exitCode = 0",
    "if ($deleted -lt 1) { $exitCode = 20 }",
    "$sw.Stop()",
    "$payload = @{",
    "  exitCode = $exitCode",
    "  durationMs = [int]$sw.ElapsedMilliseconds",
    "  method = $method",
    "  deletedCount = $deleted",
    "  drsDir = $drsDir",
    "  errors = ($errors -join ' | ')",
    "  profileInspectorUsed = $false",
    "}",
    "$dir = Split-Path -Parent $ResultPath",
    "if ($dir -and -not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }",
    "($payload | ConvertTo-Json -Compress) | Out-File -LiteralPath $ResultPath -Encoding utf8 -Force",
    "exit $exitCode"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(lines.join("\r\n"));
  tw.Close();
  logNvidiaPanelDev("Reset natif  â€” commandes : suppression DRS + clÃ© NVTweak + redÃ©marrage services NVIDIA");
  logNvidiaPanelDev("Reset natif  â€” Profile Inspector NON utilisÃ©");
  var shellCode = runPowerShell("-File \"" + psPath + "\"");
  var out = {
    exitCode: shellCode,
    durationMs: 0,
    method: "native-drs-clear",
    deletedCount: 0,
    errors: "",
    profileInspectorUsed: false
  };
  try {
    if (fso.FileExists(resultPath)) {
      var json = readTextFileAll(resultPath);
      if (json) {
        var parsed = JSON.parse(json);
        if (parsed) {
          if (typeof parsed.exitCode !== "undefined") out.exitCode = parsed.exitCode;
          if (parsed.durationMs) out.durationMs = parsed.durationMs;
          if (parsed.method) out.method = parsed.method;
          if (typeof parsed.deletedCount !== "undefined") out.deletedCount = parsed.deletedCount;
          if (parsed.errors) out.errors = String(parsed.errors);
          if (typeof parsed.profileInspectorUsed !== "undefined") out.profileInspectorUsed = !!parsed.profileInspectorUsed;
        }
      }
      fso.DeleteFile(resultPath, true);
    }
  } catch (eJ) {}
  try { if (fso.FileExists(psPath)) fso.DeleteFile(psPath, true); } catch (eDel) {}
  logNvidiaPanelDev("Reset natif  â€” code=" + out.exitCode + " durÃ©e=" + out.durationMs + "ms Ã©lÃ©ments=" + out.deletedCount);
  if (out.errors) logNvidiaPanelDev("Reset natif  â€” avertissements : " + out.errors);
  return out;
}

function resetNvidiaPanelProfile() {
  setNvidiaPanelStatus("Reset NVIDIA en cours...", "progress");
  window.setTimeout(function () {
    try { resetNvidiaPanelProfileImpl(false); } catch (eTop) {
      logNvidiaPanelDev("Exception reset : " + String(eTop.message || eTop));
      setNvidiaPanelStatus("Erreur : reset NVIDIA impossible", "bad");
    }
  }, 20);
}

function resetNvidiaPanelFromDriversUi() {
  if (nvGamingIsBusy) return;
  var btn = $("btnResetNvPanel");
  setNvGamingStatus("Reset panneau NVIDIA en cours...", "progress");
  if (btn) btn.disabled = true;
  appendNvGamingLogLine("NV_RESET_PANEL start");
  try { appendNvFinalLog("nvidia-full-optimization.log", "Reset panneau NVIDIA demandÃ©"); } catch (eLog) {}
  window.setTimeout(function () {
    try {
      resetNvidiaPanelProfileImpl(true);
    } catch (eTop) {
      appendNvGamingLogLine("NV_RESET_PANEL exception=" + String(eTop.message || eTop));
      setNvGamingStatus("Erreur : reset panneau NVIDIA impossible", "bad");
    }
    if (btn) btn.disabled = false;
  }, 20);
}

function resetNvidiaPanelProfileImpl(driversCardUi) {
  var driversUi = driversCardUi === true;
  try {
    var appDir = getAppFolderFromHta();
    logNvidiaPanelDev("Reset  â€” dossier application : " + (appDir ? getAbsolutePathFs(appDir) : "(non rÃ©solu)"));
    logNvidiaPanelDev("Reset  â€” mÃ©thode : native-drs-clear (restaurÃ©e, sans .nip, sans Profile Inspector)");
    if (driversUi) appendNvGamingLogLine("NV_RESET_PANEL mÃ©thode=native-drs-clear (paramÃ¨tres 3D NVIDIA)");

    var run = runNvidiaNativeDriverSettingsReset();
    logNvidiaPanelDev("Reset  â€” fonction : runNvidiaNativeDriverSettingsReset");
    logNvidiaPanelDev("Reset  â€” code retour : " + run.exitCode + " | durÃ©e : " + run.durationMs + "ms | suppressions : " + run.deletedCount);
    if (driversUi) {
      appendNvGamingLogLine("NV_RESET_PANEL code=" + run.exitCode + " durÃ©eMs=" + run.durationMs + " suppressions=" + run.deletedCount);
      appendNvGamingLogLine("NV_RESET_PANEL note=rÃ©glages affichage panneau (mise Ã  l'Ã©chelle, performance, tÃ©lÃ©cinÃ©) non rÃ©initialisÃ©s par DRS");
    }

    if (run.exitCode === 1223 || run.exitCode === 5 || run.exitCode === 18) {
      setNvidiaPanelStatus(driversUi ? "Erreur : droits administrateur requis" : "Erreur : droits administrateur requis", "bad");
      if (driversUi) appendNvGamingLogLine("NV_RESET_PANEL error=admin_required");
      return;
    }

    if (run.exitCode !== 0 || run.deletedCount < 1) {
      setNvidiaPanelStatus(driversUi ? "Erreur : reset panneau NVIDIA impossible" : "Erreur : reset NVIDIA impossible", "bad");
      logNvidiaPanelDev("Reset Ã©chec : aucune base de rÃ©glages NVIDIA supprimÃ©e (code " + run.exitCode + ").");
      if (run.errors) logNvidiaPanelDev("Reset dÃ©tail : " + run.errors);
      if (driversUi) appendNvGamingLogLine("NV_RESET_PANEL error=drs_clear_failed");
      return;
    }

    setNvidiaPanelStatus(driversUi ? "Reset panneau NVIDIA terminÃ©" : "RÃ©glages NVIDIA restaurÃ©s", "ok");
    logNvidiaPanelDev("Reset confirmÃ© : bases DRS / NVTweak supprimÃ©es, services NVIDIA rechargÃ©s.");
    if (driversUi) appendNvGamingLogLine("NV_RESET_PANEL done=ok DRS/NVTweak");
  } catch (e) {
    logNvidiaPanelDev("Exception reset : " + String(e.message || e));
    setNvidiaPanelStatus(driversUi ? "Erreur : reset panneau NVIDIA impossible" : "Erreur : reset NVIDIA impossible", "bad");
    if (driversUi) appendNvGamingLogLine("NV_RESET_PANEL exception=" + String(e.message || e));
  }
}


/* ========== DDUAutomation (module indÃ©pendant) ==========
 * Ne pas appeler depuis NvidiaAutomationV2. Log : logs/ddu-open-download.log.
 * Fonctions : downloadOrOpenDdu, dduAutoCleanExperimental, launchDduAutoCleanAutomation, etc.
 */
/* ---------- Onglet Drivers : DDU (tÃ©lÃ©charger / ouvrir  â€” mÃªme lancement que HIDUSBF) ---------- */
var DDU_OFFICIAL_PAGE = "https://www.wagnardsoft.com/display-driver-uninstaller-ddu/";
var DDU_DIRECT_DOWNLOAD_URLS = [
  "https://www.wagnardsoft.com/DDU/download/DDU%20v18.1.4.5.zip",
  "https://www.wagnardsoft.com/DDU/download/DDU%20v18.0.8.9.zip"
];
var DDU_EXE_PRIMARY = "Display Driver Uninstaller.exe";
var DDU_EXE_NAMES = ["Display Driver Uninstaller.exe", "DDU.exe"];
var DDU_LOG_PATH = "";
var dduDetectState = { checking: false, found: false, exe: "", workDir: "", searchPaths: "", checked: false };
var dduStatusCheckGen = 0;

function initDduOpenDownloadLog() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) DDU_LOG_PATH = combinePath(app, "logs\\ddu-open-download.log");
  else DDU_LOG_PATH = combinePath(UNREAL_BASE, "logs\\ddu-open-download.log");
}

function writeDduOpenDownloadLog(line) {
  initDduOpenDownloadLog();
  var fso = getFso();
  var folder = fso.GetParentFolderName(DDU_LOG_PATH);
  if (folder && !fso.FolderExists(folder)) fso.CreateFolder(folder);
  var ForAppending = 8;
  if (!fso.FileExists(DDU_LOG_PATH)) {
    var t0 = fso.CreateTextFile(DDU_LOG_PATH, true);
    t0.WriteLine(line);
    t0.Close();
  } else {
    var t1 = fso.OpenTextFile(DDU_LOG_PATH, ForAppending, true);
    t1.WriteLine(line);
    t1.Close();
  }
}

function dduExeNameMatches(name) {
  var n = String(name || "").toLowerCase();
  var i;
  for (i = 0; i < DDU_EXE_NAMES.length; i++) {
    if (n === DDU_EXE_NAMES[i].toLowerCase()) return true;
  }
  return false;
}

function dduFolderNameMatches(name) {
  var n = String(name || "").toLowerCase();
  if (n.indexOf("display driver uninstaller") >= 0) return true;
  if (n === "ddu") return true;
  if (n.indexOf("ddu") >= 0 && n.length <= 32) return true;
  return false;
}

function findDduExeInFolder(fso, folderPath, depth) {
  if (!folderPath || depth > 3 || !fso.FolderExists(folderPath)) return "";
  try {
    var folder = fso.GetFolder(folderPath);
    var fe = new Enumerator(folder.Files);
    for (; !fe.atEnd(); fe.moveNext()) {
      if (dduExeNameMatches(fe.item().Name)) return getAbsolutePathFs(fe.item().Path);
    }
    if (depth >= 3) return "";
    var fs = new Enumerator(folder.SubFolders);
    for (; !fs.atEnd(); fs.moveNext()) {
      var subPath = getAbsolutePathFs(fs.item().Path);
      var subName = String(fs.item().Name || "");
      if (dduFolderNameMatches(subName) || depth === 0) {
        var got = findDduExeInFolder(fso, subPath, depth + 1);
        if (got) return got;
      }
    }
  } catch (eTree) {}
  return "";
}

function buildDduSearchRoots() {
  var fso = getFso();
  var sh = getShell();
  var roots = [];
  var seen = {};
  function add(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d] || !fso.FolderExists(d)) return;
    seen[d] = true;
    roots.push(d);
  }
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) {
    add(combinePath(app, "tools\\DDU"));
    add(combinePath(app, "tools"));
  }
  try { add(sh.SpecialFolders("Desktop")); } catch (eD1) {}
  try { add(sh.SpecialFolders("MyDocuments")); } catch (eD2) {}
  try { add(sh.ExpandEnvironmentStrings("%USERPROFILE%\\Downloads")); } catch (eDl) {}
  add("C:\\Program Files");
  add("C:\\Program Files (x86)");
  return roots;
}

function getToolsPathsConfigPath() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (!app) return "";
  return combinePath(app, "config\\tools-paths.json");
}

function readToolsPathsConfig() {
  try {
    var p = getToolsPathsConfigPath();
    var txt = readTextFileAll(p);
    if (txt) return JSON.parse(txt);
  } catch (eCfg) {}
  return {};
}

function writeToolsPathsConfig(patch) {
  var prev = readToolsPathsConfig();
  var next = {};
  var k;
  for (k in prev) if (prev.hasOwnProperty(k)) next[k] = prev[k];
  for (k in patch) if (patch.hasOwnProperty(k)) next[k] = patch[k];
  var p = getToolsPathsConfigPath();
  if (!p) return;
  var fso = getFso();
  var folder = fso.GetParentFolderName(p);
  if (folder && !fso.FolderExists(folder)) fso.CreateFolder(folder);
  var tw = fso.CreateTextFile(p, true);
  tw.Write(JSON.stringify(next));
  tw.Close();
}

function getDduPathFromCache() {
  var cfg = readToolsPathsConfig();
  var path = getAbsolutePathFs(String(cfg.dduPath || ""));
  if (path && getFso().FileExists(path)) return path;
  if (cfg.dduPath) writeToolsPathsConfig({ dduPath: "" });
  return "";
}

function saveDduPathToCache(exePath) {
  if (exePath) writeToolsPathsConfig({ dduPath: getAbsolutePathFs(exePath) });
}

function findDduOnPc() {
  var fso = getFso();
  var roots = buildDduSearchRoots();
  var pathsList = roots.join(" | ");
  var ri;
  for (ri = 0; ri < roots.length; ri++) {
    var exe = findDduExeInFolder(fso, roots[ri], 0);
    if (exe) return { found: true, exe: exe, workDir: fso.GetParentFolderName(exe), searchPaths: pathsList };
  }
  return { found: false, exe: "", workDir: "", searchPaths: pathsList };
}

function dduShortPathLabel(exePath) {
  try {
    return getFso().GetParentFolderName(exePath);
  } catch (eP) {
    return String(exePath || "");
  }
}

function writeDduStatusCheckLog(fields) {
  fields = fields || {};
  initDduOpenDownloadLog();
  writeDduOpenDownloadLog("DATE=" + new Date().toISOString());
  writeDduOpenDownloadLog("ACTION=ddu_status_check");
  if (fields.CACHE_PATH != null) writeDduOpenDownloadLog("CACHE_PATH=" + fields.CACHE_PATH);
  if (fields.CACHE_VALID != null) writeDduOpenDownloadLog("CACHE_VALID=" + fields.CACHE_VALID);
  if (fields.SEARCH_STARTED != null) writeDduOpenDownloadLog("SEARCH_STARTED=" + fields.SEARCH_STARTED);
  if (fields.SEARCH_PATHS != null) writeDduOpenDownloadLog("SEARCH_PATHS=" + fields.SEARCH_PATHS);
  if (fields.DDU_FOUND != null) writeDduOpenDownloadLog("DDU_FOUND=" + fields.DDU_FOUND);
  if (fields.DDU_PATH != null) writeDduOpenDownloadLog("DDU_PATH=" + fields.DDU_PATH);
  if (fields.STATUS_SHOWN != null) writeDduOpenDownloadLog("STATUS_SHOWN=" + fields.STATUS_SHOWN);
  writeDduOpenDownloadLog("");
}

function setDduDetectStateFromHit(hit) {
  if (hit && hit.found && hit.exe) {
    dduDetectState.found = true;
    dduDetectState.exe = hit.exe;
    dduDetectState.workDir = hit.workDir || "";
    dduDetectState.searchPaths = hit.searchPaths || "";
    saveDduPathToCache(hit.exe);
    return;
  }
  dduDetectState.found = false;
  dduDetectState.exe = "";
  dduDetectState.workDir = "";
}

function applyDduDetectUi() {
  if (dduDetectState.checking) {
    setDduOpenDownloadBadge("VÃ©rification...", "progress");
    setDduStatus("VÃ©rification DDU...", "info");
    setDduOpenDownloadButtonBusy(true, "VÃ©rification...");
    return;
  }
  if (dduDetectState.found && dduDetectState.exe) {
    setDduOpenDownloadBadge("DDU dÃ©tectÃ©", "ok");
    setDduStatus("DDU dÃ©tectÃ© : " + dduShortPathLabel(dduDetectState.exe), "success");
    setDduOpenDownloadButtonLabel("Ouvrir DDU");
    return;
  }
  setDduOpenDownloadBadge("TÃ©lÃ©chargement nÃ©cessaire", "warn");
  setDduStatus("DDU non dÃ©tectÃ©. TÃ©lÃ©chargement nÃ©cessaire.", "info");
  setDduOpenDownloadButtonLabel("TÃ©lÃ©charger / Ouvrir DDU");
}

function setDduOpenDownloadButtonLabel(text) {
  var btn = $("btnDduOpenDownload");
  if (!btn) return;
  btn.innerText = text || "TÃ©lÃ©charger / Ouvrir DDU";
  btn.disabled = false;
}

function runDduStatusCheckImpl() {
  var fso = getFso();
  var cachePath = getDduPathFromCache();
  var cacheValid = cachePath ? "oui" : "non";
  if (cachePath) {
    dduDetectState.found = true;
    dduDetectState.exe = cachePath;
    dduDetectState.workDir = fso.GetParentFolderName(cachePath);
    dduDetectState.checking = false;
    dduDetectState.checked = true;
    applyDduDetectUi();
    writeDduStatusCheckLog({
      CACHE_PATH: cachePath,
      CACHE_VALID: "oui",
      SEARCH_STARTED: "non",
      DDU_FOUND: "oui",
      DDU_PATH: cachePath,
      STATUS_SHOWN: "DDU dÃ©tectÃ©"
    });
    return;
  }
  var search = findDduOnPc();
  dduDetectState.searchPaths = search.searchPaths;
  if (search.found) {
    setDduDetectStateFromHit(search);
    writeDduStatusCheckLog({
      CACHE_PATH: "",
      CACHE_VALID: cacheValid,
      SEARCH_STARTED: "oui",
      SEARCH_PATHS: search.searchPaths,
      DDU_FOUND: "oui",
      DDU_PATH: search.exe,
      STATUS_SHOWN: "DDU dÃ©tectÃ©"
    });
  } else {
    setDduDetectStateFromHit(null);
    writeDduStatusCheckLog({
      CACHE_PATH: "",
      CACHE_VALID: cacheValid,
      SEARCH_STARTED: "oui",
      SEARCH_PATHS: search.searchPaths,
      DDU_FOUND: "non",
      DDU_PATH: "",
      STATUS_SHOWN: "TÃ©lÃ©chargement nÃ©cessaire"
    });
  }
  dduDetectState.checking = false;
  dduDetectState.checked = true;
  applyDduDetectUi();
}

function beginDduDriversTabCheck() {
  dduDetectState.checking = true;
  dduDetectState.checked = false;
  applyDduDetectUi();
  var gen = ++dduStatusCheckGen;
  window.setTimeout(function () {
    if (gen !== dduStatusCheckGen) return;
    runDduStatusCheckImpl();
  }, 10);
}

function ensureAppDduInstallDir() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (!app) return "";
  var dir = combinePath(app, "tools\\DDU");
  var fso = getFso();
  try {
    var tools = combinePath(app, "tools");
    if (!fso.FolderExists(tools)) fso.CreateFolder(tools);
    if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
  } catch (eMk) {}
  return dir;
}

function expandDduZipLikeHidusbf(zipPath, extractDir) {
  var fso = getFso();
  var tmp = fso.GetSpecialFolder(2);
  var psPath = tmp + "\\unreal-ddu-expand.ps1";
  var z = zipPath.replace(/'/g, "''");
  var d = extractDir.replace(/'/g, "''");
  var body =
    "$ErrorActionPreference='Stop'\r\n" +
    "New-Item -ItemType Directory -Force -Path '" + d + "' | Out-Null\r\n" +
    "Unblock-File -LiteralPath '" + z + "' -ErrorAction SilentlyContinue\r\n" +
    "Expand-Archive -LiteralPath '" + z + "' -DestinationPath '" + d + "' -Force\r\n" +
    "exit 0\r\n";
  try {
    var tw = fso.CreateTextFile(psPath, true);
    tw.Write(body);
    tw.Close();
  } catch (eW) {
    return false;
  }
  return getShell().Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psPath + "\"", 0, true) === 0;
}

function openDduOfficialPage() {
  getShell().Run('cmd /c start "" "' + DDU_OFFICIAL_PAGE + '"', 1, false);
}

function tryDownloadDduToAppFolder() {
  var destDir = ensureAppDduInstallDir();
  if (!destDir) return { ok: false, error: "Dossier tools\\DDU introuvable", source: DDU_OFFICIAL_PAGE };
  var fso = getFso();
  var i;
  for (i = 0; i < DDU_DIRECT_DOWNLOAD_URLS.length; i++) {
    var url = DDU_DIRECT_DOWNLOAD_URLS[i];
    var ext = /\.zip/i.test(url) ? ".zip" : ".exe";
    var destFile = combinePath(destDir, "ddu-download" + i + ext);
    try {
      downloadFile(url, destFile);
    } catch (eDl) {
      continue;
    }
    if (!fso.FileExists(destFile) || fso.GetFile(destFile).Size < 500000) continue;
    if (/\.zip$/i.test(destFile)) {
      if (!expandDduZipLikeHidusbf(destFile, destDir)) continue;
    }
    var exe = findDduExeInFolder(fso, destDir, 0);
    if (exe) return { ok: true, exe: exe, workDir: fso.GetParentFolderName(exe), source: url };
  }
  return { ok: false, error: "TÃ©lÃ©chargement direct impossible", source: DDU_OFFICIAL_PAGE };
}

function launchDduLikeHidusbf(exePath) {
  launchFileAsAdmin(exePath);
}

function setDduOpenDownloadBadge(text, kind) {
  var el = $("dduStatusBadge");
  if (!el) return;
  el.innerText = text || "â€”";
  var cls = "tcp-badge";
  if (kind === "ok") cls += " tcp-badge--ok";
  else if (kind === "warn") cls += " tcp-badge--warn";
  else if (kind === "progress") cls += " tcp-badge--progress";
  else if (kind === "bad") cls += " tcp-badge--bad";
  else cls += " tcp-badge--progress";
  el.className = cls;
}

function setDduStatus(message, type) {
  var el = $("dduStatus");
  if (!el) return;
  el.innerText = message || "";
  el.className = "tool-status" + (type ? " tool-status--" + type : "");
}

function setDduOpenDownloadButtonBusy(busy, label) {
  var btn = $("btnDduOpenDownload");
  if (!btn) return;
  btn.disabled = !!busy;
  if (label) btn.innerText = label;
}

function refreshDduCardUi(forceRescan) {
  if (forceRescan) {
    writeToolsPathsConfig({ dduPath: "" });
    dduDetectState.found = false;
    dduDetectState.exe = "";
  }
  beginDduDriversTabCheck();
}

function downloadOrOpenDduOpenOnly() {
  try {
    initDduOpenDownloadLog();
    writeDduOpenDownloadLog("DATE=" + new Date().toISOString());
    writeDduOpenDownloadLog("ACTION=open_download_ddu");
    writeDduOpenDownloadLog("DDU_PATH=" + dduDetectState.exe);
    writeDduOpenDownloadLog("LAUNCH_METHOD=same_as_hidusbf");
    setDduStatus("Ouverture de DDU...", "info");
    launchDduLikeHidusbf(dduDetectState.exe);
    writeDduOpenDownloadLog("LAUNCH_RESULT=ok");
    setDduStatus("DDU ouvert.", "success");
  } catch (eOpen) {
    var err = String(eOpen.message || eOpen);
    writeDduOpenDownloadLog("LAUNCH_RESULT=erreur");
    writeDduOpenDownloadLog("ERROR=" + err);
    setDduStatus("Erreur : " + err, "error");
  } finally {
    setDduOpenDownloadButtonBusy(false);
    applyDduDetectUi();
  }
}

function downloadOrOpenDduRun() {
  try {
    initDduOpenDownloadLog();
    writeDduOpenDownloadLog("DATE=" + new Date().toISOString());
    writeDduOpenDownloadLog("ACTION=open_download_ddu");
    initApplicationBaseDirectory();
    var appRoot = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
    writeDduOpenDownloadLog("APP_ROOT=" + appRoot);

    var search = findDduOnPc();
    writeDduOpenDownloadLog("SEARCH_PATHS=" + search.searchPaths);
    writeDduOpenDownloadLog("DDU_FOUND=" + (search.found ? "oui" : "non"));

    if (search.found) {
      setDduDetectStateFromHit(search);
      writeDduOpenDownloadLog("DDU_PATH=" + search.exe);
      writeDduOpenDownloadLog("DOWNLOAD_ATTEMPTED=non");
      writeDduOpenDownloadLog("LAUNCH_METHOD=same_as_hidusbf");
      setDduStatus("DDU dÃ©tectÃ©, ouverture...", "info");
      try {
        launchDduLikeHidusbf(search.exe);
        writeDduOpenDownloadLog("LAUNCH_RESULT=ok");
        setDduStatus("DDU ouvert.", "success");
      } catch (eLaunch) {
        var err = String(eLaunch.message || eLaunch);
        writeDduOpenDownloadLog("LAUNCH_RESULT=erreur");
        writeDduOpenDownloadLog("ERROR=" + err);
        setDduStatus("Erreur : " + err, "error");
      }
      applyDduDetectUi();
      return;
    }

    setDduDetectStateFromHit(null);
    setDduStatus("DDU introuvable, tÃ©lÃ©chargement...", "info");
    writeDduOpenDownloadLog("DOWNLOAD_ATTEMPTED=oui");

    var dl = tryDownloadDduToAppFolder();
    writeDduOpenDownloadLog("DOWNLOAD_SOURCE=" + (dl.source || DDU_OFFICIAL_PAGE));
    writeDduOpenDownloadLog("DOWNLOAD_RESULT=" + (dl.ok ? "ok" : "erreur"));

    if (dl.ok && dl.exe) {
      setDduDetectStateFromHit({ found: true, exe: dl.exe, workDir: dl.workDir || "", searchPaths: search.searchPaths });
      writeDduOpenDownloadLog("DDU_PATH=" + dl.exe);
      writeDduOpenDownloadLog("LAUNCH_METHOD=same_as_hidusbf");
      setDduStatus("TÃ©lÃ©chargement terminÃ©, ouverture...", "info");
      try {
        launchDduLikeHidusbf(dl.exe);
        writeDduOpenDownloadLog("LAUNCH_RESULT=ok");
        setDduStatus("DDU ouvert.", "success");
      } catch (e2) {
        var err2 = String(e2.message || e2);
        writeDduOpenDownloadLog("LAUNCH_RESULT=erreur");
        writeDduOpenDownloadLog("ERROR=" + err2);
        setDduStatus("Erreur : " + err2, "error");
      }
      applyDduDetectUi();
      return;
    }

    writeDduOpenDownloadLog("ERROR=" + (dl.error || "Ã©chec"));
    setDduStatus("DDU introuvable, ouverture de la page officielle...", "info");
    openDduOfficialPage();
    setDduStatus("TÃ©lÃ©charge DDU depuis la page officielle, puis relance le bouton.", "info");
    applyDduDetectUi();
  } catch (eRun) {
    var errRun = String(eRun.message || eRun);
    writeDduOpenDownloadLog("ERROR=" + errRun);
    setDduStatus("Erreur : " + errRun, "error");
    applyDduDetectUi();
  } finally {
    setDduOpenDownloadButtonBusy(false);
  }
}

function downloadOrOpenDdu() {
  if (dduDetectState.found && dduDetectState.exe && !getFso().FileExists(dduDetectState.exe)) {
    writeToolsPathsConfig({ dduPath: "" });
    dduDetectState.found = false;
    dduDetectState.exe = "";
  }
  if (dduDetectState.found && dduDetectState.exe && getFso().FileExists(dduDetectState.exe)) {
    setDduOpenDownloadButtonBusy(true, "Ouverture...");
    setDduStatus("Ouverture de DDU...", "info");
    window.setTimeout(downloadOrOpenDduOpenOnly, 10);
    return;
  }
  setDduOpenDownloadButtonBusy(true, "Recherche...");
  setDduStatus("Recherche de DDU...", "info");
  window.setTimeout(downloadOrOpenDduRun, 10);
}

/* ---------- DDU : nettoyage GPU auto (expÃ©rimental, AutoHotkey v2 + UIA) ---------- */
var AUTOHOTKEY_OFFICIAL_PAGE = "https://www.autohotkey.com/";
var AUTOHOTKEY_URL_1 = "https://www.autohotkey.com/download/ahk-v2.zip";
var AUTOHOTKEY_URL_2 = "https://github.com/AutoHotkey/AutoHotkey/releases/download/v2.0.26/AutoHotkey_2.0.26.zip";
var AUTOHOTKEY_ZIP_NAME = "AutoHotkey-v2.zip";
var AUTOHOTKEY_EXE_PRIORITY_64 = [
  "AutoHotkey64.exe",
  "AutoHotkeyU64.exe",
  "AutoHotkey.exe",
  "AutoHotkey32.exe",
  "AutoHotkeyU32.exe"
];
var AUTOHOTKEY_EXE_PRIORITY_32 = [
  "AutoHotkey32.exe",
  "AutoHotkeyU32.exe",
  "AutoHotkey.exe",
  "AutoHotkey64.exe",
  "AutoHotkeyU64.exe"
];
var DDU_AUTO_LOG_PATH = "";
var DDU_AUTO_LIVE_PATH = "";
var dduAutoCleanBusy = false;
var dduAutoCleanPollGen = 0;
var dduExitWatcherGen = 0;
var dduWatcherUiPhase = "idle";
var DDU_EXIT_WATCH_TIMEOUT_MS = 900000;
var DDU_EXIT_WATCH_POLL_MS = 750;
var isDduWorkflowRunning = false;
var dduDriverRefreshGen = 0;
var DDU_DRIVER_REFRESH_TIMEOUT_MS = 5000;

function initDduAutoCleanPaths() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) {
    DDU_AUTO_LOG_PATH = combinePath(app, "logs\\ddu-auto-clean.log");
    DDU_AUTO_LIVE_PATH = combinePath(app, "logs\\ddu-auto-clean-live.txt");
  } else {
    DDU_AUTO_LOG_PATH = combinePath(UNREAL_BASE, "logs\\ddu-auto-clean.log");
    DDU_AUTO_LIVE_PATH = combinePath(UNREAL_BASE, "logs\\ddu-auto-clean-live.txt");
  }
}

function writeDduAutoCleanLog(line) {
  initDduAutoCleanPaths();
  var fso = getFso();
  var folder = fso.GetParentFolderName(DDU_AUTO_LOG_PATH);
  if (folder && !fso.FolderExists(folder)) fso.CreateFolder(folder);
  var ForAppending = 8;
  if (!fso.FileExists(DDU_AUTO_LOG_PATH)) {
    var t0 = fso.CreateTextFile(DDU_AUTO_LOG_PATH, true);
    t0.WriteLine(line);
    t0.Close();
  } else {
    var t1 = fso.OpenTextFile(DDU_AUTO_LOG_PATH, ForAppending, true);
    t1.WriteLine(line);
    t1.Close();
  }
}

function clearDduAutoCleanLiveFile() {
  initDduAutoCleanPaths();
  try {
    var fso = getFso();
    if (fso.FileExists(DDU_AUTO_LIVE_PATH)) fso.DeleteFile(DDU_AUTO_LIVE_PATH);
  } catch (eClr) {}
}

function readDduAutoCleanLastLiveStatus() {
  initDduAutoCleanPaths();
  try {
    var fso = getFso();
    if (!fso.FileExists(DDU_AUTO_LIVE_PATH)) return "";
    var txt = readTextFileAll(DDU_AUTO_LIVE_PATH);
    if (!txt) return "";
    var lines = String(txt).split(/\r?\n/);
    var i;
    for (i = lines.length - 1; i >= 0; i--) {
      var line = String(lines[i] || "");
      if (line.indexOf("STATUS=") === 0) return line.replace(/^STATUS=/, "");
    }
  } catch (eR) {}
  return "";
}

function readDduAutoCleanLogFlags() {
  var flags = { resultOk: false, resultTimeout: false, cleanClicked: false };
  initDduAutoCleanPaths();
  try {
    var fso = getFso();
    if (!fso.FileExists(DDU_AUTO_LOG_PATH)) return flags;
    var txt = readTextFileAll(DDU_AUTO_LOG_PATH);
    if (!txt) return flags;
    if (/RESULT=ok/i.test(txt)) flags.resultOk = true;
    if (/RESULT=clean_watch_timeout|RESULT=ddu_main_timeout/i.test(txt)) flags.resultTimeout = true;
    if (/CLEAN_NO_RESTART_CLICKED=oui/i.test(txt)) flags.cleanClicked = true;
  } catch (eLf) {}
  return flags;
}

function processNameLooksLikeDdu(name) {
  var n = String(name || "").toLowerCase().replace(/\.exe$/i, "");
  if (!n) return false;
  if (/\bddu\b/.test(n)) return true;
  if (n.indexOf("display") >= 0 && n.indexOf("driver") >= 0 && n.indexOf("uninstaller") >= 0) return true;
  return false;
}

function windowTitleLooksLikeDdu(title) {
  var t = String(title || "");
  if (!t) return false;
  if (/Display Driver Uninstaller/i.test(t)) return true;
  if (/\bDDU\b/i.test(t)) return true;
  return false;
}

function commandLineLooksLikeDdu(cmd) {
  var c = String(cmd || "");
  if (!c) return false;
  if (/Display Driver Uninstaller|\bddu\b/i.test(c)) return true;
  return false;
}

function snapshotDduProcessPids() {
  var pids = {};
  try {
    var items = wmiQuery("SELECT ProcessId,Name,CommandLine FROM Win32_Process");
    var e = new Enumerator(items);
    for (; !e.atEnd(); e.moveNext()) {
      var o = e.item();
      var name = String(o.Name || "");
      var cmd = String(o.CommandLine || "");
      if (!processNameLooksLikeDdu(name) && !commandLineLooksLikeDdu(cmd)) continue;
      var pid = parseInt(o.ProcessId, 10);
      if (isNaN(pid)) continue;
      pids[String(pid)] = true;
    }
  } catch (exSnap) {}
  return pids;
}

function mergeDduInstanceMap(map, pid, name, title, source) {
  if (!pid || isNaN(pid)) return;
  var key = String(pid);
  if (!map[key]) {
    map[key] = { pid: pid, name: String(name || ""), title: String(title || ""), source: source || "wmi" };
    return;
  }
  if (title && !map[key].title) map[key].title = String(title);
  if (name && !map[key].name) map[key].name = String(name);
}

function probeDduViaPowerShell() {
  var hits = [];
  try {
    var psCmd =
      "powershell.exe -NoProfile -Command " +
      "\"Get-Process | Where-Object { " +
      "$_.MainWindowTitle -match 'Display Driver Uninstaller|DDU' -or " +
      "$_.ProcessName -match 'DDU|DisplayDriverUninstaller|Display Driver Uninstaller' " +
      "} | ForEach-Object { Write-Output ($_.Id.ToString() + '|' + $_.ProcessName + '|' + $_.MainWindowTitle) }\"";
    var out = runCommandCapture(psCmd);
    if (!out) return hits;
    var lines = String(out).split(/\r?\n/);
    var i;
    for (i = 0; i < lines.length; i++) {
      var line = String(lines[i] || "").replace(/^\s+|\s+$/g, "");
      if (!line) continue;
      var parts = line.split("|");
      var pid = parseInt(parts[0], 10);
      if (isNaN(pid)) continue;
      hits.push({
        pid: pid,
        name: parts[1] || "",
        title: parts[2] || "",
        source: "ps"
      });
    }
  } catch (exPs) {}
  return hits;
}

function probeDduPresence(baselinePids, usePsProbe) {
  baselinePids = baselinePids || {};
  var map = {};
  try {
    var items = wmiQuery("SELECT ProcessId,Name,CommandLine FROM Win32_Process");
    var e = new Enumerator(items);
    for (; !e.atEnd(); e.moveNext()) {
      var o = e.item();
      var name = String(o.Name || "");
      var cmd = String(o.CommandLine || "");
      if (!processNameLooksLikeDdu(name) && !commandLineLooksLikeDdu(cmd)) continue;
      mergeDduInstanceMap(map, parseInt(o.ProcessId, 10), name, "", "wmi");
    }
  } catch (exWmi) {}

  if (usePsProbe) {
    var psHits = probeDduViaPowerShell();
    var j;
    for (j = 0; j < psHits.length; j++) {
      var ph = psHits[j];
      if (!processNameLooksLikeDdu(ph.name) && !windowTitleLooksLikeDdu(ph.title)) continue;
      mergeDduInstanceMap(map, ph.pid, ph.name, ph.title, "ps");
    }
  }

  var all = [];
  var novel = [];
  for (var pidKey in map) {
    if (!map.hasOwnProperty(pidKey)) continue;
    all.push(map[pidKey]);
    if (!baselinePids[pidKey]) novel.push(map[pidKey]);
  }
  var chosen = novel.length ? novel : all;
  return {
    active: chosen.length > 0,
    instances: chosen,
    best: chosen.length ? chosen[0] : null
  };
}

function stopDduProcessExitWatcher() {
  dduExitWatcherGen++;
}

function finishDduExitWatchTimeout() {
  writeDduAutoCleanLog("[DDU] TIMEOUT attente fermeture DDU");
  stopDduProcessExitWatcher();
  dduAutoCleanPollGen++;
  dduWatcherUiPhase = "idle";
  setDduWorkflowRunning(false);
  setDduAutoStatus("[DDU] Timeout : fermeture DDU non dÃ©tectÃ©e", "error", 0);
  driversWorkflowState.dduError = true;
  driversWorkflowState.dduPct = 0;
  setDduAutoCleanButtonBusy(false);
  dduAutoCleanBusy = false;
  showDduVerifyCleanButton(true);
  try { updateDriversWorkflowGuide(); } catch (eWf) {}
}

function beginDduProcessExitWatcher(baselinePids) {
  var gen = ++dduExitWatcherGen;
  var startedAt = new Date().getTime();
  var dduEverDetected = false;
  var detectionLogged = false;
  var waitCloseLogged = false;
  var psProbeCounter = 0;

  function tick() {
    if (gen !== dduExitWatcherGen) return;
    if (dduWatcherUiPhase === "done") return;

    var elapsed = new Date().getTime() - startedAt;
    if (elapsed >= DDU_EXIT_WATCH_TIMEOUT_MS) {
      finishDduExitWatchTimeout();
      return;
    }

    psProbeCounter++;
    var usePs = (psProbeCounter % 2 === 0);
    var probe = probeDduPresence(baselinePids, usePs);

    if (probe.active && probe.best) {
      dduEverDetected = true;
      dduWatcherUiPhase = "running";
      if (!detectionLogged) {
        detectionLogged = true;
        var title = probe.best.title || probe.best.name || "";
        writeDduAutoCleanLog("[DDU] Process/fenÃªtre DDU dÃ©tectÃ© : pid=" + probe.best.pid + " title=" + title);
        writeDduAutoCleanLog("[DDU] Nettoyage GPU en cours...");
        setDduAutoStatus("[DDU] Nettoyage GPU en cours...", "info", 40);
      }
      if (!waitCloseLogged) {
        waitCloseLogged = true;
        writeDduAutoCleanLog("[DDU] Attente fermeture DDU utilisateur...");
      }
      window.setTimeout(tick, DDU_EXIT_WATCH_POLL_MS);
      return;
    }

    if (dduEverDetected) {
      writeDduAutoCleanLog("[DDU] DDU fermÃ© aprÃ¨s nettoyage");
      stopDduProcessExitWatcher();
      finishDduAutoCleanSuccess();
      return;
    }

    window.setTimeout(tick, DDU_EXIT_WATCH_POLL_MS);
  }

  window.setTimeout(tick, DDU_EXIT_WATCH_POLL_MS);
}

function setDduWorkflowRunning(active) {
  isDduWorkflowRunning = !!active;
  if (active) {
    nvCheckGeneration++;
    finishGpuDriverCheck();
    sessionCache.suppressGpuDriverCheckUntil = new Date().getTime() + 600000;
  } else {
    sessionCache.suppressGpuDriverCheckUntil = 0;
  }
}

function setDduAutoStatus(message, type, progressPct) {
  var el = $("dduAutoStatus");
  if (el) {
    el.style.display = typeof progressPct === "number" ? "none" : "";
    if (el.style.display !== "none") {
      el.innerText = message || "";
      el.className = "tool-status" + (type ? " tool-status--" + type : "");
    }
  }
  if (typeof progressPct !== "number") return;
  setDriversProgressBar("dduAutoProgressWrap", "dduAutoProgressFill", "dduAutoProgressText", "dduAutoProgressStep", progressPct, message || "");
  var p = parseInt(progressPct, 10);
  if (!isNaN(p)) {
    driversWorkflowState.dduPct = p;
    if (p >= 100 && (type === "success")) {
      driversWorkflowState.dduDone = true;
      driversWorkflowState.dduError = false;
    }
    if (type === "error") driversWorkflowState.dduError = true;
    updateDriversWorkflowGuide();
  }
}

function setDduAutoCleanButtonBusy(busy) {
  var btn = $("btnDduAutoClean");
  if (!btn) return;
  btn.disabled = !!busy;
}

function showDduVerifyCleanButton(show) {
  var btn = $("btnVerifyDduClean");
  if (btn) btn.style.display = show ? "" : "none";
}

function verifyDduCleanManual() {
  setDduAutoStatus("VÃ©rification du pilote NVIDIA...", "info", 90);
  setDduWorkflowRunning(false);
  RefreshNvidiaDriverStatusAsync(function (res) {
    if (res && res.noDriver) {
      finishDduAutoCleanSuccess();
      showDduVerifyCleanButton(false);
      return;
    }
    if (res && res.timeout) {
      setDduAutoStatus("VÃ©rification pilote impossible pour le moment", "warn", 90);
      showDduVerifyCleanButton(true);
      return;
    }
    if (!res || !res.installed) {
      finishDduAutoCleanSuccess();
      showDduVerifyCleanButton(false);
      return;
    }
    setDduAutoStatus(
      "Pilote NVIDIA encore dÃ©tectÃ© â€” termine le nettoyage dans DDU si besoin, puis reclique sur VÃ©rifier nettoyage.",
      "info",
      90
    );
    showDduVerifyCleanButton(true);
  });
}

function showDduAutoVendorPick(show, det) {
  var box = $("dduAutoVendorPick");
  var sel = $("dduAutoVendorSelect");
  if (!box || !sel) return;
  if (!show) {
    box.style.display = "none";
    return;
  }
  var vendors = {};
  var i;
  if (det && det.list) {
    for (i = 0; i < det.list.length; i++) {
      if (det.list[i].vendor) vendors[det.list[i].vendor] = true;
    }
  }
  sel.options.length = 0;
  var keys = ["NVIDIA", "AMD", "INTEL"];
  var added = 0;
  for (i = 0; i < keys.length; i++) {
    if (vendors[keys[i]]) {
      var opt = document.createElement("option");
      opt.value = keys[i];
      opt.text = keys[i];
      sel.appendChild(opt);
      added++;
    }
  }
  if (!added) {
    for (i = 0; i < keys.length; i++) {
      var opt2 = document.createElement("option");
      opt2.value = keys[i];
      opt2.text = keys[i];
      sel.appendChild(opt2);
    }
  }
  box.style.display = "block";
}

function classifyVendorFromPciPnp(pnp) {
  var u = String(pnp || "").toUpperCase();
  if (/VEN_10DE/.test(u)) return "NVIDIA";
  if (/VEN_1002|VEN_1022/.test(u)) return "AMD";
  if (/VEN_8086/.test(u)) return "INTEL";
  return "";
}

function isVirtualOrIgnoredGpu(name, compat, pnp) {
  if (classifyVendorFromPciPnp(pnp)) return false;
  var s = (String(name) + " " + String(compat) + " " + String(pnp)).toUpperCase();
  if (/MICROSOFT BASIC|REMOTE DISPLAY|VIRTUAL|MIRROR|PARSEC|RDP|VMWARE|HYPER-V|META VIRTUAL|INDIRECT DISPLAY|GAMEVIEW|SUNSHINE|SPICE|QXL|BASIC RENDER/i.test(s)) return true;
  return false;
}

function classifyGpuVendorFromStrings(name, compat, pnp) {
  var ven = classifyVendorFromPciPnp(pnp);
  if (ven) return ven;
  var s = (String(name) + " " + String(compat) + " " + String(pnp)).toUpperCase();
  if (/NVIDIA|GEFORCE|QUADRO|TITAN|NVS /i.test(s)) return "NVIDIA";
  if (/AMD|RADEON|ATI |ADVANCED MICRO/i.test(s)) return "AMD";
  if (/INTEL|IRIS|UHD|HD GRAPHICS|\bARC\b/i.test(s)) return "INTEL";
  return "";
}

function getHardwareCacheConfigPath() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (!app) return "";
  return combinePath(app, "config\\hardware-cache.json");
}

function readHardwareCache() {
  try {
    var p = getHardwareCacheConfigPath();
    if (!p) return null;
    var txt = readTextFileAll(p);
    if (!txt) return null;
    return JSON.parse(txt);
  } catch (eR) {
    return null;
  }
}

function writeHardwareCache(obj) {
  var p = getHardwareCacheConfigPath();
  if (!p) return;
  var fso = getFso();
  var folder = fso.GetParentFolderName(p);
  if (folder && !fso.FolderExists(folder)) fso.CreateFolder(folder);
  var tw = fso.CreateTextFile(p, true);
  tw.Write(JSON.stringify(obj, null, 2));
  tw.Close();
}

function saveHardwareCacheFromDduDetection(det, vendor) {
  var v = String(vendor || (det ? det.selected : "") || "").toUpperCase();
  var gpuName = "";
  var pnp = "";
  var i;
  if (det && det.list) {
    for (i = 0; i < det.list.length; i++) {
      if (det.list[i].vendor === v || (v === "UNKNOWN" && det.list[i].vendor)) {
        if (!gpuName || det.list[i].vendor === v) {
          gpuName = det.list[i].name || gpuName;
          pnp = det.list[i].pnp || pnp;
          if (det.list[i].vendor === v) break;
        }
      }
    }
  }
  if (!v || v === "UNKNOWN") return;
  writeHardwareCache({
    lastGpuVendor: v,
    lastGpuName: gpuName || v,
    lastGpuPnpDeviceId: pnp,
    lastGpuDetectedAt: new Date().toISOString(),
    source: "pre_ddu_detection"
  });
}

function getGpuDriverInstallLogPath() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) return combinePath(app, "logs\\gpu-driver-install.log");
  return combinePath(UNREAL_BASE, "logs\\gpu-driver-install.log");
}

function writeGpuDriverInstallLog(fields) {
  try {
    var p = getGpuDriverInstallLogPath();
    var fso = getFso();
    var folder = fso.GetParentFolderName(p);
    if (folder && !fso.FolderExists(folder)) fso.CreateFolder(folder);
    var ForAppending = 8;
    function line(k, v) {
      if (v == null) return;
      var row = String(k) + "=" + String(v);
      if (!fso.FileExists(p)) {
        var t0 = fso.CreateTextFile(p, true);
        t0.WriteLine(row);
        t0.Close();
      } else {
        var t1 = fso.OpenTextFile(p, ForAppending, true);
        t1.WriteLine(row);
        t1.Close();
      }
    }
    line("DATE", new Date().toISOString());
    line("ACTION", fields.ACTION || "detect_gpu_for_driver_install");
    line("WIN32_VIDEO_RESULT", fields.WIN32_VIDEO_RESULT);
    line("WIN32_PNP_RESULT", fields.WIN32_PNP_RESULT);
    line("PNPUTIL_RESULT", fields.PNPUTIL_RESULT);
    line("PCI_VENDOR_ID_FOUND", fields.PCI_VENDOR_ID_FOUND);
    line("CACHE_FOUND", fields.CACHE_FOUND);
    line("CACHE_GPU_VENDOR", fields.CACHE_GPU_VENDOR);
    line("CACHE_GPU_NAME", fields.CACHE_GPU_NAME);
    line("FINAL_GPU_VENDOR", fields.FINAL_GPU_VENDOR);
    line("DETECTION_SOURCE", fields.DETECTION_SOURCE);
    line("INSTALL_ALLOWED", fields.INSTALL_ALLOWED);
    line("ERROR", fields.ERROR);
    line("", "");
  } catch (eW) {}
}

function detectGpuFromVideoControllersForInstall() {
  var best = null;
  var bestPri = -1;
  var priMap = { NVIDIA: 300, AMD: 200, INTEL: 100 };
  var logParts = [];
  try {
    var q = wmiQuery("SELECT Name, AdapterCompatibility, PNPDeviceID, DriverVersion FROM Win32_VideoController");
    var e = new Enumerator(q);
    for (; !e.atEnd(); e.moveNext()) {
      var o = e.item();
      var name = String(o.Name || "");
      var compat = String(o.AdapterCompatibility || "");
      var pnp = String(o.PNPDeviceID || "");
      if (isVirtualOrIgnoredGpu(name, compat, pnp)) continue;
      var vendor = classifyGpuVendorFromStrings(name, compat, pnp);
      if (!vendor) continue;
      var pri = priMap[vendor] || 10;
      logParts.push(vendor + ":" + name);
      if (pri > bestPri) {
        bestPri = pri;
        best = { vendor: vendor, gpuName: name, pnp: pnp, driverVersionRaw: String(o.DriverVersion || "") };
      }
    }
  } catch (eW) {}
  return {
    found: !!best,
    vendor: best ? best.vendor : "",
    gpuName: best ? best.gpuName : "",
    pnp: best ? best.pnp : "",
    driverVersionRaw: best ? best.driverVersionRaw : "",
    logLine: logParts.join(" | ") || "none"
  };
}

function detectGpuFromPnPEntityForInstall() {
  var best = null;
  var bestPri = -1;
  var priMap = { NVIDIA: 300, AMD: 200, INTEL: 100 };
  var logParts = [];
  var queries = [
    "SELECT Name, PNPDeviceID FROM Win32_PnPEntity WHERE PNPDeviceID LIKE '%VEN_10DE%'",
    "SELECT Name, PNPDeviceID FROM Win32_PnPEntity WHERE PNPDeviceID LIKE '%VEN_1002%'",
    "SELECT Name, PNPDeviceID FROM Win32_PnPEntity WHERE PNPDeviceID LIKE '%VEN_1022%'",
    "SELECT Name, PNPDeviceID FROM Win32_PnPEntity WHERE PNPDeviceID LIKE '%VEN_8086%'",
    "SELECT Name, PNPDeviceID FROM Win32_PnPEntity WHERE PNPClass='Display'"
  ];
  var qi;
  for (qi = 0; qi < queries.length; qi++) {
    try {
      var q = wmiQuery(queries[qi]);
      var e = new Enumerator(q);
      for (; !e.atEnd(); e.moveNext()) {
        var o = e.item();
        var name = String(o.Name || "");
        var pnp = String(o.PNPDeviceID || "");
        var vendor = classifyVendorFromPciPnp(pnp) || classifyGpuVendorFromStrings(name, "", pnp);
        if (!vendor) continue;
        var pri = priMap[vendor] || 10;
        logParts.push(vendor + ":" + name + "[" + pnp + "]");
        if (pri > bestPri) {
          bestPri = pri;
          best = { vendor: vendor, gpuName: name, pnp: pnp };
        }
      }
    } catch (eQ) {}
  }
  return {
    found: !!best,
    vendor: best ? best.vendor : "",
    gpuName: best ? best.gpuName : "",
    pnp: best ? best.pnp : "",
    pciVen: best ? classifyVendorFromPciPnp(best.pnp) : "",
    logLine: logParts.join(" | ") || "none"
  };
}

function detectGpuFromPnputilForInstall() {
  var out = runCommandCapture("pnputil /enum-devices /class Display");
  if (!out || out.length < 20) out = runCommandCapture("pnputil /enum-devices");
  var u = String(out || "").toUpperCase();
  var vendor = "";
  var pciVen = "";
  if (/VEN_10DE|NVIDIA|GEFORCE/.test(u)) {
    vendor = "NVIDIA";
    pciVen = "VEN_10DE";
  } else if (/VEN_1002|VEN_1022|AMD|RADEON/.test(u)) {
    vendor = "AMD";
    pciVen = /VEN_1002/.test(u) ? "VEN_1002" : "VEN_1022";
  } else if (/VEN_8086|INTEL/.test(u)) {
    vendor = "INTEL";
    pciVen = "VEN_8086";
  }
  return {
    found: !!vendor,
    vendor: vendor,
    pciVen: pciVen,
    logLine: vendor ? vendor + " in pnputil output" : "none"
  };
}

function detectGpuForDriverInstall(opts) {
  opts = opts || {};
  if (isDduWorkflowRunning && !opts.afterDdu) {
    var cache = readHardwareCache();
    if (cache && cache.lastGpuVendor) {
      return {
        hasNvidia: String(cache.lastGpuVendor).toUpperCase() === "NVIDIA",
        installAllowed: String(cache.lastGpuVendor).toUpperCase() === "NVIDIA",
        vendor: String(cache.lastGpuVendor).toUpperCase(),
        gpuName: cache.lastGpuName || cache.lastGpuVendor,
        hardwareOnly: true,
        detectionSource: "cache-ddu-skip"
      };
    }
    return { hasNvidia: false, installAllowed: false, vendor: "", gpuName: "", hardwareOnly: true, detectionSource: "ddu-workflow-skip" };
  }
  var log = {
    ACTION: "detect_gpu_for_driver_install",
    WIN32_VIDEO_RESULT: "",
    WIN32_PNP_RESULT: "",
    PNPUTIL_RESULT: "",
    PCI_VENDOR_ID_FOUND: "",
    CACHE_FOUND: "non",
    CACHE_GPU_VENDOR: "",
    CACHE_GPU_NAME: "",
    FINAL_GPU_VENDOR: "",
    DETECTION_SOURCE: "",
    INSTALL_ALLOWED: "non",
    ERROR: ""
  };
  var manual = String(opts.manualVendor || sessionCache.manualGpuVendor || "").toUpperCase();

  var video = detectGpuFromVideoControllersForInstall();
  log.WIN32_VIDEO_RESULT = video.logLine;
  if (video.found && video.vendor === "NVIDIA") {
    log.PCI_VENDOR_ID_FOUND = classifyVendorFromPciPnp(video.pnp) || "NVIDIA";
    log.FINAL_GPU_VENDOR = "NVIDIA";
    log.DETECTION_SOURCE = "video_controller";
    log.INSTALL_ALLOWED = "oui";
    if (!opts.skipLog) writeGpuDriverInstallLog(log);
    return {
      hasNvidia: true,
      installAllowed: true,
      vendor: "NVIDIA",
      gpuName: video.gpuName,
      pnp: video.pnp,
      driverVersionRaw: video.driverVersionRaw,
      detectionSource: "video_controller",
      hardwareOnly: !video.driverVersionRaw,
      log: log
    };
  }

  var pnpEnt = detectGpuFromPnPEntityForInstall();
  log.WIN32_PNP_RESULT = pnpEnt.logLine;
  if (pnpEnt.found && pnpEnt.vendor === "NVIDIA") {
    log.PCI_VENDOR_ID_FOUND = pnpEnt.pciVen || "VEN_10DE";
    log.FINAL_GPU_VENDOR = "NVIDIA";
    log.DETECTION_SOURCE = "pnp_entity";
    log.INSTALL_ALLOWED = "oui";
    if (!opts.skipLog) writeGpuDriverInstallLog(log);
    return {
      hasNvidia: true,
      installAllowed: true,
      vendor: "NVIDIA",
      gpuName: pnpEnt.gpuName || "GPU NVIDIA",
      pnp: pnpEnt.pnp,
      driverVersionRaw: "",
      detectionSource: "pnp_entity",
      hardwareOnly: true,
      log: log
    };
  }

  var pnu = detectGpuFromPnputilForInstall();
  log.PNPUTIL_RESULT = pnu.logLine;
  if (pnu.found && pnu.vendor === "NVIDIA") {
    log.PCI_VENDOR_ID_FOUND = pnu.pciVen || "VEN_10DE";
    log.FINAL_GPU_VENDOR = "NVIDIA";
    log.DETECTION_SOURCE = "pnputil";
    log.INSTALL_ALLOWED = "oui";
    if (!opts.skipLog) writeGpuDriverInstallLog(log);
    return {
      hasNvidia: true,
      installAllowed: true,
      vendor: "NVIDIA",
      gpuName: "GPU NVIDIA",
      pnp: "",
      driverVersionRaw: "",
      detectionSource: "pnputil",
      hardwareOnly: true,
      log: log
    };
  }

  var cache = readHardwareCache();
  if (cache && String(cache.lastGpuVendor || "").toUpperCase() === "NVIDIA") {
    log.CACHE_FOUND = "oui";
    log.CACHE_GPU_VENDOR = cache.lastGpuVendor;
    log.CACHE_GPU_NAME = cache.lastGpuName || "";
    log.FINAL_GPU_VENDOR = "NVIDIA";
    log.DETECTION_SOURCE = "cache";
    log.INSTALL_ALLOWED = "oui";
    if (!opts.skipLog) writeGpuDriverInstallLog(log);
    return {
      hasNvidia: true,
      installAllowed: true,
      vendor: "NVIDIA",
      gpuName: cache.lastGpuName || "GPU NVIDIA",
      pnp: cache.lastGpuPnpDeviceId || "",
      driverVersionRaw: "",
      detectionSource: "cache",
      hardwareOnly: true,
      log: log
    };
  }

  if (manual === "NVIDIA") {
    log.FINAL_GPU_VENDOR = "NVIDIA";
    log.DETECTION_SOURCE = "manual";
    log.INSTALL_ALLOWED = "oui";
    if (!opts.skipLog) writeGpuDriverInstallLog(log);
    return {
      hasNvidia: true,
      installAllowed: true,
      vendor: "NVIDIA",
      gpuName: "GPU NVIDIA (choix manuel)",
      pnp: "",
      driverVersionRaw: "",
      detectionSource: "manual",
      hardwareOnly: true,
      log: log
    };
  }

  log.FINAL_GPU_VENDOR = video.vendor || pnpEnt.vendor || pnu.vendor || "";
  log.ERROR = "nvidia_not_found";
  if (!opts.skipLog) writeGpuDriverInstallLog(log);
  return {
    hasNvidia: false,
    installAllowed: false,
    vendor: "",
    gpuName: "",
    pnp: "",
    driverVersionRaw: "",
    detectionSource: "",
    hardwareOnly: false,
    needsManual: true,
    log: log
  };
}

function showNvGpuManualPick(show) {
  var el = $("nvGpuManualPick");
  if (el) el.style.display = show ? "block" : "none";
}

function confirmNvGpuManualVendorForInstall() {
  var sel = $("nvGpuManualVendorSelect");
  if (!sel || !sel.value) {
    setNvMediaAutoStatus("Choisis un fabricant GPU.", "bad", 0);
    return;
  }
  var v = String(sel.value).toUpperCase();
  if (v !== "NVIDIA") {
    setNvMediaAutoStatus("NVCleanInstall automatique : rÃ©servÃ© aux GPU NVIDIA.", "bad", 0);
    appendNvMediaLog("Choix manuel : " + v + " (non NVIDIA)");
    return;
  }
  sessionCache.manualGpuVendor = "NVIDIA";
  showNvGpuManualPick(false);
  installLatestNvidiaDriverAutomatic();
}

function detectGpuVendor() {
  var list = [];
  var hasNvidia = false;
  var hasAmd = false;
  var hasIntel = false;
  try {
    var q = wmiQuery("SELECT Name, AdapterCompatibility, PNPDeviceID FROM Win32_VideoController");
    var e = new Enumerator(q);
    for (; !e.atEnd(); e.moveNext()) {
      var o = e.item();
      var name = String(o.Name || "");
      var compat = String(o.AdapterCompatibility || "");
      var pnp = String(o.PNPDeviceID || "");
      if (isVirtualOrIgnoredGpu(name, compat, pnp)) continue;
      var vendor = classifyGpuVendorFromStrings(name, compat, pnp);
      if (!vendor) continue;
      list.push({ name: name, vendor: vendor, compat: compat, pnp: pnp });
      if (vendor === "NVIDIA") hasNvidia = true;
      if (vendor === "AMD") hasAmd = true;
      if (vendor === "INTEL") hasIntel = true;
    }
  } catch (eWmi) {}
  var selected = "UNKNOWN";
  if (hasNvidia) selected = "NVIDIA";
  else if (hasAmd) selected = "AMD";
  else if (hasIntel) selected = "INTEL";
  var gpuListParts = [];
  var i;
  for (i = 0; i < list.length; i++) {
    gpuListParts.push(list[i].vendor + ":" + list[i].name);
  }
  var needsChoice = selected === "UNKNOWN" && list.length > 0;
  return {
    list: list,
    gpuList: gpuListParts.join(" | "),
    selected: selected,
    needsChoice: needsChoice
  };
}

function getAppScriptsDir() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (!app) return "";
  var fso = getFso();
  var dir = "";
  if (fso.FolderExists(combinePath(app, "Scripts"))) {
    dir = combinePath(app, "Scripts");
  } else if (fso.FolderExists(combinePath(app, "scripts"))) {
    dir = combinePath(app, "scripts");
  } else {
    dir = combinePath(app, "Scripts");
    try {
      if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
    } catch (eMk) {}
  }
  return dir;
}

function writeAutoHotkeyInstallLog(fields) {
  writeDduAutoCleanLog("DATE=" + new Date().toISOString());
  writeDduAutoCleanLog("ACTION=install_autohotkey");
  if (fields.AHK_DIR != null) writeDduAutoCleanLog("AHK_DIR=" + fields.AHK_DIR);
  if (fields.ZIP_PATH != null) writeDduAutoCleanLog("ZIP_PATH=" + fields.ZIP_PATH);
  if (fields.URL_TRIED_1 != null) writeDduAutoCleanLog("URL_TRIED_1=" + fields.URL_TRIED_1);
  if (fields.URL_1_RESULT != null) writeDduAutoCleanLog("URL_1_RESULT=" + fields.URL_1_RESULT);
  if (fields.URL_1_ERROR != null) writeDduAutoCleanLog("URL_1_ERROR=" + fields.URL_1_ERROR);
  if (fields.URL_TRIED_2 != null) writeDduAutoCleanLog("URL_TRIED_2=" + fields.URL_TRIED_2);
  if (fields.URL_2_RESULT != null) writeDduAutoCleanLog("URL_2_RESULT=" + fields.URL_2_RESULT);
  if (fields.URL_2_ERROR != null) writeDduAutoCleanLog("URL_2_ERROR=" + fields.URL_2_ERROR);
  if (fields.ZIP_EXISTS != null) writeDduAutoCleanLog("ZIP_EXISTS=" + fields.ZIP_EXISTS);
  if (fields.ZIP_SIZE_BYTES != null) writeDduAutoCleanLog("ZIP_SIZE_BYTES=" + fields.ZIP_SIZE_BYTES);
  if (fields.EXTRACT_RESULT != null) writeDduAutoCleanLog("EXTRACT_RESULT=" + fields.EXTRACT_RESULT);
  if (fields.AHK_FOUND_AFTER_EXTRACT != null) writeDduAutoCleanLog("AHK_FOUND_AFTER_EXTRACT=" + fields.AHK_FOUND_AFTER_EXTRACT);
  if (fields.AHK_PATH != null) writeDduAutoCleanLog("AHK_PATH=" + fields.AHK_PATH);
  if (fields.FINAL_RESULT != null) writeDduAutoCleanLog("FINAL_RESULT=" + fields.FINAL_RESULT);
  if (fields.ERROR != null) writeDduAutoCleanLog("ERROR=" + fields.ERROR);
  writeDduAutoCleanLog("");
}

function getAutoHotkeyToolPaths() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (!app) return null;
  return {
    app: app,
    ahkDir: combinePath(app, "tools\\AutoHotkey"),
    downloadsDir: combinePath(app, "tools\\downloads"),
    zipPath: combinePath(app, "tools\\downloads\\" + AUTOHOTKEY_ZIP_NAME)
  };
}

function ensureAutoHotkeyToolDirs() {
  var paths = getAutoHotkeyToolPaths();
  if (!paths) return null;
  var fso = getFso();
  try {
    var tools = combinePath(paths.app, "tools");
    if (!fso.FolderExists(tools)) fso.CreateFolder(tools);
    if (!fso.FolderExists(paths.downloadsDir)) fso.CreateFolder(paths.downloadsDir);
    if (!fso.FolderExists(paths.ahkDir)) fso.CreateFolder(paths.ahkDir);
  } catch (eMk) {}
  return paths;
}

function ensureAppAutoHotkeyDir() {
  var paths = ensureAutoHotkeyToolDirs();
  return paths ? paths.ahkDir : "";
}

function isWindows64BitOs() {
  try {
    var sh = getShell();
    var arch = String(sh.ExpandEnvironmentStrings("%PROCESSOR_ARCHITECTURE%") || "").toUpperCase();
    if (arch === "AMD64" || arch === "ARM64") return true;
    var archWoW = String(sh.ExpandEnvironmentStrings("%PROCESSOR_ARCHITEW6432%") || "").toUpperCase();
    if (archWoW === "AMD64" || archWoW === "ARM64") return true;
  } catch (eArch) {}
  return false;
}

function getAutoHotkeyExePriorityList() {
  return isWindows64BitOs() ? AUTOHOTKEY_EXE_PRIORITY_64 : AUTOHOTKEY_EXE_PRIORITY_32;
}

function pickAutoHotkeyExeFromMap(foundMap, priority) {
  var i;
  for (i = 0; i < priority.length; i++) {
    if (foundMap[priority[i].toLowerCase()]) return foundMap[priority[i].toLowerCase()];
  }
  return "";
}

function collectAutoHotkeyExesInTree(fso, folderPath, depth, foundMap) {
  if (!folderPath || depth > 3 || !fso.FolderExists(folderPath)) return;
  try {
    var folder = fso.GetFolder(folderPath);
    var fe = new Enumerator(folder.Files);
    for (; !fe.atEnd(); fe.moveNext()) {
      var nm = String(fe.item().Name || "");
      if (/^AutoHotkey/i.test(nm) && /\.exe$/i.test(nm)) {
        foundMap[nm.toLowerCase()] = getAbsolutePathFs(fe.item().Path);
      }
    }
    if (depth >= 3) return;
    var fs = new Enumerator(folder.SubFolders);
    for (; !fs.atEnd(); fs.moveNext()) {
      collectAutoHotkeyExesInTree(fso, getAbsolutePathFs(fs.item().Path), depth + 1, foundMap);
    }
  } catch (eTr) {}
}

function findAutoHotkeyExeInstalled() {
  var paths = ensureAutoHotkeyToolDirs();
  if (!paths) return "";
  var dir = paths.ahkDir;
  var fso = getFso();
  var priority = getAutoHotkeyExePriorityList();
  var quickPaths = [
    combinePath(dir, "AutoHotkey64.exe"),
    combinePath(dir, "AutoHotkeyU64.exe"),
    combinePath(dir, "AutoHotkey.exe"),
    combinePath(dir, "v2\\AutoHotkey64.exe"),
    combinePath(dir, "v2\\AutoHotkey.exe")
  ];
  var i;
  for (i = 0; i < quickPaths.length; i++) {
    if (fso.FileExists(quickPaths[i])) return getAbsolutePathFs(quickPaths[i]);
  }
  for (i = 0; i < priority.length; i++) {
    var direct = combinePath(dir, priority[i]);
    if (fso.FileExists(direct)) return direct;
  }
  var searchNames = ["AutoHotkey64.exe", "AutoHotkeyU64.exe", "AutoHotkey.exe"];
  var foundMap = {};
  collectAutoHotkeyExesInTree(fso, dir, 0, foundMap);
  for (i = 0; i < searchNames.length; i++) {
    if (foundMap[searchNames[i].toLowerCase()]) return foundMap[searchNames[i].toLowerCase()];
  }
  return pickAutoHotkeyExeFromMap(foundMap, priority);
}

function findAutoHotkeyExeInToolsDir() {
  return findAutoHotkeyExeInstalled();
}

function openAutoHotkeyOfficialPage() {
  getShell().Run('cmd /c start "" "' + AUTOHOTKEY_OFFICIAL_PAGE + '"', 1, false);
}

function psEscapeSingleQuoted(path) {
  return String(path || "").replace(/'/g, "''");
}

function runAutoHotkeyPowerShellScript(scriptLines, errLogPath) {
  var fso = getFso();
  var tmp = fso.GetSpecialFolder(2);
  var psPath = tmp + "\\unreal-ahk-install-" + Date.now() + ".ps1";
  var errPath = errLogPath || (tmp + "\\unreal-ahk-install-err-" + Date.now() + ".txt");
  try {
    if (fso.FileExists(errPath)) fso.DeleteFile(errPath);
  } catch (eDel0) {}
  var body = scriptLines.join("\r\n");
  try {
    var tw = fso.CreateTextFile(psPath, true);
    tw.Write(body);
    tw.Close();
  } catch (eW) {
    return { exitCode: 99, error: "ps1_write_failed:" + String(eW.message || eW) };
  }
  var exitCode = getShell().Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psPath + "\"", 0, true);
  var errText = readTextFileAll(errPath);
  try { if (fso.FileExists(psPath)) fso.DeleteFile(psPath); } catch (eDel1) {}
  return { exitCode: exitCode, error: String(errText || "").replace(/\r?\n/g, " | ") };
}

function downloadAutoHotkeyZipViaPowerShell(url, zipPath, errLogPath) {
  var z = psEscapeSingleQuoted(zipPath);
  var u = psEscapeSingleQuoted(url);
  var e = psEscapeSingleQuoted(errLogPath);
  var lines = [
    "$ErrorActionPreference = 'Stop'",
    "$errLog = '" + e + "'",
    "function Log-Err([string]$m) { Add-Content -LiteralPath $errLog -Value $m -Encoding UTF8 }",
    "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12",
    "$ProgressPreference = 'SilentlyContinue'",
    "try {",
    "  $zipDir = Split-Path -Parent '" + z + "'",
    "  if ($zipDir -and -not (Test-Path -LiteralPath $zipDir)) { New-Item -ItemType Directory -Path $zipDir -Force | Out-Null }",
    "  Invoke-WebRequest -Uri '" + u + "' -OutFile '" + z + "' -UseBasicParsing",
    "  if (-not (Test-Path -LiteralPath '" + z + "')) { Log-Err 'zip_missing_after_download'; exit 2 }",
    "  $len = (Get-Item -LiteralPath '" + z + "').Length",
    "  if ($len -lt 1000000) { Log-Err ('zip_too_small_bytes:' + $len); exit 3 }",
    "  exit 0",
    "} catch {",
    "  Log-Err $_.Exception.Message",
    "  if ($_.Exception.InnerException) { Log-Err $_.Exception.InnerException.Message }",
    "  exit 1",
    "}"
  ];
  return runAutoHotkeyPowerShellScript(lines, errLogPath);
}

function extractAutoHotkeyZipViaPowerShell(zipPath, ahkDir, extractTempDir, errLogPath) {
  var z = psEscapeSingleQuoted(zipPath);
  var d = psEscapeSingleQuoted(ahkDir);
  var t = psEscapeSingleQuoted(extractTempDir);
  var e = psEscapeSingleQuoted(errLogPath);
  var lines = [
    "$ErrorActionPreference = 'Stop'",
    "$errLog = '" + e + "'",
    "function Log-Err([string]$m) { Add-Content -LiteralPath $errLog -Value $m -Encoding UTF8 }",
    "try {",
    "  if (-not (Test-Path -LiteralPath '" + z + "')) { Log-Err 'zip_not_found_before_extract'; exit 2 }",
    "  if (Test-Path -LiteralPath '" + t + "') { Remove-Item -LiteralPath '" + t + "' -Recurse -Force -ErrorAction SilentlyContinue }",
    "  New-Item -ItemType Directory -Force -Path '" + t + "' | Out-Null",
    "  New-Item -ItemType Directory -Force -Path '" + d + "' | Out-Null",
    "  try {",
    "    Expand-Archive -LiteralPath '" + z + "' -DestinationPath '" + t + "' -Force",
    "  } catch {",
    "    Log-Err ('expand_archive_failed:' + $_.Exception.Message)",
    "    Add-Type -AssemblyName System.IO.Compression.FileSystem",
    "    [System.IO.Compression.ZipFile]::ExtractToDirectory('" + z + "', '" + t + "')",
    "  }",
    "  $exeNames = @('AutoHotkey64.exe','AutoHotkeyU64.exe','AutoHotkey.exe','AutoHotkey32.exe','AutoHotkeyU32.exe')",
    "  $copied = 0",
    "  foreach ($name in $exeNames) {",
    "    $found = Get-ChildItem -LiteralPath '" + t + "' -Recurse -Filter $name -File -ErrorAction SilentlyContinue | Select-Object -First 1",
    "    if ($found) {",
    "      Copy-Item -LiteralPath $found.FullName -Destination (Join-Path '" + d + "' $name) -Force",
    "      $copied++",
    "    }",
    "  }",
    "  if ($copied -lt 1) { Log-Err 'no_autohotkey_exe_in_zip'; exit 4 }",
    "  Remove-Item -LiteralPath '" + t + "' -Recurse -Force -ErrorAction SilentlyContinue",
    "  exit 0",
    "} catch {",
    "  Log-Err $_.Exception.Message",
    "  if ($_.Exception.InnerException) { Log-Err $_.Exception.InnerException.Message }",
    "  exit 1",
    "}"
  ];
  return runAutoHotkeyPowerShellScript(lines, errLogPath);
}

function getZipFileInfo(zipPath) {
  var fso = getFso();
  if (!fso.FileExists(zipPath)) return { exists: false, size: 0 };
  try {
    return { exists: true, size: fso.GetFile(zipPath).Size };
  } catch (eZ) {
    return { exists: true, size: 0 };
  }
}

function installAutoHotkeyViaPowerShell() {
  var paths = ensureAutoHotkeyToolDirs();
  if (!paths) {
    return { ok: false, error: "Dossier application introuvable", openPage: false };
  }
  var fso = getFso();
  var errLogPath = combinePath(paths.downloadsDir, "ahk-install-errors.txt");
  try {
    if (fso.FileExists(errLogPath)) fso.DeleteFile(errLogPath);
  } catch (eClr) {}

  var logFields = {
    AHK_DIR: paths.ahkDir,
    ZIP_PATH: paths.zipPath,
    URL_TRIED_1: AUTOHOTKEY_URL_1,
    URL_TRIED_2: AUTOHOTKEY_URL_2,
    URL_1_RESULT: "erreur",
    URL_1_ERROR: "",
    URL_2_RESULT: "",
    URL_2_ERROR: "",
    ZIP_EXISTS: "non",
    ZIP_SIZE_BYTES: "0",
    EXTRACT_RESULT: "",
    AHK_FOUND_AFTER_EXTRACT: "non",
    AHK_PATH: "",
    FINAL_RESULT: "",
    ERROR: ""
  };

  setDduAutoStatus("AutoHotkey absent, tÃ©lÃ©chargement...", "info");

  var r1 = downloadAutoHotkeyZipViaPowerShell(AUTOHOTKEY_URL_1, paths.zipPath, errLogPath);
  var zip1 = getZipFileInfo(paths.zipPath);
  if (r1.exitCode === 0 && zip1.exists && zip1.size >= 1000000) {
    logFields.URL_1_RESULT = "ok";
  } else {
    logFields.URL_1_RESULT = "erreur";
    logFields.URL_1_ERROR = r1.error || ("exit_code_" + r1.exitCode);
    var r2 = downloadAutoHotkeyZipViaPowerShell(AUTOHOTKEY_URL_2, paths.zipPath, errLogPath);
    var zip2 = getZipFileInfo(paths.zipPath);
    if (r2.exitCode === 0 && zip2.exists && zip2.size >= 1000000) {
      logFields.URL_2_RESULT = "ok";
      zip1 = zip2;
    } else {
      logFields.URL_2_RESULT = "erreur";
      logFields.URL_2_ERROR = r2.error || ("exit_code_" + r2.exitCode);
      logFields.ZIP_EXISTS = zip2.exists ? "oui" : "non";
      logFields.ZIP_SIZE_BYTES = String(zip2.size || 0);
      logFields.FINAL_RESULT = "download_failed";
      logFields.ERROR = logFields.URL_2_ERROR || logFields.URL_1_ERROR || "download_failed";
      writeAutoHotkeyInstallLog(logFields);
      return { ok: false, error: logFields.ERROR, openPage: true, logFields: logFields };
    }
  }

  zip1 = getZipFileInfo(paths.zipPath);
  logFields.ZIP_EXISTS = zip1.exists ? "oui" : "non";
  logFields.ZIP_SIZE_BYTES = String(zip1.size || 0);
  if (!zip1.exists || zip1.size < 1000000) {
    logFields.FINAL_RESULT = "zip_invalid";
    logFields.ERROR = "zip_missing_or_too_small:" + zip1.size;
    writeAutoHotkeyInstallLog(logFields);
    return { ok: false, error: logFields.ERROR, openPage: true, logFields: logFields };
  }

  setDduAutoStatus("TÃ©lÃ©chargement AutoHotkey rÃ©ussi.", "info");
  setDduAutoStatus("Extraction AutoHotkey...", "info");

  var extractTempDir = combinePath(paths.downloadsDir, "AutoHotkey-v2-extract-tmp");
  var ex = extractAutoHotkeyZipViaPowerShell(paths.zipPath, paths.ahkDir, extractTempDir, errLogPath);
  if (ex.exitCode !== 0) {
    logFields.EXTRACT_RESULT = "erreur";
    logFields.FINAL_RESULT = "extract_failed";
    logFields.ERROR = ex.error || ("exit_code_" + ex.exitCode);
    writeAutoHotkeyInstallLog(logFields);
    return { ok: false, error: logFields.ERROR, openPage: true, logFields: logFields };
  }

  logFields.EXTRACT_RESULT = "ok";
  var exePath = findAutoHotkeyExeInstalled();
  if (!exePath) {
    logFields.AHK_FOUND_AFTER_EXTRACT = "non";
    logFields.FINAL_RESULT = "exe_not_found";
    logFields.ERROR = "AutoHotkey64.exe/AutoHotkey.exe introuvable apres extraction";
    writeAutoHotkeyInstallLog(logFields);
    return { ok: false, error: logFields.ERROR, openPage: true, logFields: logFields };
  }

  logFields.AHK_FOUND_AFTER_EXTRACT = "oui";
  logFields.AHK_PATH = exePath;
  logFields.FINAL_RESULT = "installed";
  logFields.ERROR = "";
  writeAutoHotkeyInstallLog(logFields);
  return { ok: true, path: exePath, installed: true, logFields: logFields };
}

function ensureAutoHotkeyInstalled() {
  setDduAutoStatus("VÃ©rification AutoHotkey...", "info");
  var paths = ensureAutoHotkeyToolDirs();
  if (!paths) {
    writeAutoHotkeyInstallLog({
      AHK_DIR: "",
      ZIP_PATH: "",
      FINAL_RESULT: "no_app_dir",
      ERROR: "Dossier application introuvable"
    });
    return { ok: false, error: "Dossier application introuvable", openPage: false };
  }
  var existing = findAutoHotkeyExeInstalled();
  if (existing) {
    writeAutoHotkeyInstallLog({
      AHK_DIR: paths.ahkDir,
      ZIP_PATH: paths.zipPath,
      URL_TRIED_1: "",
      URL_1_RESULT: "",
      URL_1_ERROR: "",
      URL_TRIED_2: "",
      URL_2_RESULT: "",
      URL_2_ERROR: "",
      ZIP_EXISTS: "",
      ZIP_SIZE_BYTES: "",
      EXTRACT_RESULT: "",
      AHK_FOUND_AFTER_EXTRACT: "oui",
      AHK_PATH: existing,
      FINAL_RESULT: "detected",
      ERROR: ""
    });
    return { ok: true, path: existing, installed: false };
  }
  var inst = installAutoHotkeyViaPowerShell();
  if (inst.ok && inst.path) {
    return { ok: true, path: inst.path, installed: true };
  }
  return {
    ok: false,
    error: inst.error || "installation_autohotkey_echouee",
    openPage: inst.openPage !== false,
    logFields: inst.logFields
  };
}

function ensureAutoHotkeyForAutoClean() {
  return ensureAutoHotkeyInstalled();
}

function resolveDduExeForAutoClean() {
  if (dduDetectState.found && dduDetectState.exe && getFso().FileExists(dduDetectState.exe)) {
    return { ok: true, exe: dduDetectState.exe };
  }
  var search = findDduOnPc();
  if (search.found) {
    setDduDetectStateFromHit(search);
    return { ok: true, exe: search.exe };
  }
  setDduAutoStatus("DDU introuvable, tÃ©lÃ©chargement...", "info");
  var dl = tryDownloadDduToAppFolder();
  if (dl.ok && dl.exe) {
    setDduDetectStateFromHit({ found: true, exe: dl.exe, workDir: dl.workDir || "", searchPaths: "" });
    return { ok: true, exe: dl.exe };
  }
  return { ok: false, error: dl.error || "DDU introuvable" };
}

function finishDduAutoCleanSuccess() {
  stopDduProcessExitWatcher();
  dduWatcherUiPhase = "done";
  writeDduAutoCleanLog("[DDU] Progression 100 %");
  writeDduAutoCleanLog("[DDU] Nettoyage GPU terminÃ©");
  setDduWorkflowRunning(false);
  setDduAutoStatus("[DDU] Nettoyage GPU terminÃ©", "success", 100);
  driversWorkflowState.dduDone = true;
  driversWorkflowState.dduPct = 100;
  driversWorkflowState.dduError = false;
  try { updateDriversWorkflowGuide(); } catch (eWf) {}
  setDduAutoCleanButtonBusy(false);
  dduAutoCleanBusy = false;
  dduAutoCleanPollGen++;
  RefreshNvidiaDriverStatusAsync(null);
}

function finishDduAutoCleanTimeout() {
  setDduWorkflowRunning(false);
  setDduAutoStatus("DDU semble prendre trop de temps, vÃ©rifie la fenÃªtre DDU", "error", 90);
  setDduAutoCleanButtonBusy(false);
  dduAutoCleanBusy = false;
  dduAutoCleanPollGen++;
  showDduVerifyCleanButton(true);
}

function beginDduAutoCleanStatusPoll() {
  var gen = ++dduAutoCleanPollGen;
  var attempts = 0;
  var maxAttempts = 400;
  var pollMs = 300;
  var cleanStarted = false;
  var lastPct = 0;
  var cleanLaunchLogged = false;
  showDduVerifyCleanButton(false);

  function poll() {
    if (gen !== dduAutoCleanPollGen) return;
    if (dduWatcherUiPhase === "done") return;
    attempts++;
    var live = readDduAutoCleanLastLiveStatus();
    var uiMsg = mapDduLiveStatusToUiMessage(live);
    var logFlags = readDduAutoCleanLogFlags();

    if (/Nettoyage GPU en cours|CLEAN_NO_RESTART|Nettoyage lancÃ©|Nettoyage DDU en cours|DÃ©sinstallation/i.test(live || "")) cleanStarted = true;
    if (logFlags.cleanClicked) cleanStarted = true;
    if (/mode sans Ã©chec|Pop-up DDU|OK cliquÃ©|Bouton Nettoyer/i.test(live || "")) cleanStarted = true;
    if (isDduBenignLiveStatus(live)) cleanStarted = true;

    if (cleanStarted && !cleanLaunchLogged) {
      cleanLaunchLogged = true;
      writeDduAutoCleanLog("[DDU] Nettoyage lancÃ©");
    }

    if (dduWatcherUiPhase === "running") {
      var pctRunning = inferDduCleanProgressPct(live, true, attempts, false);
      if (pctRunning > 40 && pctRunning < 100) {
        setDduAutoStatus("[DDU] Nettoyage GPU en cours...", "info", pctRunning);
      }
      if (attempts >= maxAttempts) {
        finishDduExitWatchTimeout();
        return;
      }
      window.setTimeout(poll, pollMs);
      return;
    }

    if (isDduBlockingErrorStatus(live) && attempts > 20) {
      finishDduAutoCleanTimeout();
      return;
    }

    if (/Nettoyage GPU terminÃ©|redÃ©marrage conseillÃ©/i.test(live || "") || logFlags.resultOk) {
      finishDduAutoCleanSuccess();
      showDduVerifyCleanButton(false);
      return;
    }

    if (/DDU semble prendre trop de temps/i.test(live || "") || logFlags.resultTimeout) {
      finishDduAutoCleanTimeout();
      return;
    }

    var pct = inferDduCleanProgressPct(live, cleanStarted, attempts, false);
    if (pct > lastPct) lastPct = pct;
    else pct = lastPct;

    if (dduWatcherUiPhase === "opening") {
      setDduAutoStatus("[DDU] Ouverture DDU...", "info", 15);
    } else if (/Nettoyage GPU en cours/i.test(live || "")) {
      setDduAutoStatus("[DDU] Nettoyage GPU en cours...", "info", Math.max(pct, 40));
      cleanStarted = true;
    } else if (live) {
      if (/Interface DDU|\[DDU\] FenÃªtre|PrÃ©paration|Lancement DDU|\[DDU\] Ouverture/i.test(live)) {
        if (dduWatcherUiPhase !== "opening") {
          setDduAutoStatus(uiMsg || live, "info", Math.max(pct, 15));
        }
      } else if (cleanStarted) {
        setDduAutoStatus(uiMsg || "[DDU] Nettoyage GPU en cours...", "info", Math.max(pct, 40));
      } else {
        setDduAutoStatus(uiMsg || live, "info", pct);
      }
    } else if (attempts > 0) {
      setDduAutoStatus(
        dduWatcherUiPhase === "opening" ? "[DDU] Ouverture DDU..." : (cleanStarted ? "[DDU] Nettoyage GPU en cours..." : "PrÃ©paration DDU..."),
        "info",
        dduWatcherUiPhase === "opening" ? 15 : pct
      );
    }

    if (attempts >= maxAttempts) {
      finishDduExitWatchTimeout();
      return;
    }
    window.setTimeout(poll, pollMs);
  }
  window.setTimeout(poll, pollMs);
}

function validateDduAutoAhkScript(scriptPath) {
  var fso = getFso();
  if (!scriptPath || !fso.FileExists(scriptPath)) {
    return { ok: false, word: "file_missing" };
  }
  var baseName = String(fso.GetFileName(scriptPath) || "").toLowerCase();
  if (baseName !== "ddu-auto-clean.ahk") {
    return { ok: false, word: "not_main_script" };
  }
  var content = readTextFileAll(scriptPath);
  if (!content) {
    return { ok: false, word: "empty" };
  }
  var forbidden = [
    { word: "ControlGetCaption", re: /ControlGetCaption/i },
    { word: "catch name", re: /\bcatch\s+name\b/i },
    { word: "handleFinalExitPopup", re: /\bhandleFinalExitPopup\b/i },
    { word: "handleDduFinalQuitPopup", re: /\bhandleDduFinalQuitPopup\b/i },
    { word: "#Include ddu-final-quit", re: /#Include\s+.*ddu-final-quit/i },
    { word: "LaunchDduFinalQuitWatcher", re: /\bLaunchDduFinalQuitWatcher\b/i }
  ];
  var i;
  for (i = 0; i < forbidden.length; i++) {
    if (forbidden[i].re.test(content)) {
      return { ok: false, word: forbidden[i].word };
    }
  }
  return { ok: true, word: "" };
}

function launchDduAutoCleanAutomationRun(vendor, dduPath, det, ahkPath, ahkScript) {
  var appRoot = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var dduBaselinePids = snapshotDduProcessPids();
  stopDduProcessExitWatcher();
  dduWatcherUiPhase = "opening";
  setDduWorkflowRunning(true);
  clearDduAutoCleanLiveFile();
  writeDduAutoCleanLog("DATE=" + new Date().toISOString());
  writeDduAutoCleanLog("ACTION=auto_clean");
  writeDduAutoCleanLog("[DDU] Nettoyage GPU automatique lancÃ©");
  writeDduAutoCleanLog("[DDU] Ouverture DDU...");
  writeDduAutoCleanLog("GPU_LIST=" + (det ? det.gpuList : ""));
  writeDduAutoCleanLog("GPU_SELECTED=" + vendor);
  writeDduAutoCleanLog("DDU_PATH=" + dduPath);
  writeDduAutoCleanLog("AHK_PATH=" + ahkPath);
  writeDduAutoCleanLog("AHK_SCRIPT=" + ahkScript);

  setDduAutoStatus("[DDU] Ouverture DDU...", "info", 15);
  beginDduProcessExitWatcher(dduBaselinePids);
  try {
    sessionCache.nvidiaDriverCleaned = true;
    writeDduAutoCleanLog("SAFE_MODE_MSG_SUPPRESSED_BY_ARG=oui");
    launchFileAsAdminWithArgs(dduPath, "-NoSafeModeMsg");
  } catch (eDdu) {
    writeDduAutoCleanLog("ERROR=" + String(eDdu.message || eDdu));
    writeDduAutoCleanLog("RESULT=ddu_launch_fail");
    writeDduAutoCleanLog("SCRIPT_LAUNCHED=non");
    stopDduProcessExitWatcher();
    dduWatcherUiPhase = "idle";
    setDduAutoStatus("Erreur ouverture DDU : " + String(eDdu.message || eDdu), "error");
    setDduWorkflowRunning(false);
    setDduAutoCleanButtonBusy(false);
    dduAutoCleanBusy = false;
    return;
  }

  window.setTimeout(function () {
    var args = "\"" + ahkScript + "\" " + vendor + " \"" + appRoot + "\"";
    try {
      launchFileAsAdminWithArgs(ahkPath, args);
      writeDduAutoCleanLog("SCRIPT_LAUNCHED=oui");
      writeDduAutoCleanLog("RESULT=automation_started");
      writeDduAutoCleanLog("FINAL_QUIT_AUTO=disabled");
      beginDduAutoCleanStatusPoll();
    } catch (eAhk) {
      writeDduAutoCleanLog("ERROR=" + String(eAhk.message || eAhk));
      writeDduAutoCleanLog("SCRIPT_LAUNCHED=non");
      writeDduAutoCleanLog("RESULT=ahk_partial_watch");
      writeDduAutoCleanLog("NOTE=ahk_failed_but_ddu_watch_continues");
      setDduAutoStatus("DDU lancÃ© â€” surveillance du nettoyage en cours...", "info", 50);
      beginDduAutoCleanStatusPoll();
    }
  }, 500);
}

function launchDduAutoCleanAutomation(vendor, dduPath, det) {
  initDduAutoCleanPaths();
  var scriptsDir = getAppScriptsDir();
  var ahkScript = scriptsDir ? combinePath(scriptsDir, "ddu-auto-clean.ahk") : "";
  var fso = getFso();
  if (!ahkScript || !fso.FileExists(ahkScript)) {
    writeDduAutoCleanLog("ERROR=ahk_script_missing");
    writeDduAutoCleanLog("SCRIPT_LAUNCHED=non");
    setDduAutoStatus("Script ddu-auto-clean.ahk introuvable.", "error");
    setDduWorkflowRunning(false);
    setDduAutoCleanButtonBusy(false);
    dduAutoCleanBusy = false;
    return;
  }
  var dduSyntax = validateDduAutoAhkScript(ahkScript);
  if (!dduSyntax.ok) {
    writeDduAutoCleanLog("FORBIDDEN_WORD_FOUND=" + dduSyntax.word);
    writeDduAutoCleanLog("SCRIPT_LAUNCHED=non");
    if (dduSyntax.word === "file_missing" || dduSyntax.word === "empty") {
      setDduAutoStatus("Script ddu-auto-clean.ahk introuvable ou vide.", "error");
    } else {
      setDduAutoStatus("Script DDU principal invalide. VÃ©rifie scripts\\ddu-auto-clean.ahk.", "error");
    }
    setDduWorkflowRunning(false);
    setDduAutoCleanButtonBusy(false);
    dduAutoCleanBusy = false;
    return;
  }
  writeDduAutoCleanLog("FINAL_QUIT_WATCHER=disabled");
  var ahk = ensureAutoHotkeyInstalled();
  if (!ahk.ok || !ahk.path) {
    if (ahk.openPage) {
      setDduAutoStatus("TÃ©lÃ©chargement AutoHotkey impossible. Ouverture de la page officielle.", "error");
      setDduAutoStatus("TÃ©lÃ©chargement automatique impossible. La page officielle AutoHotkey va s'ouvrir.", "info");
      openAutoHotkeyOfficialPage();
      setDduAutoStatus("TÃ©lÃ©charge AutoHotkey dans tools\\AutoHotkey\\, puis relance le nettoyage auto.", "error");
    } else {
      setDduAutoStatus(ahk.error || "AutoHotkey introuvable.", "error");
    }
    setDduWorkflowRunning(false);
    setDduAutoCleanButtonBusy(false);
    dduAutoCleanBusy = false;
    return;
  }
  if (ahk.installed) {
    setDduAutoStatus("AutoHotkey installÃ©.", "success");
  } else {
    setDduAutoStatus("AutoHotkey dÃ©tectÃ©.", "success");
  }
  window.setTimeout(function () {
    launchDduAutoCleanAutomationRun(vendor, dduPath, det, ahk.path, ahkScript);
  }, ahk.installed ? 400 : 150);
}

function dduAutoCleanContinueWithVendor(vendor) {
  if (!vendor || vendor === "UNKNOWN") {
    setDduAutoStatus("GPU non reconnu. Choisis le fabricant ci-dessous.", "error");
    showDduAutoVendorPick(true, detectGpuVendor());
    setDduWorkflowRunning(false);
    setDduAutoCleanButtonBusy(false);
    dduAutoCleanBusy = false;
    return;
  }
  showDduAutoVendorPick(false);
  var det = detectGpuVendor();
  saveHardwareCacheFromDduDetection(det, vendor);
  writeDduAutoCleanLog("DATE=" + new Date().toISOString());
  writeDduAutoCleanLog("ACTION=detect_gpu");
  writeDduAutoCleanLog("GPU_LIST=" + det.gpuList);
  writeDduAutoCleanLog("GPU_SELECTED=" + vendor);
  writeDduAutoCleanLog("");

  setDduAutoStatus("GPU dÃ©tectÃ© : " + vendor, "info", 15);
  var ddu = resolveDduExeForAutoClean();
  if (!ddu.ok) {
    writeDduAutoCleanLog("ERROR=" + (ddu.error || "ddu_missing"));
    setDduAutoStatus("DDU introuvable. Utilise d'abord TÃ©lÃ©charger / Ouvrir DDU.", "error");
    setDduWorkflowRunning(false);
    setDduAutoCleanButtonBusy(false);
    dduAutoCleanBusy = false;
    return;
  }
  launchDduAutoCleanAutomation(vendor, ddu.exe, det);
}

function dduAutoCleanAfterVendorPick() {
  var sel = $("dduAutoVendorSelect");
  if (!sel || !sel.value) {
    setDduAutoStatus("Choisis un fabricant GPU.", "error");
    return;
  }
  dduAutoCleanBusy = true;
  setDduAutoCleanButtonBusy(true);
  window.setTimeout(function () {
    dduAutoCleanContinueWithVendor(String(sel.value).toUpperCase());
  }, 10);
}

function dduAutoCleanExperimental() {
  if (dduAutoCleanBusy) return;
  dduAutoCleanPollGen++;
  stopDduProcessExitWatcher();
  dduWatcherUiPhase = "idle";
  dduAutoCleanBusy = true;
  setDduWorkflowRunning(true);
  driversWorkflowState.dduDone = false;
  driversWorkflowState.dduError = false;
  setDduAutoCleanButtonBusy(true);
  showDduAutoVendorPick(false);
  setDduAutoStatus("DÃ©tection du GPU...", "info", 0);
  window.setTimeout(function () {
    try {
      var det = detectGpuVendor();
      writeDduAutoCleanLog("DATE=" + new Date().toISOString());
      writeDduAutoCleanLog("ACTION=detect_gpu");
      writeDduAutoCleanLog("GPU_LIST=" + det.gpuList);
      writeDduAutoCleanLog("GPU_SELECTED=" + det.selected);
      writeDduAutoCleanLog("");
      if (det.needsChoice) {
        setDduAutoStatus("Plusieurs GPU dÃ©tectÃ©s  â€” choisis le fabricant.", "info");
        showDduAutoVendorPick(true, det);
        setDduWorkflowRunning(false);
        setDduAutoCleanButtonBusy(false);
        dduAutoCleanBusy = false;
        return;
      }
      if (det.selected === "UNKNOWN") {
        setDduAutoStatus("GPU non reconnu  â€” choisis le fabricant.", "info");
        showDduAutoVendorPick(true, det);
        setDduWorkflowRunning(false);
        setDduAutoCleanButtonBusy(false);
        dduAutoCleanBusy = false;
        return;
      }
      dduAutoCleanContinueWithVendor(det.selected);
    } catch (eExp) {
      writeDduAutoCleanLog("ERROR=" + String(eExp.message || eExp));
      setDduAutoStatus("Erreur : " + String(eExp.message || eExp), "error");
      setDduWorkflowRunning(false);
      setDduAutoCleanButtonBusy(false);
      dduAutoCleanBusy = false;
    }
  }, 10);
}


function runCommandCapture(command) {
  try {
    createUnrealFolders();
    var outPath = UNREAL_LOGS + "\\nv-cmd-" + Date.now() + "-" + Math.floor(Math.random() * 10000) + ".txt";
    getShell().Run("cmd /c " + command + " > \"" + outPath + "\" 2>&1", 0, true);
    var txt = readTextFileAll(outPath);
    try { if (getFso().FileExists(outPath)) getFso().DeleteFile(outPath, true); } catch (eDel) {}
    return txt || "";
  } catch (eCmd) { return ""; }
}

function convertWindowsDriverToNvidiaVersion(raw) {
  var r = String(raw || "").replace(/^\s+|\s+$/g, "");
  var m = r.match(/^(\d+)\.(\d+)\.(\d+)\.(\d+)$/);
  if (!m) return "";
  var third = m[3];
  var last = m[4];
  if (third === "15" && last.length >= 4) {
    var major = "5" + last.substring(0, 2);
    var minor = last.substring(last.length - 2);
    return major + "." + minor;
  }
  return "";
}

function parseNvidiaLatestVersionFromHtml(html) {
  var h = String(html || "");
  var patterns = [
    /Game Ready Driver[\s\S]{0,220}?([0-9]{3}\.[0-9]{2})/i,
    /Studio Driver[\s\S]{0,220}?([0-9]{3}\.[0-9]{2})/i,
    /"version"\s*:\s*"([0-9]{3}\.[0-9]{2})"/i,
    /Version[:\s]+([0-9]{3}\.[0-9]{2})/i,
    />([0-9]{3}\.[0-9]{2})<\/span>/i
  ];
  var i;
  for (i = 0; i < patterns.length; i++) {
    var m = h.match(patterns[i]);
    if (m && m[1]) return m[1];
  }
  return "";
}

function gpuInfoToNvidiaLegacy(info) {
  if (!info) return { hasNvidia: false, gpuName: "", driverVersionRaw: "", driverVersion: "", source: "" };
  return {
    hasNvidia: info.vendor === "nvidia",
    gpuName: info.gpuName || "",
    driverVersionRaw: info.driverVersionRaw || "",
    driverVersion: info.driverVersion || "",
    source: info.source || ""
  };
}

function formatGpuDetectedLabel(info) {
  if (!info || !info.gpuName) return "GPU non dÃ©tectÃ©";
  if (info.hardwareOnly && info.gpuName) return info.gpuName + " (sans pilote)";
  return info.gpuName;
}

function formatDriverInstalledLabel(info) {
  if (!info || !info.gpuName) return "Pilote installÃ© : inconnu";
  if (!info.driverVersion) return "Pilote installÃ© : inconnu";
  return "Pilote installÃ© : " + info.driverVersion;
}

function syncNvidiaInfoCacheFromGpu(info) {
  sessionCache.gpuDriverInfo = info;
  if (info && info.hardwareOnly) sessionCache.nvidiaDriverCleaned = true;
  sessionCache.nvidiaInfo = gpuInfoToNvidiaLegacy(info);
}

function applyGpuDriverInfoToUi(forceRefresh) {
  if (forceRefresh) {
    sessionCache.gpuDriverInfo = null;
    sessionCache.nvidiaInfo = null;
  }
  var info = sessionCache.gpuDriverInfo;
  var upd = sessionCache.gpuDriverUpdate;
  if (!info) {
    if ($("nvGpuDetected")) $("nvGpuDetected").innerText = "â€”";
    if ($("nvDriverInstalled")) $("nvDriverInstalled").innerText = "â€”";
    if ($("nvDriverUpdateInstalledLine")) $("nvDriverUpdateInstalledLine").innerText = "Pilote installÃ© : â€”";
    return;
  }
  try {
    if ($("nvGpuDetected")) $("nvGpuDetected").innerText = formatGpuDetectedLabel(info);
    if ($("nvDriverInstalled")) $("nvDriverInstalled").innerText = info.driverVersion || "inconnu";
    if ($("nvDriverUpdateInstalledLine")) {
      $("nvDriverUpdateInstalledLine").innerText = formatDriverInstalledLabel(info);
    }
    if (upd && upd.latestVersion && $("nvDriverUpdateLatestLine") && !$("nvDriverUpdateLatestLine").getAttribute("data-locked")) {
      $("nvDriverUpdateLatestLine").innerText = "DerniÃ¨re version disponible : " + upd.latestVersion;
    }
  } catch (eSimple) {
    if ($("nvGpuDetected")) $("nvGpuDetected").innerText = "GPU non dÃ©tectÃ©";
    if ($("nvDriverInstalled")) $("nvDriverInstalled").innerText = "inconnu";
    if ($("nvDriverUpdateInstalledLine")) $("nvDriverUpdateInstalledLine").innerText = "Pilote installÃ© : inconnu";
  }
}

function applyNvDriverInfoToUi(forceRefresh) {
  applyGpuDriverInfoToUi(forceRefresh);
  if (forceRefresh && !sessionCache.gpuDriverInfo) {
    var info = getInstalledNvidiaDriverInfo(true);
    sessionCache.nvidiaInfo = info;
    if (info.hasNvidia) {
      syncNvidiaInfoCacheFromGpu({
        vendor: "nvidia",
        gpuName: info.gpuName,
        driverVersion: info.driverVersion || "",
        driverVersionRaw: info.driverVersionRaw || "",
        source: info.source || ""
      });
    }
    applyGpuDriverInfoToUi(false);
  }
}

function isGpuDriverInfoCacheFresh() {
  var info = sessionCache.gpuDriverInfo;
  if (!info || !info.checkedAt) return false;
  return (new Date().getTime() - info.checkedAt) < GPU_DRIVER_INFO_CACHE_MS;
}

function writeGpuDriverDetectScript() {
  createUnrealFolders();
  var psPath = UNREAL_LOGS + "\\gpu-driver-detect.ps1";
  var outPath = UNREAL_LOGS + "\\gpu-driver-detect.json";
  var escOut = String(outPath).replace(/'/g, "''");
  var lines = [
    "$ErrorActionPreference = 'SilentlyContinue'",
    "$OutPath = '" + escOut + "'",
    "$result = @{ vendor = ''; gpuName = ''; driverVersion = ''; driverVersionRaw = ''; source = ''; checkedAt = [int][double]::Parse((Get-Date -UFormat %s)) }",
    "function Get-GpuPriority([string]$name) {",
    "  $u = ($name + '').ToUpper()",
    "  if ($u -match 'MICROSOFT|REMOTE|VIRTUAL|BASIC|PARSEC|SPICE') { return 0 }",
    "  if ($u -match 'NVIDIA') { return 300 }",
    "  if ($u -match 'AMD|RADEON') { return 200 }",
    "  if ($u -match 'INTEL') { return 100 }",
    "  return 10",
    "}",
    "function Convert-NvidiaDrv([string]$raw) {",
    "  if ($raw -match '^(\\d+)\\.(\\d+)\\.(\\d+)\\.(\\d+)$') {",
    "    if ($Matches[3] -eq '15' -and $Matches[4].Length -ge 4) {",
    "      return ('5' + $Matches[4].Substring(0,2) + '.' + $Matches[4].Substring($Matches[4].Length-2))",
    "    }",
    "  }",
    "  return ''",
    "}",
    "$best = $null",
    "try {",
    "  $adapters = Get-WmiObject Win32_VideoController | ForEach-Object {",
    "    [PSCustomObject]@{ Name = [string]$_.Name; DriverVersion = [string]$_.DriverVersion; Priority = (Get-GpuPriority $_.Name) }",
    "  }",
    "  $best = $adapters | Where-Object { $_.Priority -gt 0 } | Sort-Object Priority -Descending | Select-Object -First 1",
    "} catch {}",
    "if (-not $best) { ($result | ConvertTo-Json -Compress) | Out-File -LiteralPath $OutPath -Encoding utf8 -Force; exit 0 }",
    "$result.gpuName = $best.Name",
    "$result.driverVersionRaw = $best.DriverVersion",
    "if ($best.Priority -ge 300) { $result.vendor = 'nvidia' }",
    "elseif ($best.Priority -ge 200) { $result.vendor = 'amd' }",
    "elseif ($best.Priority -ge 100) { $result.vendor = 'intel' }",
    "else { $result.vendor = 'other' }",
    "if ($result.vendor -eq 'nvidia') {",
    "  try {",
    "    $smi = & nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>$null",
    "    if ($smi -match '([0-9]{3}\\.[0-9]{2})') { $result.driverVersion = $Matches[1]; $result.source = 'nvidia-smi' }",
    "  } catch {}",
    "  if (-not $result.driverVersion) {",
    "    $regKeys = @(",
    "      @{ k = 'HKLM:\\SYSTEM\\CurrentControlSet\\Services\\nvlddmkm'; v = 'DisplayVersion' },",
    "      @{ k = 'HKLM:\\SYSTEM\\CurrentControlSet\\Services\\nvlddmkm'; v = 'DriverVersion' },",
    "      @{ k = 'HKLM:\\SOFTWARE\\NVIDIA Corporation\\Installer'; v = 'LastInstallerVersion' },",
    "      @{ k = 'HKLM:\\SOFTWARE\\NVIDIA Corporation\\Installer2'; v = 'Version' }",
    "    )",
    "    foreach ($rk in $regKeys) {",
    "      try {",
    "        $rv = (Get-ItemProperty -LiteralPath $rk.k -ErrorAction Stop).($rk.v)",
    "        if ($rv -match '([0-9]{3}\\.[0-9]{2})') { $result.driverVersion = $Matches[1]; $result.source = 'registry'; break }",
    "      } catch {}",
    "    }",
    "  }",
    "  if (-not $result.driverVersion) {",
    "    $cv = Convert-NvidiaDrv $result.driverVersionRaw",
    "    if ($cv) { $result.driverVersion = $cv; $result.source = 'wmi-converted' }",
    "  }",
    "}",
    "if (-not $result.driverVersion -and $result.driverVersionRaw) {",
    "  if ($result.driverVersionRaw -match '([0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2})') {",
    "    $result.driverVersion = $Matches[1]; $result.source = 'wmi-raw'",
    "  } else { $result.driverVersion = $result.driverVersionRaw; $result.source = 'wmi-raw' }",
    "}",
    "$dir = Split-Path -Parent $OutPath",
    "if ($dir -and -not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }",
    "($result | ConvertTo-Json -Compress) | Out-File -LiteralPath $OutPath -Encoding utf8 -Force"
  ];
  var tw = getFso().CreateTextFile(psPath, true);
  tw.Write(lines.join("\r\n"));
  tw.Close();
  return { psPath: psPath, outPath: outPath };
}

function readGpuDriverDetectResult(sinceMs) {
  try {
    var fso = getFso();
    var p = UNREAL_LOGS + "\\gpu-driver-detect.json";
    if (!fso.FileExists(p)) return null;
    if (sinceMs) {
      var fileMs = new Date(fso.GetFile(p).DateLastModified).getTime();
      if (fileMs < sinceMs - 1500) return null;
    }
    return JSON.parse(readTextFileAll(p));
  } catch (eR) {
    return null;
  }
}

function writeGpuDriverNvidiaUpdateScript(nvcExePath, gpuName) {
  createUnrealFolders();
  var psPath = UNREAL_LOGS + "\\gpu-driver-nvidia-update.ps1";
  var outPath = UNREAL_LOGS + "\\gpu-driver-nvidia-update.json";
  var escOut = String(outPath).replace(/'/g, "''");
  var escNvc = String(nvcExePath || "").replace(/'/g, "''");
  var escGpu = String(gpuName || "").replace(/'/g, "''");
  var osIds = NVIDIA_DRIVER_LOOKUP_OSIDS.join(",");
  var pfIds = NVIDIA_DRIVER_LOOKUP_PFIDS.join(",");
  var lines = [
    "$ErrorActionPreference = 'SilentlyContinue'",
    "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 -bor [Net.SecurityProtocolType]::Tls11",
    "$OutPath = '" + escOut + "'",
    "$NvcExe = '" + escNvc + "'",
    "$GpuName = '" + escGpu + "'",
    "$result = @{ ok = $false; version = ''; url = ''; source = ''; error = '' }",
    "$osIds = @(" + osIds + ")",
    "$pfIds = @(" + pfIds + ")",
    "function Write-Result {",
    "  param($obj)",
    "  $dir = Split-Path -Parent $OutPath",
    "  if ($dir -and -not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }",
    "  $json = $obj | ConvertTo-Json -Compress",
    "  [System.IO.File]::WriteAllText($OutPath, $json, [System.Text.UTF8Encoding]::new($false))",
    "}",
    "function Get-VersionFromBody([string]$body, [string]$url) {",
    "  if ($body -match '\"Version\"\\s*:\\s*\"([0-9]+\\.[0-9]+)\"') { return $Matches[1] }",
    "  if ($body -match '\"DisplayVersion\"\\s*:\\s*\"([0-9]+\\.[0-9]+)\"') { return $Matches[1] }",
    "  if ($url -match '/([0-9]{2,3}\\.[0-9]{2})/') { return $Matches[1] }",
    "  if ($url -match '([0-9]{2,3}\\.[0-9]{2})-desktop') { return $Matches[1] }",
    "  return ''",
    "}",
    "function Try-NvcleanstallCache {",
    "  if (-not $NvcExe -or -not (Test-Path -LiteralPath $NvcExe)) { return $null }",
    "  $roots = @([IO.Path]::GetDirectoryName($NvcExe), \"$env:LOCALAPPDATA\\NVCleanstall\", \"$env:APPDATA\\NVCleanstall\", \"$env:LOCALAPPDATA\\TechPowerUp\\NVCleanstall\")",
    "  foreach ($root in ($roots | Select-Object -Unique)) {",
    "    if (-not $root -or -not (Test-Path -LiteralPath $root)) { continue }",
    "    try {",
    "      $files = Get-ChildItem -LiteralPath $root -Recurse -Include *.json,*.xml -ErrorAction SilentlyContinue | Select-Object -First 25",
    "      foreach ($f in $files) {",
    "        $t = [IO.File]::ReadAllText($f.FullName)",
    "        if ($t -match '\"Version\"\\s*:\\s*\"([0-9]{3}\\.[0-9]{2})\"') { return @{ version = $Matches[1]; source = 'NVCleanstall' } }",
    "        if ($t -match '\"DisplayVersion\"\\s*:\\s*\"([0-9]{3}\\.[0-9]{2})\"') { return @{ version = $Matches[1]; source = 'NVCleanstall' } }",
    "      }",
    "    } catch {}",
    "  }",
    "  return $null",
    "}",
    "foreach ($os in $osIds) {",
    "  foreach ($pf in $pfIds) {",
    "    try {",
    "      $api = 'https://gfwsl.geforce.com/services_toolkit/services/com/nvidia/services/AjaxDriverService.php?beta=null&dch=1&dltype=-1&func=DriverManualLookup&isWHQL=1&languageCode=1033&numberOfResults=1&osID=' + $os + '&pfid=' + $pf",
    "      $wc = New-Object System.Net.WebClient",
    "      $wc.Headers.Add('User-Agent', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36')",
    "      $body = $wc.DownloadString($api)",
    "      if ($body -notmatch '\"DownloadURL\"') { continue }",
    "      $url = ''",
    "      if ($body -match '\"DownloadURL\"\\s*:\\s*\"([^\"]+)\"') { $url = ($Matches[1] -replace '\\\\/','/') }",
    "      if (-not $url) { continue }",
    "      $ver = Get-VersionFromBody $body $url",
    "      $result.ok = $true; $result.url = $url; $result.version = $ver; $result.source = 'NVIDIA officiel'; break",
    "    } catch { if (-not $result.error) { $result.error = $_.Exception.Message } }",
    "  }",
    "  if ($result.ok) { break }",
    "}",
    "if (-not $result.ok) {",
    "  $nvcHit = Try-NvcleanstallCache",
    "  if ($nvcHit -and $nvcHit.version) { $result.ok = $true; $result.version = $nvcHit.version; $result.source = $nvcHit.source }",
    "}",
    "if (-not $result.ok -and -not $result.error) { $result.error = 'Service NVIDIA indisponible ou rÃ©ponse vide.' }",
    "Write-Result $result"
  ];
  var tw = getFso().CreateTextFile(psPath, true);
  tw.Write(lines.join("\r\n"));
  tw.Close();
  return { psPath: psPath, outPath: outPath };
}

function finalizeNvidiaUpdateFromApiResult(apiRes, info) {
  if (!apiRes) return null;
  var ok = apiRes.ok === true || apiRes.ok === "true" || apiRes.ok === "True";
  if (!ok) return apiRes;
  var ver = String(apiRes.version || "");
  var url = String(apiRes.url || "");
  if (!ver && url) ver = extractVersionFromNvidiaDriverDownloadUrl(url);
  if (!ver && apiRes.body) ver = extractNvidiaDriverVersionFromAjaxText(apiRes.body);
  apiRes.version = ver;
  apiRes.ok = !!ver;
  return apiRes;
}

function applyNvidiaDriverUpdateComparison(info, apiRes, gen) {
  var latLine = $("nvDriverUpdateLatestLine");
  if (latLine) latLine.removeAttribute("data-locked");
  apiRes = finalizeNvidiaUpdateFromApiResult(apiRes, info);
  var installedVer = (info && info.driverVersion) ? String(info.driverVersion).replace(/\s/g, "") : "";
  if (!installedVer) {
    var hwCheck = detectInstalledNvidiaDriver({ forceFull: true });
    if (hwCheck.installed && hwCheck.version) {
      installedVer = String(hwCheck.version);
      info.driverVersion = installedVer;
      info.source = hwCheck.source || info.source;
      syncNvidiaInfoCacheFromGpu(info);
    }
  }
  if (!installedVer) {
    var latestFromApi = (apiRes && apiRes.version) ? String(apiRes.version) : "";
    sessionCache.gpuDriverUpdate = {
      status: "no_driver",
      latestVersion: latestFromApi,
      error: "",
      source: (apiRes && apiRes.source) ? apiRes.source : "",
      checkedAt: new Date().getTime()
    };
    logGpuDriverCheck("RÃ©sultat comparaison : aucun pilote Nvidia installÃ©");
    applySimplifiedNvMediaCardUi();
    finishGpuDriverCheck();
    return;
  }
  if (!apiRes || !apiRes.ok || !apiRes.version) {
    var errMsg = (apiRes && apiRes.error) ? apiRes.error : "Service NVIDIA indisponible.";
    sessionCache.gpuDriverUpdate = { status: "unknown", latestVersion: "", error: errMsg, source: "", checkedAt: new Date().getTime() };
    logGpuDriverCheck("Source derniÃ¨re version : Ã©chec");
    logGpuDriverCheck("Erreur vÃ©rification pilote : " + errMsg);
    logGpuDriverCheck("RÃ©sultat comparaison : vÃ©rification indisponible");
    if (latLine) latLine.innerText = "DerniÃ¨re version disponible : â€”";
    applyNvidiaDriverUpdatePanel("neutral", "VÃ©rification momentanÃ©ment indisponible", "", false);
    finishGpuDriverCheck();
    return;
  }
  var latestVer = String(apiRes.version || "");
  var source = String(apiRes.source || "NVIDIA officiel");
  logGpuDriverCheck("Source utilisÃ©e pour la derniÃ¨re version : " + source);
  logGpuDriverCheck("DerniÃ¨re version disponible : " + latestVer);
  logGpuDriverCheck("Version pilote installÃ©e convertie : " + (info.driverVersion || "inconnu"));
  var cmp = compareDriverVersions(installedVer, latestVer);
  if (latLine) latLine.innerText = "DerniÃ¨re version disponible : " + latestVer;
  if (cmp >= 0) {
    sessionCache.gpuDriverUpdate = { status: "uptodate", latestVersion: latestVer, error: "", source: source, checkedAt: new Date().getTime() };
    logGpuDriverCheck("RÃ©sultat comparaison : Ã  jour");
    applySimplifiedNvMediaCardUi();
  } else {
    sessionCache.gpuDriverUpdate = { status: "update", latestVersion: latestVer, error: "", source: source, checkedAt: new Date().getTime() };
    logGpuDriverCheck("RÃ©sultat comparaison : mise Ã  jour disponible");
    if (latLine) latLine.setAttribute("data-locked", "1");
    applySimplifiedNvMediaCardUi();
  }
  try {
    writeNvDriverCheckState({
      gpuName: info.gpuName,
      vendor: info.vendor,
      driverVersion: info.driverVersion,
      latestVersion: latestVer,
      updateStatus: sessionCache.gpuDriverUpdate.status,
      updateSource: source,
      lastCheck: nowDateTimeFr()
    });
  } catch (eSt) {}
  finishGpuDriverCheck();
}

