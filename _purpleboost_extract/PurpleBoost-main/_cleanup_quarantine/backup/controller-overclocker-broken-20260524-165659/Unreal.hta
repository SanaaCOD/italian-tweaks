/**
 * Lance TCPOptimizer.exe avec Ã©lÃ©vation UAC.
 * @param {{ silentAlerts?: boolean, hiddenConsole?: boolean }} opt silentAlerts=true : pas d'alert() (profil gaming) ; hiddenConsole : fenÃªtre PowerShell masquÃ©e.
 * @returns {boolean} true si processus de lancement terminÃ© avec code 0
 */
function launchTcpOptimizerElevated(opt) {
  opt = opt || {};
  var silentAlerts = opt.silentAlerts === true;
  var hiddenConsole = opt.hiddenConsole === true;
  var path = resolveTcpOptimizerFullPath();
  if (!path || !fileExists(path)) {
    log("TCP Optimizer introuvable.");
    if (!silentAlerts) alert("TCP Optimizer introuvable.");
    return false;
  }
  log("Lancement de TCP Optimizer en administrateur...");
  try {
    createUnrealFolders();
    var fso = getFso();
    if (!fso.FolderExists(UNREAL_SCRIPTS)) fso.CreateFolder(UNREAL_SCRIPTS);
    var dir = fso.GetParentFolderName(path);
    var psPath = UNREAL_SCRIPTS + "\\launch-tcp-optimizer-elevated.ps1";
    var esc = function (s) { return (s || "").replace(/'/g, "''"); };
    var tw = fso.CreateTextFile(psPath, true);
    tw.Write("$ErrorActionPreference = 'Continue'\n");
    tw.Write("Write-Host '--- UNREAL : elevation TCP Optimizer (UAC) ---' -ForegroundColor Cyan\n");
    tw.Write("$exe = '" + esc(path) + "'\n");
    tw.Write("$wd  = '" + esc(dir) + "'\n");
    tw.Write("if (-not (Test-Path -LiteralPath $exe)) {\n");
    tw.Write("  Write-Host 'Fichier introuvable :' $exe -ForegroundColor Red\n");
    tw.Write("  Read-Host 'Appuie sur Entree pour fermer cette fenetre'\n");
    tw.Write("  exit 2\n");
    tw.Write("}\n");
    tw.Write("Write-Host 'Fichier :' $exe\n");
    tw.Write("Write-Host 'Une fenetre UAC va s afficher : clique sur Oui pour lancer en administrateur.' -ForegroundColor Yellow\n");
    tw.Write("try {\n");
    tw.Write("  Start-Process -FilePath $exe -WorkingDirectory $wd -Verb RunAs -ErrorAction Stop\n");
    tw.Write("  Write-Host 'TCP Optimizer lance en administrateur (UAC acceptee).' -ForegroundColor Green\n");
    tw.Write("  Start-Sleep -Seconds 2\n");
    tw.Write("  exit 0\n");
    tw.Write("} catch {\n");
    tw.Write("  $m = $_.Exception.Message\n");
    tw.Write("  Write-Host 'Erreur PowerShell / UAC :' $m -ForegroundColor Red\n");
    tw.Write("  Read-Host 'Appuie sur Entree pour fermer cette fenetre'\n");
    tw.Write("  if ($m -match 'canceled|cancelled|annul|refus|denied|utilisateur|user|1223|operation was canceled') { exit 1 }\n");
    tw.Write("  exit 3\n");
    tw.Write("}\n");
    tw.Close();
    var cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psPath + "\"";
    var exitCode = getShell().Run(cmd, hiddenConsole ? 0 : 1, true);
    if (exitCode === 0) {
      log("TCP Optimizer lancÃ© en administrateur.");
      if (!silentAlerts) alert("TCP Optimizer lancÃ© en administrateur.");
      return true;
    }
    if (exitCode === 2) {
      log("TCP Optimizer introuvable.");
      if (!silentAlerts) alert("TCP Optimizer introuvable.");
      return false;
    }
    if (exitCode === 1) {
      log("Lancement administrateur refusÃ©.");
      if (!silentAlerts) alert("Lancement administrateur refusÃ©.");
      return false;
    }
    log("Erreur : impossible de lancer TCP Optimizer en administrateur.");
    if (!silentAlerts) alert("Erreur au lancement. Regarde la fenÃªtre PowerShell pour le message dÃ©taillÃ©.");
    return false;
  } catch (e) {
    log("Erreur : impossible de lancer TCP Optimizer en administrateur.");
    if (!silentAlerts) alert("Erreur au lancement. Regarde la fenÃªtre PowerShell pour le message dÃ©taillÃ©.\n\n" + e.message);
    return false;
  }
}

function launchTcpOptimizer() {
  var ready = ensureTcpOptimizerDownloaded(false);
  if (!ready) {
    log("TCP Optimizer : tÃ©lÃ©chargement requis non terminÃ©.");
    return;
  }
  launchTcpOptimizerElevated({ silentAlerts: false, hiddenConsole: false });
}

