function nvGamingStepUiLabel(status, skippedLabel) {
  if (status === "Success") return "OK";
  if (status === "Failed") return "Ã‰chec";
  if (status === "Unsupported") return "Non supportÃ©";
  if (status === "Skipped") return skippedLabel || "Non configurÃ©";
  return status || "â€”";
}

function nvGsyncUiLabel(step) {
  if (!step || !step.status) return "Statut inconnu";
  if (step.status === "Success" && step.verified === true && step.message === "OFF") return "OFF";
  if (step.status === "Skipped" && step.message && step.message.indexOf("outil manquant") >= 0) return "outil manquant / ignorÃ©";
  if (step.message && step.message.indexOf("Outil G-Sync manquant") >= 0) return "outil manquant / ignorÃ©";
  if (step.status === "Failed" && step.message && step.message.indexOf("Statut inconnu") >= 0) return "Statut inconnu";
  if (step.status === "Failed") return "Ã‰chec";
  if (step.status === "Skipped") return "ignorÃ©";
  return "Statut inconnu";
}

function nvDigitalVibranceUiLabel(step) {
  if (step && step.status === "Success" && step.verified === true) return "OK";
  if (step && step.status === "Failed") return "Ã‰chec";
  return "â€”";
}

function nvInverseTelecineUiLabel(step) {
  if (!step || !step.status) return "Non vÃ©rifiÃ©";
  if (step.status === "Success" && step.verified === true) return "OFF";
  if (step.status === "Failed") return "Ã‰chec";
  if (step.status === "Skipped") return "Non vÃ©rifiÃ©";
  return "Non vÃ©rifiÃ©";
}

function nvStableAppliedLabel(step) {
  if (step && step.status === "Success" && step.verified === true) return "appliquÃ©";
  if (step && step.status === "Success") return "appliquÃ©";
  if (step && step.status === "Skipped") return "ignorÃ©";
  return "erreur";
}

function renderNvGamingStepsPanel(payload, fullOptOnly) {
  var box = $("nvidiaGamingSteps");
  if (!box || !payload) return;
  var lines;
  if (fullOptOnly) {
    lines = [
      "Profil NVIDIA : " + nvStableAppliedLabel(payload.nipProfile),
      "Ã‰clat numÃ©rique : " + nvStableAppliedLabel(payload.digitalVibrance),
      "RÃ©solution max : " + nvStableAppliedLabel(payload.resolution),
      "FrÃ©quence max : " + nvStableAppliedLabel(payload.refreshRate)
    ];
  } else {
    lines = [
      "Profil NVIDIA : " + nvStableAppliedLabel(payload.nipProfile),
      "RÃ©solution max : " + nvStableAppliedLabel(payload.resolution),
      "FrÃ©quence max : " + nvStableAppliedLabel(payload.refreshRate),
      "Ã‰clat numÃ©rique 80% : " + nvStableAppliedLabel(payload.digitalVibrance),
      "G-Sync : " + nvStableAppliedLabel(payload.gsyncOff),
      "TÃ©lÃ©cinÃ© inversÃ© : " + nvStableAppliedLabel(payload.inverseTelecine)
    ];
  }
  box.innerHTML = lines.join("<br/>");
  box.style.display = "block";
}

function parseNvV2JsonFromRaw(raw) {
  if (!raw) return null;
  var t = String(raw).replace(/^\uFEFF/, "").trim();
  if (!t) return null;
  try { return JSON.parse(t); } catch (e1) {}
  var idx = t.lastIndexOf("{");
  if (idx >= 0) {
    try { return JSON.parse(t.substring(idx)); } catch (e2) {}
  }
  return null;
}

function makeEmptyNvV2Payload(msg) {
  return {
    success: false,
    warning: true,
    message: msg || "RÃ©ponse V2 incomplÃ¨te",
    nipProfile: { status: "Skipped", message: "", verified: false },
    resolution: { status: "Skipped", message: "", verified: false },
    refreshRate: { status: "Skipped", message: "", verified: false },
    digitalVibrance: { status: "Failed", message: msg || "Non exÃ©cutÃ©", verified: false },
    gsyncOff: { status: "Skipped", message: "", verified: false },
    inverseTelecine: { status: "Skipped", message: "", verified: false },
    steps: []
  };
}

function runNvidiaAutomationV2ExecAsync(cliArgs, logTag, timeoutMs, onDone) {
  createUnrealFolders();
  var exe = getNvidiaAutomationV2ExePath();
  if (!exe || !fileExists(exe)) {
    if (onDone) onDone({ error: "NvidiaAutomationV2.exe introuvable â€” lancez tools/nvidia-automation-v2/build.ps1" });
    return;
  }
  var app = getAppFolderFromHta();
  var stdoutPath = UNREAL_LOGS + "\\" + logTag + "-result.json";
  var psPath = UNREAL_LOGS + "\\" + logTag + "-run.ps1";
  var escExe = String(exe).replace(/'/g, "''");
  var escRoot = String(app || "").replace(/'/g, "''");
  var escOut = String(stdoutPath).replace(/'/g, "''");
  var waitMs = timeoutMs || 20000;
  var fso = getFso();
  var psLines = [
    "$ErrorActionPreference = 'Continue'",
    "$Exe = '" + escExe + "'",
    "$Root = '" + escRoot + "'",
    "$StdoutPath = '" + escOut + "'",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Exe",
    "$psi.Arguments = '" + cliArgs + " --json --purpleboost-root \"' + $Root + '\"'",
    "$psi.WorkingDirectory = (Split-Path -Parent $Exe)",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$psi.RedirectStandardOutput = $true",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if ($p) {",
    "  $stdout = $p.StandardOutput.ReadToEnd()",
    "  if (-not $p.WaitForExit(" + waitMs + ")) { try { $p.Kill() } catch {}; $stdout = '{\"success\":false,\"message\":\"NvidiaAutomationV2 : timeout\",\"steps\":[]}' }",
    "  $out = $stdout",
    "  if (-not $out -or $out.Trim().Length -eq 0) { $out = '{\"success\":false,\"message\":\"stdout vide\",\"steps\":[]}' }",
    "  [System.IO.File]::WriteAllText($StdoutPath, $out, [System.Text.UTF8Encoding]::new($false))",
    "  exit 0",
    "}",
    "exit 18"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(psLines.join("\r\n"));
  tw.Close();
  appendNvGamingLogLine("V2_EXEC_ASYNC=" + logTag + " args=" + cliArgs);

  var cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psPath + "\"";
  var shell = new ActiveXObject("WScript.Shell");
  var exec = shell.Exec(cmd);
  var t0 = new Date().getTime();
  var hardLimitMs = waitMs + 5000;

  function finishResult(r) {
    if (onDone) onDone(r);
  }

  function readPayload() {
    var payload = null;
    var parseErr = "";
    try {
      if (fso.FileExists(stdoutPath)) {
        var raw = readTextFileAll(stdoutPath);
        payload = parseNvV2JsonFromRaw(raw);
        if (!payload) parseErr = "JSON invalide";
        try { fso.DeleteFile(stdoutPath, true); } catch (eDel) {}
      } else {
        parseErr = "fichier rÃ©sultat absent";
      }
    } catch (eP) {
      parseErr = String(eP.message || eP);
      appendNvGamingLogLine("V2_PARSE_ERROR=" + logTag + " " + parseErr);
    }
    try { fso.DeleteFile(psPath, true); } catch (eD) {}
    if (!payload) {
      return { error: parseErr || "RÃ©ponse V2 illisible", payload: makeEmptyNvV2Payload(parseErr) };
    }
    return { payload: payload };
  }

  function poll() {
    var elapsed = new Date().getTime() - t0;
    if (elapsed > hardLimitMs) {
      try { exec.Terminate(); } catch (eKill) {}
      var timeoutPayload = makeEmptyNvV2Payload("NvidiaAutomationV2 : timeout");
      timeoutPayload.success = false;
      timeoutPayload.message = "NvidiaAutomationV2 : timeout";
      timeoutPayload.steps = [];
      finishResult({ error: "timeout", payload: timeoutPayload });
      return;
    }
    if (exec.Status === 1) {
      finishResult(readPayload());
      return;
    }
    window.setTimeout(poll, 400);
  }
  window.setTimeout(poll, 400);
}

function runNvidiaAutomationV2Exec(cliArgs, logTag, timeoutMs) {
  createUnrealFolders();
  var exe = getNvidiaAutomationV2ExePath();
  if (!exe || !fileExists(exe)) {
    return { error: "NvidiaAutomationV2.exe introuvable â€” lancez tools/nvidia-automation-v2/build.ps1" };
  }
  var app = getAppFolderFromHta();
  var stdoutPath = UNREAL_LOGS + "\\" + logTag + "-result.json";
  var psPath = UNREAL_LOGS + "\\" + logTag + "-run.ps1";
  var escExe = String(exe).replace(/'/g, "''");
  var escRoot = String(app || "").replace(/'/g, "''");
  var escOut = String(stdoutPath).replace(/'/g, "''");
  var waitMs = timeoutMs || 300000;
  var fso = getFso();
  var psLines = [
    "$ErrorActionPreference = 'Continue'",
    "$Exe = '" + escExe + "'",
    "$Root = '" + escRoot + "'",
    "$StdoutPath = '" + escOut + "'",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Exe",
    "$psi.Arguments = '" + cliArgs + " --json --purpleboost-root \"' + $Root + '\"'",
    "$psi.WorkingDirectory = (Split-Path -Parent $Exe)",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$psi.RedirectStandardOutput = $true",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if ($p) {",
    "  $stdout = $p.StandardOutput.ReadToEnd()",
    "  if (-not $p.WaitForExit(" + waitMs + ")) { try { $p.Kill() } catch {}; $stdout = '{\"success\":false,\"message\":\"timeout V2\",\"warning\":true}' }",
    "  $out = $stdout",
    "  if (-not $out -or $out.Trim().Length -eq 0) { $out = '{\"success\":false,\"message\":\"stdout vide\",\"warning\":true}' }",
    "  [System.IO.File]::WriteAllText($StdoutPath, $out, [System.Text.UTF8Encoding]::new($false))",
    "  exit 0",
    "}",
    "exit 18"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(psLines.join("\r\n"));
  tw.Close();
  appendNvGamingLogLine("V2_EXEC=" + logTag + " args=" + cliArgs);
  runPowerShell("-ExecutionPolicy Bypass -File \"" + psPath + "\"");
  var payload = null;
  var parseErr = "";
  try {
    if (fso.FileExists(stdoutPath)) {
      var raw = readTextFileAll(stdoutPath);
      payload = parseNvV2JsonFromRaw(raw);
      if (!payload) parseErr = "JSON invalide";
      fso.DeleteFile(stdoutPath, true);
    } else {
      parseErr = "fichier rÃ©sultat absent";
    }
  } catch (eP) {
    parseErr = String(eP.message || eP);
    appendNvGamingLogLine("V2_PARSE_ERROR=" + logTag + " " + parseErr);
  }
  try { fso.DeleteFile(psPath, true); } catch (eD) {}
  if (!payload) {
    return { error: parseErr || "RÃ©ponse V2 illisible", payload: makeEmptyNvV2Payload(parseErr) };
  }
  return { payload: payload };
}

