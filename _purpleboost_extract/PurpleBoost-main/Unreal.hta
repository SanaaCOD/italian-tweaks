function getControllerDevicesFinalPath() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) return getAbsolutePathFs(combinePath(app, "logs\\controller-devices-final.json"));
  return UNREAL_LOGS + "\\controller-devices-final.json";
}

function getControllerDevicesPresentPath() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) return getAbsolutePathFs(combinePath(app, "logs\\controller-devices-present.json"));
  return UNREAL_LOGS + "\\controller-devices-present.json";
}

function getSyncControllerDevicesScriptPath() {
  var scriptsDir = getAppScriptsDir();
  if (!scriptsDir) return "";
  return getAbsolutePathFs(combinePath(scriptsDir, "Devices\\Sync-ControllerDevices.ps1"));
}

function getDetectControllerScriptPath() {
  var scriptsDir = getAppScriptsDir();
  if (!scriptsDir) return "";
  return getAbsolutePathFs(combinePath(scriptsDir, "Devices\\Detect-USBControllers.ps1"));
}

function getControllerDevicesCachePath() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) return getAbsolutePathFs(combinePath(app, "logs\\controller-devices-cache.json"));
  return UNREAL_LOGS + "\\controller-devices-cache.json";
}

function getControllerHidusbfStatusAllPath() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) return getAbsolutePathFs(combinePath(app, "logs\\controller-hidusbf-status-all.json"));
  return UNREAL_LOGS + "\\controller-hidusbf-status-all.json";
}

function getControllerDeviceSignature(cards) {
  var keys = [];
  var i;
  for (i = 0; i < (cards || []).length; i++) {
    keys.push(String(cards[i].UsbParentDeviceId || cards[i].DeviceInstanceId || cards[i].cardId || "").toUpperCase());
  }
  keys.sort();
  return keys.join("|");
}

function parseControllerCacheJson(text) {
  if (!text) return [];
  var raw = String(text).replace(/^\uFEFF/, "");
  var data = JSON.parse(raw);
  if (!data) return [];
  var list = data.length !== undefined && typeof data.length === "number" ? data : [data];
  var out = [];
  var i;
  for (i = 0; i < list.length; i++) {
    var norm = normalizeControllerDevice(list[i]);
    if (!norm) continue;
    var hasId = !!(norm.InstanceId || norm.DeviceInstanceId || norm.UsbParentDeviceId);
    var hasVidPid = !!(norm.Vid && norm.Pid);
    if (hasId || hasVidPid) out.push(norm);
  }
  return out;
}

function loadControllerDevicesCache() {
  try {
    var path = getControllerDevicesCachePath();
    if (!path || !getFso().FileExists(path)) return null;
    return parseControllerCacheJson(readUtf8TextFileAll(path));
  } catch (eCache) {
    return null;
  }
}

function saveControllerDevicesCache(cards) {
  try {
    if (!cards || !cards.length) return;
    var path = getControllerDevicesCachePath();
    if (!path) return;
    var dir = getFso().GetParentFolderName(path);
    if (dir && !getFso().FolderExists(dir)) getFso().CreateFolder(dir);
    var out = [];
    var i;
    for (i = 0; i < (cards || []).length; i++) {
      var c = cards[i];
      if (!c) continue;
      out.push({
        DisplayName: c.DisplayName || c.Name,
        DeviceInstanceId: c.DeviceInstanceId || c.InstanceId,
        UsbParentDeviceId: c.UsbParentDeviceId,
        Vid: c.Vid,
        Pid: c.Pid,
        Type: c.Type,
        Badge: c.Badge,
        MaxRateHz: c.MaxRateHz,
        CurrentRateHz: c.CurrentRateHz || c.ConfiguredRate,
        LastKnownRateHz: (c.status && c.status.Verified && (c.CurrentRateHz || c.ConfiguredRate)) ? (c.CurrentRateHz || c.ConfiguredRate) : (c.LastKnownRateHz || 0),
        ParentResolved: c.ParentResolved,
        CardId: getControllerCardId(c)
      });
    }
    writeUtf8TextFileAll(path, JSON.stringify(out));
  } catch (eSave) {}
}

function runPowerShellAsync(cmd, waitForPath, onDone, timeoutMs) {
  var gen = controllerOverclockerGen;
  var timeout = timeoutMs || 22000;
  var start = new Date().getTime();
  try {
    getShell().Run(cmd, 0, false);
  } catch (eRun) {
    if (onDone) onDone(false, "run_error");
    return;
  }
  var poll = window.setInterval(function () {
    if (gen !== controllerOverclockerGen) {
      window.clearInterval(poll);
      return;
    }
    if (waitForPath && getFso().FileExists(waitForPath)) {
      window.clearInterval(poll);
      if (onDone) onDone(true);
      return;
    }
    if (new Date().getTime() - start > timeout) {
      window.clearInterval(poll);
      if (onDone) onDone(false, "timeout");
    }
  }, 100);
}

function controllerCoIsSilentDetectReason(reason) {
  if (reason === "manual") return false;
  if (reason === "boot-preload") return true;
  if (reason === "initial") {
    return !!(controllerOverclockerState.lastStableDevices && controllerOverclockerState.lastStableDevices.length);
  }
  return true;
}

function controllerCoCardsSignature(cards) {
  var keys = [];
  var i;
  for (i = 0; i < (cards || []).length; i++) {
    if (cards[i]) keys.push(getControllerCardId(cards[i]));
  }
  keys.sort();
  return keys.join("|");
}

function controllerCoCloneCards(cards) {
  var out = [];
  var i;
  for (i = 0; i < (cards || []).length; i++) {
    if (!cards[i]) continue;
    try {
      out.push(JSON.parse(JSON.stringify(cards[i])));
    } catch (eCl) {
      out.push(cards[i]);
    }
  }
  return out;
}

function controllerCoMergeStableCardState(newCard, oldCard) {
  if (!oldCard) return newCard;
  if (oldCard.status) newCard.status = oldCard.status;
  newCard.statusPending = false;
  newCard.applying = false;
  if (oldCard.uiRequestedRate) newCard.uiRequestedRate = oldCard.uiRequestedRate;
  if (oldCard.LastKnownRateHz > 0) newCard.LastKnownRateHz = oldCard.LastKnownRateHz;
  if (oldCard.CurrentRateHz > 0) newCard.CurrentRateHz = oldCard.CurrentRateHz;
  else if (oldCard.ConfiguredRate > 0) newCard.CurrentRateHz = oldCard.ConfiguredRate;
  if (oldCard.ConfiguredRate > 0) newCard.ConfiguredRate = oldCard.ConfiguredRate;
  return newCard;
}

function controllerCoGetCardDisplayConfirmed(card) {
  if (!card) return 0;
  if (card.uiState && card.uiState.currentRateHz > 0) return card.uiState.currentRateHz;
  if (card.status) return controllerCoResolveConfirmedRate(card.status);
  var cur = parseInt(card.CurrentRateHz, 10);
  if (!isNaN(cur) && cur > 0) return cur;
  cur = parseInt(card.ConfiguredRateHz, 10);
  if (!isNaN(cur) && cur > 0) return cur;
  cur = parseInt(card.ConfiguredRate, 10);
  if (!isNaN(cur) && cur > 0) return cur;
  cur = parseInt(card.PollingRateHz, 10);
  if (!isNaN(cur) && cur > 0) return cur;
  cur = parseInt(card.rateHz, 10);
  if (!isNaN(cur) && cur > 0) return cur;
  cur = parseInt(card.LastKnownRateHz, 10);
  if (!isNaN(cur) && cur > 0) return cur;
  return 0;
}

function controllerCoGetControllerAppState() {
  return {
    overclockedDeviceIds: controllerOverclockerState.overclockedDeviceIds || {},
    boostedControllerKeys: controllerOverclockerState.boostedControllerKeys || {}
  };
}

function controllerCoIsDeviceInAppBoostState(device, appState) {
  if (!device || !appState) return false;
  var id = String(device.DeviceInstanceId || device.InstanceId || "").toUpperCase();
  var parent = String(device.UsbParentDeviceId || device.TargetHidusbfDeviceId || "").toUpperCase();
  var cardKey = getControllerCardId(device).toUpperCase();
  if (appState.overclockedDeviceIds) {
    if (id && appState.overclockedDeviceIds[id]) return true;
    if (parent && appState.overclockedDeviceIds[parent]) return true;
    if (cardKey && appState.overclockedDeviceIds[cardKey]) return true;
  }
  if (appState.boostedControllerKeys) {
    if (cardKey && appState.boostedControllerKeys[cardKey]) return true;
  }
  return false;
}

function normalizeControllerStatus(device, appState) {
  appState = appState || controllerCoGetControllerAppState();
  device = device || {};
  var st = device.status || null;
  var rateFromStatus = st ? controllerCoResolveConfirmedRate(st) : 0;
  var currentRateHz = 0;
  var candidates = [
    device.currentRateHz, device.CurrentRateHz, device.configuredRateHz, device.ConfiguredRateHz,
    device.ConfiguredRate, device.pollingRateHz, device.PollingRateHz, device.rateHz, device.RateHz,
    device.LastKnownRateHz, rateFromStatus
  ];
  var ci;
  for (ci = 0; ci < candidates.length; ci++) {
    var n = parseInt(candidates[ci], 10);
    if (!isNaN(n) && n > 0) {
      currentRateHz = n;
      break;
    }
  }
  if (currentRateHz <= 0) currentRateHz = 125;

  var configuredRateHz = parseInt(device.ConfiguredRateHz != null ? device.ConfiguredRateHz : device.ConfiguredRate, 10);
  if (isNaN(configuredRateHz) || configuredRateHz <= 0) configuredRateHz = currentRateHz;

  var hasFilter = !!(device.hasFilter || device.HasFilter || device.hidusbfInstalled || device.HidusbfInstalled);
  if (st && st.HidusbfFilterPresent === true) hasFilter = true;
  if (configuredRateHz > 125 || currentRateHz > 125) hasFilter = true;

  var externalBoost = !!(device.IsBoosted || device.isBoosted);
  var inAppBoost = controllerCoIsDeviceInAppBoostState(device, appState);
  var isBoosted = hasFilter || currentRateHz > 125 || externalBoost || inAppBoost;
  if (st && (st.Status === "Optimized1000" || st.Status === "Optimized8000" || st.Optimized === true)) {
    isBoosted = true;
    if (rateFromStatus > 125) currentRateHz = rateFromStatus;
  }
  if (device.IsBoosted === true || device.isBoosted === true) isBoosted = true;

  var isConfirmed = isBoosted && (hasFilter || currentRateHz > 125);
  if (st && st.Verified === true && rateFromStatus > 125) isConfirmed = true;

  var buttonMode = isBoosted ? "restore" : "boost";
  if (device.ButtonMode === "restore" || device.buttonMode === "restore") buttonMode = "restore";
  if (device.ButtonMode === "boost" || device.buttonMode === "boost") buttonMode = "boost";
  if (!isBoosted) buttonMode = "boost";

  var source = String(device.StatusSource || device.statusSource || "");
  if (!source) {
    if (st && st.HidusbfFilterPresent != null) source = "hidusbf";
    else if (hasFilter || currentRateHz > 125) source = "hidusbf";
    else if (inAppBoost) source = "appState";
    else source = "default";
  }

  var showError = !!(device.lastApplyFailed && device.lastApplyFailed === true);
  var responseMs = st && st.ResponseTimeMs != null
    ? st.ResponseTimeMs
    : controllerCoDefaultResponseMs(currentRateHz > 0 ? currentRateHz : 125);

  return {
    currentRateHz: currentRateHz,
    configuredRateHz: configuredRateHz,
    hasFilter: hasFilter,
    isBoosted: isBoosted,
    isConfirmed: isConfirmed,
    buttonMode: buttonMode,
    source: source,
    externalBoostDetected: externalBoost || inAppBoost,
    showError: showError,
    responseMs: responseMs
  };
}

function controllerCoApplyUiStateToCard(card, appState) {
  if (!card) return card;
  card.uiState = normalizeControllerStatus(card, appState);
  card.CurrentRateHz = card.uiState.currentRateHz;
  card.ConfiguredRate = card.uiState.configuredRateHz;
  card.ConfiguredRateHz = card.uiState.configuredRateHz;
  card.PollingRateHz = card.uiState.currentRateHz;
  card.HasFilter = card.uiState.hasFilter;
  card.IsBoosted = card.uiState.isBoosted;
  card.IsConfirmed = card.uiState.isConfirmed;
  card.ButtonMode = card.uiState.buttonMode;
  card.StatusSource = card.uiState.source;
  if (card.uiState.currentRateHz > 0) card.LastKnownRateHz = card.uiState.currentRateHz;
  return card;
}

function controllerCoLogUiState(card) {
  if (!card) return;
  var ui = card.uiState || normalizeControllerStatus(card);
  var sig = ui.currentRateHz + "|" + ui.buttonMode + "|" + (ui.isBoosted ? "1" : "0") + "|" + (ui.hasFilter ? "1" : "0");
  if (card._lastUiLogSig === sig) return;
  card._lastUiLogSig = sig;
  var devLabel = getControllerCardId(card);
  writeControllerOverclockerLog(
    "[CONTROLLER-UI] device=" + devLabel +
    " currentRateHz=" + ui.currentRateHz +
    " hasFilter=" + (ui.hasFilter ? "true" : "false") +
    " isBoosted=" + (ui.isBoosted ? "true" : "false") +
    " isConfirmed=" + (ui.isConfirmed ? "true" : "false") +
    " button=" + ui.buttonMode
  );
  writeControllerOverclockerLog("[CONTROLLER-UI] externalBoostDetected=" + (ui.externalBoostDetected ? "true" : "false"));
}

function controllerCoLookupHidusbfStatusInMap(map, card) {
  if (!map || !card) return null;
  var keys = [];
  var seen = {};
  function addKey(k) {
    var u = String(k || "").toUpperCase();
    if (!u || seen[u]) return;
    seen[u] = true;
    keys.push(u);
  }
  addKey(card.TargetHidusbfDeviceId);
  addKey(card.UsbParentDeviceId);
  addKey(getControllerCardId(card));
  var usb = String(card.UsbParentDeviceId || "");
  if (/MI_/i.test(usb)) {
    addKey(usb.replace(/&MI_\d+.*$/i, ""));
    var m = usb.match(/^(USB\\VID_[0-9A-F]{4}&PID_[0-9A-F]{4})&MI_\d+\\(.+)$/i);
    if (m) addKey(m[1] + "\\" + m[2]);
  }
  var i;
  for (i = 0; i < keys.length; i++) {
    if (map[keys[i]]) return map[keys[i]];
  }
  return null;
}

function controllerCoCardShowsVerificationUi(card) {
  if (!card) return false;
  if (controllerOverclockerState.busy && getControllerCardId(card) === controllerOverclockerState.busyCardId) {
    return false;
  }
  if (card.applying) return false;
  if (controllerOverclockerState.isInitialLoading && !card.status && !controllerCoGetCardDisplayConfirmed(card)) {
    return true;
  }
  return false;
}

function loadControllerOverclockerFromCacheOnly() {
  var cached = loadControllerDevicesCache();
  if (!cached || !cached.length) return false;
  var i;
  controllerOverclockerState.isInitialLoading = true;
  for (i = 0; i < cached.length; i++) {
    cached[i].statusPending = false;
    cached[i].fromCache = true;
    cached[i].cached = true;
    cached[i].verifying = false;
    cached[i].Present = false;
    if (cached[i].LastKnownRateHz > 0 && !cached[i].CurrentRateHz) {
      cached[i].CurrentRateHz = cached[i].LastKnownRateHz;
    }
  }
  renderControllerOverclockerDeviceList(cached, { silent: true, skipStatusRefresh: true });
  writeControllerOverclockerLog("[DEVICE] Cache preview count=" + cached.length + " (stable preview)");
  return true;
}

function scheduleControllerInitialDetect() {
  window.setTimeout(function () {
    try { runControllerDetect("initial"); } catch (eDet) {}
  }, 50);
}

function setControllerOverclockerPendingUi() {
  var widget = $("controllerOverclockerWidget");
  var statusBadgeEl = $("cocStatusBadge");
  var pollingEl = $("cocPollingRate");
  var maxEl = $("cocMaxRate");
  var etatEl = $("cocEtatLabel");
  var responseEl = $("cocResponseTime");
  var potentialEl = $("cocPotential");
  var stateLineEl = $("cocStateLine");
  if (widget) widget.className = "coc-widget coc-tone-pending";
  if (statusBadgeEl) {
    statusBadgeEl.innerText = "\u2026";
    statusBadgeEl.className = "coc-badge coc-badge--default";
  }
  if (pollingEl) pollingEl.innerText = "\u2014";
  if (maxEl) maxEl.innerText = "\u2014";
  if (etatEl) etatEl.innerText = "\u2026";
  if (responseEl) responseEl.innerText = "\u2014";
  if (potentialEl) potentialEl.innerText = "\u2014";
  if (stateLineEl && !controllerOverclockerState.busy) {
    stateLineEl.innerText = "V\u00e9rification en cours...";
    stateLineEl.className = "coc-state-line coc-state-line--info";
  }
}

function controllerCoIsOptimizedStatus(st, confirmedRateHz) {
  if (!st || confirmedRateHz <= 125) return false;
  if (st.Status === "Mismatch" || st.Status === "Unknown") return false;
  if (st.Optimized === true && confirmedRateHz >= 1000) return true;
  if (confirmedRateHz >= 8000) return st.Status === "Optimized8000";
  if (confirmedRateHz >= 1000) return st.Status === "Optimized1000" && confirmedRateHz < 8000;
  return false;
}

function controllerCoHasRateMismatch(st, confirmedRateHz, selectedRateHz) {
  if (st && st.Status === "Mismatch") return true;
  var sel = parseInt(selectedRateHz, 10) || 0;
  var req = st && st.RequestedRate ? parseInt(st.RequestedRate, 10) : 0;
  var last = controllerOverclockerState.uiLastClickedRate || 0;
  var wanted = sel >= 1000 ? sel : (req >= 1000 ? req : (last >= 1000 ? last : 0));
  if (wanted < 1000) return false;
  if (confirmedRateHz <= 125) return wanted >= 1000;
  return confirmedRateHz !== wanted;
}

function controllerCoFormatPotentialLabel(st, rateHz) {
  if (rateHz >= 8000) return "maximum";
  var pl = st && st.PotentialLabel ? fixUtf8Mojibake(String(st.PotentialLabel)) : "";
  if (pl && /maximum|max/i.test(pl)) return "maximum";
  return "0.13 ms";
}

function controllerCoBuildEtatLabel(st, confirmedRateHz, selectedRateHz) {
  var mismatch = controllerCoHasRateMismatch(st, confirmedRateHz, selectedRateHz);
  if (mismatch) return "Non confirm\u00e9";
  if (confirmedRateHz <= 0) return "Inconnu";
  if (confirmedRateHz <= 125) return "Default";
  if (confirmedRateHz >= 8000 && controllerCoIsOptimizedStatus(st, confirmedRateHz)) return "Optimis\u00e9 8000";
  if (confirmedRateHz >= 1000 && controllerCoIsOptimizedStatus(st, confirmedRateHz)) return "Optimis\u00e9 1000";
  if (st && st.Code === "PREPARED_NEEDS_RECONNECT") return "Pr\u00e9par\u00e9";
  return "Inconnu";
}

function controllerCoBuildStateLine(st, confirmedRateHz, selectedRateHz) {
  if (st && st.Message && controllerCoIsOptimizedStatus(st, confirmedRateHz) && !controllerCoHasRateMismatch(st, confirmedRateHz, selectedRateHz)) {
    return fixUtf8Mojibake(String(st.Message));
  }
  var mismatch = controllerCoHasRateMismatch(st, confirmedRateHz, selectedRateHz);
  var wanted = parseInt(selectedRateHz, 10) || 0;
  if (wanted < 1000 && controllerOverclockerState.uiLastClickedRate) wanted = controllerOverclockerState.uiLastClickedRate;
  if (mismatch && wanted >= 1000 && confirmedRateHz >= 1000) {
    return wanted + " Hz demand\u00e9 \u2014 " + confirmedRateHz + " Hz d\u00e9tect\u00e9";
  }
  if (st && st.Code === "PREPARED_NEEDS_RECONNECT") {
    var req = controllerOverclockerState.uiLastClickedRate || wanted;
    if (req > 0) return req + " Hz pr\u00e9par\u00e9 \u2014 rebranche la manette";
  }
  if (confirmedRateHz <= 125) return "Default d\u00e9tect\u00e9";
  if (confirmedRateHz >= 8000 && controllerCoIsOptimizedStatus(st, confirmedRateHz)) {
    return "Optimis\u00e9 8000 Hz confirm\u00e9";
  }
  if (confirmedRateHz >= 1000 && controllerCoIsOptimizedStatus(st, confirmedRateHz)) {
    return "Optimis\u00e9 1000 Hz confirm\u00e9";
  }
  if (confirmedRateHz <= 0 && st && st.Message) return fixUtf8Mojibake(String(st.Message));
  return "Non confirm\u00e9";
}

function renderControllerPollingStatusUi(status) {
  var widget = $("controllerOverclockerWidget");
  var deviceBadgeEl = $("controllerOverclockerDeviceBadge");
  var statusBadgeEl = $("cocStatusBadge");
  var pollingEl = $("cocPollingRate");
  var etatEl = $("cocEtatLabel");
  var responseEl = $("cocResponseTime");
  var potentialEl = $("cocPotential");
  var stateLineEl = $("cocStateLine");
  var dev = getSelectedControllerDevice();
  var selectedRate = controllerOverclockerState.uiLastClickedRate || 0;

  if (controllerOverclockerState.statusPending && !controllerOverclockerState.busy) {
    setControllerOverclockerPendingUi();
    return;
  }

  if (!dev && (!status || !status.DeviceFound)) {
    if (widget) widget.className = "coc-widget coc-tone-default";
    if (deviceBadgeEl) { deviceBadgeEl.innerText = "\u2014"; deviceBadgeEl.className = "coc-badge coc-badge--device"; }
    if (statusBadgeEl) { statusBadgeEl.innerText = "\u2014"; statusBadgeEl.className = "coc-badge coc-badge--default"; }
    if (pollingEl) pollingEl.innerText = "\u2014";
    var maxElEmpty = $("cocMaxRate");
    if (maxElEmpty) maxElEmpty.innerText = "\u2014";
    if (etatEl) etatEl.innerText = "\u2014";
    if (responseEl) responseEl.innerText = "\u2014";
    if (potentialEl) potentialEl.innerText = "\u2014";
    if (stateLineEl && !controllerOverclockerState.busy) {
      stateLineEl.innerText = status && status.Present === false ? "P\u00e9riph\u00e9rique d\u00e9connect\u00e9" : "\u2014";
    }
    updateControllerApplyUi();
    return;
  }

  var st = status || {};
  var confirmedRate = controllerCoResolveConfirmedRate(st);
  var optimized = controllerCoIsOptimizedStatus(st, confirmedRate);
  var mismatch = controllerCoHasRateMismatch(st, confirmedRate, selectedRate);
  var responseMs = st.ResponseTimeMs != null
    ? st.ResponseTimeMs
    : controllerCoDefaultResponseMs(confirmedRate > 0 ? confirmedRate : 125);

  if (widget) {
    if (mismatch) widget.className = "coc-widget coc-tone-mismatch";
    else if (optimized) widget.className = "coc-widget coc-tone-opt";
    else widget.className = "coc-widget coc-tone-default";
  }

  if (deviceBadgeEl) {
    var badgeText = st.DeviceBadge || (dev && dev.Type) || "Manette";
    deviceBadgeEl.innerText = fixUtf8Mojibake(String(badgeText)).toUpperCase();
    deviceBadgeEl.className = "coc-badge coc-badge--device";
  }
  if (statusBadgeEl) {
    if (mismatch) {
      statusBadgeEl.innerText = "NON CONFIRM\u00c9";
      statusBadgeEl.className = "coc-badge coc-badge--warn";
    } else if (optimized) {
      statusBadgeEl.innerText = "OPTIMIS\u00c9";
      statusBadgeEl.className = "coc-badge coc-badge--optimized";
    } else {
      statusBadgeEl.innerText = "DEFAULT";
      statusBadgeEl.className = "coc-badge coc-badge--default";
    }
  }
  if (pollingEl) pollingEl.innerText = confirmedRate > 0 ? (confirmedRate + " Hz") : "\u2014";
  var maxEl = $("cocMaxRate");
  if (maxEl && dev) {
    var maxHzUi = parseInt(dev.MaxRateHz, 10);
    if (isNaN(maxHzUi) || maxHzUi <= 0) {
      maxHzUi = controllerCoInferMaxRateHz(dev.Type, dev.Badge, dev.Vid, dev.Pid, dev.ChildName, dev.DisplayName);
    }
    maxEl.innerText = maxHzUi > 0 ? (maxHzUi + " Hz") : "\u2014";
  }
  if (etatEl) etatEl.innerText = controllerCoBuildEtatLabel(st, confirmedRate, selectedRate);
  if (responseEl) responseEl.innerText = controllerCoFormatResponseMs(responseMs);
  if (potentialEl) potentialEl.innerText = controllerCoFormatPotentialLabel(st, confirmedRate);
  if (stateLineEl && !controllerOverclockerState.busy) {
    stateLineEl.innerText = controllerCoBuildStateLine(st, confirmedRate, selectedRate);
    if (mismatch) stateLineEl.className = "coc-state-line coc-state-line--warn";
    else if (optimized) stateLineEl.className = "coc-state-line coc-state-line--success";
    else stateLineEl.className = "coc-state-line";
  }
  updateControllerApplyUi();
}

function refreshControllerPollingStatus(options) {
  options = options || {};
  if (controllerOverclockerState.cards && controllerOverclockerState.cards.length) {
    refreshAllControllerCardsStatusBatch();
    return;
  }
  var silent = !!options.silent;
  var dev = getSelectedControllerDevice();
  if (!dev) {
    controllerOverclockerState.statusPending = false;
    renderControllerPollingStatusUi(null);
    return;
  }
  if (controllerOverclockerState.statusRefreshing) return;
  controllerOverclockerState.statusRefreshing = true;
  controllerOverclockerState.statusPending = true;
  setControllerOverclockerPendingUi();
  writeControllerOverclockerLog("[DEVICE] Reading OC status");

  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var psPath = getControllerOcStatusScriptPath();
  if (!psPath || !getFso().FileExists(psPath)) {
    controllerOverclockerState.statusRefreshing = false;
    controllerOverclockerState.statusPending = false;
    writeControllerOverclockerLog("[DEVICE] Status result: error script_missing");
    return;
  }

  var logPath = getControllerOverclockerLogPath();
  var outPath = getControllerOverclockerStatusJsonPath();
  var instanceId = String(dev.InstanceId || dev.DeviceId || "");
  var usbParent = String(dev.TargetHidusbfDeviceId || dev.UsbCompositeParentId || dev.UsbParentDeviceId || "");
  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + psPath + '"' +
    ' -AppRoot "' + escapeControllerPsArg(app) + '"' +
    ' -LogPath "' + escapeControllerPsArg(logPath) + '"' +
    ' -OutputPath "' + escapeControllerPsArg(outPath) + '"' +
    ' -DeviceInstanceId "' + escapeControllerPsArg(instanceId) + '"' +
    ' -UsbParentDeviceId "' + escapeControllerPsArg(usbParent) + '"' +
    ' -Vid "' + escapeControllerPsArg(dev.Vid || "") + '"' +
    ' -Pid "' + escapeControllerPsArg(dev.Pid || "") + '"' +
    (silent ? ' -Quiet' : '');

  window.setTimeout(function () {
    try {
      getShell().Run(cmd, 0, true);
    } catch (eRun) {
      writeControllerOverclockerLog("[DEVICE] Status result: error " + String(eRun.message || eRun));
      controllerOverclockerState.statusRefreshing = false;
      controllerOverclockerState.statusPending = false;
      return;
    }
    var status = readControllerPollingStatusResult();
    controllerOverclockerState.statusPending = false;
    controllerOverclockerState.statusLoaded = true;
    if (status) {
      writeControllerOverclockerLog("[DEVICE] ConfirmedRate=" + String(status.ConfirmedRate != null ? status.ConfirmedRate : status.ConfiguredRate || "?"));
      writeControllerOverclockerLog("[DEVICE] Status=" + String(status.Status || "?"));
    }
    var statusKey = status
      ? String(status.Status || "") + "|" + String(status.ConfirmedRate != null ? status.ConfirmedRate : status.ConfiguredRate || "") + "|" + String(status.DeviceFound) + "|" + String(status.Present)
      : "";
    var wasPresent = controllerOverclockerState.lastDevicePresent;
    var isPresent = !!(status && status.DeviceFound !== false && status.Present !== false);
    if (wasPresent && !isPresent && statusKey !== controllerOverclockerState.lastStatusKey) {
      writeControllerOverclockerLog("[DEVICE] Device disconnected");
      renderControllerPollingStatusUi(status);
      window.setTimeout(function () {
        try { runControllerDetect("disconnect"); } catch (eReScan) {}
      }, 400);
    } else if (!wasPresent && isPresent && statusKey !== controllerOverclockerState.lastStatusKey) {
      writeControllerOverclockerLog("[DEVICE] Device reconnected, refreshing status");
      renderControllerPollingStatusUi(status);
    } else {
      renderControllerPollingStatusUi(status);
    }
    controllerOverclockerState.lastDevicePresent = isPresent;
    controllerOverclockerState.lastStatusKey = statusKey;
    controllerOverclockerState.statusRefreshing = false;
  }, 10);
}

function runControllerUsbSignatureCheck(onDone) {
  var sigScript = getControllerSignatureScriptPath();
  var sigOut = getControllerDeviceSignatureJsonPath();
  if (!sigScript || !getFso().FileExists(sigScript)) {
    if (onDone) onDone(null);
    return;
  }
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  try {
    if (getFso().FileExists(sigOut)) getFso().DeleteFile(sigOut, true);
  } catch (eClr) {}
  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + sigScript + '"' +
    ' -AppRoot "' + escapeControllerPsArg(app) + '"' +
    ' -OutputPath "' + escapeControllerPsArg(sigOut) + '"';
  var gen = controllerOverclockerGen;
  runPowerShellAsync(cmd, sigOut, function (ok) {
    if (gen !== controllerOverclockerGen) {
      if (onDone) onDone(null);
      return;
    }
    var sig = null;
    try {
      if (ok && getFso().FileExists(sigOut)) {
        var parsed = JSON.parse(String(readUtf8TextFileAll(sigOut) || "").replace(/^\uFEFF/, ""));
        sig = parsed && parsed.Signature ? String(parsed.Signature) : null;
      }
    } catch (eSig) {
      sig = null;
    }
    if (onDone) onDone(sig);
  }, 5000);
}

function pollControllerPnpSignature() {
  if (currentPageName !== "peripheral") return;
  if (controllerOverclockerState.scanning || controllerOverclockerState.busy) return;
  runControllerUsbSignatureCheck(function (usbSig) {
    if (controllerOverclockerState.scanning) return;
    var curSig = String(controllerOverclockerState.pnpSignature || "");
    if (!usbSig) return;
    if (usbSig === curSig) return;
    if (controllerOverclockerState.signatureDebounceTimerId) {
      window.clearTimeout(controllerOverclockerState.signatureDebounceTimerId);
    }
    controllerOverclockerState.signatureDebounceTimerId = window.setTimeout(function () {
      controllerOverclockerState.signatureDebounceTimerId = 0;
      if (controllerOverclockerState.scanning || controllerOverclockerState.busy) return;
      writeControllerOverclockerLog("[DEVICE-DETECT] signature_changed=true");
      runControllerDetect("signature-change");
    }, 500);
  });
}

function ensureControllerOverclockerWatcher() {
  if (controllerOverclockerState.watchIntervalId) return;
  controllerOverclockerState.watchIntervalId = window.setInterval(function () {
    pollControllerPnpSignature();
  }, 1500);
}

function stopControllerOverclockerWatcher() {
  if (controllerOverclockerState.watchIntervalId) {
    window.clearInterval(controllerOverclockerState.watchIntervalId);
    controllerOverclockerState.watchIntervalId = 0;
  }
}

