  "https://nl1-dl.techpowerup.com/files/NVCleanstall_1.19.0.exe",
  "https://sg1-dl.techpowerup.com/files/NVCleanstall_1.19.0.exe",
  "https://us1-dl.techpowerup.com/files/NVCleanstall_1.18.0.exe",
  "https://uk1-dl.techpowerup.com/files/NVCleanstall_1.18.0.exe",
  "https://de1-dl.techpowerup.com/files/NVCleanstall_1.18.0.exe"
];
var NVIDIA_PROFILE_INSPECTOR_ZIP_URLS = [
  "https://github.com/Orbmu2k/nvidiaProfileInspector/releases/download/2.4.0.4/nvidiaProfileInspector.zip",
  "https://github.com/Orbmu2k/nvidiaProfileInspector/releases/latest/download/nvidiaProfileInspector.zip"
];
/** Recherche du lien du dernier pilote (GeForce web service). osID : 135 Win11 64, 57 Win10 64 */
var NVIDIA_DRIVER_LOOKUP_OSIDS = [135, 57];
var NVIDIA_DRIVER_LOOKUP_PFIDS = [995, 994, 1030, 1029, 1028, 1019, 1018, 935, 932, 930, 919, 918];
var APP_BASE_DIRECTORY = "";
var GPU_CLEAN_REBOOT_BLOCK_RX = [
  /\bRestart-Computer\b/i,
  /\bshutdown(\.exe)?\b/i,
  /\bExitWindowsEx\b/i,
  /bcdedit[^\r\n]*safeboot/i,
  /\s-restart\b/i,
  /\s-shutdown\b/i,
  /\s\/restart\b/i,
  /pnputil[^\r\n]*\/reboot\b/i
];

/** Rafraîchissement stats Accueil (processus externe, non bloquant), ms */
var HOME_STATS_MS = 8000;
var HOME_STATS_COLLECT_TIMEOUT_MS = 12000;
var HOME_STATS_GPU_TIMEOUT_SEC = 4;
var homeStatsIntervalId = null;
var homeStatsPollIntervalId = null;
var homeStatsWorkerBusy = false;
var homeStatsCollectStartMs = 0;
var homeStatsCache = { cpu: null, gpu: null, ram: null, updatedAt: 0 };
var homeDateTimeIntervalId = null;
var homeHardwareStaticDone = false;
var connSelectedProfile = "gaming";
var WARZONE_FILE_NAMES = ["s.1.0.cod25.txt0", "s.1.0.cod25.txt1"];
var currentPageName = "home";
var UI_PERF_WARN_MS = 300;
var nvCheckGeneration = 0;
var sessionCache = {
  nvidiaInfo: null,
  gpuDriverInfo: null,
  gpuDriverUpdate: null,
  nvcExeLocate: null,
  nvcPresetProbe: null,
  nvcPresetLoaded: null,
  nvidiaDriverCleaned: false,
  suppressGpuDriverCheckUntil: 0,
};
var GPU_DRIVER_INFO_CACHE_MS = 300000;
var GPU_DRIVER_DETECT_TIMEOUT_MS = 14000;
var GPU_DRIVER_UPDATE_TIMEOUT_MS = 22000;
var gpuDriverCheckBusy = false;
var gpuDriverDetectPollId = null;
var gpuDriverUpdatePollId = null;
var gpuDriverCheckStartMs = 0;

/** Panneaux logs / parsing visibles uniquement si true (mode développeur). */
var SHOW_DEBUG_UI = false;
var UI_CONSUMER_PAGES = { home: 1, conn: 1, drivers: 1 };

function isConsumerUiPage(pageName) {
  var p = pageName || currentPageName || "";
  return !!UI_CONSUMER_PAGES[p];
}

function shouldShowUiLogs() {
  return SHOW_DEBUG_UI === true || !isConsumerUiPage();
}

function appendTopicLogFile(topic, message) {
  try {
    createUnrealFolders();
    var path = UNREAL_LOGS + "\\" + topic + ".log";
    var line = "[" + nowTime() + "] " + String(message || "");
    var fso = getFso();
    var ForAppending = 8;
    if (!fso.FileExists(path)) {
      var c = fso.CreateTextFile(path, true);
      c.WriteLine(line);
      c.Close();
      return;
    }
    var t = fso.OpenTextFile(path, ForAppending, true);
    t.WriteLine(line);
    t.Close();
  } catch (eTopic) {
    try { appendFileLogLine("[" + topic + "] " + String(message || "")); } catch (eFb) {}
  }
}

function appendDriversDiagLog(message) { appendTopicLogFile("drivers", message); }
function appendConnDiagLog(message) { appendTopicLogFile("connexion", message); }
function appendHomeDiagLog(message) { appendTopicLogFile("system", message); }

function $(id) { return document.getElementById(id); }
function pad2(n) { return n < 10 ? "0" + n : "" + n; }
function nowTime() { var d = new Date(); return pad2(d.getHours()) + ":" + pad2(d.getMinutes()) + ":" + pad2(d.getSeconds()); }
function nowDateTimeFr() {
  var d = new Date();
  return pad2(d.getDate()) + "/" + pad2(d.getMonth() + 1) + "/" + d.getFullYear() + " - " + pad2(d.getHours()) + ":" + pad2(d.getMinutes());
}

function perfLog(message) {
  try {
    appendFileLogLine("[PERF] " + String(message || ""));
  } catch (eP) {}
}

function perfStart(label) {
  return { label: String(label || ""), t: new Date().getTime() };
}

function perfEnd(mark) {
  if (!mark) return;
  var dt = new Date().getTime() - mark.t;
  if (dt >= UI_PERF_WARN_MS) perfLog(mark.label + " = " + dt + "ms (SLOW)");
  else perfLog(mark.label + " = " + dt + "ms");
}

function initHomeHardwareStaticOnce() {
  if (homeHardwareStaticDone) return;
  homeHardwareStaticDone = true;
  initHomeHardwareStatic();
}

function log(message) {
  var lineText = "[" + nowTime() + "] " + message;
  try { appendFileLogLine(lineText); } catch (e0) {}
  if (!shouldShowUiLogs()) return;
  var box = $("logBox");
  if (!box) return;
  var line = document.createElement("div");
  line.className = "logline";
  line.textContent = lineText;
  box.insertBefore(line, box.firstChild);
  while (box.childNodes.length > 280) box.removeChild(box.lastChild);
}

function logScriptErrorMasked(message, lineNo) {
  var msg = String(message || "erreur inconnue");
  if (lineNo) msg += " ligne " + lineNo;
  try {
    if (typeof writeNvcleanAutoLog === "function") writeNvcleanAutoLog("[SCRIPT] erreur masquee : " + msg);
  } catch (eW) {}
  try {
    log("[SCRIPT] erreur masquee : " + msg);
  } catch (eL) {}
}

window.onerror = function (message, source, lineno, colno, error) {
  try {
    logScriptErrorMasked(message, lineno);
  } catch (e) {}
  return true;
};

function confirmAction(message) { return window.confirm(message); }

function showPage(pageName) {
  var mark = perfStart("showPage(" + pageName + ")");
  if (currentPageName === "drivers" && pageName !== "drivers") {
    nvCheckGeneration++;
    try { finishGpuDriverCheck(); } catch (eDrvStop) {}
  }
  currentPageName = pageName;
  try {
    var bodyCls = "";
    if (pageName === "peripheral") bodyCls = "page-peripheral-active";
    else if (pageName === "home") bodyCls = "page-home-active";
    else if (pageName === "conn") bodyCls = "page-conn-active";
    else if (pageName === "drivers") bodyCls = "page-drivers-active";
    else if (pageName === "opt") bodyCls = "page-opt-active";
    document.body.className = bodyCls;
  } catch (eBodyCls) {}
  var buttons = document.getElementsByClassName("navbtn");
  for (var i = 0; i < buttons.length; i++) {
    var b = buttons[i];
    b.className = "navbtn" + (b.getAttribute("data-page") === pageName ? " active" : "");
  }
  var pages = document.getElementsByClassName("page");
  for (var j = 0; j < pages.length; j++) {
    var p = pages[j];
    p.className = "page" + (p.id === "page-" + pageName ? " active" : "");
  }
  if (pageName === "conn") {
    window.setTimeout(function () {
      if (currentPageName !== "conn") return;
      try { refreshConnAdminBanner(); } catch (e1) {}
      try { refreshConnOptimizationStatusFromState(); } catch (e2) {}
      try { syncConnProfileSelectionUi(); } catch (e3) {}
    }, 0);
  }
  if (pageName === "game") {
    window.setTimeout(function () {
      if (currentPageName !== "game") return;
      try { refreshWarzoneInstallStatus(false); } catch (eGw) {}
    }, 0);
  }
  if (pageName === "peripheral") {
    window.setTimeout(function () {
      if (currentPageName !== "peripheral") return;
      writeControllerOverclockerLog("[DEVICE] Tab p\u00e9riph\u00e9rique opened \u2014 refreshing status");
      try { initControllerOverclockerUi(); } catch (eCoInit) {}
      try { runControllerDetect("initial"); } catch (eCoScan) {}
      try { ensureControllerOverclockerWatcher(); } catch (eCoWatch) {}
    }, 0);
  } else {
    try { stopControllerOverclockerWatcher(); } catch (eCoStop) {}
  }
  if (pageName === "drivers") {
    try { setDriversTabLightUi(); } catch (eDr) {}
  }
  if (pageName === "opt") {
    try { initOptimizationTab(); } catch (eOptInit) {
      try { appendOptimizationRunnerLog("init tab error: " + (eOptInit.message || eOptInit)); } catch (eLog) {}
    }
  }
  if (pageName === "home") {
    ensureHomeStatsTimer();
    window.setTimeout(function () {
      if (currentPageName !== "home") return;
      try { applyHomeStatsCacheToUi(); } catch (eHc) {}
      try { initHomeHardwareStaticOnce(); } catch (eHs) {}
    }, 0);
  } else {
    clearHomeStatsTimer();
  }
  perfEnd(mark);
}

function hydrateGpuDriverCacheFromPersistedState() {
  /* Pilote installé : jamais depuis JSON persistant  uniquement RefreshNvidiaDriverStatusAsync / Windows. */
}

function setDriversTabLightUi() {
  try { setNvidiaPanelStatus("Prêt", "ok"); } catch (eNp) {}
  try { updateDriversWorkflowGuide(); } catch (eWf) {}
  try { refreshDduCardUi(false); } catch (eDd) {}
  try { RefreshNvidiaDriverStatusAsync(null); } catch (eRef) {}
}

function getFso() { return new ActiveXObject("Scripting.FileSystemObject"); }
function getShell() { return new ActiveXObject("WScript.Shell"); }

/** PowerShell 64 bits (vue registre native, pas WOW6432Node) pour les scripts système. */
function getPowerShell64Path() {
  try {
    var sh = getShell();
    var sysRoot = sh.ExpandEnvironmentStrings("%SystemRoot%");
    var fso = getFso();
    var pNative = sysRoot + "\\Sysnative\\WindowsPowerShell\\v1.0\\powershell.exe";
    if (fso.FileExists(pNative)) return pNative;
    var p32 = sysRoot + "\\System32\\WindowsPowerShell\\v1.0\\powershell.exe";
    if (fso.FileExists(p32)) return p32;
  } catch (ePs) {}
  return "powershell.exe";
}

/** Chemin du fichier HTA courant (résolution chemin disque). */
function getUnrealHtaPath() {
  try {
    var href = String(window.location.href || "");
    if (href.indexOf("file:") !== 0) return "";
    var path = href.replace(/^file:\/\/?/i, "");
    if (path.indexOf("///") === 0) path = path.substring(2);
    else if (path.indexOf("//") === 0) path = path.substring(1);
    path = unescape(path.replace(/\//g, "\\"));
    if (path.length >= 3 && path.charAt(0) === "\\" && path.charAt(2) === ":") path = path.substring(1);
    var fso = getFso();
    if (path && fso.FileExists(path)) return path;
    return "";
  } catch (eH) {
    return "";
  }
}

/** Dossier contenant Unreal.hta (chemin absolu disque). */
function getUnrealHtaDirectory() {
  var p = getUnrealHtaPath();
  if (!p) return "";
  try {
    return getFso().GetParentFolderName(p);
  } catch (eD) {
    return "";
  }
}

/** URL file:/// pour MSHTA (évite chargement relatif capricieux). */
function unrealFileUrlFromAbs(absPath) {
  if (!absPath) return "";
  var p = String(absPath).replace(/\\/g, "/");
  if (/^[A-Za-z]:\//.test(p)) return "file:///" + p.replace(/ /g, "%20");
  return "file://" + p.replace(/ /g, "%20");
}

function wireBrandLogoPng(img, svgId) {
  if (!img) return;
  var svg = $(svgId);
  function showPng() {
    try {
      img.style.display = "block";
      if (svg) svg.style.display = "none";
    } catch (e1) {}
  }
  function showSvg() {
    try {
      img.style.display = "none";
      if (svg) svg.style.display = "block";
    } catch (e2) {}
  }
  img.onload = function () {
    showPng();
  };
  img.onerror = function () {
    showSvg();
  };
  try {
    if (img.complete) {
      if (img.naturalWidth > 0) showPng();
      else showSvg();
    }
  } catch (eC) {}
}

/** Logo PNG : chemin absolu + affichage fiable (pas de filtre CSS sur img sous Trident). */
function initBrandLogoImages() {
  var navSvg = $("brandLogoSvgNav");
  var heroSvg = $("brandLogoSvgHero");
  var nav = $("brandLogoPngNav");
  var hero = $("brandLogoPngHero");
  try {
    if (nav) nav.style.display = "none";
    if (hero) hero.style.display = "none";
    if (navSvg) navSvg.style.display = "block";
    if (heroSvg) heroSvg.style.display = "block";
  } catch (eShow) {}
  wireBrandLogoPng(nav, "brandLogoSvgNav");
  wireBrandLogoPng(hero, "brandLogoSvgHero");
  var dir = getUnrealHtaDirectory();
  if (!dir) return;
  var abs = dir + "\\assets\\images\\unreal-logo.png";
  try {
    if (!getFso().FileExists(abs)) return;
  } catch (eF) {
    return;
  }
  var url = unrealFileUrlFromAbs(abs);
  if (nav) nav.src = url;
  if (hero) hero.src = url;
}

function createUnrealFolders() {
  var fso = getFso();
  var paths = [UNREAL_BASE, UNREAL_TOOLS, UNREAL_TCP_DIR, UNREAL_SCRIPTS, UNREAL_LOGS, UNREAL_BACKUPS];
  for (var i = 0; i < paths.length; i++) {
    try {
      if (!fso.FolderExists(paths[i])) fso.CreateFolder(paths[i]);
    } catch (e) {
      log("ERREUR dossier : " + paths[i] + " - " + e.message);
      log("Relance UNREAL en administrateur.");
      return false;
    }
  }
  return true;
}

function appendFileLogLine(text) {
  var fso = getFso();
  if (!fso.FolderExists(UNREAL_LOGS)) createUnrealFolders();
  var path = UNREAL_LOGS + "\\unreal.log";
  var ForAppending = 8;
  var t;
  if (!fso.FileExists(path)) { t = fso.CreateTextFile(path, true); t.WriteLine(text); t.Close(); return; }
  t = fso.OpenTextFile(path, ForAppending, true);
  t.WriteLine(text);
  t.Close();
}

/** Une ligne dans connection-profiles.log (horodatage court). */
function appendConnectionProfilesLog(message) {
  try {
    var fso = getFso();
    if (!fso.FolderExists(UNREAL_LOGS)) {
      if (!createUnrealFolders()) throw new Error("Logs");
    }
    var path = CONNECTION_PROFILES_LOG;
    var line = "[" + nowTime() + "] " + (message || "");
    var ForAppending = 8;
    var t;
    if (!fso.FileExists(path)) {
      t = fso.CreateTextFile(path, true);
      t.WriteLine(line);
      t.Close();
      return;
    }
    t = fso.OpenTextFile(path, ForAppending, true);
    t.WriteLine(line);
    t.Close();
  } catch (eCpl) {
    try {
      log("Profils réseau rapides : impossible d'écrire connection-profiles.log - " + eCpl.message);
    } catch (e2) {}
  }
}

/**
 * Profils réseau rapides : écrit Gaming.bat ou Download.bat puis lancement UAC (Shell.Application runas).
 * @param {"gaming"|"download"} kind
 */
function launchQuickNetProfile(kind) {
  setConnProfileSelection(kind);
  var isDownload = kind === "download";
  var label = isDownload ? "Profil Download" : "Profil Gaming";
  var fileName = isDownload ? "Download.bat" : "Gaming.bat";
  var content = isDownload ? BAT_PROFILE_DOWNLOAD : BAT_PROFILE_GAMING;
  var successAlert = isDownload ? "Profil Download lancé en administrateur." : "Profil Gaming lancé en administrateur.";
  var batPath = UNREAL_SCRIPTS + "\\" + fileName;
  var fso;
  appendConnectionProfilesLog("Clic : " + label);
  try {
    fso = getFso();
  } catch (eFso) {
    appendConnectionProfilesLog("Erreur inconnue : " + (eFso && eFso.message ? eFso.message : String(eFso)));
    log(label + " : erreur inconnue - " + (eFso && eFso.message ? eFso.message : ""));
    alert("Erreur inconnue : " + (eFso && eFso.message ? eFso.message : String(eFso)));
    return;
  }
  if (!createUnrealFolders()) {
    appendConnectionProfilesLog("Erreur : impossible de créer le dossier (ProgramData\\Unreal ou Scripts).");
    log(label + " : impossible de créer le dossier.");
    alert("Impossible de créer le dossier.");
    return;
  }
  appendConnectionProfilesLog("Dossier Scripts : OK (créé ou déjà existant).");
  try {
    if (!fso.FolderExists(UNREAL_SCRIPTS)) {
      appendConnectionProfilesLog("Erreur : dossier Scripts introuvable après création.");
      alert("Impossible de créer le dossier.");
      return;
    }
  } catch (eChk) {
    appendConnectionProfilesLog("Erreur : accès refusé - " + eChk.message);
    log(label + " : accès refusé - " + eChk.message);
    alert("Accès refusé.");
    return;
  }
  try {
    var tw = fso.CreateTextFile(batPath, true);
    tw.Write(content);
    tw.Close();
  } catch (eWrite) {
    appendConnectionProfilesLog("Erreur : impossible d'écrire le fichier BAT - " + eWrite.message);
    log(label + " : impossible d'écrire le fichier BAT - " + eWrite.message);
    alert("Impossible d'écrire le fichier BAT.");
    return;
  }
  appendConnectionProfilesLog("Fichier BAT créé ou remplacé : " + fileName);
  appendConnectionProfilesLog("Chemin du BAT : " + batPath);
  if (!fileExists(batPath)) {
    appendConnectionProfilesLog("Erreur : fichier BAT introuvable après écriture.");
    log(label + " : fichier BAT introuvable.");
    alert("Fichier BAT introuvable.");
    return;
  }
  var workDir = UNREAL_SCRIPTS;
  try {
    workDir = fso.GetParentFolderName(batPath);
  } catch (eWd) {}
  appendConnectionProfilesLog("Demande d'exécution administrateur (UAC) pour : " + batPath);
  try {
    var app = new ActiveXObject("Shell.Application");
    app.ShellExecute(batPath, "", workDir, "runas", 1);
  } catch (eRun) {
    var msg = (eRun && eRun.message) ? eRun.message : String(eRun);
    var low = msg.toLowerCase();
    if (low.indexOf("canceled") >= 0 || low.indexOf("cancelled") >= 0 || low.indexOf("annul") >= 0 || low.indexOf("1223") >= 0 || low.indexOf("denied") >= 0) {
      appendConnectionProfilesLog("Erreur : lancement admin refusé - " + msg);
      log(label + " : lancement admin refusé.");
      alert("Lancement admin refusé.");
      return;
    }
    if (low.indexOf("accès") >= 0 || low.indexOf("access") >= 0) {
      appendConnectionProfilesLog("Erreur : accès refusé - " + msg);
      alert("Accès refusé.");
      return;
    }
    appendConnectionProfilesLog("Erreur inconnue (Shell.Application) : " + msg);
    log(label + " : erreur inconnue - " + msg);
    alert("Erreur inconnue : " + msg);
    return;
  }
  appendConnectionProfilesLog("Succès : demande UAC envoyée pour " + fileName + " (exécution élevée côté Windows).");
  log(successAlert);
  appendConnectionProfilesLog(successAlert);
  alert(successAlert);
}

function appendWarzoneLog(message) {
  var box = $("warzoneLogBox");
  if (!box) return;
  var line = document.createElement("div");
  line.className = "logline";
  line.textContent = "[" + nowTime() + "] " + message;
  box.insertBefore(line, box.firstChild);
  while (box.childNodes.length > 240) box.removeChild(box.lastChild);
}

function expandEnvPath(token) {
  try {
    var v = getShell().ExpandEnvironmentStrings(String(token || ""));
    if (v && v.indexOf("%") < 0) return v;
  } catch (e0) {}
  return "";
}

function getWarzoneSearchPlayerDirs() {
  var dirs = [];
  var seen = {};
  function addDir(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d]) return;
    seen[d] = true;
    dirs.push(d);
  }
  var local = expandEnvPath("%LOCALAPPDATA%");
  var profile = expandEnvPath("%USERPROFILE%");
  if (local) {
    addDir(local + "\\Activision\\Call of Duty\\players");
    addDir(local + "\\Activision\\Call of Duty");
  }
  if (profile) {
    addDir(profile + "\\Documents\\Call of Duty\\players");
    addDir(profile + "\\Documents\\Call of Duty");
  }
  try {
    var fso = getFso();
    var usersRoot = "C:\\Users";
    if (fso.FolderExists(usersRoot)) {
      var ef = new Enumerator(fso.GetFolder(usersRoot).SubFolders);
      for (; !ef.atEnd(); ef.moveNext()) {
        var sub = ef.item();
        var un = String(sub.Name || "");
        if (/^(Public|Default|Default User|All Users|DefaultAppPool)$/i.test(un)) continue;
        var up = String(sub.Path || "");
        addDir(up + "\\AppData\\Local\\Activision\\Call of Duty\\players");
        addDir(up + "\\Documents\\Call of Duty\\players");
      }
    }
  } catch (eU) {}
  return dirs;
}

function getWarzoneAutoPlayersDir() {
  var found = findWarzonePlayerDirWithTargetFiles(false);
  if (found) return found;
  var dirs = getWarzoneSearchPlayerDirs();
  var fso = getFso();
  var i;
  for (i = 0; i < dirs.length; i++) {
    if (dirs[i] && fso.FolderExists(dirs[i])) return dirs[i];
  }
  if (dirs.length) return dirs[0];
  return "";
}

function getWarzoneEmbeddedFilePath(fileName) {
  var dir = getUnrealHtaDirectory();
  if (!dir) return "";
  var names = [
    dir + "\\assets\\warzone\\" + fileName,
    dir + "\\assets\\Warzone\\" + fileName
  ];
  var fso = getFso();
  var i;
  for (i = 0; i < names.length; i++) {
    if (fso.FileExists(names[i])) return getAbsolutePathFs(names[i]);
  }
  return names[0];
}

function warzoneStatePath() {
  return UNREAL_BASE + "\\warzone-state.json";
}

function readWarzoneState() {
  try {
    var p = warzoneStatePath();
    if (!getFso().FileExists(p)) return null;
    return JSON.parse(readTextFileAll(p));
  } catch (eR) {
    return null;
  }
}

function writeWarzoneState(obj) {
  try {
    createUnrealFolders();
    var prev = readWarzoneState() || {};
    var k;
    for (k in obj) {
      if (obj.hasOwnProperty(k)) prev[k] = obj[k];
    }
    var w = getFso().CreateTextFile(warzoneStatePath(), true);
    w.Write(JSON.stringify(prev));
    w.Close();
  } catch (eW) {}
}

function findWarzonePlayerDirWithTargetFiles(requireMatchEmbedded) {
  var fso = getFso();
  var dirs = getWarzoneSearchPlayerDirs();
  var i, j;
  for (i = 0; i < dirs.length; i++) {
    var base = dirs[i];
    if (!base || !fso.FolderExists(base)) continue;
    var allPresent = true;
    var allMatch = true;
    for (j = 0; j < WARZONE_FILE_NAMES.length; j++) {
      var name = WARZONE_FILE_NAMES[j];
      var dst = base + "\\" + name;
      var src = getWarzoneEmbeddedFilePath(name);
      if (!fso.FileExists(dst)) {
        allPresent = false;
        allMatch = false;
        break;
      }
      if (requireMatchEmbedded) {
        if (!src || !fso.FileExists(src)) {
          allMatch = false;
          break;
        }
        if (!areFilesExactlyIdentical(src, dst)) {
          allMatch = false;
        }
      }
    }
    if (allMatch) return base;
    if (!requireMatchEmbedded && allPresent) return base;
  }
  return "";
}

function warzoneFilesPresentAtDir(baseFolder) {
  if (!baseFolder) return false;
  var fso = getFso();
  if (!fso.FolderExists(baseFolder)) return false;
  var i;
  for (i = 0; i < WARZONE_FILE_NAMES.length; i++) {
    if (!fso.FileExists(baseFolder + "\\" + WARZONE_FILE_NAMES[i])) return false;
  }
  return true;
}

function warzoneDirMatchesEmbedded(baseFolder) {
  if (!warzoneFilesPresentAtDir(baseFolder)) return false;
  var fso = getFso();
  var i;
  for (i = 0; i < WARZONE_FILE_NAMES.length; i++) {
    var name = WARZONE_FILE_NAMES[i];
    var src = getWarzoneEmbeddedFilePath(name);
    var dst = baseFolder + "\\" + name;
    if (!src || !fso.FileExists(src) || !fso.FileExists(dst)) return false;
    if (!areFilesExactlyIdentical(src, dst)) return false;
  }
  return true;
}

function resolveWarzoneInstallTargetDir() {
  var matched = findWarzonePlayerDirWithTargetFiles(true);
  if (matched) return matched;
  var fso = getFso();
  var dirs = getWarzoneSearchPlayerDirs();
  var i;
  for (i = 0; i < dirs.length; i++) {
    if (dirs[i] && fso.FolderExists(dirs[i])) return dirs[i];
  }
  var local = expandEnvPath("%LOCALAPPDATA%");
  if (local) return local + "\\Activision\\Call of Duty\\players";
  return "";
}

function readFileBase64(path) {
  try {
    var fso = getFso();
    if (!fso.FileExists(path)) return "";
    var stream = new ActiveXObject("ADODB.Stream");
    stream.Type = 1;
    stream.Open();
    stream.LoadFromFile(path);
    var bytes = stream.Read();
    stream.Close();
    var xml = new ActiveXObject("MSXML2.DOMDocument");
    var node = xml.createElement("b64");
    node.dataType = "bin.base64";
    node.nodeTypedValue = bytes;
    return String(node.text || "").replace(/\s+/g, "");
  } catch (eB) {
    return "";
  }
}

function areFilesExactlyIdentical(pathA, pathB) {
  var a = readFileBase64(pathA);
  var b = readFileBase64(pathB);
  if (!a || !b) return false;
  return a === b;
}

function setWarzoneInstallStatus(isInstalled, label) {
  var el = $("warzoneInstallStatus");
  if (!el) return;
  if (isInstalled) {
    el.className = "tcp-badge tcp-badge--ok";
    el.innerText = label || "Fichiers Warzone installés";
  } else {
    el.className = "tcp-badge tcp-badge--bad";
    el.innerText = label || "Fichiers Warzone non détectés";
  }
}

function verifyWarzoneInstallation(logDetails) {
  var matchedDir = findWarzonePlayerDirWithTargetFiles(true);
  if (matchedDir) {
    var prevSt = readWarzoneState();
    var mode = (prevSt && prevSt.profileActive) ? "profile" : "files";
    if (logDetails) {
      appendWarzoneLog((mode === "profile" ? "Profil Warzone actif" : "Fichiers Warzone installés") + " : " + matchedDir);
    }
    writeWarzoneState({
      installed: true,
      profileActive: mode === "profile",
      playersDir: matchedDir,
      checkedAt: nowDateTimeFr()
    });
    return { ok: true, dir: matchedDir, mode: mode };
  }
  var st = readWarzoneState();
  if (st && st.playersDir && warzoneDirMatchesEmbedded(st.playersDir)) {
    if (logDetails) appendWarzoneLog("état persistant validé : " + st.playersDir);
    return { ok: true, dir: st.playersDir, mode: st.profileActive ? "profile" : "files" };
  }
  if (logDetails) {
    appendWarzoneLog("Fichiers Warzone non détectés.");
    appendWarzoneLog("Chemins testés : " + getWarzoneSearchPlayerDirs().join(" | "));
  }
  writeWarzoneState({ installed: false, profileActive: false, playersDir: "", checkedAt: nowDateTimeFr() });
  return { ok: false, dir: "", mode: "" };
}

function refreshWarzoneInstallStatus(logDetails) {
  var res = { ok: false, dir: "", mode: "" };
  try {
    res = verifyWarzoneInstallation(!!logDetails);
  } catch (eV) {
    if (logDetails) appendWarzoneLog("Erreur détection : " + String(eV.message || eV));
    res = { ok: false, dir: "", mode: "" };
  }
  if (res.ok) {
    if (res.mode === "profile") setWarzoneInstallStatus(true, "Profil Warzone actif");
    else setWarzoneInstallStatus(true, "Fichiers Warzone installés");
  } else {
    setWarzoneInstallStatus(false, "Fichiers Warzone non détectés");
  }
  return res.ok;
}

function installWarzoneFiles() {
  var fso = getFso();
  var i;
  var baseFolder = resolveWarzoneInstallTargetDir();
  appendWarzoneLog("Chemin analysé : " + baseFolder);
  if (!baseFolder) {
    appendWarzoneLog("Erreur : impossible de déterminéer le dossier players Warzone.");
    alert("Dossier Warzone introuvable. Lance une fois Warzone, puis réessaie.");
    return;
  }
  if (!fso.FolderExists(baseFolder)) {
    if (!createFolder(baseFolder)) {
      appendWarzoneLog("Erreur : création du dossier impossible : " + baseFolder);
      alert("Impossible de créer le dossier Warzone : " + baseFolder);
      return;
    }
    appendWarzoneLog("Dossier créé : " + baseFolder);
  }
  var src = {};
  for (i = 0; i < WARZONE_FILE_NAMES.length; i++) {
    var n = WARZONE_FILE_NAMES[i];
    var p = getWarzoneEmbeddedFilePath(n);
    if (p && fso.FileExists(p)) {
      src[n] = p;
      continue;
    }
    appendWarzoneLog("Fichier source introuvable : " + n);
    alert("Fichier source introuvable : " + n + "\nAjoute-le dans assets\\warzone.");
    setWarzoneInstallStatus(false);
    return;
  }
  for (i = 0; i < WARZONE_FILE_NAMES.length; i++) {
    var name = WARZONE_FILE_NAMES[i];
    var tp = baseFolder + "\\" + name;
    var bak = tp + ".bak";
    try {
      if (fso.FileExists(tp)) {
        fso.CopyFile(tp, bak, true);
        appendWarzoneLog("Fichier sauvegardé : " + bak);
      }
      fso.CopyFile(src[name], tp, true);
      if (fso.FileExists(bak)) appendWarzoneLog("Fichier remplacé : " + tp);
      else appendWarzoneLog("Fichier copié : " + tp);
    } catch (eWz) {
      appendWarzoneLog("Erreur fichier (" + tp + ") : " + eWz.message);
    }
  }
  writeWarzoneState({ installed: true, profileActive: true, playersDir: baseFolder, checkedAt: nowDateTimeFr() });
  var installed = refreshWarzoneInstallStatus(true);
  if (installed) {
    appendWarzoneLog("Installation terminée.");
    alert("Installation Warzone terminée.");
  } else {
    appendWarzoneLog("Erreur : installation incomplète.");
    alert("Erreur : l'installation Warzone n'a pas pu être validée.");
  }
}

function setConnProfileSelection(kind) {
  connSelectedProfile = (kind === "download") ? "download" : "gaming";
  syncConnProfileSelectionUi();
}

function syncConnProfileSelectionUi() {
  var gaming = $("connProfileGaming");
  var download = $("connProfileDownload");
  if (!gaming || !download) return;
  var gamingSelected = connSelectedProfile === "gaming";
  gaming.className = "card conn-profile-card" + (gamingSelected ? " conn-profile-card--selected" : "");
  download.className = "card conn-profile-card" + (!gamingSelected ? " conn-profile-card--selected" : "");
}

function downloadFile(url, destination) {
  if (!url) throw new Error("URL invalide.");
  var xhr = new ActiveXObject("MSXML2.XMLHTTP");
  xhr.open("GET", url, false);
  xhr.send();
  if (xhr.status !== 200) throw new Error("HTTP " + xhr.status);
  try { downloadFile.lastContentType = String(xhr.getResponseHeader("Content-Type") || ""); } catch (eCT) { downloadFile.lastContentType = ""; }
  var stream = new ActiveXObject("ADODB.Stream");
  stream.Type = 1;
  stream.Open();
  stream.Write(xhr.responseBody);
  stream.SaveToFile(destination, 2);
  stream.Close();
}

function readTextFileAll(path) {
  try {
    var fso = getFso();
    if (!fso.FileExists(path)) return "";
    var t = fso.OpenTextFile(path, 1, false, 0);
    var s = t.ReadAll();
    t.Close();
    if (s.length && s.charCodeAt(0) === 0xFEFF) {
      s = s.substring(1);
    }
    if (s.length >= 3 && s.charCodeAt(0) === 0xEF && s.charCodeAt(1) === 0xBB && s.charCodeAt(2) === 0xBF) {
      s = s.substring(3);
    }
    return s;
  } catch (exR) {
    return "";
  }
}

function readUtf8TextFileAll(path) {
  try {
    var fso = getFso();
    if (!fso.FileExists(path)) return "";
    var stream = new ActiveXObject("ADODB.Stream");
    stream.Type = 2;
    stream.Charset = "utf-8";
    stream.Open();
    stream.LoadFromFile(path);
    var s = stream.ReadText(-1);
    stream.Close();
    if (s.length && s.charCodeAt(0) === 0xFEFF) s = s.substring(1);
    return s;
  } catch (exUtf8) {
    return readTextFileAll(path);
  }
}

function writeUtf8TextFileAll(path, text) {
  var stream = new ActiveXObject("ADODB.Stream");
  stream.Type = 2;
  stream.Charset = "utf-8";
  stream.Open();
  stream.WriteText(String(text || ""));
  stream.SaveToFile(path, 2);
  stream.Close();
}

function fixUtf8Mojibake(str) {
  if (!str || (str.indexOf("\u00C3") < 0 && str.indexOf("\u00E2") < 0)) return str;
  try {
    var encoded = "";
    var i;
    for (i = 0; i < str.length; i++) {
      encoded += "%" + ("0" + str.charCodeAt(i).toString(16)).slice(-2);
    }
    return decodeURIComponent(encoded);
  } catch (eFix) {
    return str;
  }
}

function launchFileAsAdmin(path) {
  var shellApp = new ActiveXObject("Shell.Application");
  var fso = getFso();
  var workDir = "";
  try {
    workDir = fso.GetParentFolderName(path);
  } catch (e0) {
    workDir = "";
  }
  shellApp.ShellExecute(path, "", workDir, "runas", 1);
}

/** Lance un exécutable avec arguments (UAC si nécessaire). */
function launchFileAsAdminWithArgs(path, args) {
  var shellApp = new ActiveXObject("Shell.Application");
  var fso = getFso();
  var workDir = "";
  try {
    workDir = fso.GetParentFolderName(path);
  } catch (e0) {
    workDir = "";
  }
  shellApp.ShellExecute(path, args || "", workDir, "runas", 1);
}

function parseUnrealCommandLineArgs() {
  var out = { autoDduClean: false, baseDir: "", dduPath: "", launcherMode: false, windowWidth: 0, windowHeight: 0 };
  try {
    if (typeof WScript === "undefined" || !WScript.Arguments) return out;
    var a = WScript.Arguments;
    var n = a.length || 0;
    var i;
    for (i = 0; i < n; i++) {
      var part = String(a.Item ? a.Item(i) : a(i));
      if (/--auto-ddu-clean/i.test(part) || /--auto-gpu-clean/i.test(part)) out.autoDduClean = true;
      if (/^--base-dir$/i.test(part) && i + 1 < n) {
        out.baseDir = getAbsolutePathFs(String(a.Item ? a.Item(i + 1) : a(i + 1)));
        i++;
      } else if (/^--base-dir=(.+)$/i.test(part)) {
        out.baseDir = getAbsolutePathFs(part.replace(/^--base-dir=/i, "").replace(/^\"|\"$/g, ""));
      }
      if (/^--ddu-path$/i.test(part) && i + 1 < n) {
        out.dduPath = getAbsolutePathFs(String(a.Item ? a.Item(i + 1) : a(i + 1)));
        i++;
      } else       if (/^--ddu-path=(.+)$/i.test(part)) {
        out.dduPath = getAbsolutePathFs(part.replace(/^--ddu-path=/i, "").replace(/^\"|\"$/g, ""));
      }
      if (/--launcher-mode/i.test(part)) out.launcherMode = true;
      if (/^--window-width$/i.test(part) && i + 1 < n) {
        out.windowWidth = parseInt(String(a.Item ? a.Item(i + 1) : a(i + 1)), 10) || 0;
        i++;
      } else if (/^--window-width=(\d+)$/i.test(part)) {
        out.windowWidth = parseInt(part.replace(/^--window-width=/i, ""), 10) || 0;
      }
      if (/^--window-height$/i.test(part) && i + 1 < n) {
        out.windowHeight = parseInt(String(a.Item ? a.Item(i + 1) : a(i + 1)), 10) || 0;
        i++;
      } else if (/^--window-height=(\d+)$/i.test(part)) {
        out.windowHeight = parseInt(part.replace(/^--window-height=/i, ""), 10) || 0;
      }
    }
  } catch (eA) {}
  if (out.launcherMode) window.__UNREAL_LAUNCHER_MODE = true;
  return out;
}

function pbApplyNormalWindowSize() {
  var sz = pbGetLauncherWindowSize();
  try {
    window.resizeTo(sz.w, sz.h);
    window.moveTo(sz.x, sz.y);
  } catch (eWin) {}
  return sz;
}

function pbGetLauncherWindowSize() {
  var w = 1280;
  var h = 820;
  try {
    var cmd = parseUnrealCommandLineArgs();
    if (cmd.windowWidth > 400) w = cmd.windowWidth;
    if (cmd.windowHeight > 300) h = cmd.windowHeight;
  } catch (eCmd) {}
  try {
    if (screen && screen.availWidth && w > screen.availWidth - 40) w = screen.availWidth - 40;
    if (screen && screen.availHeight && h > screen.availHeight - 40) h = screen.availHeight - 40;
  } catch (eScr) {}
  var x = 0;
  var y = 0;
  try {
    x = Math.max(0, Math.floor(((screen.availWidth || w) - w) / 2));
    y = Math.max(0, Math.floor(((screen.availHeight || h) - h) / 2));
  } catch (eXY) {}
  return { w: w, h: h, x: x, y: y };
}

function getPersistedApplicationBaseDirectoryPath() {
  return UNREAL_BASE + "\\app-base-directory.txt";
}

function readPersistedApplicationBaseDirectory() {
  try {
    var p = getPersistedApplicationBaseDirectoryPath();
    var txt = readTextFileAll(p);
    if (!txt) return "";
    return getAbsolutePathFs(String(txt).replace(/^\s+|\s+$/g, ""));
  } catch (eR) {
    return "";
  }
}

function persistApplicationBaseDirectory(base) {
  if (!base) return;
  try {
    createUnrealFolders();
    var tw = getFso().CreateTextFile(getPersistedApplicationBaseDirectoryPath(), true);
    tw.Write(String(base));
    tw.Close();
  } catch (eW) {}
}

function getWindowsCurrentDirectory() {
  try {
    return getAbsolutePathFs(String(getShell().CurrentDirectory || ""));
  } catch (eC) {
    return "";
  }
}

function directoryContainsUnrealHta(dir) {
  if (!dir) return false;
  try {
    return getFso().FileExists(getAbsolutePathFs(dir) + "\\Unreal.hta");
  } catch (eH) {
    return false;
  }
}

function initApplicationBaseDirectory() {
  if (APP_BASE_DIRECTORY) return APP_BASE_DIRECTORY;
  var fso = getFso();
  var cmd = parseUnrealCommandLineArgs();
  var candidates = [];
  var i;
  function trySet(p, reason) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || !fso.FolderExists(d)) return false;
    APP_BASE_DIRECTORY = d;
    persistApplicationBaseDirectory(d);
    return true;
  }
  if (cmd.baseDir) candidates.push({ path: cmd.baseDir, reason: "--base-dir" });
  var persisted = readPersistedApplicationBaseDirectory();
  if (persisted) candidates.push({ path: persisted, reason: "persisté ProgramData" });
  var htaDir = getUnrealHtaDirectory();
  if (htaDir) candidates.push({ path: htaDir, reason: "Unreal.hta" });
  try {
    var pathname = unescape(String(window.location.pathname || "").replace(/\//g, "\\"));
    if (pathname.length >= 3 && pathname.charAt(0) === "\\" && pathname.charAt(2) === ":") pathname = pathname.substring(1);
    if (pathname.length >= 2 && pathname.charAt(1) === ":") {
      candidates.push({ path: fso.GetParentFolderName(pathname), reason: "window.location" });
    }
  } catch (ePath) {}
  try {
    var envBase = getShell().ExpandEnvironmentStrings("%UNREAL_APP_BASE%");
    if (envBase && envBase.indexOf("%") < 0) candidates.push({ path: envBase, reason: "env UNREAL_APP_BASE" });
  } catch (eEnv) {}
  var cwd = getWindowsCurrentDirectory();
  if (cwd && directoryContainsUnrealHta(cwd)) candidates.push({ path: cwd, reason: "CurrentDirectory+Unreal.hta" });
  for (i = 0; i < candidates.length; i++) {
    if (trySet(candidates[i].path, candidates[i].reason)) return APP_BASE_DIRECTORY;
  }
  return "";
}

function getApplicationBaseRoots() {
  var fso = getFso();
  var list = [];
  var seen = {};
  function add(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d] || !fso.FolderExists(d)) return;
    seen[d] = true;
    list.push(d);
  }
  var cmd = parseUnrealCommandLineArgs();
  if (cmd.baseDir) add(cmd.baseDir);
  add(readPersistedApplicationBaseDirectory());
  add(getApplicationBaseDirectory());
  var hta = getUnrealHtaPath();
  if (hta) add(fso.GetParentFolderName(hta));
  var names = ["Unreal.exe", "UnrealLauncher.exe", "UNREAL.exe"];
  var basesToScan = list.slice();
  var bi, ni, lp;
  for (bi = 0; bi < basesToScan.length; bi++) {
    for (ni = 0; ni < names.length; ni++) {
      lp = basesToScan[bi] + "\\" + names[ni];
      if (fso.FileExists(lp)) add(fso.GetParentFolderName(lp));
    }
  }
  var cwd = getWindowsCurrentDirectory();
  if (cwd) add(cwd);
  var expanded = list.slice();
  for (bi = 0; bi < expanded.length; bi++) {
    try {
      var par = fso.GetParentFolderName(expanded[bi]);
      if (par) add(par);
    } catch (ePar) {}
  }
  return list;
}

function getApplicationBaseDirectory() {
  if (!APP_BASE_DIRECTORY) initApplicationBaseDirectory();
  return APP_BASE_DIRECTORY || "";
}

/** Dossier de l'application (stable, même après relance admin). */
function getAppFolderFromHta() {
  var base = getApplicationBaseDirectory();
  if (base) return base;
  try {
    var pathname = unescape(String(window.location.pathname || "").replace(/\//g, "\\"));
    if (pathname.length >= 3 && pathname.charAt(0) === "\\" && pathname.charAt(2) === ":") pathname = pathname.substring(1);
    if (pathname.length >= 2 && pathname.charAt(1) === ":") {
      return getFso().GetParentFolderName(pathname);
    }
  } catch (e1) {}
  return "";
}

/** Dossier outil : [Unreal.hta]\\tools\\NVCleanstall\\   repli %LOCALAPPDATA%\\Unreal\\Tools\\NVCleanstall */
function getNvcleanstallToolsDir() {
  var app = getAppFolderFromHta();
  if (app) return app + "\\tools\\NVCleanstall";
  var loc = getLocalUnrealDir();
  if (loc) return loc + "\\Tools\\NVCleanstall";
  return "";
}

function setNvcleanstallOpenStatus(text, kind) {
  var el = $("nvcleanstallOpenStatus");
  if (!el) return;
  if (!text) {
    el.style.display = "none";
    el.innerText = "";
    return;
  }
  el.style.display = "";
  el.innerText = text;
  var cls = "tcp-badge";
  if (kind === "ok") cls += " tcp-badge--ok";
  else if (kind === "progress") cls += " tcp-badge--progress";
  else cls += " tcp-badge--bad";
  el.className = cls;
}

function openNvcleanstallOfficialDownloadPage() {
  try {
    var sh = new ActiveXObject("Shell.Application");
    sh.ShellExecute(NVCLEANSTALL_OFFICIAL_DOWNLOAD_PAGE, "", "", "open", 1);
  } catch (e1) {
    try {
      getShell().Run("cmd /c start \"\" \"" + NVCLEANSTALL_OFFICIAL_DOWNLOAD_PAGE + "\"", 1, false);
    } catch (e2) {}
  }
}

/** Téléchargement binaire avec User-Agent (certains CDN refusent les clients sans en-tête). */
function nvcleanstallDownloadToFile(url, destination) {
  if (!url) throw new Error("URL invalide.");
  var xhr = new ActiveXObject("MSXML2.XMLHTTP");
  xhr.open("GET", url, false);
  try {
    xhr.setRequestHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36");
  } catch (eUa) {}
  try {
    xhr.setRequestHeader("Accept", "*/*");
  } catch (eAc) {}
  xhr.send();
  if (xhr.status !== 200) throw new Error("HTTP " + xhr.status);
  var stream = new ActiveXObject("ADODB.Stream");
  stream.Type = 1;
  stream.Open();
  stream.Write(xhr.responseBody);
  stream.SaveToFile(destination, 2);
  stream.Close();
}

/** Liste tous les .exe du dossier (non récursif). */
function listAllExeFilesFlat(folderDir) {
  var out = [];
  var fso = getFso();
  if (!folderDir || !fso.FolderExists(folderDir)) return out;
  try {
    var folder = fso.GetFolder(folderDir);
    var ef = new Enumerator(folder.Files);
    for (; !ef.atEnd(); ef.moveNext()) {
      var file = ef.item();
      var name = String(file.Name || "");
      if (/\.exe$/i.test(name)) out.push(file);
    }
  } catch (eList) {}
  return out;
}

function combinePath(base, rel) {
  var b = String(base || "").replace(/[\\\/]+$/, "");
  var r = String(rel || "").replace(/^[\\\/]+/, "");
  if (!b) return r;
  if (!r) return b;
  return b + "\\" + r;
}

function getAbsolutePathFs(path) {
  var p = String(path || "").replace(/^\s+|\s+$/g, "");
  if (!p) return "";
  if (/^empty$/i.test(p)) return "";
  try {
    var fso = getFso();
    if (p.length >= 2 && p.charAt(1) === ":") {
      return fso.GetAbsolutePathName(p);
    }
    var appBase = getApplicationBaseDirectory();
    if (appBase) {
      return fso.GetAbsolutePathName(combinePath(appBase, p));
    }
    var abs = fso.GetAbsolutePathName(p);
    if (!abs || /^empty$/i.test(abs)) return "";
    return abs;
  } catch (eAbs) {
    if (p.length >= 2 && p.charAt(1) === ":") return p;
    return "";
  }
}

/**
 * Score heuristique pour deviner quel .exe est NVCleanstall (noms variables / fautes).
 */
function scoreNvcleanstallExeName(fileName) {
  var raw = String(fileName || "").toLowerCase();
  var compact = raw.replace(/[\s\-_]/g, "").replace(/\.exe$/i, "");
  if (raw.indexOf("nvcleanstall") >= 0 || compact.indexOf("nvcleanstall") >= 0) return 100;
  var s = 0;
  if (compact.indexOf("cleanstall") >= 0) s = Math.max(s, 92);
  if (compact.indexOf("nvclean") >= 0) s = Math.max(s, 88);
  if (compact.indexOf("nvdcleaninstall") >= 0 || compact.indexOf("nvcleaninstall") >= 0) s = Math.max(s, 86);
  if (compact === "nvc" || /^nvc\.exe$/i.test(raw)) s = Math.max(s, 80);
  if (compact.indexOf("nvc") === 0 || /^nvc/i.test(compact)) s = Math.max(s, 72);
  if (compact.indexOf("nvidia") >= 0) s = Math.max(s, 65);
  return s;
}

/**
 * Détecte un fichier texte/HTML renommé en .exe (lecture binaire, pas d'interprétation UTF-8).
 * N'exige pas l'en-tête PE/MZ : si Windows peut lancer l'exe au double-clic, on ne bloque pas.
 */
function fileLooksLikeAsciiHtmlSavedAsExe(path) {
  try {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type = 1;
    st.Open();
    st.LoadFromFile(path);
    var max = 256;
    var sz = st.Size;
    if (typeof sz === "number" && sz >= 0 && sz < max) max = sz;
    var bin = st.Read(max);
    st.Close();
    var bytes = [];
    var i;
    for (i = 0; i < bin.length; i++) bytes.push(bin.charCodeAt(i) & 255);
    var start = 0;
    if (bytes.length >= 3 && bytes[0] === 239 && bytes[1] === 187 && bytes[2] === 191) start = 3;
    while (start < bytes.length && (bytes[start] === 9 || bytes[start] === 10 || bytes[start] === 13 || bytes[start] === 32)) start++;
    if (start >= bytes.length || bytes[start] !== 60) return false;
    var ascii = "";
    for (i = start; i < bytes.length && ascii.length < 64; i++) {
      var b = bytes[i];
      if (b >= 32 && b < 127) ascii += String.fromCharCode(b);
      else break;
    }
    var up = ascii.toUpperCase();
    if (up.indexOf("<!DOCTYPE") === 0) return true;
    if (up.indexOf("<!DOC") === 0) return true;
    if (up.indexOf("<HTML") === 0) return true;
    if (up.indexOf("<HEAD") === 0) return true;
    if (up.indexOf("<SCRIPT") === 0) return true;
    return false;
  } catch (eHtml) {
    return false;
  }
}

/**
 * Candidat pour ShellExecute runas : fichier présent, extension .exe, taille > 0,
 * pas un HTML évident   sans test PE/MZ strict.
 */
function isLaunchableExeFile(path) {
  try {
    var fso = getFso();
    if (!path || !fso.FileExists(path)) return false;
    if (!/\.exe$/i.test(String(path))) return false;
    var sf = fso.GetFile(path);
    if (!sf || sf.Size <= 0) return false;
    if (fileLooksLikeAsciiHtmlSavedAsExe(path)) return false;
    return true;
  } catch (eL) {
    return false;
  }
}

function tryMigrateLegacyNvcleanstallFolder(targetDir) {
  var app = getAppFolderFromHta();
  if (!app) return;
  var legacy = app + "\\tools\\NVCleanInstall";
  var fso = getFso();
  if (!fso.FolderExists(legacy)) return;
  var files = listAllExeFilesFlat(legacy);
  if (!files.length) return;
  var scored = [];
  var i;
  for (i = 0; i < files.length; i++) {
    scored.push({ file: files[i], score: scoreNvcleanstallExeName(String(files[i].Name || "")) });
  }
  scored.sort(function (a, b) {
    return b.score - a.score;
  });
  var src = getAbsolutePathFs(String(scored[0].file.Path || ""));
  if (!isLaunchableExeFile(src)) return;
  try {
    var dest = getAbsolutePathFs(targetDir + "\\NVCleanstall.exe");
    fso.CopyFile(src, dest, true);
    appendNvMediaLog("Migration : copie depuis l'ancien dossier tools\\NVCleanInstall vers " + dest);
  } catch (eM) {}
}

function getNvidiaDriverCacheDir() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  return app + "\\tools\\NvidiaDriverCache";
}

/** Journal technique uniquement (console fichier via log)   plus d'affichage horodaté dans l'UI. */
function appendNvMediaLog(message) {
  try {
    log("[NV média] " + String(message || ""));
  } catch (e0) {}
}

var driversWorkflowState = {
  dduPct: 0, dduDone: false, dduError: false,
  installPct: 0, installDone: false, installError: false,
  optPct: 0, optDone: false, optError: false
};

function updateDriversWorkflowGuide() {
  var el = $("driversWorkflowGuide");
  if (!el) return;
  var s = driversWorkflowState;
  if (s.optDone && s.optPct >= 100) {
    el.innerText = "Optimisation NVIDIA terminée";
    return;
  }
  if (s.installDone && s.installPct >= 100) {
    el.innerText = "0tape 3 : lancer l'optimisation NVIDIA (installation du pilote terminée)";
    return;
  }
  if (s.dduDone && s.dduPct >= 100) {
    el.innerText = "0tape 2 : installer le nouveau pilote graphique (nettoyage GPU terminé)";
    return;
  }
  el.innerText = "0tape 1 : nettoyer le pilote GPU";
}

function setDriversProgressBar(wrapId, fillId, textId, stepId, pct, stepLabel) {
  var wrap = $(wrapId);
  var fill = $(fillId);
  var text = $(textId);
  var step = $(stepId);
  if (!wrap) return;
  if (pct === -1 || pct === null || typeof pct === "undefined") {
    wrap.style.display = "none";
    return;
  }
  var p = parseInt(pct, 10);
  if (isNaN(p)) p = 0;
  if (p < 0) p = 0;
  if (p > 100) p = 100;
  wrap.style.display = "block";
  try { void wrap.offsetWidth; } catch (eRf) {}
  if (fill) fill.style.width = p + "%";
  if (text) text.innerText = p + " %";
  if (step) step.innerText = stepLabel ? ("0tape en cours : " + stepLabel) : "";
}

/**
 * Statut installation pilote automatique + barre optionnelle (progressPct 0-100, ou -1 pour masquer).
 */
function setNvMediaAutoStatus(text, kind, progressPct) {
  var el = $("nvMediaAutoStatus");
  if (progressPct === -1 || progressPct === null || typeof progressPct === "undefined") {
    if (el) {
      el.style.display = "none";
      el.innerText = "";
    }
    setDriversProgressBar("nvMediaProgressWrap", "nvMediaProgressFill", "nvMediaProgressText", "nvMediaProgressStep", -1, "");
    return;
  }
  if (el) {
    el.style.display = progressPct >= 100 && kind === "ok" ? "" : "none";
    if (el.style.display !== "none") {
      el.innerText = text || "";
      var cls = "tcp-badge";
      if (kind === "ok") cls += " tcp-badge--ok";
      else if (kind === "progress") cls += " tcp-badge--progress";
      else cls += " tcp-badge--bad";
      el.className = cls;
    }
  }
  setDriversProgressBar("nvMediaProgressWrap", "nvMediaProgressFill", "nvMediaProgressText", "nvMediaProgressStep", progressPct, text || "");
  var p = parseInt(progressPct, 10);
  if (!isNaN(p)) {
    driversWorkflowState.installPct = p;
    if (p >= 100 && kind === "ok") {
      driversWorkflowState.installDone = true;
      driversWorkflowState.installError = false;
    }
    if (kind === "bad" || kind === "error") driversWorkflowState.installError = true;
    updateDriversWorkflowGuide();
  }
}

function nvcleanProgressFromLiveStatus(live) {
  if (!live) return null;
  if (/\[NVCleanInstall\].*AutoHotkey v2 script|script genere/i.test(live)) {
    return { pct: 25, msg: "Script NVCleanstall AutoHotkey v2 prêt" };
  }
  if (/\[NVCleanstall\].*Automatisation démarrée|\[NVCleanstall\].*Automatisation demarree/i.test(live)) {
    return { pct: 50, msg: "Automatisation NVCleanstall en cours..." };
  }
  if (/\[NVCleanstall\].*Page Driver Version|\[NVCleanstall\].*Next cliqué|\[NVCleanstall\].*Page intermédiaire/i.test(live)) {
    return { pct: 60, msg: "Assistant NVCleanstall  avancement automatique..." };
  }
  if (/Detection page prete NVCleanstall|Détection page prête NVCleanstall|\[NVCleanstall\].*Recherche|Recherche texte Finished/i.test(live)) {
    return { pct: 75, msg: "Détection page prête NVCleanstall..." };
  }
  if (/\[NVCleanstall\].*Page finale|\[NVCleanstall\].*Page prete detectee|Page prete detectee, lancement|\[NVCleanstall\].*Texte detecte|Your customized installer is now ready/i.test(live)) {
    return { pct: 75, msg: "Page prête détectée, lancement de l'installation NVIDIA..." };
  }
  if (/\[NVCleanstall\].*Flèche bas|Flèche bas \+ Entrée|\[NVCleanstall\].*Action clavier|fleche bas puis entree|flèche bas puis entrée/i.test(live)) {
    return { pct: 80, msg: "Lancement du programme d'installation NVIDIA..." };
  }
  if (/\[NVCleanInstall\].*NVIDIA Installer|Attente Programme d'installation|\[NVCleanstall\].*Attente installateur/i.test(live)) {
    return { pct: 80, msg: "Lancement du programme d'installation NVIDIA..." };
  }
  if (/Page Finished detectee|attente stabilisation/i.test(live)) {
    return { pct: 75, msg: "Détection page prête NVCleanstall..." };
  }
  if (/verifiez le focus|vérifiez le focus/i.test(live)) {
    return { pct: 75, msg: live };
  }
  if (/Lancement du programme d'installation NVIDIA|Lancement du programme d installation NVIDIA/i.test(live)) {
    return { pct: 80, msg: "Lancement du programme d'installation NVIDIA..." };
  }
  if (/Install lancé|programme d'installation NVIDIA|Ouverture du programme/i.test(live)) {
    return { pct: 80, msg: "Lancement du programme d'installation NVIDIA..." };
  }
  if (/Contrat NVIDIA accepté|Contrat NVIDIA accepte/i.test(live)) {
    return { pct: 85, msg: "Contrat NVIDIA accepté." };
  }
  if (/\[NVIDIA Installer\].*Options d'installation|\[NVIDIA Installer\].*Personnalisée|\[NVIDIA Installer\].*Personnalisee/i.test(live)) {
    return { pct: 90, msg: "Installation personnalisée sélectionnée." };
  }
  if (/\[NVIDIA-INSTALLER\].*Options page detected|\[NVIDIA-INSTALLER\].*Personnalisée|\[NVIDIA-INSTALLER\].*Personnalisee/i.test(live)) {
    return { pct: 90, msg: "Installation personnalisée sélectionnée." };
  }
  if (/\[NVIDIA-INSTALLER\].*Installation final state|\[NVIDIA-INSTALLER\].*Progress forced to 100|Installation NVIDIA terminée  validation finale/i.test(live)) {
    return { pct: 100, msg: "Installation NVIDIA terminée  validation finale manuelle si demandée." };
  }
  if (/Installation personnalisée sélectionnée|Installation personnalisee selectionnee/i.test(live)) {
    return { pct: 90, msg: "Installation personnalisée sélectionnée." };
  }
  if (/Installation NVIDIA lancée|Installation du pilote NVIDIA en cours/i.test(live)) {
    return { pct: 95, msg: "Installation du pilote NVIDIA en cours..." };
  }
  if (/^NVIDIA\s*:\s*attente du programme/i.test(live)) {
    return { pct: 82, msg: live };
  }
  if (/^NVIDIA\s*:\s*licence/i.test(live)) {
    return { pct: 85, msg: live };
  }
  if (/^NVIDIA\s*:\s*options d'installation|^NVIDIA\s*:\s*sélection Personnalisée|^NVIDIA\s*:\s*validation Options/i.test(live)) {
    return { pct: 90, msg: live };
  }
  if (/^NVIDIA\s*:\s*options personnalisées/i.test(live)) {
    return { pct: 92, msg: live };
  }
  if (/^NVIDIA\s*:\s*installation/i.test(live)) {
    return { pct: 95, msg: live };
  }
  if (/^NVIDIA\s*:\s*installation terminée|^NVIDIA\s*:\s*fermeture de l'installeur/i.test(live)) {
    return { pct: 100, msg: live };
  }
  if (/Installation NVIDIA non confirmée|Verifiez l'installation|Verifier l'installation/i.test(live)) {
    return { pct: 90, msg: live };
  }
  return null;
}

function inferNvcleanInstallProgressPct(live, attempts, watchPhase) {
  var mapped = nvcleanProgressFromLiveStatus(live);
  if (mapped) return mapped.pct;
  if (watchPhase === "verify") return 95;
  if (watchPhase === "finalize") return 85;
  if (/Installation terminée|Fenêtre fermée/i.test(live)) return 95;
  if (/bloquée|bloquee/i.test(live) && attempts > 4 && !/confirmation requise/i.test(live)) return -2;
  if (/Attente de la fenêtre finale|Fenêtre finale/i.test(live)) return 85;
  if (/Detection page prete NVCleanstall|Détection page prête NVCleanstall|\[NVCleanstall\].*Texte detecte/i.test(live)) return 75;
  if (/\[NVCleanInstall\].*Attente page Finished|Attente de la page Finished|Attente page Finished/i.test(live)) return 70;
  if (/confirmation requise|page d'installation|page d.installation/i.test(live)) return 75;
  if (/Reglages NVIDIA|Preparation NVIDIA|Preparation des fichiers|finalisation/i.test(live)) return 85;
  if (/Installation lancée|Application des reglages|Install|Pages 1-2/i.test(live)) return 65;
  if (/Ouverture|NVCleanstall|préparation|Preparation/i.test(live)) return 45;
  if (attempts <= 2) return 10;
  if (attempts <= 4) return 25;
  return Math.min(90, 45 + Math.floor(attempts / 3));
}

function shouldStartNvcleanDriverWatch(live) {
  if (!live) return false;
  if (/Installation NVIDIA lancée|Installation du pilote NVIDIA en cours|AWAIT_DRIVER|Contrat NVIDIA accepté|Installation personnalisée sélectionnée/i.test(live)) {
    return true;
  }
  if (/Lancement du programme d'installation NVIDIA|Lancement du programme d installation NVIDIA/i.test(live)) {
    return true;
  }
  if (/Installateur personnalisé prêt|Install lancé|programme d'installation NVIDIA/i.test(live)) {
    return true;
  }
  return false;
}

function isNvcleanManualConfirmationLive(live) {
  if (!live) return false;
  return /confirmation requise|page d'installation|page d.installation|confirmation manuelle/i.test(live);
}

function stopNvcleanDriverWatchPoll() {
  nvcleanDriverWatchPollGen++;
}

function showNvcleanVerifyInstallButton(show) {
  var btn = $("btnVerifyNvidiaInstall");
  if (btn) btn.style.display = show ? "" : "none";
}

function refreshDriverStatusAfterNvcleanInstall(det) {
  det = det || detectInstalledNvidiaDriver({ forceFull: true });
  var hw = detectGpuForDriverInstall({ skipLog: true });
  syncNvidiaInfoCacheFromGpu(buildGpuDriverInfoFromDetect(det, hw));
  sessionCache.nvidiaDriverCleaned = false;
  if (det.installed && det.version) {
    sessionCache.gpuDriverUpdate = null;
    nvCheckGeneration++;
    window.setTimeout(function () {
      try { scheduleGpuDriverFullCheck(); } catch (eSch) {}
    }, 500);
  } else if (det.installed) {
    sessionCache.gpuDriverUpdate = {
      status: "installed_unknown",
      latestVersion: "",
      error: "",
      source: det.source || "",
      checkedAt: new Date().getTime()
    };
    applySimplifiedNvMediaCardUi();
  }
}

function readNvidiaOrchFinishedFromLog() {
  var tail = readNvcleanAutoLogTail(50);
  if (/NVIDIA_ORCH_RESULT=finished/i.test(tail)) return true;
  if (/NVIDIA-ORCH-SIMPLE\] Done/i.test(tail)) return true;
  if (/ACTION=nvidia_installer_loop_finished/i.test(tail)) return true;
  return false;
}

function shouldCompleteInstallUiOnNvcClose() {
  if (readNvidiaOrchFinishedFromLog()) return true;
  if (nvidiaInstallerLoopStarted) return true;
  var live = readNvcleanAutoLiveStatus();
  var tail = readNvcleanAutoLogTail(50);
  if (/SCRIPT_LAUNCHED=oui|Installation NVIDIA|NVIDIA_INSTALLER|NVIDIA-ORCH|NVCleanInstall lancé|PS1.*06|\[NVIDIA Driver\]/i.test(tail)) return true;
  if (/Installation terminée|Finish|Finished|Fenêtre fermée|page Finished/i.test(live || "")) return true;
  return false;
}

function logNvcWaitFinishIfNeeded() {
  if (nvcWaitFinishLogged || nvcleanInstallUiCompleted) return;
  if (nvidiaInstallerLoopStarted || readNvidiaOrchFinishedFromLog()) {
    nvcWaitFinishLogged = true;
    writeNvcleanAutoLog("[NVIDIA Driver] Attente fin NVCleanInstall / Finish");
    logNvidiaDriverRefresh("Attente fin NVCleanInstall / Finish");
  }
}

function completeNvcleanInstallProgressUi(reason) {
  if (nvcleanInstallUiCompleted) return;
  nvcleanInstallUiCompleted = true;
  stopNvidiaInstallerWizardLoop();
  stopNvcleanDriverWatchPoll();
  nvcleanAutoPollGen++;
  showNvcleanVerifyInstallButton(false);
  writeNvcleanAutoLog("[NVIDIA Driver] Progression installation pilote 100 %");
  logNvidiaDriverRefresh("Progression installation pilote 100 %");
  writeNvcleanAutoLog("[NVIDIA Driver] Installation du pilote terminée");
  logNvidiaDriverRefresh("Installation du pilote terminée");
  if (reason) writeNvcleanAutoLog("INSTALL_UI_COMPLETE=" + reason);
  setNvcleanAutoStatus("Installation du pilote terminée", "success", 100);
  driversWorkflowState.installDone = true;
  driversWorkflowState.installError = false;
  setNvcleanAutoButtonBusy(false);
  setNvcleanContinueButtonBusy(false);
  nvcleanAutoBusy = false;
  nvcleanTweaksBusy = false;
  sessionCache.gpuDriverInfo = null;
  sessionCache.nvidiaInfo = null;
  var det = detectInstalledNvidiaDriver({ forceFull: true });
  if (det.installed) {
    refreshDriverStatusAfterNvcleanInstall(det);
  } else {
    sessionCache.gpuDriverUpdate = {
      status: "installed_unknown",
      latestVersion: "",
      error: "",
      source: det.source || "",
      checkedAt: new Date().getTime()
    };
    applySimplifiedNvMediaCardUi();
    applyNvidiaDriverUpdatePanel("ok", "Pilote Nvidia installé", "", false);
  }
  try { updateDriversWorkflowGuide(); } catch (eWf) {}
}

function tryCompleteNvcleanInstallOnProcessExit() {
  if (nvcleanInstallUiCompleted) return true;
  if (isNvcleanstallProcessRunning()) {
    nvcInstallProcessSeen = true;
    return false;
  }
  if (!shouldCompleteInstallUiOnNvcClose()) return false;
  if (!nvcInstallProcessSeen && !readNvidiaOrchFinishedFromLog() && !nvidiaInstallerLoopStarted) return false;
  writeNvcleanAutoLog("[NVIDIA Driver] NVCleanInstall terminé ou fermé");
  completeNvcleanInstallProgressUi("nvc_process_closed");
  return true;
}

function finishNvcleanInstallSuccess(detPre) {
  var det = detPre || detectInstalledNvidiaDriver({ forceFull: true });
  if (det.installed) {
    completeNvcleanInstallProgressUi("driver_detected");
    return;
  }
  if (nvcInstallProcessSeen && !isNvcleanstallProcessRunning() && shouldCompleteInstallUiOnNvcClose()) {
    completeNvcleanInstallProgressUi("nvc_closed_no_driver_yet");
    return;
  }
  stopNvcleanDriverWatchPoll();
  showNvcleanVerifyInstallButton(true);
  sessionCache.gpuDriverInfo = null;
  sessionCache.nvidiaInfo = null;
  sessionCache.gpuDriverUpdate = null;
  setNvcleanAutoStatus(
    "Installation terminée mais aucun pilote Nvidia détecté  vérification requise.",
    "error",
    85
  );
  driversWorkflowState.installError = true;
  setNvcleanAutoButtonBusy(false);
  setNvcleanContinueButtonBusy(false);
  nvcleanAutoBusy = false;
  nvcleanTweaksBusy = false;
  try { updateDriversWorkflowGuide(); } catch (eWf) {}
}

function verifyNvidiaInstallAfterManualConfirmation() {
  writeNvcleanAutoLog("ACTION=manual_verify_install");
  var det = detectInstalledNvidiaDriver({ forceFull: true });
  writeNvcleanAutoLog("MANUAL_VERIFY installed=" + (det.installed ? "oui" : "non") + " ver=" + (det.version || ""));
  if (det.installed) {
    nvcleanAutoPollGen++;
    finishNvcleanInstallSuccess(det);
  } else {
    setNvcleanAutoStatus("Aucun pilote Nvidia détecté  installation non confirmée.", "error", 85);
    showNvcleanVerifyInstallButton(true);
  }
}

function waitForNvidiaDriverInstalledAfterManualConfirmation() {
  stopNvcleanDriverWatchPoll();
  nvcleanAutoPollGen++;
  var gen = ++nvcleanDriverWatchPollGen;
  var attempts = 0;
  var maxAttempts = 16;
  var pollMs = 500;
  var driverWatchTimedOut = false;
  showNvcleanVerifyInstallButton(true);
  setNvcleanAutoButtonBusy(false);
  writeNvcleanAutoLog("ACTION=driver_watch_after_install");

  function tick() {
    if (gen !== nvcleanDriverWatchPollGen) return;
    logNvcWaitFinishIfNeeded();
    if (tryCompleteNvcleanInstallOnProcessExit()) return;
    attempts++;
    var live = readNvcleanAutoLiveStatus();
    if (isNvidiaInstallerWizardLoopRunning || /\[NVIDIA Installer\]|Installation NVIDIA en cours|nvidia-wizard|NVIDIA_WIZARD|NVIDIA_INSTALLER_WINDOW_READY/i.test(live || "")) {
      setNvcleanAutoStatus("Installation NVIDIA en cours...", "info", 95);
      if (!nvidiaInstallerLoopStarted && shouldStartNvidiaInstallerWizardLoop(live)) {
        RunNvidiaInstallerWizardLoopAsync();
      }
      window.setTimeout(tick, pollMs);
      return;
    }
    if (isNvidiaInstallerWizardLoopRunning) {
      setNvcleanAutoStatus("Installation NVIDIA en cours...", "info", 95);
      window.setTimeout(tick, pollMs);
      return;
    }
    var det = detectInstalledNvidiaDriver({ forceFull: true });
    writeNvcleanAutoLog(
      "DRIVER_WATCH n=" + attempts + " installed=" + (det.installed ? "oui" : "non") +
      " ver=" + (det.version || "")
    );

    if (det.installed) {
      finishNvcleanInstallSuccess(det);
      return;
    }

    var mapped = nvcleanProgressFromLiveStatus(live);
    var pct = 95;
    var msg = "Installation du pilote NVIDIA en cours...";
    if (mapped) {
      pct = mapped.pct;
      msg = mapped.msg;
      if (mapped.pct < 95 && /Installation du pilote NVIDIA en cours/i.test(mapped.msg)) {
        pct = 95;
      }
    } else if (isNvcleanManualConfirmationLive(live)) {
      pct = 75;
      msg = "Confirmation requise dans l'installateur Nvidia  en attente de finalisation...";
    }
    setNvcleanAutoStatus(msg, "info", pct);

    if (attempts >= maxAttempts) {
      if (!driverWatchTimedOut) {
        driverWatchTimedOut = true;
        setNvcleanAutoStatus("Vérification pilote impossible pour le moment", "warn", pct);
        writeNvcleanAutoLog("DRIVER_WATCH=timeout_8s_continue");
      }
      showNvcleanVerifyInstallButton(true);
      setNvcleanAutoButtonBusy(false);
      nvcleanAutoBusy = false;
      return;
    }
    window.setTimeout(tick, pollMs);
  }

  var live0 = readNvcleanAutoLiveStatus();
  var mapped0 = nvcleanProgressFromLiveStatus(live0);
  if (mapped0) {
    setNvcleanAutoStatus(mapped0.msg, "info", mapped0.pct);
  } else {
    setNvcleanAutoStatus("Installation du pilote NVIDIA en cours...", "info", 95);
  }
  window.setTimeout(tick, pollMs);
}

function inferDduCleanProgressPct(live, cleanStarted, attempts, driverVerified) {
  if (driverVerified) return 100;
  if (/Nettoyage GPU terminé|redémarrage conseillé|\[DDU\] Bouton Nettoyer/i.test(live || "")) return 95;
  if (/Nettoyage GPU en cours|CLEAN_NO_RESTART_CLICKED/i.test(live || "")) return 70;
  if (/Vérification finale|Nettoyage DDU terminé|DDU fermé/i.test(live || "")) return 90;
  if (cleanStarted && (attempts > 8 || /suppression|registre|packages|fichiers|Fenêtre finale|Attente de la fenêtre/i.test(live || ""))) {
    return 75;
  }
  if (/Nettoyage DDU en cours|Nettoyage lancé|Désinstallation|Nettoyage en cours|surveillance du nettoyage|DDU lancé|DDU lance|Automatisation impossible|DDU est ouvert|choisis GPU|Nettoyer/i.test(live || "")) {
    return 50;
  }
  if (/Interface DDU|Attente de l'interface|préparation|Préparation|Lancement DDU|NoSafeMode|Vérification DDU/i.test(live || "")) {
    return 30;
  }
  if (attempts <= 1) return 0;
  if (attempts <= 2) return 15;
  if (cleanStarted || attempts > 3) return 50;
  return 30;
}

function mapDduLiveStatusToUiMessage(live) {
  if (!live) return "";
  if (/Automatisation impossible/i.test(live)) {
    return "DDU lancé  surveillance du nettoyage en cours...";
  }
  return live;
}

function isDduBenignLiveStatus(live) {
  if (!live) return false;
  if (/Nettoyage GPU terminé|Nettoyage GPU en cours|\[DDU\]|Fenêtre détectée|Pop-up DDU|OK cliqué|Bouton Nettoyer/i.test(live)) return true;
  if (/Nettoyage DDU terminé|DDU fermé|redémarrage conseillé|reboot|restart required|restart recommended/i.test(live)) return true;
  if (/Nettoyage lancé|Nettoyage DDU en cours|Nettoyage en cours|Désinstallation du pilote/i.test(live)) return true;
  if (/Automatisation impossible|surveillance du nettoyage|DDU lancé|DDU lance/i.test(live)) return true;
  if (/DDU est ouvert/i.test(live) && /choisis GPU|Nettoyer|Nettoyer sans redémarrer/i.test(live)) return true;
  if (/Interface DDU détectée|Attente de l'interface DDU|\[DDU\] Ouverture/i.test(live)) return true;
  return false;
}

function isDduBlockingErrorStatus(live) {
  if (!live) return false;
  if (/Erreur ouverture DDU|ddu_launch_fail/i.test(live)) return true;
  if (/SCRIPT_LAUNCHED=non/i.test(live) && !/DDU lancé|DDU lance|surveillance/i.test(live || "")) return true;
  return false;
}

function fileStartsLikeHtml(path) {
  try {
    var st = new ActiveXObject("ADODB.Stream");
    st.Type = 2;
    st.Charset = "utf-8";
    st.Open();
    st.LoadFromFile(path);
    var t = st.ReadText(128);
    st.Close();
    var s = String(t || "").toLowerCase();
    return s.indexOf("<!doctype html") >= 0 || s.indexOf("<html") >= 0;
  } catch (eH) {
    return false;
  }
}

/** EXE Windows : taille minimale, en-tête MZ, pas une page HTML renommée. */
function isPeExeFile(path) {
  try {
    var fso = getFso();
    if (!fso.FileExists(path)) return false;
    var sf = fso.GetFile(path);
    if (!sf || sf.Size < 512000) return false;
    if (fileStartsLikeHtml(path)) return false;
    var st = new ActiveXObject("ADODB.Stream");
    st.Type = 1;
    st.Open();
    st.LoadFromFile(path);
    var bin = st.Read(2);
    st.Close();
    if (!bin || bin.length < 2) return false;
    return bin.charCodeAt(0) === 0x4d && bin.charCodeAt(1) === 0x5a;
  } catch (eP) {
    return false;
  }
}

function extractFirstHttpsExeFromText(txt) {
  var m = String(txt || "").match(/https?:\/\/[^\s"'<>]+\.exe(?:\?[^\s"'<>]*)?/i);
  return m && m[0] ? m[0] : "";
}

function extractNvidiaDownloadUrlFromAjaxText(txt) {
  var t = String(txt || "");
  var m = t.match(/"DownloadURL"\s*:\s*"([^"]+)"/i);
  if (m && m[1]) {
    var u = m[1].replace(/\\\//g, "/");
    if (/\.exe(\?|$)/i.test(u)) return u;
  }
  return extractFirstHttpsExeFromText(t);
}

function extractNvidiaDriverVersionFromAjaxText(txt) {
  var t = String(txt || "");
  var m = t.match(/"Version"\s*:\s*"([0-9]+\.[0-9]+)"/i);
  if (m && m[1]) return m[1];
  m = t.match(/"DisplayVersion"\s*:\s*"([0-9]+\.[0-9]+)"/i);
  if (m && m[1]) return m[1];
  return "";
}

function extractVersionFromNvidiaDriverDownloadUrl(url) {
  var u = String(url || "");
  var m = u.match(/\/([0-9]{2,3}\.[0-9]{2})\//);
  if (m && m[1]) return m[1];
  m = u.match(/([0-9]{2,3}\.[0-9]{2})-desktop/i);
  if (m && m[1]) return m[1];
  return "";
}

/** Dernier pilote DCH (URL + version) depuis le service GeForce, ou null. */
function fetchLatestNvidiaDriverFromApi() {
  var iOs, iPf;
  for (iOs = 0; iOs < NVIDIA_DRIVER_LOOKUP_OSIDS.length; iOs++) {
    for (iPf = 0; iPf < NVIDIA_DRIVER_LOOKUP_PFIDS.length; iPf++) {
      try {
        var api = "https://gfwsl.geforce.com/services_toolkit/services/com/nvidia/services/AjaxDriverService.php?beta=null&dch=1&dltype=-1&func=DriverManualLookup&isWHQL=1&languageCode=1033&numberOfResults=1&osID=" + NVIDIA_DRIVER_LOOKUP_OSIDS[iOs] + "&pfid=" + NVIDIA_DRIVER_LOOKUP_PFIDS[iPf];
        var xhr = new ActiveXObject("MSXML2.XMLHTTP");
        xhr.open("GET", api, false);
        xhr.send();
        if (xhr.status !== 200) continue;
        var body = xhr.responseText || "";
        var url = extractNvidiaDownloadUrlFromAjaxText(body);
        if (!url) continue;
        var version = extractNvidiaDriverVersionFromAjaxText(body);
        if (!version) version = extractVersionFromNvidiaDriverDownloadUrl(url);
        return { url: url, version: version };
      } catch (eApi) {}
    }
  }
  return null;
}

function downloadBinaryWithBrowserUa(url, destination) {
  if (!url) throw new Error("URL de téléchargement vide.");
  var xhr = new ActiveXObject("MSXML2.XMLHTTP");
  xhr.open("GET", url, false);
  try {
    xhr.setRequestHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36");
  } catch (eUa) {}
  try {
    xhr.setRequestHeader("Accept", "*/*");
  } catch (eAc) {}
  xhr.send();
  if (xhr.status !== 200) throw new Error("HTTP " + xhr.status + "   le serveur a refusé ou redirigé le téléchargement.");
  var stream = new ActiveXObject("ADODB.Stream");
  stream.Type = 1;
  stream.Open();
  stream.Write(xhr.responseBody);
  stream.SaveToFile(destination, 2);
  stream.Close();
}

/** Chemin absolu attendu : tools\\NVCleanstall\\NVCleanstall.exe (outil valide uniquement). */
function getPreferredNvcleanstallExePath() {
  var loc = locateNvcleanstallExecutable(false);
  return loc && loc.path ? loc.path : "";
}

function getUnrealNvidiaPresetPath() {
  var app = getAppFolderFromHta();
  if (app) {
    var p1 = getAbsolutePathFs(app + "\\config\\UnrealNvidiaPreset.json");
    if (getFso().FileExists(p1)) return p1;
    var p2 = getAbsolutePathFs(app + "\\UnrealNvidiaPreset.json");
    if (getFso().FileExists(p2)) return p2;
    return p1;
  }
  var loc = getLocalUnrealDir();
  if (loc) return getAbsolutePathFs(loc + "\\config\\UnrealNvidiaPreset.json");
  return "";
}

function ensureDefaultUnrealNvidiaPresetFile() {
  var p = getUnrealNvidiaPresetPath();
  if (!p) return null;
  var fso = getFso();
  if (fso.FileExists(p)) return p;
  try {
    var dir = fso.GetParentFolderName(p);
    if (dir && !fso.FolderExists(dir)) createFolder(dir);
    var bundled = getAppFolderFromHta();
    if (bundled) {
      var src = getAbsolutePathFs(bundled + "\\config\\UnrealNvidiaPreset.json");
      if (fso.FileExists(src)) {
        fso.CopyFile(src, p, true);
        return p;
      }
    }
  } catch (eMk) {}
  return p;
}

function loadUnrealNvidiaPreset() {
  if (sessionCache.nvcPresetLoaded) return sessionCache.nvcPresetLoaded;
  try {
    var p = ensureDefaultUnrealNvidiaPresetFile();
    if (!p || !getFso().FileExists(p)) return null;
    var preset = JSON.parse(readTextFileAll(p));
    sessionCache.nvcPresetLoaded = preset;
    return preset;
  } catch (eL) {
    return null;
  }
}

function appendNvPresetLog(message) {
  var msg = "[NV preset] " + String(message || "");
  appendDriversDiagLog(msg);
  if (!shouldShowUiLogs()) return;
  var box = $("nvPresetLogBox");
  if (!box) {
    try { log(msg); } catch (e0) {}
    return;
  }
  var line = document.createElement("div");
  line.className = "logline";
  line.textContent = "[" + nowTime() + "] " + message;
  box.insertBefore(line, box.firstChild);
  while (box.childNodes.length > 120) box.removeChild(box.lastChild);
  try { log(msg); } catch (e1) {}
}

function logNvPreset(message) {
  appendNvPresetLog(String(message || ""));
}

function listExeCandidatesInFolder(folderDir, maxDepth, depth) {
  var out = [];
  var fso = getFso();
  if (!folderDir || !fso.FolderExists(folderDir)) return out;
  depth = depth || 0;
  if (depth > (maxDepth || 2)) return out;
  try {
    var folder = fso.GetFolder(folderDir);
    var ef = new Enumerator(folder.Files);
    for (; !ef.atEnd(); ef.moveNext()) {
      var file = ef.item();
      var name = String(file.Name || "");
      if (/\.exe$/i.test(name)) out.push(getAbsolutePathFs(String(file.Path || "")));
    }
    if (depth < (maxDepth || 2)) {
      var sd = new Enumerator(folder.SubFolders);
      for (; !sd.atEnd(); sd.moveNext()) {
        var sub = sd.item();
        var subPath = String(sub.Path || "");
        if (/\\Windows|\\Program Files|\\Program Files \(x86\)/i.test(subPath)) continue;
        out = out.concat(listExeCandidatesInFolder(subPath, maxDepth, depth + 1));
      }
    }
  } catch (eList) {}
  return out;
}

function locateNvcleanstallExecutable(forceRescan) {
  try {
    if (!forceRescan && sessionCache.nvcExeLocate && sessionCache.nvcExeLocate.path) {
      return sessionCache.nvcExeLocate;
    }
    var fso = getFso();
    var sh = getShell();
    var hits = [];
    function addHit(path, source) {
      try {
        var p = getAbsolutePathFs(String(path || ""));
        if (!p || !isLaunchableExeFile(p)) return;
        var score = scoreNvcleanstallExeName(fso.GetFileName(p));
        if (score < 70) return;
        hits.push({ path: p, source: source, score: score });
      } catch (eHit) {}
    }
    var toolsDir = getNvcleanstallToolsDir();
    if (toolsDir) addHit(toolsDir + "\\NVCleanstall.exe", "tools");
    var app = getAppFolderFromHta();
    if (app) {
      addHit(app + "\\tools\\NVCleanstall\\NVCleanstall.exe", "app-tools");
      var appExes = listExeCandidatesInFolder(app, 3, 0);
      var i;
      for (i = 0; i < appExes.length; i++) addHit(appExes[i], "app-scan");
    }
    try {
      var down = sh.ExpandEnvironmentStrings("%USERPROFILE%\\Downloads");
      var desk = sh.ExpandEnvironmentStrings("%USERPROFILE%\\Desktop");
      var j;
      if (down) {
        var downExes = listExeCandidatesInFolder(down, 1, 0);
        for (j = 0; j < downExes.length; j++) addHit(downExes[j], "downloads");
      }
      if (desk) {
        var deskExes = listExeCandidatesInFolder(desk, 1, 0);
        for (j = 0; j < deskExes.length; j++) addHit(deskExes[j], "desktop");
      }
    } catch (eEnv) {}
    hits.sort(function (a, b) {
      if (b.score !== a.score) return b.score - a.score;
      return String(a.source).length - String(b.source).length;
    });
    var best = hits.length ? hits[0] : null;
    sessionCache.nvcExeLocate = best;
    return best;
  } catch (eLoc) {
    try {
      writeNvcleanAutoLog("[SCRIPT] locateNvcleanstall: " + String(eLoc.message || eLoc));
    } catch (eLog) {}
    return null;
  }
}

function getNvcleanstallFileVersion(exePath) {
  try {
    var sh = getShell();
    var folder = getFso().GetParentFolderName(exePath);
    var name = getFso().GetFileName(exePath);
    var cmd = "cmd /c for %V in (\"" + String(exePath).replace(/"/g, "") + "\") do @echo %~zV|%V";
    var out = runCommandCapture("powershell.exe -NoProfile -Command \"(Get-Item -LiteralPath '" + String(exePath).replace(/'/g, "''") + "').VersionInfo.FileVersion\"");
    var v = String(out || "").replace(/^\s+|\s+$/g, "");
    if (v) return v;
    var m = String(name || "").match(/NVCleanstall[_\s-]?([0-9]+(?:\.[0-9]+)+)/i);
    if (m && m[1]) return m[1];
  } catch (eV) {}
  return "";
}

function probeNvcleanstallCapabilities(exePath) {
  var result = {
  probedAt: new Date().getTime(),
    exePath: exePath || "",
    cliSupported: false,
    cliHelpSnippet: "",
    configFiles: [],
    configWritablePath: "",
    deployDir: "",
    method: "guided"
  };
  if (!exePath || !isLaunchableExeFile(exePath)) return result;
  var fso = getFso();
  var exeDir = fso.GetParentFolderName(exePath);
  var sh = getShell();
  var cfgNames = ["NVCleanstall.ini", "settings.ini", "Settings.xml", "config.json", "NVCleanstallSettings.xml"];
  var cfgRoots = [
    exeDir,
    sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\NVCleanstall"),
    sh.ExpandEnvironmentStrings("%APPDATA%\\NVCleanstall"),
    sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\NVCleanInstall"),
    sh.ExpandEnvironmentStrings("%APPDATA%\\NVCleanInstall"),
    sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\TechPowerUp\\NVCleanstall")
  ];
  var i, j, cp, cn;
  for (i = 0; i < cfgRoots.length; i++) {
    var root = cfgRoots[i];
    if (!root || !fso.FolderExists(root)) continue;
    for (j = 0; j < cfgNames.length; j++) {
      cn = cfgNames[j];
      cp = getAbsolutePathFs(root + "\\" + cn);
      if (fso.FileExists(cp)) result.configFiles.push(cp);
    }
  }
  var args = ["/?", "--help", "-h", "/help"];
  var helpAll = "";
  for (i = 0; i < args.length; i++) {
    try {
      var out = runCommandCapture('"' + String(exePath).replace(/"/g, "") + '" ' + args[i]);
      if (out && out.length > helpAll.length) helpAll = out;
    } catch (eH) {}
  }
  result.cliHelpSnippet = String(helpAll || "").substring(0, 600);
  if (/silent|unattend|preset|config|\.ini|import|export|command[- ]?line/i.test(helpAll)) {
    result.cliSupported = true;
  }
  if (result.configFiles.length) {
    result.configWritablePath = result.configFiles[0];
    if (/^tools|app-tools/i.test(String(sessionCache.nvcExeLocate && sessionCache.nvcExeLocate.source))) {
      result.method = "config";
    }
  }
  if (result.cliSupported) result.method = "cli";
  var deploy = getNvcleanstallToolsDir() || exeDir;
  if (deploy) result.deployDir = getAbsolutePathFs(deploy + "\\UnrealPresetDeploy");
  return result;
}

function mapPresetToNvcleanstallIniLines(preset) {
  var lines = [];
  lines.push("; Unreal   preset NVCleanInstall Gaming / Unreal (suggestion, non officiel)");
  lines.push("; Composants : 1 = installer, 0 = ne pas installer");
  var c = preset.components || {};
  var t = preset.tweaks || {};
  function onOff(obj, key) {
    if (!obj || !obj[key]) return "0";
    if (obj[key].enabled === true || obj[key].required) return "1";
    return "0";
  }
  lines.push("DisplayDriver=" + onOff(c, "displayDriver"));
  lines.push("PhysX=" + onOff(c, "physX"));
  lines.push("NVIDIA_DLSS=" + onOff(c, "nvidiaDlss"));
  lines.push("LegacyControlPanel=" + onOff(c, "legacyControlPanel"));
  lines.push("HDAudio=" + onOff(c, "hdAudioHdmi"));
  lines.push("VCpp2017=" + onOff(c, "vcpp2017"));
  lines.push("USBC=" + onOff(c, "usbC"));
  lines.push("FrameViewSDK=" + onOff(c, "frameViewSdk"));
  lines.push("QuadroView=" + onOff(c, "quadroView"));
  lines.push("VirtualAudio=" + onOff(c, "virtualAudio"));
  lines.push("Telemetry=" + onOff(c, "telemetry"));
  lines.push("NVPlatformControllers=" + onOff(c, "nvPlatformControllers"));
  lines.push("NVIDIAApp=" + onOff(c, "nvidiaApp"));
  lines.push("NVContainer=" + onOff(c, "nvContainer"));
  lines.push("ShadowPlay=" + onOff(c, "shadowPlay"));
  lines.push("NVBackend=" + onOff(c, "nvBackend"));
  lines.push("NVIDIAAppMessageBus=" + onOff(c, "nvidiaAppMessageBus"));
  lines.push("; Tweaks");
  lines.push("DisableInstallerTelemetry=" + onOff(t, "disableInstallerTelemetryAdvertising"));
  lines.push("UnattendedExpressInstallation=" + onOff(t, "unattendedExpressInstallation"));
  lines.push("PerformCleanInstallation=" + onOff(t, "performCleanInstallation"));
  lines.push("AddHardwareSupport=" + onOff(t, "addHardwareSupport"));
  lines.push("EnableDLSSIndicator=" + onOff(t, "enableDlssIndicator"));
  lines.push("DisableMPO=" + onOff(t, "disableMpo"));
  lines.push("DisableAnsel=" + onOff(t, "disableAnsel"));
  lines.push("ShowExpertTweaks=" + onOff(t, "showExpertTweaks"));
  lines.push("DisableDriverTelemetry=" + onOff(t, "disableDriverTelemetryExperimental"));
  lines.push("DisableNVIDIAContainer=" + onOff(t, "disableNvidiaContainerExperimental"));
  lines.push("DisableHDAudioSleepTimer=" + onOff(t, "disableHdAudioSleepTimer"));
  lines.push("EnableMSI=" + onOff(t, "enableMsi"));
  lines.push("InterruptPolicy=" + (t.interruptPolicy && t.interruptPolicy.value ? t.interruptPolicy.value : "Default"));
  lines.push("InterruptPriority=" + (t.interruptPriority && t.interruptPriority.value ? t.interruptPriority.value : "Default"));
  lines.push("DisableHDCP=" + onOff(t, "disableHdcp"));
  lines.push("ApplyNVENCPatch=" + onOff(t, "applyNvencSessionLimitPatch"));
  lines.push("StartExternalApp=" + onOff(t, "startExternalApplication"));
  lines.push("RebuildDigitalSignature=" + onOff(t, "rebuildDigitalSignature"));
  lines.push("EACCompatibleMethod=" + onOff(t, "easyAntiCheatCompatibleMethod"));
  lines.push("AutoAcceptUnsignedWarning=" + onOff(t, "autoAcceptDriverUnsignedWarning"));
  return lines;
}

function buildUnrealNvidiaPresetChecklist(preset) {
  var lines = [];
  var c = preset.components || {};
  var t = preset.tweaks || {};
  var k;
  lines.push("=== Composants à cocher dans NVCleanInstall ===");
  for (k in c) {
    if (!c.hasOwnProperty(k) || !c[k] || !c[k].label) continue;
    var mark = (c[k].enabled || c[k].required) ? "[x]" : "[ ]";
    lines.push(mark + " " + c[k].label);
  }
  lines.push("");
  lines.push("=== Installation Tweaks ===");
  for (k in t) {
    if (!t.hasOwnProperty(k) || !t[k] || !t[k].label) continue;
    if (t[k].value) {
      lines.push("[=] " + t[k].label + " : " + t[k].value);
    } else {
      mark = t[k].enabled ? "[x]" : "[ ]";
      lines.push(mark + " " + t[k].label);
    }
  }
  return lines;
}

function deployUnrealNvidiaPresetFiles(preset, probe) {
  var applied = [];
  var skipped = [];
  var deployDir = probe && probe.deployDir ? probe.deployDir : "";
  if (!deployDir) {
    skipped.push("Dossier de déploiement introuvable");
    return { applied: applied, skipped: skipped, deployDir: "" };
  }
  if (!createFolder(deployDir)) {
    skipped.push("Impossible de créer le dossier deploy");
    return { applied: applied, skipped: skipped, deployDir: deployDir };
  }
  var fso = getFso();
  var presetPath = getUnrealNvidiaPresetPath();
  try {
    if (presetPath && fso.FileExists(presetPath)) {
      fso.CopyFile(presetPath, deployDir + "\\UnrealNvidiaPreset.json", true);
      applied.push("UnrealNvidiaPreset.json");
    }
  } catch (eCp) {
    skipped.push("Copie preset : " + String(eCp.message || eCp));
  }
  var checklist = buildUnrealNvidiaPresetChecklist(preset);
  try {
    var tw = fso.CreateTextFile(deployDir + "\\UnrealNvidiaPreset.checklist.txt", true);
    tw.Write(checklist.join("\r\n"));
    tw.Close();
    applied.push("UnrealNvidiaPreset.checklist.txt");
  } catch (eCl) {
    skipped.push("Checklist : " + String(eCl.message || eCl));
  }
  var iniLines = mapPresetToNvcleanstallIniLines(preset);
  try {
    var tw2 = fso.CreateTextFile(deployDir + "\\UnrealNvidiaPreset.suggested.ini", true);
    tw2.Write(iniLines.join("\r\n"));
    tw2.Close();
    applied.push("UnrealNvidiaPreset.suggested.ini");
  } catch (eIn) {
    skipped.push("INI : " + String(eIn.message || eIn));
  }
  if (probe && probe.configWritablePath && /\\tools\\NVCleanstall/i.test(probe.configWritablePath)) {
    try {
      var targetIni = getAbsolutePathFs(fso.GetParentFolderName(probe.configWritablePath) + "\\UnrealNvidiaPreset.suggested.ini");
      var tw3 = fso.CreateTextFile(targetIni, true);
      tw3.Write(iniLines.join("\r\n"));
      tw3.Close();
      applied.push("INI outils (à importer si NVCleanInstall le supporte)");
    } catch (eT) {
      skipped.push("INI outils : " + String(eT.message || eT));
    }
  }
  return { applied: applied, skipped: skipped, deployDir: deployDir };
}

function readNvPresetState() {
  try {
    var p = UNREAL_BASE + "\\nvc-preset-state.json";
    if (!getFso().FileExists(p)) return null;
    return JSON.parse(readTextFileAll(p));
  } catch (e) {
    return null;
  }
}

function writeNvPresetState(obj) {
  try {
    createUnrealFolders();
    var prev = readNvPresetState() || {};
    var k;
    for (k in obj) if (obj.hasOwnProperty(k)) prev[k] = obj[k];
    var w = getFso().CreateTextFile(UNREAL_BASE + "\\nvc-preset-state.json", true);
    w.Write(JSON.stringify(prev, null, 2));
    w.Close();
  } catch (eW) {}
}

function prepareUnrealNvidiaPresetForInstall(exePath, options) {
  options = options || {};
  var preset = loadUnrealNvidiaPreset();
  var result = {
    ok: false,
    method: "guided",
    applied: [],
    skipped: [],
    checklist: [],
    deployDir: ""
  };
  if (!preset) {
    logNvPreset("Preset Unreal chargé : non");
    result.skipped.push("Fichier UnrealNvidiaPreset.json introuvable");
    return result;
  }
  logNvPreset("Preset Unreal chargé : oui (" + (preset.presetName || preset.presetId) + ")");
  var probe = probeNvcleanstallCapabilities(exePath);
  sessionCache.nvcPresetProbe = probe;
  logNvPreset("Support ligne de commande : " + (probe.cliSupported ? "oui" : "non"));
  logNvPreset("Fichier config détecté : " + (probe.configFiles.length ? "oui" : "non"));
  if (probe.configFiles.length) logNvPreset("Config : " + probe.configFiles.join(" | "));
  var deploy = deployUnrealNvidiaPresetFiles(preset, probe);
  result.applied = deploy.applied;
  result.skipped = deploy.skipped;
  result.deployDir = deploy.deployDir;
  result.checklist = buildUnrealNvidiaPresetChecklist(preset);
  if (probe.method === "cli" && probe.cliSupported) {
    result.method = "cli";
    result.ok = true;
    logNvPreset("Méthode : automatique (arguments CLI détectés   validation manuelle requise)");
  } else if (probe.method === "config" && deploy.applied.length) {
    result.method = "config";
    result.ok = true;
    logNvPreset("Méthode : config (fichiers déployés dans tools   import selon version NVCleanInstall)");
  } else {
    result.method = "guided";
    result.ok = true;
    logNvPreset("Méthode : guidée (checklist   pas d'automatisation souris)");
  }
  var i;
  for (i = 0; i < result.applied.length; i++) logNvPreset("Option déployée : " + result.applied[i]);
  for (i = 0; i < result.skipped.length; i++) logNvPreset("Option ignorée : " + result.skipped[i]);
  if (!options.dryRun) {
    writeNvPresetState({
      lastApplied: nowDateTimeFr(),
      method: result.method,
      deployDir: result.deployDir,
      exePath: exePath || ""
    });
  }
  return result;
}

/* ---------- NVCleanstall preset fichier (sans clics souris) ---------- */
var NVCLEAN_PRESET_LOG_PATH = "";

function initNvcleanstallPresetLogPath() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  NVCLEAN_PRESET_LOG_PATH = app
    ? combinePath(app, "logs\\nvcleaninstall-preset.log")
    : combinePath(UNREAL_BASE, "logs\\nvcleaninstall-preset.log");
}

function writeNvcleanstallPresetLog(line) {
  initNvcleanstallPresetLogPath();
  try {
    var fso = getFso();
    var folder = fso.GetParentFolderName(NVCLEAN_PRESET_LOG_PATH);
    if (folder && !fso.FolderExists(folder)) fso.CreateFolder(folder);
    var ForAppending = 8;
    if (!fso.FileExists(NVCLEAN_PRESET_LOG_PATH)) {
      var t0 = fso.CreateTextFile(NVCLEAN_PRESET_LOG_PATH, true);
      t0.WriteLine(line);
      t0.Close();
    } else {
      var t1 = fso.OpenTextFile(NVCLEAN_PRESET_LOG_PATH, ForAppending, true);
      t1.WriteLine(line);
      t1.Close();
    }
  } catch (eLog) {}
}

function getNvcleanstallUnrealPresetPath() {
  var app = getAppFolderFromHta() || getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (!app) return "";
  return getAbsolutePathFs(app + "\\config\\NVCleanstall_UnrealPreset.json");
}

function buildNvcleanstallUnrealPresetSpec() {
  return {
    bestDriverForHardware: true,
    components: { displayDriver: true },
    tweaks: {
      disableInstallerTelemetryAdvertising: true,
      performCleanInstall: true,
      disableMPO: true,
      disableAnsel: true,
      showExpertTweaks: true,
      disableDriverTelemetry: true,
      enableMSI: true,
      disableHDCP: true,
      easyAntiCheatCompatible: true,
      acceptUnsignedWarning: true
    }
  };
}

function nvcPresetSpecToIniKeyMap(spec) {
  var m = {};
  var compOff = {
    DisplayDriver: "1",
    PhysX: "0",
    NVIDIA_DLSS: "0",
    LegacyControlPanel: "0",
    HDAudio: "0",
    VCpp2017: "0",
    USBC: "0",
    FrameViewSDK: "0",
    QuadroView: "0",
    VirtualAudio: "0",
    Telemetry: "0",
    NVPlatformControllers: "0",
    NVIDIAApp: "0",
    NVContainer: "0",
    ShadowPlay: "0",
    NVBackend: "0",
    NVIDIAAppMessageBus: "0"
  };
  var ck;
  for (ck in compOff) {
    if (compOff.hasOwnProperty(ck)) m[ck] = compOff[ck];
  }
  if (spec && spec.tweaks) {
    var t = spec.tweaks;
    if (t.disableInstallerTelemetryAdvertising) m.DisableInstallerTelemetry = "1";
    if (t.performCleanInstall) m.PerformCleanInstallation = "1";
    if (t.disableMPO) m.DisableMPO = "1";
    if (t.disableAnsel) m.DisableAnsel = "1";
    if (t.showExpertTweaks) m.ShowExpertTweaks = "1";
    if (t.disableDriverTelemetry) m.DisableDriverTelemetry = "1";
    if (t.enableMSI) m.EnableMSI = "1";
    if (t.disableHDCP) m.DisableHDCP = "1";
    if (t.easyAntiCheatCompatible) m.EACCompatibleMethod = "1";
    if (t.acceptUnsignedWarning) m.AutoAcceptUnsignedWarning = "1";
  }
  m.InstallBestDriverForHardware = "1";
  m.BestDriverForHardware = "1";
  m.AutoSelectBestDriver = "1";
  return m;
}

function writeNvcleanstallInternalPresetFile(spec) {
  var path = getNvcleanstallUnrealPresetPath();
  if (!path) return { ok: false, path: "", error: "path_unresolved" };
  try {
    var dir = getFso().GetParentFolderName(path);
    if (dir && !getFso().FolderExists(dir)) createFolder(dir);
    var tw = getFso().CreateTextFile(path, true);
    tw.Write(JSON.stringify(spec, null, 2));
    tw.Close();
    return { ok: true, path: path, error: "" };
  } catch (eW) {
    return { ok: false, path: path, error: String(eW.message || eW) };
  }
}

function collectNvcleanstallPresetSearchRoots(nvcExePath) {
  var fso = getFso();
  var sh = getShell();
  var roots = [];
  var seen = {};
  function add(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d] || !fso.FolderExists(d)) return;
    seen[d] = true;
    roots.push(d);
  }
  if (nvcExePath && fso.FileExists(nvcExePath)) add(fso.GetParentFolderName(nvcExePath));
  add(getNvcleanstallToolsDir());
  add(sh.ExpandEnvironmentStrings("%LOCALAPPDATA%"));
  add(sh.ExpandEnvironmentStrings("%APPDATA%"));
  add(sh.ExpandEnvironmentStrings("%PROGRAMDATA%"));
  add(sh.ExpandEnvironmentStrings("%USERPROFILE%\\Documents"));
  add(sh.ExpandEnvironmentStrings("%USERPROFILE%\\Downloads"));
  add(sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\NVCleanstall"));
  add(sh.ExpandEnvironmentStrings("%APPDATA%\\NVCleanstall"));
  add(sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\NVCleanInstall"));
  add(sh.ExpandEnvironmentStrings("%APPDATA%\\NVCleanInstall"));
  add(sh.ExpandEnvironmentStrings("%LOCALAPPDATA%\\TechPowerUp\\NVCleanstall"));
  return roots;
}

function nvcConfigFileNameLooksRelevant(name) {
  return /nvcleanstall|nvcleaninstall|techpowerup|settings|config|preset|preferences|profile/i.test(String(name || ""));
}

function nvcConfigFileHasUsefulKeywords(content) {
  return /telemetry|advertising|clean|mpo|multiplane|ansel|expert|msi|message\s*signaled|hdcp|anti-?cheat|unsigned|warning|display\s*driver|DisableMPO|PerformClean|ShowExpert/i.test(String(content || ""));
}

function searchNvcleanstallConfigFilesLimited(nvcExePath) {
  var fso = getFso();
  var roots = collectNvcleanstallPresetSearchRoots(nvcExePath);
  var found = [];
  var seenFile = {};
  var extRe = /\.(ini|json|xml|cfg|config|txt)$/i;
  var cfgNames = ["NVCleanstall.ini", "settings.ini", "Settings.xml", "config.json", "NVCleanstallSettings.xml", "preferences.ini", "profile.ini"];
  var maxFiles = 48;
  function pushFile(fp) {
    var p = getAbsolutePathFs(fp);
    if (!p || seenFile[p] || !fso.FileExists(p)) return;
    if (!extRe.test(p)) return;
    if (!nvcConfigFileNameLooksRelevant(fso.GetFileName(p))) return;
    seenFile[p] = true;
    found.push(p);
  }
  function scanDir(dir, depth) {
    if (!dir || depth > 2 || found.length >= maxFiles) return;
    var i;
    try {
      for (i = 0; i < cfgNames.length; i++) pushFile(dir + "\\" + cfgNames[i]);
      var folder = fso.GetFolder(dir);
      var fc = new Enumerator(folder.Files);
      for (; !fc.atEnd(); fc.moveNext()) {
        if (found.length >= maxFiles) break;
        pushFile(fc.item().Path);
      }
      if (depth < 2) {
        var sub = new Enumerator(folder.SubFolders);
        for (; !sub.atEnd(); sub.moveNext()) {
          if (found.length >= maxFiles) break;
          var subName = sub.item().Name;
          if (/nvcleanstall|nvcleaninstall|techpowerup|config|settings|preset/i.test(subName)) {
            scanDir(sub.item().Path, depth + 1);
          }
        }
      }
    } catch (eScan) {}
  }
  var r;
  for (r = 0; r < roots.length; r++) scanDir(roots[r], 0);
  return { roots: roots, files: found };
}

function backupNvcConfigFile(filePath) {
  var fso = getFso();
  var backupPath = filePath + ".bak-unreal";
  try {
    if (fso.FileExists(backupPath)) return { ok: true, path: backupPath };
    fso.CopyFile(filePath, backupPath, false);
    return { ok: true, path: backupPath };
  } catch (eB) {
    return { ok: false, path: "", error: String(eB.message || eB) };
  }
}

function countIniKnownKeysInContent(content, keyMap) {
  var found = 0;
  var lines = String(content || "").split(/\r?\n/);
  var i, m, k;
  for (i = 0; i < lines.length; i++) {
    m = /^\s*([A-Za-z0-9_]+)\s*=/.exec(lines[i]);
    if (m && keyMap[m[1]]) found++;
  }
  return found;
}

function applyPresetToIniContent(content, keyMap, allowAdd) {
  var lines = String(content || "").split(/\r?\n/);
  var keysFound = [];
  var keysModified = [];
  var present = countIniKnownKeysInContent(content, keyMap);
  var canAdd = !!allowAdd && present >= 3;
  var i, m, key, line, newLine, re;
  for (i = 0; i < lines.length; i++) {
    line = lines[i];
    m = /^\s*([A-Za-z0-9_]+)\s*=\s*(.*)$/.exec(line);
    if (!m) continue;
    key = m[1];
    if (!keyMap[key]) continue;
    keysFound.push(key);
    newLine = key + "=" + keyMap[key];
    if (line !== newLine) {
      lines[i] = newLine;
      keysModified.push(key);
    }
  }
  if (canAdd) {
    for (key in keyMap) {
      if (!keyMap.hasOwnProperty(key)) continue;
      re = new RegExp("^\\s*" + key + "\\s*=", "m");
      if (!re.test(content)) {
        lines.push(key + "=" + keyMap[key]);
        keysModified.push(key + "(added)");
      }
    }
  }
  return {
    content: lines.join("\r\n"),
    keysFound: keysFound,
    keysModified: keysModified,
    format: "ini"
  };
}

function applyPresetToJsonContent(content, keyMap) {
  var keysFound = [];
  var keysModified = [];
  try {
    var obj = JSON.parse(content);
    var flat = {};
    function walk(o, prefix) {
      var k;
      for (k in o) {
        if (!o.hasOwnProperty(k)) continue;
        var path = prefix ? prefix + "." + k : k;
        if (o[k] !== null && typeof o[k] === "object" && !o[k].length && typeof o[k] !== "boolean") {
          walk(o[k], path);
        } else {
          flat[k] = o[k];
        }
      }
    }
    walk(obj, "");
    var mapKey, fileKey;
    for (mapKey in keyMap) {
      if (!keyMap.hasOwnProperty(mapKey)) continue;
      for (fileKey in flat) {
        if (!flat.hasOwnProperty(fileKey)) continue;
        if (String(fileKey).toLowerCase() === String(mapKey).toLowerCase()) {
          keysFound.push(fileKey);
          var want = keyMap[mapKey] === "1" || keyMap[mapKey] === "true";
          if (typeof flat[fileKey] === "boolean" && flat[fileKey] !== want) {
            flat[fileKey] = want;
            keysModified.push(fileKey);
          } else if (String(flat[fileKey]) !== String(keyMap[mapKey])) {
            flat[fileKey] = mapKey.indexOf("Disable") === 0 || mapKey.indexOf("Enable") === 0 ? (keyMap[mapKey] === "1") : keyMap[mapKey];
            keysModified.push(fileKey);
          }
        }
      }
    }
    if (!keysModified.length) return { content: content, keysFound: keysFound, keysModified: keysModified, format: "json" };
    for (mapKey in keyMap) {
      if (!keyMap.hasOwnProperty(mapKey)) continue;
      if (obj[mapKey] !== undefined && String(obj[mapKey]) !== String(keyMap[mapKey])) {
        obj[mapKey] = keyMap[mapKey] === "1";
        if (keysModified.indexOf(mapKey) < 0) keysModified.push(mapKey);
      }
    }
    return { content: JSON.stringify(obj, null, 2), keysFound: keysFound, keysModified: keysModified, format: "json" };
  } catch (eJ) {
    return { content: content, keysFound: keysFound, keysModified: keysModified, format: "json-invalid" };
  }
}

function applyPresetToConfigFile(filePath, keyMap) {
  var content = readTextFileAll(filePath);
  if (!content || !nvcConfigFileHasUsefulKeywords(content)) {
    return { ok: false, analyzed: true, exploitable: false, keysFound: [], keysModified: [], backup: "" };
  }
  var lower = String(filePath).toLowerCase();
  var result;
  if (/\.json$/i.test(lower)) result = applyPresetToJsonContent(content, keyMap);
  else result = applyPresetToIniContent(content, keyMap, false);
  if (!result.keysFound.length && !result.keysModified.length) {
    return { ok: false, analyzed: true, exploitable: false, keysFound: [], keysModified: [], backup: "" };
  }
  if (!result.keysModified.length) {
    return { ok: false, analyzed: true, exploitable: true, keysFound: result.keysFound, keysModified: [], backup: "" };
  }
  var bak = backupNvcConfigFile(filePath);
  if (!bak.ok) return { ok: false, analyzed: true, exploitable: true, keysFound: result.keysFound, keysModified: [], backup: "", error: bak.error };
  try {
    var tw = getFso().CreateTextFile(filePath, true);
    tw.Write(result.content);
    tw.Close();
    return {
      ok: true,
      analyzed: true,
      exploitable: true,
      keysFound: result.keysFound,
      keysModified: result.keysModified,
      backup: bak.path,
      format: result.format
    };
  } catch (eW) {
    return { ok: false, analyzed: true, exploitable: true, keysFound: result.keysFound, keysModified: [], backup: bak.path, error: String(eW.message || eW) };
  }
}

function prepareNvcleanstallPreset() {
  initNvcleanstallPresetLogPath();
  writeNvcleanstallPresetLog("DATE=" + new Date().toISOString());
  writeNvcleanstallPresetLog("ACTION=prepare_nvcleaninstall_preset");
  setNvcleanAutoStatus("Recherche des fichiers de configuration NVCleanstall...", "info");
  var nvcPath = getPreferredNvcleanstallExePath();
  writeNvcleanstallPresetLog("NVCLEANSTALL_PATH=" + (nvcPath || ""));
  var spec = buildNvcleanstallUnrealPresetSpec();
  var internal = writeNvcleanstallInternalPresetFile(spec);
  writeNvcleanstallPresetLog("INTERNAL_PRESET_CREATED=" + (internal.ok ? "oui" : "non"));
  if (internal.path) writeNvcleanstallPresetLog("INTERNAL_PRESET_PATH=" + internal.path);
  if (!internal.ok) writeNvcleanstallPresetLog("INTERNAL_PRESET_ERROR=" + internal.error);
  var keyMap = nvcPresetSpecToIniKeyMap(spec);
  var search = searchNvcleanstallConfigFilesLimited(nvcPath);
  writeNvcleanstallPresetLog("SEARCH_PATHS=" + search.roots.join(" | "));
  writeNvcleanstallPresetLog("CONFIG_FILES_FOUND=" + search.files.length);
  var allKeysFound = [];
  var allKeysModified = [];
  var backups = [];
  var filesModified = 0;
  var i, fp, applyRes;
  for (i = 0; i < search.files.length; i++) {
    fp = search.files[i];
    writeNvcleanstallPresetLog("CONFIG_FILE_ANALYZED=" + fp);
    applyRes = applyPresetToConfigFile(fp, keyMap);
    if (applyRes.keysFound && applyRes.keysFound.length) {
      writeNvcleanstallPresetLog("KEYS_FOUND=" + applyRes.keysFound.join(","));
      allKeysFound = allKeysFound.concat(applyRes.keysFound);
    }
    if (applyRes.ok) {
      filesModified++;
      if (applyRes.keysModified.length) {
        writeNvcleanstallPresetLog("KEYS_MODIFIED=" + applyRes.keysModified.join(","));
        allKeysModified = allKeysModified.concat(applyRes.keysModified);
      }
      if (applyRes.backup) {
        backups.push(applyRes.backup);
        writeNvcleanstallPresetLog("BACKUP_CREATED=oui");
        writeNvcleanstallPresetLog("BACKUP_PATH=" + applyRes.backup);
      }
    } else if (applyRes.exploitable) {
      writeNvcleanstallPresetLog("KEYS_MODIFIED=");
      writeNvcleanstallPresetLog("BACKUP_CREATED=non");
    }
  }
  if (!search.files.length) {
    writeNvcleanstallPresetLog("RESULT=no_config_files");
    writeNvcleanstallPresetLog("ERROR=");
    setNvcleanAutoStatus("Aucun fichier de configuration NVCleanstall exploitable trouve.", "info");
    if (internal.ok) {
      window.setTimeout(function () {
        setNvcleanAutoStatus("Preset interne cree, mais aucun fichier NVCleanstall modifiable trouve.", "info");
      }, 1200);
    }
    return;
  }
  if (filesModified > 0) {
    writeNvcleanstallPresetLog("RESULT=preset_applied");
    writeNvcleanstallPresetLog("ERROR=");
    setNvcleanAutoStatus("Preset NVCleanstall applique. Ouvre NVCleanstall pour verifier les reglages.", "success");
    return;
  }
  writeNvcleanstallPresetLog("RESULT=internal_only");
  writeNvcleanstallPresetLog("ERROR=");
  if (internal.ok) {
    setNvcleanAutoStatus("Preset interne cree, mais aucun fichier NVCleanstall modifiable trouve.", "info");
  } else {
    setNvcleanAutoStatus("Aucun fichier de configuration NVCleanstall exploitable trouve.", "info");
  }
}

function verifyNvidiaTweaksAfterInstall(preset) {
  var out = [];
  function pushLine(name, status, detail) {
    out.push({ name: name, status: status, detail: detail || "" });
  }
  try {
    var mpo = queryRegValueText("HKLM\\SOFTWARE\\Microsoft\\Windows\\Dwm", "OverlayTestMode");
    if (/REG_DWORD\s+0x5\b/i.test(mpo) || /REG_DWORD\s+5(\s|$)/i.test(mpo)) {
      pushLine("MPO désactivé", "ok", "OverlayTestMode=5");
    } else if (mpo) {
      pushLine("MPO désactivé", "unknown", "Valeur actuelle : " + mpo.replace(/\s+/g, " "));
    } else {
      pushLine("MPO désactivé", "unknown", "non vérifiable automatiquement");
    }
  } catch (eM) {
    pushLine("MPO désactivé", "unknown", "non vérifiable automatiquement");
  }
  pushLine("Composants NVIDIA (App/ShadowPlay)", "unknown", "non vérifiable automatiquement");
  pushLine("Télémétrie pilote", "unknown", "non vérifiable automatiquement");
  pushLine("HDCP", "unknown", "non vérifiable automatiquement");
  pushLine("MSI", "unknown", "non vérifiable automatiquement");
  return out;
}

function setNvPresetBadge(elId, text, kind) {
  var el = $(elId);
  if (!el) return;
  var cls = "tcp-badge";
  if (kind === "ok") cls += " tcp-badge--ok";
  else if (kind === "warn") cls += " tcp-badge--warn";
  else if (kind === "bad") cls += " tcp-badge--bad";
  else cls += " tcp-badge--progress";
  el.className = cls;
  el.innerText = text || "";
}

function refreshNvPresetUi() {
  var preset = loadUnrealNvidiaPreset();
  if (preset) setNvPresetBadge("nvPresetStatusBadge", "Preset : actif", "ok");
  else setNvPresetBadge("nvPresetStatusBadge", "Preset : introuvable", "bad");
  var loc = locateNvcleanstallExecutable(false);
  if (loc && loc.path) {
    setNvPresetBadge("nvPresetNvcBadge", "NVCleanInstall : détecté", "ok");
    if ($("nvPresetNvcPath")) $("nvPresetNvcPath").innerText = loc.path;
  } else {
    setNvPresetBadge("nvPresetNvcBadge", "NVCleanInstall : non détecté", "warn");
    if ($("nvPresetNvcPath")) $("nvPresetNvcPath").innerText = "";
  }
  var st = readNvPresetState();
  var method = (sessionCache.nvcPresetProbe && sessionCache.nvcPresetProbe.method) || (st && st.method) || "";
  if (method === "guided") method = "guidée";
  else if (method === "config") method = "config";
  else if (method === "cli") method = "automatique (CLI)";
  if ($("nvPresetMethodLine")) $("nvPresetMethodLine").innerText = "Méthode : " + method;
  if ($("nvPresetLastAppliedLine")) {
    $("nvPresetLastAppliedLine").innerText = "Dernière application du preset : " + ((st && st.lastApplied) ? st.lastApplied : "");
  }
  var upd = sessionCache.gpuDriverUpdate;
  if ($("nvPresetDriverLine")) {
    if (upd && upd.status === "update") $("nvPresetDriverLine").innerText = "Dernier pilote : mise à jour disponible";
    else if (upd && upd.status === "uptodate") $("nvPresetDriverLine").innerText = "Dernier pilote : à jour";
    else $("nvPresetDriverLine").innerText = "Dernier pilote : ";
  }
}

var nvPresetProbeBusy = false;

function scheduleNvPresetProbe(force) {
  if (nvPresetProbeBusy && !force) return;
  nvPresetProbeBusy = true;
  window.setTimeout(function () {
    try {
      var loc = locateNvcleanstallExecutable(!!force);
      if (loc && loc.path) {
        logNvPreset("Chemin NVCleanInstall trouvé : " + loc.path + " (" + loc.source + ")");
        var ver = getNvcleanstallFileVersion(loc.path);
        logNvPreset("Version NVCleanInstall : " + (ver || "inconnue"));
        sessionCache.nvcPresetProbe = probeNvcleanstallCapabilities(loc.path);
        var preset = loadUnrealNvidiaPreset();
        if (preset) prepareUnrealNvidiaPresetForInstall(loc.path, { dryRun: true });
      } else {
        logNvPreset("NVCleanInstall non détecté (tools, Downloads, Bureau, projet)");
      }
      refreshNvPresetUi();
    } catch (ePr) {
      logNvPreset("Erreur probe preset : " + String(ePr.message || ePr));
    }
    nvPresetProbeBusy = false;
  }, 30);
}

function showUnrealNvidiaPresetChecklist() {
  var preset = loadUnrealNvidiaPreset();
  if (!preset) {
    alert("Preset Unreal introuvable (config\\UnrealNvidiaPreset.json).");
    return;
  }
  var lines = buildUnrealNvidiaPresetChecklist(preset);
  var i;
  for (i = 0; i < lines.length; i++) appendNvPresetLog(lines[i]);
  var st = readNvPresetState();
  if (st && st.deployDir) {
    appendNvPresetLog("Fichiers : " + st.deployDir);
    try {
      getShell().Run('explorer.exe "' + String(st.deployDir).replace(/"/g, "") + '"', 1, false);
    } catch (eEx) {}
  }
}

function openNvcleanstallWithPresetGuidance() {
  var loc = locateNvcleanstallExecutable(false);
  if (!loc || !loc.path) {
    if (window.confirm("NVCleanInstall non détecté.\n\nTélécharger / ouvrir la page officielle ?")) {
      openNvcleanstall();
    }
    return;
  }
  prepareUnrealNvidiaPresetForInstall(loc.path, { dryRun: false });
  showUnrealNvidiaPresetChecklist();
  if (!window.confirm("Ouvrir NVCleanInstall maintenant ?\n\nSuivez la checklist affichée dans le journal preset (composants + tweaks).")) return;
  var res = launchNvcleanstallExeElevated(loc.path, logNvPreset);
  if (res === "ok") setNvcleanstallOpenStatus("NVCleanInstall ouvert   appliquez le preset Unreal.", "ok");
  else nvcleanstallSetLaunchErrorUi(res);
}

function downloadNvcleanstallBinaryToPreferredPath(logFn) {
  var dir = getNvcleanstallToolsDir();
  if (!dir) throw new Error("Impossible de résoudre le dossier tools\\NVCleanstall (emplacement d'Unreal.hta).");
  if (!createFolder(dir)) throw new Error("Impossible de créer le dossier tools\\NVCleanstall (accès refusé ou chemin invalide).");
  var dest = getAbsolutePathFs(dir + "\\NVCleanstall.exe");
  var fso = getFso();
  var lastErr = "";
  var i;
  for (i = 0; i < NVCLEANSTALL_DIRECT_EXE_URLS.length; i++) {
    try {
      if (logFn) logFn("Téléchargement NVCleanstall (miroir " + (i + 1) + ") : " + NVCLEANSTALL_DIRECT_EXE_URLS[i]);
      downloadBinaryWithBrowserUa(NVCLEANSTALL_DIRECT_EXE_URLS[i], dest);
      if (isLaunchableExeFile(dest)) return dest;
      lastErr = "Le fichier téléchargé n'est pas un exécutable utilisable (contenu invalide ou page d'erreur).";
      try {
        if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
      } catch (eRm) {}
    } catch (e) {
      lastErr = String(e.message || e);
      try {
        if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
      } catch (eRm2) {}
    }
  }
  throw new Error(lastErr || "échec du téléchargement de NVCleanstall depuis tous les miroirs TechPowerUp.");
}

/**
 * Journal : réglages NVCleanstall à appliquer (NVCleanstall ne documente pas de ligne de commande complète pour tout pré-cocher ;
 * le pilote est passé en argument pour ouvrir directement le package ; vérifiez l'assistant si une étape reste manuelle).
 */
function logNvcleanstallExpectedSettings(logFn) {
  if (!logFn) return;
  var preset = loadUnrealNvidiaPreset();
  if (!preset) {
    logFn("Preset UnrealNvidiaPreset.json : introuvable");
    return;
  }
  var lines = buildUnrealNvidiaPresetChecklist(preset);
  var i;
  logFn("Preset Unreal   checklist NVCleanInstall :");
  for (i = 0; i < lines.length; i++) logFn("  " + lines[i]);
}

function shellQuoteAbsolutePath(path) {
  var p = getAbsolutePathFs(path);
  p = String(p || "").split('"').join("");
  return '"' + p + '"';
}

function nvcleanstallSetLaunchErrorUi(code, detail) {
  var map = {
    missing: "Erreur : fichier EXE introuvable.",
    invalid: "Erreur : fichier invalide ou non exécutable (extension, taille nulle, ou fichier HTML renommé).",
    uac_cancel: "Erreur : élévation administrateur refusée (UAC annulé).",
    access: "Erreur : accès refusé.",
    blocked: "Erreur : fichier peut être bloqué par Windows ou l'antivirus.",
    unknown: "Erreur : le lancement a échoué (voir le journal)."
  };
  var base = map[code] || map.unknown;
  if (detail) base += " " + detail;
  setNvcleanstallOpenStatus(base, "bad");
}

/** Lance NVCleanstall avec chemin absolu ; retour ok | missing | invalid | uac_cancel | access | unknown */
function launchNvcleanstallExeElevated(absExePath, logFn) {
  var p = "";
  try {
    p = getAbsolutePathFs(absExePath);
    if (logFn) logFn("Préparation du lancement (ShellExecute, runas, répertoire de travail = dossier de l'exe)...");
    var fso = getFso();
    if (!fso.FileExists(p)) {
      if (logFn) logFn("Erreur précise : fichier introuvable à l'emplacement attendu.");
      return "missing";
    }
    try {
      var sz = fso.GetFile(p).Size;
      if (logFn) logFn("Fichier trouvé : oui   taille " + String(sz) + " octet(s).");
    } catch (eSz) {
      if (logFn) logFn("Impossible de lire la taille du fichier : " + String(eSz.message || eSz));
    }
    if (!isLaunchableExeFile(p)) {
      if (logFn) {
        if (!/\.exe$/i.test(String(p))) logFn("Erreur précise : le chemin ne se terminée pas par .exe.");
        else if (fileLooksLikeAsciiHtmlSavedAsExe(p)) logFn("Erreur précise : le contenu ressemble à du HTML/texte (pas un binaire d'application).");
        else logFn("Erreur précise : fichier absent, taille nulle, ou illisible.");
      }
      return "invalid";
    }
    if (logFn) logFn("Chemin absolu utilisé pour ShellExecute : " + p);
    if (logFn) logFn("Répertoire de travail : " + fso.GetParentFolderName(p));
    launchFileAsAdmin(p);
    return "ok";
  } catch (e) {
    var msg = String(e.message || e || "");
    if (logFn) logFn("Erreur exacte au lancement (exception) : " + msg);
    if (/1223|cancel|cancelled|annul/i.test(msg)) return "uac_cancel";
    if (/accès|access|permission|denied|refus/i.test(msg)) return "access";
    if (/bloqu|blocked|smartscreen|protégé/i.test(msg)) return "blocked";
    return "unknown";
  }
}

function openNvcleanstall() {
  appendNvMediaLog("openNvcleanstall début");
  setNvcleanstallOpenStatus("Vérification en cours...", "progress");
  try {
    var dir = getNvcleanstallToolsDir();
    appendNvMediaLog("Dossier outil : " + (dir ? getAbsolutePathFs(dir) : "(non résolu)"));
    if (!dir) {
      nvcleanstallSetLaunchErrorUi("missing");
      alert("Erreur : dossier introuvable.");
      setNvcleanstallOpenStatus("", "");
      return;
    }
    if (!createFolder(dir)) {
      alert("Erreur : impossible de créer tools\\NVCleanstall.");
      nvcleanstallSetLaunchErrorUi("access");
      setNvcleanstallOpenStatus("", "");
      return;
    }
    tryMigrateLegacyNvcleanstallFolder(dir);
    var nvc = getPreferredNvcleanstallExePath();
    if (!nvc) {
      var askDl = window.confirm("NVCleanstall n'est pas installé dans tools\\NVCleanstall\\NVCleanstall.exe.\n\nTélécharger automatiquement depuis TechPowerUp ?\n\n(Annuler = ouvrir la page officielle.)");
      if (askDl) {
        setNvcleanstallOpenStatus("Téléchargement en cours...", "progress");
        try {
          nvc = downloadNvcleanstallBinaryToPreferredPath(appendNvMediaLog);
        } catch (eDl) {
          var md = String(eDl.message || eDl);
          appendNvMediaLog("échec téléchargement NVCleanstall : " + md);
          openNvcleanstallOfficialDownloadPage();
          alert("Erreur : téléchargement impossible.\n" + md);
          setNvcleanstallOpenStatus("", "");
          return;
        }
      } else {
        openNvcleanstallOfficialDownloadPage();
        setNvcleanstallOpenStatus("", "");
        return;
      }
    }
    if (!nvc) {
      setNvcleanstallOpenStatus("", "");
      return;
    }
    setNvcleanstallOpenStatus("Ouverture en cours...", "progress");
    var res = launchNvcleanstallExeElevated(nvc, appendNvMediaLog);
    if (res === "ok") {
      setNvcleanstallOpenStatus("Ouverture réussie.", "ok");
      window.setTimeout(function () {
        setNvcleanstallOpenStatus("", "");
      }, 5000);
    } else {
      nvcleanstallSetLaunchErrorUi(res);
      var detail = "";
      if (res === "uac_cancel") detail = "0lévation administrateur annulée.";
      else if (res === "access") detail = "Accès refusé.";
      else if (res === "invalid") detail = "Fichier NVCleanstall.exe invalide ou inaccessible.";
      else if (res === "blocked") detail = "Fichier peut être bloqué par Windows ou l'antivirus.";
      else detail = "Erreur : ouverture impossible.";
      if (detail) alert(detail);
    }
  } catch (eAll) {
    var em = String(eAll.message || eAll);
    appendNvMediaLog("Exception : " + em);
    alert("Erreur : " + em);
    setNvcleanstallOpenStatus("", "");
  }
}

function installLatestNvidiaDriverAutomatic() {
  appendNvMediaLog("installLatestNvidiaDriverAutomatic début");
  setNvMediaAutoStatus("Vérification en cours...", "progress", 6);
  window.setTimeout(function () {
    try { installLatestNvidiaDriverAutomaticImpl(); } catch (eTop) {
      var em = String(eTop.message || eTop);
      appendNvMediaLog("Exception : " + em);
      alert("Erreur : " + em);
      setNvMediaAutoStatus("", "", -1);
    }
  }, 20);
}

function installLatestNvidiaDriverAutomaticImpl() {
  try {
    showNvGpuManualPick(false);
    setNvMediaAutoStatus("Pilote graphique absent après nettoyage DDU. Recherche du matériel GPU...", "progress", 8);
    appendNvMediaLog("Détection GPU matériel pour installation pilote...");
    var hw = detectGpuForDriverInstall({});
    var detInstall = detectInstalledNvidiaDriver({ forceFull: true });
    var info = getInstalledNvidiaDriverInfo(true);
    if (hw.hasNvidia) {
      info.hasNvidia = true;
      if (!info.gpuName || hw.hardwareOnly) info.gpuName = hw.gpuName || info.gpuName || "GPU NVIDIA";
      info.detectionSource = hw.detectionSource || info.detectionSource;
      info.hardwareOnly = !detInstall.installed && hw.hardwareOnly;
    }
    if (detInstall.installed && detInstall.version) {
      info.driverVersion = detInstall.version;
      info.source = detInstall.source;
      info.hardwareOnly = false;
    } else {
      info.driverVersion = "";
      info.hardwareOnly = !!(hw.hasNvidia || info.hasNvidia);
    }
    if ($("nvGpuDetected")) {
      $("nvGpuDetected").innerText = info.gpuName || (info.hasNvidia ? "GPU NVIDIA" : "");
    }
    if ($("nvDriverInstalled")) {
      $("nvDriverInstalled").innerText = info.driverVersion || (info.hasNvidia ? "Aucun pilote installé" : "");
    }
    if (!info.hasNvidia) {
      showNvGpuManualPick(true);
      setNvMediaAutoStatus("Impossible de détecter le GPU. Choisis le fabricant manuellement.", "bad", 0);
      appendNvMediaLog("NVIDIA non détecté (cache/PCI/pnputil/video)");
      setNvMediaAutoStatus("", "", -1);
      return;
    }
    if (hw.detectionSource === "cache") {
      setNvMediaAutoStatus("Dernier GPU connu : NVIDIA. Installation du pilote possible.", "progress", 14);
      appendNvMediaLog("GPU depuis cache : " + (hw.gpuName || "NVIDIA"));
    } else if (hw.detectionSource === "pnp_entity" || hw.detectionSource === "pnputil") {
      setNvMediaAutoStatus("Carte NVIDIA détectée sans pilote. Installation du pilote possible.", "progress", 14);
      appendNvMediaLog("GPU NVIDIA matériel (" + hw.detectionSource + ")");
    } else if (!info.driverVersion) {
      setNvMediaAutoStatus("Carte NVIDIA détectée sans pilote. Installation du pilote possible.", "progress", 14);
    }

    setNvMediaAutoStatus("Vérification en cours...", "progress", 18);
    appendNvMediaLog("Pilote installé : " + (info.driverVersion || "(absent)") + " source=" + (info.source || hw.detectionSource || ""));
    var bundle = fetchLatestNvidiaDriverFromApi();
    if (!bundle || !bundle.url) {
      setNvMediaAutoStatus("Erreur : vérification impossible.", "bad", 0);
      appendNvMediaLog("API NVIDIA sans résultat");
      alert("Erreur : impossible de récupérer le dernier pilote (réseau ou service NVIDIA).");
      setNvMediaAutoStatus("", "", -1);
      return;
    }
    appendNvMediaLog("Dernier pilote : " + (bundle.version || "?") + " " + bundle.url);

    var latestVer = bundle.version || "";
    if (info.driverVersion && latestVer && detInstall.installed) {
      var cmp = compareDriverVersions(info.driverVersion, latestVer);
      if (cmp >= 0) {
        setNvMediaAutoStatus("Pilote NVIDIA à jour.", "ok", 100);
        appendNvMediaLog("Déjà à jour");
        window.setTimeout(function () {
          setNvMediaAutoStatus("", "", -1);
        }, 8000);
        return;
      }
    } else if (!info.driverVersion) {
      appendNvMediaLog("Pas de pilote installé   installation via NVCleanInstall");
    }

    setNvMediaAutoStatus("Vérification en cours...", "progress", 28);
    appendNvMediaLog("Mise à jour nécessaire vers " + (latestVer || "?"));

    var cacheDir = getNvidiaDriverCacheDir();
    if (!cacheDir || !createFolder(cacheDir)) {
      setNvMediaAutoStatus("Erreur : préparation impossible.", "bad", 0);
      appendNvMediaLog("Cache pilote introuvable : " + (cacheDir || ""));
      alert("Erreur : impossible de préparer le dossier de téléchargement.");
      setNvMediaAutoStatus("", "", -1);
      return;
    }
    var safeVer = latestVer ? latestVer.replace(/[^\d.]/g, "") : "";
    var dest = getAbsolutePathFs(cacheDir + "\\nvidia-driver-" + (safeVer || "latest") + ".exe");
    var fso = getFso();
    try {
      if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
    } catch (eOld) {}

    setNvMediaAutoStatus("Téléchargement en cours...", "progress", 45);
    appendNvMediaLog("Téléchargement vers " + dest);
    try {
      downloadBinaryWithBrowserUa(bundle.url, dest);
    } catch (eDl) {
      var mDl = String(eDl.message || eDl);
      setNvMediaAutoStatus("Erreur : téléchargement impossible.", "bad", 0);
      appendNvMediaLog("DL erreur : " + mDl);
      alert("Erreur : téléchargement impossible.\n" + mDl);
      try {
        if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
      } catch (eRm) {}
      setNvMediaAutoStatus("", "", -1);
      return;
    }

    try {
      var szDrv = fso.GetFile(dest).Size;
      appendNvMediaLog("Taille fichier : " + String(szDrv));
    } catch (eSz) {
      appendNvMediaLog("Taille illisible : " + String(eSz.message || eSz));
    }

    var driverOk = false;
    try {
      if (isPeExeFile(dest)) driverOk = true;
      else if (isLaunchableExeFile(dest)) {
        var szCheck = fso.GetFile(dest).Size;
        if (szCheck > 5000000) driverOk = true;
        else appendNvMediaLog("Taille pilote suspecte : " + String(szCheck));
      }
    } catch (eValDrv) {
      appendNvMediaLog("Validation : " + String(eValDrv.message || eValDrv));
      driverOk = false;
    }
    if (!driverOk) {
      setNvMediaAutoStatus("Erreur : téléchargement impossible.", "bad", 0);
      appendNvMediaLog("Fichier pilote invalide");
      alert("Erreur : fichier téléchargé invalide.");
      try {
        if (fso.FileExists(dest)) fso.DeleteFile(dest, true);
      } catch (eRm2) {}
      setNvMediaAutoStatus("", "", -1);
      return;
    }

    setNvMediaAutoStatus("Préparation en cours...", "progress", 62);
    tryMigrateLegacyNvcleanstallFolder(getNvcleanstallToolsDir());
    var nvc = getPreferredNvcleanstallExePath();
    if (!nvc) {
      if (!window.confirm("NVCleanstall est introuvable.\n\nTélécharger NVCleanstall automatiquement ?")) {
        setNvMediaAutoStatus("Opération annulée.", "bad", 0);
        appendNvMediaLog("Utilisateur a annulé sans NVCleanstall");
        alert("Opération annulée. Pilote enregistré :\n" + dest);
        setNvMediaAutoStatus("", "", -1);
        return;
      }
      try {
        nvc = downloadNvcleanstallBinaryToPreferredPath(appendNvMediaLog);
      } catch (eNv) {
        var mNv = String(eNv.message || eNv);
        setNvMediaAutoStatus("Erreur : téléchargement impossible.", "bad", 0);
        appendNvMediaLog("NVCleanstall DL : " + mNv);
        alert("Erreur : téléchargement impossible.\n" + mNv);
        setNvMediaAutoStatus("", "", -1);
        return;
      }
    }

    setNvMediaAutoStatus("Préparation du pilote...", "progress", 72);
    var prep = prepareUnrealNvidiaPresetForInstall(nvc, { dryRun: false });
    logNvcleanstallExpectedSettings(appendNvMediaLog);
    if (prep.method === "guided") {
      setNvMediaAutoStatus("Application du preset Unreal (guidée)...", "progress", 78);
      appendNvMediaLog("Mode guidé : suivez la checklist preset avant de valider dans NVCleanInstall");
    } else {
      setNvMediaAutoStatus("Application du preset Unreal...", "progress", 78);
      appendNvMediaLog("Preset déployé : " + (prep.deployDir || ""));
    }
    appendNvMediaLog("Lancement NVCleanstall + pilote");

    setNvMediaAutoStatus("Installation NVIDIA en cours...", "progress", 92);
    var driverArg = shellQuoteAbsolutePath(dest);
    launchFileAsAdminWithArgs(nvc, driverArg);

    setNvMediaAutoStatus("Terminez l'assistant NVCleanInstall...", "progress", 96);
    appendNvMediaLog("NVCleanInstall lancé avec le package pilote   Terminez l'assistant");
    try {
      sessionCache.nvidiaInfo = null;
      window.setTimeout(function () {
        try { applyNvDriverInfoToUi(true); } catch (eNvRef) {}
      }, 0);
    } catch (eNvRef2) {}
    alert("NVCleanInstall est ouvert avec le pilote téléchargé.\n\nAppliquez le preset Unreal (checklist dans le journal preset / dossier UnrealPresetDeploy).\n\nTerminez l'assistant, puis redémarrez si demandé.");
    window.setTimeout(function () {
      try { scheduleGpuDriverFullCheck(); } catch (eVer) {}
    }, 0);
  } catch (eAll) {
    var msg = String(eAll && eAll.message ? eAll.message : eAll);
    setNvMediaAutoStatus("Erreur : installation impossible.", "bad", 0);
    appendNvMediaLog("Exception : " + msg);
    alert("Erreur : installation impossible.\n" + msg);
  }
  try {
    window.setTimeout(function () {
      setNvMediaAutoStatus("", "", -1);
    }, 14000);
  } catch (eT) {
    setNvMediaAutoStatus("", "", -1);
  }
}

/* ---------- NVCleanstall auto (expérimental, AutoHotkey v2 + UIA) ---------- */
var NVCLEAN_AUTO_LOG_PATH = "";
var NVCLEAN_AUTO_LIVE_PATH = "";
var nvcleanAutoBusy = false;
var nvcleanTweaksBusy = false;
var nvcleanAutoPollGen = 0;
var nvcleanPackageReadyLogged = false;
var nvcleanKeyboardActionLogged = false;
var nvcleanDriverWatchPollGen = 0;
var nvcleanContinuePromptVisible = false;
var isNvidiaInstallerWizardLoopRunning = false;
var nvidiaInstallerLoopGen = 0;
var nvidiaInstallerLoopStarted = false;
var nvidiaElevatedHelperLaunchAttempted = false;
var nvidiaInstallerTickBusy = false;
var nvidiaOrchestratorWatcherGen = 0;
var nvidiaOrchestratorWatcherStarted = false;
var nvcInstallProcessSeen = false;
var nvcleanInstallUiCompleted = false;
var nvcWaitFinishLogged = false;

function initNvcleanAutoPaths() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) {
    NVCLEAN_AUTO_LOG_PATH = combinePath(app, "logs\\nvcleaninstall-auto.log");
    NVCLEAN_AUTO_LIVE_PATH = combinePath(app, "logs\\nvcleaninstall-auto-live.txt");
  } else {
    NVCLEAN_AUTO_LOG_PATH = combinePath(UNREAL_BASE, "logs\\nvcleaninstall-auto.log");
    NVCLEAN_AUTO_LIVE_PATH = combinePath(UNREAL_BASE, "logs\\nvcleaninstall-auto-live.txt");
  }
}

function writeNvcleanAutoLog(line) {
  try {
    initNvcleanAutoPaths();
    var fso = getFso();
    var folder = fso.GetParentFolderName(NVCLEAN_AUTO_LOG_PATH);
    if (folder && !fso.FolderExists(folder)) {
      try {
        fso.CreateFolder(folder);
      } catch (eMk) {}
    }
    var ForAppending = 8;
    if (!fso.FileExists(NVCLEAN_AUTO_LOG_PATH)) {
      var t0 = fso.CreateTextFile(NVCLEAN_AUTO_LOG_PATH, true);
      t0.WriteLine(line);
      t0.Close();
    } else {
      var t1 = fso.OpenTextFile(NVCLEAN_AUTO_LOG_PATH, ForAppending, true);
      t1.WriteLine(line);
      t1.Close();
    }
  } catch (eLog) {
    try {
      log("[NVClean auto] " + String(line || ""));
    } catch (eL) {}
  }
}

function writeNvcleanAutoLiveStatus(message) {
  initNvcleanAutoPaths();
  try {
    var fso = getFso();
    var dir = fso.GetParentFolderName(NVCLEAN_AUTO_LIVE_PATH);
    if (dir && !fso.FolderExists(dir)) fso.CreateFolder(dir);
    var st = fso.OpenTextFile(NVCLEAN_AUTO_LIVE_PATH, 8, true, -1);
    st.WriteLine("STATUS=" + String(message || ""));
    st.Close();
  } catch (eW) {}
}

function clearNvcleanAutoLiveFile() {
  initNvcleanAutoPaths();
  try {
    var fso = getFso();
    if (fso.FileExists(NVCLEAN_AUTO_LIVE_PATH)) fso.DeleteFile(NVCLEAN_AUTO_LIVE_PATH);
  } catch (eClr) {}
}

function readNvcleanAutoLiveStatus() {
  initNvcleanAutoPaths();
  try {
    var fso = getFso();
    if (!fso.FileExists(NVCLEAN_AUTO_LIVE_PATH)) return "";
    var txt = readTextFileAll(NVCLEAN_AUTO_LIVE_PATH);
    if (!txt) return "";
    var lines = String(txt).split(/\r?\n/);
    var i;
    for (i = lines.length - 1; i >= 0; i--) {
      var line = String(lines[i] || "");
      if (line.indexOf("STATUS=") === 0) return line.replace(/^STATUS=/, "");
    }
  } catch (eR) {}
  return "";
}

function readNvcleanAutoLogTail(maxLines) {
  initNvcleanAutoPaths();
  try {
    var fso = getFso();
    if (!fso.FileExists(NVCLEAN_AUTO_LOG_PATH)) return "";
    var txt = readTextFileAll(NVCLEAN_AUTO_LOG_PATH);
    if (!txt) return "";
    var lines = String(txt).split(/\r?\n/);
    var start = Math.max(0, lines.length - (maxLines || 30));
    return lines.slice(start).join("\n");
  } catch (eT) {}
  return "";
}

function readNvidiaInstallerTickResultFromLog() {
  var tail = readNvcleanAutoLogTail(40);
  var mOrch = tail.match(/NVIDIA_ORCH_RESULT=([^\r\n]+)/gi);
  if (mOrch && mOrch.length) {
    var lastO = mOrch[mOrch.length - 1];
    var po = lastO.split("=");
    if (po.length >= 2) return String(po[1]).toLowerCase();
  }
  var mElev = tail.match(/NVIDIA_ELEVATED_RESULT=([^\r\n]+)/gi);
  if (mElev && mElev.length) {
    var lastE = mElev[mElev.length - 1];
    var pe = lastE.split("=");
    if (pe.length >= 2) return String(pe[1]).toLowerCase();
  }
  var m = tail.match(/NVIDIA_TICK_RESULT=([^\r\n]+)/gi);
  if (m && m.length) {
    var last = m[m.length - 1];
    var parts = last.split("=");
    if (parts.length >= 2) return String(parts[1]).toLowerCase();
  }
  return "continue";
}

function shouldStartNvidiaInstallerWizardLoop(live) {
  if (nvidiaInstallerLoopStarted || isNvidiaInstallerWizardLoopRunning) return false;
  var logTail = readNvcleanAutoLogTail(40);
  if (/NVIDIA_INSTALLER_WINDOW_READY=oui/i.test(logTail)) return true;
  live = live || readNvcleanAutoLiveStatus();
  if (/Lancement du programme d'installation NVIDIA|Lancement du programme d installation NVIDIA/i.test(live)) return true;
  if (/\[NVIDIA Installer\] Fenêtre Programme/i.test(live)) return true;
  if (/NVIDIA Setup is running|Setup is running|Programme d'installation NVIDIA/i.test(live)) return true;
  return false;
}

function stopNvidiaInstallerWizardLoop() {
  isNvidiaInstallerWizardLoopRunning = false;
  nvidiaInstallerLoopGen++;
}

function refreshNvidiaDriverOnceAfterInstallerClosed() {
  writeNvcleanAutoLog("ACTION=nvidia_installer_closed_refresh_driver");
  var det = detectInstalledNvidiaDriver({ forceFull: true });
  writeNvcleanAutoLog(
    "POST_INSTALLER_DRIVER installed=" + (det.installed ? "oui" : "non") +
    " ver=" + (det.version || "")
  );
  if (tryCompleteNvcleanInstallOnProcessExit()) return;
  if (det.installed) {
    finishNvcleanInstallSuccess(det);
    return;
  }
  if (nvcInstallProcessSeen && !isNvcleanstallProcessRunning()) {
    completeNvcleanInstallProgressUi("installer_closed");
    return;
  }
  setNvcleanAutoStatus("Installation NVIDIA terminée  validation finale manuelle si demandée.", "info", 100);
  showNvcleanVerifyInstallButton(true);
}

function probeNvidiaInstallerWindowVisible() {
  try {
    initNvcleanAutoPaths();
    var scriptsDir = getAppScriptsDir();
    if (!scriptsDir) return false;
    var helperCs = getAbsolutePathFs(combinePath(scriptsDir, "NvidiaWin32Msaa-helper.cs"));
    if (!helperCs || !getFso().FileExists(helperCs)) return false;
    var escPath = String(helperCs).replace(/'/g, "''");
    var psCmd =
      "Add-Type -Path '" + escPath + "'; " +
      "$h=[NvidiaWin32Msaa]::FindNvidiaInstallerRootHwnd(); " +
      "if ($h -ne [IntPtr]::Zero) { Write-Output 'NVIDIA_INSTALLER_WINDOW_PROBE=FOUND' }";
    var out = runCommandCapture("powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"" + psCmd.replace(/"/g, "\\\"") + "\"");
    return /NVIDIA_INSTALLER_WINDOW_PROBE=FOUND/i.test(String(out || ""));
  } catch (eProbe) {
  }
  return false;
}

function probeNvidiaLicensePageVisible() {
  try {
    initNvcleanAutoPaths();
    var scriptsDir = getAppScriptsDir();
    if (!scriptsDir) return false;
    var helperCs = getAbsolutePathFs(combinePath(scriptsDir, "NvidiaWin32Msaa-helper.cs"));
    if (!helperCs || !getFso().FileExists(helperCs)) return false;
    var escPath = String(helperCs).replace(/'/g, "''");
    var psCmd =
      "Add-Type -Path '" + escPath + "'; " +
      "$h=[NvidiaWin32Msaa]::FindNvidiaInstallerRootHwnd(); " +
      "if ($h -eq [IntPtr]::Zero) { exit 1 }; " +
      "$ok=$false; " +
      "foreach ($c in [NvidiaWin32Msaa]::EnumChildren($h)) { " +
      "  if (-not $c.Visible) { continue }; " +
      "  $n=($c.Text + '').ToLowerInvariant().Replace('&','').Replace('é','e').Replace('è','e'); " +
      "  if ($n -eq 'accepter et continuer' -or $n -eq 'accept and continue' -or $n -eq 'agree and continue') { $ok=$true; break } " +
      "}; " +
      "if ($ok) { Write-Output 'NVIDIA_LICENSE_PROBE=FOUND' }";
    var out = runCommandCapture("powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"" + psCmd.replace(/"/g, "\\\"") + "\"");
    return /NVIDIA_LICENSE_PROBE=FOUND/i.test(String(out || ""));
  } catch (eLic) {}
  return false;
}

function startNvidiaPs1OrchestratorIfNeeded() {
  if (nvidiaElevatedHelperLaunchAttempted) return;
  writeNvcleanAutoLog("[NVIDIA Driver] Lancement orchestrateur PS1...");
  logNvidiaDriverRefresh("Lancement orchestrateur PS1...");
  launchNvidiaInstallerElevatedHelperAsync(function () {});
  if (!isNvidiaInstallerWizardLoopRunning) {
    RunNvidiaInstallerWizardLoopAsync(true);
  }
}

function launchNvidiaInstallerElevatedHelperAsync(onDone) {
  if (nvidiaElevatedHelperLaunchAttempted) {
    if (onDone) onDone({ already: true });
    return;
  }
  nvidiaElevatedHelperLaunchAttempted = true;
  initNvcleanAutoPaths();
  var scriptsDir = getAppScriptsDir();
  var orchPath = scriptsDir ? getAbsolutePathFs(combinePath(scriptsDir, "nvidia-installer-ps1-orchestrator.ps1")) : "";
  if (!orchPath || !getFso().FileExists(orchPath)) {
    writeNvcleanAutoLog("NVIDIA_ORCH_SCRIPT_MISSING=oui");
    if (onDone) onDone({ error: "orchestrator_missing" });
    return;
  }
  writeNvcleanAutoLog("NVIDIA_ORCH_SCRIPT_PATH=" + orchPath);
  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + orchPath + '"' +
    ' -LogPath "' + NVCLEAN_AUTO_LOG_PATH + '"' +
    ' -LiveStatusPath "' + NVCLEAN_AUTO_LIVE_PATH + '"';
  writeNvcleanAutoLog("ACTION=nvidia_ps1_orchestrator_launch");
  try {
    var shell = getShell();
    var exec = shell.Exec(cmd);
    var pid = exec ? exec.ProcessID : 0;
    writeNvcleanAutoLog("[NVIDIA Driver] Orchestrateur PS1 démarré PID=" + pid);
    logNvidiaDriverRefresh("Orchestrateur PS1 démarré PID=" + pid);
  } catch (eLaunch) {
    writeNvcleanAutoLog("NVIDIA_ORCH_LAUNCH_ERROR=" + String(eLaunch.message || eLaunch));
    if (onDone) onDone({ error: "launch_failed" });
    return;
  }
  if (onDone) onDone({ launched: true });
}

function WaitForNvidiaInstallerWindowAndStartOrchestratorAsync() {
  if (nvidiaOrchestratorWatcherStarted) return;
  nvidiaOrchestratorWatcherStarted = true;
  var gen = ++nvidiaOrchestratorWatcherGen;
  var attempts = 0;
  var maxAttempts = 360;

  writeNvcleanAutoLog("[NVIDIA Driver] Attente fenêtre Programme d'installation NVIDIA...");
  logNvidiaDriverRefresh("Attente fenêtre Programme d'installation NVIDIA...");

  function tick() {
    if (gen !== nvidiaOrchestratorWatcherGen) return;
    attempts++;

    if (probeNvidiaInstallerWindowVisible() && probeNvidiaLicensePageVisible()) {
      writeNvcleanAutoLog("[NVIDIA Driver] Fenêtre Programme d'installation NVIDIA détectée");
      logNvidiaDriverRefresh("Fenêtre Programme d'installation NVIDIA détectée");
      startNvidiaPs1OrchestratorIfNeeded();
      return;
    }

    var logTail = readNvcleanAutoLogTail(20);
    if (/NVIDIA_INSTALLER_WINDOW_READY=oui|NVIDIA_INSTALLER_FOUND=oui/i.test(logTail)) {
      if (probeNvidiaLicensePageVisible()) {
        writeNvcleanAutoLog("[NVIDIA Driver] Fenêtre Programme d'installation NVIDIA détectée");
        logNvidiaDriverRefresh("Fenêtre Programme d'installation NVIDIA détectée");
        startNvidiaPs1OrchestratorIfNeeded();
        return;
      }
    }

    if (attempts >= maxAttempts) {
      writeNvcleanAutoLog("[NVIDIA Driver] TIMEOUT attente fenêtre NVIDIA pour orchestrateur");
      logNvidiaDriverRefresh("TIMEOUT attente fenêtre NVIDIA pour orchestrateur");
      return;
    }
    window.setTimeout(tick, 500);
  }

  window.setTimeout(tick, 500);
}

function runNvidiaInstallerWizardTickOnce(onDone) {
  if (nvidiaInstallerTickBusy) {
    if (onDone) onDone({ busy: true, result: "continue" });
    return;
  }
  initNvcleanAutoPaths();
  var scriptsDir = getAppScriptsDir();
  var psPath = scriptsDir ? combinePath(scriptsDir, "nvcleaninstall-auto-uia.ps1") : "";
  if (!psPath || !getFso().FileExists(psPath)) {
    if (onDone) onDone({ error: "uia_missing", result: "continue" });
    return;
  }
  var cmd =
    'powershell.exe -NoProfile -STA -ExecutionPolicy Bypass -File "' + psPath + '"' +
    ' -Phase nvidia-installer-tick' +
    ' -LiveStatusPath "' + NVCLEAN_AUTO_LIVE_PATH + '"' +
    ' -LogPath "' + NVCLEAN_AUTO_LOG_PATH + '"';
  nvidiaInstallerTickBusy = true;
  var exitCode = -1;
  try {
    exitCode = getShell().Run(cmd, 0, true);
  } catch (eRun) {
    writeNvcleanAutoLog("NVIDIA_TICK_RUN_ERROR=" + String(eRun.message || eRun));
  }
  nvidiaInstallerTickBusy = false;
  var result = readNvidiaInstallerTickResultFromLog();
  if (onDone) onDone({ result: result, exitCode: exitCode });
}

function RunNvidiaInstallerWizardLoopAsync(skipLaunch) {
  if (isNvidiaInstallerWizardLoopRunning) return;
  isNvidiaInstallerWizardLoopRunning = true;
  nvidiaInstallerLoopStarted = true;
  var gen = ++nvidiaInstallerLoopGen;
  writeNvcleanAutoLog("ACTION=nvidia_installer_loop_start");
  writeNvcleanAutoLog("[NVIDIA Driver] Installation NVIDIA lancée");
  logNvidiaDriverRefresh("Installation NVIDIA lancée");
  setNvcleanAutoStatus("Installation NVIDIA en cours...", "info", 90);

  if (!skipLaunch && !nvidiaElevatedHelperLaunchAttempted) {
    launchNvidiaInstallerElevatedHelperAsync(function () {});
  }

  function pollLoop() {
    if (gen !== nvidiaInstallerLoopGen) return;
    if (nvcleanInstallUiCompleted) return;
    logNvcWaitFinishIfNeeded();
    if (tryCompleteNvcleanInstallOnProcessExit()) return;
    var tr = readNvidiaInstallerTickResultFromLog();
    if (tr === "finished") {
      stopNvidiaInstallerWizardLoop();
      writeNvcleanAutoLog("ACTION=nvidia_installer_loop_finished");
      logNvcWaitFinishIfNeeded();
      if (tryCompleteNvcleanInstallOnProcessExit()) return;
      setNvcleanAutoStatus("Installation NVIDIA terminée  fermeture NVCleanInstall en attente...", "info", 95);
      window.setTimeout(function () {
        refreshNvidiaDriverOnceAfterInstallerClosed();
        pollLoop();
      }, 2000);
      return;
    }
    if (tr === "manual" || tr === "timeout") {
      stopNvidiaInstallerWizardLoop();
      setNvcleanAutoStatus("Installation NVIDIA  action manuelle requise sur l'installateur.", "warn", 95);
      window.setTimeout(pollLoop, 500);
      return;
    }
    var liveOrch = readNvcleanAutoLiveStatus();
    if (liveOrch && /^NVIDIA\s*:/i.test(liveOrch)) {
      setNvcleanAutoStatus(liveOrch, "info", tr === "installing" || tr === "continue" ? 95 : undefined);
    } else if (tr === "installing" || tr === "continue") {
      setNvcleanAutoStatus("Installation NVIDIA en cours...", "info", 95);
    }
    window.setTimeout(pollLoop, 500);
  }
  pollLoop();
}

function setNvcleanAutoStatus(message, type, progressPct) {
  var el = $("nvcleanAutoStatus");
  if (el) {
    el.style.display = typeof progressPct === "number" ? "none" : (message ? "" : "none");
    if (el.style.display !== "none") {
      el.innerText = message || "";
      el.className = "tool-status" + (type ? " tool-status--" + type : "");
    }
  }
  if (typeof progressPct !== "number") return;
  var kind = "progress";
  if (type === "success") kind = "ok";
  else if (type === "error") kind = "bad";
  setNvMediaAutoStatus(message || "", kind, progressPct);
}

function ensureAutoHotkeyForNvcleanAuto() {
  try {
    var existing = "";
    try {
      existing = findAutoHotkeyExeInstalled();
    } catch (eFind) {
      writeNvcleanAutoLog("[SCRIPT] findAutoHotkey: " + String(eFind.message || eFind));
    }
    if (existing) {
      if (!isAutoHotkeyExecutableV2(existing)) {
        return { ok: false, error: "autohotkey_v1_detected", openPage: true };
      }
      return { ok: true, path: existing };
    }
    var inst = { ok: false, error: "installation_autohotkey_echouee", openPage: true };
    try {
      inst = installAutoHotkeyViaPowerShell();
    } catch (eInst) {
      writeNvcleanAutoLog("[SCRIPT] installAutoHotkey: " + String(eInst.message || eInst));
      inst = { ok: false, error: String(eInst.message || eInst), openPage: true };
    }
    if (inst.ok && inst.path) {
      if (!isAutoHotkeyExecutableV2(inst.path)) {
        return { ok: false, error: "autohotkey_v1_detected", openPage: true };
      }
      return { ok: true, path: inst.path };
    }
    return {
      ok: false,
      error: inst.error || "installation_autohotkey_echouee",
      openPage: inst.openPage !== false
    };
  } catch (eTop) {
    writeNvcleanAutoLog("[SCRIPT] ensureAutoHotkeyForNvcleanAuto: " + String(eTop.message || eTop));
    return { ok: false, error: "autohotkey_access", openPage: true };
  }
}

function ensureNvcleanstallExeForAuto() {
  try {
    try {
      sessionCache.nvcExeLocate = null;
    } catch (eClr) {}
    var nvc = "";
    try {
      nvc = getPreferredNvcleanstallExePath();
    } catch (eGet) {
      writeNvcleanAutoLog("[SCRIPT] getPreferredNvcleanstall: " + String(eGet.message || eGet));
    }
    if (nvc) return { ok: true, path: nvc };
    setNvcleanAutoStatus("NVCleanstall absent, téléchargement...", "info");
    try {
      nvc = downloadNvcleanstallBinaryToPreferredPath(appendNvMediaLog);
      if (nvc && getFso().FileExists(nvc)) return { ok: true, path: nvc };
    } catch (eDl) {
      writeNvcleanAutoLog("DOWNLOAD_ERROR=" + String(eDl.message || eDl));
    }
    try {
      nvc = getPreferredNvcleanstallExePath();
    } catch (eGet2) {
      writeNvcleanAutoLog("[SCRIPT] getPreferredNvcleanstall(retry): " + String(eGet2.message || eGet2));
    }
    if (nvc) return { ok: true, path: nvc };
    return { ok: false, error: "nvcleanstall_missing", openPage: true };
  } catch (eTop) {
    writeNvcleanAutoLog("[SCRIPT] ensureNvcleanstallExeForAuto: " + String(eTop.message || eTop));
    return { ok: false, error: "nvcleanstall_access", openPage: true };
  }
}

function beginNvcleanAutoStatusPoll() {
  var gen = ++nvcleanAutoPollGen;
  var attempts = 0;
  var maxAttempts = 240;
  var lastPct = 0;
  var driverWatchStarted = false;
  function poll() {
    if (gen !== nvcleanAutoPollGen) return;
    logNvcWaitFinishIfNeeded();
    if (tryCompleteNvcleanInstallOnProcessExit()) return;
    attempts++;
    var live = readNvcleanAutoLiveStatus();

    if (!nvidiaInstallerLoopStarted && shouldStartNvidiaInstallerWizardLoop(live)) {
      RunNvidiaInstallerWizardLoopAsync();
    }
    if (isNvidiaInstallerWizardLoopRunning) {
      setNvcleanAutoStatus("Installation NVIDIA en cours...", "info", Math.max(lastPct, 90));
      window.setTimeout(poll, 200);
      return;
    }

    if (!driverWatchStarted && shouldStartNvcleanDriverWatch(live)) {
      driverWatchStarted = true;
      waitForNvidiaDriverInstalledAfterManualConfirmation();
      return;
    }

    if (driverWatchStarted) return;

    var mappedLive = nvcleanProgressFromLiveStatus(live);
    var pct = inferNvcleanInstallProgressPct(live, attempts);
    if (pct === -2) pct = lastPct;
    else if (pct > lastPct) lastPct = pct;
    else pct = lastPct;

    if (attempts >= 6 && attempts % 2 === 0 && lastPct >= 75 && !isNvidiaInstallerWizardLoopRunning) {
      var earlyDet = detectInstalledNvidiaDriver({ forceFull: true });
      if (earlyDet.installed) {
        finishNvcleanInstallSuccess(earlyDet);
        return;
      }
    }

    if (live) {
      if (!nvcleanPackageReadyLogged && /\[NVCleanstall\].*Texte d[eé]tect[eé]|your customi[sz]ed installer is now ready/i.test(live)) {
        nvcleanPackageReadyLogged = true;
        try { appendNvMediaLog("[NVCleanstall] Texte détecté : Your customized installer is now ready."); } catch (ePkgLog) {}
      }
      if (!nvcleanKeyboardActionLogged && /\[NVCleanstall\].*Action clavier|fleche bas puis entree|flèche bas puis entrée/i.test(live)) {
        nvcleanKeyboardActionLogged = true;
        try { appendNvMediaLog("[NVCleanstall] Action clavier envoyée : flèche bas puis entrée."); } catch (eKbLog) {}
      }
      if (mappedLive) {
        setNvcleanAutoStatus(mappedLive.msg, "info", mappedLive.pct);
        lastPct = Math.max(lastPct, mappedLive.pct);
        if (mappedLive.pct >= 95 && !driverWatchStarted) {
          driverWatchStarted = true;
          waitForNvidiaDriverInstalledAfterManualConfirmation();
          return;
        }
      } else if (/Installation terminée|Fenêtre fermée/i.test(live)) {
        setNvcleanAutoStatus("Vérification du pilote installé...", "info", Math.max(pct, 95));
      } else if (/Fenêtre finale détectée|Clic sur Oui/i.test(live)) {
        setNvcleanAutoStatus(live, "info", pct);
      } else if (/Attente de la fenêtre finale/i.test(live)) {
        setNvcleanAutoStatus("Attente de la fenêtre finale...", "info", pct);
      } else if (/Reglages NVIDIA :|WAITING_FOR_TWEAKS|Preparation des fichiers NVIDIA|Preparation NVIDIA en cours/i.test(live)) {
        setNvcleanAutoStatus("Finalisation de l'installation...", "info", pct);
      } else if (/Application des reglages|Application :|Reglages NVIDIA appliques|Reglages partiellement|Installation du pilote lancee|Bouton Install|Clique sur Next|Automatisation annulee/i.test(live)) {
        setNvcleanAutoStatus(live, "info", pct);
      } else if (/Preparation des fichiers NVIDIA|copie les fichiers|preparation NVIDIA/i.test(live)) {
        setNvcleanAutoStatus("Préparation NVCleanInstall...", "info", pct);
      } else if (/Install non lance automatiquement|Impossible de lancer automatiquement Install|Impossible de lancer Install automatiquement/i.test(live)) {
        setNvcleanAutoStatus(live, "error", Math.max(lastPct, 75));
        setNvcleanAutoButtonBusy(false);
        nvcleanAutoBusy = false;
        showNvcleanVerifyInstallButton(true);
        return;
      } else if (/Impossible de lire les options/i.test(live)) {
        setNvcleanAutoStatus(live, "error", lastPct);
      } else if (/bloquée|bloquee/i.test(live) && live.indexOf("Continue") < 0) {
        setNvcleanAutoStatus(live, "error", lastPct);
      } else if (/Installation lancée/i.test(live)) {
        setNvcleanAutoStatus("Installation du pilote en cours...", "info", pct);
      } else {
        setNvcleanAutoStatus(live, "info", pct);
      }
    } else if (attempts > 0) {
      setNvcleanAutoStatus("Installation du pilote en cours...", "info", pct);
    }

    if (/prépare les fichiers NVIDIA/i.test(live) && !nvcleanTweaksBusy) {
      setNvcleanAutoButtonBusy(false);
    }
    if (/bloquée|bloquee/i.test(live) && live.indexOf("Continue") < 0 && attempts > 6) {
      setNvcleanAutoStatus("Automatisation NVCleanstall bloquée. Continue manuellement à partir de cette fenêtre.", "error", lastPct);
      setNvcleanAutoButtonBusy(false);
      nvcleanAutoBusy = false;
      showNvcleanVerifyInstallButton(true);
      return;
    }
    if (attempts >= maxAttempts) {
      var lateDet = detectInstalledNvidiaDriver({ forceFull: true });
      if (lateDet.installed) {
        finishNvcleanInstallSuccess(lateDet);
      } else {
        setNvcleanAutoStatus(
          "Installation non confirmée automatiquement  cliquez sur Vérifier l'installation si le pilote est installé.",
          "info",
          lastPct
        );
        showNvcleanVerifyInstallButton(true);
        setNvcleanAutoButtonBusy(false);
        nvcleanAutoBusy = false;
      }
      return;
    }
    window.setTimeout(poll, 800);
  }
  window.setTimeout(poll, 800);
}

function setNvcleanAutoButtonBusy(busy) {
  var btn = $("btnNvcleaninstallAuto");
  if (btn) btn.disabled = !!busy;
}

function setNvcleanContinueButtonBusy(busy) {
  var btn = $("btnContinueNvidiaTweaks");
  if (btn) btn.disabled = !!busy;
}

function bindContinueNvidiaTweaksButton() {
  var btn = document.getElementById("btnContinueNvidiaTweaks");
  if (!btn) return;
  btn.onclick = continueNvidiaTweaks;
}

function showNvcleanContinuePrompt(show) {
  var panel = $("nvcleanContinuePanel");
  var btn = $("btnContinueNvidiaTweaks");
  nvcleanContinuePromptVisible = !!show;
  if (panel) panel.style.display = show ? "" : "none";
  if (btn) {
    btn.disabled = false;
    bindContinueNvidiaTweaksButton();
  }
  if (show) {
    writeNvcleanAutoLog("PHASE=1");
    writeNvcleanAutoLog("INSTALLATION_TWEAKS_DETECTED=oui");
    writeNvcleanAutoLog("CONTINUE_BUTTON_SHOWN=oui");
    setNvcleanAutoStatus("Page des réglages NVIDIA détectée. Cliquez sur Continuer les réglages NVIDIA.", "info");
  }
}

function getNvcTweaksOnlyScriptPath() {
  var fso = getFso();
  var candidates = [];
  var scriptsDir = getAppScriptsDir();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (scriptsDir) candidates.push(combinePath(scriptsDir, "nvcleaninstall-tweaks-only.ahk"));
  if (app) {
    candidates.push(combinePath(app, "Scripts\\nvcleaninstall-tweaks-only.ahk"));
    candidates.push(combinePath(app, "scripts\\nvcleaninstall-tweaks-only.ahk"));
  }
  var i;
  for (i = 0; i < candidates.length; i++) {
    if (candidates[i] && fso.FileExists(candidates[i])) return candidates[i];
  }
  return "";
}

function cancelNvcleanContinuePrompt() {
  showNvcleanContinuePrompt(false);
  setNvcleanAutoStatus("Reprise automatique annulée. Tu peux continuer manuellement dans NVCleanstall.", "info");
  writeNvcleanAutoLog("TWEAKS_CONTINUE_CANCELLED=oui");
}

function isAutoHotkeyExecutableV2(exePath) {
  if (!exePath || !getFso().FileExists(exePath)) return false;
  var base = String(exePath).toLowerCase();
  if (base.indexOf("autohotkey_v1") >= 0 || /\\v1\\/.test(base)) return false;
  if (/\\autohotkey\.exe$/.test(base) && base.indexOf("v2") < 0 && base.indexOf("64") < 0 && base.indexOf("u64") < 0) {
    return false;
  }
  return true;
}

function validateNvcleanAutoAhkScript(scriptPath) {
  var forbidden = [
    { word: "ControlGetCaption", re: /ControlGetCaption/i },
    { word: "catch name", re: /\bcatch\s+name\b/i },
    { word: "handleFinalExitPopup", re: /handleFinalExitPopup/i },
    { word: "FINAL_EXIT_POPUP", re: /FINAL_EXIT_POPUP/i },
    { word: "FINAL_YES", re: /\bFINAL_YES\b/i },
    { word: "final-exit-popup", re: /final-exit-popup/i },
    { word: "#Include final-exit", re: /#Include\s+final-exit/i }
  ];
  var v1CommandLines = [
    { word: "SetTitleMatchMode_v1", re: /^\s*SetTitleMatchMode\s*,/m },
    { word: "WinWait_v1", re: /^\s*WinWait\s*,/m },
    { word: "WinActivate_v1", re: /^\s*WinActivate\s*,/m },
    { word: "WinWaitActive_v1", re: /^\s*WinWaitActive\s*,/m },
    { word: "Send_v1", re: /^\s*Send\s*,/m },
    { word: "SendInput_v1", re: /^\s*SendInput\s*,/m },
    { word: "ControlSend_v1", re: /^\s*ControlSend\s*,/m },
    { word: "ControlClick_v1", re: /^\s*ControlClick\s*,/m },
    { word: "IfWinExist", re: /^\s*IfWinExist\b/m },
    { word: "var_v1", re: /^\s*var\s+[A-Za-z_]+\s*:=/m }
  ];
  var fso = getFso();
  if (!scriptPath || !fso.FileExists(scriptPath)) {
    return { ok: false, word: "file_missing", detail: "" };
  }
  var content = readTextFileAll(scriptPath);
  if (!content) {
    return { ok: false, word: "empty", detail: "" };
  }
  if (!/#Requires\s+AutoHotkey\s+v2/i.test(content)) {
    return { ok: false, word: "missing_v2_requires", detail: "#Requires AutoHotkey v2.0" };
  }
  if (/#Requires\s+AutoHotkey\s+v1/i.test(content)) {
    return { ok: false, word: "ahk_v1_requires", detail: "" };
  }
  var i;
  for (i = 0; i < forbidden.length; i++) {
    if (forbidden[i].re.test(content)) {
      return { ok: false, word: forbidden[i].word, detail: "" };
    }
  }
  for (i = 0; i < v1CommandLines.length; i++) {
    if (v1CommandLines[i].re.test(content)) {
      return { ok: false, word: v1CommandLines[i].word, detail: "" };
    }
  }
  var tweaksPath = combinePath(fso.GetParentFolderName(scriptPath), "nvcleaninstall-tweaks-page.ahk");
  if (fso.FileExists(tweaksPath)) {
    var tweaksContent = readTextFileAll(tweaksPath);
    if (tweaksContent && /#Include/i.test(content) && /nvcleaninstall-tweaks-page/i.test(content)) {
      for (i = 0; i < forbidden.length; i++) {
        if (forbidden[i].re.test(tweaksContent)) {
          return { ok: false, word: forbidden[i].word, detail: "tweaks-page" };
        }
      }
    }
  }
  return { ok: true, word: "", detail: "" };
}

function launchNvcleaninstallAutoRunImpl() {
  try {
    initNvcleanAutoPaths();
  } catch (eInit) {
    writeNvcleanAutoLog("[SCRIPT] initNvcleanAutoPaths: " + String(eInit.message || eInit));
  }
  try {
    clearNvcleanAutoLiveFile();
  } catch (eClr) {
    writeNvcleanAutoLog("[SCRIPT] clearNvcleanAutoLiveFile: " + String(eClr.message || eClr));
  }
  nvcleanPackageReadyLogged = false;
  nvcleanKeyboardActionLogged = false;
  nvidiaInstallerLoopStarted = false;
  nvidiaElevatedHelperLaunchAttempted = false;
  nvidiaOrchestratorWatcherStarted = false;
  nvidiaOrchestratorWatcherGen++;
  nvcInstallProcessSeen = false;
  nvcleanInstallUiCompleted = false;
  nvcWaitFinishLogged = false;
  stopNvidiaInstallerWizardLoop();
  writeNvcleanAutoLog("DATE=" + new Date().toISOString());
  writeNvcleanAutoLog("ACTION=nvcleaninstall_auto_start");
  driversWorkflowState.installError = false;
  sessionCache.gpuDriverUpdate = null;
  setNvcleanAutoStatus("Installation du pilote en cours...", "info", 0);

  var gpu = detectGpuForDriverInstall({ skipLog: true });
  if (!gpu.hasNvidia && !gpu.installAllowed) {
    gpu = detectGpuForDriverInstall({});
  }
  if (!gpu.hasNvidia) {
    writeNvcleanAutoLog("INSTALL_ALLOWED=non");
    writeNvcleanAutoLog("ERROR=nvidia_gpu_not_detected");
    setNvcleanAutoStatus("GPU NVIDIA non détecté. Nettoyage DDU ou choix manuel requis.", "error", 10);
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }
  setNvcleanAutoStatus("Recherche du pilote...", "info", 10);

  var nvc = ensureNvcleanstallExeForAuto();
  if (!nvc.ok || !nvc.path) {
    writeNvcleanAutoLog("NVCLEANSTALL_PATH=");
    writeNvcleanAutoLog("ERROR=" + (nvc.error || "nvc_missing"));
    if (nvc.openPage) {
      setNvcleanAutoStatus("NVCleanstall introuvable. Ouverture de la page officielle...", "info");
      openNvcleanstallOfficialDownloadPage();
      setNvcleanAutoStatus("Télécharge NVCleanstall, puis relance l'installation auto.", "error");
    } else {
      setNvcleanAutoStatus("NVCleanstall introuvable.", "error");
    }
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }
  setNvcleanAutoStatus("Téléchargement / préparation...", "info", 25);

  writeNvcleanAutoLog("NVCLEANSTALL_PATH=" + nvc.path);

  var ahk = ensureAutoHotkeyForNvcleanAuto();
  if (!ahk.ok || !ahk.path) {
    writeNvcleanAutoLog("ERROR=" + (ahk.error || "autohotkey_missing"));
    if (ahk.error === "autohotkey_v1_detected") {
      setNvcleanAutoStatus("AutoHotkey v2 requis  version 1 détectée.", "error", 25);
    } else if (ahk.openPage) {
      setNvcleanAutoStatus("AutoHotkey v2 requis  téléchargement en cours...", "info", 25);
    } else {
      setNvcleanAutoStatus("AutoHotkey v2 introuvable.", "error", 25);
    }
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }

  var scriptsDir = getAppScriptsDir();
  var ahkScript = scriptsDir ? combinePath(scriptsDir, "nvcleaninstall-auto.ahk") : "";
  if (!ahkScript || !getFso().FileExists(ahkScript)) {
    writeNvcleanAutoLog("ERROR=ahk_script_missing");
    writeNvcleanAutoLog("SCRIPT_SYNTAX_CHECK=erreur");
    writeNvcleanAutoLog("STARTED=non");
    setNvcleanAutoStatus("Script nvcleaninstall-auto.ahk introuvable.", "error");
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }

  var syntaxCheck = validateNvcleanAutoAhkScript(ahkScript);
  writeNvcleanAutoLog("AHK_VERSION_MODE=v2");
  writeNvcleanAutoLog("SCRIPT_PATH=" + ahkScript);
  writeNvcleanAutoLog("SYNTAX_CHECK=" + (syntaxCheck.ok ? "ok" : "error"));
  if (!syntaxCheck.ok) {
    writeNvcleanAutoLog("ERROR_MESSAGE=" + syntaxCheck.word);
    writeNvcleanAutoLog("FORBIDDEN_WORD_FOUND=" + syntaxCheck.word);
    writeNvcleanAutoLog("STARTED=non");
    writeNvcleanAutoLog("ERROR=forbidden_ahk_syntax");
    if (syntaxCheck.word === "missing_v2_requires") {
      setNvcleanAutoStatus("Script NVCleanstall invalide : #Requires AutoHotkey v2.0 manquant.", "error", 25);
    } else if (/^WinWait_v1|Send_v1|ControlSend_v1|SetTitleMatchMode_v1/i.test(syntaxCheck.word)) {
      setNvcleanAutoStatus("Script NVCleanstall invalide : syntaxe AutoHotkey v1 detectee.", "error", 25);
    } else {
      setNvcleanAutoStatus("Script NVCleanstall invalide : " + syntaxCheck.word + ".", "error", 25);
    }
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }

  setNvcleanAutoStatus("Script NVCleanstall AutoHotkey v2 prêt", "info", 25);
  try {
    writeNvcleanAutoLiveStatus("[NVCleanInstall] AutoHotkey v2 script genere");
  } catch (eLiveGen) {}

  writeNvcleanAutoLog("AHK_PATH=" + ahk.path);
  writeNvcleanAutoLog("AHK_SCRIPT=" + ahkScript);

  setNvcleanAutoStatus("Ouverture de NVCleanstall...", "info", 45);
  var launchRes = launchNvcleanstallExeElevated(nvc.path, function (m) { writeNvcleanAutoLog(String(m)); });
  if (launchRes !== "ok") {
    writeNvcleanAutoLog("ERROR=nvc_launch_" + launchRes);
    if (launchRes === "uac_cancel") {
      setNvcleanAutoStatus("Ouverture annulée (UAC).", "error");
    } else {
      setNvcleanAutoStatus("Erreur ouverture NVCleanstall.", "error");
    }
    setNvcleanAutoButtonBusy(false);
    nvcleanAutoBusy = false;
    return;
  }
  nvcInstallProcessSeen = isNvcleanstallProcessRunning();

  var appRoot = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  window.setTimeout(function () {
    setNvcleanAutoStatus("Installation en cours...", "info", 65);
    var args = "\"" + ahkScript + "\" \"" + appRoot + "\"";
    try {
      launchFileAsAdminWithArgs(ahk.path, args);
      writeNvcleanAutoLog("SCRIPT_LAUNCHED=oui");
      writeNvcleanAutoLog("[NVIDIA Driver] NVCleanInstall lancé");
      logNvidiaDriverRefresh("NVCleanInstall lancé");
      writeNvcleanAutoLog("PHASE=1_DRIVER_AND_COMPONENTS");
      beginNvcleanAutoStatusPoll();
      WaitForNvidiaInstallerWindowAndStartOrchestratorAsync();
    } catch (eAhk) {
      writeNvcleanAutoLog("SCRIPT_LAUNCHED=non");
      writeNvcleanAutoLog("ERROR=" + String(eAhk.message || eAhk));
      setNvcleanAutoStatus("Automatisation NVCleanstall bloquée. Continue manuellement.", "error");
      setNvcleanAutoButtonBusy(false);
      nvcleanAutoBusy = false;
    }
  }, 500);
}

function continueNvidiaTweaks() {
  setNvcleanAutoStatus("Automatisation NVIDIA temporairement desactivee.", "info");
}

function launchNvcleaninstallTweaksOnly() {
  continueNvidiaTweaks();
}

function launchNvcleaninstallAutoExperimental() {
  if (nvcleanAutoBusy || nvcleanTweaksBusy) return;
  nvcleanAutoPollGen++;
  stopNvcleanDriverWatchPoll();
  showNvcleanVerifyInstallButton(false);
  nvcleanAutoBusy = true;
  setNvcleanAutoButtonBusy(true);
  driversWorkflowState.installDone = false;
  driversWorkflowState.installError = false;
  sessionCache.gpuDriverUpdate = null;
  setNvcleanAutoStatus("Installation du pilote en cours...", "info", 0);
  window.setTimeout(function () {
    try {
      launchNvcleaninstallAutoRunImpl();
    } catch (eRun) {
      writeNvcleanAutoLog("ERROR=" + String(eRun.message || eRun));
      setNvcleanAutoStatus("Erreur : " + String(eRun.message || eRun), "error");
      setNvcleanAutoButtonBusy(false);
      nvcleanAutoBusy = false;
    }
  }, 10);
}

var NVIDIA_PERFORMANCE_PROFILE_FILE = "NvidiaPerformanceProfile.nip";
var NVIDIA_FPS_LATENCY_PROFILE_FILE = "Unreal_NVIDIA_FPS_Latence_Global.nip";
var NVIDIA_DEFAULT_RESET_PROFILE_FILE = "NVIDIA_Default_Reset.nip";
var NVIDIA_BACKUP_BEFORE_UNREAL_FILE = "Backup_Before_Unreal_Profile.nip";
var NVIDIA_PROFILE_INSPECTOR_EXE_NAME = "nvidiaProfileInspector.exe";
var NVIDIA_PROFILE_INSPECTOR_BUNDLE_ZIPS = [
  "nvidiaProfileInspector.zip",
  "ProfileInspector.zip"
];
/** Réglages 3D du profil Unreal   utilisés pour confirmer qu'un reset a réellement changé l'état. */
var NVIDIA_RESET_WATCH_IDS = ["274197361", "277041152", "11041231"];
var NVIDIA_NIP_MIN_BYTES = 1024;
var NVIDIA_FULL_WARZONE_NIP_FILE = "Unreal_Warzone_Performance.nip";
var NVIDIA_FULL_IMPORT_TIMEOUT_MS = 60000;

function logNvidiaPanelDev(message) {
  var line = "[NVIDIA Panel] " + String(message || "");
  try { log(line); } catch (eL) {}
  try { appendFileLogLine(line); } catch (eF) {}
}

function getNvidiaToolsDir() {
  var app = getAppFolderFromHta();
  if (app) return app + "\\tools\\NVIDIA";
  var loc = getLocalUnrealDir();
  if (loc) return loc + "\\Tools\\NVIDIA";
  return "";
}

function getNvidiaProfileInspectorDir() {
  var base = getNvidiaToolsDir();
  if (!base) return "";
  return base + "\\ProfileInspector";
}

function getNvidiaPanelToolsDir() {
  return getNvidiaProfileInspectorDir();
}

function getNvidiaProfilesDir() {
  var base = getNvidiaToolsDir();
  if (!base) return "";
  return base + "\\Profiles";
}

function getNvidiaBackupDir() {
  var base = getNvidiaToolsDir();
  if (!base) return "";
  return base + "\\Backups";
}

function getNvidiaFpsLatencyProfilePath() {
  var dir = getNvidiaProfilesDir();
  if (!dir) return "";
  return getAbsolutePathFs(dir + "\\" + NVIDIA_FPS_LATENCY_PROFILE_FILE);
}

function getNvidiaDefaultResetProfilePath() {
  var dir = getNvidiaProfilesDir();
  if (!dir) return "";
  return getAbsolutePathFs(dir + "\\" + NVIDIA_DEFAULT_RESET_PROFILE_FILE);
}

function getNvidiaBackupBeforeUnrealPath() {
  var dir = getNvidiaBackupDir();
  if (!dir) return "";
  return getAbsolutePathFs(dir + "\\" + NVIDIA_BACKUP_BEFORE_UNREAL_FILE);
}

function resolveNvidiaResetProfilePath() {
  var base = getNvidiaToolsDir();
  var backup = getNvidiaBackupBeforeUnrealPath();
  if (backup && !fileExists(backup) && base) {
    backup = findNvidiaFileRecursive(base, NVIDIA_BACKUP_BEFORE_UNREAL_FILE, 0) || backup;
  }
  if (backup && fileExists(backup)) return { path: backup, source: "backup" };
  var def = getNvidiaDefaultResetProfilePath();
  if (def && !fileExists(def) && base) {
    def = findNvidiaFileRecursive(base, NVIDIA_DEFAULT_RESET_PROFILE_FILE, 0) || def;
  }
  if (def && fileExists(def)) return { path: def, source: "default" };
  return { path: "", source: "" };
}

function sleepMs(ms) {
  var n = parseInt(ms, 10);
  if (isNaN(n) || n < 0) n = 0;
  var end = new Date().getTime() + n;
  while (new Date().getTime() < end) {}
}

function countNvidiaNipProfileSettings(filePath) {
  var txt = readTextFileAll(filePath);
  var c = 0;
  if (txt) {
    var re = /<ProfileSetting>/gi;
    var m;
    while ((m = re.exec(txt)) !== null) c++;
    if (c > 0) return c;
    re = /ProfileSetting/gi;
    while ((m = re.exec(txt)) !== null) c++;
    if (c > 0) return c;
  }
  try {
    var out = runCommandCapture("findstr /C:\"<ProfileSetting>\" \"" + String(filePath).replace(/"/g, "") + "\"");
    if (out) {
      var lines = String(out).split(/\r?\n/);
      var i;
      for (i = 0; i < lines.length; i++) {
        if (lines[i] && lines[i].indexOf("ProfileSetting") >= 0) c++;
      }
    }
  } catch (eF) {}
  return c;
}

function parseNvidiaNipSettingMap(filePath) {
  var map = {};
  var txt = readTextFileAll(filePath);
  if (!txt) return map;
  var re = /<SettingID>(\d+)<\/SettingID>[\s\S]*?<SettingValue>([^<]*)<\/SettingValue>/gi;
  var m;
  while ((m = re.exec(txt)) !== null) {
    map[m[1]] = String(m[2]);
  }
  return map;
}

function validateNvidiaNipFile(filePath) {
  var info = { valid: false, size: 0, modified: "", settingCount: 0, reason: "" };
  try {
    var fso = getFso();
    if (!filePath || !fso.FileExists(filePath)) {
      info.reason = "fichier absent";
      return info;
    }
    var f = fso.GetFile(filePath);
    info.size = f.Size;
    try {
      info.modified = new Date(f.DateLastModified).toLocaleString();
    } catch (eDt) {
      info.modified = String(f.DateLastModified || "");
    }
    info.settingCount = countNvidiaNipProfileSettings(filePath);
    var txt = readTextFileAll(filePath);
    if (info.size < NVIDIA_NIP_MIN_BYTES) {
      info.reason = "taille < " + NVIDIA_NIP_MIN_BYTES + " octets";
      return info;
    }
    if (!txt || txt.indexOf("<ArrayOfProfile") < 0) {
      info.reason = "format .nip invalide";
      return info;
    }
    if (info.settingCount < 1) {
      info.reason = "aucun réglage NVIDIA (ProfileSetting vide)";
      return info;
    }
    info.valid = true;
    return info;
  } catch (eV) {
    info.reason = String(eV.message || eV);
    return info;
  }
}

function logNvidiaNipFileInfo(label, filePath) {
  var v = validateNvidiaNipFile(filePath);
  logNvidiaPanelDev(label + " : " + (filePath || "(vide)") + " | taille=" + v.size + " | réglages=" + v.settingCount + " | modif=" + (v.modified || "?") + " | valide=" + (v.valid ? "oui" : "non (" + v.reason + ")"));
  return v;
}

function resolveNvidiaResetProfileForApply() {
  var base = getNvidiaToolsDir();
  var backup = getNvidiaBackupBeforeUnrealPath();
  if (base && (!backup || !fileExists(backup))) {
    backup = findNvidiaFileRecursive(base, NVIDIA_BACKUP_BEFORE_UNREAL_FILE, 0) || backup;
  }
  if (backup && fileExists(backup)) {
    var vb = validateNvidiaNipFile(backup);
    if (vb.valid) return { path: backup, source: "backup", validation: vb };
    logNvidiaPanelDev("Backup présent mais invalide : " + vb.reason);
  }
  var def = getNvidiaDefaultResetProfilePath();
  if (base && (!def || !fileExists(def))) {
    def = findNvidiaFileRecursive(base, NVIDIA_DEFAULT_RESET_PROFILE_FILE, 0) || def;
  }
  if (def && fileExists(def)) {
    var vd = validateNvidiaNipFile(def);
    if (vd.valid) return { path: def, source: "default", validation: vd };
    return { path: def, source: "default", validation: vd, invalid: true };
  }
  return { path: "", source: "", validation: null };
}

function getExpectedNvidiaProfileInspectorExePath() {
  var dir = getNvidiaProfileInspectorDir();
  if (!dir) return "";
  return getAbsolutePathFs(dir + "\\" + NVIDIA_PROFILE_INSPECTOR_EXE_NAME);
}

function isNvidiaProfileInspectorExeName(fileName) {
  var n = String(fileName || "");
  if (!/\.exe$/i.test(n)) return false;
  if (/^nvidiaProfileInspector\.exe$/i.test(n)) return true;
  if (/^NvidiaProfileInspector\.exe$/i.test(n)) return true;
  if (/^nvidiaProfileInspectorDmW\.exe$/i.test(n)) return true;
  if (/ProfileInspector/i.test(n)) return true;
  if (/nvidiaProfile/i.test(n)) return true;
  return false;
}

function findNvidiaProfileInspectorExe(dir, depth) {
  var fso = getFso();
  if (!dir || !fso.FolderExists(dir)) return "";
  if (typeof depth !== "number") depth = 0;
  if (depth > 4) return "";
  var expected = dir + "\\" + NVIDIA_PROFILE_INSPECTOR_EXE_NAME;
  if (fso.FileExists(expected)) return getAbsolutePathFs(expected);
  try {
    var folder = fso.GetFolder(dir);
    var ef = new Enumerator(folder.Files);
    for (; !ef.atEnd(); ef.moveNext()) {
      var file = ef.item();
      var n = String(file.Name || "");
      if (isNvidiaProfileInspectorExeName(n)) {
        return getAbsolutePathFs(String(file.Path || ""));
      }
    }
    if (depth < 4) {
      var es = new Enumerator(folder.SubFolders);
      for (; !es.atEnd(); es.moveNext()) {
        var sub = es.item();
        var found = findNvidiaProfileInspectorExe(String(sub.Path || ""), depth + 1);
        if (found) return found;
      }
    }
  } catch (e) {}
  return "";
}

function getNvidiaProfileInspectorSearchRoots() {
  var roots = [], seen = {}, app, sh, i;
  function add(p) {
    if (!p) return;
    var a = getAbsolutePathFs(p);
    if (!a || seen[a]) return;
    seen[a] = true;
    roots.push(a);
  }
  add(getExpectedNvidiaProfileInspectorExePath());
  add(getNvidiaProfileInspectorDir());
  add(getNvidiaToolsDir());
  app = getAppFolderFromHta();
  if (app) {
    add(app);
    add(app + "\\tools");
    add(app + "\\Tools");
    add(app + "\\tools\\NvidiaProfileInspector");
    add(app + "\\tools\\NVIDIAProfileInspector");
    add(app + "\\Tools\\NVIDIA\\ProfileInspector");
    add(app + "\\config");
  }
  try {
    sh = getShell();
    add(sh.SpecialFolders("Desktop"));
    add(sh.ExpandEnvironmentStrings("%USERPROFILE%\\Desktop"));
    add(sh.ExpandEnvironmentStrings("%USERPROFILE%\\Downloads"));
  } catch (eSh) {}
  return roots;
}

function resolveNvidiaProfileInspectorExe() {
  var roots = getNvidiaProfileInspectorSearchRoots();
  var i;
  for (i = 0; i < roots.length; i++) {
    var r = roots[i];
    if (/\.exe$/i.test(r) && fileExists(r) && isNvidiaProfileInspectorExeName(r.split("\\").pop())) {
      return getAbsolutePathFs(r);
    }
    var found = findNvidiaProfileInspectorExe(r, 0);
    if (found) return found;
  }
  return "";
}

function findNvidiaFileRecursive(rootDir, fileName, depth) {
  var fso = getFso();
  if (!rootDir || !fileName || !fso.FolderExists(rootDir)) return "";
  if (typeof depth !== "number") depth = 0;
  if (depth > 6) return "";
  var direct = getAbsolutePathFs(rootDir + "\\" + fileName);
  if (fso.FileExists(direct)) return direct;
  try {
    var folder = fso.GetFolder(rootDir);
    var es = new Enumerator(folder.SubFolders);
    for (; !es.atEnd(); es.moveNext()) {
      var sub = es.item();
      var hit = findNvidiaFileRecursive(String(sub.Path || ""), fileName, depth + 1);
      if (hit) return hit;
    }
  } catch (eR) {}
  return "";
}

function resolveNvidiaPerformanceProfilePath() {
  var fso = getFso();
  var candidates = [], i, app = getAppFolderFromHta();
  if (app) {
    candidates.push(app + "\\config\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
    candidates.push(app + "\\PurpleBoost\\config\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
    candidates.push(app + "\\tools\\NvidiaProfileInspector\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
    candidates.push(app + "\\tools\\NVIDIAProfileInspector\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
    candidates.push(app + "\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
  }
  var piDir = getNvidiaProfileInspectorDir();
  if (piDir) candidates.push(piDir + "\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
  var profilesDir = getNvidiaProfilesDir();
  if (profilesDir) candidates.push(profilesDir + "\\" + NVIDIA_PERFORMANCE_PROFILE_FILE);
  for (i = 0; i < candidates.length; i++) {
    if (candidates[i] && fso.FileExists(candidates[i])) {
      return getAbsolutePathFs(candidates[i]);
    }
  }
  var base = getNvidiaToolsDir();
  if (base) {
    var found = findNvidiaFileRecursive(base, NVIDIA_PERFORMANCE_PROFILE_FILE, 0);
    if (found) return found;
  }
  var legacy = getNvidiaFpsLatencyProfilePath();
  if (legacy && fileExists(legacy)) return legacy;
  if (base) {
    found = findNvidiaFileRecursive(base, NVIDIA_FPS_LATENCY_PROFILE_FILE, 0);
    if (found) return found;
  }
  return "";
}

function resolveNvidiaFpsLatencyProfilePath() {
  return resolveNvidiaPerformanceProfilePath();
}

function extractZipArchiveToFolder(archivePath, destDir) {
  var escA = archivePath.replace(/'/g, "''");
  var escD = destDir.replace(/'/g, "''");
  if (/\.zip$/i.test(archivePath)) {
    getShell().Run(
      "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Expand-Archive -LiteralPath '" + escA + "' -DestinationPath '" + escD + "' -Force\"",
      0,
      true
    );
    return;
  }
  if (/\.7z$/i.test(archivePath)) {
    getShell().Run(
      "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"tar -xf '" + escA + "' -C '" + escD + "'\"",
      0,
      true
    );
  }
}

function extractNvidiaProfileInspectorBundleZip(zipPath, destDir) {
  if (!zipPath || !destDir) return false;
  var fso = getFso();
  if (!fso.FileExists(zipPath)) return false;
  try {
    extractZipArchiveToFolder(zipPath, destDir);
    logNvidiaPanelDev("Archive embarquée extraite : " + zipPath);
    return true;
  } catch (eEx) {
    logNvidiaPanelDev("échec extraction archive : " + zipPath + " - " + String(eEx.message || eEx));
    return false;
  }
}

/** Déploie nvidiaProfileInspector.exe depuis le zip embarqué (aucune action utilisateur). */
function ensureBundledNvidiaProfileInspector() {
  var existing = resolveNvidiaProfileInspectorExe();
  if (existing) return existing;

  var dir = getNvidiaProfileInspectorDir();
  if (!dir || !createFolder(dir)) return "";

  var fso = getFso();
  var i, zipPath, base = getNvidiaToolsDir();
  for (i = 0; i < NVIDIA_PROFILE_INSPECTOR_BUNDLE_ZIPS.length; i++) {
    zipPath = dir + "\\" + NVIDIA_PROFILE_INSPECTOR_BUNDLE_ZIPS[i];
    if (fso.FileExists(zipPath)) extractNvidiaProfileInspectorBundleZip(zipPath, dir);
  }
  if (base && base !== dir) {
    for (i = 0; i < NVIDIA_PROFILE_INSPECTOR_BUNDLE_ZIPS.length; i++) {
      zipPath = base + "\\" + NVIDIA_PROFILE_INSPECTOR_BUNDLE_ZIPS[i];
      if (fso.FileExists(zipPath)) extractNvidiaProfileInspectorBundleZip(zipPath, dir);
    }
  }

  existing = resolveNvidiaProfileInspectorExe();
  if (existing) return existing;

  var legacy = getAppFolderFromHta();
  if (legacy) {
    legacy = legacy + "\\tools\\NVIDIAProfileInspector";
    var legacyExe = findNvidiaProfileInspectorExe(legacy, 0);
    if (legacyExe && fso.FileExists(legacyExe)) {
      try {
        var destExe = getExpectedNvidiaProfileInspectorExePath();
        if (destExe) {
          fso.CopyFile(legacyExe, destExe, true);
          logNvidiaPanelDev("Migration outil interne depuis ancien dossier : " + legacyExe);
          return resolveNvidiaProfileInspectorExe();
        }
      } catch (eCp) {
        logNvidiaPanelDev("échec migration outil interne : " + String(eCp.message || eCp));
      }
    }
  }
  return "";
}

function mapNvidiaCliExitCode(code, context) {
  var c = parseInt(code, 10);
  if (isNaN(c)) c = -1;
  var ctx = String(context || "import");
  if (c === 0) {
    if (ctx === "reset") return { ok: false, status: "", detail: "code 0   vérification post-reset requise" };
    if (ctx === "export") return { ok: true, status: "", detail: "export silencieux réussi" };
    return { ok: true, status: "Profil 3D NVIDIA appliqué.", detail: "import silencieux réussi" };
  }
  if (c === 16) {
    return { ok: false, status: "Erreur : outil NVIDIA interne manquant", detail: "nvidiaProfileInspector.exe absent" };
  }
  if (c === 17) {
    if (ctx === "reset") return { ok: false, status: "Erreur : aucun profil de reset NVIDIA disponible. Réinstallez Purple Boost.", detail: "fichier .nip reset/backup absent" };
    return { ok: false, status: "Erreur : profil NVIDIA FPS / Latence manquant", detail: "fichier .nip profil Unreal absent" };
  }
  if (c === 18 || c === 1223 || c === 5) {
    return { ok: false, status: "Erreur : droits administrateur requis", detail: "élévation refusée (code " + c + ")" };
  }
  if (ctx === "reset") return { ok: false, status: "Erreur : reset NVIDIA impossible", detail: "code de sortie " + c };
  return { ok: false, status: "Erreur : application du profil NVIDIA impossible", detail: "code de sortie " + c };
}

function mapNvidiaImportExitCode(code) {
  return mapNvidiaCliExitCode(code, "import");
}

function mapNvidiaResetExitCode(code) {
  return mapNvidiaCliExitCode(code, "reset");
}

function mapNvidiaImportProcessResult(res) {
  if (!res) return { ok: false, status: "Erreur : application du profil NVIDIA impossible", detail: "résultat processus vide" };
  var code = parseInt(res.exitCode, 10);
  if (isNaN(code)) code = -1;
  return mapNvidiaImportExitCode(code);
}

function setNvidiaPanelStatus(text, kind) {
  var el = $("nvidiaGamingStatus") || $("nvidiaPanelStatus");
  if (!el) return;
  var cls = "tcp-badge";
  if (kind === "ok") cls += " tcp-badge--ok";
  else if (kind === "progress") cls += " tcp-badge--progress";
  else if (kind === "warn") cls += " tcp-badge--progress";
  else cls += " tcp-badge--bad";
  el.className = cls;
  el.style.whiteSpace = "pre-line";
  el.innerText = text || "Prêt";
}

function openNvidiaProfileInspectorWithNip(inspectorExe, profilePath) {
  if (!inspectorExe || !profilePath || !fileExists(inspectorExe) || !fileExists(profilePath)) return false;
  try {
    getShell().Run('"' + inspectorExe + '" "' + profilePath + '"', 1, false);
    return true;
  } catch (eOpen) {
    logNvidiaPanelDev("Ouverture NPI + .nip : " + String(eOpen.message || eOpen));
    return false;
  }
}

function getNvidiaProfileLogPath() {
  var app = getAppFolderFromHta();
  var path = app ? getAbsolutePathFs(app + "\\logs\\nvidia-profile.log") : (UNREAL_LOGS + "\\nvidia-profile.log");
  try {
    var fso = getFso();
    var dir = fso.GetParentFolderName(path);
    if (dir && !fso.FolderExists(dir)) fso.CreateFolder(dir);
  } catch (eMk) {}
  return path;
}

function appendNvidiaProfileLogLine(line) {
  var path = getNvidiaProfileLogPath();
  try {
    var fso = getFso();
    var stream = fso.OpenTextFile(path, 8, true);
    stream.WriteLine(String(line || ""));
    stream.Close();
  } catch (eW) {
    try { appendFileLogLine("[nvidia-profile] " + line); } catch (e2) {}
  }
}

/**
 * Import silencieux .nip (arrière-plan)  appelé uniquement par ApplyNipProfile.
 * nvidiaProfileInspector.exe -silent -silentImport  fenêtre masquée, jamais affichée.
 */
function importNvidiaProfileNipElevated(inspectorExe, profilePath) {
  var nip = getAbsolutePathFs(profilePath || "");
  if (!nip || !fileExists(nip)) return { exitCode: 17, durationMs: 0, cmdLine: "", error: "nip absent" };
  if (!inspectorExe || !fileExists(inspectorExe)) return { exitCode: 16, durationMs: 0, cmdLine: "", error: "inspector absent" };

  createUnrealFolders();
  var fso = getFso();
  var psPath = UNREAL_LOGS + "\\nvidia-nip-import.ps1";
  var elevInnerPath = UNREAL_LOGS + "\\nvidia-nip-import-elev-inner.ps1";
  var resultPath = UNREAL_LOGS + "\\nvidia-nip-import-result.json";
  var escInspector = String(inspectorExe).replace(/'/g, "''");
  var escProfile = String(nip).replace(/'/g, "''");
  var escResult = String(resultPath).replace(/'/g, "''");
  var escElevInner = String(elevInnerPath).replace(/'/g, "''");
  var elevInnerLines = [
    "$ErrorActionPreference = 'Stop'",
    "$Inspector = '" + escInspector + "'",
    "$Profile = '" + escProfile + "'",
    "$wd = Split-Path -Parent $Inspector",
    "$argsLine = '-silent -silentImport \"' + $Profile + '\"'",
    "Add-Type @'",
    "using System; using System.Runtime.InteropServices;",
    "public class NpiWinHide {",
    "  [DllImport(\"user32.dll\")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);",
    "}",
    "'@ -ErrorAction SilentlyContinue",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Inspector",
    "$psi.Arguments = $argsLine",
    "$psi.WorkingDirectory = $wd",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if (-not $p) { exit 18 }",
    "for ($i = 0; $i -lt 50; $i++) {",
    "  Start-Sleep -Milliseconds 80",
    "  try { $p.Refresh() } catch {}",
    "  if ($p.MainWindowHandle -ne [IntPtr]::Zero) { [void][NpiWinHide]::ShowWindow($p.MainWindowHandle, 0); break }",
    "}",
    "$null = $p.WaitForExit()",
    "exit $p.ExitCode"
  ];
  var elevTw = fso.CreateTextFile(elevInnerPath, true);
  elevTw.Write(elevInnerLines.join("\r\n"));
  elevTw.Close();
  var lines = [
    "$ErrorActionPreference = 'Stop'",
    "$Inspector = '" + escInspector + "'",
    "$Profile = '" + escProfile + "'",
    "$ResultPath = '" + escResult + "'",
    "$ElevInner = '" + escElevInner + "'",
    "if (-not (Test-Path -LiteralPath $Inspector)) { exit 16 }",
    "if (-not (Test-Path -LiteralPath $Profile)) { exit 17 }",
    "$wd = Split-Path -Parent $Inspector",
    "$argsLine = '-silent -silentImport \"' + $Profile + '\"'",
    "$cmdLine = $Inspector + ' ' + $argsLine",
    "Set-Content -LiteralPath ($env:TEMP + '\\purpleboost-nvidia-cli-last.txt') -Value $cmdLine -Encoding UTF8",
    "$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
    "$sw = [System.Diagnostics.Stopwatch]::StartNew()",
    "$exitCode = -1",
    "$errMsg = ''",
    "Add-Type @'",
    "using System; using System.Runtime.InteropServices;",
    "public class NpiWinHide {",
    "  [DllImport(\"user32.dll\")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);",
    "}",
    "'@ -ErrorAction SilentlyContinue",
    "function Hide-NpiProcessWindow([System.Diagnostics.Process]$proc) {",
    "  if (-not $proc) { return }",
    "  for ($i = 0; $i -lt 50; $i++) {",
    "    Start-Sleep -Milliseconds 80",
    "    try { $proc.Refresh() } catch {}",
    "    if ($proc.MainWindowHandle -ne [IntPtr]::Zero) {",
    "      [void][NpiWinHide]::ShowWindow($proc.MainWindowHandle, 0)",
    "      return",
    "    }",
    "  }",
    "}",
    "function Invoke-NpiHidden {",
    "  $psi = New-Object System.Diagnostics.ProcessStartInfo",
    "  $psi.FileName = $Inspector",
    "  $psi.Arguments = $argsLine",
    "  $psi.WorkingDirectory = $wd",
    "  $psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "  $psi.CreateNoWindow = $true",
    "  $psi.UseShellExecute = $false",
    "  $psi.RedirectStandardError = $true",
    "  $psi.RedirectStandardOutput = $true",
    "  $p = [System.Diagnostics.Process]::Start($psi)",
    "  if (-not $p) { throw [System.InvalidOperationException]::new('ProcessStartFailed') }",
    "  Hide-NpiProcessWindow $p",
    "  $stdout = $p.StandardOutput.ReadToEnd()",
    "  $stderr = $p.StandardError.ReadToEnd()",
    "  $null = $p.WaitForExit()",
    "  return @{ ExitCode = $p.ExitCode; StdOut = $stdout; StdErr = $stderr }",
    "}",
    "try {",
    "  if ($isAdmin) {",
    "    $run = Invoke-NpiHidden",
    "    $exitCode = $run.ExitCode",
    "    $errMsg = [string]$run.StdErr",
    "  } else {",
    "    $elevArgs = @('-NoProfile','-ExecutionPolicy','Bypass','-WindowStyle','Hidden','-File',$ElevInner)",
    "    $ep = Start-Process -FilePath 'powershell.exe' -ArgumentList $elevArgs -Verb RunAs -Wait -PassThru -WindowStyle Hidden",
    "    if ($ep) { $exitCode = $ep.ExitCode } else { $exitCode = 18 }",
    "  }",
    "} catch {",
    "  $errMsg = [string]$_.Exception.Message",
    "  if ($errMsg -match '1223|canceled|cancelled|refus|operation was canceled') { $exitCode = 1223 }",
    "  elseif ($exitCode -lt 0) { $exitCode = 18 }",
    "}",
    "$sw.Stop()",
    "$payload = @{ exitCode = $exitCode; durationMs = [int]$sw.ElapsedMilliseconds; cmdLine = $cmdLine; stderr = $errMsg }",
    "$dir = Split-Path -Parent $ResultPath",
    "if ($dir -and -not (Test-Path -LiteralPath $dir)) { New-Item -ItemType Directory -Path $dir -Force | Out-Null }",
    "($payload | ConvertTo-Json -Compress) | Out-File -LiteralPath $ResultPath -Encoding utf8 -Force",
    "exit $exitCode"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(lines.join("\r\n"));
  tw.Close();
  logNvidiaPanelDev("Commande silencieuse : " + inspectorExe + " -silentImport \"" + nip + "\"");
  var shellCode = runPowerShell("-File \"" + psPath + "\"");
  var out = { exitCode: shellCode, durationMs: 0, cmdLine: inspectorExe + " -silentImport \"" + nip + "\"", error: "" };
  try {
    if (fso.FileExists(resultPath)) {
      var json = readTextFileAll(resultPath);
      if (json) {
        var parsed = JSON.parse(json);
        if (parsed && typeof parsed.exitCode !== "undefined") out.exitCode = parsed.exitCode;
        if (parsed && parsed.durationMs) out.durationMs = parsed.durationMs;
        if (parsed && parsed.cmdLine) out.cmdLine = parsed.cmdLine;
        if (parsed && parsed.stderr) out.error = String(parsed.stderr);
      }
      fso.DeleteFile(resultPath, true);
    }
  } catch (eJ) {}
  try { if (fso.FileExists(psPath)) fso.DeleteFile(psPath, true); } catch (eDel) {}
  try { if (fso.FileExists(elevInnerPath)) fso.DeleteFile(elevInnerPath, true); } catch (eDel2) {}
  appendNvidiaProfileLogLine("NPI_CMD=" + out.cmdLine);
  appendNvidiaProfileLogLine("NPI_EXIT_CODE=" + out.exitCode);
  logNvidiaPanelDev("Import terminé   code=" + out.exitCode + " durée=" + out.durationMs + "ms");
  if (out.error) logNvidiaPanelDev("Import stderr : " + out.error);
  return out;
}

function exportNvidiaProfileToVerifyPath(inspectorExe, destPath) {
  return exportNvidiaBackupViaInspector(inspectorExe, destPath);
}

function verifyNvidiaResetAfterImport(inspector, importedPath, resetSource) {
  var verifyPath = getAbsolutePathFs((getNvidiaBackupDir() || UNREAL_LOGS) + "\\__verify_after_reset.nip");
  try {
    if (fileExists(verifyPath)) getFso().DeleteFile(verifyPath, true);
  } catch (eRm) {}
  sleepMs(1500);
  var expCode = exportNvidiaProfileToVerifyPath(inspector, verifyPath);
  if (expCode !== 0 || !fileExists(verifyPath)) {
    return { state: "unverified", detail: "export post-reset impossible (code " + expCode + ")" };
  }
  var afterMap = parseNvidiaNipSettingMap(verifyPath);
  var importedMap = parseNvidiaNipSettingMap(importedPath);
  if (resetSource === "backup") {
    var match = 0;
    var total = 0;
    var id;
    for (id in importedMap) {
      if (!importedMap.hasOwnProperty(id)) continue;
      total++;
      if (afterMap[id] === importedMap[id]) match++;
    }
    logNvidiaPanelDev("Vérif backup : correspondance " + match + "/" + total + " réglages");
    if (total >= 5 && match / total >= 0.75) return { state: "confirmed", detail: "profil driver aligné sur le backup" };
    if (total >= 1 && match > 0) return { state: "confirmed", detail: "partie du backup restaurée (" + match + "/" + total + ")" };
    return { state: "unconfirmed", detail: "le driver ne correspond pas au backup importé" };
  }
  var unrealPath = resolveNvidiaFpsLatencyProfilePath();
  var unrealMap = unrealPath ? parseNvidiaNipSettingMap(unrealPath) : {};
  var same = 0;
  var checked = 0;
  var i;
  var sid;
  for (i = 0; i < NVIDIA_RESET_WATCH_IDS.length; i++) {
    sid = NVIDIA_RESET_WATCH_IDS[i];
    if (typeof unrealMap[sid] === "undefined") continue;
    checked++;
    if (afterMap[sid] === unrealMap[sid]) same++;
  }
  logNvidiaPanelDev("Vérif défaut : réglages encore identiques au profil Unreal " + same + "/" + checked);
  if (countNvidiaNipProfileSettings(importedPath) < 1) {
    return { state: "unconfirmed", detail: "fichier reset sans réglages   aucun changement attendu" };
  }
  if (checked > 0 && same >= checked) {
    return { state: "unconfirmed", detail: "réglages FPS/latence toujours identiques au profil Unreal" };
  }
  if (checked > 0 && same < checked) {
    return { state: "confirmed", detail: "écart confirmé sur " + (checked - same) + " réglage(s) surveillé(s)" };
  }
  var afterCount = countNvidiaNipProfileSettings(verifyPath);
  var importCount = countNvidiaNipProfileSettings(importedPath);
  if (importCount >= 3 && afterCount >= 3) {
    return { state: "confirmed", detail: "profil driver réexporté après import (" + afterCount + " réglages)" };
  }
  return { state: "unverified", detail: "comparaison des réglages surveillés impossible" };
}

/** Export sauvegarde via -exportCustomized (NPI v3+), sans ouvrir l'interface. */
function exportNvidiaBackupViaInspector(inspectorExe, backupPath) {
  if (!inspectorExe || !fileExists(inspectorExe)) return 16;
  var dest = getAbsolutePathFs(backupPath || "");
  if (!dest) return 17;
  var backupDir = getNvidiaBackupDir();
  if (!backupDir || !createFolder(backupDir)) return 17;

  createUnrealFolders();
  var fso = getFso();
  var psPath = UNREAL_LOGS + "\\nvidia-nip-export.ps1";
  var escInspector = String(inspectorExe).replace(/'/g, "''");
  var escDest = String(dest).replace(/'/g, "''");
  var lines = [
    "$ErrorActionPreference = 'Stop'",
    "$Inspector = '" + escInspector + "'",
    "$Dest = '" + escDest + "'",
    "$wd = Split-Path -Parent $Inspector",
    "if (-not (Test-Path -LiteralPath $Inspector)) { exit 16 }",
    "$argsLine = '-exportCustomized'",
    "$cmdLine = $Inspector + ' ' + $argsLine",
    "Set-Content -LiteralPath ($env:TEMP + '\\purpleboost-nvidia-cli-last.txt') -Value $cmdLine -Encoding UTF8",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Inspector",
    "$psi.Arguments = $argsLine",
    "$psi.WorkingDirectory = $wd",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$before = @(Get-ChildItem -LiteralPath $wd -Filter '*.nip' -File -ErrorAction SilentlyContinue | ForEach-Object { $_.FullName })",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if (-not $p) { exit 18 }",
    "$p.WaitForExit()",
    "if ($p.ExitCode -ne 0) { exit $p.ExitCode }",
    "$after = Get-ChildItem -LiteralPath $wd -Filter '*.nip' -File -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending",
    "$newFile = $null",
    "foreach ($f in $after) { if ($before -notcontains $f.FullName) { $newFile = $f; break } }",
    "if (-not $newFile -and $after.Count -gt 0) { $newFile = $after[0] }",
    "if (-not $newFile) { exit 19 }",
    "Copy-Item -LiteralPath $newFile.FullName -Destination $Dest -Force",
    "exit 0"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(lines.join("\r\n"));
  tw.Close();
  logNvidiaPanelDev("Commande silencieuse export : " + inspectorExe + " -exportCustomized  →  " + dest);
  var code = runPowerShell("-File \"" + psPath + "\"");
  try { if (fso.FileExists(psPath)) fso.DeleteFile(psPath, true); } catch (eDel2) {}
  logNvidiaPanelDev("Code retour export : " + code);
  return code;
}

function tryExportNvidiaBackupBeforeUnreal(inspector) {
  var backupDir = getNvidiaBackupDir();
  if (!backupDir || !createFolder(backupDir)) {
    logNvidiaPanelDev("Sauvegarde auto : dossier Backups inaccessible.");
    return { ok: false, warn: true };
  }
  var backupPath = getNvidiaBackupBeforeUnrealPath();
  if (!backupPath) return { ok: false, warn: true };
  if (fileExists(backupPath)) {
    logNvidiaPanelDev("Sauvegarde existante conservée : " + backupPath);
    return { ok: true, warn: false };
  }
  var code = exportNvidiaBackupViaInspector(inspector, backupPath);
  if (code === 0 && fileExists(backupPath)) {
    logNvidiaPanelDev("Sauvegarde créée : " + backupPath);
    return { ok: true, warn: false };
  }
  logNvidiaPanelDev("Sauvegarde auto impossible (code " + code + ")   application du profil poursuivie.");
  return { ok: false, warn: true };
}

/* ========== NvidiaAutomationV2 (module indépendant) ==========
 * N'appelle pas DDU ni NVCleanInstall. Logs : nvidia-gaming.log, nvidia-automation-v2.log.
 * NIP élevé : ApplyNipProfile / importNvidiaProfileNipElevated (HTA).
 * Affichage max : runNvGamingDisplayApply + NvidiaAutomationV2.exe (--skip-nip pour NIP).
 */
var nvGamingDisplayCache = null;

function makeNvGamingResult(status, message) {
  return { status: status, message: message || "" };
}

function getNvGamingLogPath() {
  var app = getAppFolderFromHta();
  return app ? getAbsolutePathFs(app + "\\logs\\nvidia-gaming.log") : (UNREAL_LOGS + "\\nvidia-gaming.log");
}

function appendNvGamingLogLine(line) {
  var path = getNvGamingLogPath();
  try {
    var fso = getFso();
    var dir = fso.GetParentFolderName(path);
    if (dir && !fso.FolderExists(dir)) fso.CreateFolder(dir);
    var stream = fso.OpenTextFile(path, 8, true);
    stream.WriteLine(String(line || ""));
    stream.Close();
  } catch (eW) {
    try { appendNvidiaProfileLogLine("[nvidia-gaming] " + line); } catch (e2) {}
  }
}

var purpleboostNvDevMode = false;

function getNvFinalLogDir() {
  var app = getAppFolderFromHta();
  return app ? getAbsolutePathFs(app + "\\logs\\nvidia-final") : (UNREAL_LOGS + "\\nvidia-final");
}

function ensureNvFinalLogDir() {
  try {
    var fso = getFso();
    var dir = getNvFinalLogDir();
    if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
    return dir;
  } catch (e) { return ""; }
}

function appendNvFinalLog(fileName, line) {
  try {
    ensureNvFinalLogDir();
    var fso = getFso();
    var path = getNvFinalLogDir() + "\\" + fileName;
    var ts = new Date().toISOString().replace("T", " ").substring(0, 19);
    var stream = fso.OpenTextFile(path, 8, true);
    stream.WriteLine(ts + " " + String(line || ""));
    stream.Close();
  } catch (eW) {}
}

function appendNvFinalStepLog(fileName, stepName, actionSent, outcome, errMsg, durationMs) {
  appendNvFinalLog(fileName, "étape=" + stepName + " action=" + actionSent + " résultat=" + outcome
    + (errMsg ? " erreur=" + errMsg : "") + " duréeMs=" + (durationMs || 0));
}

function loadNvidiaOptimizationConfig() {
  var defaults = {
    digitalVibrance: 80,
    runNipProfile: true,
    runDigitalVibrance: true,
    runDisplaySettings: true,
    runPanelSettings: true,
    closeNvidiaPanelAtEnd: true,
    bringUnrealToFrontAtEnd: true,
    experimentalKeepUnrealInFrontDuringPanelAutomation: false,
    panelSettings: {
      runNoScaling: true,
      runPreviewPerformance: true,
      runInverseTelecine: true,
      delayAfterNoScalingMs: 4000,
      delayBetweenPanelStepsMs: 1000
    }
  };
  try {
    var app = getAppFolderFromHta();
    if (!app) return defaults;
    var path = getAbsolutePathFs(app + "\\config\\nvidia-optimization.json");
    if (!fileExists(path)) return defaults;
    var raw = readTextFileAll(path);
    if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
    var cfg = JSON.parse(raw);
    if (!cfg.panelSettings) cfg.panelSettings = defaults.panelSettings;
    return cfg;
  } catch (e) {
    appendNvFinalLog("nvidia-full-optimization.log", "WARN config illisible  défauts");
    return defaults;
  }
}

function purgeObsoleteNvidiaLogs() {
  var app = getAppFolderFromHta();
  if (!app) return;
  var logsDir = getAbsolutePathFs(app + "\\logs");
  var patterns = [
    "nvidia-ui-fallback.log",
    "nvidia-control-panel-ui-tree.json",
    "nvidia-control-panel-ui-tree.txt",
    "nvidia-v3-result.json",
    "nvidia-v3-diagnostics.log",
    "nvidia-v3-audit-report.txt",
    "nvidia-v3-performance-forensic.log",
    "nvidia-performance-reg-candidates.txt",
    "nvidia-performance-nvtweak-diff.txt",
    "nvidia-final-three-settings.log"
  ];
  var prefixes = ["nvidia_snapshot_", "nvidia-v3-"];
  try {
    var fso = getFso();
    if (!fso.FolderExists(logsDir)) return;
    var folder = fso.GetFolder(logsDir);
    var fe = new Enumerator(folder.Files);
    for (; !fe.atEnd(); fe.moveNext()) {
      var name = fe.item().Name;
      var i, kill = false;
      for (i = 0; i < patterns.length; i++) {
        if (name === patterns[i]) { kill = true; break; }
      }
      if (!kill) {
        for (i = 0; i < prefixes.length; i++) {
          if (name.indexOf(prefixes[i]) === 0) { kill = true; break; }
        }
      }
      if (kill) {
        try { fso.DeleteFile(logsDir + "\\" + name, true); } catch (eD) {}
      }
    }
  } catch (eP) {}
}

function initNvFullOptResult(startedAt) {
  return {
    success: false,
    startedAt: startedAt || new Date().toISOString(),
    endedAt: "",
    steps: {
      nip: { status: "skipped", log: "logs/nvidia-final/01-nip.log" },
      digitalVibrance: { status: "skipped", value: 80, log: "logs/nvidia-final/02-digital-vibrance.log" },
      display: {
        status: "skipped",
        log: "logs/nvidia-final/03-display.log",
        resolution: { status: "skipped", message: "" },
        refreshRate: { status: "skipped", message: "" }
      },
      panelSettings: {
        status: "skipped",
        label: "",
        log: "logs/nvidia-final/04-panel-settings.log",
        children: {
          noScaling: "skipped",
          previewPerformance: "skipped",
          inverseTelecine: "skipped"
        }
      }
    }
  };
}

function nvFullOptMapV2Step(step) {
  if (!step || !step.status) return "error";
  if (step.status === "Skipped") return "skipped";
  if (step.status === "Success" && step.verified === true) return "success";
  if (step.status === "Success") return "success";
  return "error";
}

function nvFullOptMapPanelPayload(payload, hadError) {
  if (hadError || !payload) return "error";
  if (payload.uiStatus === "error") return "error";
  if (payload.verified === true && payload.uiStatus === "panel_verified") return "success";
  if (payload.success !== false) return "success";
  return "error";
}

function nvFullOptMapPanelChild(status) {
  if (status === "success") return "success";
  if (status === "skipped") return "skipped";
  return "error";
}

function writeNvFullOptimizationResultJson(result) {
  try {
    ensureNvFinalLogDir();
    var app = getAppFolderFromHta();
    var path = getNvFinalLogDir() + "\\nvidia-full-optimization-result.json";
    var fso = getFso();
    var tw = fso.CreateTextFile(path, true);
    tw.Write(JSON.stringify(result, null, 2));
    tw.Close();
    if (app) appendNvGamingLogLine("NV_FULL_OPT_JSON=" + path);
  } catch (eW) {
    appendNvGamingLogLine("NV_FULL_OPT_JSON_ERROR=" + String(eW.message || eW));
  }
}

function logNvOptProgress(pct, stepLabel) {
  appendNvFinalLog("nvidia-full-optimization.log", "progress=" + pct + " " + stepLabel);
}

function preventUnrealHtaRelaunch(context) {
  appendNvFinalLog("nvidia-full-optimization.log", "No second HTA instance should be launched");
  appendNvFinalLog("nvidia-full-optimization.log", "Unreal.hta relaunch prevented" + (context ? " (" + context + ")" : ""));
  appendNvGamingLogLine("Unreal.hta relaunch prevented context=" + (context || "nv-full-opt"));
}

function setNvOptProgress(pct, stepLabel) {
  var wrap = $("nvOptProgressWrap");
  var fill = $("nvOptProgressFill");
  var text = $("nvOptProgressText");
  var step = $("nvOptProgressStep");
  var p = parseInt(pct, 10);
  if (isNaN(p)) p = 0;
  if (p < 0) p = 0;
  if (p > 100) p = 100;
  if (wrap) {
    wrap.style.display = "block";
    try { void wrap.offsetWidth; } catch (eRf) {}
  }
  if (fill) fill.style.width = p + "%";
  if (text) text.innerHTML = p + " %";
  if (step) step.innerHTML = "0tape en cours : " + (stepLabel || "⬦");
  if (stepLabel) logNvOptProgress(p, stepLabel);
  driversWorkflowState.optPct = p;
  if (p >= 100) {
    driversWorkflowState.optDone = true;
    driversWorkflowState.optError = false;
    updateDriversWorkflowGuide();
  } else if (p > 0) {
    driversWorkflowState.optDone = false;
    updateDriversWorkflowGuide();
  }
}

function setProgress(pct, stepLabel, nextFn) {
  setNvOptProgress(pct, stepLabel);
  if (typeof nextFn === "function") {
    window.setTimeout(nextFn, 100);
  }
}

function resetNvOptProgress(hide) {
  if (hide) {
    var wrap = $("nvOptProgressWrap");
    if (wrap) wrap.style.display = "none";
    return;
  }
  setNvOptProgress(0, "En attente");
}

/** Met la fenêtre HTA courante au premier plan  ne relance jamais mshta.exe / Unreal.hta */
function focusCurrentHtaWindowOnly() {
  preventUnrealHtaRelaunch("focus-end");
  try {
    if (window.focus) window.focus();
    appendNvGamingLogLine("FOCUS=current HTA window only (no mshta relaunch)");
    appendNvFinalLog("nvidia-full-optimization.log", "Fenêtre Unreal au premier plan (instance courante)");
  } catch (eF) {
    appendNvGamingLogLine("FOCUS_WARN=" + String(eF.message || eF));
  }
}

function extractDisplayMaxFromPayload(payload) {
  var maxRes = "";
  var maxHz = 0;
  var msgs = (payload && payload.messages) ? payload.messages : [];
  var i, m, rm, hm;
  for (i = 0; i < msgs.length; i++) {
    m = String(msgs[i] || "");
    rm = m.match(/Selected max resolution:\s*(\d+x\d+)/i);
    if (rm) maxRes = rm[1];
    hm = m.match(/Selected max refresh rate:\s*(\d+)/i);
    if (hm) maxHz = parseInt(hm[1], 10);
  }
  return { maxRes: maxRes, maxHz: maxHz };
}

function normalizeResStr(res) {
  if (!res) return "";
  return String(res).replace(/\s/g, "").toLowerCase();
}

function parseRefreshHz(hzStr) {
  if (!hzStr) return 0;
  var n = parseInt(String(hzStr).replace(/Hz/gi, ""), 10);
  return isNaN(n) ? 0 : n;
}

function evaluateDisplayResolutionStatus(d, payload) {
  if (!d || !d.resolution) {
    return { status: "error", message: "Impossible de lire les modes d'affichage" };
  }
  if (d.verified) {
    return { status: "success", message: "appliquée (" + d.resolution + ")" };
  }
  var max = extractDisplayMaxFromPayload(payload);
  if (max.maxRes && normalizeResStr(d.resolution) === normalizeResStr(max.maxRes)) {
    return { status: "already_optimal", message: "Résolution déjà maximale" };
  }
  return { status: "error", message: "Impossible d'appliquer la résolution maximale" };
}

function evaluateDisplayRefreshStatus(d, payload) {
  if (!d || !d.refresh) {
    return { status: "error", message: "Impossible de lire la fréquence d'affichage" };
  }
  if (d.verified) {
    return { status: "success", message: "appliquée (" + d.refresh + ")" };
  }
  var max = extractDisplayMaxFromPayload(payload);
  var curHz = parseRefreshHz(d.refresh);
  if (max.maxHz > 0 && curHz >= max.maxHz) {
    return { status: "already_optimal", message: "Fréquence déjà maximale" };
  }
  if (max.maxHz > 0 && curHz > 0 && curHz >= max.maxHz - 1) {
    return { status: "already_optimal", message: "Fréquence déjà maximale" };
  }
  return { status: "error", message: "Impossible d'appliquer la fréquence maximale" };
}

function aggregateDisplayStepStatus(resSt, hzSt) {
  if (resSt.status === "error" && hzSt.status === "error") return "error";
  if (resSt.status === "error" || hzSt.status === "error") return "error";
  return "success";
}

function isDisplayStepOkForFlow(st) {
  return st === "success" || st === "already_optimal" || st === "skipped";
}

function nvFullOptUiLabel(status) {
  if (status === "success") return { text: "fait", tone: "ok" };
  if (status === "already_optimal") return { text: "déjà maximale", tone: "ok" };
  if (status === "applied") return { text: "appliquée", tone: "ok" };
  if (status === "skipped") return { text: "ignoré", tone: "muted" };
  if (status === "sent") return { text: "action envoyée", tone: "warn" };
  return { text: "erreur", tone: "bad" };
}

function nvDisplayLineUiLabel(step) {
  if (!step) return { text: "", tone: "muted" };
  if (step.status === "success") return { text: "appliquée", tone: "ok" };
  if (step.status === "already_optimal") return { text: "déjà maximale", tone: "ok" };
  if (step.status === "skipped") return { text: "ignoré", tone: "muted" };
  return { text: "erreur", tone: "bad" };
}

function mapPanelChildFromPayload(status) {
  if (status === "applied" || status === "success") return "applied";
  if (status === "skipped") return "skipped";
  return "error";
}

function aggregatePanelSettingsStatus(children) {
  if (!children) return "skipped";
  if (children.noScaling === "error" || children.previewPerformance === "error" || children.inverseTelecine === "error") {
    return "error";
  }
  if (children.noScaling === "applied" || children.previewPerformance === "applied" || children.inverseTelecine === "applied") {
    return "applied";
  }
  return "skipped";
}

function panelLabelForStatus(status) {
  if (status === "applied") return "appliqué";
  if (status === "skipped") return "ignoré";
  return "erreur";
}

function nvPanelParentUiLabel(panelStep) {
  if (!panelStep) return { text: "", tone: "muted" };
  var st = panelStep.status || "error";
  if (st === "error") return { text: "erreur", tone: "bad" };
  if (st === "skipped") return { text: "ignoré", tone: "muted" };
  if (st === "applied") return { text: "appliqué", tone: "ok" };
  return { text: "erreur", tone: "bad" };
}

function nvPanelSubStepUiLabel(childStatus) {
  if (childStatus === "skipped") return { text: "ignoré", tone: "muted" };
  if (childStatus === "applied") return { text: "appliqué", tone: "ok" };
  if (childStatus === "error") return { text: "erreur", tone: "bad" };
  return { text: "erreur", tone: "bad" };
}

function isPanelStepOkForFlow(status) {
  return status === "applied" || status === "skipped";
}

function renderNvFullOptimizationSummary(result) {
  var box = $("nvidiaGamingSteps");
  if (!box || !result || !result.steps) return;
  var s = result.steps;
  var lines = ["<strong>Optimisation NVIDIA complète terminée</strong>"];
  var nip = nvFullOptUiLabel(s.nip.status);
  var dvVal = (s.digitalVibrance && s.digitalVibrance.value) ? s.digitalVibrance.value : 80;
  var dv = nvFullOptUiLabel(s.digitalVibrance.status);
  var dvText = (s.digitalVibrance.status === "success") ? (dvVal + " %") : dv.text;
  var resUi = nvDisplayLineUiLabel(s.display.resolution);
  var hzUi = nvDisplayLineUiLabel(s.display.refreshRate);
  var pan = nvPanelParentUiLabel(s.panelSettings);
  lines.push("- Profil NVIDIA : <span class=\"nv-step-" + nip.tone + "\">" + nip.text + "</span>");
  lines.push("- 0clat numérique : <span class=\"nv-step-" + dv.tone + "\">" + dvText + "</span>");
  lines.push("- Résolution : <span class=\"nv-step-" + resUi.tone + "\">" + resUi.text + "</span>");
  lines.push("- Fréquence : <span class=\"nv-step-" + hzUi.tone + "\">" + hzUi.text + "</span>");
  lines.push("- Réglages panneau NVIDIA : <span class=\"nv-step-" + pan.tone + "\">" + pan.text + "</span>");
  if (s.panelSettings.children) {
    var c = s.panelSettings.children;
    var ns = nvPanelSubStepUiLabel(c.noScaling);
    var pp = nvPanelSubStepUiLabel(c.previewPerformance);
    var it = nvPanelSubStepUiLabel(c.inverseTelecine);
    lines.push("  - Pas de mise à l'échelle : <span class=\"nv-step-" + ns.tone + "\">" + ns.text + "</span>");
    lines.push("  - Mode performance NVIDIA : <span class=\"nv-step-" + pp.tone + "\">" + pp.text + "</span>");
    lines.push("  - Téléciné inversée : <span class=\"nv-step-" + it.tone + "\">" + it.text + "</span>");
  }
  box.innerHTML = lines.join("<br/>");
  box.style.display = SHOW_DEBUG_UI ? "block" : "none";
}

function setNvGamingStatusFromFullOpt(result) {
  if (!result) { setNvGamingStatus("Optimisation NVIDIA : erreur interne", "bad"); return; }
  if (result.success) {
    setNvGamingStatus("Optimisation NVIDIA complète terminée.", "ok");
    return;
  }
  var hasError = false;
  var steps = result.steps;
  if (steps.nip.status === "error" || steps.digitalVibrance.status === "error") hasError = true;
  if (steps.display && steps.display.resolution && steps.display.resolution.status === "error") hasError = true;
  if (steps.display && steps.display.refreshRate && steps.display.refreshRate.status === "error") hasError = true;
  if (steps.panelSettings && steps.panelSettings.status === "error") hasError = true;
  if (hasError) {
    setNvGamingStatus("Optimisation NVIDIA : une ou plusieurs étapes en erreur  voir détail.", "bad");
    return;
  }
  setNvGamingStatus("Optimisation NVIDIA : terminée avec avertissements  voir détail.", "warn");
}

function toggleNvDevMode() {
  purpleboostNvDevMode = !purpleboostNvDevMode;
  var nodes = document.querySelectorAll ? document.querySelectorAll(".nv-dev-only") : [];
  var i, display = purpleboostNvDevMode ? "" : "none";
  for (i = 0; i < nodes.length; i++) nodes[i].style.display = display;
  var link = $("nvDevModeToggle");
  if (link) link.innerHTML = purpleboostNvDevMode ? "Masquer mode développeur" : "Mode développeur (tests NVIDIA)";
}

function getNvidiaFullProfileInspectorPath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var candidates = [
    app + "\\tools\\nvidiaProfileInspector\\nvidiaProfileInspector.exe",
    app + "\\tools\\nvidiaProfileInspector\\ProfileInspector\\nvidiaProfileInspector.exe",
    app + "\\tools\\NVIDIA\\ProfileInspector\\nvidiaProfileInspector.exe"
  ];
  var i;
  for (i = 0; i < candidates.length; i++) {
    if (fileExists(candidates[i])) return getAbsolutePathFs(candidates[i]);
  }
  return "";
}

function getNvidiaFullWarzoneNipPath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var candidates = [
    app + "\\tools\\profiles\\" + NVIDIA_FULL_WARZONE_NIP_FILE,
    app + "\\tools\\nvidiaProfileInspector\\Profiles\\" + NVIDIA_FULL_WARZONE_NIP_FILE,
    app + "\\tools\\NVIDIA\\Profiles\\" + NVIDIA_FULL_WARZONE_NIP_FILE
  ];
  var i;
  for (i = 0; i < candidates.length; i++) {
    if (fileExists(candidates[i])) return getAbsolutePathFs(candidates[i]);
  }
  return "";
}

function getNvidiaDisplayHelperPath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var p = getAbsolutePathFs(app + "\\tools\\nvidia-display-helper\\UnrealNvidiaDisplayHelper.exe");
  if (fileExists(p)) return p;
  return "";
}

function setNvGamingStatus(text, kind) {
  setNvidiaPanelStatus(text, kind);
}

function resolveNvGamingNipPath() {
  var p = getNvidiaFullWarzoneNipPath();
  if (p && fileExists(p)) return p;
  return resolveNvidiaPerformanceProfilePath();
}

function resolveNvGamingInspectorPath() {
  var inspector = ensureBundledNvidiaProfileInspector();
  if (!inspector) inspector = resolveNvidiaProfileInspectorExe();
  if (!inspector) inspector = getNvidiaFullProfileInspectorPath();
  return inspector || "";
}

/*
 * STABLE  stable-nvidia-nip-silent-import (NE PAS R00CRIRE)
 * Import .nip validé : NvidiaAutomationV2 + -silentImport, sans UI NPI.
 * Ne pas remplacer par ShellExecute, ouverture du .nip, PowerShell runas sur NPI,
 * ni export sauvegarde avant apply dans ce flux.
 * Fichiers : ApplyNipProfile, runNvidiaAutomationV2ApplyNipOnly,
 *   tools/nvidia-automation-v2/.../NipSilentImportService.cs
 */
function resolveApplyNipInspectorPath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var primary = getAbsolutePathFs(app + "\\tools\\NvidiaProfileInspector\\nvidiaProfileInspector.exe");
  if (fileExists(primary)) return primary;
  return resolveNvGamingInspectorPath();
}

function resolveApplyNipPresetPath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var primary = getAbsolutePathFs(app + "\\presets\\UnrealGaming.nip");
  if (fileExists(primary)) return primary;
  return resolveNvGamingNipPath();
}

function runNvidiaAutomationV2ApplyNipOnly() {
  createUnrealFolders();
  var exe = getNvidiaAutomationV2ExePath();
  if (!exe || !fileExists(exe)) {
    return { error: "NvidiaAutomationV2.exe introuvable" };
  }
  var app = getAppFolderFromHta();
  var stdoutPath = UNREAL_LOGS + "\\nvidia-apply-nip-result.json";
  var psPath = UNREAL_LOGS + "\\nvidia-apply-nip-run.ps1";
  var escExe = String(exe).replace(/'/g, "''");
  var escRoot = String(app || "").replace(/'/g, "''");
  var escOut = String(stdoutPath).replace(/'/g, "''");
  var fso = getFso();
  var psLines = [
    "$ErrorActionPreference = 'Continue'",
    "$Exe = '" + escExe + "'",
    "$Root = '" + escRoot + "'",
    "$StdoutPath = '" + escOut + "'",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Exe",
    "$psi.Arguments = '--apply-nip --json --purpleboost-root \"' + $Root + '\"'",
    "$psi.WorkingDirectory = (Split-Path -Parent $Exe)",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$psi.RedirectStandardOutput = $true",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if ($p) {",
    "  $stdout = $p.StandardOutput.ReadToEnd()",
    "  if (-not $p.WaitForExit(180000)) { try { $p.Kill() } catch {}; exit 124 }",
    "  else { if ($stdout) { [System.IO.File]::WriteAllText($StdoutPath, $stdout, [System.Text.UTF8Encoding]::new($false)) }; exit $p.ExitCode }",
    "}",
    "exit 18"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(psLines.join("\r\n"));
  tw.Close();
  appendNvGamingLogLine("NIP_V2_SILENT=" + exe);
  runPowerShell("-ExecutionPolicy Bypass -File \"" + psPath + "\"");
  var payload = null;
  try {
    if (fso.FileExists(stdoutPath)) {
      var raw = readTextFileAll(stdoutPath);
      if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
      if (raw) payload = JSON.parse(raw);
      fso.DeleteFile(stdoutPath, true);
    }
  } catch (eP) {
    appendNvGamingLogLine("NIP_V2_PARSE_ERROR=" + String(eP.message || eP));
  }
  try { fso.DeleteFile(psPath, true); } catch (eD) {}
  return payload;
}

function ApplyNipProfile() {
  appendNvGamingLogLine("STEP=ApplyNipProfile");
  appendNvidiaProfileLogLine("STEP=ApplyNipProfile (-silentImport C#, sans UI NPI)");
  var inspector = resolveApplyNipInspectorPath();
  if (!inspector || !fileExists(inspector)) {
    appendNvidiaProfileLogLine("NPI=manquant");
    return makeNvGamingResult("Failed", "Outil Nvidia Profile Inspector manquant.");
  }
  var nipPath = resolveApplyNipPresetPath();
  if (!nipPath || !fileExists(nipPath)) {
    appendNvidiaProfileLogLine("NIP=preset UnrealGaming.nip manquant");
    return makeNvGamingResult("Failed", "Preset Nvidia UnrealGaming.nip introuvable.");
  }
  appendNvidiaProfileLogLine("NPI_PATH=" + inspector);
  appendNvidiaProfileLogLine("NIP_PATH=" + nipPath);
  appendNvidiaProfileLogLine("NPI_CMD=" + inspector + " -silentImport \"" + nipPath + "\"");
  var payload = runNvidiaAutomationV2ApplyNipOnly();
  if (!payload || payload.error) {
    appendNvidiaProfileLogLine("NPI_EXIT_CODE=error " + (payload && payload.error ? payload.error : "no_json"));
    return makeNvGamingResult("Failed", payload && payload.error ? payload.error : "Import .nip échoué");
  }
  var step = payload.nipProfile || {};
  var exitOk = step.status === "Success";
  appendNvGamingLogLine("NIP_EXIT=" + (step.status || "?") + " ok=" + exitOk);
  appendNvidiaProfileLogLine("NPI_EXIT_CODE=" + (step.status || "?") + " msg=" + (step.message || ""));
  if (exitOk) {
    return makeNvGamingResult("Success", "Profil NVIDIA appliqué via .nip");
  }
  return makeNvGamingResult("Failed", step.message || "Import .nip échoué");
}

function runNvGamingDisplayApply() {
  if (nvGamingDisplayCache) return nvGamingDisplayCache;
  createUnrealFolders();
  var helperPath = getNvidiaDisplayHelperPath();
  var fso = getFso();
  var payload = null;

  if (helperPath && fileExists(helperPath)) {
    var stdoutPath = UNREAL_LOGS + "\\nvidia-gaming-display-stdout.json";
    var psPath = UNREAL_LOGS + "\\nvidia-gaming-display-run.ps1";
    var escHelper = String(helperPath).replace(/'/g, "''");
    var escOut = String(stdoutPath).replace(/'/g, "''");
    var psLines = [
      "$ErrorActionPreference = 'Continue'",
      "$Helper = '" + escHelper + "'",
      "$StdoutPath = '" + escOut + "'",
      "$psi = New-Object System.Diagnostics.ProcessStartInfo",
      "$psi.FileName = $Helper",
      "$psi.Arguments = '--apply-full --skip-digital-vibrance --json'",
      "$psi.WorkingDirectory = (Split-Path -Parent $Helper)",
      "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
      "$psi.CreateNoWindow = $true",
      "$psi.UseShellExecute = $false",
      "$psi.RedirectStandardOutput = $true",
      "$p = [System.Diagnostics.Process]::Start($psi)",
      "if ($p) {",
      "  $stdout = $p.StandardOutput.ReadToEnd()",
      "  if (-not $p.WaitForExit(120000)) { try { $p.Kill() } catch {}; exit 124 }",
      "  else { if ($stdout) { [System.IO.File]::WriteAllText($StdoutPath, $stdout, [System.Text.UTF8Encoding]::new($false)) }; exit $p.ExitCode }",
      "}",
      "exit 18"
    ];
    var tw = fso.CreateTextFile(psPath, true);
    tw.Write(psLines.join("\r\n"));
    tw.Close();
    appendNvGamingLogLine("DISPLAY=helper " + helperPath);
    runPowerShell("-ExecutionPolicy Bypass -File \"" + psPath + "\"");
    try {
      if (fso.FileExists(stdoutPath)) {
        var raw = readTextFileAll(stdoutPath);
        if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
        if (raw) payload = JSON.parse(raw);
        fso.DeleteFile(stdoutPath, true);
      }
    } catch (eP) {
      appendNvGamingLogLine("DISPLAY_PARSE_ERROR=" + String(eP.message || eP));
    }
    try { fso.DeleteFile(psPath, true); } catch (eD) {}
  }

  if (!payload) {
    var resultPath = UNREAL_LOGS + "\\nvidia-gaming-display-result.json";
    var psDisplay = UNREAL_SCRIPTS + "\\apply-nvidia-display-profile.ps1";
    if (!fileExists(psDisplay)) {
      nvGamingDisplayCache = { ok: false, resolution: "", refresh: "", verified: false };
      return nvGamingDisplayCache;
    }
    var escPs = String(psDisplay).replace(/'/g, "''");
    var escRes = String(resultPath).replace(/'/g, "''");
    var escLog = String(getNvGamingLogPath()).replace(/'/g, "''");
    var runner = UNREAL_LOGS + "\\nvidia-gaming-display-ps.ps1";
    var rLines = [
      "& '" + escPs + "' -LogPath '" + escLog + "' -ResultPath '" + escRes + "'",
      "exit $LASTEXITCODE"
    ];
    var tr = fso.CreateTextFile(runner, true);
    tr.Write(rLines.join("\r\n"));
    tr.Close();
    appendNvGamingLogLine("DISPLAY=ps1 fallback");
    runPowerShell("-ExecutionPolicy Bypass -File \"" + runner + "\"");
    try {
      if (fso.FileExists(resultPath)) {
        var json = readTextFileAll(resultPath);
        if (json) {
          var parsed = JSON.parse(json);
          if (parsed && parsed.resolution) {
            payload = {
              displayMode: {
                applied: parsed.globalResult === "ok",
                verified: parsed.resolution.verified === true,
                resolution: parsed.resolution.targetResolution || parsed.resolution.activeResolution || "",
                refreshRate: (parsed.resolution.targetRefresh || parsed.resolution.activeRefresh || "") + "Hz"
              }
            };
          }
        }
        fso.DeleteFile(resultPath, true);
      }
    } catch (eP2) {}
    try { fso.DeleteFile(runner, true); } catch (eD2) {}
  }

  var dm = payload && payload.displayMode ? payload.displayMode : {};
  var res = dm.resolution || "";
  var hz = dm.refreshRate || "";
  if (hz && hz.indexOf("Hz") < 0) hz = hz + "Hz";
  var verified = dm.applied === true && dm.verified === true;
  nvGamingDisplayCache = {
    ok: verified,
    resolution: res,
    refresh: hz,
    verified: verified,
    raw: dm,
    payload: payload,
    messages: (payload && payload.messages) ? payload.messages : []
  };
  if (payload && payload.messages && payload.messages.length) {
    for (var mi = 0; mi < payload.messages.length; mi++) {
      var msg = String(payload.messages[mi] || "");
      if (msg.indexOf("Selected max") === 0 || msg.indexOf("Available display") === 0 ||
          msg.indexOf("Resolution applied") === 0 || msg.indexOf("Refresh rate applied") === 0 ||
          msg.indexOf("Current mode after apply") === 0) {
        appendNvGamingLogLine(msg);
      }
    }
  }
  appendNvGamingLogLine("Resolution applied: " + (verified && res ? "OK" : "Failed"));
  appendNvGamingLogLine("Refresh rate applied: " + (verified && hz ? "OK" : "Failed"));
  if (res && hz) {
    var hzNum = String(hz).replace(/Hz$/i, "");
    appendNvGamingLogLine("Current mode after apply: " + res + " @ " + hzNum + " Hz");
  }
  appendNvGamingLogLine("DISPLAY_RESULT verified=" + verified + " res=" + res + " hz=" + hz);
  return nvGamingDisplayCache;
}

function nvGamingBuildDisplayCacheFromPayload(payload) {
  var dm = payload && payload.displayMode ? payload.displayMode : {};
  var res = dm.resolution || "";
  var hz = dm.refreshRate || "";
  if (hz && hz.indexOf("Hz") < 0) hz = hz + "Hz";
  var verified = dm.applied === true && dm.verified === true;
  nvGamingDisplayCache = {
    ok: verified,
    resolution: res,
    refresh: hz,
    verified: verified,
    raw: dm,
    payload: payload,
    messages: (payload && payload.messages) ? payload.messages : []
  };
  return nvGamingDisplayCache;
}

function runNvGamingDisplayApplyAsync(onDone) {
  nvGamingDisplayCache = null;
  createUnrealFolders();
  var helperPath = getNvidiaDisplayHelperPath();
  if (!helperPath || !fileExists(helperPath)) {
    window.setTimeout(function () {
      try {
        onDone(runNvGamingDisplayApply());
      } catch (eD) {
        onDone({ ok: false, resolution: "", refresh: "", verified: false });
      }
    }, 50);
    return;
  }
  var fso = getFso();
  var stdoutPath = UNREAL_LOGS + "\\nvidia-gaming-display-stdout.json";
  var psPath = UNREAL_LOGS + "\\nvidia-gaming-display-async-run.ps1";
  var escHelper = String(helperPath).replace(/'/g, "''");
  var escOut = String(stdoutPath).replace(/'/g, "''");
  var psLines = [
    "$ErrorActionPreference = 'Continue'",
    "$Helper = '" + escHelper + "'",
    "$StdoutPath = '" + escOut + "'",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Helper",
    "$psi.Arguments = '--apply-full --skip-digital-vibrance --json'",
    "$psi.WorkingDirectory = (Split-Path -Parent $Helper)",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$psi.RedirectStandardOutput = $true",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if ($p) {",
    "  $stdout = $p.StandardOutput.ReadToEnd()",
    "  if (-not $p.WaitForExit(120000)) { try { $p.Kill() } catch {}; exit 124 }",
    "  else { if ($stdout) { [System.IO.File]::WriteAllText($StdoutPath, $stdout, [System.Text.UTF8Encoding]::new($false)) }; exit $p.ExitCode }",
    "}",
    "exit 18"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(psLines.join("\r\n"));
  tw.Close();
  appendNvGamingLogLine("DISPLAY=helper async " + helperPath);
  var shell = new ActiveXObject("WScript.Shell");
  var exec = shell.Exec("powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" + psPath + "\"");
  var t0 = new Date().getTime();
  var hardLimitMs = 125000;
  function finish(cache) {
    try { fso.DeleteFile(psPath, true); } catch (eD) {}
    if (onDone) onDone(cache);
  }
  function poll() {
    if (new Date().getTime() - t0 > hardLimitMs) {
      try { exec.Terminate(); } catch (eK) {}
      finish({ ok: false, resolution: "", refresh: "", verified: false });
      return;
    }
    if (exec.Status === 1) {
      var payload = null;
      try {
        if (fso.FileExists(stdoutPath)) {
          var raw = readTextFileAll(stdoutPath);
          if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
          if (raw) payload = JSON.parse(raw);
          fso.DeleteFile(stdoutPath, true);
        }
      } catch (eP) {
        appendNvGamingLogLine("DISPLAY_ASYNC_PARSE_ERROR=" + String(eP.message || eP));
      }
      if (payload) {
        finish(nvGamingBuildDisplayCacheFromPayload(payload));
      } else {
        window.setTimeout(function () {
          try { finish(runNvGamingDisplayApply()); } catch (eF) { finish({ ok: false, resolution: "", refresh: "", verified: false }); }
        }, 50);
      }
      return;
    }
    window.setTimeout(poll, 400);
  }
  window.setTimeout(poll, 400);
}

function ApplyMaxResolution() {
  appendNvGamingLogLine("STEP=ApplyMaxResolution");
  var d = runNvGamingDisplayApply();
  if (!d || !d.resolution) {
    return makeNvGamingResult("Failed", "RÒ©solution maximale non appliquÒ©e ou non vÒ©rifiable");
  }
  if (d.verified) {
    return makeNvGamingResult("Success", "RÒ©solution " + d.resolution);
  }
  if (d.resolution) {
    return makeNvGamingResult("Failed", "RÒ©solution " + d.resolution + " (non vÒ©rifiÒ©e)");
  }
  return makeNvGamingResult("Failed", "Impossible d'appliquer la rÒ©solution maximale");
}

function ApplyMaxRefreshRate() {
  appendNvGamingLogLine("STEP=ApplyMaxRefreshRate");
  var d = runNvGamingDisplayApply();
  if (!d || !d.refresh) {
    return makeNvGamingResult("Failed", "FrÒ©quence maximale non appliquÒ©e ou non vÒ©rifiable");
  }
  if (d.verified) {
    return makeNvGamingResult("Success", "FrÒ©quence " + d.refresh);
  }
  if (d.refresh) {
    return makeNvGamingResult("Failed", "FrÒ©quence " + d.refresh + " (non vÒ©rifiÒ©e)");
  }
  return makeNvGamingResult("Failed", "Impossible d'appliquer la frÒ©quence maximale");
}

/* --- Nvidia Automation V2 (exe) --- */
function getNvidiaAutomationV2ExePath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var main = getAbsolutePathFs(app + "\\tools\\nvidia-automation-v2\\NvidiaAutomationV2.exe");
  var staging = getAbsolutePathFs(app + "\\tools\\nvidia-automation-v2\\_publish-staging\\NvidiaAutomationV2.exe");
  if (fileExists(staging) && fileExists(main)) {
    try {
      var fso = getFso();
      if (fso.GetFile(staging).DateLastModified > fso.GetFile(main).DateLastModified) return staging;
    } catch (eCmp) {}
  }
  if (fileExists(staging) && !fileExists(main)) return staging;
  if (fileExists(main)) return main;
  if (fileExists(staging)) return staging;
  return "";
}

/* --- Réglages NVIDIA supplémentaires (statuts honnêtes  SAFE_STATUS_2026_05_22) --- */
var NV_EXTRA_UI_VERSION = "SAFE_STATUS_2026_05_22";

function initNvExtraUiVersion() {
  try { appendNvGamingLogLine("NV_EXTRA_UI_VERSION=" + NV_EXTRA_UI_VERSION); } catch (eLog) {}
  var el = $("nvExtraUiVersionLabel");
  if (el) el.innerText = "Version UI NVIDIA extras : " + NV_EXTRA_UI_VERSION;
}

function setNvExtraRegStatus(msg, tone) {
  var el = $("nvExtraRegStatus");
  if (!el) return;
  el.innerHTML = msg;
  var cls = "tcp-badge tcp-badge--progress";
  if (tone === "ok") cls = "tcp-badge tcp-badge--ok";
  else if (tone === "bad") cls = "tcp-badge tcp-badge--bad";
  else if (tone === "warn") cls = "tcp-badge tcp-badge--warn";
  else if (tone === "muted") cls = "tcp-badge tcp-badge--progress";
  el.className = cls;
}

function nvExtraTextHasBlockedGreenTerms(text) {
  var t = String(text || "").toLowerCase();
  var blocked = [
    "non implémenté", "non implemente", "diagnostic", "ignored", "ignoré", "ignore",
    "déjà", "deja", "aucune preuve", "no change", "no scaling", "not implemented",
    "not_implemented", "déjà natif", "deja natif", "relecture seulement"
  ];
  for (var i = 0; i < blocked.length; i++) {
    if (t.indexOf(blocked[i]) >= 0) return true;
  }
  return false;
}

function nvExtraEvidenceImpliesReadAfterApply(evidence) {
  var e = String(evidence || "").toLowerCase();
  if (!e) return false;
  if (e.indexOf("après écriture") >= 0 || e.indexOf("apres ecriture") >= 0) return true;
  if (e.indexOf("relu après application") >= 0 || e.indexOf("relu apres application") >= 0) return true;
  if (e.indexOf("after apply") >= 0) return true;
  return false;
}

/** Vert impossible si message/evidence ambigu  applied+verified+evidence+method requis. */
function nvExtraRenderUi(internal) {
  if (!internal) internal = { status: "error", verified: false, message: "aucun retour", evidence: "", method: "none" };
  var st = String(internal.status || "error");
  var v = internal.verified === true;
  var proof = String(internal.evidence || "").trim();
  var msg = String(internal.message || "");
  var method = String(internal.method || "none");

  if (st === "not_implemented" || method === "none") {
    return { tone: "muted", label: "non implémenté", detail: msg, proof: "" };
  }
  if (st === "ignored") {
    return { tone: "warn", label: "ignoré", detail: msg, proof: proof || "" };
  }
  if (st === "applied") {
    if (!v || proof.length === 0 || method === "none" || nvExtraTextHasBlockedGreenTerms(msg) || nvExtraTextHasBlockedGreenTerms(proof)) {
      return { tone: "bad", label: "erreur", detail: msg || "applied sans preuve fiable", proof: "" };
    }
    if (!nvExtraEvidenceImpliesReadAfterApply(proof) && st === "applied") {
      return { tone: "warn", label: "ignoré", detail: "Pas de mise à l'échelle non confirmé visuellement", proof: proof };
    }
    return { tone: "ok", label: "appliqué", detail: msg, proof: proof };
  }
  return { tone: "bad", label: "erreur", detail: msg || st, proof: "" };
}

function nvExtraFormatStatusLine(title, ui) {
  var line = title + " : <strong>" + ui.label + "</strong>  " + ui.detail;
  if (ui.proof) line += " <span style=\"opacity:0.85\">(" + ui.proof + ")</span>";
  return line;
}

function nvExtraMapV2TelecineStep(step) {
  if (!step || !step.status) {
    return { status: "error", verified: false, method: "registry_xalg_cadence", evidence: "", message: "aucun retour exe" };
  }
  var msg = String(step.message || "");
  var evidence = String(step.evidence || "");
  var modifiedCount = (typeof step.modifiedCount === "number") ? step.modifiedCount : 0;
  var changed = (step.changed === true) || (step.registryChanged === true) || modifiedCount > 0;
  var uiSt = String(step.uiStatus || "");

  if (msg.indexOf("Action non lancée en administrateur") >= 0 || msg.indexOf("not allowed") >= 0 || msg.indexOf("Requested registry access") >= 0) {
    return { status: "error", verified: false, method: "registry_xalg_cadence", evidence: "", message: "Action non lancée en administrateur" };
  }
  if (step.status === "Failed" || uiSt === "error" || (msg.indexOf("Accès registre refusé") >= 0)) {
    return { status: "error", verified: false, method: "registry_xalg_cadence", evidence: "", message: msg || "Accès registre refusé, lancement admin requis" };
  }
  if (step.status === "Skipped" || uiSt === "ignored" || (!changed && modifiedCount === 0)) {
    if (msg.indexOf("Aucune valeur") >= 0) {
      return { status: "ignored", verified: false, method: "registry_xalg_cadence", evidence: evidence, message: msg };
    }
    return { status: "ignored", verified: false, method: "registry_xalg_cadence", evidence: evidence, message: "Déjà à zéro dans le registre, aucune preuve de changement utilisateur" };
  }
  if (changed && step.verified === true && evidence.indexOf("00 00 00 00 00 00 00 00") >= 0 && evidence.indexOf("après écriture") >= 0) {
    return {
      status: "ignored",
      verified: false,
      method: "registry_xalg_cadence",
      evidence: evidence,
      message: "Registre modifié, panneau NVIDIA non confirmé"
    };
  }
  if (step.status === "Success" && !changed) {
    return { status: "ignored", verified: false, method: "registry_xalg_cadence", evidence: evidence, message: "Déjà à zéro dans le registre, aucune preuve de changement utilisateur" };
  }
  return { status: "error", verified: false, method: "registry_xalg_cadence", evidence: "", message: msg || step.status };
}

function nvExtraMapScalingPayload(payload) {
  var sc = payload && payload.scaling ? payload.scaling : null;
  if (!sc) {
    return { status: "error", verified: false, method: "display_helper_existing", evidence: "", message: "Réponse helper affichage vide" };
  }
  var mode = String(sc.mode || "");
  var evidence = String(sc.evidence || "");
  var modeLc = mode.toLowerCase();
  var evLc = evidence.toLowerCase();

  if (sc.uiStatus === "not_implemented") {
    return { status: "not_implemented", verified: false, method: "display_helper_existing", evidence: "", message: "Pas de mise à l'échelle non vérifiable dans le helper actuel" };
  }
  if (sc.uiStatus === "ignored" || modeLc.indexOf("no change") >= 0 || modeLc.indexOf("déjà") >= 0 || modeLc.indexOf("deja") >= 0 || evLc.indexOf("déjà") >= 0) {
    return { status: "ignored", verified: false, method: "display_helper_existing", evidence: evidence, message: "Pas de mise à l'échelle non confirmé visuellement" };
  }
  if (modeLc.indexOf("no scaling") >= 0 && sc.verified !== true) {
    return { status: "ignored", verified: false, method: "display_helper_existing", evidence: "", message: mode || "No scaling  preuve insuffisante" };
  }
  if (sc.scalingChanged === true && sc.uiStatus === "applied" && sc.verified === true && evidence && nvExtraEvidenceImpliesReadAfterApply(evidence)) {
    return { status: "applied", verified: true, method: "display_helper_existing", evidence: evidence, message: mode || "Pas de mise à l'échelle" };
  }
  if (sc.applied === true && sc.verified !== true) {
    return { status: "error", verified: false, method: "display_helper_existing", evidence: "", message: "Scaling appliqué sans relecture confirmée" };
  }
  return { status: "ignored", verified: false, method: "display_helper_existing", evidence: evidence, message: "Pas de mise à l'échelle non confirmé visuellement" };
}

function runUnrealDisplayHelperExecAsync(helperArgs, logTag, timeoutMs, onDone) {
  createUnrealFolders();
  var helper = getNvidiaDisplayHelperPath();
  if (!helper || !fileExists(helper)) {
    if (onDone) onDone({ error: "UnrealNvidiaDisplayHelper.exe introuvable  lancez tools/nvidia-display-helper/build.ps1" });
    return;
  }
  var stdoutPath = UNREAL_LOGS + "\\" + logTag + "-result.json";
  var psPath = UNREAL_LOGS + "\\" + logTag + "-run.ps1";
  var escHelper = String(helper).replace(/'/g, "''");
  var escOut = String(stdoutPath).replace(/'/g, "''");
  var waitMs = timeoutMs || 60000;
  var fso = getFso();
  var psLines = [
    "$ErrorActionPreference = 'Continue'",
    "$Helper = '" + escHelper + "'",
    "$StdoutPath = '" + escOut + "'",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Helper",
    "$psi.Arguments = '" + helperArgs + "'",
    "$psi.WorkingDirectory = (Split-Path -Parent $Helper)",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$psi.RedirectStandardOutput = $true",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if ($p) {",
    "  $stdout = $p.StandardOutput.ReadToEnd()",
    "  if (-not $p.WaitForExit(" + waitMs + ")) { try { $p.Kill() } catch {}; $stdout = '{\"success\":false,\"messages\":[\"timeout\"]}' }",
    "  if (-not $stdout -or $stdout.Trim().Length -eq 0) { $stdout = '{\"success\":false,\"messages\":[\"stdout vide\"]}' }",
    "  [System.IO.File]::WriteAllText($StdoutPath, $stdout, [System.Text.UTF8Encoding]::new($false))",
    "  exit 0",
    "}",
    "exit 18"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(psLines.join("\r\n"));
  tw.Close();
  appendNvGamingLogLine("DISPLAY_HELPER=" + logTag + " args=" + helperArgs);
  var shell = new ActiveXObject("WScript.Shell");
  var exec = shell.Exec("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psPath + "\"");
  var t0 = new Date().getTime();
  var hardLimitMs = waitMs + 5000;
  function finish(r) { if (onDone) onDone(r); }
  function readPayload() {
    try {
      if (fso.FileExists(stdoutPath)) {
        var raw = readTextFileAll(stdoutPath);
        if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
        var payload = raw ? JSON.parse(raw) : null;
        fso.DeleteFile(stdoutPath, true);
        if (payload) return { payload: payload };
      }
    } catch (eP) {}
    try { fso.DeleteFile(psPath, true); } catch (eD) {}
    return { error: "Réponse helper affichage illisible", payload: null };
  }
  function poll() {
    if (new Date().getTime() - t0 > hardLimitMs) {
      try { exec.Terminate(); } catch (eK) {}
      finish({ error: "timeout helper affichage", payload: null });
      return;
    }
    if (exec.Status === 1) { finish(readPayload()); return; }
    window.setTimeout(poll, 400);
  }
  window.setTimeout(poll, 400);
}

function runNvExtraInverseTelecineAdminAsync(onDone) {
  var exe = getNvidiaAutomationV2ExePath();
  var app = getAppFolderFromHta();
  if (!exe || !fileExists(exe)) {
    if (onDone) onDone({ error: "NvidiaAutomationV2.exe introuvable  lancez tools/nvidia-automation-v2/build.ps1" });
    return;
  }
  if (!app) {
    if (onDone) onDone({ error: "Dossier application introuvable" });
    return;
  }
  var fso = getFso();
  var resultPath = getAbsolutePathFs(app + "\\logs\\nv-extra-it-result.json");
  try {
    var logsDir = fso.GetParentFolderName(resultPath);
    if (logsDir && !fso.FolderExists(logsDir)) fso.CreateFolder(logsDir);
    if (fso.FileExists(resultPath)) fso.DeleteFile(resultPath, true);
  } catch (ePrep) {}

  var args = "--disable-inverse-telecine-registry-only --json --purpleboost-root \"" + app + "\" --result-file \"" + resultPath + "\"";
  appendNvGamingLogLine("NV_EXTRA_IT admin ShellExecute runas result=" + resultPath);
  try {
    launchFileAsAdminWithArgs(exe, args);
  } catch (eLaunch) {
    if (onDone) onDone({ error: "0lévation administrateur refusée ou impossible" });
    return;
  }

  var t0 = new Date().getTime();
  var waitMs = 120000;
  function finish(r) { if (onDone) onDone(r); }
  function tryRead() {
    try {
      if (!fso.FileExists(resultPath)) return null;
      var raw = readTextFileAll(resultPath);
      var payload = parseNvV2JsonFromRaw(raw);
      if (payload && payload.inverseTelecine) return { payload: payload };
    } catch (eR) {}
    return null;
  }
  function poll() {
    if (new Date().getTime() - t0 > waitMs) {
      finish({
        error: "timeout",
        payload: makeEmptyNvV2Payload("Action non lancée en administrateur ou timeout UAC")
      });
      return;
    }
    var got = tryRead();
    if (got) {
      finish(got);
      return;
    }
    window.setTimeout(poll, 500);
  }
  window.setTimeout(poll, 800);
}

function applyNvExtraInverseTelecineFromUi() {
  setNvExtraRegStatus("Désactivation téléciné inversée (élévation admin)⬦", "progress");
  appendNvGamingLogLine("NV_EXTRA=inverse_telecine_admin");
  runNvExtraInverseTelecineAdminAsync(function (r) {
    var payload = (r && r.payload) ? r.payload : null;
    var step = (payload && payload.inverseTelecine) ? payload.inverseTelecine : { status: "Failed", message: r && r.error ? r.error : "échec", verified: false, changed: false };
    var internal = nvExtraMapV2TelecineStep(step);
    var ui = nvExtraRenderUi(internal);
    setNvExtraRegStatus(nvExtraFormatStatusLine("Téléciné inversée", ui), ui.tone);
    appendNvGamingLogLine("NV_EXTRA_IT status=" + internal.status + " verified=" + internal.verified + " changed=" + (step.changed === true));
  });
}

function getNvidiaPanelClickerExePath() {
  var app = getAppFolderFromHta();
  if (!app) return "";
  var p = getAbsolutePathFs(app + "\\tools\\nvidia-panel-clicker\\NvidiaPanelClicker.exe");
  return fileExists(p) ? p : "";
}

function setNvPanelClickerStatus(msg, tone) {
  var el = $("nvPanelClickerStatus");
  if (!el) return;
  el.innerHTML = msg;
  var cls = "tcp-badge tcp-badge--progress";
  if (tone === "ok") cls = "tcp-badge tcp-badge--ok";
  else if (tone === "bad") cls = "tcp-badge tcp-badge--bad";
  else if (tone === "warn") cls = "tcp-badge tcp-badge--warn";
  else if (tone === "muted") cls = "tcp-badge tcp-badge--progress";
  el.className = cls;
}

function nvPanelMapClickerResult(payload) {
  if (!payload || payload.uiStatus === "error") {
    return { tone: "bad", title: "erreur", detail: (payload && payload.message) ? payload.message : "Panneau NVIDIA introuvable" };
  }
  if (payload.verified === true && payload.uiStatus === "panel_verified") {
    return { tone: "ok", title: "confirmé", detail: payload.message || "Action panneau confirmée" };
  }
  return { tone: "warn", title: "envoyé", detail: payload.message || "Action panneau envoyée  vérification visuelle requise" };
}

function runNvidiaPanelClickerExecAsync(task, logTag, timeoutMs, onDone, dedicatedLogFile) {
  createUnrealFolders();
  var exe = getNvidiaPanelClickerExePath();
  if (!exe || !fileExists(exe)) {
    if (onDone) onDone({ error: "NvidiaPanelClicker.exe introuvable  lancez tools/nvidia-panel-clicker/build.ps1" });
    return;
  }
  var app = getAppFolderFromHta();
  var resultPath = getAbsolutePathFs(app + "\\logs\\" + logTag + "-result.json");
  var psPath = UNREAL_LOGS + "\\" + logTag + "-run.ps1";
  var escExe = String(exe).replace(/'/g, "''");
  var escRoot = String(app || "").replace(/'/g, "''");
  var escResult = String(resultPath).replace(/'/g, "''");
  var waitMs = timeoutMs || 90000;
  var fso = getFso();
  try {
    var logsDir = fso.GetParentFolderName(resultPath);
    if (logsDir && !fso.FolderExists(logsDir)) fso.CreateFolder(logsDir);
    if (fso.FileExists(resultPath)) fso.DeleteFile(resultPath, true);
  } catch (ePrep) {}
  var cliArgs = "--json --purpleboost-root \"" + app + "\" --task " + task + " --result-file \"" + resultPath + "\"";
  if (dedicatedLogFile) {
    cliArgs += " --log-file \"" + String(dedicatedLogFile).replace(/\\/g, "\\\\") + "\"";
  }
  var psLines = [
    "$ErrorActionPreference = 'Continue'",
    "$Exe = '" + escExe + "'",
    "$ResultPath = '" + escResult + "'",
    "$psi = New-Object System.Diagnostics.ProcessStartInfo",
    "$psi.FileName = $Exe",
    "$psi.Arguments = '" + cliArgs.replace(/'/g, "''") + "'",
    "$psi.WorkingDirectory = (Split-Path -Parent $Exe)",
    "$psi.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
    "$psi.CreateNoWindow = $true",
    "$psi.UseShellExecute = $false",
    "$psi.RedirectStandardOutput = $true",
    "$p = [System.Diagnostics.Process]::Start($psi)",
    "if ($p) {",
    "  $null = $p.StandardOutput.ReadToEnd()",
    "  if (-not $p.WaitForExit(" + waitMs + ")) { try { $p.Kill() } catch {} }",
    "  exit 0",
    "}",
    "exit 18"
  ];
  var tw = fso.CreateTextFile(psPath, true);
  tw.Write(psLines.join("\r\n"));
  tw.Close();
  appendNvGamingLogLine("NV_PANEL_CLICKER=" + logTag + " task=" + task);
  var shell = new ActiveXObject("WScript.Shell");
  var exec = shell.Exec("powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File \"" + psPath + "\"");
  var t0 = new Date().getTime();
  var hardLimitMs = waitMs + 8000;
  function finish(r) { if (onDone) onDone(r); }
  function readPayload() {
    try {
      if (fso.FileExists(resultPath)) {
        var raw = readTextFileAll(resultPath);
        if (raw && raw.charCodeAt(0) === 0xFEFF) raw = raw.substring(1);
        var payload = raw ? JSON.parse(raw) : null;
        if (payload) return { payload: payload };
      }
    } catch (eP) {}
    try { fso.DeleteFile(psPath, true); } catch (eD) {}
    return { error: "Réponse NvidiaPanelClicker illisible", payload: null };
  }
  function poll() {
    if (new Date().getTime() - t0 > hardLimitMs) {
      try { exec.Terminate(); } catch (eK) {}
      finish({ error: "timeout panneau NVIDIA", payload: null });
      return;
    }
    if (exec.Status === 1) { finish(readPayload()); return; }
    window.setTimeout(poll, 500);
  }
  window.setTimeout(poll, 500);
}

