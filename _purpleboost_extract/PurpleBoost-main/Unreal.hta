  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) return getAbsolutePathFs(combinePath(app, "logs\\hidusbf-registry-diff.json"));
  return UNREAL_LOGS + "\\hidusbf-registry-diff.json";
}

function isHidusbfAutoMethodValidated() {
  try {
    var jsonPath = getHidusbfRegistryDiffJsonPath();
    if (jsonPath && getFso().FileExists(jsonPath)) {
      var j = JSON.parse(String(readUtf8TextFileAll(jsonPath) || "{}"));
      if (j && j.HasDiff === true && j.ChangeCount > 0) return true;
    }
    var diffPath = getHidusbfRegistryDiffPath();
    if (!diffPath || !getFso().FileExists(diffPath)) return false;
    var txt = String(readUtf8TextFileAll(diffPath) || "");
    if (!txt || /\(no differences\)/i.test(txt)) return false;
    return /\->/.test(txt);
  } catch (eDiff) {
    return false;
  }
}

function writeControllerApplyVerificationResult(payload) {
  try {
    var path = getControllerOverclockerApplyResultPath();
    var outDir = getFso().GetParentFolderName(path);
    if (outDir && !getFso().FolderExists(outDir)) getFso().CreateFolder(outDir);
    writeUtf8TextFileAll(path, JSON.stringify(payload || {}, null, 2));
  } catch (eWrite) {}
}

function refreshControllerPollingStatusSync(silent) {
  var dev = getSelectedControllerDevice();
  if (!dev) return null;
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var psPath = getControllerOcStatusScriptPath();
  if (!psPath || !getFso().FileExists(psPath)) return null;
  var logPath = getControllerOverclockerLogPath();
  var outPath = getControllerOverclockerStatusJsonPath();
  var instanceId = String(dev.InstanceId || dev.DeviceId || "");
  var usbParent = String(dev.TargetHidusbfDeviceId || dev.UsbCompositeParentId || dev.UsbParentDeviceId || "");
  writeControllerOverclockerLog("[DEVICE] Reading OC status");
  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + psPath + '"' +
    ' -AppRoot "' + escapeControllerPsArg(app) + '"' +
    ' -LogPath "' + escapeControllerPsArg(logPath) + '"' +
    ' -OutputPath "' + escapeControllerPsArg(outPath) + '"' +
    ' -DeviceInstanceId "' + escapeControllerPsArg(instanceId) + '"' +
    ' -UsbParentDeviceId "' + escapeControllerPsArg(usbParent) + '"' +
    ' -Vid "' + escapeControllerPsArg(dev.Vid || "") + '"' +
    ' -Pid "' + escapeControllerPsArg(dev.Pid || "") + '"' +
    (silent ? " -Quiet" : "");
  try {
    getShell().Run(cmd, 0, true);
  } catch (eRun) {
    return null;
  }
  var status = readControllerPollingStatusResult();
  controllerOverclockerState.statusPending = false;
  controllerOverclockerState.statusLoaded = true;
  if (status) {
    writeControllerOverclockerLog("[DEVICE] ConfirmedRate=" + String(status.ConfirmedRate != null ? status.ConfirmedRate : "?"));
    writeControllerOverclockerLog("[DEVICE] Status=" + String(status.Status || "?"));
    renderControllerPollingStatusUi(status);
  }
  return status;
}

function verifyControllerPollingAfterApply(requestedHz, status) {
  if (!status || !requestedHz) {
    return { verified: false, detected: "Unknown", detectedRate: 0, detectedLabel: "Unknown" };
  }
  var detected = String(status.Status || "Unknown");
  var rate = parseInt(status.ConfirmedRate, 10);
  if (isNaN(rate)) rate = parseInt(status.ConfiguredRate, 10) || 125;
  var verified = status.Optimized === true && rate === requestedHz;
  if (requestedHz === 1000) {
    verified = verified && detected === "Optimized1000" && rate === 1000;
  } else if (requestedHz === 8000) {
    verified = verified && detected === "Optimized8000" && rate === 8000;
  }
  if (detected === "Default" || rate <= 125) verified = false;
  if (requestedHz >= 1000 && rate >= 1000 && rate !== requestedHz) verified = false;
  return {
    verified: verified,
    detected: detected,
    detectedRate: rate,
    detectedLabel: (rate > 0 ? String(rate) + " Hz" : detected)
  };
}

function formatControllerDetectedRateForLog(status) {
  if (!status) return "Unknown";
  if (status.Status === "Default" || (parseInt(status.ConfiguredRate, 10) || 125) <= 125) return "Default";
  if (status.Status === "Optimized1000") return "1000";
  if (status.Status === "Optimized8000") return "8000";
  return String(status.ConfiguredRate || status.Status || "Unknown");
}

