    <button class="navbtn" type="button" data-page="settings" onclick="showPage('settings')">Réglages</button>
  </nav>
  <div class="sidebar-foot">HTA portable · WMI ActiveX · confirmations obligatoires pour actions système.</div>
</aside>
<section class="main">
<div class="content">

<div id="page-home" class="page active page-home-root">
  <h2 class="page-title">Accueil</h2>
  <div class="home-hero">
    <div class="home-hero-inner">
      <div class="home-hero-glass">
        <div class="home-hero-kicker">UNREAL</div>
        <div class="home-hero-core hero-logo-stack"><img id="brandLogoPngHero" class="brand-logo-png brand-logo-png--hero" src="assets/images/unreal-logo.png" alt=""/><svg id="brandLogoSvgHero" class="brand-logomark brand-logomark--hero" viewBox="0 0 100 118" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs><linearGradient id="ublHero" x1="0" y1="118" x2="100" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#22d3ee"/><stop offset="34%" stop-color="#4338ca"/><stop offset="66%" stop-color="#a855f7"/><stop offset="100%" stop-color="#fb7185"/></linearGradient></defs><path class="ubl-stroke-white" fill="none" stroke="#f8f7ff" stroke-width="13" stroke-linejoin="miter" stroke-miterlimit="6" stroke-linecap="butt" d="M 8 58 L 20 46 L 20 90 L 50 112 L 80 86 L 80 40 L 94 26"/><path class="ubl-stroke-grad" fill="none" stroke="url(#ublHero)" stroke-width="8" stroke-linejoin="miter" stroke-miterlimit="6" stroke-linecap="butt" d="M 8 58 L 20 46 L 20 90 L 50 112 L 80 86 L 80 40 L 94 26"/></svg></div>
        <div class="home-hero-title">AU SERVICE DE VOS PERFORMANCES</div>
      </div>
    </div>
  </div>
  <div style="margin-top:10px;">
