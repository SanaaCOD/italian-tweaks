function clearControllerOcApplyArtifacts() {
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var fso = getFso();
  var paths = [
    getControllerOverclockerParamsPath(),
    getControllerOverclockerApplyResultPath(),
    app ? getAbsolutePathFs(combinePath(app, "logs\\controller-overclocker-apply-result.json")) : "",
    app ? getAbsolutePathFs(combinePath(app, "logs\\controller-overclocker-exitcode.txt")) : ""
  ];
  var i;
  for (i = 0; i < paths.length; i++) {
    try {
      if (paths[i] && fso.FileExists(paths[i])) fso.DeleteFile(paths[i], true);
    } catch (eDel) {}
  }
}

function writeControllerOverclockerParamsFile(app, logPath, params) {
  var paramPath = getControllerOverclockerParamsPath();
  try {
    var outDir = getFso().GetParentFolderName(paramPath);
    if (outDir && !getFso().FolderExists(outDir)) getFso().CreateFolder(outDir);
  } catch (eMk) {}
  var instanceId = String(params.instanceId || "");
  if (!isValidControllerDeviceInstanceId(instanceId)) {
    instanceId = "";
  }
  var payload = {
    AppRoot: String(app || ""),
    LogPath: String(logPath || ""),
    DeviceInstanceId: instanceId,
    UsbParentDeviceId: String(params.usbParentDeviceId || ""),
    Vid: String(params.vid || ""),
    Pid: String(params.pid || ""),
    MaxRateHz: params.maxRateHz ? parseInt(params.maxRateHz, 10) : 0,
    Uninstall: !!params.uninstall,
    Mode: String(params.mode || "")
  };
  writeUtf8TextFileAll(paramPath, JSON.stringify(payload, null, 2));
  return paramPath;
}

function getHidusbfToolsPath() {
  var bundle = resolveHidusbfBundle();
  return bundle.root || "";
}

function findHidusbfAssetRecursive(rootDir, leafName, depth) {
  if (!rootDir || depth > 10) return "";
  var fso = getFso();
  try {
    var folder = fso.GetFolder(rootDir);
    var files = new Enumerator(folder.Files);
    for (; !files.atEnd(); files.moveNext()) {
      if (String(files.item().Name).toUpperCase() === String(leafName || "").toUpperCase()) {
        return String(files.item().Path);
      }
    }
    if (depth >= 10) return "";
    var subs = new Enumerator(folder.SubFolders);
    for (; !subs.atEnd(); subs.moveNext()) {
      var hit = findHidusbfAssetRecursive(String(subs.item().Path), leafName, depth + 1);
      if (hit) return hit;
    }
  } catch (eFind) {}
  return "";
}

function resolveHidusbfBundle() {
  initApplicationBaseDirectory();
  var fso = getFso();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var htaDir = getUnrealHtaDirectory() || "";
  var roots = [];
  var seen = {};
  function addRoot(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d]) return;
    seen[d] = true;
    if (fso.FolderExists(d)) roots.push(d);
  }
  if (app) {
    addRoot(combinePath(app, "Tools\\hidusbf"));
    addRoot(combinePath(app, "tools\\hidusbf"));
  }
  if (htaDir && htaDir !== app) {
    addRoot(combinePath(htaDir, "Tools\\hidusbf"));
    addRoot(combinePath(htaDir, "tools\\hidusbf"));
  }
  var relInfPaths = [
    "HIDUSBF_AS.INF",
    "hidusbf\\DRIVER\\HIDUSBF_AS.INF",
    "HIDUSBF\\DRIVER\\HIDUSBF_AS.INF",
    "DRIVER\\HIDUSBF_AS.INF"
  ];
  var i;
  var j;
  for (i = 0; i < roots.length; i++) {
    var recursiveInf = findHidusbfAssetRecursive(roots[i], "HIDUSBF_AS.INF", 0);
    if (recursiveInf) {
      return { found: true, root: roots[i], infPath: recursiveInf };
    }
    for (j = 0; j < relInfPaths.length; j++) {
      var infPath = getAbsolutePathFs(combinePath(roots[i], relInfPaths[j]));
      if (infPath && fso.FileExists(infPath)) {
        return { found: true, root: roots[i], infPath: infPath };
      }
    }
  }
  var fallback = roots.length ? roots[0] : (app ? getAbsolutePathFs(combinePath(app, "Tools\\hidusbf")) : "");
  return { found: false, root: fallback, infPath: "" };
}

function findHidusbfRateDriverSys(rootDir, rateFolderName, depth) {
  if (!rootDir || depth > 10) return "";
  var fso = getFso();
  try {
    var folder = fso.GetFolder(rootDir);
    if (String(folder.Name).toUpperCase() === String(rateFolderName || "").toUpperCase()) {
      var sysPath = getAbsolutePathFs(combinePath(folder.Path, "hidusbf.sys"));
      if (sysPath && fso.FileExists(sysPath)) return sysPath;
    }
    var subs = new Enumerator(folder.SubFolders);
    for (; !subs.atEnd(); subs.moveNext()) {
      var hit = findHidusbfRateDriverSys(String(subs.item().Path), rateFolderName, depth + 1);
      if (hit) return hit;
    }
  } catch (eRate) {}
  return "";
}

function isHidusbfBundledPresent() {
  var bundle = resolveHidusbfBundle();
  if (!bundle.found || !bundle.root) return false;
  var fso = getFso();
  var cert = findHidusbfAssetRecursive(bundle.root, "SweetLow.CER", 0);
  if (!cert || !fso.FileExists(cert)) return false;
  var infU = findHidusbfAssetRecursive(bundle.root, "HIDUSBFU.INF", 0);
  if (!infU || !fso.FileExists(infU)) return false;
  var sys1k = findHidusbfRateDriverSys(bundle.root, "1khz", 0);
  if (!sys1k) sys1k = findHidusbfRateDriverSys(bundle.root, "1kHz", 0);
  return !!sys1k;
}

function writeControllerOverclockerLog(line) {
  try {
    var path = getControllerOverclockerLogPath();
    var fso = getFso();
    var folder = fso.GetParentFolderName(path);
    if (folder && !fso.FolderExists(folder)) fso.CreateFolder(folder);
    var ForAppending = 8;
    if (!fso.FileExists(path)) {
      var t0 = fso.CreateTextFile(path, true);
      t0.WriteLine(line);
      t0.Close();
    } else {
      var t1 = fso.OpenTextFile(path, ForAppending, true);
      t1.WriteLine(line);
      t1.Close();
    }
  } catch (eLog) {}
  appendControllerOverclockerUiLog(line);
}

function appendControllerOverclockerUiLog(message) {
  /* Logs fichier uniquement  jamais affichs dans l'UI. */
}

function setControllerOverclockerStatus(message, kind) {
  var line = $("cocStateLine");
  if (line) {
    line.innerText = String(message || "");
    line.className = "coc-state-line" + (kind ? " coc-state-line--" + kind : "");
  }
  var el = $("controllerOverclockerStatus");
  if (el) {
    el.style.display = message ? "" : "none";
    el.innerText = message || "";
    el.className = "tool-status" + (kind ? " tool-status--" + kind : "");
  }
}

function updateControllerOverclockerHidusbfBadge() {
  var badge = $("controllerOverclockerHidusbfBadge");
  if (!badge) return;
  var bundle = resolveHidusbfBundle();
  writeControllerOverclockerLog("[DEVICE] HIDUSBF path: " + (bundle.root || "(non r\u00e9solu)"));
  writeControllerOverclockerLog("[DEVICE] HIDUSBF detected: " + (bundle.found ? "true" : "false"));
  if (bundle.found) {
    badge.innerText = "HIDUSBF : d\u00e9tect\u00e9";
    badge.className = "tcp-badge tcp-badge--ok";
  } else {
    badge.innerText = "HIDUSBF : introuvable";
    badge.className = "tcp-badge tcp-badge--err";
  }
}

function updateControllerOverclockerSelectionUi() {
  var sel = $("controllerOverclockerSelect");
  var idx = sel ? parseInt(sel.value, 10) : -1;
  if (isNaN(idx)) idx = -1;
  controllerOverclockerState.selectedIndex = idx;
  var dev = idx >= 0 && controllerOverclockerState.devices[idx] ? controllerOverclockerState.devices[idx] : null;
  if (dev) dev = controllerCoFinalizeCard(dev);
  var lineEl = $("cocDeviceLine");
  var badgeEl = $("controllerOverclockerDeviceBadge");
  if (lineEl) {
    if (!dev) {
      lineEl.innerText = "Aucun p\u00e9riph\u00e9rique s\u00e9lectionn\u00e9";
    } else {
      var devName = fixUtf8Mojibake(dev.DisplayName || dev.Name || dev.FriendlyName || "P\u00e9riph\u00e9rique");
      var badge = fixUtf8Mojibake(dev.Badge || dev.Type || "");
      lineEl.innerText = devName + (badge ? (" [" + badge + "]") : "");
      if (!dev.ParentResolved || !dev.UsbParentDeviceId) {
        lineEl.innerText += " \u2014 Parent USB composite introuvable";
      }
    }
  }
  if (badgeEl) {
    badgeEl.innerText = dev ? fixUtf8Mojibake(String(dev.Badge || dev.Type || "\u2014")).toUpperCase() : "\u2014";
  }
  var maxEl = $("cocMaxRate");
  if (maxEl) {
    var maxHz = dev ? parseInt(dev.MaxRateHz, 10) : 0;
    if (dev && (isNaN(maxHz) || maxHz <= 0)) {
      maxHz = controllerCoInferMaxRateHz(dev.Type, dev.Badge, dev.Vid, dev.Pid, dev.ChildName, dev.DisplayName);
      dev.MaxRateHz = maxHz;
    }
    maxEl.innerText = maxHz > 0 ? (maxHz + " Hz") : "\u2014";
  }
  if (!dev) {
    try { renderControllerPollingStatusUi(null); } catch (eNoDev) {}
  }
  updateControllerApplyUi();
}

function updateControllerApplyUi() {
  var dev = getSelectedControllerDevice();
  if (dev) dev = controllerCoFinalizeCard(dev);
  var btn = $("btnBoostControllerMax");
  var bR = $("btnControllerRestoreDefault");
  var busy = !!controllerOverclockerState.busy;
  if (!btn) return;
  if (!dev) {
    btn.disabled = true;
    btn.innerText = "Aucune manette";
    if (bR) bR.disabled = busy;
    return;
  }
  var maxHz = parseInt(dev.MaxRateHz, 10);
  if (isNaN(maxHz) || maxHz <= 0) {
    maxHz = controllerCoInferMaxRateHz(dev.Type, dev.Badge, dev.Vid, dev.Pid, dev.ChildName, dev.DisplayName);
    dev.MaxRateHz = maxHz;
  }
  var canApply = dev.ParentResolved && !!dev.UsbParentDeviceId;
  if (!canApply) {
    btn.disabled = true;
    btn.innerText = "Parent USB introuvable";
  } else {
    btn.disabled = busy;
    btn.innerText = maxHz >= 8000 ? "Booster \u00e0 8000 Hz" : "Booster \u00e0 1000 Hz";
  }
  if (bR) bR.disabled = busy || !canApply;
}

function applySelectedControllerMaxRate() {
  var dev = getSelectedControllerDevice();
  if (!dev) {
    setControllerOverclockerStatus("Aucune manette s\u00e9lectionn\u00e9e", "error");
    return;
  }
  dev = controllerCoFinalizeCard(dev);
  var maxHz = parseInt(dev.MaxRateHz, 10);
  if (isNaN(maxHz) || maxHz <= 0) {
    maxHz = controllerCoInferMaxRateHz(dev.Type, dev.Badge, dev.Vid, dev.Pid, dev.ChildName, dev.DisplayName);
    dev.MaxRateHz = maxHz;
  }
  writeControllerOverclockerLog("[DEVICE] Boost max clicked");
  writeControllerOverclockerLog("[DEVICE] Selected controller=" + String(dev.DeviceInstanceId || dev.InstanceId || ""));
  writeControllerOverclockerLog("[DEVICE] Selected VID/PID=" + dev.Vid + "/" + dev.Pid);
  writeControllerOverclockerLog("[DEVICE] Selected MaxRateHz=" + maxHz);
  if (!dev.ParentResolved || !dev.UsbParentDeviceId) {
    setControllerOverclockerStatus("Parent USB composite introuvable", "error");
    return;
  }
  if (maxHz !== 1000 && maxHz !== 8000) {
    setControllerOverclockerStatus("Rate max non support\u00e9 pour cette manette", "error");
    return;
  }
  writeControllerOverclockerLog("[DEVICE] Calling Apply-ControllerOC RateHz=" + maxHz);
  controllerOverclockerState.uiLastClickedRate = maxHz;
  runControllerOverclockerAction("apply", maxHz);
}

function handleControllerApplyResult(applyResult, requestedRate) {
  if (!applyResult) {
    setControllerOverclockerStatus("\u00c9chec application", "error");
    return;
  }
  var req = parseInt(applyResult.RequestedRate, 10) || parseInt(requestedRate, 10) || 0;
  var conf = parseInt(applyResult.ConfirmedRate, 10);
  if (isNaN(conf)) conf = 125;
  var code = String(applyResult.Code || "");

  if (code === "RATE_1000_FAILED_STILL_8000" || code === "1000_STILL_HAS_8000_PATCH" || (req === 1000 && conf === 8000)) {
    setControllerOverclockerStatus("\u00c9chec application 1000 Hz \u2014 8000 Hz d\u00e9tect\u00e9", "warn");
    return;
  }
  if (code === "DRIVER_VARIANT_MISMATCH_1000" || code === "RATE_1000_USING_8000_VARIANT" || code === "APPLY_1000_FAILED") {
    setControllerOverclockerStatus(req === 1000 ? "\u00c9chec boost 1000 Hz" : "\u00c9chec application 1000 Hz", "error");
    return;
  }
  if (code === "DRIVER_VARIANT_MISMATCH_8000" || code === "ACTIVE_RATE_MISMATCH") {
    setControllerOverclockerStatus("\u00c9chec application 8000 Hz", "error");
    return;
  }
  if (code === "APPLIED_1000_CONFIRMED" || (req === 1000 && conf === 1000 && applyResult.Success === true)) {
    setControllerOverclockerStatus("Optimis\u00e9 1000 Hz confirm\u00e9", "success");
    return;
  }
  if (code === "APPLIED_8000_CONFIRMED" || (req === 8000 && conf === 8000 && applyResult.Success === true)) {
    setControllerOverclockerStatus("Optimis\u00e9 8000 Hz confirm\u00e9", "success");
    return;
  }
  if (code === "PREPARED_NEEDS_RECONNECT") {
    setControllerOverclockerStatus(req + " Hz pr\u00e9par\u00e9 \u2014 rebranche la manette", "warn");
    return;
  }
  if (applyResult.Success === true) {
    setControllerOverclockerStatus(fixUtf8Mojibake(String(applyResult.Message || "Application termin\u00e9e")), "info");
    return;
  }
  setControllerOverclockerStatus(fixUtf8Mojibake(String(applyResult.Message || "\u00c9chec application")), "error");
}

function controllerCoEscapeHtml(text) {
  return String(text || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function showControllerAssistedGuide(rateHz) {
  var guide = $("controllerOverclockerAssistedGuide");
  if (!guide) return;
  var dev = getSelectedControllerDevice();
  var vid = dev && dev.Vid ? dev.Vid : "054C";
  var pid = dev && dev.Pid ? dev.Pid : "0CE6";
  var typeName = dev && dev.Type ? fixUtf8Mojibake(dev.Type) : "DualSense";
  var rateStep = rateHz
    ? ("Choisis le rate demand\u00e9 : " + rateHz)
    : "Choisis le rate demand\u00e9 : 1000 ou 8000";
  controllerOverclockerState.assistedGuideRate = rateHz || 0;
  guide.innerHTML =
    "<strong>Mode assist\u00e9 \u2014 \u00e9tapes dans HIDUSBF Setup :</strong>" +
    "<ol style=\"margin:8px 0 0 18px;padding:0;font-size:12px;line-height:1.55;\">" +
    "<li>S\u00e9lectionne la ligne de la manette correspondant \u00e0 :<br>VID " +
    controllerCoEscapeHtml(vid) + " / PID " + controllerCoEscapeHtml(pid) + " / " +
    controllerCoEscapeHtml(typeName) + "</li>" +
    "<li>Coche \u00ab Filter On Device \u00bb</li>" +
    "<li>" + controllerCoEscapeHtml(rateStep) + "</li>" +
    "<li>Clique \u00ab Install Service \u00bb</li>" +
    "<li>Clique \u00ab Restart \u00bb</li>" +
    "<li>D\u00e9branche/rebranche la manette si n\u00e9cessaire</li>" +
    "</ol>" +
    (!isHidusbfAutoMethodValidated()
      ? ""
      : "");
  guide.style.display = "";
}

function hideControllerAssistedGuide() {
  var guide = $("controllerOverclockerAssistedGuide");
  if (guide) guide.style.display = "none";
  controllerOverclockerState.assistedGuideRate = 0;
}

function logControllerAssistedSetupOpened() {
  writeControllerOverclockerLog("[DEVICE] HIDUSBF Setup opened");
  writeControllerOverclockerLog("[DEVICE] Manual action required");
  writeControllerOverclockerLog("[DEVICE] Result: setup_opened_not_applied");
}

function setControllerAssistedSetupStatus() {
  setControllerOverclockerStatus(
    "Mode assist\u00e9 : HIDUSBF Setup est ouvert, applique le rate dans la fen\u00eatre.",
    "warn"
  );
}

function controllerCoGetCardDisplayTitle(card) {
  if (!card) return "Manette";
  var badge = fixUtf8Mojibake(String(card.Badge || "")).toUpperCase();
  var child = fixUtf8Mojibake(String(card.ChildName || ""));
  var type = String(card.Type || "").toLowerCase();
  if (badge.indexOf("PS5") >= 0 || badge.indexOf("DUALSENSE") >= 0 || type.indexOf("dualsense") >= 0) return "PS5 DualSense";
  if (badge.indexOf("PS4") >= 0 || badge.indexOf("DUALSHOCK") >= 0 || type.indexOf("ps4") >= 0) return "PS4 DualShock";
  if (/dualsense/i.test(child)) return "PS5 DualSense";
  if (/wireless controller/i.test(child) && !/dualsense/i.test(child)) return "PS4 DualShock";
  if (/xbox/i.test(badge) || type.indexOf("xbox") >= 0) return "Xbox Controller";
  return fixUtf8Mojibake(card.DisplayName || card.Name || "HID Controller");
}

function controllerCoGetBoostButtonLabel(maxHz) {
  var hz = parseInt(maxHz, 10);
  if (hz >= 8000) return "Booster \u00e0 8000 Hz";
  return "Booster \u00e0 1000 Hz";
}

function controllerCoFormatPotentialForCard(card, confirmedRate) {
  var max = card && card.MaxRateHz ? parseInt(card.MaxRateHz, 10) : 1000;
  var cur = confirmedRate > 0 ? confirmedRate : (card ? card.CurrentRateHz : 125);
  if (isNaN(cur)) cur = 125;
  if (max >= 8000 && cur >= 8000) return "Maxed";
  if (cur >= 1000 && cur >= max) return "Maxed";
  if (max >= 8000) return "0.13 ms";
  return "1.0 ms";
}

function controllerCoApplyDeviceBadgeClass(badgeEl, card) {
  if (!badgeEl) return;
  var badgeType = fixUtf8Mojibake(String(card.Badge || card.Type || "MANETTE")).toUpperCase();
  badgeEl.innerText = badgeType;
  badgeEl.className = "coc-badge coc-badge--device";
  if (badgeType.indexOf("PS5") >= 0 || badgeType.indexOf("DUALSENSE") >= 0) {
    badgeEl.className = "coc-badge coc-badge--device coc-badge--ps5";
  } else if (badgeType.indexOf("PS4") >= 0 || badgeType.indexOf("DUALSHOCK") >= 0) {
    badgeEl.className = "coc-badge coc-badge--device coc-badge--ps4";
  }
}

function controllerCoApplyPollRowUi(domId, ui) {
  ui = ui || { currentRateHz: 125, isBoosted: false };
  var poll = document.getElementById(domId + "_poll");
  var pollDot = document.getElementById(domId + "_pollDot");
  var pollTag = document.getElementById(domId + "_pollTag");
  var rateHz = ui.currentRateHz > 0 ? ui.currentRateHz : 125;
  var isSlow = rateHz <= 125;
  var isBoosted = !!ui.isBoosted && rateHz > 125;
  if (poll) {
    poll.innerText = rateHz + " Hz";
    poll.className = "coc-poll-val" + (isSlow ? "" : (isBoosted ? " coc-poll-val--ok" : " coc-poll-val--violet"));
  }
  if (pollDot) {
    pollDot.className = "coc-poll-dot" + (isSlow ? "" : (rateHz >= 8000 ? " coc-poll-dot--violet" : " coc-poll-dot--ok"));
  }
  if (pollTag) {
    if (isSlow) {
      pollTag.innerText = "SLOW";
      pollTag.className = "coc-poll-tag coc-poll-tag--slow";
    } else if (isBoosted && rateHz >= 8000) {
      pollTag.innerText = "MAXIMUM";
      pollTag.className = "coc-poll-tag coc-poll-tag--max";
    } else if (isBoosted) {
      pollTag.innerText = "BOOSTED";
      pollTag.className = "coc-poll-tag coc-poll-tag--boost";
    } else {
      pollTag.innerText = "";
      pollTag.className = "coc-poll-tag coc-hidden";
    }
  }
}

function renderControllerCardDom(card) {
  card = controllerCoFinalizeCard(card);
  card = controllerCoApplyUiStateToCard(card);
  var ui = card.uiState;
  var domId = cocSafeDomId(getControllerCardId(card));
  var isApplyingCard = !!(card.applying) ||
    (controllerOverclockerState.busy && getControllerCardId(card) === controllerOverclockerState.busyCardId);
  var el = document.getElementById(domId);
  if (!el) return;
  var tone = ui.isBoosted ? "coc-tone-opt" : "coc-tone-default";
  if (ui.showError) tone = "coc-tone-mismatch";
  el.className = "coc-card " + tone;
  var badgeDev = document.getElementById(domId + "_badgeDev");
  var badgeSt = document.getElementById(domId + "_badgeSt");
  var resp = document.getElementById(domId + "_resp");
  var pot = document.getElementById(domId + "_pot");
  var state = document.getElementById(domId + "_state");
  controllerCoApplyDeviceBadgeClass(badgeDev, card);
  if (badgeSt) {
    if (ui.isBoosted) {
      badgeSt.innerText = "BOOSTED";
      badgeSt.className = "coc-badge coc-badge--boosted";
    } else {
      badgeSt.innerText = "DEFAULT";
      badgeSt.className = "coc-badge coc-badge--default";
    }
  }
  controllerCoApplyPollRowUi(domId, ui);
  if (resp) {
    resp.innerText = controllerCoFormatResponseMs(ui.responseMs);
    resp.className = "coc-metric-val coc-metric-val--resp" + (ui.isBoosted ? " coc-val--ok" : "");
  }
  if (pot) {
    var potLabel = controllerCoFormatPotentialForCard(card, ui.currentRateHz);
    pot.innerText = potLabel;
    pot.className = "coc-metric-val coc-metric-val--pot" + (/maxed/i.test(potLabel) ? " coc-val--muted" : "");
  }
  var canApply = card.ParentResolved && !!card.UsbParentDeviceId;
  var showRestore = ui.buttonMode === "restore" && ui.isBoosted;
  if (state) {
    state.className = "coc-card-state";
    if (isApplyingCard) {
      state.innerText = "Application...";
    } else if (!canApply) {
      state.innerText = "Parent USB \u00e0 r\u00e9soudre";
      state.className = "coc-card-state coc-card-state--warn";
    } else {
      state.innerText = "";
    }
  }
  var btnBoost = document.getElementById(domId + "_btnBoost");
  var btnR = document.getElementById(domId + "_btnRestore");
  var thisBusy = controllerOverclockerState.busy && getControllerCardId(card) === controllerOverclockerState.busyCardId;
  var maxHz = parseInt(card.MaxRateHz, 10);
  if (isNaN(maxHz) || maxHz <= 0) {
    maxHz = controllerCoInferMaxRateHz(card.Type, card.Badge, card.Vid, card.Pid, card.ChildName, card.DisplayName);
    card.MaxRateHz = maxHz;
  }
  if (btnBoost) {
    btnBoost.disabled = thisBusy || !canApply;
    btnBoost.innerText = controllerCoGetBoostButtonLabel(maxHz);
    btnBoost.className = showRestore ? "coc-btn-primary coc-btn-rate coc-hidden" : "coc-btn-primary coc-btn-rate";
  }
  if (btnR) {
    btnR.disabled = thisBusy || !canApply;
    btnR.innerText = "Restaurer \u00e0 125 Hz";
    btnR.className = showRestore ? "coc-btn-remove" : "coc-btn-remove coc-hidden";
  }
  controllerCoLogUiState(card);
}

function buildControllerCardHtml(card, cardIndex) {
  card = controllerCoFinalizeCard(card);
  card.cardIndex = parseInt(cardIndex, 10);
  if (isNaN(card.cardIndex)) card.cardIndex = 0;
  var domId = cocSafeDomId(getControllerCardId(card));
  var idx = card.cardIndex;
  var maxHz = parseInt(card.MaxRateHz, 10);
  if (isNaN(maxHz) || maxHz <= 0) {
    maxHz = controllerCoInferMaxRateHz(card.Type, card.Badge, card.Vid, card.Pid, card.ChildName, card.DisplayName);
    card.MaxRateHz = maxHz;
  }
  var boostLabel = controllerCoGetBoostButtonLabel(maxHz);
  var title = controllerCoGetCardDisplayTitle(card);
  var canApply = card.ParentResolved && !!card.UsbParentDeviceId;
  var disAttr = canApply ? "" : " disabled";
  var initHz = card.CurrentRateHz > 0 ? card.CurrentRateHz : (card.ConfiguredRate > 125 ? card.ConfiguredRate : 125);
  var initResp = controllerCoFormatResponseMs(controllerCoDefaultResponseMs(initHz));
  var initPot = controllerCoFormatPotentialForCard(card, initHz);
  var badgeHtml = controllerCoEscapeHtml(String(card.Badge || "MANETTE").toUpperCase());
  return (
    '<div class="coc-card coc-tone-default" id="' + domId + '" data-card-index="' + idx + '">' +
    '<div class="coc-card-head">' +
    '<div class="coc-card-icon" aria-hidden="true">&#9889;</div>' +
    '<div class="coc-card-head-text">' +
    '<div class="coc-card-title">' + controllerCoEscapeHtml(title) + '</div>' +
    '<div class="coc-card-badges">' +
    '<span class="coc-badge coc-badge--device" id="' + domId + '_badgeDev">' + badgeHtml + '</span>' +
    '<span class="coc-badge coc-badge--default" id="' + domId + '_badgeSt">DEFAULT</span>' +
    '</div></div></div>' +
    '<div class="coc-card-divider"></div>' +
    '<div class="coc-card-poll-row">' +
    '<span class="coc-poll-label">POLLING RATE</span>' +
    '<span class="coc-poll-value-wrap">' +
    '<span class="coc-poll-dot" id="' + domId + '_pollDot"></span>' +
    '<span class="coc-poll-val" id="' + domId + '_poll">' + initHz + ' Hz</span>' +
    '<span class="coc-poll-tag' + (initHz <= 125 ? ' coc-poll-tag--slow' : ' coc-hidden') + '" id="' + domId + '_pollTag">' +
    (initHz <= 125 ? 'SLOW' : '') + '</span>' +
    '</span></div>' +
    '<div class="coc-card-divider"></div>' +
    '<div class="coc-card-metrics-grid">' +
    '<div class="coc-metric-cell">' +
    '<span class="coc-metric-label">RESPONSE TIME</span>' +
    '<span class="coc-metric-val coc-metric-val--resp" id="' + domId + '_resp">' + controllerCoEscapeHtml(initResp) + '</span>' +
    '</div>' +
    '<div class="coc-metric-sep"></div>' +
    '<div class="coc-metric-cell">' +
    '<span class="coc-metric-label">POTENTIAL</span>' +
    '<span class="coc-metric-val coc-metric-val--pot" id="' + domId + '_pot">' + controllerCoEscapeHtml(initPot) + '</span>' +
    '</div></div>' +
    '<div class="coc-card-actions">' +
    '<button type="button" class="coc-btn-primary coc-btn-rate" id="' + domId + '_btnBoost"' + disAttr +
    ' onclick="applyControllerRateForCardByIndex(' + idx + ',' + maxHz + ')">' + controllerCoEscapeHtml(boostLabel) + '</button>' +
    '<button type="button" class="coc-btn-remove coc-hidden" id="' + domId + '_btnRestore"' + disAttr +
    ' onclick="restoreControllerCardDefaultByIndex(' + idx + ')">Retirer le boost</button>' +
    '</div>' +
    '<div class="coc-card-state" id="' + domId + '_state"></div>' +
    '</div>'
  );
}

function syncControllerCardsDom(cards, opts) {
  opts = opts || {};
  var container = $("controllerOverclockerCards");
  if (!container) return;
  var prevCards = controllerOverclockerState.cards || [];
  var prevSig = controllerCoCardsSignature(prevCards);
  var newSig = controllerCoCardsSignature(cards);
  var i;
  if (prevSig === newSig && cards.length && opts.inPlaceOnly) {
    for (i = 0; i < cards.length; i++) {
      var prev = getControllerCardById(getControllerCardId(cards[i]));
      if (prev) cards[i] = controllerCoMergeStableCardState(cards[i], prev);
      cards[i].cardIndex = i;
      cards[i].statusPending = false;
      renderControllerCardDom(cards[i]);
    }
    controllerOverclockerState.cards = cards;
    controllerOverclockerState.devices = cards;
    return;
  }
  container.innerHTML = "";
  if (cards.length) {
    container.className = "coc-cards";
    for (i = 0; i < cards.length; i++) {
      container.innerHTML += buildControllerCardHtml(cards[i], i);
      renderControllerCardDom(cards[i]);
    }
  } else {
    container.className = "coc-cards coc-hidden";
  }
}

function renderControllerOverclockerDeviceList(devices, opts) {
  opts = opts || {};
  var silent = !!opts.silent;
  var cards = [];
  var i;
  for (i = 0; i < (devices || []).length; i++) {
    var c = normalizeControllerDevice(devices[i]);
    if (!c) continue;
    var old = getControllerCardById(getControllerCardId(c));
    if (!old && controllerOverclockerState.lastStableDevices) {
      var j;
      for (j = 0; j < controllerOverclockerState.lastStableDevices.length; j++) {
        if (getControllerCardId(controllerOverclockerState.lastStableDevices[j]) === getControllerCardId(c)) {
          old = controllerOverclockerState.lastStableDevices[j];
          break;
        }
      }
    }
    if (old) c = controllerCoMergeStableCardState(c, old);
    c.statusPending = false;
    c = controllerCoApplyUiStateToCard(c);
    c.cardIndex = cards.length;
    cards.push(c);
  }
  var prevSig = controllerCoCardsSignature(controllerOverclockerState.cards);
  var newSig = controllerCoCardsSignature(cards);
  var sameLayout = prevSig === newSig && cards.length > 0;

  controllerOverclockerState.cards = cards;
  controllerOverclockerState.devices = cards;
  controllerOverclockerState.selectedIndex = cards.length ? 0 : -1;
  if (cards.length) {
    controllerOverclockerState.lastStableDevices = controllerCoCloneCards(cards);
  }

  var emptyEl = $("controllerOverclockerEmpty");
  syncControllerCardsDom(cards, { inPlaceOnly: sameLayout && silent });

  if (emptyEl) {
    if (cards.length) {
      emptyEl.className = "coc-empty-hint coc-hidden";
    } else if (controllerOverclockerState.isInitialLoading || controllerOverclockerState.searchingDevices) {
      emptyEl.className = "coc-empty-hint";
      emptyEl.innerText = "Recherche des manettes...";
    } else {
      emptyEl.className = "coc-empty-hint";
      emptyEl.innerText = "Aucune manette d\u00e9tect\u00e9e. Branchez une manette USB puis rafra\u00eechissez.";
    }
  }

  if (cards.length && !opts.skipStatusRefresh) {
    writeControllerOverclockerLog("[DEVICE] Controllers cards count=" + cards.length);
    refreshAllControllerCardsStatusBatch({ silent: silent });
  } else if (!cards.length) {
    controllerOverclockerState.statusPending = false;
  }
}

function applyBatchHidusbfStatusToCards(opts) {
  opts = opts || {};
  var cards = controllerOverclockerState.cards || [];
  var path = getControllerHidusbfStatusAllPath();
  if (!path || !getFso().FileExists(path)) {
    return;
  }
  var entries = [];
  try {
    var raw = readUtf8TextFileAll(path);
    entries = JSON.parse(String(raw).replace(/^\uFEFF/, ""));
    if (entries && entries.length === undefined && typeof entries === "object") entries = [entries];
  } catch (eParse) {
    entries = [];
  }
  var map = {};
  var j;
  for (j = 0; j < entries.length; j++) {
    var e = entries[j];
    if (!e) continue;
    var key = String(e.CardKey || e.UsbParentDeviceId || "");
    if (key) map[key.toUpperCase()] = e.Status;
  }
  var i;
  for (i = 0; i < cards.length; i++) {
    var card = controllerCoFinalizeCard(cards[i]);
    var st = controllerCoLookupHidusbfStatusInMap(map, card);
    if (st) {
      card.status = st;
      var cr = controllerCoResolveConfirmedRate(st);
      if (cr > 0 || (st.Status === "Default" && st.Verified)) {
        card.CurrentRateHz = cr > 0 ? cr : 125;
        card.ConfiguredRate = card.CurrentRateHz;
        card.LastKnownRateHz = card.CurrentRateHz;
      }
      if (st.HidusbfFilterPresent === true) card.HasFilter = true;
    }
    card.statusPending = false;
    card.fromCache = false;
    card.applying = false;
    card = controllerCoApplyUiStateToCard(card);
    renderControllerCardDom(card);
    cards[i] = card;
  }
  writeControllerOverclockerLog("[CONTROLLER-UI] renderCards count=" + cards.length);
  writeControllerOverclockerLog("[CONTROLLER-UI] layout compactCards=true");
  controllerOverclockerState.lastStableDevices = controllerCoCloneCards(cards);
  saveControllerDevicesCache(cards);
}

function refreshAllControllerCardsStatusBatch(opts) {
  opts = opts || {};
  var silent = !!opts.silent;
  var cards = controllerOverclockerState.cards || [];
  if (!cards.length) {
    controllerOverclockerState.statusPending = false;
    controllerOverclockerState.statusLoaded = true;
    return;
  }
  if (controllerOverclockerState.statusBatchRunning) return;
  controllerOverclockerState.statusBatchRunning = true;
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var logPath = getControllerOverclockerLogPath();
  var detectPath = getControllerDevicesFinalPath();
  if (!detectPath || !getFso().FileExists(detectPath)) {
    detectPath = getControllerOverclockerDetectJsonPath();
  }
  var batchOut = getControllerHidusbfStatusAllPath();
  var batchScript = getControllerStatusBatchScriptPath();
  if (!batchScript || !getFso().FileExists(batchScript)) {
    controllerOverclockerState.statusBatchRunning = false;
    return;
  }
  if (getFso().FileExists(batchOut)) {
    try { getFso().DeleteFile(batchOut, true); } catch (eDel) {}
  }
  var gen = controllerOverclockerGen;
  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + batchScript + '"' +
    ' -AppRoot "' + escapeControllerPsArg(app) + '"' +
    ' -LogPath "' + escapeControllerPsArg(logPath) + '"' +
    ' -DevicesPath "' + escapeControllerPsArg(detectPath) + '"' +
    ' -OutputPath "' + escapeControllerPsArg(batchOut) + '"';
  writeControllerOverclockerLog("[DEVICE] HIDUSBF status batch started silent=" + (silent ? "1" : "0"));
  runPowerShellAsync(cmd, batchOut, function (ok) {
    if (gen !== controllerOverclockerGen) return;
    controllerOverclockerState.statusBatchRunning = false;
    controllerOverclockerState.statusPending = false;
    controllerOverclockerState.statusLoaded = true;
    if (ok) applyBatchHidusbfStatusToCards({ silent: silent });
    writeControllerOverclockerLog("[DEVICE] HIDUSBF status batch done ok=" + (ok ? "1" : "0"));
  }, 12000);
}

function refreshControllerCardStatus(cardIndex, done, opts) {
  opts = opts || {};
  var cards = controllerOverclockerState.cards || [];
  var card = cards[cardIndex];
  if (!card) {
    if (done) done();
    return;
  }
  if (opts.applying) {
    card.applying = true;
    renderControllerCardDom(card);
  }
  var psPath = getControllerHidusbfStatusFastScriptPath();
  if (!psPath || !getFso().FileExists(psPath)) {
    card.applying = false;
    card.statusPending = false;
    renderControllerCardDom(card);
    if (done) done();
    return;
  }
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var logPath = getControllerOverclockerLogPath();
  var outPath = getControllerOverclockerStatusJsonPath();
  var usbParent = String(card.UsbParentDeviceId || "");
  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + psPath + '"' +
    ' -AppRoot "' + escapeControllerPsArg(app) + '"' +
    ' -LogPath "' + escapeControllerPsArg(logPath) + '"' +
    ' -OutputPath "' + escapeControllerPsArg(outPath) + '"' +
    ' -UsbParentDeviceId "' + escapeControllerPsArg(usbParent) + '"' +
    ' -Vid "' + escapeControllerPsArg(card.Vid || "") + '"' +
    ' -Pid "' + escapeControllerPsArg(card.Pid || "") + '"' +
    ' -Quiet';
  var gen = controllerOverclockerGen;
  runPowerShellAsync(cmd, outPath, function (ok) {
    if (gen !== controllerOverclockerGen) return;
    var st = readControllerPollingStatusResult();
    card.status = st;
    if (st) {
      var cr = controllerCoResolveConfirmedRate(st);
      card.CurrentRateHz = cr;
      card.ConfiguredRate = cr;
    }
    card.statusPending = false;
    card.applying = false;
    card.fromCache = false;
    renderControllerCardDom(card);
    controllerOverclockerState.lastStableDevices = controllerCoCloneCards(cards);
    saveControllerDevicesCache(cards);
    if (done) done();
  }, 8000);
}

function applyControllerRateForCardByIndex(cardIndex, rateHz) {
  var card = getControllerCardByIndex(cardIndex);
  if (!card) return;
  applyControllerRateForCard(getControllerCardId(card), rateHz, cardIndex);
}

function applyControllerRateForCard(cardId, rateHz, cardIndexHint) {
  var card = null;
  if (typeof cardIndexHint === "number" && !isNaN(cardIndexHint)) {
    card = getControllerCardByIndex(cardIndexHint);
  }
  if (!card) card = getControllerCardById(cardId);
  if (!card) return;
  card = controllerCoFinalizeCard(card);
  var rate = parseInt(rateHz, 10);
  var maxHz = parseInt(card.MaxRateHz, 10);
  writeControllerOverclockerLog("[DEVICE] Apply card clicked");
  writeControllerOverclockerLog("[DEVICE] Card index=" + String(card.cardIndex));
  writeControllerOverclockerLog("[DEVICE] Card Type=" + card.Type);
  writeControllerOverclockerLog("[DEVICE] Card VID/PID=" + card.Vid + "/" + card.Pid);
  writeControllerOverclockerLog("[DEVICE] Card DeviceInstanceId=" + card.DeviceInstanceId);
  writeControllerOverclockerLog("[DEVICE] Card UsbParentDeviceId=" + (card.UsbParentDeviceId || "(empty)"));
  writeControllerOverclockerLog("[DEVICE] Card MaxRateHz=" + maxHz);
  writeControllerOverclockerLog("[DEVICE] Requested RateHz=" + rate);
  if (rate !== 1000 && rate !== 8000) return;
  if (!card.ParentResolved || !card.UsbParentDeviceId) {
    setControllerOverclockerStatus("Parent USB composite introuvable", "error");
    return;
  }
  if (rate > maxHz) {
    setControllerOverclockerStatus("Cette manette ne supporte pas " + rate + " Hz", "error");
    return;
  }
  card.uiRequestedRate = rate;
  runControllerOverclockerActionForCard(card, "apply", rate);
}

function applyControllerCardRateByIndex(cardIndex, rateHz) {
  applyControllerRateForCardByIndex(cardIndex, rateHz);
}

function applyControllerCardRate(cardId, rateHz) {
  applyControllerRateForCard(cardId, rateHz);
}

function restoreControllerCardDefaultByIndex(cardIndex) {
  var cards = controllerOverclockerState.cards || [];
  var card = cards[cardIndex];
  if (!card) return;
  restoreControllerCardDefault(getControllerCardId(card));
}

function restoreControllerCardDefault(cardId) {
  var card = getControllerCardById(cardId);
  if (!card) return;
  runControllerOverclockerActionForCard(card, "restore", 125);
}

function cocSafeDomId(cardId) {
  return "coc_" + String(cardId || "card").replace(/[^a-zA-Z0-9_]/g, "_").substring(0, 72);
}

function getControllerCardId(card) {
  if (!card) return "";
  return String(
    card.cardId || card.CardId || card.UsbParentDeviceId || card.TargetHidusbfDeviceId ||
    (card.Vid + ":" + card.Pid)
  );
}

function getControllerCardById(cardId) {
  var cards = controllerOverclockerState.cards || [];
  var i;
  for (i = 0; i < cards.length; i++) {
    if (getControllerCardId(cards[i]) === String(cardId || "")) return cards[i];
  }
  return null;
}

function getControllerCardByIndex(cardIndex) {
  var cards = controllerOverclockerState.cards || [];
  var idx = parseInt(cardIndex, 10);
  if (isNaN(idx) || idx < 0 || idx >= cards.length) return null;
  return cards[idx];
}

function controllerCoInferMaxRateHz(type, badge, vid, pid, childName, displayName) {
  var t = String(type || "").toLowerCase();
  var b = String(badge || "").toUpperCase();
  var v = String(vid || "").toUpperCase();
  var p = String(pid || "").toUpperCase();
  var blob = (String(childName || "") + " " + String(displayName || "")).toLowerCase();
  if (t.indexOf("dualsense") >= 0 || b.indexOf("PS5") >= 0 || b.indexOf("DUALSENSE") >= 0) return 8000;
  if (v === "054C" && /^(0CE6|0DF2|0E5F)$/.test(p)) return 8000;
  if (blob.indexOf("dualsense") >= 0 || blob.indexOf("ps5") >= 0) return 8000;
  if (t.indexOf("ps4") >= 0 || b.indexOf("PS4") >= 0 || b.indexOf("DUALSHOCK") >= 0) return 1000;
  if (v === "054C" && /^(05C4|09CC|0BA0|054C|0268|0C5E)$/.test(p)) return 1000;
  if (blob.indexOf("wireless controller") >= 0 && blob.indexOf("dualsense") < 0) return 1000;
  return 1000;
}

function controllerCoFinalizeCard(card) {
  if (!card) return null;
  var maxRate = parseInt(card.MaxRateHz, 10);
  if (isNaN(maxRate) || maxRate <= 0) {
    maxRate = controllerCoInferMaxRateHz(card.Type, card.Badge, card.Vid, card.Pid, card.ChildName, card.DisplayName);
  }
  card.MaxRateHz = maxRate;
  var cur = parseInt(card.CurrentRateHz, 10);
  if (isNaN(cur)) cur = parseInt(card.ConfiguredRate, 10);
  if (isNaN(cur)) cur = 125;
  card.CurrentRateHz = cur;
  card.ConfiguredRate = cur;
  if (!card.Vid || !card.Pid) {
    var idBlob = String(card.DeviceInstanceId || card.UsbParentDeviceId || "");
    var mVid = idBlob.match(/VID_([0-9A-Fa-f]{4})/i);
    var mPid = idBlob.match(/PID_([0-9A-Fa-f]{4})/i);
    if (mVid && !card.Vid) card.Vid = mVid[1].toUpperCase();
    if (mPid && !card.Pid) card.Pid = mPid[1].toUpperCase();
  }
  card.ParentResolved = !!String(card.UsbParentDeviceId || "").replace(/^\s+|\s+$/g, "");
  if (card.MaxRateHz >= 8000) {
    card.Type = "DualSense";
    if (!card.Badge || card.Badge.indexOf("PS5") < 0) card.Badge = "PS5 DUALSENSE";
  }
  return card;
}

function normalizeControllerCard(raw) {
  if (!raw) return null;
  var instanceId = String(raw.DeviceInstanceId || raw.InstanceId || raw.DeviceId || raw.deviceInstanceId || "");
  var usbParent = String(
    raw.UsbParentDeviceId || raw.usbParentDeviceId || raw.TargetHidusbfDeviceId ||
    raw.targetHidusbfDeviceId || raw.UsbCompositeParentId || raw.usbCompositeParentId || ""
  );
  var vid = String(raw.Vid || raw.vid || "").toUpperCase();
  var pid = String(raw.Pid || raw.pid || raw.ProductId || "").toUpperCase();
  var type = String(raw.Type || raw.type || "HID Controller");
  var badge = fixUtf8Mojibake(String(raw.Badge || raw.badge || raw.Type || raw.type || "HID CONTROLLER")).toUpperCase();
  var maxRate = parseInt(raw.MaxRateHz != null ? raw.MaxRateHz : raw.maxRateHz, 10);
  if (isNaN(maxRate) || maxRate <= 0) {
    maxRate = controllerCoInferMaxRateHz(type, badge, vid, pid, raw.ChildName, raw.DisplayName);
  }
  var cur = parseInt(raw.CurrentRateHz != null ? raw.CurrentRateHz : raw.currentRateHz, 10);
  if (isNaN(cur)) cur = parseInt(raw.ConfiguredRate != null ? raw.ConfiguredRate : raw.configuredRate, 10);
  if (isNaN(cur)) cur = 125;
  var card = {
    cardIndex: -1,
    cardId: String(raw.CardId || raw.cardId || usbParent || (vid + ":" + pid + ":" + instanceId)),
    DisplayName: fixUtf8Mojibake(String(raw.DisplayName || raw.displayName || raw.Name || raw.name || "P\u00e9riph\u00e9rique USB composite")),
    ChildName: fixUtf8Mojibake(String(raw.ChildName || raw.childName || "")),
    Name: fixUtf8Mojibake(String(raw.Name || raw.name || raw.DisplayName || "")),
    FriendlyName: fixUtf8Mojibake(String(raw.FriendlyName || raw.friendlyName || raw.DisplayName || raw.Name || "")),
    DeviceInstanceId: instanceId,
    InstanceId: instanceId,
    DeviceId: instanceId,
    Vid: vid,
    Pid: pid,
    UsbParentDeviceId: usbParent,
    UsbCompositeParentId: usbParent,
    TargetHidusbfDeviceId: usbParent,
    Type: type,
    Badge: badge,
    MaxRateHz: maxRate,
    CurrentRateHz: cur,
    ConfiguredRate: cur,
    HasFilter: !!(raw.HasFilter || raw.hasFilter),
    HidusbfInstalled: !!(raw.HidusbfInstalled || raw.hidusbfInstalled),
    IsBoosted: raw.IsBoosted === true || raw.isBoosted === true,
    IsConfirmed: raw.IsConfirmed === true || raw.isConfirmed === true,
    ButtonMode: raw.ButtonMode || raw.buttonMode || "",
    StatusSource: raw.StatusSource || raw.statusSource || "",
    ConfiguredRateHz: parseInt(raw.ConfiguredRateHz != null ? raw.ConfiguredRateHz : raw.configuredRateHz, 10) || 0,
    PollingRateHz: parseInt(raw.PollingRateHz != null ? raw.PollingRateHz : raw.pollingRateHz, 10) || 0,
    ParentResolved: !!usbParent,
    Present: raw.Present === true,
    status: null,
    statusPending: false,
    uiRequestedRate: 0,
    lastApplyFailed: false
  };
  return controllerCoFinalizeCard(card);
}

function normalizeControllerDevice(raw) {
  return normalizeControllerCard(raw);
}

function parseControllerDetectJson(text) {
  if (!text) return [];
  var raw = String(text).replace(/^\uFEFF/, "");
  var data = JSON.parse(raw);
  if (!data) return [];
  var list = data.length !== undefined && typeof data.length === "number" ? data : [data];
  var out = [];
  var i;
  for (i = 0; i < list.length; i++) {
    var norm = normalizeControllerDevice(list[i]);
    if (!norm) continue;
    if (norm.Present !== true) continue;
    var hasId = !!(norm.InstanceId || norm.DeviceInstanceId || norm.UsbParentDeviceId);
    var hasVidPid = !!(norm.Vid && norm.Pid);
    if (hasId || hasVidPid) out.push(norm);
  }
  return out;
}

function readControllerDetectResultFromPath(path) {
  try {
    if (!path || !getFso().FileExists(path)) return null;
    return parseControllerDetectJson(readUtf8TextFileAll(path));
  } catch (eR) {
    return null;
  }
}

function readControllerDetectResult() {
  return readControllerDetectResultFromPath(getControllerDevicesFinalPath()) ||
    readControllerDetectResultFromPath(getControllerOverclockerDetectJsonPath());
}

function setControllerOverclockerSearchUi(searching) {
  controllerOverclockerState.searchingDevices = !!searching;
  var emptyEl = $("controllerOverclockerEmpty");
  if (!emptyEl) return;
  if (searching) {
    if (controllerOverclockerState.cards && controllerOverclockerState.cards.length) {
      emptyEl.className = "coc-empty-hint coc-hidden";
      return;
    }
    emptyEl.className = "coc-empty-hint";
    emptyEl.innerText = "Recherche des manettes...";
  } else if (!controllerOverclockerState.cards || !controllerOverclockerState.cards.length) {
    emptyEl.className = "coc-empty-hint";
    emptyEl.innerText = "Aucune manette connect\u00e9e. Branchez une manette USB puis rafra\u00eechissez.";
  } else {
    emptyEl.className = "coc-empty-hint coc-hidden";
  }
}

function controllerCoEnrichDevicesForExport(devices) {
  var out = [];
  var i;
  for (i = 0; i < (devices || []).length; i++) {
    var c = normalizeControllerDevice(devices[i]);
    if (!c) continue;
    c = controllerCoApplyUiStateToCard(c);
    var ui = c.uiState;
    out.push({
      DisplayName: c.DisplayName,
      DeviceInstanceId: c.DeviceInstanceId,
      UsbParentDeviceId: c.UsbParentDeviceId,
      Vid: c.Vid,
      Pid: c.Pid,
      Type: c.Type,
      Badge: c.Badge,
      MaxRateHz: c.MaxRateHz,
      currentRateHz: ui.currentRateHz,
      configuredRateHz: ui.configuredRateHz,
      hasFilter: ui.hasFilter,
      isBoosted: ui.isBoosted,
      isConfirmed: ui.isConfirmed,
      buttonMode: ui.buttonMode,
      source: ui.source,
      Present: c.Present === true
    });
  }
  return out;
}

function writeControllerDetectArtifacts(devices, sourceLabel) {
  var exportDevices = controllerCoEnrichDevicesForExport(devices);
  var listJson = JSON.stringify(exportDevices.length ? exportDevices : (devices || []));
  try {
    var finalPath = getControllerDevicesFinalPath();
    if (finalPath) writeUtf8TextFileAll(finalPath, listJson);
  } catch (eFin) {}
  try {
    var detPath = getControllerDevicesDetectedPath();
    if (detPath && sourceLabel === "full") writeUtf8TextFileAll(detPath, listJson);
  } catch (eDet) {}
  try {
    var legacyPath = getControllerOverclockerDetectJsonPath();
    if (legacyPath) writeUtf8TextFileAll(legacyPath, listJson);
  } catch (eLeg) {}
}

function applyControllerDetectResults(devices, sourceLabel, detectOpts) {
  detectOpts = detectOpts || {};
  var silent = !!detectOpts.silent;
  var di, filtered = [];
  for (di = 0; di < (devices || []).length; di++) {
    if (!devices[di] || devices[di].Present !== true) continue;
    devices[di].statusPending = false;
    devices[di].fromCache = false;
    devices[di].cached = false;
    devices[di].verifying = false;
    filtered.push(devices[di]);
  }
  devices = filtered;
  if (!devices.length) {
    if (silent && controllerOverclockerState.lastStableDevices && controllerOverclockerState.lastStableDevices.length) {
      writeControllerOverclockerLog("[DEVICE-DETECT] silent empty result  keeping stable UI");
      return false;
    }
    writeControllerDetectArtifacts([], sourceLabel);
    renderControllerOverclockerDeviceList([], { silent: silent });
    controllerOverclockerState.deviceSignature = "";
    controllerOverclockerState.lastStableDevices = [];
    setControllerOverclockerSearchUi(false);
    controllerOverclockerState.isInitialLoading = false;
    writeControllerOverclockerLog("[DEVICE-DETECT] final_cards_count=0");
    return false;
  }
  var prevSig = controllerCoCardsSignature(controllerOverclockerState.cards);
  var newSig = controllerCoCardsSignature(devices);
  if (silent && prevSig === newSig && controllerOverclockerState.cards.length) {
    writeControllerOverclockerLog("[DEVICE-DETECT] silent detect  layout unchanged, skip UI rebuild");
    controllerOverclockerState.lastDetectMs = new Date().getTime();
    refreshAllControllerCardsStatusBatch({ silent: true });
    return true;
  }
  saveControllerDevicesCache(devices);
  writeControllerDetectArtifacts(devices, sourceLabel);
  renderControllerOverclockerDeviceList(devices, { silent: silent });
  updateControllerOverclockerHidusbfBadge();
  controllerOverclockerState.deviceSignature = getControllerDeviceSignature(devices);
  controllerOverclockerState.lastDetectMs = new Date().getTime();
  controllerOverclockerState.isInitialLoading = false;
  setControllerOverclockerSearchUi(false);
  return true;
}

function runControllerDetect(reason) {
  if (controllerOverclockerState.scanning) return;
  var silent = controllerCoIsSilentDetectReason(reason);
  var scanToken = ++controllerOverclockerState.detectScanToken;
  controllerOverclockerState.scanning = true;
  controllerOverclockerState.isBackgroundRefreshing = silent;
  if (!silent && !(controllerOverclockerState.cards && controllerOverclockerState.cards.length)) {
    controllerOverclockerState.isInitialLoading = true;
    setControllerOverclockerSearchUi(true);
  } else if (!silent) {
    setControllerOverclockerSearchUi(false);
  }
  writeControllerOverclockerLog("[DEVICE-DETECT] start reason=" + String(reason || "manual") + " silent=" + (silent ? "1" : "0"));
  var btn = $("btnControllerOverclockerRefresh");
  if (btn && !silent) btn.disabled = true;

  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var logPath = getControllerOverclockerLogPath();
  var detectScript = getDetectControllerScriptPath();
  var finalPath = getControllerDevicesFinalPath();
  var presentPath = getControllerDevicesPresentPath();
  var sigPath = getControllerDeviceSignatureJsonPath();

  if (!detectScript || !getFso().FileExists(detectScript)) {
    writeControllerOverclockerLog("[DEVICE-DETECT] script missing");
    controllerOverclockerState.scanning = false;
    controllerOverclockerState.isBackgroundRefreshing = false;
    controllerOverclockerState.isInitialLoading = false;
    if (btn && !silent) btn.disabled = false;
    return;
  }

  try {
    if (getFso().FileExists(finalPath)) getFso().DeleteFile(finalPath, true);
  } catch (eClr) {}

  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + detectScript + '"' +
    ' -AppRoot "' + escapeControllerPsArg(app) + '"' +
    ' -LogPath "' + escapeControllerPsArg(logPath) + '"' +
    ' -OutputPath "' + escapeControllerPsArg(finalPath) + '"' +
    ' -PresentPath "' + escapeControllerPsArg(presentPath) + '"' +
    ' -FinalPath "' + escapeControllerPsArg(finalPath) + '"' +
    ' -SignaturePath "' + escapeControllerPsArg(sigPath) + '"' +
    ' -Reason "' + escapeControllerPsArg(reason || "manual") + '"';

  runPowerShellAsync(cmd, finalPath, function (ok) {
    if (scanToken !== controllerOverclockerState.detectScanToken) return;
    controllerOverclockerState.scanning = false;
    controllerOverclockerState.isBackgroundRefreshing = false;
    if (btn && !silent) btn.disabled = false;

    if (!ok) {
      writeControllerOverclockerLog("[DEVICE-DETECT] scan failed silent=" + (silent ? "1" : "0"));
      controllerOverclockerState.isInitialLoading = false;
      setControllerOverclockerSearchUi(false);
      return;
    }

    var devices = readControllerDetectResultFromPath(finalPath);
    if (!devices) devices = [];

    var sigChanged = false;
    try {
      if (getFso().FileExists(sigPath)) {
        var sigObj = JSON.parse(String(readUtf8TextFileAll(sigPath) || "").replace(/^\uFEFF/, ""));
        var newSig = sigObj && sigObj.Signature ? String(sigObj.Signature) : "";
        sigChanged = newSig !== String(controllerOverclockerState.pnpSignature || "");
        controllerOverclockerState.pnpSignature = newSig;
      }
    } catch (eSig) {}

    writeControllerOverclockerLog("[DEVICE-DETECT] signature_changed=" + (sigChanged ? "true" : "false"));
    applyControllerDetectResults(devices, reason || "detect", { silent: silent });
    controllerOverclockerState.isInitialLoading = false;
    setControllerOverclockerSearchUi(false);
  }, 20000);
}

function refreshUsbControllers() {
  if (controllerOverclockerState.scanning || controllerOverclockerState.busy) return;
  runControllerDetect("manual");
}

function onControllerOverclockerWindowFocus() {
  if (currentPageName !== "peripheral") return;
  if (controllerOverclockerState.scanning || controllerOverclockerState.busy) return;
  var now = new Date().getTime();
  var last = controllerOverclockerState.lastDetectMs || 0;
  if (now - last < 2000) return;
  runControllerDetect("focus");
}

function getSelectedControllerDevice() {
  var idx = controllerOverclockerState.selectedIndex;
  if (idx < 0 || !controllerOverclockerState.devices[idx]) return null;
  return controllerOverclockerState.devices[idx];
}

function isValidControllerDeviceInstanceId(instanceId) {
  var id = String(instanceId || "").replace(/^\s+|\s+$/g, "");
  if (!id) return false;
  if (/^(test|null|none|undefined|n\/a|na)$/i.test(id)) return false;
  if (id.length < 12) return false;
  if (!/^(HID|USB)\\/i.test(id)) return false;
  if (!/VID_[0-9A-Fa-f]{4}/i.test(id)) return false;
  if (!/PID_[0-9A-Fa-f]{4}/i.test(id)) return false;
  return true;
}

function resolveControllerDeviceInstanceId(dev) {
  if (!dev) return "";
  var primary = String(dev.InstanceId || dev.DeviceId || "").replace(/^\s+|\s+$/g, "");
  if (isValidControllerDeviceInstanceId(primary)) return primary;
  var vid = String(dev.Vid || "").toUpperCase();
  var pid = String(dev.Pid || "").toUpperCase();
  var devices = controllerOverclockerState.devices || [];
  var i, d, did, bestHid = "", bestUsb = "";
  for (i = 0; i < devices.length; i++) {
    d = devices[i];
    if (!d) continue;
    if (String(d.Vid || "").toUpperCase() !== vid) continue;
    if (String(d.Pid || "").toUpperCase() !== pid) continue;
    did = String(d.InstanceId || d.DeviceId || "").replace(/^\s+|\s+$/g, "");
    if (!isValidControllerDeviceInstanceId(did)) continue;
    if (/^HID\\/i.test(did) && /MI_03/i.test(did)) return did;
    if (/^HID\\/i.test(did) && !bestHid) bestHid = did;
    if (/^USB\\/i.test(did) && !bestUsb) bestUsb = did;
  }
  if (bestHid) return bestHid;
  if (bestUsb) return bestUsb;
  return "";
}

function setControllerOverclockerButtonsBusy(busy) {
  controllerOverclockerState.busy = !!busy;
  if (!busy) controllerOverclockerState.busyCardId = "";
  var refreshBtn = $("btnControllerOverclockerRefresh");
  if (refreshBtn) refreshBtn.disabled = !!busy;
  var cards = controllerOverclockerState.cards || [];
  var i;
  var busyId = controllerOverclockerState.busyCardId;
  for (i = 0; i < cards.length; i++) {
    if (!busy || getControllerCardId(cards[i]) === busyId) {
      renderControllerCardDom(controllerCoFinalizeCard(cards[i]));
    }
  }
}

function isControllerDeviceSafeForOverclock(dev) {
  if (!dev) return false;
  var name = fixUtf8Mojibake(
    String(dev.Name || "") + " " + String(dev.FriendlyName || "") + " " + String(dev.Type || "")
  );
  if (/keyboard|clavier|mouse|souris|touchpad|trackpad/i.test(name)) return false;
  if (/dualsense|xbox|controller|game controller|scuf|ps4|ps5|manette|joystick|gamepad|hid controller|contrôleur/i.test(name)) {
    return true;
  }
  if (dev.Type && /dualsense|xbox|ps4|scuf|hid controller/i.test(String(dev.Type))) return true;
  var vid = String(dev.Vid || "").toUpperCase();
  var pid = String(dev.Pid || "").toUpperCase();
  if (vid === "054C" && /^(0CE6|0DF2|05C4|09CC|0BA0|0E5F|054C|0268|0C5E)$/.test(pid)) return true;
  if (vid === "045E" && pid) return true;
  return false;
}

function escapeControllerPsArg(value) {
  return String(value || "").replace(/"/g, '""');
}

function readControllerOverclockerExitCodeFile() {
  try {
    initApplicationBaseDirectory();
    var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
    var exitPath = app ? getAbsolutePathFs(combinePath(app, "logs\\controller-overclocker-exitcode.txt")) : "";
    if (!exitPath || !getFso().FileExists(exitPath)) return null;
    var ecTxt = String(readTextFileAll(exitPath) || "").replace(/\s/g, "");
    if (ecTxt === "" || isNaN(parseInt(ecTxt, 10))) return null;
    return parseInt(ecTxt, 10);
  } catch (eEcRead) {
    return null;
  }
}

function resolveControllerOverclockerExitCode(shellExitCode) {
  var code = typeof shellExitCode === "number" ? shellExitCode : -1;
  var fileCode = readControllerOverclockerExitCodeFile();
  if (code === 259 || code === -1) {
    if (fileCode !== null && !isNaN(fileCode)) code = fileCode;
  }
  return code;
}

function findHidusbfSetupExePath() {
  var bundle = resolveHidusbfBundle();
  var fso = getFso();
  var roots = [];
  var seen = {};
  function addRoot(p) {
    var d = getAbsolutePathFs(String(p || ""));
    if (!d || seen[d]) return;
    seen[d] = true;
    if (fso.FolderExists(d)) roots.push(d);
  }
  if (bundle.root) addRoot(bundle.root);
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  if (app) {
    addRoot(combinePath(app, "Tools\\hidusbf"));
    addRoot(combinePath(app, "tools\\hidusbf"));
  }
  var rels = [
    "Setup.exe",
    "setup.exe",
    "USB Devices Rate Setup.exe",
    "DRIVER\\Setup.exe",
    "hidusbf\\DRIVER\\Setup.exe",
    "HIDUSBF\\DRIVER\\Setup.exe"
  ];
  var i;
  var j;
  for (i = 0; i < roots.length; i++) {
    for (j = 0; j < rels.length; j++) {
      var p = getAbsolutePathFs(combinePath(roots[i], rels[j]));
      if (p && fso.FileExists(p)) {
        writeControllerOverclockerLog("[DEVICE] HIDUSBF setup exe found: " + p);
        return p;
      }
    }
    var treeHit = findSetupExeInTree(fso, roots[i], 0);
    if (treeHit) {
      writeControllerOverclockerLog("[DEVICE] HIDUSBF setup exe found: " + treeHit);
      return treeHit;
    }
  }
  writeControllerOverclockerLog("[DEVICE] HIDUSBF setup exe found: none");
  return "";
}

function isHidusbfSetupPresent() {
  return !!findHidusbfSetupExePath();
}

function launchHidusbfSetupExe(setupPath) {
  if (!setupPath) return false;
  try {
    initApplicationBaseDirectory();
    createUnrealFolders();
    var outerPath = UNREAL_LOGS + "\\open-hidusbf-setup.ps1";
    var esc = function (s) { return String(s || "").replace(/'/g, "''"); };
    var tw = getFso().CreateTextFile(outerPath, true);
    tw.Write(
      "$ErrorActionPreference = 'Continue'\r\n" +
      "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8\r\n" +
      "$OutputEncoding = [System.Text.Encoding]::UTF8\r\n" +
      "Start-Process -FilePath '" + esc(setupPath) + "' -ArgumentList '/all' -Verb RunAs\r\n"
    );
    tw.Close();
    getShell().Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + outerPath + '"', 0, false);
    return true;
  } catch (eLaunch) {
    return false;
  }
}

function openHidusbfSetupFromTools(skipAssistedUi) {
  var setupPath = findHidusbfSetupExePath();
  if (!setupPath) {
    setControllerOverclockerStatus("HIDUSBF Setup introuvable", "error");
    alert("HIDUSBF Setup introuvable.\n\nPlacez Setup.exe dans Tools\\hidusbf\\.");
    return;
  }
  writeControllerOverclockerLog("[DEVICE] Open HIDUSBF Setup clicked: " + setupPath);
  if (!launchHidusbfSetupExe(setupPath)) {
    setControllerOverclockerStatus("Impossible de lancer HIDUSBF Setup.", "error");
    alert("Impossible de lancer HIDUSBF Setup.");
    return;
  }
  if (!skipAssistedUi) {
    logControllerAssistedSetupOpened();
    showControllerAssistedGuide(0);
    setControllerAssistedSetupStatus();
  }
}

function runControllerOverclockerScriptSync(scriptFileName, params) {
  initApplicationBaseDirectory();
  createUnrealFolders();
  clearControllerOcApplyArtifacts();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var scriptsDir = getAppScriptsDir();
  var psPath = scriptsDir ? getAbsolutePathFs(combinePath(scriptsDir, "Devices\\" + scriptFileName)) : "";
  if (!psPath || !getFso().FileExists(psPath)) {
    return { exitCode: 127, error: "script_missing" };
  }
  var logPath = getControllerOverclockerLogPath();
  var exitPath = app ? getAbsolutePathFs(combinePath(app, "logs\\controller-overclocker-exitcode.txt")) : "";
  var resultPath = getControllerOverclockerApplyResultPath();
  var outPath = UNREAL_LOGS + "\\controller-overclocker-last-stdout.txt";
  var errPath = UNREAL_LOGS + "\\controller-overclocker-last-stderr.txt";
  var rateForPs = params.rate ? parseInt(params.rate, 10) : 0;
  if (isNaN(rateForPs)) rateForPs = 0;
  writeControllerOverclockerLog("[DEVICE] HARD_RATE=" + rateForPs);
  writeControllerOverclockerLog("[DEVICE] Passed RateHz=" + rateForPs);
  var paramPath = writeControllerOverclockerParamsFile(app, logPath, params);
  var instanceId = String(params.instanceId || "");
  var usbParent = String(params.usbParentDeviceId || "");
  var vid = String(params.vid || "");
  var pid = String(params.pid || "");

  try {
    if (getFso().FileExists(outPath)) getFso().DeleteFile(outPath, true);
    if (getFso().FileExists(errPath)) getFso().DeleteFile(errPath, true);
  } catch (eDel2) {}

  var exitCode = -1;
  var esc = function (s) { return String(s || "").replace(/'/g, "''"); };
  var runBody =
    "$ErrorActionPreference = 'Continue'\r\n" +
    "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8\r\n" +
    "$OutputEncoding = [System.Text.Encoding]::UTF8\r\n" +
    "$psPath = '" + esc(psPath) + "'\r\n" +
    "$argList = @('-NoProfile','-ExecutionPolicy','Bypass','-File', $psPath, '-AppRoot', '" + esc(app) + "', '-LogPath', '" + esc(logPath) + "', '-ResultPath', '" + esc(resultPath) + "', '-DeviceInstanceId', '" + esc(instanceId) + "', '-UsbParentDeviceId', '" + esc(usbParent) + "', '-Vid', '" + esc(vid) + "', '-Pid', '" + esc(pid) + "'" +
    (params.uninstall ? ", '-Uninstall'" : (", '-RateHz', '" + esc(String(rateForPs)) + "'" + (params.maxRateHz ? (", '-MaxRateHz', '" + esc(String(params.maxRateHz)) + "'") : ""))) + ")\r\n" +
    "$outPath = '" + esc(outPath) + "'\r\n" +
    "$errPath = '" + esc(errPath) + "'\r\n" +
    "$logPath = '" + esc(logPath) + "'\r\n" +
    "$exitPath = '" + esc(exitPath) + "'\r\n" +
    "try {\r\n" +
    "  $p = Start-Process -FilePath 'powershell.exe' -ArgumentList $argList -Wait -PassThru -NoNewWindow -RedirectStandardOutput $outPath -RedirectStandardError $errPath\r\n" +
    "  $c = 0; if ($p) { $c = [int]$p.ExitCode }\r\n" +
    "  if ($exitPath -and (Test-Path -LiteralPath $exitPath)) {\r\n" +
    "    $fromFile = (Get-Content -LiteralPath $exitPath -Raw -ErrorAction SilentlyContinue).Trim()\r\n" +
    "    if ($fromFile -match '^\\d+$') { $c = [int]$fromFile }\r\n" +
    "  }\r\n" +
    "  if ($logPath -and (Test-Path -LiteralPath $outPath)) {\r\n" +
    "    Add-Content -LiteralPath $logPath -Value '[DEVICE-AUTO] --- stdout ---' -Encoding UTF8\r\n" +
    "    Get-Content -LiteralPath $outPath -ErrorAction SilentlyContinue | ForEach-Object { Add-Content -LiteralPath $logPath -Value ('[DEVICE-AUTO] stdout=' + $_) -Encoding UTF8 }\r\n" +
    "  }\r\n" +
    "  if ($logPath -and (Test-Path -LiteralPath $errPath)) {\r\n" +
    "    Add-Content -LiteralPath $logPath -Value '[DEVICE-AUTO] --- stderr ---' -Encoding UTF8\r\n" +
    "    Get-Content -LiteralPath $errPath -ErrorAction SilentlyContinue | ForEach-Object { Add-Content -LiteralPath $logPath -Value ('[DEVICE-AUTO] stderr=' + $_) -Encoding UTF8 }\r\n" +
    "  }\r\n" +
    "  exit $c\r\n" +
    "} catch {\r\n" +
    "  if ($exitPath) { Set-Content -LiteralPath $exitPath -Value 3 -Encoding ascii -Force }\r\n" +
    "  exit 3\r\n" +
    "}\r\n";

  if (isRunningAsAdmin()) {
    var wrapperPath = UNREAL_LOGS + "\\controller-overclocker-run.ps1";
    var twRun = getFso().CreateTextFile(wrapperPath, true);
    twRun.Write(runBody);
    twRun.Close();
    exitCode = getShell().Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + wrapperPath + '"', 0, true);
    exitCode = resolveControllerOverclockerExitCode(exitCode);
  } else {
    var wrapperPath2 = UNREAL_LOGS + "\\controller-overclocker-run.ps1";
    var twRun2 = getFso().CreateTextFile(wrapperPath2, true);
    twRun2.Write(runBody);
    twRun2.Close();
    var outerPath = UNREAL_LOGS + "\\controller-overclocker-elev.ps1";
    var tw = getFso().CreateTextFile(outerPath, true);
    var body =
      "$ErrorActionPreference = 'Continue'\r\n" +
      "try {\r\n" +
      "  $p = Start-Process -FilePath 'powershell.exe' -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-File','" + esc(wrapperPath2) + "') -Verb RunAs -PassThru -Wait -ErrorAction Stop\r\n" +
      "  $c = 0; if ($p) { $c = [int]$p.ExitCode }\r\n" +
      "  exit $c\r\n" +
      "} catch {\r\n" +
      "  exit 3\r\n" +
      "}\r\n";
    tw.Write(body);
    tw.Close();
    exitCode = getShell().Run('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + outerPath + '"', 0, true);
    exitCode = resolveControllerOverclockerExitCode(exitCode);
  }
  appendControllerAutoCapturedOutput();
  return { exitCode: exitCode, applyResult: readControllerApplyResultJson() };
}

function runControllerOverclockerActionForCard(card, action, rateHz) {
  if (!card) return;
  if (controllerOverclockerState.busy) return;
  card = controllerCoFinalizeCard(card);
  var cardId = getControllerCardId(card);
  controllerOverclockerState.busyCardId = cardId;
  controllerOverclockerState.busy = true;
  var dev = card;
  if (!isControllerDeviceSafeForOverclock(dev)) {
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    alert("S\u00e9curit\u00e9 : p\u00e9riph\u00e9rique non autoris\u00e9.");
    return;
  }
  if (!dev.Vid || !dev.Pid) {
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    setControllerOverclockerStatus("VID/PID manquants \u2014 rafra\u00eechis la liste.", "error");
    return;
  }
  var appliedInstanceId = String(dev.DeviceInstanceId || "");
  if (!isValidControllerDeviceInstanceId(appliedInstanceId)) {
    appliedInstanceId = resolveControllerDeviceInstanceId(dev);
  }
  if (!isValidControllerDeviceInstanceId(appliedInstanceId)) {
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    alert("Aucun vrai p\u00e9riph\u00e9rique s\u00e9lectionn\u00e9.");
    return;
  }
  var usbParentId = String(dev.UsbParentDeviceId || dev.TargetHidusbfDeviceId || "");
  if (!usbParentId) {
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    setControllerOverclockerStatus("Parent USB composite introuvable", "error");
    return;
  }
  if (!isHidusbfBundledPresent()) {
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    setControllerOverclockerStatus("HIDUSBF extrait introuvable dans Tools\\hidusbf", "error");
    return;
  }
  if (action === "apply") {
    var applyRateCheck = parseInt(rateHz, 10);
    if (applyRateCheck !== 1000 && applyRateCheck !== 8000) {
      controllerOverclockerState.busy = false;
      controllerOverclockerState.busyCardId = "";
      return;
    }
    if (applyRateCheck > parseInt(dev.MaxRateHz, 10)) {
      controllerOverclockerState.busy = false;
      controllerOverclockerState.busyCardId = "";
      setControllerOverclockerStatus("Cette manette ne supporte pas " + applyRateCheck + " Hz", "error");
      return;
    }
    dev.uiRequestedRate = applyRateCheck;
  }
  dev.applying = true;
  renderControllerCardDom(dev);
  setControllerOverclockerButtonsBusy(true);
  setControllerOverclockerStatus(action === "restore" ? "Restauration en cours..." : "Application en cours...", "info");
  window.setTimeout(function () {
    var applyRate = action === "restore" ? 125 : rateHz;
    writeControllerOverclockerLog("[DEVICE] Passed RateHz=" + applyRate);
    var result = runControllerOverclockerScriptSync("Apply-ControllerOC.ps1", {
      instanceId: appliedInstanceId,
      usbParentDeviceId: usbParentId,
      vid: dev.Vid || "",
      pid: dev.Pid || "",
      maxRateHz: parseInt(dev.MaxRateHz, 10) || 1000,
      rate: action === "restore" ? 125 : (rateHz || 0),
      uninstall: action === "restore",
      mode: action === "restore" ? "Restore" : "Apply"
    });
    controllerOverclockerState.busy = false;
    controllerOverclockerState.busyCardId = "";
    setControllerOverclockerButtonsBusy(false);
    var exitCode = result && typeof result.exitCode === "number" ? result.exitCode : -1;
    var applyResult = result && result.applyResult ? result.applyResult : readControllerApplyResultJson();
    handleControllerCardApplyResult(dev, applyResult, applyRate, exitCode, action);
  }, 20);
}

function handleControllerCardApplyResult(card, applyResult, requestedRate, exitCode, action) {
  if (!card) return;
  card.applying = false;
  card.lastApplyFailed = false;
  var cardKey = getControllerCardId(card).toUpperCase();
  if (applyResult && applyResult.Code === "RATE_NOT_SUPPORTED_BY_CONTROLLER") {
    card.lastApplyFailed = true;
    setControllerOverclockerStatus(fixUtf8Mojibake(String(applyResult.Message || "Rate non support\u00e9")), "error");
    renderControllerCardDom(card);
    return;
  }
  if (action === "apply") {
    handleControllerApplyResult(applyResult, requestedRate);
    if (applyResult && (applyResult.Success || /APPLIED|CONFIRMED|PREPARED/i.test(String(applyResult.Code || "")))) {
      if (cardKey) controllerOverclockerState.boostedControllerKeys[cardKey] = true;
    }
  } else if (applyResult && applyResult.Success) {
    setControllerOverclockerStatus("D\u00e9faut restaur\u00e9", "success");
    if (cardKey) delete controllerOverclockerState.boostedControllerKeys[cardKey];
  }
  card.uiRequestedRate = requestedRate;
  var cardIdx = 0;
  var ri;
  for (ri = 0; ri < controllerOverclockerState.cards.length; ri++) {
    if (getControllerCardId(controllerOverclockerState.cards[ri]) === getControllerCardId(card)) {
      cardIdx = ri;
      break;
    }
  }
  refreshControllerCardStatus(cardIdx, function () {}, { applying: false });
  window.setTimeout(function () {
    try { runControllerDetect("after-apply"); } catch (eAfter) {}
  }, 1500);
}

function runControllerOverclockerAction(action, rateHz) {
  if (controllerOverclockerState.busy) return;
  var dev = getSelectedControllerDevice();
  if (!dev) {
    alert("Aucune manette d\u00e9tect\u00e9e. Rafra\u00eechis la liste.");
    return;
  }
  dev = controllerCoFinalizeCard(dev);
  if (!isControllerDeviceSafeForOverclock(dev)) {
    var devLabel = fixUtf8Mojibake(
      String(dev.Name || "") + " " + String(dev.FriendlyName || "") + " " + String(dev.Type || "")
    );
    if (/keyboard|clavier|mouse|souris|touchpad|trackpad/i.test(devLabel)) {
      alert("S\u00e9curit\u00e9 : p\u00e9riph\u00e9rique clavier/souris non modifi\u00e9.");
    } else {
      alert("S\u00e9curit\u00e9 : seuls les manettes/contr\u00f4leurs de jeu sont autoris\u00e9s.");
    }
    writeControllerOverclockerLog("[DEVICE] Result: error blocked_input_device");
    setControllerOverclockerStatus("S\u00e9curit\u00e9 : p\u00e9riph\u00e9rique non autoris\u00e9.", "error");
    return;
  }
  if (!dev.Vid || !dev.Pid) {
    alert("VID/PID manquants pour ce p\u00e9riph\u00e9rique. Rafra\u00eechis la liste.");
    setControllerOverclockerStatus("VID/PID manquants \u2014 rafra\u00eechis la liste.", "error");
    return;
  }

  var appliedInstanceId = resolveControllerDeviceInstanceId(dev);
  if (!isValidControllerDeviceInstanceId(appliedInstanceId)) {
    writeControllerOverclockerLog("[HIDUSBF-AUTO] ERROR invalid DeviceInstanceId from UI");
    writeControllerOverclockerLog("[DEVICE] Rejected DeviceInstanceId=" + String(dev.InstanceId || dev.DeviceId || ""));
    alert("Aucun vrai p\u00e9riph\u00e9rique s\u00e9lectionn\u00e9.\n\nChoisis une manette dans la liste (HID\\VID_... ou USB\\VID_...).");
    setControllerOverclockerStatus("Aucun vrai p\u00e9riph\u00e9rique s\u00e9lectionn\u00e9.", "error");
    return;
  }
  var usbParentId = String(dev.TargetHidusbfDeviceId || dev.UsbCompositeParentId || dev.UsbParentDeviceId || "");
  writeControllerOverclockerLog("[DEVICE] Selected DeviceInstanceId=" + appliedInstanceId);
  writeControllerOverclockerLog("[DEVICE] Selected UsbParentDeviceId=" + (usbParentId || "(empty, script will resolve)"));
  writeControllerOverclockerLog("[DEVICE] Selected TargetHidusbfDeviceId=" + (usbParentId || "(resolve in script)"));

  if (!isHidusbfBundledPresent()) {
    setControllerOverclockerStatus("HIDUSBF extrait introuvable dans Tools\\hidusbf", "error");
    alert("HIDUSBF extrait introuvable dans Tools\\hidusbf.\n\nVerifiez que le dossier extrait est present (ex: Tools\\hidusbf\\hidusbf\\DRIVER\\).");
    return;
  }

  if (action === "apply") {
    var applyRateCheck = parseInt(rateHz, 10);
    if (applyRateCheck !== 1000 && applyRateCheck !== 8000) {
      setControllerOverclockerStatus("Rate invalide (1000 ou 8000 uniquement)", "error");
      return;
    }
    controllerOverclockerState.uiLastClickedRate = applyRateCheck;
    updateControllerApplyUi();
  } else {
    writeControllerOverclockerLog("[DEVICE] Restore default clicked");
  }
  writeControllerOverclockerLog("[DEVICE] VID/PID: " + dev.Vid + "/" + dev.Pid);
  var scriptName = "Apply-ControllerOC.ps1";
  setControllerOverclockerButtonsBusy(true);
  if (action === "restore") {
    setControllerOverclockerStatus("Restauration en cours...", "info");
  } else {
    setControllerOverclockerStatus("Application en cours...", "info");
  }
  window.setTimeout(function () {
    var applyRate = action === "restore" ? 125 : rateHz;
    writeControllerOverclockerLog("[DEVICE] Apply OC clicked rate=" + applyRate);
    writeControllerOverclockerLog("[DEVICE] Passed RateHz=" + applyRate);
    writeControllerOverclockerLog("[DEVICE] DeviceInstanceId=" + appliedInstanceId);
    writeControllerOverclockerLog("[DEVICE] UsbParentDeviceId=" + usbParentId);
    var maxHzSend = parseInt(dev.MaxRateHz, 10) || 1000;
    var result = runControllerOverclockerScriptSync(scriptName, {
      instanceId: appliedInstanceId,
      usbParentDeviceId: usbParentId,
      vid: dev.Vid || "",
      pid: dev.Pid || "",
      maxRateHz: maxHzSend,
      rate: action === "restore" ? 125 : (rateHz || 0),
      uninstall: action === "restore",
      mode: action === "restore" ? "Restore" : "Apply"
    });
    var exitCode = result && typeof result.exitCode === "number" ? result.exitCode : -1;
    var applyResult = result && result.applyResult ? result.applyResult : readControllerApplyResultJson();
    writeControllerOverclockerLog("[DEVICE] Script exit=" + exitCode);
    if (applyResult) writeControllerOverclockerLog("[DEVICE] JSON result=" + JSON.stringify(applyResult));
    if (applyResult && applyResult.Code) {
      writeControllerOverclockerLog("[DEVICE] Apply result code: " + applyResult.Code);
    }

    if (action === "apply" && rateHz) {
      handleControllerApplyResult(applyResult, rateHz);
      if (applyResult && (applyResult.Code === "APPLIED_1000_CONFIRMED" || applyResult.Code === "APPLIED_8000_CONFIRMED" || applyResult.Code === "APPLIED_CONFIRMED_1000" || applyResult.Code === "APPLIED_CONFIRMED_8000")) {
        hideControllerAssistedGuide();
        window.setTimeout(function () {
          try { runControllerDetect("after-apply"); } catch (eRefOk) {}
        }, 1500);
      } else if (exitCode === 0 && applyResult && applyResult.Success === true && applyResult.Code === "PREPARED_NEEDS_RECONNECT") {
        hideControllerAssistedGuide();
        window.setTimeout(function () {
          try { runControllerDetect("after-apply"); } catch (eRefPrep) {}
        }, 1500);
      }
    } else if (exitCode === 0 && applyResult && applyResult.Success === true && action === "restore") {
      setControllerOverclockerStatus("Default d\u00e9tect\u00e9", "success");
      hideControllerAssistedGuide();
      window.setTimeout(function () {
        try { runControllerDetect("after-apply"); } catch (eRefOk) {}
      }, 1500);
    } else if (exitCode === 20 || (applyResult && applyResult.Code === "NOT_ADMIN")) {
      writeControllerOverclockerLog("[DEVICE] Result: error not_admin");
      setControllerOverclockerStatus(
        fixUtf8Mojibake(applyResult && applyResult.Message ? applyResult.Message : "Droits administrateur requis pour appliquer HIDUSBF"),
        "error"
      );
    } else if (exitCode === 3) {
      writeControllerOverclockerLog("[DEVICE] Result: error uac_cancelled");
      setControllerOverclockerStatus("Op\u00e9ration annul\u00e9e (UAC).", "warn");
    } else if (exitCode === 4) {
      writeControllerOverclockerLog("[DEVICE] Result: error blocked_device");
      setControllerOverclockerStatus("S\u00e9curit\u00e9 : p\u00e9riph\u00e9rique clavier/souris non modifi\u00e9.", "error");
    } else if (exitCode === 1 || (applyResult && (applyResult.Code === "DEVICE_NOT_FOUND" || applyResult.Code === "INVALID_DEVICE_INSTANCE_ID"))) {
      writeControllerOverclockerLog("[DEVICE] Result: error no_device");
      setControllerOverclockerStatus(
        fixUtf8Mojibake(applyResult && applyResult.Message ? applyResult.Message : "Aucun vrai p\u00e9riph\u00e9rique s\u00e9lectionn\u00e9"),
        "error"
      );
    } else if (exitCode === 40 || (applyResult && applyResult.Code === "RATE_NOT_SUPPORTED_BY_CONTROLLER")) {
      setControllerOverclockerStatus(fixUtf8Mojibake(String(applyResult && applyResult.Message ? applyResult.Message : "Cette manette ne supporte pas ce rate")), "error");
    } else if (exitCode === 31 || (applyResult && (applyResult.Code === "USB_PARENT_NOT_FOUND" || applyResult.Code === "USB_PARENT_KEY_MISSING" || applyResult.Code === "USB_COMPOSITE_NOT_FOUND"))) {
      writeControllerOverclockerLog("[DEVICE] Result: error usb_composite_not_found");
      hideControllerAssistedGuide();
      setControllerOverclockerStatus("Parent USB composite introuvable", "error");
    } else if (exitCode === 32 || (applyResult && applyResult.Code === "WRONG_TARGET_MI_INTERFACE")) {
      writeControllerOverclockerLog("[DEVICE] Result: error wrong_target_mi");
      hideControllerAssistedGuide();
      setControllerOverclockerStatus("Cible HIDUSBF invalide (interface MI)", "error");
    } else if (action === "apply" || action === "restore") {
      var failMsg = applyResult && applyResult.Message
        ? fixUtf8Mojibake(String(applyResult.Message))
        : ("Erreur Controller OC (code " + exitCode + ")");
      writeControllerOverclockerLog("[DEVICE] Result: error");
      setControllerOverclockerStatus(failMsg, "error");
    } else {
      var errMsg = applyResult && applyResult.Message
        ? fixUtf8Mojibake(String(applyResult.Message))
        : ("Erreur (code " + exitCode + ")");
      writeControllerOverclockerLog("[DEVICE] Result: error");
      setControllerOverclockerStatus(errMsg, "error");
    }

    setControllerOverclockerButtonsBusy(false);
    window.setTimeout(function () {
      try { refreshControllerPollingStatus({ silent: false }); } catch (eAfterAct) {}
    }, exitCode === 0 ? 1200 : 400);
  }, 20);
}

function restoreControllerPollingDefault() {
  runControllerOverclockerAction("restore", 0);
}

function onControllerOverclockerSelectChange() {
  updateControllerOverclockerSelectionUi();
  var dev = getSelectedControllerDevice();
  if (dev) {
    writeControllerOverclockerLog(
      "[DEVICE] Selected controller=" + String(dev.InstanceId || dev.DeviceId || "") +
      " vid=" + (dev.Vid || "") + " pid=" + (dev.Pid || "")
    );
    controllerOverclockerState.statusPending = true;
    setControllerOverclockerPendingUi();
    try { refreshControllerPollingStatus({ silent: false }); } catch (eSelSt) {}
  } else {
    controllerOverclockerState.statusPending = false;
    renderControllerPollingStatusUi(null);
  }
}

function ensureControllerPollingStatusPanels() {
  /* Legacy no-op: compact widget markup is static in page-peripheral. */
}

function initControllerOverclockerUi() {
  updateControllerOverclockerHidusbfBadge();
  var sel = $("controllerOverclockerSelect");
  if (sel) sel.onchange = onControllerOverclockerSelectChange;
  controllerOverclockerState.statusPending = false;
  controllerOverclockerState.statusLoaded = !!(controllerOverclockerState.cards && controllerOverclockerState.cards.length);
  if (!controllerOverclockerState.cards || !controllerOverclockerState.cards.length) {
    setControllerOverclockerPendingUi();
  }
  updateControllerApplyUi();
  hideControllerAssistedGuide();
  ensureControllerOverclockerWatcher();
}

/* ---------- Onglet Périphérique : HIDUSBF (zip + extraction sur le Bureau uniquement) ---------- */
var HIDUSBF_URL = "https://raw.githubusercontent.com/LordOfMice/hidusbf/master/hidusbf.zip";

function getUserDesktopDirectory() {
  try {
    return getShell().SpecialFolders("Desktop");
  } catch (eDesk) {
    return "";
  }
}

function hidUpper(s) {
  return (s || "").toString().toUpperCase();
}

function logHidusbf(message) {
  var box = $("hidusbfLogBox");
  if (!box) return;
  var line = document.createElement("div");
  line.className = "logline";
  line.textContent = "[" + nowTime() + "] " + message;
  box.insertBefore(line, box.firstChild);
  while (box.childNodes.length > 40) box.removeChild(box.lastChild);
}

function findSetupExeInTree(fso, dir, depth) {
  if (!dir || depth > 5 || !fso.FolderExists(dir)) return "";
  try {
    var folder = fso.GetFolder(dir);
    var fc = new Enumerator(folder.Files);
    for (; !fc.atEnd(); fc.moveNext()) {
      var f = fc.item();
      var n = String(f.Name || "");
      if (hidUpper(n) === "SETUP.EXE") return f.Path;
    }
    var fe = new Enumerator(folder.SubFolders);
    for (; !fe.atEnd(); fe.moveNext()) {
      var sub = fe.item().Path;
      var got = findSetupExeInTree(fso, sub, depth + 1);
      if (got) return got;
    }
  } catch (eTree) {}
  return "";
}

function locateHidusbfSetupOnDesktop(fso, desk) {
  var extractDir = desk + "\\HIDUSBF";
  if (!fso.FolderExists(extractDir)) return "";
  return findSetupExeInTree(fso, extractDir, 0);
}

/** Décompresse hidusbf.zip sur le Bureau vers Bureau\\HIDUSBF (script temporaire dans %TEMP% uniquement). */
function expandHidusbfZipOnDesktop(zipPath, extractDir) {
  var fso = getFso();
  var tmp = fso.GetSpecialFolder(2);
  var psPath = tmp + "\\unreal-hidusbf-expand.ps1";
  var z = zipPath.replace(/'/g, "''");
  var d = extractDir.replace(/'/g, "''");
  var body =
    "$ErrorActionPreference='Stop'\r\n" +
    "if (Test-Path -LiteralPath '" +
    d +
    "') { Remove-Item -LiteralPath '" +
    d +
    "' -Recurse -Force -ErrorAction SilentlyContinue }\r\n" +
    "New-Item -ItemType Directory -Force -Path '" +
    d +
    "' | Out-Null\r\n" +
    "Unblock-File -LiteralPath '" +
    z +
    "' -ErrorAction SilentlyContinue\r\n" +
    "Expand-Archive -LiteralPath '" +
    z +
    "' -DestinationPath '" +
    d +
    "' -Force\r\n" +
    "exit 0\r\n";
  try {
    var tw = fso.CreateTextFile(psPath, true);
    tw.Write(body);
    tw.Close();
  } catch (eW) {
    return false;
  }
  return getShell().Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psPath + "\"", 0, true) === 0;
}

function downloadOrLaunchHidusbf() {
  var fso = getFso();
  var desk = getUserDesktopDirectory();
  if (!desk) {
    logHidusbf("Erreur : impossible de télécharger HIDUSBF.");
    alert("Erreur : impossible de télécharger HIDUSBF.");
    return;
  }
  var zipPath = desk + "\\hidusbf.zip";
  var extractDir = desk + "\\HIDUSBF";
  try {
    var exePath = locateHidusbfSetupOnDesktop(fso, desk);
    if (exePath) {
      logHidusbf("Lancement de HIDUSBF...");
      try {
        launchFileAsAdmin(exePath);
      } catch (eLaunch) {
        alert("Impossible de lancer HIDUSBF.");
      }
      return;
    }

    logHidusbf("Téléchargement de HIDUSBF...");
    try {
      downloadFile(HIDUSBF_URL, zipPath);
    } catch (eDl) {
      logHidusbf("Erreur : impossible de télécharger HIDUSBF.");
      alert("Erreur : impossible de télécharger HIDUSBF.");
      return;
    }
    if (!fso.FileExists(zipPath) || fso.GetFile(zipPath).Size < 50000) {
      logHidusbf("Erreur : impossible de télécharger HIDUSBF.");
      alert("Erreur : impossible de télécharger HIDUSBF.");
      return;
    }
    if (!expandHidusbfZipOnDesktop(zipPath, extractDir)) {
      logHidusbf("Erreur : impossible de télécharger HIDUSBF.");
      alert("Erreur : impossible de télécharger HIDUSBF.");
      return;
    }
    exePath = locateHidusbfSetupOnDesktop(fso, desk);
    if (!exePath) {
      logHidusbf("Erreur : impossible de télécharger HIDUSBF.");
      alert("Erreur : impossible de télécharger HIDUSBF.");
      return;
    }
    logHidusbf("HIDUSBF téléchargé sur le Bureau.");
    logHidusbf("Lancement de HIDUSBF...");
    try {
      launchFileAsAdmin(exePath);
    } catch (e2) {
      alert("Impossible de lancer HIDUSBF.");
    }
  } catch (e0) {
    logHidusbf("Erreur : impossible de télécharger HIDUSBF.");
    alert("Erreur : impossible de télécharger HIDUSBF.");
  }
}

/* ---------- TCP Optimizer 4   téléchargement PowerShell multi-méthodes ---------- */

/** Script PS : Invoke-WebRequest  →  WebClient  →  BITSAdmin (secours). */
function buildTcpDownloadPsScript() {
  var u = TCP_OPTIMIZER_URL.replace(/'/g, "''");
  var o = TCP_OPTIMIZER_PATH.replace(/'/g, "''");
  var lines = [
    "$ErrorActionPreference='SilentlyContinue'",
    "[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12",
    "$Url = '" + u + "'",
    "$OutPath = '" + o + "'",
    "function Test-ExeOk($p) {",
    "  if (-not (Test-Path $p)) { return $false }",
    "  $i = Get-Item -LiteralPath $p -ErrorAction SilentlyContinue",
    "  if (-not $i) { return $false }",
    "  return ($i.Length -gt 50000)",
    "}",
    "$dir = Split-Path -Parent $OutPath",
    "if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }",
    "if (Test-Path $OutPath) { Remove-Item -LiteralPath $OutPath -Force -ErrorAction SilentlyContinue }",
    "$ok = $false",
    "try {",
    "  Invoke-WebRequest -Uri $Url -OutFile $OutPath -UseBasicParsing",
    "  if (Test-ExeOk $OutPath) { $ok = $true }",
    "} catch {}",
    "if (-not $ok) {",
    "  try {",
    "    $wc = New-Object System.Net.WebClient",
    "    $wc.DownloadFile($Url, $OutPath)",
    "    if (Test-ExeOk $OutPath) { $ok = $true }",
    "  } catch {}",
    "}",
    "if (-not $ok) {",
    "  try {",
    "    $job = 'UNREALTCP' + (Get-Random -Maximum 99999)",
    "    $a = @('/transfer', $job, '/download', '/priority', 'high', $Url, $OutPath)",
    "    $p = Start-Process -FilePath bitsadmin.exe -ArgumentList $a -Wait -PassThru -WindowStyle Hidden",
    "    if ((Test-ExeOk $OutPath)) { $ok = $true }",
    "  } catch {}",
    "}",
    "if ($ok) { exit 0 } else { exit 1 }"
  ];
  return lines.join("\r\n");
}

/** true si le processus HTA a des droits administrateur (nécessaire pour profil TCP). */
function isRunningAsAdmin() {
  try {
    return getShell().Run("net session", 0, true) === 0;
  } catch (e0) {
    return false;
  }
}

function refreshConnAdminBanner() {
  var el = $("connAdminBanner");
  if (!el) return;
  if (isRunningAsAdmin()) {
    el.className = "conn-admin-ok";
    el.innerText = "Prêt : les optimisations réseau peuvent être appliquées directement.";
  } else {
    el.className = "conn-admin-banner";
    el.innerText = "Pour le profil gaming, une demande d'élévation Windows peut apparaître : accepte-la pour enregistrer les réglages.";
  }
  refreshConnQoSNlaUi();
}

function setConnOptimizationStatus(isOptimized) {
  var el = $("connOptimizeStatus");
  if (!el) return;
  var meta = $("connOptimizeLast");
  if (isOptimized) {
    el.className = "tcp-badge tcp-badge--ok";
    el.innerText = "Connexion optimisée";
  } else {
    el.className = "tcp-badge";
    el.innerText = "Non optimisé";
  }
  if (!meta) return;
  var st = readTcpOptimizerState();
  if (st && st.tcpOptimizerLastApplied) {
    meta.innerText = "Dernière optimisation : " + st.tcpOptimizerLastApplied;
  } else {
    meta.innerText = "Dernière optimisation : ";
  }
}

function getLocalUnrealDir() {
  var base = "";
  try { base = getShell().ExpandEnvironmentStrings("%LOCALAPPDATA%"); } catch (e0) {}
  if (!base) return "";
  return base + "\\Unreal";
}

function tcpOptimizerStatePath() {
  var d = getLocalUnrealDir();
  if (!d) return "";
  return d + "\\settings.json";
}

/** Alias pour persistance JSON pilote (même fichier que TCP si présent). */
function getNvSettingsPath() {
  return tcpOptimizerStatePath();
}

function readTcpOptimizerState() {
  try {
    var p = tcpOptimizerStatePath();
    if (!p) return null;
    var txt = readTextFileAll(p);
    if (!txt) return null;
    return JSON.parse(txt);
  } catch (e) { return null; }
}

function writeTcpOptimizerState(next) {
  try {
    var d = getLocalUnrealDir();
    var p = tcpOptimizerStatePath();
    if (!d || !p) return false;
    var fso = getFso();
    if (!fso.FolderExists(d)) fso.CreateFolder(d);
    var prev = readTcpOptimizerState() || {};
    var out = {};
    var k;
    for (k in prev) if (prev.hasOwnProperty(k)) out[k] = prev[k];
    for (k in next) if (next.hasOwnProperty(k)) out[k] = next[k];
    var tw = fso.CreateTextFile(p, true);
    tw.Write(JSON.stringify(out, null, 2));
    tw.Close();
    return true;
  } catch (eW) {
    log("Impossible d'écrire settings.json (TCP) : " + eW.message);
    return false;
  }
}

function queryRegValueText(keyPath, valueName) {
  try {
    createUnrealFolders();
    var outPath = UNREAL_LOGS + "\\tmp-reg-" + Date.now() + "-" + Math.floor(Math.random() * 10000) + ".txt";
    var cmd = "cmd /c reg query \"" + keyPath + "\" /v \"" + valueName + "\" > \"" + outPath + "\" 2>&1";
    getShell().Run(cmd, 0, true);
    var txt = readTextFileAll(outPath);
    try { if (getFso().FileExists(outPath)) getFso().DeleteFile(outPath, true); } catch (eDel) {}
    return txt || "";
  } catch (eQ) { return ""; }
}

function detectTcpOptimizerGamingApplied() {
  var checks = [
    { key: "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile", name: "NetworkThrottlingIndex", expected: /REG_DWORD\s+0xFFFFFFFF/i },
    { key: "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile", name: "SystemResponsiveness", expected: /REG_DWORD\s+0x0\b/i },
    { key: "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters", name: "TcpMaxSynRetransmissions", expected: /REG_DWORD\s+0x2\b/i },
    { key: "HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\Parameters", name: "NonSackRttResiliency", expected: /REG_DWORD\s+0x0\b/i }
  ];
  var i;
  for (i = 0; i < checks.length; i++) {
    var t = queryRegValueText(checks[i].key, checks[i].name);
    if (!t || !checks[i].expected.test(t)) return false;
  }
  return true;
}

function refreshConnOptimizationStatusFromState() {
  var st = readTcpOptimizerState() || {};
  var fromState = !!st.tcpOptimizerApplied;
  var real = false;
  try { real = detectTcpOptimizerGamingApplied(); } catch (eD) { real = fromState; }
  var finalState = real || fromState;
  setConnOptimizationStatus(finalState);
}

/** Libellé UI pour la relecture reg query « Do not use NLA » (REG_SZ). */
function mapQoSNlaRegQueryToUiLabel(regOut) {
  var t = (regOut || "").replace(/^\s+|\s+$/g, "");
  if (!t) return "N/A";
  if (/ERROR|Unable\s+to\s+find|introuvable|Impossible\s+de\s+trouver|Cannot\s+find|accès\s+refusé|Access\s+is\s+denied/i.test(t)) return "N/A";
  if (/REG_SZ\s+1(\s|$)/i.test(t)) return "optimal: 1";
  if (/REG_SZ/i.test(t)) return "non optimal";
  return "N/A";
}

/** Met à jour la ligne Connexion · QoS · Do not use NLA depuis le registre (reg query). */
function refreshConnQoSNlaUi() {
  if (!SHOW_DEBUG_UI) return;
  var el = $("connQosNlaUi");
  if (!el) return;
  try {
    createUnrealFolders();
    var tmp = UNREAL_LOGS + "\\conn-qos-nla-query.txt";
    var cmd = "cmd /c reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\QoS\" /v \"Do not use NLA\" > \"" + tmp + "\" 2>&1";
    getShell().Run(cmd, 0, true);
    el.innerText = mapQoSNlaRegQueryToUiLabel(readTextFileAll(tmp));
  } catch (eQ) {
    el.innerText = "N/A";
  }
}

/** Télécharge TCP Optimizer si absent. silent=true : pas de confirm ni alerte succès (logs seulement). */
function ensureTcpOptimizerDownloaded(silent) {
  if (fileExists(TCP_OPTIMIZER_PATH)) {
    if (!silent) log("TCP Optimizer : fichier déjà présent (" + TCP_OPTIMIZER_PATH + ").");
    return true;
  }
  if (!silent) log("TCP Optimizer absent   téléchargement automatique");
  return downloadTcpOptimizerInner(silent);
}

/**
 * Télécharge TCPOptimizer.exe (Invoke-WebRequest  →  WebClient  →  BITSAdmin).
 * silent : sans confirm / sans alerte bloquante (pour enchaînement « Appliquer profil »).
 */
function downloadTcpOptimizer(silent) {
  if (!silent && !confirmAction("UNREAL va télécharger TCP Optimizer 4. Continuer ?")) {
    log("Téléchargement TCP Optimizer : annulé.");
    return false;
  }
  return downloadTcpOptimizerInner(silent);
}

function downloadTcpOptimizerInner(silent) {
  try {
    log("Création du dossier TCP Optimizer");
    if (!createUnrealFolders()) throw new Error("Impossible de créer ProgramData\\Unreal.");
    var folderTrim = TCP_OPTIMIZER_FOLDER.replace(/\\+$/g, "");
    if (!createFolder(folderTrim)) throw new Error("Création dossier TCPOptimizer.");

    log("Téléchargement TCP Optimizer lancé");
    log("Méthode Invoke-WebRequest");
    var fso = getFso();
    if (!fso.FolderExists(UNREAL_SCRIPTS)) fso.CreateFolder(UNREAL_SCRIPTS);
    var psPath = UNREAL_SCRIPTS + "\\download-tcp-optimizer.ps1";
    var tw = fso.CreateTextFile(psPath, true);
    tw.Write(buildTcpDownloadPsScript());
    tw.Close();

    var psArg = '-File "' + psPath + '"';
    var exitCode = runPowerShell(psArg);
    log("Téléchargement terminé.");
    log("Vérification du fichier");

    if (fileExists(TCP_OPTIMIZER_PATH)) {
      log("TCP Optimizer 4 téléchargé avec succès.");
      log("TCP Optimizer prêt.");
      if (!silent) alert("TCP Optimizer 4 est disponible :\n" + TCP_OPTIMIZER_PATH);
      return true;
    }
    log("Erreur : téléchargement impossible.");
    log("Erreur téléchargement, ouverture de la page officielle possible.");
    if (exitCode !== 0) log("Code retour PowerShell : " + exitCode);
    if (!silent) alert("Le téléchargement automatique a échoué.\nUtilise « Ouvrir la page officielle » puis enregistre le fichier sous :\n" + TCP_OPTIMIZER_PATH);
    return false;
  } catch (e) {
    log("Erreur : téléchargement impossible.");
    log("ERREUR : " + e.message);
    log("Erreur téléchargement, ouverture de la page officielle possible.");
    if (!silent) alert("Erreur : " + e.message);
    return false;
  }
}

/** Alias / ancien nom de bouton */
function downloadTcpOptimizer4() { downloadTcpOptimizer(false); }

/**
 * Lance TCPOptimizer.exe avec élévation UAC.
 * @param {{ silentAlerts?: boolean, hiddenConsole?: boolean }} opt silentAlerts=true : pas d'alert() (profil gaming) ; hiddenConsole : fenêtre PowerShell masquée.
 * @returns {boolean} true si processus de lancement terminé avec code 0
 */
function launchTcpOptimizerElevated(opt) {
  opt = opt || {};
  var silentAlerts = opt.silentAlerts === true;
  var hiddenConsole = opt.hiddenConsole === true;
  var path = resolveTcpOptimizerFullPath();
  if (!path || !fileExists(path)) {
    log("TCP Optimizer introuvable.");
    if (!silentAlerts) alert("TCP Optimizer introuvable.");
    return false;
  }
  log("Lancement de TCP Optimizer en administrateur...");
  try {
    createUnrealFolders();
    var fso = getFso();
    if (!fso.FolderExists(UNREAL_SCRIPTS)) fso.CreateFolder(UNREAL_SCRIPTS);
    var dir = fso.GetParentFolderName(path);
    var psPath = UNREAL_SCRIPTS + "\\launch-tcp-optimizer-elevated.ps1";
    var esc = function (s) { return (s || "").replace(/'/g, "''"); };
    var tw = fso.CreateTextFile(psPath, true);
    tw.Write("$ErrorActionPreference = 'Continue'\n");
    tw.Write("Write-Host '--- UNREAL : elevation TCP Optimizer (UAC) ---' -ForegroundColor Cyan\n");
    tw.Write("$exe = '" + esc(path) + "'\n");
    tw.Write("$wd  = '" + esc(dir) + "'\n");
    tw.Write("if (-not (Test-Path -LiteralPath $exe)) {\n");
    tw.Write("  Write-Host 'Fichier introuvable :' $exe -ForegroundColor Red\n");
    tw.Write("  Read-Host 'Appuie sur Entree pour fermer cette fenetre'\n");
    tw.Write("  exit 2\n");
    tw.Write("}\n");
    tw.Write("Write-Host 'Fichier :' $exe\n");
    tw.Write("Write-Host 'Une fenetre UAC va s afficher : clique sur Oui pour lancer en administrateur.' -ForegroundColor Yellow\n");
    tw.Write("try {\n");
    tw.Write("  Start-Process -FilePath $exe -WorkingDirectory $wd -Verb RunAs -ErrorAction Stop\n");
    tw.Write("  Write-Host 'TCP Optimizer lance en administrateur (UAC acceptee).' -ForegroundColor Green\n");
    tw.Write("  Start-Sleep -Seconds 2\n");
    tw.Write("  exit 0\n");
    tw.Write("} catch {\n");
    tw.Write("  $m = $_.Exception.Message\n");
    tw.Write("  Write-Host 'Erreur PowerShell / UAC :' $m -ForegroundColor Red\n");
    tw.Write("  Read-Host 'Appuie sur Entree pour fermer cette fenetre'\n");
    tw.Write("  if ($m -match 'canceled|cancelled|annul|refus|denied|utilisateur|user|1223|operation was canceled') { exit 1 }\n");
    tw.Write("  exit 3\n");
    tw.Write("}\n");
    tw.Close();
    var cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + psPath + "\"";
    var exitCode = getShell().Run(cmd, hiddenConsole ? 0 : 1, true);
    if (exitCode === 0) {
      log("TCP Optimizer lancé en administrateur.");
      if (!silentAlerts) alert("TCP Optimizer lancé en administrateur.");
      return true;
    }
    if (exitCode === 2) {
      log("TCP Optimizer introuvable.");
      if (!silentAlerts) alert("TCP Optimizer introuvable.");
      return false;
    }
    if (exitCode === 1) {
      log("Lancement administrateur refusé.");
      if (!silentAlerts) alert("Lancement administrateur refusé.");
      return false;
    }
    log("Erreur : impossible de lancer TCP Optimizer en administrateur.");
    if (!silentAlerts) alert("Erreur au lancement. Regarde la fenêtre PowerShell pour le message détaillé.");
    return false;
  } catch (e) {
    log("Erreur : impossible de lancer TCP Optimizer en administrateur.");
    if (!silentAlerts) alert("Erreur au lancement. Regarde la fenêtre PowerShell pour le message détaillé.\n\n" + e.message);
    return false;
  }
}

function launchTcpOptimizer() {
  var ready = ensureTcpOptimizerDownloaded(false);
  if (!ready) {
    log("TCP Optimizer : téléchargement requis non terminé.");
    return;
  }
  launchTcpOptimizerElevated({ silentAlerts: false, hiddenConsole: false });
}

/**
 * Profil TCP = SG TCP Optimizer   Advanced Settings, mode Custom (capture référence) :
 * IE MaxConnections 4/2 (HKCU profils + HKLM), ServiceProvider 4-7, TcpMaxSynRetransmissions 2, NonSackRttResiliency 0,
 * RTO netsh 2000/300, QoS NonBestEffortLimit 0,  QoS  Do not use NLA  optimal 1), NetworkThrottlingIndex FFFFFFFF, SystemResponsiveness 0,
 * Nagle sur interfaces actives, LargeSystemCache 1, LanmanServer Size 3, MaxUserPort / TcpTimedWaitDelay supprimés si présents.
 * Vérification : relecture registre + gaming-profile-result.json (erreurs explicites, plus de message vague).
 */
function buildPsTcpGamingProfile() {
  var L = "function L($m){ Add-Content -Path $log -Value ((Get-Date -Format 'HH:mm:ss') + ' ' + $m) }";
  var lines = [
    "$ErrorActionPreference='Continue'",
    "$log='C:\\\\ProgramData\\\\Unreal\\\\logs\\\\network-profile.log'",
    L,
    "L 'Application profil TCP Gaming lancée'",
    "try {",
    "  Checkpoint-Computer -Description 'UNREAL   profil TCP gaming' -RestorePointType MODIFY_SETTINGS -ErrorAction Stop",
    "  L 'Point de restauration Windows demandé (réussi)'",
    "} catch { L ('Point de restauration Windows : '+$_.Exception.Message) }",
    "$ts=Get-Date -Format 'yyyyMMdd-HHmmss'",
    "$bd='C:\\\\ProgramData\\\\Unreal\\\\Backups\\\\'+$ts",
    "$backupDir='C:\\\\ProgramData\\\\Unreal\\\\backup'",
    "$backupReg=Join-Path $backupDir 'network-profile-backup.reg'",
    "New-Item -ItemType Directory -Force -Path $bd | Out-Null",
    "New-Item -ItemType Directory -Force -Path $backupDir | Out-Null",
    "L 'Sauvegarde registre créée'",
    "try { reg export 'HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip' $backupReg /y 2>$null | Out-Null; L ('Backup principal : '+$backupReg) } catch { L ('Backup principal : '+$_.Exception.Message) }",
    "reg export 'HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\Parameters' \"$bd\\\\tcpip-parameters.reg\" /y 2>$null | Out-Null",
    "reg export 'HKLM\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Multimedia\\\\SystemProfile' \"$bd\\\\multimedia-systemprofile.reg\" /y 2>$null | Out-Null",
    "reg export 'HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Session Manager\\\\Memory Management' \"$bd\\\\memory-management.reg\" /y 2>$null | Out-Null",
    "reg export 'HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\LanmanServer\\\\Parameters' \"$bd\\\\lanmanserver.reg\" /y 2>$null | Out-Null",
    "try { reg export 'HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\ServiceProvider' \"$bd\\\\serviceprovider.reg\" /y 2>$null | Out-Null } catch {}",
    "try { reg export 'HKLM\\\\SOFTWARE\\\\Policies\\\\Microsoft\\\\Windows\\\\Psched' \"$bd\\\\psched.reg\" /y 2>$null | Out-Null } catch {}",
    "try { reg export 'HKLM\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\QoS' \"$bd\\\\tcp-qos.reg\" /y 2>$null | Out-Null } catch {}",
    "try { reg export 'HKCU\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings' \"$bd\\\\hkcu-internet-settings.reg\" /y 2>$null | Out-Null } catch {}",
    "",
    "function Ensure-Path($p){ if(-not(Test-Path $p)){ New-Item -Path $p -Force | Out-Null } }",
    "",
    "# --- 1) Internet Explorer Optimization : MaxConnectionsPer1_0Server=4, MaxConnectionsPerServer=2 ---",
    "try {",
    "  Get-ChildItem 'Registry::HKEY_USERS' | Where-Object { $_.PSChildName -match '^S-1-5-21-[0-9\\-]+$' } | ForEach-Object {",
    "    $ie = Join-Path $_.PSPath 'Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings'",
    "    if(Test-Path $ie){",
    "      New-ItemProperty -Path $ie -Name 'MaxConnectionsPer1_0Server' -Value 4 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "      New-ItemProperty -Path $ie -Name 'MaxConnectionsPerServer' -Value 2 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "    }",
    "  }",
    "  $ieCu='HKCU:\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings'",
    "  Ensure-Path $ieCu",
    "  New-ItemProperty -Path $ieCu -Name 'MaxConnectionsPer1_0Server' -Value 4 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $ieCu -Name 'MaxConnectionsPerServer' -Value 2 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  L 'Internet Explorer Optimization (MaxConnections) appliqué'",
    "} catch { L ('ERREUR Internet Settings: '+$_.Exception.Message) }",
    "",
    "# --- 1b) Internet Settings HKLM (MaxConnectionsPer1_0Server=4, MaxConnectionsPerServer=2) ---",
    "try {",
    "  $ieLm='HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings'",
    "  Ensure-Path $ieLm",
    "  New-ItemProperty -Path $ieLm -Name 'MaxConnectionsPer1_0Server' -Value 4 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $ieLm -Name 'MaxConnectionsPerServer' -Value 2 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  L 'Internet Settings HKLM (MaxConnections) appliqué'",
    "} catch { L ('ERREUR Internet Settings HKLM: '+$_.Exception.Message) }",
    "",
    "# --- 2) Host Resolution Priority : Local 4, Hosts 5, Dns 6, Netbt 7 (UI « HostPriority » = clé HostsPriority) ---",
    "try {",
    "  $sp='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\ServiceProvider'",
    "  Ensure-Path $sp",
    "  New-ItemProperty -Path $sp -Name 'LocalPriority' -Value 4 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $sp -Name 'HostsPriority' -Value 5 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $sp -Name 'DnsPriority' -Value 6 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $sp -Name 'NetbtPriority' -Value 7 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  L 'Host Resolution Priority appliqué'",
    "} catch { L ('ERREUR ServiceProvider: '+$_.Exception.Message) }",
    "",
    "# --- 3-4) Retransmissions + Nagle global : TcpMaxSynRetransmissions=2, NonSackRttResiliency=0 (desactive), TcpAckFrequency/TCPNoDelay/TcpDelAckTicks ---",
    "try {",
    "  $tp='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\Parameters'",
    "  New-ItemProperty -Path $tp -Name 'TcpMaxSynRetransmissions' -Value 2 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $tp -Name 'InitialRto' -Value 2000 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $tp -Name 'MinRto' -Value 300 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $tp -Name 'NonSackRttResiliency' -Value 0 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $tp -Name 'TcpAckFrequency' -Value 1 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $tp -Name 'TCPNoDelay' -Value 1 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $tp -Name 'TcpDelAckTicks' -Value 0 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  L 'Tcpip\\\\Parameters : retransmissions + Nagle (global) appliqués'",
    "} catch { L ('ERREUR Tcpip\\\\Parameters: '+$_.Exception.Message) }",
    "try {",
    "  $n1 = Start-Process -FilePath netsh.exe -ArgumentList @('int','tcp','set','global','maxsynretransmissions=2') -Wait -PassThru -WindowStyle Hidden -ErrorAction SilentlyContinue",
    "  if ($n1 -and $n1.ExitCode -eq 0) { L 'netsh maxsynretransmissions=2 appliqué' } else { L 'netsh maxsynretransmissions non supporté (fallback registre conservé)' }",
    "} catch { L ('netsh maxsynretransmissions: '+$_.Exception.Message) }",
    "try {",
    "  $n2 = Start-Process -FilePath netsh.exe -ArgumentList @('int','tcp','set','global','nonsackrttresiliency=disabled') -Wait -PassThru -WindowStyle Hidden -ErrorAction SilentlyContinue",
    "  if ($n2 -and $n2.ExitCode -eq 0) { L 'netsh nonsackrttresiliency=disabled appliqué' } else { L 'netsh nonsackrttresiliency non supporté (fallback registre conservé)' }",
    "} catch { L ('netsh nonsackrttresiliency: '+$_.Exception.Message) }",
    "",
    "# --- 5) Type / QoS : NonBestEffortLimit=0 ---",
    "try {",
    "  $ps='HKLM:\\\\SOFTWARE\\\\Policies\\\\Microsoft\\\\Windows\\\\Psched'",
    "  Ensure-Path $ps",
    "  New-ItemProperty -LiteralPath $ps -Name 'NonBestEffortLimit' -Value 0 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  L 'QoS NonBestEffortLimit=0 appliqué'",
    "} catch { L ('ERREUR Psched (NonBestEffortLimit): '+$_.Exception.Message) }",
    "# --- 5b) QoS : Do not use NLA = 1 (best effort, non bloquant) ---",
    "try {",
    "  $qosPath='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\QoS'",
    "  Ensure-Path $qosPath",
    "  New-ItemProperty -LiteralPath $qosPath -Name 'Do not use NLA' -Value '1' -PropertyType String -Force -ErrorAction SilentlyContinue | Out-Null",
    "  Start-Process -FilePath 'reg.exe' -ArgumentList @('add','HKLM\\SYSTEM\\CurrentControlSet\\Services\\Tcpip\\QoS','/v','Do not use NLA','/t','REG_SZ','/d','1','/f') -Wait -WindowStyle Hidden -ErrorAction SilentlyContinue | Out-Null",
    "  L 'QoS Do not use NLA appliqué (best effort, non bloquant)'",
    "} catch { L ('QoS Do not use NLA ignoré (non bloquant) : '+$_.Exception.Message) }",
    "",
    "# --- 6) Gaming : NetworkThrottlingIndex=ffffffff, SystemResponsiveness=0 ---",
    "try {",
    "  $mm='HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Multimedia\\\\SystemProfile'",
    "  Ensure-Path $mm",
    "  New-ItemProperty -Path $mm -Name 'NetworkThrottlingIndex' -Value ([UInt32]::MaxValue) -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $mm -Name 'SystemResponsiveness' -Value 0 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  try {",
    "    $p = Start-Process -FilePath reg.exe -ArgumentList @('add','HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile','/v','NetworkThrottlingIndex','/t','REG_DWORD','/d','ffffffff','/f') -Wait -PassThru -WindowStyle Hidden -ErrorAction SilentlyContinue",
    "    if ($p -and $p.ExitCode -eq 0) { L 'NetworkThrottlingIndex (secours reg.exe)' }",
    "  } catch {}",
    "  L 'NetworkThrottlingIndex + SystemResponsiveness appliqués'",
    "} catch { L ('ERREUR SystemProfile: '+$_.Exception.Message) }",
    "",
    "# --- 7) Nagle sur interfaces réseau actives (TcpAckFrequency=1, TCPNoDelay=1, TcpDelAckTicks=0) ---",
    "try {",
    "  $ifRoot='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\Parameters\\\\Interfaces'",
    "  $ifaceItems = @(Get-ChildItem -LiteralPath $ifRoot -ErrorAction SilentlyContinue)",
    "  $nagleTargets = @()",
    "  foreach ($it in $ifaceItems) {",
    "    $pr = Get-ItemProperty -LiteralPath $it.PSPath -ErrorAction SilentlyContinue",
    "    if (-not $pr) { continue }",
    "    $dhcpOk = $false",
    "    if ($pr.PSObject.Properties['DhcpIPAddress'] -and $pr.DhcpIPAddress -match '^\\d+\\.\\d+') { if ($pr.DhcpIPAddress -notmatch '^0\\.0\\.0\\.0') { $dhcpOk = $true } }",
    "    $ipOk = $false",
    "    if ($pr.PSObject.Properties['IPAddress']) { foreach ($a in @($pr.IPAddress)) { if ($a -match '^\\d+\\.\\d+' -and $a -ne '0.0.0.0') { $ipOk = $true } } }",
    "    $dhcpEn = ($pr.EnableDhcp -eq 1)",
    "    $gwOk = $false",
    "    if ($pr.PSObject.Properties['DefaultGateway']) { foreach ($gw in @($pr.DefaultGateway)) { if ($gw -match '^\\d+\\.\\d+' -and $gw -ne '0.0.0.0') { $gwOk = $true } } }",
    "    if ($dhcpOk -or $ipOk -or $dhcpEn -or $gwOk) { $nagleTargets += $it }",
    "  }",
    "  if ($nagleTargets.Count -eq 0) { L 'Aucune interface active détectée pour Nagle (IP/passerelle absente).' }",
    "  foreach ($it in @($nagleTargets)) {",
    "    New-ItemProperty -Path $it.PSPath -Name 'TcpAckFrequency' -Value 1 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "    New-ItemProperty -Path $it.PSPath -Name 'TCPNoDelay' -Value 1 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "    New-ItemProperty -Path $it.PSPath -Name 'TcpDelAckTicks' -Value 0 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  }",
    "  L ('Nagle appliqué sur '+$nagleTargets.Count+' interface(s) Tcpip')",
    "} catch { L ('ERREUR interfaces Nagle: '+$_.Exception.Message) }",
    "",
    "# --- 8) Network Memory : LargeSystemCache=1 ---",
    "try {",
    "  $mem='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Session Manager\\\\Memory Management'",
    "  New-ItemProperty -Path $mem -Name 'LargeSystemCache' -Value 1 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  L 'LargeSystemCache=1 appliqué'",
    "} catch { L ('ERREUR Memory Management: '+$_.Exception.Message) }",
    "",
    "# --- 8b) LanmanServer : Size=3 (optimized) ---",
    "try {",
    "  $ls='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\LanmanServer\\\\Parameters'",
    "  New-ItemProperty -Path $ls -Name 'Size' -Value 3 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "  L 'LanmanServer Size=3 appliqué'",
    "} catch { L ('ERREUR LanmanServer: '+$_.Exception.Message) }",
    "",
    "# --- 9) Dynamic Port : suppression des anciens tweaks pour retour comportement Windows ---",
    "try {",
    "  $tp='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\Parameters'",
    "  Remove-ItemProperty -LiteralPath $tp -Name 'MaxUserPort' -ErrorAction SilentlyContinue",
    "  Remove-ItemProperty -LiteralPath $tp -Name 'TcpTimedWaitDelay' -ErrorAction SilentlyContinue",
    "  L 'MaxUserPort et TcpTimedWaitDelay supprimés si présents'",
    "} catch { L ('ERREUR suppression Dynamic Port: '+$_.Exception.Message) }",
    "",
    "# --- 4) Retransmit Timeout (RTO) : Initial=2000, Min=300 (netsh) ---",
    "$rtoOk=$false",
    "try {",
    "  $p1 = Start-Process -FilePath netsh.exe -ArgumentList @('int','tcp','set','global','initialrto=2000') -Wait -PassThru -WindowStyle Hidden",
    "  if($p1 -and $p1.ExitCode -eq 0){ $rtoOk=$true; L 'Initial RTO netsh tenté' }",
    "} catch { L ('netsh initialrto: '+$_.Exception.Message) }",
    "try {",
    "  $p2 = Start-Process -FilePath netsh.exe -ArgumentList @('int','tcp','set','global','minrto=300') -Wait -PassThru -WindowStyle Hidden",
    "  if($p2 -and $p2.ExitCode -eq 0){ $rtoOk=$true; L 'Min RTO netsh tenté' }",
    "} catch { L ('netsh minrto: '+$_.Exception.Message) }",
    "if(-not $rtoOk){ L 'RTO netsh : non appliqué sur cette version Windows (non bloquant pour la vérification registre).' }",
    "try { ipconfig.exe /flushdns 2>&1 | Out-Null; L 'ipconfig /flushdns appliqué' } catch { L ('ipconfig /flushdns: '+$_.Exception.Message) }",
    "",
    "# --- Vérification post-application (relecture registre, erreurs détaillées) ---",
    "$jsonOut='C:\\\\ProgramData\\\\Unreal\\\\Logs\\\\gaming-profile-result.json'",
    "$verifyErrors = New-Object System.Collections.ArrayList",
    "function Add-VerifErr([string]$msg) { L $msg; [void]$verifyErrors.Add($msg) }",
    "$ifRootV='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\Parameters\\\\Interfaces'",
    "$ifaceItemsV = @(Get-ChildItem -LiteralPath $ifRootV -ErrorAction SilentlyContinue)",
    "$nagleTargetsV = @()",
    "foreach ($itv in $ifaceItemsV) {",
    "  $prv = Get-ItemProperty -LiteralPath $itv.PSPath -ErrorAction SilentlyContinue",
    "  if (-not $prv) { continue }",
    "  $dhcpOkV = $false",
    "  if ($prv.PSObject.Properties['DhcpIPAddress'] -and $prv.DhcpIPAddress -match '^\\d+\\.\\d+') { if ($prv.DhcpIPAddress -notmatch '^0\\.0\\.0\\.0') { $dhcpOkV = $true } }",
    "  $ipOkV = $false",
    "  if ($prv.PSObject.Properties['IPAddress']) { foreach ($av in @($prv.IPAddress)) { if ($av -match '^\\d+\\.\\d+' -and $av -ne '0.0.0.0') { $ipOkV = $true } } }",
    "  $dhcpEnV = ($prv.EnableDhcp -eq 1)",
    "  $gwOkV = $false",
    "  if ($prv.PSObject.Properties['DefaultGateway']) { foreach ($gwv in @($prv.DefaultGateway)) { if ($gwv -match '^\\d+\\.\\d+' -and $gwv -ne '0.0.0.0') { $gwOkV = $true } } }",
    "  if ($dhcpOkV -or $ipOkV -or $dhcpEnV -or $gwOkV) { $nagleTargetsV += $itv }",
    "}",
    "if ($nagleTargetsV.Count -eq 0) { L 'Vérification Nagle : aucune interface active détectée.' }",
    "$mmPathSys='HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Multimedia\\\\SystemProfile'",
    "function Test-NtiVal($obj) {",
    "  if (-not $obj) { return $false }",
    "  $v = $obj.NetworkThrottlingIndex",
    "  if ($null -eq $v) { return $false }",
    "  if ($v -eq -1) { return $true }",
    "  try { return ([uint32]$v -eq [uint32]::MaxValue) } catch { return $false }",
    "}",
    "function Test-SrZero($obj) {",
    "  if (-not $obj) { return $false }",
    "  try { return ([uint32]$obj.SystemResponsiveness -eq 0) } catch { return $false }",
    "}",
    "try {",
    "  Ensure-Path $mmPathSys",
    "  $mmg = Get-ItemProperty -LiteralPath $mmPathSys -ErrorAction SilentlyContinue",
    "  if (-not (Test-NtiVal $mmg)) {",
    "    New-ItemProperty -LiteralPath $mmPathSys -Name 'NetworkThrottlingIndex' -Value ([UInt32]::MaxValue) -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "    Start-Process -FilePath reg.exe -ArgumentList @('add','HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile','/v','NetworkThrottlingIndex','/t','REG_DWORD','/d','ffffffff','/f') -Wait -WindowStyle Hidden -ErrorAction SilentlyContinue | Out-Null",
    "    $mmg = Get-ItemProperty -LiteralPath $mmPathSys -ErrorAction SilentlyContinue",
    "  }",
    "  if (-not (Test-NtiVal $mmg)) { Add-VerifErr 'Erreur : impossible d''appliquer NetworkThrottlingIndex dans HKLM\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Multimedia\\\\SystemProfile. Lance l''application en administrateur.' }",
    "  if (-not (Test-SrZero $mmg)) {",
    "    New-ItemProperty -LiteralPath $mmPathSys -Name 'SystemResponsiveness' -Value 0 -PropertyType DWord -Force -ErrorAction SilentlyContinue | Out-Null",
    "    $mmg = Get-ItemProperty -LiteralPath $mmPathSys -ErrorAction SilentlyContinue",
    "  }",
    "  if (-not (Test-SrZero $mmg)) { Add-VerifErr 'Erreur : impossible d''appliquer SystemResponsiveness dans HKLM\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Multimedia\\\\SystemProfile. Lance l''application en administrateur.' }",
    "} catch { Add-VerifErr ('Erreur : SystemProfile   '+$_.Exception.Message+'. Lance l''application en administrateur.') }",
    "$tpg = $null",
    "try {",
    "  $tpg = Get-ItemProperty -Path 'HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\Parameters' -ErrorAction SilentlyContinue",
    "  if (-not $tpg) { Add-VerifErr 'Erreur : clé Tcpip\\\\Parameters inaccessible.' }",
    "  else {",
    "    if ($null -eq $tpg.TcpMaxSynRetransmissions -or [int]$tpg.TcpMaxSynRetransmissions -ne 2) { Add-VerifErr 'Erreur : TcpMaxSynRetransmissions != 2.' }",
    "    if ($null -eq $tpg.NonSackRttResiliency -or [int]$tpg.NonSackRttResiliency -ne 0) { Add-VerifErr 'Erreur : NonSackRttResiliency != 0 (désactivé).' }",
    "    if ($null -ne $tpg.TcpDelAckTicks -and [int]$tpg.TcpDelAckTicks -ne 0) { Add-VerifErr 'Erreur : TcpDelAckTicks global != 0.' }",
    "  }",
    "  $gAck = $false; $gNd = $false; $gDelOk = $true",
    "  if ($tpg) {",
    "    if ($null -ne $tpg.TcpAckFrequency -and [int]$tpg.TcpAckFrequency -eq 1) { $gAck = $true }",
    "    if ($null -ne $tpg.TCPNoDelay -and [int]$tpg.TCPNoDelay -eq 1) { $gNd = $true }",
    "    if ($null -ne $tpg.TcpDelAckTicks -and [int]$tpg.TcpDelAckTicks -ne 0) { $gDelOk = $false }",
    "  }",
    "  $globalNagleOk = ($gAck -and $gNd -and $gDelOk)",
    "  $ifaceNagleOk = $true",
    "  foreach ($itn in $nagleTargetsV) {",
    "    $pn = Get-ItemProperty -LiteralPath $itn.PSPath -ErrorAction SilentlyContinue",
    "    $gid = $itn.PSChildName",
    "    if (-not $pn) { Add-VerifErr ('Erreur : impossible de lire l''interface Tcpip '+$gid+' (Nagle).'); $ifaceNagleOk = $false; continue }",
    "    if ($null -eq $pn.TcpAckFrequency -or [int]$pn.TcpAckFrequency -ne 1) { Add-VerifErr ('Erreur : TcpAckFrequency non appliqué sur l''interface '+$gid+'.'); $ifaceNagleOk = $false }",
    "    if ($null -eq $pn.TCPNoDelay -or [int]$pn.TCPNoDelay -ne 1) { Add-VerifErr ('Erreur : TCPNoDelay non appliqué sur l''interface '+$gid+'.'); $ifaceNagleOk = $false }",
    "    if ($null -eq $pn.TcpDelAckTicks -or [int]$pn.TcpDelAckTicks -ne 0) { Add-VerifErr ('Erreur : TcpDelAckTicks non appliqué sur l''interface '+$gid+'.'); $ifaceNagleOk = $false }",
    "  }",
    "  if ($nagleTargetsV.Count -gt 0 -and -not $ifaceNagleOk) { Add-VerifErr 'Erreur : Nagle non appliqué sur une ou plusieurs interfaces actives.' }",
    "} catch { Add-VerifErr ('Erreur : vérification Tcpip / Nagle   '+$_.Exception.Message) }",
    "try {",
    "  $spg = Get-ItemProperty -Path 'HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\ServiceProvider' -ErrorAction SilentlyContinue",
    "  if ($null -eq $spg.LocalPriority -or [int]$spg.LocalPriority -ne 4) { Add-VerifErr 'Erreur : LocalPriority != 4 (Host Resolution).' }",
    "  if ($null -eq $spg.HostsPriority -or [int]$spg.HostsPriority -ne 5) { Add-VerifErr 'Erreur : HostsPriority != 5.' }",
    "  if ($null -eq $spg.DnsPriority -or [int]$spg.DnsPriority -ne 6) { Add-VerifErr 'Erreur : DnsPriority != 6.' }",
    "  if ($null -eq $spg.NetbtPriority -or [int]$spg.NetbtPriority -ne 7) { Add-VerifErr 'Erreur : NetbtPriority != 7.' }",
    "} catch { Add-VerifErr ('Erreur : ServiceProvider   '+$_.Exception.Message) }",
    "try {",
    "  if (-not (Test-Path -LiteralPath 'HKLM:\\\\SOFTWARE\\\\Policies\\\\Microsoft\\\\Windows\\\\Psched')) { Add-VerifErr 'Erreur : clé HKLM\\\\SOFTWARE\\\\Policies\\\\Microsoft\\\\Windows\\\\Psched absente (QoS NonBestEffortLimit).' }",
    "  else {",
    "    $psg = Get-ItemProperty -LiteralPath 'HKLM:\\\\SOFTWARE\\\\Policies\\\\Microsoft\\\\Windows\\\\Psched' -ErrorAction SilentlyContinue",
    "    if ($null -eq $psg.NonBestEffortLimit -or [int]$psg.NonBestEffortLimit -ne 0) { Add-VerifErr 'Erreur : NonBestEffortLimit != 0.' }",
    "  }",
    "} catch { Add-VerifErr ('Erreur : Psched (NonBestEffortLimit)   '+$_.Exception.Message) }",
    "L 'QoS Do not use NLA : vérification ignorée (non bloquant).'",
    "try {",
    "  $memg = Get-ItemProperty -Path 'HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Session Manager\\\\Memory Management' -Name LargeSystemCache -ErrorAction SilentlyContinue",
    "  if ($null -eq $memg.LargeSystemCache -or [int]$memg.LargeSystemCache -ne 1) { Add-VerifErr 'Erreur : LargeSystemCache != 1 (Network Memory).' }",
    "} catch { Add-VerifErr ('Erreur : Memory Management   '+$_.Exception.Message) }",
    "try {",
    "  $lsg = Get-ItemProperty -Path 'HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\LanmanServer\\\\Parameters' -Name Size -ErrorAction SilentlyContinue",
    "  if ($null -eq $lsg.Size -or [int]$lsg.Size -ne 3) { Add-VerifErr 'Erreur : LanmanServer Size != 3 (optimized).' }",
    "} catch { Add-VerifErr ('Erreur : LanmanServer   '+$_.Exception.Message) }",
    "try {",
    "  $ieu = Get-ItemProperty -Path 'HKCU:\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings' -ErrorAction SilentlyContinue",
    "  if ($null -eq $ieu.MaxConnectionsPer1_0Server -or [int]$ieu.MaxConnectionsPer1_0Server -ne 4) { Add-VerifErr 'Erreur : MaxConnectionsPer1_0Server != 4 (IE / HKCU).' }",
    "  if ($null -eq $ieu.MaxConnectionsPerServer -or [int]$ieu.MaxConnectionsPerServer -ne 2) { Add-VerifErr 'Erreur : MaxConnectionsPerServer != 2 (IE / HKCU).' }",
    "} catch { Add-VerifErr ('Erreur : Internet Settings HKCU   '+$_.Exception.Message) }",
    "try {",
    "  $iel = Get-ItemProperty -Path 'HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings' -ErrorAction SilentlyContinue",
    "  if ($iel) {",
    "    if ($null -eq $iel.MaxConnectionsPer1_0Server -or [int]$iel.MaxConnectionsPer1_0Server -ne 4) { Add-VerifErr 'Erreur : MaxConnectionsPer1_0Server != 4 (HKLM).' }",
    "    if ($null -eq $iel.MaxConnectionsPerServer -or [int]$iel.MaxConnectionsPerServer -ne 2) { Add-VerifErr 'Erreur : MaxConnectionsPerServer != 2 (HKLM).' }",
    "  }",
    "} catch { Add-VerifErr ('Erreur : Internet Settings HKLM   '+$_.Exception.Message) }",
    "try {",
    "  $outObj = [ordered]@{ success = ($verifyErrors.Count -eq 0); errors = @($verifyErrors.ToArray()) }",
    "  $jsonText = $outObj | ConvertTo-Json -Depth 6",
    "  [System.IO.File]::WriteAllText($jsonOut, $jsonText, (New-Object System.Text.UTF8Encoding($false)))",
    "} catch { L ('Impossible d ecrire gaming-profile-result.json : '+$_.Exception.Message) }",
    "if ($verifyErrors.Count -gt 0) {",
    "  L ('VERIF ECHEC profil gaming ('+$verifyErrors.Count+' erreur(s)).')",
    "  exit 2",
    "}",
    "L 'VERIF OK : valeurs du profil gaming (Custom) présentes dans le registre.'",
    "L 'Profil Gaming terminé'",
    "L 'Redémarrage conseillé'",
    "Write-Host 'UNREAL: profil TCP gaming appliqué et vérifié.'",
    "exit 0"
  ];
  return lines.join("\r\n");
}

/** Restauration réseau complète : netsh + registre, résultat JSON (plus de exit 2 sur « rien n a changé »). */
function buildPsTcpRestoreNetwork() {
  var jsonOut = UNREAL_LOGS + "\\\\network-restore-result.json";
  var ipLog = UNREAL_LOGS + "\\\\unreal-netsh-ip-reset.log";
  var L = "function L($m){ Add-Content -Path $log -Value ((Get-Date -Format 'HH:mm:ss') + ' ' + $m) }";
  var lines = [
    "$ErrorActionPreference='Continue'",
    "$log='C:\\\\ProgramData\\\\Unreal\\\\Logs\\\\tcp-profile.log'",
    "$jsonOut='" + jsonOut.replace(/'/g, "''") + "'",
    "$ipLog='" + ipLog.replace(/'/g, "''") + "'",
    L,
    "$result = [ordered]@{ success=$true; alreadyDefault=$false; fatalErrors=(New-Object System.Collections.ArrayList); warnings=(New-Object System.Collections.ArrayList); steps=(New-Object System.Collections.ArrayList); netshTcpShowGlobal=''; before=$null; after=$null }",
    "",
    "function Gaming-Snapshot {",
    "  $mm = Get-ItemProperty 'HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Multimedia\\\\SystemProfile' -ErrorAction SilentlyContinue",
    "  $ntiG=$false; $srG=$false",
    "  if ($mm) {",
    "    try { if ([uint32]$mm.NetworkThrottlingIndex -eq [uint32]::MaxValue) { $ntiG=$true } } catch {}",
    "    try { if ([uint32]$mm.SystemResponsiveness -eq 0) { $srG=$true } } catch {}",
    "  }",
    "  $tp = Get-ItemProperty 'HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\Parameters' -ErrorAction SilentlyContinue",
    "  $ack = $false; if ($tp -and $null -ne $tp.TcpAckFrequency) { $ack=$true }",
    "  return [ordered]@{ ntiGaming=$ntiG; srGaming=$srG; tcpAck=$ack }",
    "}",
    "",
    "function Run-Step([string]$label,[string]$exe,[string[]]$arguments,[bool]$critical=$false) {",
    "  L $label",
    "  $code = -999",
    "  try {",
    "    $p = Start-Process -FilePath $exe -ArgumentList $arguments -Wait -PassThru -WindowStyle Hidden -ErrorAction Stop",
    "    if ($null -ne $p -and $null -ne $p.ExitCode) { $code = [int]$p.ExitCode } else { $code = 0 }",
    "  } catch {",
    "    $msg = $_.Exception.Message",
    "    L ('  ERREUR '+$label+' : '+$msg)",
    "    [void]$result.fatalErrors.Add(($label+' | '+$exe+' '+($arguments -join ' ')+' | '+$msg))",
    "    if ($critical) { $result.success = $false }",
    "    $code = -1",
    "  }",
    "  $argStr = if ($arguments) { $arguments -join ' ' } else { '' }",
    "  [void]$result.steps.Add([ordered]@{ label=$label; executable=$exe; arguments=$argStr; exitCode=$code })",
    "  if ($code -ne 0 -and $code -ne -999) {",
    "    L ('  -> code sortie '+$code)",
    "    if ($critical) { $result.success=$false; [void]$result.fatalErrors.Add($label+' : code '+$code) }",
    "    else { [void]$result.warnings.Add($label+' : code '+$code+' (souvent normal si non supporte sur cette version Windows)') }",
    "  }",
    "}",
    "",
    "function RmProp($p,$n){ try { Remove-ItemProperty -LiteralPath $p -Name $n -Force -ErrorAction SilentlyContinue; L ('Supprimé : '+$p+' :: '+$n) } catch {} }",
    "",
    "L 'Restauration réseau demandée...'",
    "L 'Vérification des droits administrateur...'",
    "L 'Droits administrateur OK (ce script s exécute en contexte élevé).'",
    "L 'Restauration réseau lancée (netsh + registre).'",
    "$result.before = Gaming-Snapshot",
    "",
    "Run-Step 'Vidage du cache DNS...' 'ipconfig.exe' @('/flushdns') $true",
    "Run-Step 'Réinitialisation Winsock...' 'netsh.exe' @('winsock','reset') $true",
    "Run-Step 'Réinitialisation TCP/IP (stack)...' 'netsh.exe' @('int','ip','reset',$ipLog) $false",
    "",
    "Run-Step 'TCP autotuning (normal)...' 'netsh.exe' @('int','tcp','set','global','autotuninglevel=normal') $false",
    "Run-Step 'Congestion provider (internet, défaut)...' 'netsh.exe' @('int','tcp','set','supplemental','internet','congestionprovider=default') $false",
    "Run-Step 'Congestion provider (datacenter, défaut)...' 'netsh.exe' @('int','tcp','set','supplemental','datacenter','congestionprovider=default') $false",
    "Run-Step 'RSS...' 'netsh.exe' @('int','tcp','set','global','rss=enabled') $false",
    "Run-Step 'ECN...' 'netsh.exe' @('int','tcp','set','global','ecn=disabled') $false",
    "Run-Step 'Timestamps TCP...' 'netsh.exe' @('int','tcp','set','global','timestamps=enabled') $false",
    "Run-Step 'Chimney Offload (legacy)...' 'netsh.exe' @('int','tcp','set','global','chimney=disabled') $false",
    "Run-Step 'NetDMA (legacy)...' 'netsh.exe' @('int','tcp','set','global','netdma=disabled') $false",
    "Run-Step 'RTO initial=3000...' 'netsh.exe' @('int','tcp','set','global','initialrto=3000') $false",
    "Run-Step 'RTO min=300...' 'netsh.exe' @('int','tcp','set','global','minrto=300') $false",
    "",
    "# --- Internet Settings ---",
    "try {",
    "  $ieCu='HKCU:\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings'",
    "  if(Test-Path $ieCu){ RmProp $ieCu 'MaxConnectionsPer1_0Server'; RmProp $ieCu 'MaxConnectionsPerServer' }",
    "  Get-ChildItem 'Registry::HKEY_USERS' -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -match '^S-1-5-21-[0-9\\-]+$' } | ForEach-Object {",
    "    $ie = Join-Path $_.PSPath 'Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Internet Settings'",
    "    if(Test-Path $ie){ RmProp $ie 'MaxConnectionsPer1_0Server'; RmProp $ie 'MaxConnectionsPerServer' }",
    "  }",
    "  L 'Internet Settings : MaxConnections supprimées'",
    "} catch { L ('Internet Settings: '+$_.Exception.Message); [void]$result.warnings.Add($_.Exception.Message) }",
    "",
    "# --- ServiceProvider ---",
    "try {",
    "  $sp='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\ServiceProvider'",
    "  foreach($n in @('LocalPriority','HostsPriority','DnsPriority','NetbtPriority')){ RmProp $sp $n }",
    "  L 'ServiceProvider : priorités supprimées'",
    "} catch { L ('ServiceProvider: '+$_.Exception.Message) }",
    "",
    "# --- Tcpip Parameters global ---",
    "try {",
    "  $tp='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\Parameters'",
    "  foreach($n in @('TcpAckFrequency','TCPNoDelay','TcpDelAckTicks','TcpMaxSynRetransmissions','NonSackRttResiliency','GlobalMaxTcpWindowSize','Tcp1323Opts','DefaultTTL')){ RmProp $tp $n }",
    "  L 'Tcpip\\\\Parameters : clés tuning supprimées'",
    "} catch { L ('Tcpip Parameters: '+$_.Exception.Message) }",
    "",
    "# --- Interfaces Tcpip ---",
    "try {",
    "  $ifRoot='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\Parameters\\\\Interfaces'",
    "  Get-ChildItem -LiteralPath $ifRoot -ErrorAction SilentlyContinue | ForEach-Object {",
    "    foreach($n in @('TcpAckFrequency','TCPNoDelay','TcpDelAckTicks')){ RmProp $_.PSPath $n }",
    "  }",
    "  L 'Interfaces Tcpip : Nagle supprimé'",
    "} catch { L ('Interfaces: '+$_.Exception.Message) }",
    "",
    "# --- QoS Psched + Tcpip QoS ---",
    "try { Remove-Item -LiteralPath 'HKLM:\\\\SOFTWARE\\\\Policies\\\\Microsoft\\\\Windows\\\\Psched' -Recurse -Force -ErrorAction SilentlyContinue; L 'Psched supprimé' } catch {}",
    "try {",
    "  $qos='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\Tcpip\\\\QoS'",
    "  RmProp $qos 'Do not use NLA'",
    "  L 'Tcpip\\\\QoS : Do not use NLA supprimé'",
    "} catch {}",
    "",
    "# --- Multimedia SystemProfile ---",
    "try {",
    "  $mm='HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Windows NT\\\\CurrentVersion\\\\Multimedia\\\\SystemProfile'",
    "  New-ItemProperty -Path $mm -Name 'NetworkThrottlingIndex' -PropertyType DWord -Value 10 -Force -ErrorAction SilentlyContinue | Out-Null",
    "  New-ItemProperty -Path $mm -Name 'SystemResponsiveness' -PropertyType DWord -Value 20 -Force -ErrorAction SilentlyContinue | Out-Null",
    "  L 'SystemProfile : NetworkThrottlingIndex=10 SystemResponsiveness=20'",
    "} catch { L ('SystemProfile: '+$_.Exception.Message); [void]$result.warnings.Add($_.Exception.Message) }",
    "",
    "# --- Memory + LanmanServer ---",
    "try {",
    "  $mem='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Control\\\\Session Manager\\\\Memory Management'",
    "  New-ItemProperty -Path $mem -Name 'LargeSystemCache' -PropertyType DWord -Value 0 -Force -ErrorAction SilentlyContinue | Out-Null",
    "  L 'LargeSystemCache=0'",
    "} catch {}",
    "try {",
    "  $ls='HKLM:\\\\SYSTEM\\\\CurrentControlSet\\\\Services\\\\LanmanServer\\\\Parameters'",
    "  New-ItemProperty -Path $ls -Name 'Size' -PropertyType DWord -Value 1 -Force -ErrorAction SilentlyContinue | Out-Null",
    "  L 'LanmanServer Size=1'",
    "} catch {}",
    "",
    "L 'Vérification des valeurs après restauration...'",
    "$result.after = Gaming-Snapshot",
    "$b = $result.before",
    "$result.alreadyDefault = ((-not $b.ntiGaming) -and (-not $b.srGaming) -and (-not $b.tcpAck))",
    "try { $result.netshTcpShowGlobal = (netsh.exe int tcp show global 2>&1 | Out-String) } catch { $result.netshTcpShowGlobal = $_.Exception.Message }",
    "",
    "if ($result.after.ntiGaming -or $result.after.srGaming) {",
    "  [void]$result.warnings.Add('NetworkThrottlingIndex ou SystemResponsiveness indiquent encore des valeurs type profil gaming   redémarrage Windows souvent nécessaire après netsh int ip reset.')",
    "}",
    "if ($result.after.tcpAck) { [void]$result.warnings.Add('TcpAckFrequency encore présent sur Parameters (droits ou pilote).') }",
    "",
    "L 'Restauration réseau terminée.'",
    "L 'Redémarrage Windows conseillé.'",
    "try {",
    "  $jsonText = $result | ConvertTo-Json -Depth 12",
    "  [System.IO.File]::WriteAllText($jsonOut, $jsonText, (New-Object System.Text.UTF8Encoding($false)))",
    "  L ('Resultat JSON : '+$jsonOut)",
    "} catch {",
    "  L ('Impossible d ecrire le JSON resultat : '+$_.Exception.Message)",
    "  $result.success = $false",
    "  [void]$result.fatalErrors.Add('JSON: '+$_.Exception.Message)",
    "}",
    "if ($result.success) { exit 0 } else { exit 10 }"
  ];
  return lines.join("\r\n");
}

function readGamingProfileVerifyErrors() {
  try {
    var p = UNREAL_LOGS + "\\gaming-profile-result.json";
    var txt = readTextFileAll(p);
    if (!txt) return "";
    var o = JSON.parse(txt);
    if (!o) return "";
    var errs = o.errors || o.Errors;
    if (!errs || !errs.length) return "";
    return errs.join("\n");
  } catch (eRead) {
    return "";
  }
}

/** Message d'erreur court pour l'utilisateur (QoS NLA : libellés explicites). */
function simpleGamingVerifyUserMessage(detail) {
  var d = detail || "";
  if (!d) return "Erreur : la vérification du profil a échoué.";
  var first = d.split(/\r?\n/)[0];
  if (!first) return "Erreur : la vérification du profil a échoué.";
  if (/Do not use NLA/i.test(first)) {
    return "Avertissement QoS Do not use NLA (non bloquant, profil appliqué).";
  }
  return first;
}

function applyTcpOptimizerGamingProfile() {
  if (!confirmAction("UNREAL va appliquer le profil gaming (registre Windows + netsh, comme TCP Optimizer en mode Custom). Continuer ?")) return;
  log("Application du profil gaming...");
  if (!createUnrealFolders()) {
    log("Erreur : préparation des fichiers.");
    alert("Erreur : impossible de préparer l'application. Réessaie.");
    refreshConnAdminBanner();
    return;
  }
  var tcpReady = ensureTcpOptimizerDownloaded(true);
  if (!tcpReady) log("Avertissement : TCP Optimizer introuvable (l'application du profil continue quand même).");
  var fso = getFso();
  var tcpPath = resolveTcpOptimizerFullPath();
  try {
    if (!isRunningAsAdmin()) {
      var htaPath = getUnrealHtaPath();
      if (htaPath && fso.FileExists(htaPath)) {
        log("Mode non administrateur détecté. Relance en administrateur...");
        var app = new ActiveXObject("Shell.Application");
        var wd = fso.GetParentFolderName(htaPath);
        app.ShellExecute("mshta.exe", '"' + htaPath + '"', wd, "runas", 1);
        alert("Une demande Windows va s'ouvrir. Une fois acceptée, utilise « Appliquer profil gaming » dans la fenêtre administrateur (la fenêtre actuelle reste ouverte).");
        return;
      }
      alert("Erreur : accès registre refusé malgré le mode administrateur non actif.");
      refreshConnAdminBanner();
      return;
    }
    if (!fso.FolderExists(UNREAL_SCRIPTS)) fso.CreateFolder(UNREAL_SCRIPTS);
    var innerPath = UNREAL_SCRIPTS + "\\apply-tcp-gaming-profile.ps1";
    var t = fso.CreateTextFile(innerPath, true);
    t.Write(buildPsTcpGamingProfile());
    t.Close();
    var exitCode;
    var psExe = getPowerShell64Path();
    var psInner = "\"" + psExe + "\" -NoProfile -ExecutionPolicy Bypass -File \"" + innerPath + "\"";
    log("0criture des réglages registre...");
    exitCode = getShell().Run(psInner, 0, true);
    log("Vérification des réglages...");
    if (exitCode === 0) {
      refreshConnQoSNlaUi();
      try {
        var elN = $("connQosNlaUi");
        if (elN) log("QoS Do not use NLA : affichage UI = " + (elN.innerText || ""));
      } catch (eNlaUi) {}
      log("Lancement de TCP Optimizer en administrateur...");
      if (tcpReady && tcpPath && fileExists(tcpPath)) {
        try {
          getShell().Run("\"" + tcpPath + "\"", 1, false);
        } catch (eTcp) {
          log("TCP Optimizer : lancement direct refusé, tentative script...");
          launchTcpOptimizerElevated({ silentAlerts: true, hiddenConsole: true });
        }
      }
      log("Profil gaming appliqué avec succès.");
      writeTcpOptimizerState({ tcpOptimizerApplied: true, tcpOptimizerLastApplied: nowDateTimeFr() });
      setConnOptimizationStatus(true);
      alert("Profil gaming appliqué avec succès. Redémarrage conseillé.");
    } else if (exitCode === 2) {
      log("échec vérification profil gaming.");
      setConnOptimizationStatus(false);
      var detail = readGamingProfileVerifyErrors();
      alert(detail ? simpleGamingVerifyUserMessage(detail) : "Erreur : la vérification du profil a échoué.");
    } else {
      log("Erreur profil gaming (code " + exitCode + ").");
      setConnOptimizationStatus(false);
      var detailUnknown = readGamingProfileVerifyErrors();
      alert(detailUnknown ? simpleGamingVerifyUserMessage(detailUnknown) : ("Erreur : impossible d'appliquer le profil gaming (code " + exitCode + ")."));
    }
  } catch (e) {
    log("ERREUR profil TCP : " + e.message);
    setConnOptimizationStatus(false);
    var detailCatch = readGamingProfileVerifyErrors();
    alert(detailCatch ? simpleGamingVerifyUserMessage(detailCatch) : ("Erreur : impossible d'appliquer le profil gaming. " + e.message));
  }
  refreshConnAdminBanner();
}

function restoreTcpNetworkWindowsDefaults() {
  if (!confirmAction("UNREAL va restaurer les réglages réseau (Winsock, pile TCP/IP, netsh, registre TCP / multimédia). Un redémarrage peut être nécessaire. Continuer ?")) return;
  var resultPath = UNREAL_LOGS + "\\network-restore-result.json";
  var backupReg = "C:\\ProgramData\\Unreal\\backup\\network-profile-backup.reg";
  log("Restauration réseau demandée...");
  log("Vérification des droits administrateur...");
  try {
    var fso = getFso();
    createUnrealFolders();
    if (fso.FileExists(backupReg)) {
      log("Backup détecté, restauration depuis le backup réseau...");
      var importCmd = "reg.exe import \"" + backupReg + "\"";
      if (isRunningAsAdmin()) {
        var importCode = getShell().Run(importCmd, 0, true);
        if (importCode === 0) {
          log("Backup réseau restauré.");
          writeTcpOptimizerState({ tcpOptimizerApplied: false, tcpOptimizerLastRestored: nowDateTimeFr() });
          setConnOptimizationStatus(false);
          alert("Réglages réseau restaurés depuis le backup. Redémarrage conseillé.");
          return;
        }
      }
    }
    if (!fso.FolderExists(UNREAL_SCRIPTS)) fso.CreateFolder(UNREAL_SCRIPTS);
    try {
      if (fso.FileExists(resultPath)) fso.DeleteFile(resultPath, true);
    } catch (eDel) {}
    var innerPath = UNREAL_SCRIPTS + "\\restore-tcp-network.ps1";
    var ti = fso.CreateTextFile(innerPath, true);
    ti.Write(buildPsTcpRestoreNetwork());
    ti.Close();
    var exitCode;
    var admin = isRunningAsAdmin();
    if (admin) {
      log("Droits administrateur OK.");
      log("Réinitialisation Winsock...");
      log("Réinitialisation TCP/IP...");
      log("Restauration des paramètres TCP par défaut...");
      log("Vidage du cache DNS...");
      log("Restauration des réglages réseau en cours...");
      exitCode = getShell().Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + innerPath + "\"", 0, true);
    } else {
      log("Droits administrateur non détectés   demande d'élévation UAC (PowerShell)...");
      var esc = function (s) { return (s || "").replace(/'/g, "''"); };
      var outerPath = UNREAL_SCRIPTS + "\\restore-tcp-network-elevated.ps1";
      var tw = fso.CreateTextFile(outerPath, true);
      tw.Write("$ErrorActionPreference = 'Continue'\n");
      tw.Write("Write-Host '--- UNREAL : restauration reseau (elevation UAC) ---' -ForegroundColor Cyan\n");
      tw.Write("$inner = '" + esc(innerPath) + "'\n");
      tw.Write("if (-not (Test-Path -LiteralPath $inner)) {\n");
      tw.Write("  Write-Host 'Script introuvable :' $inner -ForegroundColor Red\n");
      tw.Write("  Read-Host 'Appuie sur Entree pour fermer cette fenetre'\n");
      tw.Write("  exit 5\n");
      tw.Write("}\n");
      tw.Write("Write-Host 'Une fenetre UAC va s afficher : clique sur Oui pour restaurer les reglages reseau.' -ForegroundColor Yellow\n");
      tw.Write("try {\n");
      tw.Write("  $p = Start-Process -FilePath powershell.exe -ArgumentList @('-NoProfile','-ExecutionPolicy','Bypass','-WindowStyle','Hidden','-File', $inner) -Verb RunAs -PassThru -Wait -ErrorAction Stop\n");
      tw.Write("  if ($null -eq $p) { Write-Host 'Processus inconnu.' -ForegroundColor Red; exit 4 }\n");
      tw.Write("  $c = $p.ExitCode\n");
      tw.Write("  if ($null -eq $c) { $c = 0 }\n");
      tw.Write("  Write-Host ('Code sortie restauration : ' + $c) -ForegroundColor Green\n");
      tw.Write("  Start-Sleep -Seconds 1\n");
      tw.Write("  exit [int]$c\n");
      tw.Write("} catch {\n");
      tw.Write("  $m = $_.Exception.Message\n");
      tw.Write("  Write-Host 'Erreur PowerShell / UAC :' $m -ForegroundColor Red\n");
      tw.Write("  Read-Host 'Appuie sur Entree pour fermer cette fenetre'\n");
      tw.Write("  if ($m -match 'canceled|cancelled|annul|refus|denied|utilisateur|user|1223|operation was canceled') { exit 1 }\n");
      tw.Write("  exit 3\n");
      tw.Write("}\n");
      tw.Close();
      exitCode = getShell().Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + outerPath + "\"", 1, true);
    }
    log("Vérification des valeurs après restauration...");
    var txt = readTextFileAll(resultPath);
    var res = null;
    try {
      if (txt) res = JSON.parse(txt);
    } catch (eJson) {
      log("Impossible de lire le fichier résultat JSON : " + eJson.message);
      if (txt && txt.length) log("Aperçu fichier résultat : " + txt.substring(0, 240).replace(/\r/g, "\\r").replace(/\n/g, "\\n"));
    }
    if (exitCode === 1) {
      log("échec : demande UAC annulée ou refusée.");
      alert("La restauration réseau a été annulée (UAC).");
      return;
    }
    if (exitCode === 3) {
      log("échec : erreur PowerShell lors de l'élévation (code 3).");
      alert("Erreur lors du lancement de la restauration en administrateur. Consulte le log :\n" + UNREAL_LOGS + "\\tcp-profile.log");
      return;
    }
    if (exitCode === 4) {
      log("échec : processus élevé inconnu (code 4).");
      alert("La restauration n'a pas pu démarrer correctement (code 4). Réessaie ou lance UNREAL en administrateur.");
      return;
    }
    if (exitCode === 5) {
      log("Erreur : script de restauration introuvable (code 5).");
      alert("Erreur : le script de restauration est introuvable. Vérifie C:\\ProgramData\\Unreal\\Scripts.");
      return;
    }
    if (exitCode === 10) {
      log("échec restauration réseau : le script interne a signalé une erreur (code 10).");
      if (res && res.fatalErrors && res.fatalErrors.length) {
        var k, errBlock = "";
        for (k = 0; k < res.fatalErrors.length; k++) {
          errBlock += res.fatalErrors[k] + "\n";
          log("Erreur commande / exécution : " + res.fatalErrors[k]);
        }
        alert("échec : une ou plusieurs étapes critiques ont échoué.\n\n" + errBlock + "\nVoir " + UNREAL_LOGS + "\\tcp-profile.log");
      } else {
        alert("La restauration a échoué (code 10). Consulte le log :\n" + UNREAL_LOGS + "\\tcp-profile.log");
      }
      return;
    }
    if (exitCode !== 0) {
      log("échec restauration réseau : code PowerShell inattendu " + exitCode + ".");
      alert("La restauration a renvoyé un code inattendu (" + exitCode + "). Consulte le log :\n" + UNREAL_LOGS + "\\tcp-profile.log");
      return;
    }
    if (res && res.steps) {
      var i, st;
      for (i = 0; i < res.steps.length; i++) {
        st = res.steps[i];
        if (st && st.label) log(st.label + "   code " + (st.exitCode != null ? st.exitCode : "?"));
      }
    }
    if (res && res.fatalErrors && res.fatalErrors.length) {
      var j, errLines = "";
      for (j = 0; j < res.fatalErrors.length; j++) {
        errLines += res.fatalErrors[j] + "\n";
        log("Erreur commande / exécution : " + res.fatalErrors[j]);
      }
      alert("échec : une ou plusieurs étapes critiques ont échoué.\n\n" + errLines + "\nVoir " + UNREAL_LOGS + "\\tcp-profile.log");
      return;
    }
    if (!res && exitCode === 0) {
      log("Avertissement : résultat JSON absent ou illisible alors que le script a renvoyé 0   vérifie " + resultPath + " et tcp-profile.log.");
    }
    if (res && res.warnings && res.warnings.length) {
      var w;
      for (w = 0; w < res.warnings.length; w++) log("Avertissement : " + res.warnings[w]);
    }
    log("Restauration réseau terminée.");
    log("Redémarrage Windows conseillé.");
    writeTcpOptimizerState({ tcpOptimizerApplied: false, tcpOptimizerLastRestored: nowDateTimeFr() });
    setConnOptimizationStatus(false);
    var wasAlreadyDefault = res && (res.alreadyDefault === true || res.alreadyDefault === "True" || res.alreadyDefault === "true");
    if (wasAlreadyDefault) {
      log("Les réglages réseau sont déjà par défaut.");
      alert("Les réglages réseau sont déjà par défaut.\n\nLes commandes netsh / registre ont tout de même été exécutées. Redémarrage conseillé pour valider dans TCP Optimizer.");
    } else {
      alert("Réglages réseau restaurés. Redémarrage conseillé.");
    }
  } catch (e) {
    log("échec restauration réseau : " + e.message);
    alert("Erreur : " + e.message);
  }
}

/* ---------- Optimisation : grille toggles + mémoire JSON interne ---------- */
var OPTIMIZATION_ITEMS = null;
var optimizationSavedSelected = {};
var optimizationUiSelected = {};
var optimizationApplyBusy = false;
var optimizationApplyRun = null;

function buildOptimizationItemsCatalog() {
  var items = [
    { id: "debloat", label: "Debloat", description: "", enableScript: "Scripts\\Optimisation\\Debloat\\enable.ps1", disableScript: "Scripts\\Optimisation\\Debloat\\disable.ps1", placeholder: false },
    { id: "mode-jeu", label: "Mode Jeu", description: "", enableScript: "Scripts\\Optimisation\\ModeJeu\\enable.ps1", disableScript: "Scripts\\Optimisation\\ModeJeu\\disable.ps1", placeholder: false },
    { id: "gestion-alimentation", label: "Gestion de l'alimentation", description: "", enableScript: "Scripts\\Optimisation\\GestionAlimentation\\enable.ps1", disableScript: "Scripts\\Optimisation\\GestionAlimentation\\disable.ps1", placeholder: false }
  ];
  var i;
  for (i = 4; i <= 15; i++) {
    items.push({ id: "empty-" + i, label: "", description: "", enableScript: "", disableScript: "", placeholder: true });
  }
  return items;
}

function getOptimizationItems() {
  if (!OPTIMIZATION_ITEMS) OPTIMIZATION_ITEMS = buildOptimizationItemsCatalog();
  return OPTIMIZATION_ITEMS;
}

function getOptimizationItemById(id) {
  var items = getOptimizationItems();
  var i;
  for (i = 0; i < items.length; i++) {
    if (items[i].id === id) return items[i];
  }
  return null;
}

function getOptimizationStatePath() {
  return getShell().ExpandEnvironmentStrings("%ProgramData%") + "\\PurpleBoost\\optimization-state.json";
}

function getOptimizationStateDir() {
  return getShell().ExpandEnvironmentStrings("%ProgramData%") + "\\PurpleBoost";
}

function getOptimizationRunnerLogPath() {
  // Chemin fiable (dev + exe packagé) : %ProgramData%\PurpleBoost\logs\
  try {
    var pd = getShell().ExpandEnvironmentStrings("%ProgramData%") || "C:\\ProgramData";
    return pd + "\\PurpleBoost\\logs\\optimization-runner.log";
  } catch (e0) {
    return UNREAL_LOGS + "\\optimization-runner.log";
  }
}

function nowIsoLocal() {
  var d = new Date();
  function z(n) { return n < 10 ? "0" + n : "" + n; }
  return d.getFullYear() + "-" + z(d.getMonth() + 1) + "-" + z(d.getDate()) + "T" +
    z(d.getHours()) + ":" + z(d.getMinutes()) + ":" + z(d.getSeconds());
}

function appendOptimizationRunnerLog(message) {
  try {
    var fso = getFso();
    var path = getOptimizationRunnerLogPath();
    var dir = fso.GetParentFolderName(path);
    if (dir && !fso.FolderExists(dir)) fso.CreateFolder(dir);
    var line = "[" + nowTime() + "] " + String(message || "");
    if (!fso.FileExists(path)) {
      var c = fso.CreateTextFile(path, true);
      c.WriteLine(line);
      c.Close();
      return;
    }
    var t = fso.OpenTextFile(path, 8, true);
    t.WriteLine(line);
    t.Close();
  } catch (eLog) {}
}

function ensureOptimizationStateDir() {
  var fso = getFso();
  var dir = getOptimizationStateDir();
  if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
}

function loadOptimizationStateFromDisk() {
  ensureOptimizationStateDir();
  optimizationSavedSelected = {};
  var fso = getFso();
  var path = getOptimizationStatePath();
  if (!fso.FileExists(path)) return;
  try {
    var raw = readTextFileAll(path);
    if (!raw) return;
    var obj = JSON.parse(raw);
    var sel = obj.selected || obj.Selected || {};
    var items = getOptimizationItems();
    var i;
    for (i = 0; i < items.length; i++) {
      if (items[i].placeholder) continue;
      if (sel.hasOwnProperty(items[i].id)) optimizationSavedSelected[items[i].id] = !!sel[items[i].id];
      else optimizationSavedSelected[items[i].id] = false;
    }
  } catch (eLoad) {
    appendOptimizationRunnerLog("load state error: " + (eLoad.message || eLoad));
    optimizationSavedSelected = {};
  }
}

function saveOptimizationStateToDisk() {
  ensureOptimizationStateDir();
  var payload = {
    selected: {},
    lastApplyAt: nowIsoLocal()
  };
  var items = getOptimizationItems();
  var i;
  for (i = 0; i < items.length; i++) {
    if (items[i].placeholder) continue;
    payload.selected[items[i].id] = !!optimizationSavedSelected[items[i].id];
  }
  var path = getOptimizationStatePath();
  writeUtf8TextFileAll(path, JSON.stringify(payload, null, 2));
  appendOptimizationRunnerLog("state saved " + path);
}

function cloneOptimizationSelectedMap(src) {
  var out = {};
  var k;
  for (k in src) {
    if (src.hasOwnProperty(k)) out[k] = !!src[k];
  }
  return out;
}

function syncOptimizationUiFromSaved() {
  optimizationUiSelected = cloneOptimizationSelectedMap(optimizationSavedSelected);
  renderOptimizationGridStates();
}

function getOptimizationUiSelectedMap() {
  var out = {};
  var items = getOptimizationItems();
  var i;
  for (i = 0; i < items.length; i++) {
    if (items[i].placeholder) continue;
    out[items[i].id] = !!optimizationUiSelected[items[i].id];
  }
  return out;
}

function resolveOptimizationScriptPath(relPath) {
  // Ne jamais dépendre d'un chemin relatif fragile depuis l'HTA.
  // Essaie plusieurs racines pour fonctionner en dev + en .exe packagé (resources).
  if (!relPath) return "";
  var fso = getFso();
  var rp = String(relPath || "").replace(/\//g, "\\");
  var tail = rp.replace(/^Scripts\\/i, "");

  var roots = [];
  try { if (getAppFolderFromHta()) roots.push(getAppFolderFromHta()); } catch (eA) {}
  try { if (getUnrealHtaDirectory()) roots.push(getUnrealHtaDirectory()); } catch (eH) {}
  try {
    var pd = getShell().ExpandEnvironmentStrings("%ProgramData%") || "C:\\ProgramData";
    roots.push(pd + "\\PurpleBoost");
  } catch (eP) {}

  var tried = [];
  function tryPath(p) {
    if (!p) return "";
    var ap = getAbsolutePathFs(p);
    tried.push(ap);
    if (fso.FileExists(ap)) return ap;
    return "";
  }

  var i;
  for (i = 0; i < roots.length; i++) {
    var r = roots[i];
    // 1) <root>\Scripts\Optimisation\...\ (dev: repo)
    var p1 = tryPath(combinePath(r, rp));
    if (p1) return p1;
    // 2) <root>\resources\Scripts\Optimisation\...\ (packaged)
    var p2 = tryPath(combinePath(combinePath(r, "resources"), rp));
    if (p2) return p2;
    // 3) <root>\resources\Scripts\<tail> (packaged, no leading Scripts\)
    var p3 = tryPath(combinePath(combinePath(combinePath(r, "resources"), "Scripts"), tail));
    if (p3) return p3;
    // 4) <root>\Scripts\<tail> (repo style, no leading Scripts\)
    var p4 = tryPath(combinePath(combinePath(r, "Scripts"), tail));
    if (p4) return p4;
  }

  appendOptimizationRunnerLog("script not found rel=" + rp + " tried=" + tried.join(" | "));
  return "";
}

function runOptimizationScriptSync(scriptPath) {
  var fso = getFso();
  if (!scriptPath || !fso.FileExists(scriptPath)) {
    appendOptimizationRunnerLog("missing script path=" + String(scriptPath || "(empty)"));
    return { ok: false, exitCode: -1, missing: true, error: "missing" };
  }
  var psExe = getPowerShell64Path();
  var cmd = "\"" + psExe + "\" -NoProfile -ExecutionPolicy Bypass -File \"" + scriptPath + "\"";
  appendOptimizationRunnerLog("run " + scriptPath);
  var exitCode = getShell().Run(cmd, 0, true);
  appendOptimizationRunnerLog("exit " + scriptPath + " code=" + exitCode);
  return { ok: exitCode === 0, exitCode: exitCode, missing: false, error: exitCode === 0 ? "" : ("exit " + exitCode) };
}

function buildOptimizationApplyActions() {
  var actions = [];
  var items = getOptimizationItems();
  var i;
  for (i = 0; i < items.length; i++) {
    var it = items[i];
    if (it.placeholder) continue;
    var savedOn = !!optimizationSavedSelected[it.id];
    var uiOn = !!optimizationUiSelected[it.id];
    if (savedOn === uiOn) continue;
    var scriptRel = uiOn ? it.enableScript : it.disableScript;
    var scriptPath = resolveOptimizationScriptPath(scriptRel);
    actions.push({
      id: it.id,
      label: it.label,
      targetOn: uiOn,
      scriptPath: scriptPath,
      scriptRel: scriptRel
    });
  }
  return actions;
}

function setOptimizationRunnerMessage(text, kind) {
  var el = $("optRunnerStatus");
  if (!el) return;
  el.innerText = text || "";
  el.className = "opt-runner-status";
  if (kind === "ok") el.className += " opt-runner-status--ok";
  else if (kind === "err") el.className += " opt-runner-status--err";
  else if (kind === "muted") el.className += " opt-runner-status--muted";
}

function setOptimizationProgress(percent, stepText) {
  var wrap = $("optProgressWrap");
  var fill = $("optProgressFill");
  var text = $("optProgressText");
  var step = $("optProgressStep");
  if (wrap) wrap.className = "opt-progress-wrap opt-progress-wrap--visible";
  var p = Math.max(0, Math.min(100, Math.round(percent)));
  if (fill) fill.style.width = p + "%";
  if (text) text.innerText = p + " %";
  if (step) step.innerText = stepText || "";
}

function hideOptimizationProgress() {
  var wrap = $("optProgressWrap");
  if (wrap) wrap.className = "opt-progress-wrap";
  var fill = $("optProgressFill");
  if (fill) fill.style.width = "0%";
}

function setOptimizationApplyUiBusy(busy) {
  optimizationApplyBusy = !!busy;
  var btn = $("btnOptimizationApply");
  if (btn) btn.disabled = busy;
}

function renderOptimizationCardState(id) {
  var card = $("opt-card-" + id);
  var toggle = $("opt-toggle-" + id);
  if (!card || !toggle) return;
  var on = !!optimizationUiSelected[id];
  card.className = "opt-card" + (on ? " opt-card--on" : "");
  toggle.className = "opt-toggle" + (on ? " opt-toggle--on" : "");
  toggle.setAttribute("aria-pressed", on ? "true" : "false");
}

function renderOptimizationGridStates() {
  var items = getOptimizationItems();
  var i;
  for (i = 0; i < items.length; i++) {
    if (items[i].placeholder) continue;
    renderOptimizationCardState(items[i].id);
  }
}

function onOptimizationToggleClick(id, evt) {
  if (evt && evt.cancelBubble !== undefined) evt.cancelBubble = true;
  if (optimizationApplyBusy) return;
  var it = getOptimizationItemById(id);
  if (!it || it.placeholder) return;
  optimizationUiSelected[id] = !optimizationUiSelected[id];
  renderOptimizationCardState(id);
}

function onOptimizationCardClick(id) {
  if (optimizationApplyBusy) return;
  onOptimizationToggleClick(id, null);
}

function wireOptimizationGridEvents() {
  var host = $("optOptimizationGrid");
  if (!host) return;
  var items = getOptimizationItems();
  var i;
  for (i = 0; i < items.length; i++) {
    if (items[i].placeholder) continue;
    (function (it) {
      var card = $("opt-card-" + it.id);
      var toggle = $("opt-toggle-" + it.id);
      if (card) {
        card.onclick = function () { onOptimizationCardClick(it.id); };
      }
      if (toggle) {
        toggle.onclick = function (e) {
          if (e && e.stopPropagation) e.stopPropagation();
          else if (e) e.cancelBubble = true;
          onOptimizationToggleClick(it.id, e);
        };
      }
    })(items[i]);
  }
}

function renderOptimizationGrid() {
  var host = $("optOptimizationGrid");
  if (!host) return;
  if (host.getElementsByClassName && host.getElementsByClassName("opt-card").length >= 15) {
    wireOptimizationGridEvents();
    renderOptimizationGridStates();
    return;
  }
  host.innerHTML = "";
  var items = getOptimizationItems();
  var i;
  for (i = 0; i < items.length; i++) {
    (function (it) {
      var card = document.createElement("div");
      card.id = "opt-card-" + it.id;
      if (it.placeholder) {
        card.className = "opt-card opt-card--placeholder";
        host.appendChild(card);
        return;
      }
      card.className = "opt-card";
      card.onclick = function () { onOptimizationCardClick(it.id); };
      var head = document.createElement("div");
      head.className = "opt-card__head";
      var textWrap = document.createElement("div");
      var title = document.createElement("div");
      title.className = "opt-card__title";
      title.appendChild(document.createTextNode(it.label));
      textWrap.appendChild(title);
      if (it.description) {
        var desc = document.createElement("div");
        desc.className = "opt-card__desc";
        desc.appendChild(document.createTextNode(it.description));
        textWrap.appendChild(desc);
      }
      head.appendChild(textWrap);
      var toggle = document.createElement("button");
      toggle.type = "button";
      toggle.id = "opt-toggle-" + it.id;
      toggle.className = "opt-toggle";
      toggle.setAttribute("aria-label", "Activer " + it.label);
      toggle.onclick = function (e) {
        if (e && e.stopPropagation) e.stopPropagation();
        else if (e) e.cancelBubble = true;
        onOptimizationToggleClick(it.id, e);
      };
      var thumb = document.createElement("span");
      thumb.className = "opt-toggle__thumb";
      toggle.appendChild(thumb);
      head.appendChild(toggle);
      card.appendChild(head);
      host.appendChild(card);
    })(items[i]);
  }
  renderOptimizationGridStates();
}

function initOptimizationTab() {
  loadOptimizationStateFromDisk();
  try { renderOptimizationGrid(); } catch (eGrid) {
    appendOptimizationRunnerLog("grid error: " + (eGrid.message || eGrid));
  }
  try { wireOptimizationGridEvents(); } catch (eWire) {}
  syncOptimizationUiFromSaved();
  hideOptimizationProgress();
  setOptimizationApplyUiBusy(false);
  if (!optimizationApplyBusy) setOptimizationRunnerMessage("", "muted");
}

function runNextOptimizationApplyStep() {
  if (!optimizationApplyRun) return;
  var run = optimizationApplyRun;
  if (run.index >= run.actions.length) {
    optimizationSavedSelected = cloneOptimizationSelectedMap(run.pendingSaved);
    try { saveOptimizationStateToDisk(); } catch (eSave) {
      setOptimizationRunnerMessage("Erreur lors de l'enregistrement de l'état.", "err");
      setOptimizationApplyUiBusy(false);
      optimizationApplyRun = null;
      return;
    }
    syncOptimizationUiFromSaved();
    setOptimizationProgress(100, "Terminé");
    setOptimizationRunnerMessage("Optimisations appliquées.", "ok");
    setOptimizationApplyUiBusy(false);
    optimizationApplyRun = null;
    window.setTimeout(hideOptimizationProgress, 1200);
    return;
  }
  var act = run.actions[run.index];
  var total = run.actions.length;
  var pctBefore = (run.completed / total) * 100;
  setOptimizationProgress(pctBefore, "En cours : " + act.label + "...");
  if (!act.scriptPath) {
    setOptimizationRunnerMessage("Script manquant pour " + act.label + ".", "err");
    appendOptimizationRunnerLog("missing script " + (act.scriptRel || act.id));
    setOptimizationApplyUiBusy(false);
    optimizationApplyRun = null;
    hideOptimizationProgress();
    return;
  }
  var result = runOptimizationScriptSync(act.scriptPath);
  if (!result.ok) {
    if (result.missing) setOptimizationRunnerMessage("Script manquant pour " + act.label + ".", "err");
    else setOptimizationRunnerMessage("Erreur pendant l'application de " + act.label + ".", "err");
    setOptimizationApplyUiBusy(false);
    optimizationApplyRun = null;
    hideOptimizationProgress();
    return;
  }
  run.pendingSaved[act.id] = act.targetOn;
  run.completed++;
  run.index++;
  var pctAfter = (run.completed / total) * 100;
  setOptimizationProgress(pctAfter, run.index < total ? ("Terminé : " + act.label) : "Terminé");
  window.setTimeout(runNextOptimizationApplyStep, 40);
}

function applyOptimizationChanges() {
  if (optimizationApplyBusy) return;
  if (!confirmAction("UNREAL va appliquer les optimisations sélectionnées. Continuer ?")) return;
  var actions = buildOptimizationApplyActions();
  if (!actions.length) {
    setOptimizationRunnerMessage("Aucune modification à appliquer.", "muted");
    hideOptimizationProgress();
    return;
  }
  var pendingSaved = cloneOptimizationSelectedMap(optimizationSavedSelected);
  optimizationApplyRun = {
    actions: actions,
    index: 0,
    completed: 0,
    pendingSaved: pendingSaved
  };
  setOptimizationApplyUiBusy(true);
  setOptimizationRunnerMessage("Application en cours...", "muted");
  setOptimizationProgress(0, "Démarrage...");
  appendOptimizationRunnerLog("apply start actions=" + actions.length);
  window.setTimeout(runNextOptimizationApplyStep, 30);
}

/* ========== PurpleBoost — Auth locale (remplaçable par API serveur) ========== */
function getPurpleBoostDataDir() {
  try {
    var pd = getShell().ExpandEnvironmentStrings("%ProgramData%") || "C:\\ProgramData";
    return pd + "\\PurpleBoost";
  } catch (e0) {
    return "C:\\ProgramData\\PurpleBoost";
  }
}

function ensurePurpleBoostDataDir() {
  try {
    var fso = getFso();
    var dir = getPurpleBoostDataDir();
    if (!fso.FolderExists(dir)) fso.CreateFolder(dir);
    var logs = dir + "\\logs";
    if (!fso.FolderExists(logs)) fso.CreateFolder(logs);
    return true;
  } catch (eDir) {
    return false;
  }
}

function pbUsersPath() { return getPurpleBoostDataDir() + "\\users.json"; }
function pbReadTextFileUtf8(path) {
  var fso = getFso();
  if (!fso.FileExists(path)) return "";
  var t = fso.OpenTextFile(path, 1, false, -1);
  var s = t.ReadAll();
  t.Close();
  return s;
}

function pbWriteTextFileUtf8(path, content) {
  var fso = getFso();
  var dir = fso.GetParentFolderName(path);
  if (dir && !fso.FolderExists(dir)) fso.CreateFolder(dir);
  var w = fso.CreateTextFile(path, true, true);
  w.Write(String(content || ""));
  w.Close();
}

function pbSha256Hex(input) {
  var s = String(input || "");
  var chrsz = 8;
  function safe_add(x, y) {
    var lsw = (x & 0xFFFF) + (y & 0xFFFF);
    var msw = (x >> 16) + (y >> 16) + (lsw >> 16);
    return (msw << 16) | (lsw & 0xFFFF);
  }
  function S(X, n) { return (X >>> n) | (X << (32 - n)); }
  function R(X, n) { return (X >>> n); }
  function Ch(x, y, z) { return ((x & y) ^ ((~x) & z)); }
  function Maj(x, y, z) { return ((x & y) ^ (x & z) ^ (y & z)); }
  function Sigma0256(x) { return (S(x, 2) ^ S(x, 13) ^ S(x, 22)); }
  function Sigma1256(x) { return (S(x, 6) ^ S(x, 11) ^ S(x, 25)); }
  function Gamma0256(x) { return (S(x, 7) ^ S(x, 18) ^ R(x, 3)); }
  function Gamma1256(x) { return (S(x, 17) ^ S(x, 19) ^ R(x, 10)); }
  function core_sha256(m, l) {
    var K = [
      0x428A2F98,0x71374491,0xB5C0FBCF,0xE9B5DBA5,0x3956C25B,0x59F111F1,0x923F82A4,0xAB1C5ED5,
      0xD807AA98,0x12835B01,0x243185BE,0x550C7DC3,0x72BE5D74,0x80DEB1FE,0x9BDC06A7,0xC19BF174,
      0xE49B69C1,0xEFBE4786,0x0FC19DC6,0x240CA1CC,0x2DE92C6F,0x4A7484AA,0x5CB0A9DC,0x76F988DA,
      0x983E5152,0xA831C66D,0xB00327C8,0xBF597FC7,0xC6E00BF3,0xD5A79147,0x06CA6351,0x14292967,
      0x27B70A85,0x2E1B2138,0x4D2C6DFC,0x53380D13,0x650A7354,0x766A0ABB,0x81C2C92E,0x92722C85,
      0xA2BFE8A1,0xA81A664B,0xC24B8B70,0xC76C51A3,0xD192E819,0xD6990624,0xF40E3585,0x106AA070,
      0x19A4C116,0x1E376C08,0x2748774C,0x34B0BC5E,0x391C0CB3,0x4ED8AA4A,0x5B9CCA4F,0x682E6FF3,
      0x748F82EE,0x78A5636F,0x84C87814,0x8CC70208,0x90BEFFFA,0xA4506CEB,0xBEF9A3F7,0xC67178F2
    ];
    var HASH = [0x6A09E667,0xBB67AE85,0x3C6EF372,0xA54FF53A,0x510E527F,0x9B05688C,0x1F83D9AB,0x5BE0CD19];
    var W = new Array(64);
    var a, b, c, d, e, f, g, h, i, j;
    var T1, T2;
    m[l >> 5] |= 0x80 << (24 - l % 32);
    m[((l + 64 >> 9) << 4) + 15] = l;
    for (i = 0; i < m.length; i += 16) {
      a = HASH[0]; b = HASH[1]; c = HASH[2]; d = HASH[3];
      e = HASH[4]; f = HASH[5]; g = HASH[6]; h = HASH[7];
      for (j = 0; j < 64; j++) {
        if (j < 16) W[j] = m[j + i];
        else W[j] = safe_add(safe_add(safe_add(Gamma1256(W[j - 2]), W[j - 7]), Gamma0256(W[j - 15])), W[j - 16]);
        T1 = safe_add(safe_add(safe_add(safe_add(h, Sigma1256(e)), Ch(e, f, g)), K[j]), W[j]);
        T2 = safe_add(Sigma0256(a), Maj(a, b, c));
        h = g; g = f; f = e; e = safe_add(d, T1);
        d = c; c = b; b = a; a = safe_add(T1, T2);
      }
      HASH[0] = safe_add(a, HASH[0]); HASH[1] = safe_add(b, HASH[1]);
      HASH[2] = safe_add(c, HASH[2]); HASH[3] = safe_add(d, HASH[3]);
      HASH[4] = safe_add(e, HASH[4]); HASH[5] = safe_add(f, HASH[5]);
      HASH[6] = safe_add(g, HASH[6]); HASH[7] = safe_add(h, HASH[7]);
    }
    return HASH;
  }
  function str2binb(str) {
    var bin = [];
    var mask = (1 << chrsz) - 1;
    for (var i = 0; i < str.length * chrsz; i += chrsz) {
      bin[i >> 5] |= (str.charCodeAt(i / chrsz) & mask) << (24 - i % 32);
    }
    return bin;
  }
  function binb2hex(binarray) {
    var hex = "0123456789abcdef";
    var out = "";
    for (var i = 0; i < binarray.length * 4; i++) {
      out += hex.charAt((binarray[i >> 2] >> ((3 - i % 4) * 8 + 4)) & 0xF) +
        hex.charAt((binarray[i >> 2] >> ((3 - i % 4) * 8)) & 0xF);
    }
    return out;
  }
  return binb2hex(core_sha256(str2binb(s), s.length * chrsz));
}

function pbNormalizeEmail(email) {
  return String(email || "").replace(/^\s+|\s+$/g, "").toLowerCase();
}

function pbLoadUsersDb() {
  ensurePurpleBoostDataDir();
  var empty = { users: [] };
  try {
    var raw = pbReadTextFileUtf8(pbUsersPath());
    if (!raw) return empty;
    var obj = JSON.parse(raw);
    if (!obj || !obj.users || !(obj.users instanceof Array)) return empty;
    return obj;
  } catch (eRead) {
    return null;
  }
}

function pbSaveUsersDb(db) {
  ensurePurpleBoostDataDir();
  pbWriteTextFileUtf8(pbUsersPath(), JSON.stringify(db));
}

function pbFindUser(db, emailNorm) {
  if (!db || !db.users) return null;
  var i;
  for (i = 0; i < db.users.length; i++) {
    if (pbNormalizeEmail(db.users[i].email) === emailNorm) return db.users[i];
  }
  return null;
}

function pbHtmlClassAdd(cls) {
  try {
    var el = document.documentElement;
    if (el.classList && el.classList.add) el.classList.add(cls);
    else {
      var cur = " " + (el.className || "") + " ";
      if (cur.indexOf(" " + cls + " ") < 0) el.className = (el.className ? el.className + " " : "") + cls;
    }
  } catch (eA) {}
}

function pbHtmlClassRemove(cls) {
  try {
    var el = document.documentElement;
    if (el.classList && el.classList.remove) el.classList.remove(cls);
    else {
      el.className = (" " + (el.className || "") + " ")
        .replace(new RegExp("\\s*" + cls + "\\s*", "g"), " ").replace(/^\s+|\s+$/g, "");
    }
  } catch (eR) {}
}

function pbSetHtmlClass(cls, enabled) {
  if (enabled) pbHtmlClassAdd(cls);
  else pbHtmlClassRemove(cls);
}

function pbApplyFullscreenOverlay(el) {
  if (!el) return;
  el.style.position = "fixed";
  el.style.top = "0";
  el.style.left = "0";
  el.style.right = "0";
  el.style.bottom = "0";
  el.style.width = "100%";
  el.style.height = "100%";
  el.style.minWidth = "100%";
  el.style.minHeight = "100%";
  el.style.margin = "0";
  el.style.padding = "0";
  el.style.border = "0";
  el.style.zIndex = "2147483000";
  el.style.background = "#000";
  el.style.overflow = "hidden";
  el.style.boxSizing = "border-box";
}

function pbLockBodyOverlay(on) {
  try {
    if (on) document.body.className = (document.body.className || "") + " pb-overlay-lock";
    else document.body.className = (document.body.className || "").replace(/\bpb-overlay-lock\b/g, "").replace(/^\s+|\s+$/g, "");
  } catch (eB) {}
}

function pbInitAuthLogos() {
  try {
    var dir = getUnrealHtaDirectory();
    if (!dir) return;
    var abs = dir + "\\assets\\images\\unreal-logo.png";
    if (!getFso().FileExists(abs)) return;
    var url = unrealFileUrlFromAbs(abs);
    var img = $("pbAuthLogoImg");
    if (img) img.src = url;
  } catch (eLogo) {}
}

function pbInitLoadingBrandLogo() {
  var img = $("pbLoadingLogoImg");
  var svg = $("pbLoadingLogoSvg");
  try {
    if (svg) svg.style.display = "block";
    if (img) img.style.display = "none";
  } catch (eShow) {}
  try {
    var dir = getUnrealHtaDirectory();
    if (!dir) return;
    var abs = dir + "\\assets\\images\\unreal-logo.png";
    if (!getFso().FileExists(abs)) return;
    var url = unrealFileUrlFromAbs(abs);
    if (img) {
      img.src = url;
      img.style.display = "block";
      if (svg) svg.style.display = "none";
    }
  } catch (eLogo) {}
}

function pbForceLayoutReflow() {
  try {
    var shell = document.querySelector(".app-shell");
    if (shell && shell.offsetHeight) { /* reflow */ }
    if (document.body && document.body.offsetHeight) { /* reflow */ }
  } catch (eRf) {}
}

function pbWaitAnimationFrames(count, cb) {
  var left = count || 2;
  function tick() {
    left--;
    if (left <= 0) {
      try { if (typeof cb === "function") cb(); } catch (eCb) {}
      return;
    }
    if (window.requestAnimationFrame) window.requestAnimationFrame(tick);
    else window.setTimeout(tick, 16);
  }
  if (window.requestAnimationFrame) window.requestAnimationFrame(tick);
  else window.setTimeout(tick, 16);
}

function pbWarmAllPagesDom() {
  var pageIds = ["home", "peripheral", "drivers", "conn", "game", "opt", "sound", "account", "settings"];
  var i;
  for (i = 0; i < pageIds.length; i++) {
    try {
      var el = document.getElementById("page-" + pageIds[i]);
      if (el && el.offsetHeight) { /* layout */ }
    } catch (ePg) {}
  }
}

function pbTouchSidebarNav() {
  try {
    var nav = document.getElementsByClassName("navbtn");
    var i;
    for (i = 0; i < nav.length; i++) {
      if (nav[i] && nav[i].getAttribute) nav[i].getAttribute("data-page");
    }
    var sidebar = document.querySelector(".sidebar");
    if (sidebar && sidebar.offsetHeight) { /* layout */ }
  } catch (eNav) {}
}

function pbSetAuthMessage(text, kind) {
  var el = $("pbAuthMessage");
  if (!el) return;
  el.innerText = text || "";
  el.className = "pb-auth-msg" + (kind === "ok" ? " ok" : "");
}

function pbShowAuthView(viewName) {
  var views = ["welcome", "login", "register"];
  var i;
  for (i = 0; i < views.length; i++) {
    var v = $("pbAuthView-" + views[i]);
    if (v) v.className = "pb-auth-view" + (views[i] === viewName ? " active" : "");
  }
  pbSetAuthMessage("");
}

function pbShowAuthGate(viewName) {
  pbHtmlClassRemove("pb-main-unlocked");
  pbHtmlClassRemove("pb-loading-active");
  pbHtmlClassRemove("pb-app-preparing");
  pbHtmlClassAdd("pb-auth-active");
  pbHtmlClassAdd("pb-startup-hold");
  pbShowAuthView(viewName || "welcome");
  pbLockBodyOverlay(true);
  try { pbInitAuthLogos(); } catch (eL) {}
  if (pbIsLauncherMode()) {
    try { pbLauncherWriteState("auth", "Connexion…"); } catch (eLa) {}
    var gateLm = $("pbAuthGate");
    if (gateLm) {
      pbApplyFullscreenOverlay(gateLm);
      gateLm.style.display = "block";
      gateLm.style.visibility = "visible";
    }
    return;
  }
  var gate = $("pbAuthGate");
  var load = $("pbLoadingScreen");
  if (load) {
    load.style.display = "none";
    load.style.visibility = "hidden";
  }
  if (gate) {
    pbApplyFullscreenOverlay(gate);
    gate.style.display = "block";
    gate.style.visibility = "visible";
  }
  unrealLaunchBootstrapShowOverlayAfterPaint();
}

function pbHideAuthGate() {
  pbHtmlClassRemove("pb-auth-active");
  var gate = $("pbAuthGate");
  if (gate) {
    gate.style.display = "none";
    gate.style.visibility = "hidden";
  }
}

function pbShowLoadingScreen() {
  if (!pbHasValidSession()) {
    pbShowAuthGate("welcome");
    return;
  }
  pbHideAuthGate();
  pbHtmlClassRemove("pb-main-unlocked");
  pbHtmlClassRemove("pb-auth-active");
  pbHtmlClassAdd("pb-loading-active");
  pbHtmlClassAdd("pb-app-preparing");
  pbHtmlClassAdd("pb-startup-hold");
  pbLockBodyOverlay(true);
  if (pbIsLauncherMode()) {
    try { pbLauncherWriteState("loading", "Chargement…"); } catch (eLl) {}
    try { UnrealLaunch.markPreloading(); } catch (eMp) {}
    return;
  }
  try { pbInitLoadingBrandLogo(); } catch (eLb) {}
  var load = $("pbLoadingScreen");
  if (load) {
    pbApplyFullscreenOverlay(load);
    load.style.display = "block";
    load.style.visibility = "visible";
    load.style.background = "#000";
  }
  unrealLaunchBootstrapShowOverlayAfterPaint();
}

function pbHideLoadingScreen() {
  pbHtmlClassRemove("pb-loading-active");
  var load = $("pbLoadingScreen");
  if (load) {
    load.style.display = "none";
    load.style.visibility = "hidden";
  }
}

function pbDismissBootScreen() {
  try {
    var boot = document.getElementById("unrealBootScreen");
    if (boot) boot.style.display = "none";
  } catch (eBoot) {}
}

function sessionPath() { return getPurpleBoostDataDir() + "\\session.json"; }

function readSession() {
  try {
    ensurePurpleBoostDataDir();
    var f = getFso();
    var p = sessionPath();
    if (!f.FileExists(p)) return null;
    var j = pbReadTextFileUtf8(p);
    if (!j || !String(j).replace(/\s/g, "").length) return null;
    var sess = JSON.parse(j);
    if (!sess || typeof sess !== "object") return null;
    return sess;
  } catch (eRead) {
    try { if (getFso().FileExists(sessionPath())) getFso().DeleteFile(sessionPath()); } catch (eDel) {}
    return null;
  }
}

function pbSessionIsValid(sess) {
  if (!sess || !sess.email) return false;
  if (sess.expiresAt) {
    try {
      if (new Date(sess.expiresAt).getTime() < Date.now()) return false;
    } catch (eExp) {}
  }
  return true;
}

function pbHasValidSession() {
  var sess = readSession();
  if (!pbSessionIsValid(sess)) return false;
  if (!sess.token || String(sess.token).length < 4) return false;
  return true;
}

function writeSession(o) {
  ensurePurpleBoostDataDir();
  pbWriteTextFileUtf8(sessionPath(), JSON.stringify(o || {}));
}

function pbCreateLocalSession(email) {
  var em = pbNormalizeEmail(email);
  writeSession({
    email: em,
    token: "pb_" + Date.now() + "_" + Math.floor(Math.random() * 1000000),
    createdAt: nowIsoLocal(),
    subscriptionActive: false
  });
}

function pbRegisterAccount() {
  var em = pbNormalizeEmail($("pbAuthRegEmail").value);
  var pw = String($("pbAuthRegPassword").value || "");
  var pw2 = String($("pbAuthRegConfirm").value || "");
  if (!em || em.indexOf("@") < 1) {
    pbSetAuthMessage("Veuillez saisir une adresse e-mail valide.");
    return;
  }
  if (pw.length < 6) {
    pbSetAuthMessage("Le mot de passe doit contenir au moins 6 caractères.");
    return;
  }
  if (pw !== pw2) {
    pbSetAuthMessage("Les mots de passe ne correspondent pas.");
    return;
  }
  var db = pbLoadUsersDb();
  if (db === null) {
    pbSetAuthMessage("Impossible de lire les comptes. Réessayez.");
    return;
  }
  if (pbFindUser(db, em)) {
    pbSetAuthMessage("Un compte existe déjà avec cette adresse e-mail.");
    return;
  }
  db.users.push({
    email: em,
    passwordHash: pbSha256Hex(pw),
    createdAt: nowIsoLocal()
  });
  try {
    pbSaveUsersDb(db);
  } catch (eSave) {
    pbSetAuthMessage("Impossible d'enregistrer le compte. Réessayez.");
    return;
  }
  pbCreateLocalSession(em);
  pbStartLoadingAndPreload();
}

function pbLoginAccount() {
  var em = pbNormalizeEmail($("pbAuthLoginEmail").value);
  var pw = String($("pbAuthLoginPassword").value || "");
  if (!em || em.indexOf("@") < 1) {
    pbSetAuthMessage("Veuillez saisir une adresse e-mail valide.");
    return;
  }
  if (!pw) {
    pbSetAuthMessage("Veuillez saisir votre mot de passe.");
    return;
  }
  var db = pbLoadUsersDb();
  if (db === null) {
    pbSetAuthMessage("Impossible de lire les comptes. Réessayez.");
    return;
  }
  var user = pbFindUser(db, em);
  if (!user || user.passwordHash !== pbSha256Hex(pw)) {
    pbSetAuthMessage("E-mail ou mot de passe incorrect.");
    return;
  }
  pbCreateLocalSession(em);
  pbStartLoadingAndPreload();
}

/** Déconnexion — à brancher plus tard sur un bouton UI (Réglages / Compte). */
function purpleBoostLogout() {
  clearSession();
  _pbPreloadFinished = true;
  _pbPreloadPipelineDone = false;
  _pbAnimationFramesDone = false;
  if (_pbPreloadTimeoutId) {
    try { window.clearTimeout(_pbPreloadTimeoutId); } catch (eClr) {}
    _pbPreloadTimeoutId = null;
  }
  try { refreshAccountUi(); } catch (eAcc) {}
  pbHtmlClassRemove("pb-main-unlocked");
  pbHtmlClassRemove("unreal-ready");
  pbHtmlClassRemove("pb-loading-active");
  pbHtmlClassRemove("pb-app-preparing");
  pbDismissBootScreen();
  pbShowAuthGate("welcome");
}

var _pbPreloadStartedAt = 0;
var _pbPreloadFinished = false;
var _pbPreloadTimeoutId = null;
var _pbPreloadPipelineDone = false;
var _pbAnimationFramesDone = false;
var PB_PRELOAD_MAX_MS = 10000;
var PB_PRELOAD_MIN_MS = 3000;
var   _pbBoot = {
  assets: false,
  sidebar: false,
  navigation: false,
  dashboard: false,
  sensors: false,
  polling: false,
  devices: false,
  ui: false,
  app: false
};

function pbRunPreloadStep(stepFn) {
  try { if (typeof stepFn === "function") stepFn(); } catch (eStep) {}
}

function pbBootLog(msg) {
  var ms = Date.now() - (_pbPreloadStartedAt || Date.now());
  var line = "[BOOT] " + msg + " (+" + ms + "ms)";
  try { appendFileLogLine("[" + nowTime() + "] " + line); } catch (e0) {}
  try { log(line); } catch (e1) {}
  if (pbIsLauncherMode()) {
    try { pbLauncherWriteState("loading", String(msg || "Chargement…")); } catch (eLs) {}
  }
}

function pbBootMarkReady(key) {
  if (_pbBoot[key]) return;
  _pbBoot[key] = true;
  if (key === "sidebar") pbBootLog("sidebar ready");
  else if (key === "navigation") pbBootLog("navigation ready");
  else if (key === "dashboard") pbBootLog("home ready");
  else if (key === "sensors") pbBootLog("stats ready");
  else if (key === "polling") pbBootLog("polling ready");
  else if (key === "devices") pbBootLog("devices preload ready");
  else if (key === "ui") pbBootLog("ui ready");
  else if (key === "app") pbBootLog("app ready");
}

function pbBootAllStagesReady() {
  return _pbBoot.assets && _pbBoot.sidebar && _pbBoot.navigation &&
    _pbBoot.dashboard && _pbBoot.sensors && _pbBoot.polling && _pbBoot.devices &&
    _pbBoot.ui && _pbBoot.app;
}

function pbBootResetFlags() {
  _pbBoot.assets = false;
  _pbBoot.sidebar = false;
  _pbBoot.navigation = false;
  _pbBoot.dashboard = false;
  _pbBoot.sensors = false;
  _pbBoot.polling = false;
  _pbBoot.devices = false;
  _pbBoot.ui = false;
  _pbBoot.app = false;
}

function pbIsMainAppReady() {
  try {
    if (!pbBootAllStagesReady() || !_pbBoot.app) return false;
    var shell = document.querySelector(".app-shell");
    var sidebar = document.querySelector(".sidebar");
    var home = document.getElementById("page-home");
    var nav = document.getElementsByClassName("navbtn");
    if (!shell || !sidebar || !home) return false;
    if (shell.offsetWidth < 200 || shell.offsetHeight < 200) return false;
    if (!nav || nav.length < 8) return false;
    if (currentPageName !== "home") return false;
    if (!home.className || home.className.indexOf("active") < 0) return false;
    var i;
    for (i = 0; i < nav.length; i++) {
      if (!nav[i]) return false;
      if (!nav[i].onclick && !nav[i].getAttribute("onclick")) return false;
    }
    if (!pbIsHomeHardwareDashboardReady()) return false;
    if (!pbIsHomeStatsCardsReady()) return false;
    if (homeStatsIntervalId === null) return false;
    return true;
  } catch (eReady) {
    return false;
  }
}

function pbTryMarkAppReady() {
  if (_pbBoot.app) return true;
  if (!_pbBoot.assets || !_pbBoot.sidebar || !_pbBoot.navigation || !_pbBoot.ui ||
      !_pbBoot.dashboard || !_pbBoot.sensors || !_pbBoot.polling || !_pbBoot.devices) {
    return false;
  }
  var shell = document.querySelector(".app-shell");
  if (!shell || shell.offsetWidth < 200) return false;
  pbBootMarkReady("app");
  return true;
}

/** Relance les stats Accueil une fois le DOM visible (après loading). */
function pbRestartHomeStatsAfterLaunch() {
  try { stopHomeStatsBackgroundCollect(); } catch (e0) {}
  try {
    if (homeStatsPollIntervalId !== null) {
      window.clearInterval(homeStatsPollIntervalId);
      homeStatsPollIntervalId = null;
    }
  } catch (e1) {}
  homeStatsWorkerBusy = false;
  try {
    if (homeStatsIntervalId !== null) {
      window.clearInterval(homeStatsIntervalId);
      homeStatsIntervalId = null;
    }
  } catch (e2) {}
  if (currentPageName !== "home") {
    try { showPage("home"); } catch (ePg) { currentPageName = "home"; }
  }
  try { applyHomeStatsCacheToUi(); } catch (eUi) {}
  try { ensureHomeStatsTimer(); } catch (eTm) {}
  try { refreshHomeStats(); } catch (eRf) {}
}

function pbPreloadJsonStatesOnly() {
  try { loadOptimizationStateFromDisk(); } catch (eOpt) {}
}

function pbPreloadBrandAndAssets() {
  try { initBrandLogoImages(); } catch (e1) {}
  try { pbInitLoadingBrandLogo(); } catch (e2) {}
  try { pbInitAuthLogos(); } catch (e3) {}
}

function pbPrimeNavigationAndListeners() {
  pbTouchSidebarNav();
  try {
    var nav = document.getElementsByClassName("navbtn");
    var i;
    for (i = 0; i < nav.length; i++) {
      if (nav[i] && nav[i].getAttribute) nav[i].getAttribute("data-page");
      if (nav[i] && !nav[i].onclick && !nav[i].getAttribute("onclick")) return false;
    }
  } catch (eNav) {}
  return true;
}

function pbVerifySidebarReady() {
  try {
    var sidebar = document.querySelector(".sidebar");
    if (sidebar && sidebar.offsetWidth > 40) {
      pbBootMarkReady("sidebar");
      return;
    }
  } catch (eSb) {}
  pbBootMarkReady("sidebar");
}

function pbIsHomeHardwareDashboardReady() {
  var subCpu = $("homeCpuSub");
  var subGpu = $("homeGpuSub");
  var subRam = $("homeRamSub");
  if (subCpu && String(subCpu.innerText || "").replace(/\s/g, "").length > 2) return true;
  if (subGpu && String(subGpu.innerText || "").replace(/\s/g, "").length > 2) return true;
  if (subRam && String(subRam.innerText || "").replace(/\s/g, "").length > 2) return true;
  var card = document.querySelector(".home-stat-card");
  return !!(card && card.offsetHeight > 8);
}

function pbIsHomeStatsCardsReady() {
  var elCpu = $("homeCpuPct");
  var elGpu = $("homeGpuPct");
  var elRam = $("homeRamPct");
  if (!elCpu || !elGpu || !elRam) return false;
  function hasPct(el) {
    var t = String(el.innerText || "").trim();
    return t.indexOf("%") >= 0 && t !== "-- %";
  }
  return hasPct(elCpu) || hasPct(elGpu) || hasPct(elRam);
}

function pbIsHomeDashboardReady() {
  return pbIsHomeHardwareDashboardReady() && pbIsHomeStatsCardsReady();
}

function pbPreloadAssetsAsync(doneCb) {
  pbPreloadBrandAndAssets();
  var finished = false;
  function finish() {
    if (finished) return;
    finished = true;
    _pbBoot.assets = true;
    try { if (typeof doneCb === "function") doneCb(); } catch (eDone) {}
  }
  var wait = 0;
  function hookImg(img) {
    if (!img || !img.src) return;
    wait++;
    var done = false;
    function imgDone() {
      if (done) return;
      done = true;
      wait--;
      if (wait <= 0) finish();
    }
    if (img.complete && img.naturalWidth > 0) imgDone();
    else {
      img.onload = imgDone;
      img.onerror = imgDone;
    }
  }
  hookImg($("brandLogoPngNav"));
  hookImg($("brandLogoPngHero"));
  hookImg($("pbLoadingLogoImg"));
  if (wait === 0) finish();
  window.setTimeout(finish, 2800);
}

function pbPreloadDashboardAsync(doneCb) {
  var dashStart = Date.now();
  try { showPage("home"); } catch (ePg) { currentPageName = "home"; }
  try { ensureHomeDateTimeTimer(); } catch (eDt) {}
  try { initHomeHardwareStaticOnce(); } catch (eHw) {}
  try { applyHomeStatsCacheToUi(); } catch (eUi0) {}
  function pollDash() {
    pbForceLayoutReflow();
    var hwOk = pbIsHomeHardwareDashboardReady();
    var dashElapsed = Date.now() - dashStart;
    if (hwOk || dashElapsed >= 5500) {
      pbBootMarkReady("dashboard");
      pbPreloadSensorsAsync(doneCb);
      return;
    }
    if (Date.now() - _pbPreloadStartedAt >= PB_PRELOAD_MAX_MS - 1200) {
      pbBootMarkReady("dashboard");
      pbPreloadSensorsAsync(doneCb);
      return;
    }
    window.setTimeout(pollDash, 120);
  }
  pollDash();
}

function pbPreloadSensorsAsync(doneCb) {
  var sensorStart = Date.now();
  try { applyHomeStatsCacheToUi(); } catch (eUi) {}
  try { scheduleHomeStatsBackgroundCollect(); } catch (eSt) {}
  function pollSensors() {
    pbForceLayoutReflow();
    try { applyHomeStatsCacheToUi(); } catch (eUi2) {}
    var statsOk = pbIsHomeStatsCardsReady();
    var elapsed = Date.now() - sensorStart;
    if (statsOk || elapsed >= 7500) {
      pbBootMarkReady("sensors");
      pbPreloadDevicesAsync(doneCb);
      return;
    }
    if (Date.now() - _pbPreloadStartedAt >= PB_PRELOAD_MAX_MS - 600) {
      pbBootMarkReady("sensors");
      pbPreloadDevicesAsync(doneCb);
      return;
    }
    window.setTimeout(pollSensors, 150);
  }
  pollSensors();
}

function pbPreloadPollingAsync(doneCb) {
  try {
    if (homeStatsIntervalId === null) {
      homeStatsIntervalId = window.setInterval(function () {
        if (currentPageName === "home") scheduleHomeStatsBackgroundCollect();
      }, HOME_STATS_MS);
    }
    if (!homeStatsWorkerBusy && currentPageName === "home") {
      try { scheduleHomeStatsBackgroundCollect(); } catch (eSt2) {}
    }
  } catch (ePoll) {}
  var pollStart = Date.now();
  function tick() {
    pbForceLayoutReflow();
    try { applyHomeStatsCacheToUi(); } catch (eUi) {}
    var intervalOk = homeStatsIntervalId !== null;
    var collectStarted = homeStatsWorkerBusy || homeStatsPollIntervalId !== null;
    var elapsed = Date.now() - pollStart;
    if ((intervalOk && collectStarted) || elapsed >= 2500) {
      pbBootMarkReady("polling");
      pbPreloadDevicesAsync(doneCb);
      return;
    }
    if (Date.now() - _pbPreloadStartedAt >= PB_PRELOAD_MAX_MS - 350) {
      pbBootMarkReady("polling");
      pbPreloadDevicesAsync(doneCb);
      return;
    }
    window.setTimeout(tick, 120);
  }
  tick();
}

var PB_DEVICES_PRELOAD_MAX_MS = 5000;

/** Prépare onglet Périphériques : cache + détection légère (pas de boost / HIDUSBF). */
function initControllerOverclockerUiPreload() {
  try { updateControllerOverclockerHidusbfBadge(); } catch (eBadge) {}
  var sel = $("controllerOverclockerSelect");
  if (sel) sel.onchange = onControllerOverclockerSelectChange;
  controllerOverclockerState.statusPending = false;
  if (controllerOverclockerState.cards && controllerOverclockerState.cards.length) {
    controllerOverclockerState.statusLoaded = true;
  } else {
    try { setControllerOverclockerPendingUi(); } catch (ePen) {}
  }
  try { updateControllerApplyUi(); } catch (eApp) {}
}

function pbPreloadDevicesAsync(doneCb) {
  pbBootLog("devices preload start");
  var devStart = Date.now();
  try { initControllerOverclockerUiPreload(); } catch (eUi) {}
  try { loadControllerOverclockerFromCacheOnly(); } catch (eCache) {}
  function finishDevices() {
    if (_pbBoot.devices) {
      try { if (typeof doneCb === "function") doneCb(); } catch (eDone) {}
      return;
    }
    pbBootMarkReady("devices");
    try { if (typeof doneCb === "function") doneCb(); } catch (eDone2) {}
  }
  function pollDevices() {
    if (!_pbBoot.devices && !controllerOverclockerState.scanning) {
      finishDevices();
      return;
    }
    if (Date.now() - devStart >= PB_DEVICES_PRELOAD_MAX_MS) {
      finishDevices();
      return;
    }
    window.setTimeout(pollDevices, 120);
  }
  window.setTimeout(function () {
    try { runControllerDetect("boot-preload"); } catch (eDet) {}
    pollDevices();
  }, 80);
}

function pbCanCompleteLaunch() {
  var elapsed = Date.now() - _pbPreloadStartedAt;
  if (elapsed < PB_PRELOAD_MIN_MS) return false;
  if (!_pbPreloadPipelineDone || !_pbAnimationFramesDone) return false;
  pbTryMarkAppReady();
  if (!_pbBoot.app) return false;
  return pbIsMainAppReady();
}

function pbRunPreloadPipelineAsync(doneCb) {
  pbBootLog("bootstrap start");
  pbBootResetFlags();

  function finishPipeline() {
    pbForceLayoutReflow();
    pbWaitAnimationFrames(2, function () {
      pbForceLayoutReflow();
      pbTryMarkAppReady();
      _pbAnimationFramesDone = true;
      _pbPreloadPipelineDone = true;
      try { if (typeof doneCb === "function") doneCb(); } catch (eDone) {}
    });
  }

  function stepUi() {
    pbRunPreloadStep(function () { try { initNvExtraUiVersion(); } catch (eNv) {} });
    pbWarmAllPagesDom();
    pbRunPreloadStep(function () { try { initSettingsUi(); } catch (eSet) {} });
    pbRunPreloadStep(function () { try { refreshAccountUi(); } catch (eAcc) {} });
    pbRunPreloadStep(function () { try { initOptimizationTab(); } catch (eOpt) {} });
    pbForceLayoutReflow();
    pbBootMarkReady("ui");
    pbPreloadDashboardAsync(finishPipeline);
  }

  function stepNav() {
    if (!pbPrimeNavigationAndListeners()) {
      window.setTimeout(stepNav, 80);
      return;
    }
    pbBootMarkReady("navigation");
    window.setTimeout(stepUi, 40);
  }

  function stepSidebar() {
    pbVerifySidebarReady();
    window.setTimeout(stepNav, 40);
  }

  function stepAssets() {
    pbPreloadAssetsAsync(stepSidebar);
  }

  function stepJson() {
    pbRunPreloadStep(function () { ensurePurpleBoostDataDir(); createUnrealFolders(); });
    pbRunPreloadStep(function () { try { initApplicationBaseDirectory(); } catch (eBase) {} });
    pbPreloadJsonStatesOnly();
    window.setTimeout(stepAssets, 30);
  }

  stepJson();
}

function pbCompleteLaunch(fromTimeout) {
  if (_pbPreloadFinished) return;
  _pbPreloadFinished = true;
  if (_pbPreloadTimeoutId) {
    try { window.clearTimeout(_pbPreloadTimeoutId); } catch (eClr) {}
    _pbPreloadTimeoutId = null;
  }
  pbFinishLaunch(!!fromTimeout);
}

function pbForcePreloadStagesForTimeout() {
  if (!_pbBoot.assets) _pbBoot.assets = true;
  if (!_pbBoot.sidebar) pbBootMarkReady("sidebar");
  if (!_pbBoot.navigation) pbBootMarkReady("navigation");
  if (!_pbBoot.ui) pbBootMarkReady("ui");
  if (!_pbBoot.dashboard) pbBootMarkReady("dashboard");
  if (!_pbBoot.sensors) pbBootMarkReady("sensors");
  if (!_pbBoot.polling) pbBootMarkReady("polling");
  if (!_pbBoot.devices) pbBootMarkReady("devices");
  _pbPreloadPipelineDone = true;
  _pbAnimationFramesDone = true;
  pbTryMarkAppReady();
  if (!_pbBoot.app) pbBootMarkReady("app");
}

function pbPollPreloadReady() {
  if (_pbPreloadFinished) return;
  if (pbCanCompleteLaunch()) {
    pbCompleteLaunch(false);
    return;
  }
  if (Date.now() - _pbPreloadStartedAt >= PB_PRELOAD_MAX_MS) {
    pbForcePreloadStagesForTimeout();
    pbCompleteLaunch(true);
    return;
  }
  window.setTimeout(pbPollPreloadReady, 80);
}

function pbStartLoadingAndPreload() {
  if (!pbHasValidSession()) {
    pbShowAuthGate("welcome");
    return;
  }
  _pbFinishLaunchUiDone = false;
  try { UnrealLaunch.resetForPreloadCycle(); } catch (eLc) {}
  _pbPreloadFinished = false;
  _pbPreloadPipelineDone = false;
  _pbAnimationFramesDone = false;
  pbBootResetFlags();
  _pbPreloadStartedAt = Date.now();
  pbShowLoadingScreen();
  try { UnrealLaunch.markPreloading(); } catch (ePh) {}
  window.setTimeout(function () {
    pbRunPreloadPipelineAsync(function () {});
    pbPollPreloadReady();
  }, 50);
  _pbPreloadTimeoutId = window.setTimeout(function () {
    pbForcePreloadStagesForTimeout();
    pbCompleteLaunch(true);
  }, PB_PRELOAD_MAX_MS);
}

function pbFinishLaunch(fromTimeout) {
  if (!fromTimeout && (!_pbBoot.app || !pbBootAllStagesReady())) {
    pbPollPreloadReady();
    return;
  }
  if (!_pbBoot.app) pbTryMarkAppReady();
  if (!_pbBoot.app && fromTimeout) pbBootMarkReady("app");
  if (!_pbBoot.app) {
    pbPollPreloadReady();
    return;
  }
  if (_pbFinishLaunchUiDone) return;
  _pbFinishLaunchUiDone = true;

  var loadMs = Date.now() - _pbPreloadStartedAt;

  UnrealLaunch.revealApplication(function () {
    try { log("PurpleBoost démarré" + (fromTimeout ? " (délai max.)" : "") + " après " + loadMs + "ms."); } catch (eLog) {}
  });

  window.setTimeout(function () {
    try { RunAutomationHealthCheck(); } catch (eHealth) {}
  }, 12000);

  window.onfocus = function () {
    try { onControllerOverclockerWindowFocus(); } catch (eCoFocus) {}
  };
}

function pbBeginApplicationLaunch() {
  pbDismissBootScreen();
  try { ensurePurpleBoostDataDir(); } catch (eDir) {}
  try { pbLauncherWriteState("boot", "Démarrage…"); } catch (eLb0) {}
  pbHtmlClassRemove("pb-main-unlocked");
  pbHtmlClassRemove("unreal-ready");
  if (!pbHasValidSession()) {
    pbShowAuthGate("welcome");
    return;
  }
  pbStartLoadingAndPreload();
}
function clearSession() {
  try { if (getFso().FileExists(sessionPath())) getFso().DeleteFile(sessionPath()); } catch (e) {}
}
function refreshAccountUi() {
  var s = readSession();
  if (!s || !s.email) { $("subStatus").innerText = "Inactif"; $("sessEmail").innerText = "Non connecté"; return; }
  $("sessEmail").innerText = s.email;
  $("subStatus").innerText = s.subscriptionActive ? "Actif" : "Inactif";
}
function loginMock() {
  var em = $("inEmail").value.replace(/^\s+|\s+$/g, "");
  var pw = $("inPassword").value;
  if (!em || !pw) { alert("Champs requis."); return; }
  writeSession({ email: em, token: "mock_" + Date.now(), subscriptionActive: em.indexOf("+sub") >= 0 });
  refreshAccountUi();
  log("Connexion mock (API/Stripe plus tard).");
}
function registerMock() {
  var em = $("inEmail").value.replace(/^\s+|\s+$/g, "");
  var pw = $("inPassword").value;
  if (!em || pw.length < 4) { alert("Mot de passe trop court."); return; }
  writeSession({ email: em, token: "mock_" + Date.now(), subscriptionActive: false });
  refreshAccountUi();
  log("Compte mock créé.");
}
function logoutMock() { clearSession(); refreshAccountUi(); log("Déconnexion."); }

function exportLogsUi() {
  try {
    createUnrealFolders();
    var p = UNREAL_LOGS + "\\unreal-export-" + Date.now() + ".txt";
    var w = getFso().CreateTextFile(p, true);
    w.Write($("logBox").innerText || "");
    w.Close();
    log("Logs exportés : " + p);
    alert(p);
  } catch (e) { alert(e.message); }
}
function openUnrealFolder() {
  try { createUnrealFolders(); getShell().Run("explorer.exe \"" + UNREAL_BASE + "\"", 1, false); log("Dossier Unreal ouvert."); } catch (e) { alert(e.message); }
}

function initSettingsUi() {
  $("setTheme").innerText = "UNREAL   Smoke / Néon violet";
  $("setLang").innerText = "Français";
  $("setLogsDir").innerText = UNREAL_LOGS;
  $("setVersion").innerText = APP_VERSION;
  var pbVer = $("pbUpdateLocalVersion");
  if (pbVer) pbVer.innerText = appUpdateFormatDisplayVersion(APP_VERSION);
  var pbLatest = $("pbUpdateLatestVersion");
  if (pbLatest) pbLatest.innerText = "—";
  pbUpdateSetActionsVisible(false);
}

function appUpdateLog(phase) {
  var line = "[UPDATE] " + String(phase || "");
  try { log(line); } catch (eLog) {}
  try { appendFileLogLine("[" + nowTime() + "] " + line); } catch (eFile) {}
}

function pbSetUpdateStatus(text, kind) {
  var el = $("pbUpdateStatus");
  var cls = "pb-update-status muted";
  if (kind === "ok") cls = "pb-update-status ok";
  else if (kind === "err") cls = "pb-update-status err";
  else if (kind === "info") cls = "pb-update-status info";
  if (el) {
    el.innerText = text || "";
    el.className = cls;
  }
}

function pbUpdateSetActionsVisible(show) {
  var box = $("pbUpdateActions");
  if (!box) return;
  box.className = show ? "pb-update-actions visible" : "pb-update-actions";
}

function pbUpdateSetLatestVersionLabel(versionStr) {
  var el = $("pbUpdateLatestVersion");
  if (!el) return;
  if (!versionStr) {
    el.innerText = "—";
    return;
  }
  el.innerText = appUpdateFormatDisplayVersion(versionStr);
}

function appUpdateEnsureDir() {
  try {
    createUnrealFolders();
    var fso = getFso();
    if (!fso.FolderExists(APP_UPDATE_DIR)) fso.CreateFolder(APP_UPDATE_DIR);
  } catch (eDir) {}
  return APP_UPDATE_DIR;
}

function appUpdateNormalizeVersion(versionStr) {
  var s = String(versionStr || "").replace(/^\s+|\s+$/g, "").replace(/^v/i, "");
  var parts = s.split(/[-+]/)[0].split(".");
  var out = [0, 0, 0];
  var i;
  for (i = 0; i < 3; i++) {
    out[i] = parseInt(parts[i], 10);
    if (isNaN(out[i])) out[i] = 0;
  }
  return out;
}

/** Retourne 1 si a > b, -1 si a < b, 0 si égal. */
function appUpdateCompareVersions(a, b) {
  var pa = appUpdateNormalizeVersion(a);
  var pb = appUpdateNormalizeVersion(b);
  var i;
  for (i = 0; i < 3; i++) {
    if (pa[i] > pb[i]) return 1;
    if (pa[i] < pb[i]) return -1;
  }
  return 0;
}

function appUpdateFormatDisplayVersion(versionStr) {
  var v = String(versionStr || "").replace(/^\s+|\s+$/g, "");
  if (!v) return "?";
  if (v.charAt(0) === "v" || v.charAt(0) === "V") return v;
  return "v" + v;
}

function appUpdateHttpGetText(url) {
  var xhr = new ActiveXObject("MSXML2.XMLHTTP");
  xhr.open("GET", url, false);
  try {
    xhr.setRequestHeader("User-Agent", "Unreal-Gaming-Optimizer/" + APP_VERSION);
    xhr.setRequestHeader("Accept", "application/vnd.github+json");
  } catch (eHdr) {}
  xhr.send();
  if (xhr.status !== 200) {
    throw new Error("HTTP " + xhr.status + " — impossible de joindre GitHub Releases.");
  }
  return xhr.responseText || "";
}

/** Choisit l'asset .exe de la release GitHub (browser_download_url). */
function appUpdatePickExeAsset(assets) {
  var empty = { url: "", name: "" };
  if (!assets || !assets.length) return empty;
  var i;
  for (i = 0; i < assets.length; i++) {
    var a = assets[i];
    if (!a) continue;
    var name = String(a.name || "");
    var url = String(a.browser_download_url || "");
    if (url && /\.exe$/i.test(name)) {
      return { url: url, name: name };
    }
  }
  return empty;
}

function appUpdateParseGithubLatestRelease(jsonText) {
  var tag = "";
  var htmlUrl = "";
  var publishedAt = "";
  var downloadUrl = "";
  var assetName = "";
  try {
    var obj = JSON.parse(jsonText);
    if (obj) {
      tag = String(obj.tag_name || "");
      htmlUrl = String(obj.html_url || "");
      publishedAt = String(obj.published_at || "");
      var picked = appUpdatePickExeAsset(obj.assets);
      downloadUrl = picked.url;
      assetName = picked.name;
    }
  } catch (eJson) {
    var mTag = jsonText.match(/"tag_name"\s*:\s*"([^"]+)"/i);
    var mUrl = jsonText.match(/"html_url"\s*:\s*"(https:\/\/github\.com\/[^"]+)"/i);
    var mDl = jsonText.match(/"browser_download_url"\s*:\s*"(https:\/\/[^"]+\.exe)"/i);
    var mName = jsonText.match(/"name"\s*:\s*"([^"]+\.exe)"/i);
    if (mTag) tag = mTag[1];
    if (mUrl) htmlUrl = mUrl[1];
    if (mDl) downloadUrl = mDl[1];
    if (mName) assetName = mName[1];
  }
  if (!tag) throw new Error("Réponse GitHub invalide (tag_name manquant).");
  if (!downloadUrl) throw new Error("Aucun fichier .exe trouvé dans la dernière release GitHub.");
  return {
    tag: tag,
    version: tag.replace(/^v/i, ""),
    htmlUrl: htmlUrl,
    downloadUrl: downloadUrl,
    assetName: assetName || "PurpleBoost-update.exe",
    publishedAt: publishedAt
  };
}

function appUpdateFetchGithubLatestRelease() {
  var body = appUpdateHttpGetText(APP_UPDATE_GITHUB_API_LATEST);
  return appUpdateParseGithubLatestRelease(body);
}

function appUpdateDownloadGithubRelease(release) {
  if (!release || !release.downloadUrl) {
    throw new Error("URL de téléchargement manquante.");
  }
  appUpdateEnsureDir();
  var safeVer = String(release.version || "latest").replace(/[^\w.\-]/g, "_");
  var fileName = release.assetName || ("PurpleBoost-" + safeVer + ".exe");
  fileName = fileName.replace(/[\\\/:*?"<>|]/g, "_");
  var dest = APP_UPDATE_DIR + "\\" + fileName;
  appUpdateLog("download started");
  pbSetUpdateStatus("Téléchargement en cours… (cela peut prendre plusieurs minutes)", "info");
  downloadBinaryWithBrowserUa(release.downloadUrl, dest);
  var fso = getFso();
  if (!fso.FileExists(dest)) throw new Error("Le fichier téléchargé est introuvable.");
  _appUpdateDownloadPath = dest;
  return dest;
}

function appUpdateResolveLauncherTarget() {
  var fso = getFso();
  var app = getApplicationBaseDirectory() || getAppFolderFromHta() || "";
  var exeNames = ["Unreal Gaming Optimizer.exe", "Unreal.Gaming.Optimizer.exe"];
  var dirs = [];
  var i;
  var j;
  if (app) {
    dirs.push(app + "\\dist");
    dirs.push(app);
    try {
      var parent = fso.GetParentFolderName(app);
      if (parent) {
        dirs.push(parent + "\\dist");
        dirs.push(parent);
      }
    } catch (ePar) {}
  }
  for (i = 0; i < dirs.length; i++) {
    for (j = 0; j < exeNames.length; j++) {
      var p = dirs[i] + "\\" + exeNames[j];
      try {
        if (fso.FileExists(p)) {
          return { exePath: p, appRoot: app || fso.GetParentFolderName(p) };
        }
      } catch (eHit) {}
    }
  }
  return { exePath: "", appRoot: app };
}

function appUpdateWriteApplyScript(scriptPath, downloadedExe, targetExe, appRoot) {
  var ps = ""
    + "$ErrorActionPreference = 'Stop'\r\n"
    + "$src = '" + String(downloadedExe).replace(/'/g, "''") + "'\r\n"
    + "$dst = '" + String(targetExe).replace(/'/g, "''") + "'\r\n"
    + "$app = '" + String(appRoot || "").replace(/'/g, "''") + "'\r\n"
    + "Start-Sleep -Seconds 2\r\n"
    + "if (-not (Test-Path -LiteralPath $src)) { exit 2 }\r\n"
    + "$dstDir = Split-Path -Parent $dst\r\n"
    + "if ($dstDir -and -not (Test-Path -LiteralPath $dstDir)) { New-Item -ItemType Directory -Path $dstDir -Force | Out-Null }\r\n"
    + "Copy-Item -LiteralPath $src -Destination $dst -Force\r\n"
    + "$args = @()\r\n"
    + "if ($app) { $args += @('--base-dir', $app) }\r\n"
    + "Start-Process -FilePath $dst -ArgumentList $args -WorkingDirectory (Split-Path -Parent $dst)\r\n"
    + "exit 0\r\n";
  writeUtf8TextFileAll(scriptPath, ps);
}

function appUpdateInstallAndRestart() {
  if (_appUpdateInstallInProgress) return;
  var release = _appUpdatePending;
  if (!release) throw new Error("Aucune mise à jour en attente. Vérifiez d'abord les mises à jour.");
  if (!_appUpdateDownloadPath || !getFso().FileExists(_appUpdateDownloadPath)) {
    throw new Error("Téléchargez la mise à jour avant d'installer.");
  }
  var target = appUpdateResolveLauncherTarget();
  if (!target.exePath) {
    throw new Error("Impossible de localiser le lanceur PurpleBoost sur ce PC.");
  }
  _appUpdateInstallInProgress = true;
  appUpdateLog("install started");
  pbSetUpdateStatus("Installation en cours… PurpleBoost va redémarrer.", "info");
  var scriptPath = APP_UPDATE_DIR + "\\apply-purpleboost-update.ps1";
  appUpdateWriteApplyScript(scriptPath, _appUpdateDownloadPath, target.exePath, target.appRoot || getApplicationBaseDirectory());
  var sh = getShell();
  var cmd = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + scriptPath + '"';
  sh.Run(cmd, 0, false);
  window.setTimeout(function () {
    try { window.close(); } catch (eClose) {}
  }, 400);
}

/**
 * Vérifie GitHub Releases/latest.
 * Retourne { status: "uptodate"|"available", message, release }
 */
function appUpdateCheckGithubLatest() {
  appUpdateLog("checking");
  var release = appUpdateFetchGithubLatestRelease();
  appUpdateLog("latest release found");
  _appUpdateLastCheck = { at: new Date().getTime(), release: release };
  pbUpdateSetLatestVersionLabel(release.version);
  var cmp = appUpdateCompareVersions(release.version, APP_VERSION);
  if (cmp > 0) {
    _appUpdatePending = release;
    _appUpdateDownloadPath = "";
    return {
      status: "available",
      message: "Une nouvelle version est disponible",
      release: release
    };
  }
  _appUpdatePending = null;
  _appUpdateDownloadPath = "";
  pbUpdateSetActionsVisible(false);
  return {
    status: "uptodate",
    message: "PurpleBoost est à jour",
    release: release
  };
}

function pbCheckForUpdates() {
  var btn = $("pbBtnCheckUpdate");
  var btnDl = $("pbBtnUpdateDownload");
  var btnIns = $("pbBtnUpdateInstall");
  if (btn) try { btn.disabled = true; } catch (eDis) {}
  if (btnDl) try { btnDl.disabled = true; } catch (eDl) {}
  if (btnIns) try { btnIns.disabled = true; } catch (eIns) {}
  pbUpdateSetActionsVisible(false);
  pbSetUpdateStatus("Vérification sur GitHub…", "info");
  window.setTimeout(function () {
    try {
      var result = appUpdateCheckGithubLatest();
      if (result.status === "uptodate") {
        pbSetUpdateStatus(result.message, "ok");
      } else if (result.status === "available") {
        pbSetUpdateStatus(result.message, "ok");
        pbUpdateSetActionsVisible(true);
      } else {
        pbSetUpdateStatus(result.message || "Vérification terminée.", "info");
      }
    } catch (eUpd) {
      _appUpdatePending = null;
      _appUpdateDownloadPath = "";
      pbUpdateSetActionsVisible(false);
      pbSetUpdateStatus("Échec : " + (eUpd.message || eUpd), "err");
    }
    if (btn) try { btn.disabled = false; } catch (eEn) {}
    if (btnDl) try { btnDl.disabled = false; } catch (eDl2) {}
    if (btnIns) try { btnIns.disabled = false; } catch (eIns2) {}
  }, 10);
}

function pbUpdateDownload() {
  if (_appUpdateDownloadInProgress) return;
  var release = _appUpdatePending;
  if (!release) {
    pbSetUpdateStatus("Vérifiez d'abord les mises à jour.", "err");
    return;
  }
  var btnDl = $("pbBtnUpdateDownload");
  var btnIns = $("pbBtnUpdateInstall");
  _appUpdateDownloadInProgress = true;
  if (btnDl) try { btnDl.disabled = true; } catch (eD) {}
  if (btnIns) try { btnIns.disabled = true; } catch (eI) {}
  window.setTimeout(function () {
    try {
      var path = appUpdateDownloadGithubRelease(release);
      pbSetUpdateStatus("Téléchargement terminé : " + path, "ok");
    } catch (eDl) {
      _appUpdateDownloadPath = "";
      pbSetUpdateStatus("Échec du téléchargement : " + (eDl.message || eDl), "err");
    }
    _appUpdateDownloadInProgress = false;
    if (btnDl) try { btnDl.disabled = false; } catch (eD2) {}
    if (btnIns) try { btnIns.disabled = false; } catch (eI2) {}
  }, 10);
}

function pbUpdateInstallNow() {
  if (_appUpdateInstallInProgress) return;
  var btnIns = $("pbBtnUpdateInstall");
  var btnDl = $("pbBtnUpdateDownload");
  if (btnIns) try { btnIns.disabled = true; } catch (eI) {}
  if (btnDl) try { btnDl.disabled = true; } catch (eD) {}
  window.setTimeout(function () {
    try {
      if (!_appUpdateDownloadPath || !getFso().FileExists(_appUpdateDownloadPath)) {
        var release = _appUpdatePending;
        if (!release) throw new Error("Aucune mise à jour disponible.");
        pbSetUpdateStatus("Téléchargement automatique avant installation…", "info");
        appUpdateDownloadGithubRelease(release);
      }
      appUpdateInstallAndRestart();
    } catch (eIns) {
      _appUpdateInstallInProgress = false;
      pbSetUpdateStatus("Échec de l'installation : " + (eIns.message || eIns), "err");
      if (btnIns) try { btnIns.disabled = false; } catch (eI2) {}
      if (btnDl) try { btnDl.disabled = false; } catch (eD2) {}
    }
  }, 10);
}

/** Alias legacy. */
function pbCheckForUpdatesPlaceholder() {
  pbCheckForUpdates();
}

function ensureAppRunsAsAdminOnStartup() {
  try {
    window.__UNREAL_NEEDS_ELEVATION = false;
    if (isRunningAsAdmin()) window.__UNREAL_IS_ELEVATED = true;
    else window.__UNREAL_IS_ELEVATED = false;
    return true;
  } catch (e) {
    return true;
  }
}

/* ========== Diagnostic non-régression (tous modules) ========== */
var _automationHealthLogPath = "";

function getAutomationHealthLogPath() {
  if (_automationHealthLogPath) return _automationHealthLogPath;
  var app = getAppFolderFromHta();
  _automationHealthLogPath = app ? combinePath(app, "logs\\automation-health.log") : combinePath(UNREAL_LOGS, "automation-health.log");
  return _automationHealthLogPath;
}

function appendAutomationHealthLog(line) {
  var path = getAutomationHealthLogPath();
  try {
    var fso = getFso();
    var dir = fso.GetParentFolderName(path);
    if (dir && !fso.FolderExists(dir)) fso.CreateFolder(dir);
    var stream = fso.OpenTextFile(path, 8, true);
    stream.WriteLine(String(line || ""));
    stream.Close();
  } catch (eW) {
    try { log("[automation-health] " + line); } catch (e2) {}
  }
}

function automationHealthFnOk(fnName) {
  try {
    return typeof window[fnName] === "function";
  } catch (e) {
    return false;
  }
}

function automationHealthFileOk(path) {
  return !!(path && fileExists(path));
}

function RunAutomationHealthCheck() {
  createUnrealFolders();
  var ts = new Date().toISOString();
  appendAutomationHealthLog("=== HEALTHCHECK " + ts + " ===");

  var dduFns = ["downloadOrOpenDdu", "downloadOrOpenDduRun", "openDduOfficialPage", "dduAutoCleanExperimental", "launchDduAutoCleanAutomation", "runDduStatusCheckImpl"];
  var dduOk = true;
  var d;
  for (d = 0; d < dduFns.length; d++) {
    if (!automationHealthFnOk(dduFns[d])) { dduOk = false; appendAutomationHealthLog("DDU: fonction manquante " + dduFns[d]); }
  }
  appendAutomationHealthLog("DDU module: " + (dduOk ? "OK" : "erreur"));
  try { writeDduOpenDownloadLog("HEALTHCHECK DDU=" + (dduOk ? "OK" : "erreur")); } catch (eDduLog) {}

  var nvcFns = ["openNvcleanstall", "openNvcleanstallWithPresetGuidance", "openNvcleanstallOfficialDownloadPage", "launchNvcleaninstallAutoExperimental", "launchNvcleaninstallAutoRunImpl", "prepareNvcleanstallPreset", "locateNvcleanstallExecutable"];
  var nvcOk = true;
  for (d = 0; d < nvcFns.length; d++) {
    if (!automationHealthFnOk(nvcFns[d])) { nvcOk = false; appendAutomationHealthLog("NVCleanInstall: fonction manquante " + nvcFns[d]); }
  }
  var nvcExe = "";
  try { nvcExe = locateNvcleanstallExecutable(false) || ""; } catch (eNvc) { nvcExe = ""; }
  appendAutomationHealthLog("NVCleanInstall module: " + (nvcOk ? "OK" : "erreur") + (nvcExe ? " (exe détecté)" : " (exe non détecté  téléchargement toujours possible)"));
  try { appendNvMediaLog("HEALTHCHECK NVCleanInstall=" + (nvcOk ? "OK" : "erreur")); } catch (eNvMedia) {}

  var nipFns = ["ApplyNipProfile", "importNvidiaProfileNipElevated", "resolveNvGamingInspectorPath", "resolveNvGamingNipPath"];
  var nipOk = true;
  for (d = 0; d < nipFns.length; d++) {
    if (!automationHealthFnOk(nipFns[d])) { nipOk = false; appendAutomationHealthLog("Nvidia NIP: fonction manquante " + nipFns[d]); }
  }
  var inspector = "";
  var nipPath = "";
  try { inspector = resolveNvGamingInspectorPath() || ""; } catch (eInsp) {}
  try { nipPath = resolveNvGamingNipPath() || ""; } catch (eNip) {}
  var nipFilesOk = automationHealthFileOk(inspector) && automationHealthFileOk(nipPath);
  appendAutomationHealthLog("Nvidia Profile Inspector / NIP: " + (nipOk && nipFilesOk ? "OK" : (nipOk ? "OK (fichiers optionnels absents)" : "erreur")));
  try { appendNvidiaProfileLogLine("HEALTHCHECK NIP=" + (nipOk ? "OK" : "erreur") + " inspector=" + (inspector ? "oui" : "non") + " nip=" + (nipPath ? "oui" : "non")); } catch (eNipLog) {}
  var nipSilentStable = automationHealthFnOk("ApplyNipProfile") && automationHealthFnOk("runNvidiaAutomationV2ApplyNipOnly");
  try {
    var v2NipExe = getNvidiaAutomationV2ExePath() || "";
    nipSilentStable = nipSilentStable && automationHealthFileOk(v2NipExe);
  } catch (eV2n) {}
  if (nipSilentStable) {
    appendAutomationHealthLog("NPI silent import validated");
    try { appendNvidiaProfileLogLine("NPI silent import validated"); } catch (eNpiVal) {}
    try { appendNvGamingLogLine("NPI silent import validated"); } catch (eNvVal) {}
  }

  var dispFns = ["ApplyMaxResolution", "ApplyMaxRefreshRate", "runNvGamingDisplayApply", "getNvidiaDisplayHelperPath"];
  var dispOk = true;
  for (d = 0; d < dispFns.length; d++) {
    if (!automationHealthFnOk(dispFns[d])) { dispOk = false; appendAutomationHealthLog("Display: fonction manquante " + dispFns[d]); }
  }
  var helperPath = "";
  try { helperPath = getNvidiaDisplayHelperPath() || ""; } catch (eH) {}
  appendAutomationHealthLog("Résolution max: " + (dispOk ? "OK" : "erreur") + " (helper " + (helperPath ? "présent" : "absent, repli PS1") + ")");
  appendAutomationHealthLog("Fréquence max: " + (dispOk ? "OK" : "erreur"));
  try { appendNvGamingLogLine("HEALTHCHECK resolution=" + (dispOk ? "OK" : "erreur") + " refresh=" + (dispOk ? "OK" : "erreur")); } catch (eDispLog) {}

  var v2Exe = "";
  try { v2Exe = getNvidiaAutomationV2ExePath() || ""; } catch (eV2) {}
  var v2Fns = ["runNvidiaAutomationV2", "applyNvidiaGamingOptimizationFromUi", "applyNvidiaGamingOptimizationImpl"];
  var v2Ok = automationHealthFileOk(v2Exe);
  for (d = 0; d < v2Fns.length; d++) {
    if (!automationHealthFnOk(v2Fns[d])) { v2Ok = false; appendAutomationHealthLog("Nvidia V2: fonction manquante " + v2Fns[d]); }
  }
  appendAutomationHealthLog("Nvidia module (Automation V2): " + (v2Ok ? "OK" : "erreur"));

  var legacyRemoved = !automationHealthFnOk("applyNvidiaFullProfileImpl") && !automationHealthFnOk("applyNvidiaPreviewPerformanceMode");
  appendAutomationHealthLog("Legacy panneau raté absent: " + (legacyRemoved ? "OK" : "erreur (ancienne auto encore présente)"));

  var preserved = dduOk && nvcOk && nipOk && dispOk && legacyRemoved;
  appendAutomationHealthLog("DDU module detected: " + (dduOk ? "yes" : "no"));
  appendAutomationHealthLog("NVCleanInstall module detected: " + (nvcOk ? "yes" : "no"));
  appendAutomationHealthLog("Nvidia module detected: " + (v2Ok && nipOk ? "yes" : "no"));
  appendAutomationHealthLog("Existing automation preserved: " + (preserved ? "yes" : "no"));
  appendAutomationHealthLog("=== END HEALTHCHECK ===");
  return { ok: preserved, ddu: dduOk, nvcleanstall: nvcOk, nip: nipOk, display: dispOk, nvidiaV2: v2Ok, preserved: preserved };
}

var _pbFinishLaunchUiDone = false;

function unrealWindowLogLine(text) {
  var line = "[WINDOW] " + String(text || "");
  try { log(line); } catch (eL) {
    try { appendFileLogLine("[" + nowTime() + "] " + line); } catch (e2) {}
  }
}

function unrealWindowLogSizes(phase) {
  var m = unrealGetViewportMetrics();
  unrealWindowLogLine(String(phase || "size")
    + " outer=" + m.outerW + "x" + m.outerH
    + " inner=" + m.innerW + "x" + m.innerH
    + " client=" + m.clientW + "x" + m.clientH);
  unrealWindowLogLine("body size " + m.bodyW + "x" + m.bodyH);
  unrealWindowLogLine("app-shell size " + m.shellW + "x" + m.shellH);
}

/** Legacy — alias pixel lock (orchestrateur = source de vérité document). */
function unrealApplyWhiteBorderGuard() {
  try { unrealApplyViewportPixelLock(); } catch (ePx) {}
}

/** Après boot : verrou pixel uniquement (pas de re-settle). */
function unrealPrepareHostWindowGeometry() {
  if (UnrealLaunch.hostReady) {
    try { unrealApplyViewportPixelLock(); } catch (ePx) {}
    return;
  }
  UnrealLaunch.settleHostOnce(function () {});
}

function pbRevealMainApplicationUi() {
  pbHtmlClassRemove("pb-loading-active");
  pbHtmlClassRemove("pb-auth-active");
  pbHtmlClassRemove("pb-app-preparing");
  pbHtmlClassRemove("pb-startup-hold");
  pbHtmlClassAdd("pb-main-unlocked");
  pbLockBodyOverlay(false);
  pbHideLoadingScreen();
  pbHideAuthGate();
  try { pbHtmlClassAdd("unreal-ready"); } catch (eRd) {}
  pbForceLayoutReflow();
  if (!pbIsLauncherMode()) {
    try { unrealApplyViewportPixelLock(); } catch (eLock) {}
    unrealWindowLogSizes("after resize size");
    unrealWindowLogLine("white border guard applied");
  } else {
    try { unrealApplyViewportPixelLock(); } catch (eLockLm) {}
    unrealWindowLogLine("reveal dom (handoff natif)");
  }
}

function unrealGetViewportMetrics() {
  var m = { outerW: 0, outerH: 0, innerW: 0, innerH: 0, clientW: 0, clientH: 0, bodyW: 0, bodyH: 0, shellW: 0, shellH: 0, scrollW: 0, scrollH: 0, availW: 0, availH: 0 };
  try {
    m.outerW = window.outerWidth || 0;
    m.outerH = window.outerHeight || 0;
    m.innerW = window.innerWidth || 0;
    m.innerH = window.innerHeight || 0;
    m.clientW = document.documentElement.clientWidth || 0;
    m.clientH = document.documentElement.clientHeight || 0;
    m.bodyW = document.body.clientWidth || 0;
    m.bodyH = document.body.clientHeight || 0;
    m.scrollW = document.documentElement.scrollWidth || 0;
    m.scrollH = document.documentElement.scrollHeight || 0;
    m.availW = screen.availWidth || 0;
    m.availH = screen.availHeight || 0;
    var shell = document.querySelector(".app-shell");
    if (shell) {
      m.shellW = shell.offsetWidth || 0;
      m.shellH = shell.offsetHeight || 0;
    }
  } catch (eM) {}
  return m;
}

function unrealLogViewportAudit(tag) {
  var m = unrealGetViewportMetrics();
  var gapR = m.clientW - m.shellW;
  var gapB = m.clientH - m.shellH;
  var line = "[WINDOW] " + tag
    + " outer=" + m.outerW + "x" + m.outerH
    + " inner=" + m.innerW + "x" + m.innerH
    + " client=" + m.clientW + "x" + m.clientH
    + " body=" + m.bodyW + "x" + m.bodyH
    + " shell=" + m.shellW + "x" + m.shellH
    + " scroll=" + m.scrollW + "x" + m.scrollH
    + " avail=" + m.availW + "x" + m.availH
    + " gapR=" + gapR + " gapB=" + gapB;
  try { log(line); } catch (eL) {
    try { appendFileLogLine("[" + nowTime() + "] " + line); } catch (e2) {}
  }
}

/** Verrouille html/body/shell sur la zone cliente réelle (px) — corrige le fond blanc IE hors document. */
function unrealApplyViewportPixelLock() {
  var w = 0;
  var h = 0;
  try {
    w = document.documentElement.clientWidth || window.innerWidth || 0;
    h = document.documentElement.clientHeight || window.innerHeight || 0;
  } catch (e0) {}
  if (w < 2 || h < 2) {
    var fb = pbGetLauncherWindowSize();
    if (w < 2) w = fb.w;
    if (h < 2) h = fb.h;
  }
  var px = "px";
  try {
    document.documentElement.style.width = w + px;
    document.documentElement.style.height = h + px;
    document.documentElement.style.maxWidth = w + px;
    document.documentElement.style.maxHeight = h + px;
    document.documentElement.style.overflow = "hidden";
    document.documentElement.style.backgroundColor = "#0a0a0f";
    document.body.style.width = w + px;
    document.body.style.height = h + px;
    document.body.style.maxWidth = w + px;
    document.body.style.maxHeight = h + px;
    document.body.style.overflow = "hidden";
    document.body.style.margin = "0";
    document.body.style.padding = "0";
    document.body.style.backgroundColor = "#0a0a0f";
    try { document.body.bgColor = "#0a0a0f"; } catch (eBg) {}
    try { document.bgColor = "#0a0a0f"; } catch (eBg2) {}
    var shell = document.querySelector(".app-shell");
    if (shell) {
      shell.style.width = w + px;
      shell.style.height = h + px;
      shell.style.maxWidth = w + px;
      shell.style.maxHeight = h + px;
      shell.style.overflow = "hidden";
    }
    var load = document.getElementById("pbLoadingScreen");
    if (load) {
      load.style.width = w + px;
      load.style.height = h + px;
    }
    var auth = document.getElementById("pbAuthGate");
    if (auth) {
      auth.style.width = w + px;
      auth.style.height = h + px;
    }
  } catch (eSt) {}
  return { w: w, h: h };
}

function unrealFitWindowToMonitor() {
  if (!UnrealLaunch.hostReady) {
    UnrealLaunch.settleHostOnce(function () {});
    return unrealApplyViewportPixelLock();
  }
  return unrealApplyViewportPixelLock();
}

function unrealScheduleViewportSync() {
  UnrealLaunch.onResizeDebounced();
}

/**
 * Supprime le chrome natif Windows (barre blanche, cadre) sur la fenêtre mshta courante.
 * Complète HTA:APPLICATION BORDER=none CAPTION=no (souvent ignoré partiellement sous Win10/11).
 */
function forceBorderlessHtaNativeChrome() {
  if (pbIsLauncherMode()) return;
  try { pbApplyNormalWindowSize(); } catch (eSzOnly) {}
  return;
  try {
    var sh = new ActiveXObject("WScript.Shell");
    try { document.title = UNREAL_WINDOW_TITLE; } catch (eT) {}
    var titles = [UNREAL_WINDOW_TITLE, "Unreal", "Unreal Gaming Optimizer"];
    var titleList = "";
    var ti;
    for (ti = 0; ti < titles.length; ti++) {
      if (titleList) titleList += ",";
      titleList += "'" + String(titles[ti]).replace(/'/g, "''") + "'";
    }
    var szWin = pbGetLauncherWindowSize();
    var aw = szWin.w;
    var ah = szWin.h;
    var ax = szWin.x;
    var ay = szWin.y;
    var ps = "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& { "
      + "$titles=@(" + titleList + "); "
      + "Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;using System.Text;public struct UnrealWinRect { public int Left, Top, Right, Bottom; } public class UnrealHtaWin { "
      + "[DllImport(\\\"user32.dll\\\")] public static extern System.IntPtr FindWindow(string c,string t); "
      + "[DllImport(\\\"user32.dll\\\")] public static extern int GetWindowLong(System.IntPtr h,int n); "
      + "[DllImport(\\\"user32.dll\\\")] public static extern int SetWindowLong(System.IntPtr h,int n,int v); "
      + "[DllImport(\\\"user32.dll\\\")] public static extern bool SetWindowPos(System.IntPtr h,System.IntPtr i,int x,int y,int cx,int cy,uint f); "
      + "[DllImport(\\\"user32.dll\\\")] public static extern bool GetWindowRect(System.IntPtr h,out UnrealWinRect r); "
      + "[DllImport(\\\"user32.dll\\\")] public static extern bool GetClientRect(System.IntPtr h,out UnrealWinRect r); "
      + "[DllImport(\\\"user32.dll\\\")] public static extern bool EnumWindows(UnrealHtaWin.EnumProc lp, System.IntPtr p); "
      + "public delegate bool EnumProc(System.IntPtr h, System.IntPtr p); "
      + "[DllImport(\\\"user32.dll\\\")] public static extern int GetWindowText(System.IntPtr h,StringBuilder s,int c); "
      + "}'; "
      + "function Set-Borderless([IntPtr]$hwnd) { "
      + "if ($hwnd -eq [IntPtr]::Zero) { return }; "
      + "$s=[UnrealHtaWin]::GetWindowLong($hwnd,-16); "
      + "$strip=0x00C00000 -bor 0x00080000 -bor 0x00040000 -bor 0x00020000 -bor 0x00010000 -bor 0x00000080; "
      + "$s=$s -band (-1 -bxor $strip); "
      + "[void][UnrealHtaWin]::SetWindowLong($hwnd,-16,$s); "
      + "$ex=[UnrealHtaWin]::GetWindowLong($hwnd,-20); "
      + "$ex=$ex -band (-1 -bxor 0x00000100) -band (-1 -bxor 0x00000200); "
      + "[void][UnrealHtaWin]::SetWindowLong($hwnd,-20,$ex); "
      + "$wr=New-Object UnrealWinRect; $cr=New-Object UnrealWinRect; "
      + "[void][UnrealHtaWin]::GetWindowRect($hwnd,[ref]$wr); "
      + "[void][UnrealHtaWin]::GetClientRect($hwnd,[ref]$cr); "
      + "$frameW=($wr.Right-$wr.Left)-($cr.Right-$cr.Left); "
      + "$frameH=($wr.Bottom-$wr.Top)-($cr.Bottom-$cr.Top); "
      + "if ($frameW -lt 0) { $frameW=0 }; if ($frameH -lt 0) { $frameH=0 }; "
      + "$ow=" + aw + "+$frameW; $oh=" + ah + "+$frameH; "
      + "[void][UnrealHtaWin]::SetWindowPos($hwnd,[IntPtr]::Zero," + ax + "," + ay + ",$ow,$oh,0x0026) "
      + "}; "
      + "$hwnd=[IntPtr]::Zero; "
      + "foreach ($t in $titles) { "
      + "$hwnd=[UnrealHtaWin]::FindWindow($null,$t); "
      + "if ($hwnd -eq [IntPtr]::Zero) { $hwnd=[UnrealHtaWin]::FindWindow('IEFrame',$t) }; "
      + "if ($hwnd -ne [IntPtr]::Zero) { break } "
      + "}; "
      + "if ($hwnd -eq [IntPtr]::Zero) { "
      + "[UnrealHtaWin]::EnumWindows({ param($h,$l) "
      + "$sb=New-Object System.Text.StringBuilder 512; "
      + "[void][UnrealHtaWin]::GetWindowText($h,$sb,512); "
      + "$txt=$sb.ToString(); "
      + "foreach ($t in $titles) { if ($txt -like ('*'+$t+'*')) { Set-Borderless $h; return $false } }; "
      + "return $true }, [IntPtr]::Zero) | Out-Null "
      + "} else { Set-Borderless $hwnd } "
      + "}\"";
    sh.Run(ps, 0, false);
  } catch (eBorder) {
    try { log("[WINDOW] borderless natif impossible : " + (eBorder.message || eBorder)); } catch (eLog) {}
  }
}

function scheduleBorderlessHtaNativeChrome() {
  if (pbIsLauncherMode()) return;
  if (!UnrealLaunch.hostReady) UnrealLaunch.settleHostOnce(function () {});
}

function unrealTitlebarClose() {
  try {
    if (pbIsLauncherMode()) {
      try { pbLauncherWriteState("exited", ""); } catch (eEx) {}
      try { LaunchSessionStoreClearLocal(); } catch (eLc) {}
    }
    window.close();
  } catch (eClose) {
    log("[WINDOW] close impossible : " + (eClose.message || eClose));
  }
}

function LaunchSessionStoreClearLocal() {
  try {
    ensurePurpleBoostDataDir();
    createUnrealFolders();
    var fso = getFso();
    var p = UNREAL_LOGS + "\\launch-session.json";
    if (fso.FileExists(p)) fso.DeleteFile(p);
    var sh = new ActiveXObject("WScript.Shell");
    var pd = sh.ExpandEnvironmentStrings("%ProgramData%");
    if (pd && pd.indexOf("%") < 0) {
      var lockDir = pd + "\\PurpleBoost";
      if (!fso.FolderExists(lockDir)) return;
      var lockF = lockDir + "\\instance.lock";
      if (fso.FileExists(lockF)) fso.DeleteFile(lockF);
    }
  } catch (eDel) {}
}

function unrealTitlebarMaximize() {
  try {
    if (pbIsLauncherMode()) {
      var sz = pbGetLauncherWindowSize();
      window.resizeTo(sz.w, sz.h);
      window.moveTo(sz.x, sz.y);
      try { unrealApplyViewportPixelLock(); } catch (ePx) {}
      return;
    }
    if (UnrealLaunch.hostReady) unrealApplyViewportPixelLock();
    else UnrealLaunch.settleHostOnce(function () {});
  } catch (eMax) {
    try { log("[WINDOW] maximize : " + (eMax.message || eMax)); } catch (eLog) {}
  }
}

function unrealTitlebarMinimize() {
  try {
    var sh = new ActiveXObject("WScript.Shell");
    var winTitle = UNREAL_WINDOW_TITLE || document.title || "Unreal Gaming Optimizer";
    var safeTitle = String(winTitle).replace(/'/g, "''");
    var ps = "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;public class UnrealWinApi { [DllImport(\\\"user32.dll\\\")] public static extern bool ShowWindow(System.IntPtr h, int n); [DllImport(\\\"user32.dll\\\")] public static extern System.IntPtr FindWindow(string c, string t); }'; $h = [UnrealWinApi]::FindWindow($null, '" + safeTitle + "'); if ($h -ne [IntPtr]::Zero) { [UnrealWinApi]::ShowWindow($h, 6) | Out-Null }\"";
    sh.Run(ps, 0, false);
  } catch (eMin) {
    log("[WINDOW] minimize impossible : " + (eMin.message || eMin));
  }
}

function unrealMarkUiReady() {
  try {
    pbHtmlClassAdd("unreal-ready");
    pbHtmlClassAdd("pb-main-unlocked");
    pbHtmlClassRemove("pb-auth-active");
    pbHtmlClassRemove("pb-loading-active");
    pbHtmlClassRemove("pb-app-preparing");
    var boot = document.getElementById("unrealBootScreen");
    if (boot) boot.style.display = "none";
    var auth = document.getElementById("pbAuthGate");
    var load = document.getElementById("pbLoadingScreen");
    if (auth) { auth.style.display = "none"; auth.style.visibility = "hidden"; }
    if (load) { load.style.display = "none"; load.style.visibility = "hidden"; }
    pbLockBodyOverlay(false);
  } catch (eReady) {}
}

window.onload = function () {
  try { document.title = UNREAL_WINDOW_TITLE; } catch (eT0) {}
  try { UnrealLaunch.beginSession(); } catch (eBoot) {}
  try {
    window.onresize = function () {
      try { UnrealLaunch.onResizeDebounced(); } catch (eR) {}
    };
  } catch (eOnR) {}
  try {
    window.onunload = function () {
      try {
        if (pbIsLauncherMode()) {
          pbLauncherWriteState("exited", "");
          LaunchSessionStoreClearLocal();
        }
      } catch (eUnload) {}
    };
  } catch (eUn) {}
  try { initApplicationBaseDirectory(); } catch (eBase) {}
  if (!ensureAppRunsAsAdminOnStartup()) return;
  pbBeginApplicationLaunch();
};
</script>
</head>
<body>
<script type="text/javascript">try{document.body.bgColor="#0a0a0f";document.bgColor="#0a0a0f";document.documentElement.style.backgroundColor="#0a0a0f";if(typeof pbHtmlClassAdd==="function")pbHtmlClassAdd("pb-startup-hold");}catch(eBodyHide){}</script>
<div id="unrealBootScreen" class="boot-screen" aria-hidden="true">
  <div class="boot-screen__inner">
    <img class="boot-screen__logo" src="assets/images/unreal-logo.png" alt="" onerror="this.style.display='none'" />
    <div class="boot-screen__title">UNREAL</div>
  </div>
</div>

<div class="app-shell">
<header class="unreal-titlebar" id="unrealTitlebar">
  <span class="unreal-titlebar__brand">Unreal</span>
  <div class="unreal-titlebar__actions">
    <button type="button" class="unreal-titlebar__btn unreal-titlebar__btn--min" title="Réduire" aria-label="Réduire" onclick="unrealTitlebarMinimize()">&#8722;</button>
    <button type="button" class="unreal-titlebar__btn unreal-titlebar__btn--max" title="Agrandir" aria-label="Agrandir" onclick="unrealTitlebarMaximize()">&#9633;</button>
    <button type="button" class="unreal-titlebar__btn unreal-titlebar__btn--close" title="Fermer" aria-label="Fermer" onclick="unrealTitlebarClose()">&#10005;</button>
  </div>
</header>
<div class="app-scroll">
<div class="app">
<aside class="sidebar">
  <div class="brand"><div class="logo logo-stack" title="UNREAL"><img id="brandLogoPngNav" class="brand-logo-png" src="assets/images/unreal-logo.png" alt=""/><svg id="brandLogoSvgNav" class="brand-logomark" viewBox="0 0 100 118" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><defs><linearGradient id="ublNav" x1="0" y1="118" x2="100" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#22d3ee"/><stop offset="34%" stop-color="#4338ca"/><stop offset="66%" stop-color="#a855f7"/><stop offset="100%" stop-color="#fb7185"/></linearGradient></defs><path class="ubl-stroke-white" fill="none" stroke="#f8f7ff" stroke-width="13" stroke-linejoin="miter" stroke-miterlimit="6" stroke-linecap="butt" d="M 8 58 L 20 46 L 20 90 L 50 112 L 80 86 L 80 40 L 94 26"/><path class="ubl-stroke-grad" fill="none" stroke="url(#ublNav)" stroke-width="8" stroke-linejoin="miter" stroke-miterlimit="6" stroke-linecap="butt" d="M 8 58 L 20 46 L 20 90 L 50 112 L 80 86 L 80 40 L 94 26"/></svg></div><div><h1>UNREAL</h1><p>Gaming Optimizer</p></div></div>
  <nav class="nav">
    <div class="nav-label">Principal</div>
    <button class="navbtn active" type="button" data-page="home" onclick="showPage('home')">Accueil</button>
    <div class="nav-label">Matériel &amp; réseau</div>
    <button class="navbtn" type="button" data-page="peripheral" onclick="showPage('peripheral')">Périphériques</button>
    <button class="navbtn" type="button" data-page="drivers" onclick="showPage('drivers')">Drivers</button>
    <button class="navbtn" type="button" data-page="conn" onclick="showPage('conn')">Connexion</button>
    <div class="nav-label">Jeu &amp; optimisation</div>
    <button class="navbtn" type="button" data-page="game" onclick="showPage('game')">Jeu</button>
    <button class="navbtn" type="button" data-page="opt" onclick="showPage('opt')">Optimisation</button>
    <button class="navbtn" type="button" data-page="sound" onclick="showPage('sound')">Son</button>
    <div class="nav-label">Compte</div>
