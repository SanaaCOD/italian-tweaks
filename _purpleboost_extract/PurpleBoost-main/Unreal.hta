  }
}

function controllerCoFormatResponseMs(ms) {
  var n = parseFloat(ms);
  if (isNaN(n)) return "\u2014";
  if (n >= 1) return n.toFixed(1) + " ms";
  return n.toFixed(3) + " ms";
}

function controllerCoDefaultResponseMs(rateHz) {
  var r = parseInt(rateHz, 10);
  if (isNaN(r) || r <= 0) return 8;
  if (r >= 8000) return 0.125;
  if (r >= 1000) return 1;
  if (r >= 500) return 2;
  if (r >= 250) return 4;
  return 8;
}

function controllerCoResolveConfirmedRate(st) {
  if (!st) return 0;
  if (st.Status === "Unknown" && (!st.ConfirmedRate || st.ConfirmedRate === 0)) return 0;
  var rate = 0;
  if (st.ConfirmedRate != null) rate = parseInt(st.ConfirmedRate, 10);
  else if (st.ConfiguredRate != null) rate = parseInt(st.ConfiguredRate, 10);
  if (isNaN(rate)) rate = 0;
  if (rate <= 0 && st.Status === "Default") return 125;
  return rate;
}

