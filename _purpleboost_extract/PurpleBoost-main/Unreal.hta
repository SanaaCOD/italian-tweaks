function runHidusbfRegistryProbe(phase, rateHz) {
  var dev = getSelectedControllerDevice();
  if (!dev) {
    alert("S\u00e9lectionnez d'abord une manette dans la liste.");
    return { ok: false, exitCode: -1, result: null };
  }
  initApplicationBaseDirectory();
  var app = getApplicationBaseDirectory() || getUnrealHtaDirectory() || "";
  var scriptsDir = getAppScriptsDir();
  var psPath = scriptsDir ? getAbsolutePathFs(combinePath(scriptsDir, "Devices\\Probe-HidusbfRegistry.ps1")) : "";
  if (!psPath || !getFso().FileExists(psPath)) {
    alert("Script Probe-HidusbfRegistry.ps1 introuvable.");
    return { ok: false, exitCode: -1, result: null };
  }
  var instanceId = String(dev.InstanceId || dev.DeviceId || "");
  var rate = rateHz ? parseInt(rateHz, 10) : 0;
  var cmd =
    'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + psPath + '"' +
    ' -AppRoot "' + escapeControllerPsArg(app) + '"' +
    ' -DeviceInstanceId "' + escapeControllerPsArg(instanceId) + '"' +
    ' -Vid "' + escapeControllerPsArg(dev.Vid || "054C") + '"' +
    ' -Pid "' + escapeControllerPsArg(dev.Pid || "0CE6") + '"' +
    ' -Phase "' + escapeControllerPsArg(phase) + '"' +
    ' -Rate ' + rate;
  var exitCode = -1;
  try {
    exitCode = getShell().Run(cmd, 0, true);
  } catch (eProbe) {
    return { ok: false, exitCode: -1, result: null };
  }
  var result = readHidusbfProbeResult();
  return { ok: exitCode === 0 || exitCode === 2, exitCode: exitCode, result: result };
}

function showHidusbfProbeGuide(rateHz) {
  var guide = $("controllerOverclockerAssistedGuide");
  if (!guide) return;
  var dev = getSelectedControllerDevice();
  var vid = dev && dev.Vid ? dev.Vid : "054C";
  var pid = dev && dev.Pid ? dev.Pid : "0CE6";
  var typeName = dev && dev.Type ? fixUtf8Mojibake(dev.Type) : "DualSense";
  var rateLabel = rateHz ? (rateHz + " Hz") : "1000 ou 8000 Hz";
  controllerOverclockerState.probeActiveRate = rateHz || 0;
  guide.innerHTML =
    "<strong>Probe HIDUSBF \u2014 \u00e9tapes manuelles (" + controllerCoEscapeHtml(rateLabel) + ") :</strong>" +
    "<ol style=\"margin:8px 0 0 18px;padding:0;font-size:12px;line-height:1.55;\">" +
    "<li>Snapshot AVANT termin\u00e9.</li>" +
    "<li>Dans HIDUSBF Setup : s\u00e9lectionne la ligne DualSense VID " +
    controllerCoEscapeHtml(vid) + " / PID " + controllerCoEscapeHtml(pid) + " (" +
    controllerCoEscapeHtml(typeName) + ").</li>" +
    "<li>Coche \u00ab Filter On Device \u00bb.</li>" +
    "<li>Choisis " + controllerCoEscapeHtml(rateLabel) + ".</li>" +
    "<li>Clique \u00ab Install Service \u00bb puis \u00ab Restart \u00bb.</li>" +
    "<li>V\u00e9rifie Filter? = Yes et Rate " + controllerCoEscapeHtml(rateLabel) + ".</li>" +
    "<li>Reviens dans Unreal et clique \u00ab Snapshot APR\u00c8S / Comparer \u00bb.</li>" +
    "</ol>";
  guide.style.display = "";
}

function startHidusbfProbeBefore(rateHz) {
  if (!rateHz) return;
  var run = runHidusbfRegistryProbe("Before", rateHz);
  if (!run || run.exitCode !== 0) {
    var msg = run && run.result && run.result.Message
      ? fixUtf8Mojibake(String(run.result.Message))
      : "Echec snapshot AVANT.";
    setControllerOverclockerStatus(msg, "error");
    return;
  }
  controllerOverclockerState.probeActiveRate = rateHz;
  controllerOverclockerState.probeBeforeCaptured = true;
  writeControllerOverclockerLog("[HIDUSBF-PROBE] Snapshot BEFORE complete rate=" + rateHz);
  setControllerOverclockerStatus(
    "Snapshot AVANT termin\u00e9. Applique maintenant le r\u00e9glage " + rateHz + " Hz dans HIDUSBF Setup.",
    "info"
  );
  showHidusbfProbeGuide(rateHz);
  openHidusbfSetupFromTools(true);
}

function runHidusbfProbeAfterCompare() {
  var rateHz = controllerOverclockerState.probeActiveRate || 0;
  var beforePath = getHidusbfProbeBeforeJsonPath();
  if (!beforePath || !getFso().FileExists(beforePath)) {
    alert("Snapshot AVANT manquant \u2014 lance d'abord Analyser HIDUSBF 1000 Hz ou 8000 Hz.");
    setControllerOverclockerStatus("Snapshot AVANT manquant \u2014 lance d'abord Analyser HIDUSBF.", "warn");
    return;
  }
  setControllerOverclockerStatus("Snapshot APR\u00c8S et comparaison en cours...", "info");
  var run = runHidusbfRegistryProbe("After", rateHz);
  var result = run ? run.result : null;
  var code = result && result.Code ? String(result.Code) : "";

  if (run && run.exitCode === 1 && code === "BEFORE_MISSING") {
    alert("Snapshot AVANT manquant \u2014 lance d'abord Analyser HIDUSBF.");
    setControllerOverclockerStatus("Snapshot AVANT manquant \u2014 lance d'abord Analyser HIDUSBF.", "warn");
    return;
  }

  if (code === "DIFF_OK") {
    var n = result.DifferenceCount || 0;
    writeControllerOverclockerLog("[HIDUSBF-PROBE] Diff OK count=" + n);
    setControllerOverclockerStatus(
      "Diff g\u00e9n\u00e9r\u00e9 : " + n + " changement(s). Voir logs\\hidusbf-registry-diff.log",
      "success"
    );
    alert("Diff g\u00e9n\u00e9r\u00e9 : " + n + " changement(s).\n\nlogs\\hidusbf-registry-diff.log\nlogs\\hidusbf-registry-diff.json");
    hideControllerAssistedGuide();
  } else if (code === "DIFF_EMPTY") {
    writeControllerOverclockerLog("[HIDUSBF-PROBE] Diff empty");
    setControllerOverclockerStatus(
      "Aucune diff\u00e9rence d\u00e9tect\u00e9e. V\u00e9rifie Filter? Yes et Rate 1000/8000 dans HIDUSBF avant le snapshot APR\u00c8S.",
      "warn"
    );
    alert(
      "Aucune diff\u00e9rence d\u00e9tect\u00e9e.\n\n" +
      "V\u00e9rifie que HIDUSBF affiche bien Filter? Yes et Rate 1000/8000 avant de cliquer Snapshot APR\u00c8S / Comparer."
    );
  } else {
    var errMsg = result && result.Message
      ? fixUtf8Mojibake(String(result.Message))
      : "Erreur probe (code " + (run ? run.exitCode : "?") + ")";
    setControllerOverclockerStatus(errMsg, "error");
  }
  try { refreshControllerPollingStatus({ silent: false }); } catch (eSt) {}
}

function startHidusbfRegistryProbeWizard() {
  startHidusbfProbeBefore(1000);
}

function finalizeControllerApplyVerification(action, rateHz, applyResult, exitCode) {
  if (action !== "apply" || !rateHz) return;
  var prepared =
    exitCode === 15 ||
    (applyResult && (applyResult.Code === "PREPARED_NEEDS_MANUAL_CONFIRMATION" || applyResult.Code === "PREPARED_NEEDS_RECONNECT" || applyResult.Code === "APPLIED")) ||
    (exitCode === 0 && applyResult && applyResult.Success);
  if (!prepared) return;

  var waitMs = applyResult && applyResult.NeedsReconnect ? 1500 : 800;
  window.setTimeout(function () {
    var status = refreshControllerPollingStatusSync(true);
    var v = verifyControllerPollingAfterApply(rateHz, status);
    var detectedLog = formatControllerDetectedRateForLog(status);
    writeControllerOverclockerLog(
      "[DEVICE] Verification after apply: requested=" + rateHz +
      " detected=" + detectedLog +
      " verified=" + (v.verified ? "true" : "false")
    );

    if (v.verified && v.detectedRate === rateHz) {
      if (rateHz === 1000) controllerOverclockerState.applied1000Once = true;
      writeControllerOverclockerLog("[DEVICE] Result: applied_verified rate=" + rateHz);
      setControllerOverclockerStatus(
        rateHz === 1000 ? "Optimis\u00e9 1000 Hz confirm\u00e9" : "Optimis\u00e9 8000 Hz confirm\u00e9",
        "success"
      );
      hideControllerAssistedGuide();
      window.setTimeout(function () {
        try { runControllerDetect("after-apply"); } catch (eRef) {}
      }, 1500);
      return;
    }

    if (v.detectedRate >= 1000 && rateHz >= 1000 && v.detectedRate !== rateHz) {
      writeControllerOverclockerLog("[DEVICE] Result: rate_mismatch requested=" + rateHz + " detected=" + v.detectedRate);
      setControllerOverclockerStatus(
        rateHz + " Hz demand\u00e9 \u2014 " + v.detectedRate + " Hz d\u00e9tect\u00e9",
        "warn"
      );
      hideControllerAssistedGuide();
      try { refreshControllerPollingStatus({ silent: true }); } catch (eMis) {}
      return;
    }

    if (detectedLog === "Default" || (status && status.Status === "Default")) {
      writeControllerApplyVerificationResult({
        Success: false,
        Code: "NOT_CONFIRMED_DEFAULT",
        Message: "Le reglage n'est pas confirme : HIDUSBF indique encore Default.",
        NeedsReconnect: !!(applyResult && applyResult.NeedsReconnect),
        Verified: false,
        FallbackAvailable: true,
        Rate: rateHz
      });
      writeControllerOverclockerLog("[DEVICE] Result: not_confirmed_default");
      var autoValidated = isHidusbfAutoMethodValidated();
      setControllerOverclockerStatus("Non confirm\u00e9 / Default d\u00e9tect\u00e9", "warn");
      showControllerAssistedGuide(rateHz);
      return;
    }

      writeControllerApplyVerificationResult({
        Success: true,
        Code: "PREPARED_NEEDS_MANUAL_CONFIRMATION",
        Message: "Reglage prepare, mais HIDUSBF indique encore Default. Action manuelle ou probe necessaire.",
        NeedsReconnect: true,
        Verified: false,
        FallbackAvailable: true,
        Rate: rateHz
      });
    writeControllerOverclockerLog("[DEVICE] Result: prepared_needs_reconnect");
    setControllerOverclockerStatus(
      "Reglage prepare \u2014 reconnecte la manette puis verifie le statut",
      "warn"
    );
    showControllerAssistedGuide(rateHz);
  }, waitMs);
}

function appendControllerAutoCapturedOutput() {
  try {
    var outPath = UNREAL_LOGS + "\\controller-overclocker-last-stdout.txt";
    var errPath = UNREAL_LOGS + "\\controller-overclocker-last-stderr.txt";
    var fso = getFso();
    if (fso.FileExists(outPath)) {
      writeControllerOverclockerLog("[DEVICE-AUTO] --- stdout ---");
      var ts = fso.OpenTextFile(outPath, 1, false);
      while (!ts.AtEndOfStream) {
        var ln = String(ts.ReadLine() || "").replace(/\s+$/, "");
        if (ln) writeControllerOverclockerLog("[DEVICE-AUTO] stdout=" + ln);
      }
      ts.Close();
    }
    if (fso.FileExists(errPath)) {
      writeControllerOverclockerLog("[DEVICE-AUTO] --- stderr ---");
      var te = fso.OpenTextFile(errPath, 1, false);
      while (!te.AtEndOfStream) {
        var le = String(te.ReadLine() || "").replace(/\s+$/, "");
        if (le) writeControllerOverclockerLog("[DEVICE-AUTO] stderr=" + le);
      }
      te.Close();
    }
  } catch (eCap) {}
}

function handleControllerAutoApplyFallback(rateHz, applyResult, exitCode) {
  var code = applyResult && applyResult.Code ? String(applyResult.Code) : ("EXIT_" + exitCode);
  var msg = applyResult && applyResult.Message
    ? fixUtf8Mojibake(String(applyResult.Message))
    : ("Erreur automatique (code " + exitCode + ")");
  writeControllerOverclockerLog("[DEVICE] Result: auto_apply_failed");
  writeControllerOverclockerLog("[DEVICE] Auto failure code: " + code);
  if (code === "USB_PARENT_NOT_FOUND" || code === "USB_PARENT_KEY_MISSING" || exitCode === 31) {
    hideControllerAssistedGuide();
    setControllerOverclockerStatus("Parent USB introuvable \u2014 voir logs", "error");
    return;
  }
  setControllerOverclockerStatus(
    "Mode automatique impossible : " + msg + ". Ouvre HIDUSBF Setup en mode assist\u00e9.",
    "warn"
  );
  showControllerAssistedGuide(rateHz || 0);
}

